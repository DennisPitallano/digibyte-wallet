@using System.Globalization
@using DigiByte.Wallet.Models
@using DigiByte.Wallet.Services
@inject LocalizationService L

@* The DigiDollar price oracle at a glance: the DGB price in USD, how fresh it is, and whether a protection state is active.
   Presentational only: the caller supplies the health snapshot (the DigiDollar page reuses its polled one, Analytics fetches
   its own), so this never talks to the network. The status is always shown as words as well as colour (FR-024). *@
@{
    var s = Status;
    var (chipBg, chipText, dot, ring, iconBg, iconText, bodyKey, iconName) = s switch
    {
        OracleState.Live => ("bg-emerald-50 dark:bg-emerald-900/25", "text-emerald-700 dark:text-emerald-300", "bg-emerald-500", "border-emerald-200/70 dark:border-emerald-800/50", "bg-emerald-100 dark:bg-emerald-900/40", "text-emerald-600 dark:text-emerald-300", "dd.oracle.body.live", "check"),
        OracleState.Stale => ("bg-amber-50 dark:bg-amber-900/25", "text-amber-700 dark:text-amber-300", "bg-amber-500", "border-amber-200/70 dark:border-amber-800/50", "bg-amber-100 dark:bg-amber-900/40", "text-amber-600 dark:text-amber-300", "dd.oracle.body.stale", "clock"),
        OracleState.Protected => ("bg-amber-50 dark:bg-amber-900/25", "text-amber-700 dark:text-amber-300", "bg-amber-500", "border-amber-200/70 dark:border-amber-800/50", "bg-amber-100 dark:bg-amber-900/40", "text-amber-600 dark:text-amber-300", "dd.oracle.body.protected", "shield"),
        OracleState.Loading => ("bg-slate-100 dark:bg-dgb-800", "text-slate-500 dark:text-slate-400", "bg-slate-400 animate-pulse", "border-slate-200/80 dark:border-dgb-800", "bg-slate-100 dark:bg-dgb-800", "text-slate-400", "dd.oracle.loading", "chart"),
        _ => ("bg-slate-100 dark:bg-dgb-800", "text-slate-600 dark:text-slate-300", "bg-slate-400", "border-slate-200/80 dark:border-dgb-800", "bg-slate-100 dark:bg-dgb-800", "text-slate-500 dark:text-slate-400", "dd.oracle.body.unavailable", "offline"),
    };
    var h = Health;
}
<section class="bg-white dark:bg-dgb-900 rounded-2xl border @ring p-4 flex flex-col gap-3 shadow-sm" aria-label="@L.T("dd.oracle.title")">
    <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 @iconBg @iconText">
                <DdIcon Name="@iconName" Class="w-5 h-5" />
            </span>
            <div class="min-w-0">
                <p class="text-xs font-semibold text-slate-900 dark:text-white truncate">@L.T("dd.oracle.title")</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">@L.T(bodyKey)</p>
            </div>
        </div>
        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold px-2 py-1 rounded-full shrink-0 @chipBg @chipText" role="status">
            <span class="w-1.5 h-1.5 rounded-full @dot" aria-hidden="true"></span>
            @StatusLabel
        </span>
    </div>

    @if (h is { Available: true, OraclePriceAvailable: true })
    {
        <div class="flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tabular-nums text-slate-900 dark:text-white">@DigiDollarFormat.DgbPrice(h.OraclePriceMicroUsd!.Value, Culture)</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">@L.T("dd.oracle.perDgb")</span>
        </div>

        <dl class="grid grid-cols-3 gap-2 text-[11px]">
            <div class="rounded-xl bg-slate-50 dark:bg-dgb-950 border border-slate-100 dark:border-dgb-800 px-2.5 py-2">
                <dt class="flex items-center gap-1 text-slate-400 dark:text-slate-500"><DdIcon Name="clock" Class="w-3.5 h-3.5" />@L.T("dd.oracle.updated")</dt>
                <dd class="mt-0.5 font-semibold tabular-nums text-slate-800 dark:text-slate-200">@AgeText</dd>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-dgb-950 border border-slate-100 dark:border-dgb-800 px-2.5 py-2">
                <dt class="flex items-center gap-1 text-slate-400 dark:text-slate-500"><DdIcon Name="block" Class="w-3.5 h-3.5" />@L.T("dd.oracle.block")</dt>
                <dd class="mt-0.5 font-semibold tabular-nums text-slate-800 dark:text-slate-200">@(h.OracleHeight is { } oh ? oh.ToString("N0", Culture) : "—")</dd>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-dgb-950 border border-slate-100 dark:border-dgb-800 px-2.5 py-2">
                <dt class="flex items-center gap-1 text-slate-400 dark:text-slate-500"><DdIcon Name="link" Class="w-3.5 h-3.5" />@L.T("dd.oracle.chain")</dt>
                <dd class="mt-0.5 font-semibold tabular-nums text-slate-800 dark:text-slate-200">@h.NodeHeight.ToString("N0", Culture)</dd>
            </div>
        </dl>

        <div class="flex flex-wrap items-center gap-x-1.5 text-[11px] text-slate-500 dark:text-slate-400">
            <DdIcon Name="shield" Class="w-3.5 h-3.5" />
            <span>@L.T("dd.oracle.protection"):</span>
            @if (h.ErrActive || h.VolatilityFreeze)
            {
                @if (h.ErrActive)
                {
                    <span class="font-semibold text-amber-700 dark:text-amber-300">@L.T("dd.oracle.protection.err")</span>
                }
                @if (h.VolatilityFreeze)
                {
                    <span class="font-semibold text-amber-700 dark:text-amber-300">@L.T("dd.oracle.protection.volatility")</span>
                }
            }
            else
            {
                <span class="font-semibold text-emerald-700 dark:text-emerald-300">@L.T("dd.oracle.protection.normal")</span>
            }
        </div>
    }
</section>

@code {
    private enum OracleState { Loading, Live, Stale, Protected, Unavailable }

    /// <summary>The latest health snapshot, or null while nothing has loaded.</summary>
    [Parameter] public NetworkHealth? Health { get; set; }

    /// <summary>True until the first answer arrives, so a slow first load is not reported as "unavailable".</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public CultureInfo Culture { get; set; } = CultureInfo.CurrentCulture;

    private OracleState Status => Health switch
    {
        null => Loading ? OracleState.Loading : OracleState.Unavailable,
        { Available: false } => OracleState.Unavailable,
        { OraclePriceAvailable: false } => OracleState.Unavailable,
        { ErrActive: true } or { VolatilityFreeze: true } => OracleState.Protected,
        { IsOracleStale: true } => OracleState.Stale,
        _ => OracleState.Live,
    };

    private string StatusLabel => L.T(Status switch
    {
        OracleState.Live => "dd.oracle.status.live",
        OracleState.Stale => "dd.oracle.status.stale",
        OracleState.Protected => "dd.oracle.status.protected",
        OracleState.Loading => "dd.oracle.loading",
        _ => "dd.oracle.status.unavailable",
    });

    private string AgeText
    {
        get
        {
            if (Health is null || DigiDollarFormat.OracleAge(Health) is not { } a) return "—";
            var text = a.TotalSeconds < 60 ? L.T("dd.time.seconds", (int)a.TotalSeconds)
                : a.TotalMinutes < 60 ? L.T("dd.time.minutes", (int)a.TotalMinutes)
                : L.T("dd.time.hours", (int)a.TotalHours);
            return L.T("dd.oracle.ago", text);
        }
    }
}
