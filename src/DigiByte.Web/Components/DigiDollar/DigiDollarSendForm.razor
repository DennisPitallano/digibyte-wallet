@using DigiByte.Crypto.Addresses
@using DigiByte.Crypto.Transactions
@using DigiByte.Wallet.Services
@implements IDisposable
@inject DigiDollarViewModel Dd
@inject UsageCounter UsageCounter
@inject IDigiDollarService Service
@inject LocalizationService L
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Recipient, USD amount, Send all, and the automatically computed DGB fee (FR-011..FR-014). There is NO fee selector or
   custom fee input: the fee is calculated by the wallet and never below the protocol minimum (FR-014). Inline messages come
   from the same validation the final send uses, so nothing that passes here is rejected later by our own rules. *@
<div class="flex flex-col gap-4">
    <div class="flex flex-col gap-1.5">
        <label for="dd-recipient" class="text-xs font-medium text-slate-500 dark:text-slate-400">@L.T("dd.send.recipient")</label>
        <div class="flex gap-2">
            <input id="dd-recipient" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                   value="@recipientText" @oninput="OnRecipientInput"
                   aria-invalid="@(RecipientError is not null ? "true" : "false")" aria-describedby="dd-send-error"
                   class="flex-1 min-w-0 px-3 py-2.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl text-sm font-mono text-slate-900 dark:text-white outline-none focus:border-dgb-500 focus:ring-2 focus:ring-dgb-500/20 transition-all" />
            <button type="button" class="w-11 shrink-0 flex items-center justify-center bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-600 dark:text-slate-300 rounded-xl press-effect hover:border-dgb-400 transition-colors"
                    aria-label="@L.T("dd.send.paste")" title="@L.T("dd.send.paste")" @onclick="PasteAsync">
                <DdIcon Name="paste" Class="w-5 h-5" />
            </button>
            <button type="button" class="w-11 shrink-0 flex items-center justify-center bg-dgb-500 hover:bg-dgb-600 text-white rounded-xl press-effect transition-colors"
                    aria-label="@L.T("dd.send.scan")" title="@L.T("dd.send.scan")" @onclick="@(() => showScanner = true)">
                <DdIcon Name="qr" Class="w-5 h-5" StrokeWidth="2" />
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
            <label for="dd-amount" class="text-xs font-medium text-slate-500 dark:text-slate-400">@L.T("dd.send.amount")</label>
            <span class="text-[11px] tabular-nums text-slate-500 dark:text-slate-400">@L.T("dd.send.available", Dd.Usd(Dd.Dashboard?.AvailableCents ?? check?.AvailableCents ?? 0))</span>
        </div>
        <div class="flex gap-2">
            <input id="dd-amount" type="text" inputmode="decimal" autocomplete="off"
                   value="@amountText" @oninput="OnAmountInput"
                   aria-invalid="@(AmountError is not null ? "true" : "false")" aria-describedby="dd-send-error"
                   class="flex-1 px-3 py-2.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl text-sm tabular-nums text-slate-900 dark:text-white outline-none focus:border-dgb-500 focus:ring-2 focus:ring-dgb-500/20 transition-all" />
            <button type="button" class="px-4 py-2.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect"
                    @onclick="SendAllAsync">
                @L.T("dd.send.all")
            </button>
        </div>
    </div>

    <p class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        <DdIcon Name="clock" Class="w-3.5 h-3.5 shrink-0" />
        @L.T("dd.send.fee", DigiDollarFormat.Dgb(check?.FeeSats > 0 ? check.FeeSats : DigiDollarTransferBuilder.MinFeeSats, Dd.Culture))
    </p>

    <div id="dd-send-error" aria-live="polite">
        @if (message is not null)
        {
            <p class="text-xs text-red-600 dark:text-red-400" role="alert">@message</p>
        }
        else if (checking)
        {
            <p class="text-xs text-slate-400" role="status">@L.T("dd.send.checking")</p>
        }
    </div>

    <p class="flex items-start gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        <DdIcon Name="shield" Class="w-4 h-4 shrink-0 mt-px text-emerald-600 dark:text-emerald-400" />
        <span>@L.T("dd.send.custody")</span>
    </p>

    <button type="button"
            class="w-full py-3 bg-dgb-500 hover:bg-dgb-600 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-xl press-effect"
            disabled="@(!CanContinue)" @onclick="OpenConfirm">
        <span class="inline-flex items-center justify-center gap-2"><DdIcon Name="send" Class="w-4 h-4" StrokeWidth="2" />@L.T("dd.send.continue")</span>
    </button>
</div>

<QrScannerModal IsOpen="@showScanner" OnScanned="OnQrScanned" OnClosed="@(() => showScanner = false)" />

@if (showConfirm && check is { IsOk: true } && TryAmount(out var confirmCents))
{
    <DigiDollarConfirmDialog Check="check" Recipient="@recipientText.Trim()" AmountCents="confirmCents"
                             Busy="sending" Error="@sendError" OnConfirm="ConfirmAsync" OnCancel="CloseConfirm" />
}

@code {
    private string recipientText = "";
    private string amountText = "";
    private DdSendCheck? check;
    private bool checking;
    private bool showConfirm;
    private bool showScanner;
    private bool sending;
    private string? sendError;
    private string? message;
    private CancellationTokenSource? debounce;

    private bool CanContinue => !checking && !sending && check is { IsOk: true };
    private string? RecipientError => check?.Issue is DdSendIssue.NotDdAddress or DdSendIssue.WrongNetwork ? message : null;
    private string? AmountError => message is not null && RecipientError is null ? message : null;

    protected override void OnInitialized()
    {
        Dd.Changed += OnChanged;
        // "Scan" on the DigiDollar page opens this screen with the scanner already up.
        showScanner = new Uri(Nav.Uri).Query.Contains("scan=1", StringComparison.Ordinal);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private bool TryAmount(out long cents) => DigiDollarFormat.TryParseUsdToCents(amountText, Dd.Culture, out cents);

    /// <summary>The address inside a scanned code: a bare address, or a <c>digidollar:</c> style URI with optional parameters.</summary>
    internal static string ExtractAddress(string data)
    {
        var text = data.Trim();
        var colon = text.IndexOf(':');
        if (colon > 0 && colon < 16 && !DigiDollarAddressValidator.IsValid(text)) text = text[(colon + 1)..].TrimStart('/');
        var query = text.IndexOfAny(['?', '&', '#']);
        return query >= 0 ? text[..query] : text;
    }

    private async Task OnQrScanned(string data)
    {
        showScanner = false;
        var address = ExtractAddress(data ?? "");
        if (DigiDollarAddressValidator.DetectNetwork(address) is null)
        {
            recipientText = "";
            check = null;
            message = L.T("dd.send.err.scanInvalid");
            return;
        }
        recipientText = address;
        Notifications.Show(L.T("dd.send.scanned"), ToastType.Success, 2000);
        await ScheduleCheckAsync(immediate: true);
    }

    private async Task PasteAsync()
    {
        string? text = null;
        try { text = await JS.InvokeAsync<string>("navigator.clipboard.readText"); }
        catch { /* permission denied or unsupported: the field still accepts typing and the OS paste */ }
        if (string.IsNullOrWhiteSpace(text))
        {
            message = L.T("dd.send.pasteEmpty");
            return;
        }
        recipientText = ExtractAddress(text);
        await ScheduleCheckAsync(immediate: true);
    }

    private Task OnRecipientInput(ChangeEventArgs e) { recipientText = e.Value?.ToString() ?? ""; return ScheduleCheckAsync(); }

    private Task OnAmountInput(ChangeEventArgs e) { amountText = e.Value?.ToString() ?? ""; return ScheduleCheckAsync(); }

    private async Task SendAllAsync()
    {
        var all = await Service.GetSendAllAmountAsync();
        if (all <= 0) { amountText = ""; check = null; message = L.T("dd.send.err.insufficientDd"); return; }
        amountText = (all / 100m).ToString("0.00", Dd.Culture);
        await ScheduleCheckAsync(immediate: true);
    }

    /// <summary>Validate shortly after the user stops typing; static problems (format, limits) answer without any network call.</summary>
    private async Task ScheduleCheckAsync(bool immediate = false)
    {
        debounce?.Cancel();
        debounce?.Dispose();
        debounce = new CancellationTokenSource();
        var token = debounce.Token;

        check = null;
        message = null;
        sendError = null;

        var recipient = recipientText.Trim();
        if (recipient.Length == 0 || amountText.Trim().Length == 0) { checking = false; return; }

        if (!TryAmount(out var cents))
        {
            checking = false;
            message = L.T("dd.send.err.amountFormat");
            return;
        }

        checking = true;
        try
        {
            if (!immediate) await Task.Delay(450, token);
            var result = await Service.CheckSendAsync(recipient, cents, token);
            if (token.IsCancellationRequested) return;
            check = result;
            message = result.IsOk ? null : MessageFor(result, null);
        }
        catch (OperationCanceledException) { return; }
        catch
        {
            check = null;
            message = L.T("dd.send.err.offline");
        }
        finally
        {
            if (!token.IsCancellationRequested) checking = false;
        }
    }

    private string MessageFor(DdSendCheck c, string? detail) => c.Issue switch
    {
        DdSendIssue.NotDdAddress => L.T("dd.send.err.notDdAddress"),
        DdSendIssue.WrongNetwork => L.T("dd.send.err.wrongNetwork"),
        DdSendIssue.BelowMinimum => L.T("dd.send.err.belowMin"),
        DdSendIssue.AboveMaximum => L.T("dd.send.err.aboveMax"),
        DdSendIssue.InsufficientDd => L.T("dd.send.err.insufficientDd"),
        DdSendIssue.ChangeBelowMinimum => L.T("dd.send.err.changeBelowMin", Dd.Usd(c.AvailableCents)),
        DdSendIssue.ChangeAboveMaximum => L.T("dd.send.err.changeAboveMax"),
        DdSendIssue.InsufficientDgbFee => L.T("dd.send.err.insufficientDgbFee"),
        DdSendIssue.RateLimited => L.T("dd.send.err.slowDown"),
        DdSendIssue.Offline => L.T("dd.send.err.offline"),
        DdSendIssue.NotActive => L.T("dd.notActive"),
        DdSendIssue.NotSupported => L.T("dd.unsupported"),
        DdSendIssue.Rejected => L.T("dd.send.err.rejected", detail ?? ""),
        _ => L.T("dd.send.err.offline"),
    };

    private void OpenConfirm()
    {
        if (!CanContinue) return;
        sendError = null;
        showConfirm = true;
    }

    private void CloseConfirm()
    {
        if (sending) return;
        showConfirm = false;
        sendError = null;
    }

    private async Task ConfirmAsync()
    {
        if (sending || check is not { IsOk: true } || !TryAmount(out var cents)) return;
        sending = true;
        sendError = null;
        _ = UsageCounter.RecordAsync("dd_send_attempted"); // anonymous count: the attempt, never the address or amount
        try
        {
            var result = await Service.SendAsync(recipientText.Trim(), cents);
            showConfirm = false;
            Notifications.Show(L.T("dd.send.sent", Dd.Usd(result.AmountCents)), ToastType.Success, 4000);
            _ = Dd.RefreshAsync();
            Nav.NavigateTo("/digidollar");
        }
        catch (DdSendException ex)
        {
            sendError = MessageFor(new DdSendCheck(ex.Issue, check?.AvailableCents ?? 0, 0, 0, false, []), ex.Detail);
            // Something changed since the quote: show why and re-check so the form reflects reality.
            if (ex.Issue is not DdSendIssue.Rejected and not DdSendIssue.Offline)
            {
                showConfirm = false;
                message = sendError;
                check = null;
            }
        }
        catch
        {
            sendError = L.T("dd.send.err.offline");
        }
        finally
        {
            sending = false;
        }
    }

    public void Dispose()
    {
        Dd.Changed -= OnChanged;
        debounce?.Cancel();
        debounce?.Dispose();
    }
}
