@* The recipient rows of a shared-wallet payment to several recipients (specs/029-multisig-multiple-recipients): 2 to 20
   numbered rows, each a RecipientInput (type, paste, scan or pick a contact) and an amount. The page owns the rows, checks
   them, and hosts the one scanner; this component only shows them and reports changes. *@
@inject LocalizationService L

<div class="flex flex-col gap-3">
    @for (var i = 0; i < Rows.Count; i++)
    {
        var index = i;
        var row = Rows[index];
        <div @key="row.Id" class="flex flex-col gap-2 p-3 bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800" data-testid="recipient-row">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("send.batch.recipient_n", index + 1)</span>
                @if (Rows.Count > MinRows)
                {
                    <button type="button" class="min-h-[32px] px-1 text-xs font-semibold text-red-500 hover:text-red-600"
                            aria-label="@L.T("ms.send.batch.remove_aria", index + 1)" @onclick="() => RemoveAsync(index)">@L.T("send.batch.remove")</button>
                }
            </div>

            <RecipientInput @ref="inputs[index]" Address="@row.Address" Label="@L.T("send.recipient")" InputId="@($"ms-recipient-{index}")"
                            InputAriaLabel="@L.T("send.batch.recipient_n", index + 1)" ContactList="ContactList"
                            Error="@row.AddressError" AddressChanged="v => OnAddressAsync(row, v)"
                            OnPaymentLink="link => OnPaymentLinkAsync(row, link)" OnScanRequested="() => OnScanRequested.InvokeAsync(index)" />

            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider" for="@($"ms-amount-{index}")">@L.T("send.amount")</label>
                <div class="flex items-center bg-white dark:bg-dgb-900 border rounded-xl focus-within:ring-2 focus-within:ring-dgb-500/20 transition-all @(string.IsNullOrEmpty(row.AmountError) ? "border-slate-200 dark:border-dgb-800 focus-within:border-dgb-500" : "border-red-400")">
                    <input id="@($"ms-amount-{index}")" type="text" inputmode="decimal" value="@row.AmountText" placeholder="0.00" autocomplete="off"
                           aria-invalid="@(!string.IsNullOrEmpty(row.AmountError))" @oninput="e => OnAmountAsync(row, e)"
                           aria-label="@($"{L.T("send.batch.recipient_n", index + 1)} · {L.T("send.amount")}")"
                           class="flex-1 min-w-0 px-4 py-3 bg-transparent text-sm text-slate-900 dark:text-white outline-none" />
                    <span class="flex items-center mr-2 px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-dgb-800">
                        <span class="text-sm font-bold text-dgb-500">DGB</span>
                    </span>
                </div>
                @if (row.Ambiguity is { Kind: AmountEntryKind.Ambiguous } ambiguous)
                {
                    <AmountAmbiguityChoice AsDecimal="ambiguous.AsDecimal!.Value" AsThousands="ambiguous.AsThousands!.Value" OnPicked="v => OnPickedAsync(row, v)" />
                }
                @if (!string.IsNullOrEmpty(row.AmountError)) { <InlineError Message="@row.AmountError" /> }
            </div>
        </div>
    }

    @if (Rows.Count < MultisigSendHelper.MaxRecipients)
    {
        <button type="button" class="btn-secondary btn-sm w-full" @onclick="AddAsync">@L.T("send.batch.add")</button>
    }
</div>

@code {
    /// <summary>One recipient row as typed. The page fills in the errors after checking every row.</summary>
    public sealed class Row
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Address { get; set; } = "";
        public string AmountText { get; set; } = "";
        public string? AddressError { get; set; }
        public string? AmountError { get; set; }

        /// <summary>An amount already settled for <see cref="AmountText"/>: filled in from a link, or picked after "which did you mean".</summary>
        public (string Text, decimal Value)? Pick { get; set; }

        /// <summary>Set by the page when <see cref="AmountText"/> could mean two amounts ("1.234").</summary>
        public AmountEntryResult? Ambiguity { get; set; }
    }

    public const int MinRows = 2;

    [Parameter, EditorRequired] public List<Row> Rows { get; set; } = [];

    /// <summary>Your own wallets and saved contacts, for each row's Contacts button.</summary>
    [Parameter] public IReadOnlyList<Contact>? ContactList { get; set; }

    /// <summary>Raised after any row is added, removed or edited.</summary>
    [Parameter] public EventCallback RowsChanged { get; set; }

    /// <summary>Raised with the row index when that row's Scan button is tapped; the page opens the scanner.</summary>
    [Parameter] public EventCallback<int> OnScanRequested { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private readonly RecipientInput?[] inputs = new RecipientInput?[MultisigSendHelper.MaxRecipients];

    /// <summary>Hands scanned text to row <paramref name="index"/> only (an address, or a payment link with its amount).</summary>
    public async Task ApplyScannedAsync(int index, string data)
    {
        if (index < 0 || index >= Rows.Count || inputs[index] is not { } input) return;
        await input.ApplyScannedAsync(data);
    }

    private Task OnAddressAsync(Row row, string value)
    {
        row.Address = value;
        return RowsChanged.InvokeAsync();
    }

    // A payment link's amount fills only its own row.
    private Task OnPaymentLinkAsync(Row row, ScanResult link)
    {
        if (link.AmountDgb is { } amount && amount > 0)
        {
            row.AmountText = amount.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture);
            row.Pick = (row.AmountText, amount);   // a link's amount has its own format and never asks
        }
        return RowsChanged.InvokeAsync();
    }

    private Task OnAmountAsync(Row row, ChangeEventArgs e)
    {
        row.AmountText = e.Value?.ToString() ?? "";
        row.Pick = null;
        return RowsChanged.InvokeAsync();
    }

    private Task OnPickedAsync(Row row, decimal value)
    {
        row.Pick = (row.AmountText, value);
        return RowsChanged.InvokeAsync();
    }

    private Task AddAsync()
    {
        if (Rows.Count < MultisigSendHelper.MaxRecipients) Rows.Add(new Row());
        return RowsChanged.InvokeAsync();
    }

    private Task RemoveAsync(int index)
    {
        if (Rows.Count > MinRows && index >= 0 && index < Rows.Count) Rows.RemoveAt(index);
        return RowsChanged.InvokeAsync();
    }
}
