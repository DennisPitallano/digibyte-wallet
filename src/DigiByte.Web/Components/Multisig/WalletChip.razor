@* The small pill the Send and Receive headers show: the active wallet's colour dot and name. *@
@inject ActiveWalletContext ActiveWallet

<div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10">
    <div class="w-2 h-2 rounded-full" style="background-color: @ActiveWallet.WalletColor;"></div>
    <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[100px]">@(Label ?? ActiveWallet.WalletName)</span>
</div>

@code {
    /// <summary>Replaces the wallet's name, e.g. with the multisig's own name.</summary>
    [Parameter] public string? Label { get; set; }
}
