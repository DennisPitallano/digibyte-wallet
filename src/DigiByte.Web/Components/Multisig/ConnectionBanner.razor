@inject LocalizationService L

@if (IsReconnecting)
{
    <div class="p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-xl flex items-center gap-2" role="status">
        <UxIcon Name="clock" Class="w-4 h-4 shrink-0 text-amber-600 dark:text-amber-400" />
        <p class="text-xs font-semibold text-amber-700 dark:text-amber-300">@L.T("ms.ui.connection.reconnecting")</p>
    </div>
}

@code {
    [Parameter] public bool IsReconnecting { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }
}
