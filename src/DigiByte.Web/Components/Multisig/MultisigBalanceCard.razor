@* The multisig's balance card, built like the wallet dashboard's: same surface, wallet-colour edge and glow, balance
   typography, hide and refresh buttons, and the address row with copy and QR at the bottom. *@
@inject ActiveWalletContext ActiveWallet
@inject AppState AppState
@inject ISecureStorage Storage
@inject ClipboardService Clipboard

<div class="relative overflow-hidden rounded-2xl bg-white dark:bg-gradient-to-br dark:from-dgb-900 dark:via-dgb-800 dark:to-dgb-700 border border-dgb-200 dark:border-dgb-700/50 px-5 py-4 text-dgb-900 dark:text-white shadow-lg shadow-gray-200/50 dark:shadow-dgb-900/25">
    <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full blur-2xl" style="background-color: @(ActiveWallet.WalletColor)40;"></div>
    <div class="absolute left-0 top-4 bottom-4 w-1 rounded-r-full" style="background-color: @ActiveWallet.WalletColor;"></div>
    <div class="absolute -bottom-6 -left-6 w-20 h-20 bg-dgb-50/50 dark:bg-dgb-400/10 rounded-full blur-xl"></div>
    <div class="absolute -bottom-4 -right-4 opacity-[0.08] dark:opacity-[0.10] pointer-events-none">
        <SpinningCoin Size="120" />
    </div>

    <div class="relative">
        <div class="flex items-center gap-2">
            <p class="text-xs text-dgb-600 dark:text-dgb-200 font-medium">Multisig Balance</p>
            @if (AppState.NetworkMode != "mainnet")
            {
                <span class="text-[11px] font-bold text-amber-700 dark:text-amber-300 bg-amber-500/20 px-1.5 py-0.5 rounded-full uppercase">@AppState.NetworkMode</span>
            }
            @if (IsWatchOnly)
            {
                <span class="text-[11px] font-bold text-sky-700 dark:text-sky-300 bg-sky-500/20 px-1.5 py-0.5 rounded-full uppercase" title="This device holds no key of this multisig">Watch-Only</span>
            }
            @if (IsLoading)
            {
                <div class="w-2.5 h-2.5 border-2 border-dgb-500 dark:border-dgb-300 border-t-transparent rounded-full animate-spin" role="status" aria-label="Loading balance"></div>
            }
            <div class="flex-1"></div>
            <button type="button" class="p-1 rounded-lg hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors"
                    title="@(hideBalance ? "Show balance" : "Hide balance")" aria-label="@(hideBalance ? "Show balance" : "Hide balance")" aria-pressed="@(hideBalance ? "true" : "false")"
                    @onclick="ToggleHide">
                <svg class="w-4 h-4 text-dgb-500 dark:text-dgb-300" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    @if (hideBalance)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    }
                </svg>
            </button>
            <button type="button" class="p-1 rounded-lg hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors disabled:opacity-40" title="Refresh" aria-label="Refresh"
                    @onclick="() => OnRefresh.InvokeAsync()" disabled="@IsLoading">
                <svg class="w-4 h-4 text-dgb-500 dark:text-dgb-300 @(IsLoading ? "animate-spin" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182M20.015 4.356v4.99" />
                </svg>
            </button>
        </div>

        @if (IsLoading && BalanceSatoshis is null)
        {
            <div class="h-9 w-40 skeleton mt-1 rounded-lg" style="background:rgba(0,102,204,0.1)"></div>
            <div class="h-4 w-24 skeleton mt-1.5 rounded" style="background:rgba(0,102,204,0.08)"></div>
        }
        else if (BalanceSatoshis is null)
        {
            <h1 class="text-2xl font-extrabold mt-0.5 tracking-tight opacity-70">Balance unavailable</h1>
            <p class="text-xs text-amber-600 dark:text-amber-300 mt-0.5" role="status">Couldn't reach the network. Your funds are not affected. Tap refresh to try again.</p>
        }
        else if (hideBalance)
        {
            <h1 class="text-3xl font-extrabold mt-0.5 balance-mask" aria-label="Balance hidden">••••••</h1>
            <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5">Balance hidden</p>
        }
        else if (AppState.IsSimpleMode && DgbPrice > 0)
        {
            var fiat = FiatText;
            <h1 class="@BalanceSize(AppState.FiatSymbol + fiat) font-extrabold mt-0.5 tracking-tight whitespace-nowrap tabular-nums">@AppState.FiatSymbol@fiat</h1>
            <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5 tabular-nums">@MultisigFormat.Dgb(BalanceSatoshis.Value) DGB</p>
        }
        else
        {
            var dgb = MultisigFormat.Dgb(BalanceSatoshis.Value);
            <h1 class="@BalanceSize(dgb) font-extrabold mt-0.5 tracking-tight whitespace-nowrap tabular-nums">@dgb <span class="text-base font-bold opacity-80">DGB</span></h1>
            @if (DgbPrice > 0)
            {
                <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5 tabular-nums">@AppState.FiatSymbol@FiatText @AppState.FiatCurrency</p>
            }
        }

        <div class="flex items-center gap-1.5 mt-2 pt-2 border-t border-dgb-300/30 dark:border-white/10">
            <span class="text-[11px] font-mono text-dgb-500/70 dark:text-dgb-300/80 truncate flex-1" title="@Address">@MultisigFormat.Short(Address, 12, 8)</span>
            <button type="button" class="p-1 rounded hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors" title="Copy address" aria-label="Copy address" @onclick="CopyAddress">
                @if (copied)
                {
                    <span class="text-[11px] font-semibold text-green-500 px-1">Copied</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-dgb-500 dark:text-dgb-300" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                    </svg>
                }
            </button>
            <button type="button" class="p-1 rounded hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors" title="Show QR code" aria-label="Show QR code" @onclick="() => OnShowQr.InvokeAsync()">
                <svg class="w-3.5 h-3.5 text-dgb-500 dark:text-dgb-300" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 14.625v2.625m3.375-2.625v2.625m-6.75 0h8.25" />
                </svg>
            </button>
        </div>
    </div>
</div>

@code {
    private const string HideBalanceKey = "pref:hideBalance";

    [Parameter, EditorRequired] public string Address { get; set; } = "";
    [Parameter] public long? BalanceSatoshis { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsWatchOnly { get; set; }

    /// <summary>Price of one DGB in the wallet's fiat currency, or 0 when it isn't known (then only DGB is shown).</summary>
    [Parameter] public decimal DgbPrice { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnShowQr { get; set; }

    private bool hideBalance;
    private bool copied;

    private string FiatText
    {
        get
        {
            var value = (BalanceSatoshis ?? 0) / 100_000_000m * DgbPrice;
            return value.ToString("N" + AppState.FiatDecimals);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The same preference the wallet dashboard uses, so hiding the balance there hides it here too.
        try { hideBalance = await Storage.GetAsync(HideBalanceKey) == "1"; } catch { }
    }

    private async Task ToggleHide()
    {
        hideBalance = !hideBalance;
        try { await Storage.SetAsync(HideBalanceKey, hideBalance ? "1" : "0"); } catch { }
    }

    private async Task CopyAddress()
    {
        await Clipboard.CopyAsync(Address, toast: false);
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
    }

    private static string BalanceSize(string amount) => amount.Length switch
    {
        <= 12 => "text-3xl",
        <= 15 => "text-[1.65rem] leading-8",
        _ => "text-2xl",
    };
}
