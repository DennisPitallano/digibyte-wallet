@* Every way a co-signer's proposal gets onto this device, in one place: scan, paste, file, or join a live room with a
   code (specs/026-multisig-wallet-experience, FR-022). The bottom menu is hidden while the sheet is open, so the
   sheet owns the bottom of the screen. *@
@inject ShellChrome Chrome
@inject LocalizationService L
@inject IJSRuntime JS
@implements IDisposable

@if (IsOpen)
{
    <div id="@SheetId" class="more-sheet-overlay" role="dialog" aria-modal="true" aria-labelledby="@TitleId" tabindex="-1"
         data-testid="add-proposal-sheet" @onclick="CloseAsync" @onkeydown="OnKeyDown">
        <div class="more-sheet sheet-enter" @onclick:stopPropagation="true">
            <div class="more-sheet-grip" aria-hidden="true"></div>
            <div class="flex items-center justify-between px-5 pb-1">
                <h3 id="@TitleId" class="block-title">@L.T("ms.ui.addProposal.title")</h3>
                <button type="button" class="icon-btn -mr-2" aria-label="@L.T("more.close")" @onclick="CloseAsync">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <p class="px-5 pb-3 text-xs text-slate-600 dark:text-slate-400">@L.T("ms.ui.addProposal.intro")</p>
            <div class="more-sheet-list">
                <button type="button" class="more-sheet-row" data-autofocus="true" @onclick="() => ChooseAsync(OnScan)">
                    <span class="more-sheet-icon" aria-hidden="true"><UxIcon Name="scan" Class="w-5 h-5" /></span>
                    <span class="flex-1 min-w-0 text-left">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">@L.T("send.scan_qr")</span>
                        <span class="block text-xs text-slate-600 dark:text-slate-400">@L.T("ms.ui.addProposal.scan_hint")</span>
                    </span>
                </button>
                <button type="button" class="more-sheet-row" @onclick="() => ChooseAsync(OnPaste)">
                    <span class="more-sheet-icon" aria-hidden="true"><UxIcon Name="copy" Class="w-5 h-5" /></span>
                    <span class="flex-1 min-w-0 text-left">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">@L.T("send.paste")</span>
                        <span class="block text-xs text-slate-600 dark:text-slate-400">@L.T("ms.ui.addProposal.paste_hint")</span>
                    </span>
                </button>
                <label class="more-sheet-row">
                    <span class="more-sheet-icon" aria-hidden="true">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                        </svg>
                    </span>
                    <span class="flex-1 min-w-0 text-left">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">@L.T("ms.ui.addProposal.file")</span>
                        <span class="block text-xs text-slate-600 dark:text-slate-400">@L.T("ms.ui.addProposal.file_hint")</span>
                    </span>
                    <InputFile OnChange="OnFileChosenAsync" class="sr-only" accept=".txt,.psbt,text/plain" />
                </label>
                @if (CanJoinRoom)
                {
                    <button type="button" class="more-sheet-row" @onclick="() => ChooseAsync(OnJoinRoom)">
                        <span class="more-sheet-icon" aria-hidden="true"><UxIcon Name="live" Class="w-5 h-5" /></span>
                        <span class="flex-1 min-w-0 text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">@L.T("ms.ui.addProposal.join")</span>
                            <span class="block text-xs text-slate-600 dark:text-slate-400">@L.T("ms.ui.addProposal.join_hint")</span>
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>False for a view-only copy, which cannot join signing rooms.</summary>
    [Parameter] public bool CanJoinRoom { get; set; }

    [Parameter] public EventCallback OnScan { get; set; }
    [Parameter] public EventCallback OnPaste { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFile { get; set; }
    [Parameter] public EventCallback OnJoinRoom { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private readonly string SheetId = "add-proposal-" + Guid.NewGuid().ToString("N")[..8];
    private string TitleId => SheetId + "-title";
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen != wasOpen && !IsOpen)
        {
            wasOpen = false;
            Chrome.SetHideNav(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen || wasOpen) return;
        wasOpen = true;
        Chrome.SetHideNav(true);
        try { await JS.InvokeVoidAsync("domHelpers.trapFocus", SheetId); } catch { }
    }

    private async Task CloseAsync()
    {
        try { await JS.InvokeVoidAsync("domHelpers.releaseFocus", SheetId); } catch { }
        await OnClosed.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    // The sheet closes first, so what the choice opens (the scanner, a message) is not behind it.
    private async Task ChooseAsync(EventCallback choice)
    {
        await CloseAsync();
        await choice.InvokeAsync();
    }

    private async Task OnFileChosenAsync(InputFileChangeEventArgs e)
    {
        // Read by the page before the sheet (and with it the file input) goes away.
        await OnFile.InvokeAsync(e);
        await CloseAsync();
    }

    public void Dispose()
    {
        if (wasOpen) Chrome.SetHideNav(false);
    }
}
