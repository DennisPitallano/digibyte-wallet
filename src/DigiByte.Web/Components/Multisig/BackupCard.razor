@* Redeem-script backup. Until the user downloads the backup file or copies the script it is a prominent warning (styled
   like the wallet's other amber notices); afterwards it shrinks to one quiet line with the date. *@
@inject MultisigWalletService MultisigService
@inject ClipboardService Clipboard
@inject IJSRuntime JS

@if (Config.BackupAt is null)
{
    <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-3 rounded-xl border border-amber-200 dark:border-amber-800/30" role="alert">
        <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
        <div class="min-w-0 flex-1">
            <p class="text-xs font-bold text-amber-800 dark:text-amber-300">Back up your redeem script</p>
            <p class="text-xs text-amber-700 dark:text-amber-400 font-medium leading-relaxed mt-0.5">
                Your seed phrase alone <b>cannot recover</b> this multisig. Download the backup or copy the script and keep it safe.
            </p>
            <div class="flex gap-2 mt-2.5">
                <button type="button" class="btn-primary btn-sm flex-1" @onclick="Download">Download backup</button>
                <button type="button" class="btn-secondary btn-sm" @onclick="CopyScript">@(copied ? "Copied!" : "Copy script")</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="flex items-center gap-2 px-1 text-[11px] font-medium text-green-600 dark:text-green-400">
        <svg class="w-3.5 h-3.5 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        <span>Backed up @MultisigFormat.When(Config.BackupAt.Value)</span>
    </div>
}

<CollapsePanel Title="Redeem script &amp; backup" @bind-IsOpen="expanded"
               IconPath="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z">
    <p class="text-[11px] font-mono text-slate-500 dark:text-slate-400 break-all leading-relaxed max-h-40 overflow-y-auto select-all bg-slate-50 dark:bg-dgb-950 rounded-xl px-3 py-2.5 border border-slate-100 dark:border-dgb-800">@Config.RedeemScriptHex</p>
    <p class="text-xs text-slate-400 dark:text-slate-500">Share this with co-signers so they can import this multisig. They can also scan the QR code from Import.</p>
    <button type="button" class="self-start inline-flex items-center gap-1 text-[11px] font-semibold text-dgb-500 hover:text-dgb-600 press-effect min-h-[32px]"
            aria-expanded="@showQr" @onclick="() => showQr = !showQr">
        <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5Z" /></svg>
        @(showQr ? "Hide QR code" : "Show QR code")
    </button>
    @if (showQr)
    {
        <div class="flex flex-col items-center gap-2 py-1 fade-in">
            <QrImage Payload="@Config.RedeemScriptHex" Alt="Redeem script QR code" />
            <p class="text-[11px] text-slate-400 dark:text-slate-500 text-center">Scan this from Import on a co-signer's device. Treat it like the backup file: it holds every co-signer's key.</p>
            <button type="button" class="flex items-center justify-center gap-1.5 min-h-[44px] px-3 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-dgb-500 transition-colors" @onclick="DownloadQr">
                <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                Download QR
            </button>
        </div>
    }
    <div class="flex gap-2">
        <button type="button" class="btn-primary btn-sm flex-1" @onclick="Download">Download backup</button>
        <button type="button" class="btn-secondary btn-sm" @onclick="CopyScript">@(copied ? "Copied!" : "Copy script")</button>
    </div>
</CollapsePanel>

@code {
    [Parameter, EditorRequired] public MultisigWalletConfig Config { get; set; } = default!;
    [Parameter] public EventCallback OnBackedUp { get; set; }

    private bool expanded;
    private bool copied;
    private bool showQr;

    private async Task DownloadQr()
    {
        var url = QrImage.ToDataUrl(Config.RedeemScriptHex);
        await JS.InvokeVoidAsync("downloadDataUrl", url, $"multisig-{Config.Address[..Math.Min(8, Config.Address.Length)]}-redeem-script-qr.png");
        await MarkBackedUp();
    }

    private async Task Download()
    {
        var (filename, content) = MultisigWalletService.BuildBackup(Config);
        await JS.InvokeVoidAsync("downloadTextFile", content, filename);
        await MarkBackedUp();
    }

    private async Task CopyScript()
    {
        await Clipboard.CopyAsync(Config.RedeemScriptHex, toast: false);
        copied = true;
        await MarkBackedUp();
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
    }

    private async Task MarkBackedUp()
    {
        await MultisigService.MarkBackedUpAsync(Config.WalletId);
        Config.BackupAt = DateTime.UtcNow;
        await OnBackedUp.InvokeAsync();
    }
}
