@* Redeem-script backup. Until the user downloads the backup file or copies the script it is a prominent warning;
   afterwards it shrinks to one quiet line with the date. The script itself is behind an expander. *@
@inject MultisigWalletService MultisigService
@inject ClipboardService Clipboard
@inject IJSRuntime JS

@if (Config.BackupAt is null)
{
    <div class="rounded-2xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30 p-3" role="alert">
        <div class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-bold text-amber-800 dark:text-amber-300">Back up your redeem script</p>
                <p class="text-[11px] text-amber-700 dark:text-amber-400 leading-relaxed mt-0.5">
                    Your seed phrase alone <b>cannot recover</b> this multisig. Download the backup or copy the script and keep it safe.
                </p>
                <div class="flex items-center gap-2 mt-2 flex-wrap">
                    <button type="button" class="min-h-[44px] px-4 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-xl press-effect" @onclick="Download">Download backup</button>
                    <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-amber-800 dark:text-amber-300" @onclick="CopyScript">@(copied ? "Copied!" : "Copy script")</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="flex items-center gap-2 px-1 text-xs text-green-600 dark:text-green-400">
        <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        <span>Backed up @MultisigFormat.When(Config.BackupAt.Value)</span>
    </div>
}

<div class="rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200/80 dark:border-dgb-800">
    <button type="button" class="w-full flex items-center justify-between gap-2 p-3 min-h-[44px] text-left" aria-expanded="@expanded" @onclick="() => expanded = !expanded">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Redeem script &amp; backup</span>
        <svg class="w-4 h-4 text-slate-400 transition-transform @(expanded ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
    </button>
    @if (expanded)
    {
        <div class="px-3 pb-3 flex flex-col gap-2">
            <p class="text-[11px] font-mono text-slate-500 break-all leading-relaxed max-h-40 overflow-y-auto select-all">@Config.RedeemScriptHex</p>
            <p class="text-[11px] text-slate-400">Share this with co-signers so they can import this multisig.</p>
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-dgb-600 dark:text-dgb-400 bg-dgb-50 dark:bg-dgb-800 rounded-xl press-effect" @onclick="Download">Download backup</button>
                <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-dgb-800 rounded-xl press-effect" @onclick="CopyScript">@(copied ? "Copied!" : "Copy script")</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public MultisigWalletConfig Config { get; set; } = default!;
    [Parameter] public EventCallback OnBackedUp { get; set; }

    private bool expanded;
    private bool copied;

    private async Task Download()
    {
        var (filename, content) = MultisigWalletService.BuildBackup(Config);
        await JS.InvokeVoidAsync("downloadTextFile", content, filename);
        await MarkBackedUp();
    }

    private async Task CopyScript()
    {
        await Clipboard.CopyAsync(Config.RedeemScriptHex, toast: false);
        copied = true;
        await MarkBackedUp();
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
    }

    private async Task MarkBackedUp()
    {
        await MultisigService.MarkBackedUpAsync(Config.WalletId);
        Config.BackupAt = DateTime.UtcNow;
        await OnBackedUp.InvokeAsync();
    }
}
