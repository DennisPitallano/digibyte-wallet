@* The signer cards plus a hidden live region that announces who changed (for screen readers). *@
@inject LocalizationService L
<div>
    <ul class="flex flex-col gap-1.5">
        @foreach (var card in Cards)
        {
            <SignerCard Card="card" />
        }
    </ul>
    <p class="sr-only" role="status" aria-live="polite">@announcement</p>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SignerCardModel> Cards { get; set; } = [];
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private Dictionary<string, (SignerStatus Status, SignerPresence? Presence)> previous = new(StringComparer.OrdinalIgnoreCase);
    private string announcement = "";

    protected override void OnParametersSet()
    {
        var changes = new List<string>();
        foreach (var c in Cards.Where(c => c.PublicKeyHex.Length > 0))
        {
            var name = c.IsYou ? L.T("ms.ui.common.you") : c.DisplayName;
            if (previous.TryGetValue(c.PublicKeyHex, out var old))
            {
                if (old.Status != c.Status) changes.Add($"{name}: {StatusText(c.Status)}");
                if (old.Presence != c.Presence && c.Presence is { } p) changes.Add(PresenceText(c.IsYou, name, p));
            }
        }
        if (changes.Count > 0) announcement = string.Join(". ", changes);
        previous = Cards.Where(c => c.PublicKeyHex.Length > 0).ToDictionary(c => c.PublicKeyHex, c => (c.Status, c.Presence), StringComparer.OrdinalIgnoreCase);
    }

    private string StatusText(SignerStatus s) => s switch
    {
        SignerStatus.Signed => L.T("ms.ui.signerList.signed"),
        SignerStatus.Declined => L.T("ms.ui.signerList.declined"),
        SignerStatus.Ready => L.T("ms.ui.signerList.ready"),
        SignerStatus.Joined => L.T("ms.ui.signerList.joined"),
        _ => L.T("ms.ui.signerList.waiting"),
    };

    // "You" gets its own sentences: Spanish says "Estás en línea", not "Tú está en línea".
    private string PresenceText(bool isYou, string name, SignerPresence presence) => (isYou, presence == SignerPresence.Online) switch
    {
        (true, true) => L.T("ms.ui.signerList.you_online"),
        (true, false) => L.T("ms.ui.signerList.you_offline"),
        (false, true) => L.T("ms.ui.signerList.online", name),
        (false, false) => L.T("ms.ui.signerList.offline", name),
    };
}
