@* One status pill: icon + text, never color alone. Shows a shared state (Pending, Activity, wallet cards, rooms) or a signer status. *@
@inject LocalizationService L
<span class="@Classes" title="@Text">
    <UxIcon Name="@Icon" Class="w-3.5 h-3.5 shrink-0" />
    <span>@Text</span>
</span>

@code {
    [Parameter] public MultisigState? State { get; set; }
    [Parameter] public SignerStatus? Signer { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    /// <summary>
    /// The translation key for a shared state's label (the words of <see cref="MultisigStateVocabulary"/>), so every
    /// multisig component says a state the same way in every language.
    /// </summary>
    public static string StateKey(MultisigState state) => state switch
    {
        MultisigState.NeedsYourSignature => "ms.ui.common.state.needs_signature",
        MultisigState.YouSigned => "ms.ui.common.state.you_signed",
        MultisigState.WaitingForOthers => "ms.ui.common.state.waiting_others",
        MultisigState.ReadyToBroadcast => "ms.ui.common.state.ready",
        MultisigState.LiveRoom => "ms.ui.common.state.live_room",
        MultisigState.Sent => "ms.ui.common.state.sent",
        MultisigState.CancelledOrExpired => "ms.ui.common.state.cancelled_expired",
        MultisigState.Failed => "ms.ui.common.state.failed",
        _ => "ms.ui.common.state.unknown",
    };

    private (string Text, string Icon, UxTone Tone) Resolved
    {
        get
        {
            if (State is { } s)
            {
                var info = MultisigStateVocabulary.For(s);
                return (L.T(StateKey(s)), info.Icon, info.Tone);
            }
            return Signer switch
            {
                SignerStatus.Signed => (L.T("ms.ui.statusBadge.signed"), "check", UxTone.Positive),
                SignerStatus.Declined => (L.T("ms.ui.statusBadge.declined"), "x", UxTone.Warning),
                SignerStatus.Ready => (L.T("ms.ui.statusBadge.ready"), "check", UxTone.Positive),
                SignerStatus.Joined => (L.T("ms.ui.statusBadge.joined"), "user", UxTone.Neutral),
                SignerStatus.NotJoined => (L.T("ms.ui.statusBadge.not_joined"), "clock", UxTone.Neutral),
                _ => (L.T("ms.ui.statusBadge.waiting"), "clock", UxTone.Neutral),
            };
        }
    }

    private string Text => Resolved.Text;
    private string Icon => Resolved.Icon;

    private string Classes => "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap " + Resolved.Tone switch
    {
        UxTone.Positive => "bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-300",
        UxTone.Warning => "bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-300",
        UxTone.Action => "bg-dgb-100 text-dgb-700 dark:bg-dgb-800 dark:text-dgb-200",
        _ => "bg-slate-100 text-slate-600 dark:bg-dgb-800 dark:text-slate-300",
    };
}
