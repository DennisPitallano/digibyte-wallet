@* Dashboard header: back, the multisig's name (tap to rename), its M-of-N badge, and a watch-only chip. *@
<div class="flex items-center gap-3 slide-up">
    <button type="button" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-xl bg-slate-100 dark:bg-dgb-800 hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors"
            aria-label="Back to multisig wallets" @onclick="OnBack">
        <svg class="w-4 h-4 text-slate-600 dark:text-slate-300" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    </button>
    <div class="min-w-0 flex-1">
        <button type="button" class="flex items-center gap-1.5 max-w-full min-h-[44px] text-left group" aria-label="Rename multisig" @onclick="OnRename">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white truncate">@Title</h2>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-dgb-500 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
            </svg>
        </button>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[11px] font-bold text-dgb-600 dark:text-dgb-400 bg-dgb-100 dark:bg-dgb-800 px-2 py-1 rounded-full">@Required-of-@Total</span>
        @if (IsWatchOnly)
        {
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-dgb-800 px-2 py-1 rounded-full" title="This device holds no key of this multisig">Watch-only</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public int Required { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool IsWatchOnly { get; set; }
    [Parameter] public EventCallback OnRename { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
}
