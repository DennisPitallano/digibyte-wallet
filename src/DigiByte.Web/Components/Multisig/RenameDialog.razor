@* A small dialog to rename a multisig, a draft, or a co-signer label. The caller does the saving: OnSave returns the
   result, and the dialog shows its error, or its "name already used" warning, instead of closing. *@
@inject LocalizationService L
@if (IsOpen)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="@TitleText" @onclick="Close">
        <div class="modal-card flex flex-col gap-3" @onclick:stopPropagation="true">
            <h3 class="block-title">@TitleText</h3>
            <label class="flex flex-col gap-1.5">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@LabelText</span>
                <input type="text" @bind="draftName" @bind:event="oninput" maxlength="@MaxLength" autocomplete="off"
                       disabled="@saved" aria-label="@LabelText"
                       @onkeydown="OnKeyDown"
                       class="input" />
                <span class="text-[11px] text-slate-400 text-right">@(draftName?.Length ?? 0)/@MaxLength</span>
            </label>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="text-xs text-red-500" role="alert">@error</p>
            }
            @if (duplicateWarning)
            {
                <p class="text-xs text-amber-600 dark:text-amber-400" role="status">@L.T("ms.ui.rename.duplicate")</p>
            }

            <div class="flex items-center gap-2">
                @if (saved)
                {
                    <button type="button" class="flex-1 min-h-[44px] bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-2xl press-effect" @onclick="Close">@L.T("backup.done_button")</button>
                }
                else
                {
                    <button type="button" class="flex-1 min-h-[44px] bg-dgb-500 hover:bg-dgb-600 disabled:opacity-50 text-white font-semibold rounded-2xl press-effect"
                            disabled="@(isSaving || string.IsNullOrWhiteSpace(draftName))" @onclick="Save">
                        @(isSaving ? L.T("ms.ui.rename.saving") : L.T("history.detail.save"))
                    </button>
                    <button type="button" class="min-h-[44px] px-4 text-sm font-medium text-slate-500 dark:text-slate-400" @onclick="Close">@L.T("common.cancel")</button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Null says "Rename" in the wallet's language.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Null says "Name" in the wallet's language.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Initial { get; set; } = "";
    [Parameter] public int MaxLength { get; set; } = MultisigWalletService.MaxNameLength;

    /// <summary>Saves the new name and says how it went.</summary>
    [Parameter, EditorRequired] public Func<string, Task<RenameResult>> OnSave { get; set; } = _ => Task.FromResult(new RenameResult(false, null, false, null));
    [Parameter] public EventCallback OnClosed { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private string TitleText => Title ?? L.T("ms.ui.rename.title");
    private string LabelText => Label ?? L.T("ms.ui.rename.label");

    private string draftName = "";
    private string? error;
    private bool duplicateWarning;
    private bool saved;
    private bool isSaving;
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            draftName = Initial;
            error = null;
            duplicateWarning = false;
            saved = false;
        }
        wasOpen = IsOpen;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !saved) await Save();
        else if (e.Key == "Escape") await Close();
    }

    private async Task Save()
    {
        if (isSaving) return;
        isSaving = true;
        error = null;
        try
        {
            var result = await OnSave(draftName);
            if (!result.Ok)
            {
                error = result.Error ?? L.T("ms.ui.rename.failed");
                return;
            }
            if (result.DuplicateWarning)
            {
                duplicateWarning = true;
                saved = true;
                return;
            }
            await Close();
        }
        finally { isSaving = false; }
    }

    private async Task Close()
    {
        IsOpen = false;
        wasOpen = false;
        await OnClosed.InvokeAsync();
    }
}
