@* A multisig's activity: a segmented filter like the Receive page's address-format switch, day headings in the
   wallet's small-caps style, rows like the transaction list, and a Load more button. *@
@{
    var visible = MultisigActivityBuilder.Filter(Entries, Filter);
    var groups = MultisigActivityBuilder.GroupByDate(visible);
}
<div class="flex flex-col gap-2">
    @if (ShowFilters)
    {
        <div class="flex bg-slate-100 dark:bg-dgb-900 rounded-xl p-1 gap-0.5 w-full" role="tablist" aria-label="Filter activity">
            @foreach (var f in Enum.GetValues<ActivityFilter>())
            {
                <button type="button" role="tab" aria-selected="@(f == Filter)"
                        class="flex-1 min-h-[36px] py-2 text-[11px] sm:text-xs font-semibold rounded-lg transition-all duration-200 @(f == Filter ? "bg-white dark:bg-dgb-800 text-dgb-500 shadow-sm" : "text-slate-500 dark:text-slate-400")"
                        @onclick="() => OnFilterChanged.InvokeAsync(f)">@f</button>
            }
        </div>
    }

    @if (IsPartial)
    {
        <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl" role="status">
            <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">You're offline or the network is unreachable. Showing only what's saved on this device (proposals and your own sends).</p>
        </div>
    }

    @if (IsLoading && Entries.Count == 0)
    {
        @for (var i = 0; i < 3; i++)
        {
            <div class="h-14 skeleton rounded-xl"></div>
        }
    }
    else if (visible.Count == 0)
    {
        <div class="py-6 text-center">
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">@EmptyTitle</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@EmptyHint</p>
            @if (EmptyActions is not null)
            {
                <div class="flex items-center justify-center gap-2 mt-3">@EmptyActions</div>
            }
        </div>
    }
    else
    {
        @foreach (var (day, items) in groups)
        {
            <h3 class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider pt-1">@MultisigFormat.DayLabel(day)</h3>
            <div class="flex flex-col gap-1.5">
                @foreach (var entry in items)
                {
                    <ActivityItem Entry="entry" OnSelect="OnSelect" />
                }
            </div>
        }
    }

    @if (HasMore)
    {
        <button type="button" class="min-h-[44px] w-full text-xs font-semibold text-dgb-500 hover:text-dgb-600 disabled:opacity-50"
                disabled="@IsLoading" @onclick="() => OnLoadMore.InvokeAsync()">
            @(IsLoading ? "Loading…" : "Load more")
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<ActivityEntry> Entries { get; set; } = [];
    [Parameter] public ActivityFilter Filter { get; set; } = ActivityFilter.All;
    [Parameter] public bool ShowFilters { get; set; } = true;
    [Parameter] public bool IsPartial { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasMore { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No activity yet";
    [Parameter] public string EmptyHint { get; set; } = "Receive funds or create a payment and it will show up here.";
    [Parameter] public RenderFragment? EmptyActions { get; set; }
    [Parameter] public EventCallback<ActivityFilter> OnFilterChanged { get; set; }
    [Parameter] public EventCallback<ActivityEntry> OnSelect { get; set; }
    [Parameter] public EventCallback OnLoadMore { get; set; }
}
