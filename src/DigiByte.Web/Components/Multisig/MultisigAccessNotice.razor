@* Shown instead of a multisig's contents when it can't be opened by the active wallet. Never shows anything about the multisig itself. *@
@inject LocalizationService L
<div class="flex flex-col items-center justify-center gap-4 py-12 text-center" role="alert">
    @switch (State)
    {
        case MultisigAccessState.OtherWallet:
            <h2 class="block-title block-title-lg">@L.T("ms.ui.access.other.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-[280px]">
                @L.T("ms.ui.access.other.body")
            </p>
            break;
        case MultisigAccessState.Unassigned:
            <h2 class="block-title block-title-lg">@L.T("ms.ui.access.unassigned.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-[280px]">
                @L.T("ms.ui.access.unassigned.body")
            </p>
            break;
        default:
            <h2 class="block-title block-title-lg">@L.T("ms.ui.access.not_found.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-[280px]">@L.T("ms.ui.access.not_found.body")</p>
            break;
    }
    <button class="btn-primary btn-sm"
            @onclick='() => Nav.NavigateTo("/multisig")'>@L.T("ms.ui.access.back")</button>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter] public MultisigAccessState State { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }
}
