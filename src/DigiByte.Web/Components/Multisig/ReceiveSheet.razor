@* Receive into a multisig: its address, a QR code, and Copy. *@
@inject ClipboardService Clipboard

@if (IsOpen)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="Receive to multisig" @onclick="Close">
        <div class="modal-card flex flex-col items-center gap-3" @onclick:stopPropagation="true">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Receive DGB</h3>
            <QrImage Payload="@Address" Alt="Multisig address QR code" Class="w-52 h-52 rounded-xl bg-white p-1.5" />
            <p class="text-xs font-mono text-slate-700 dark:text-slate-200 break-all text-center leading-relaxed select-all">@Address</p>
            <div class="flex items-center gap-2 w-full">
                <button type="button" class="flex-1 min-h-[44px] bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-2xl press-effect" @onclick="Copy">
                    @(copied ? "Copied!" : "Copy address")
                </button>
                <button type="button" class="min-h-[44px] px-4 text-sm font-medium text-slate-500 dark:text-slate-400" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public string Address { get; set; } = "";
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool copied;

    private async Task Copy()
    {
        await Clipboard.CopyAsync(Address, toast: false);
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
    }

    private async Task Close()
    {
        IsOpen = false;
        await OnClosed.InvokeAsync();
    }
}
