@* A folded section in the style of the Receive page's "Request a specific amount" and "Your addresses" panels. *@
<div class="w-full bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800">
    <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2.5 min-h-[44px] text-left"
            aria-expanded="@(IsOpen ? "true" : "false")" @onclick="Toggle">
        <span class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 min-w-0">
            <svg class="w-4 h-4 text-dgb-500 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="@IconPath" />
            </svg>
            <span class="truncate">@Title</span>
        </span>
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-200 @(IsOpen ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
    </button>
    @if (IsOpen)
    {
        <div class="px-3 pb-3 flex flex-col gap-2 fade-in">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string IconPath { get; set; } = "M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm0 5.25h.007v.008H3.75V12Zm0 5.25h.007v.008H3.75v-.008Z";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task Toggle()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
