@* Says where you are on every screen of a shared wallet: its name, its scheme, and the personal wallet it belongs
   to, with that wallet's colour (specs/026-multisig-wallet-experience, FR-001). It is one button: it opens the
   switcher, which is how you leave or move to another shared wallet (FR-005). The switcher itself belongs to the
   menu (Layout/NavMenu), so it opens above everything; this button only asks for it.
   The dashboard already has the name and scheme as its title, so it sets ShowName to false. *@
@inject ActiveWalletContext ActiveWallet
@inject ShellActions Shell
@inject LocalizationService L

@if (Static)
{
    <p class="context-line context-line-static" data-testid="shared-context-line">
        <svg class="context-line-icon" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
        </svg>
        <span class="context-line-name">@Config.DisplayName</span>
        <span class="context-line-scheme">@L.T("ms.ui.common.scheme", Config.RequiredSignatures, Config.TotalSigners)</span>
        <span class="context-line-in">@L.T("ms.ui.contextLine.in")</span>
        <span class="context-line-dot" style="background-color: @ActiveWallet.WalletColor;" aria-hidden="true"></span>
        <span class="context-line-name">@ActiveWallet.WalletName</span>
    </p>
    return;
}

<button type="button" class="context-line" aria-haspopup="dialog"
        aria-label="@AriaLabel" data-testid="shared-context-line" @onclick="Shell.RequestSwitcher">
    <svg class="context-line-icon" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
    </svg>
    @if (ShowName)
    {
        <span class="context-line-name">@Config.DisplayName</span>
        <span class="context-line-scheme">@L.T("ms.ui.common.scheme", Config.RequiredSignatures, Config.TotalSigners)</span>
    }
    else
    {
        <span class="context-line-kind">@L.T("ms.ui.contextLine.kind")</span>
    }
    <span class="context-line-in">@L.T("ms.ui.contextLine.in")</span>
    <span class="context-line-dot" style="background-color: @ActiveWallet.WalletColor;" aria-hidden="true"></span>
    <span class="context-line-name">@ActiveWallet.WalletName</span>
    <svg class="context-line-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
</button>

@code {
    [Parameter, EditorRequired] public MultisigWalletConfig Config { get; set; } = default!;

    /// <summary>False where the page title already shows the shared wallet's name and scheme (the dashboard).</summary>
    [Parameter] public bool ShowName { get; set; } = true;

    /// <summary>
    /// True where it only says where you are and opens nothing: the signing room, which hides the menu that owns
    /// the switcher. Leaving there is done with Back or the room menu.
    /// </summary>
    [Parameter] public bool Static { get; set; }

    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private string AriaLabel => L.T("ms.ui.contextLine.aria", Config.DisplayName,
        L.T("ms.ui.common.scheme", Config.RequiredSignatures, Config.TotalSigners), ActiveWallet.WalletName);
}
