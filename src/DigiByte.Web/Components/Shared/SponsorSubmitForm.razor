@using DigiByte.P2P.Shared.Sponsors
@implements IAsyncDisposable
@inject SponsorSubmissionClient Submissions
@inject IJSRuntime JS

@* "Add me to the list": a donor with no GitHub account asks to be listed (or removed). The server checks the donation automatically and opens a
   pull request for a maintainer to review. This form never reads or sends wallet data. *@

<div class="bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-5 flex flex-col gap-4">
    @if (done)
    {
        <div class="text-center py-2" role="status">
            <p class="text-base font-semibold text-slate-900 dark:text-white">@doneTitle</p>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@doneText</p>
        </div>
    }
    else
    {
        <div class="flex rounded-xl bg-slate-100 dark:bg-dgb-800 p-1 text-sm font-semibold" role="tablist">
            <button type="button" role="tab" aria-selected="@(!removing)" class="flex-1 py-1.5 rounded-lg @(!removing ? "bg-white dark:bg-dgb-900 shadow text-slate-900 dark:text-white" : "text-slate-500 dark:text-slate-400")" @onclick="() => SetMode(false)">Add me</button>
            <button type="button" role="tab" aria-selected="@removing" class="flex-1 py-1.5 rounded-lg @(removing ? "bg-white dark:bg-dgb-900 shadow text-slate-900 dark:text-white" : "text-slate-500 dark:text-slate-400")" @onclick="() => SetMode(true)">Remove me</button>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400">
            @if (removing)
            {
                <text>Use the transaction ID of the donation that created your entry. A maintainer reviews the request.</text>
            }
            else
            {
                <text>Donate at least 1 DGB to the project, wait for about 3 confirmations, then paste the transaction ID here. We check it automatically; a maintainer reviews your entry before it appears.</text>
            }
        </p>

        @if (!removing)
        {
            <label class="flex flex-col gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                Name to show
                <input type="text" maxlength="@SponsorRules.NameMaxLength" @bind="name" @bind:event="oninput" autocomplete="off"
                       class="px-3 py-2 rounded-xl border @Border("name") bg-white dark:bg-dgb-950 text-sm font-normal text-slate-900 dark:text-white" />
                @FieldError("name", "Enter a name of 1 to 60 characters.")
            </label>
            <label class="flex flex-col gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                Link (optional, https only)
                <input type="url" maxlength="@SponsorRules.LinkMaxLength" @bind="link" @bind:event="oninput" autocomplete="off" placeholder="https://"
                       class="px-3 py-2 rounded-xl border @Border("link") bg-white dark:bg-dgb-950 text-sm font-normal text-slate-900 dark:text-white" />
                @FieldError("link", "Use a full https:// link, or leave it empty.")
            </label>
            <div class="flex flex-col gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                Picture (optional)
                <div class="flex items-center gap-3">
                    @if (previewUrl is not null)
                    {
                        <img src="@previewUrl" alt="Your picture" class="w-14 h-14 rounded-xl object-cover" />
                    }
                    <input type="file" accept="image/png,image/jpeg,image/webp" @ref="fileInput" @onchange="OnPictureChosen"
                           class="text-xs font-normal text-slate-500 dark:text-slate-400" aria-label="Picture" />
                </div>
                @if (pictureError is not null)
                {
                    <span class="text-[11px] font-normal text-red-600 dark:text-red-400">@pictureError</span>
                }
                else
                {
                    <span class="text-[11px] font-normal text-slate-400">It's shrunk to a small square before it's sent.</span>
                }
            </div>
        }

        <label class="flex flex-col gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
            Donation transaction ID
            <input type="text" maxlength="@SponsorRules.TxIdLength" @bind="txid" @bind:event="oninput" autocomplete="off" spellcheck="false" placeholder="64 characters (0-9, a-f)"
                   class="px-3 py-2 rounded-xl border @Border("txid") bg-white dark:bg-dgb-950 text-xs font-mono font-normal text-slate-900 dark:text-white" />
            @FieldError("txid", "A transaction ID is 64 characters using 0-9 and a-f.")
        </label>

        @* Honeypot: hidden from people and screen readers; only bots fill it in. *@
        <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
            <label>Website <input type="text" tabindex="-1" autocomplete="off" @bind="website" /></label>
        </div>

        @if (!removing)
        {
            <label class="flex items-start gap-2 text-xs text-slate-600 dark:text-slate-300">
                <input type="checkbox" @bind="consent" class="mt-0.5" />
                <span>I am the person named above, or I have their permission to list them.</span>
            </label>
            @FieldError("consent", "Please confirm this to continue.")
        }

        <p class="text-[11px] text-slate-400">
            Your name, link, picture and transaction ID will appear publicly in a pull request on GitHub. Don't enter anything private.
        </p>

        @if (message is not null)
        {
            <p class="text-sm text-amber-700 dark:text-amber-300" role="alert">@message</p>
        }

        <button type="button" disabled="@submitting" @onclick="SubmitAsync"
                class="w-full py-2.5 text-sm font-semibold text-center rounded-xl bg-dgb-500 hover:bg-dgb-600 disabled:opacity-60 text-white shadow-lg shadow-dgb-500/25 press-effect transition-colors">
            @(submitting ? "Sending…" : removing ? "Request removal" : "Send for review")
        </button>
    }
</div>

@code {
    private ElementReference fileInput;
    private bool removing;
    private string name = "", link = "", txid = "", website = "";
    private bool consent;
    private string? pictureBase64, pictureType, previewUrl, pictureError, message;
    private bool submitting, done, showErrors;
    private string doneTitle = "", doneText = "";
    private readonly HashSet<string> serverInvalid = [];

    private void SetMode(bool remove)
    {
        removing = remove;
        message = null;
        showErrors = false;
        serverInvalid.Clear();
    }

    private bool HasError(string field) => (showErrors || serverInvalid.Contains(field)) && Failing().Contains(field) || serverInvalid.Contains(field);

    private string Border(string field) => HasError(field)
        ? "border-red-400 dark:border-red-500"
        : "border-slate-200 dark:border-dgb-800";

    private RenderFragment FieldError(string field, string text) => builder =>
    {
        if (!HasError(field)) return;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "text-[11px] font-normal text-red-600 dark:text-red-400");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    // The same rules the server applies (shared in DigiByte.P2P.Shared), so nothing invalid is ever sent.
    private HashSet<string> Failing()
    {
        var bad = new HashSet<string>();
        if (!SponsorRules.IsValidTxId(txid.Trim())) bad.Add("txid");
        if (!removing)
        {
            if (!SponsorRules.TryNormalizeName(name, out _)) bad.Add("name");
            if (!string.IsNullOrWhiteSpace(link) && !SponsorRules.IsValidLink(link.Trim())) bad.Add("link");
            if (!consent) bad.Add("consent");
        }
        return bad;
    }

    private async Task OnPictureChosen()
    {
        pictureError = null;
        await ClearPictureAsync();
        try
        {
            var result = await JS.InvokeAsync<PictureResult?>("sponsorsImage.prepare", fileInput);
            if (result is null) return;
            if (result.Error is not null)
            {
                pictureError = result.Error == "type"
                    ? "Choose a PNG, JPEG or WebP picture."
                    : "That picture can't be used. Try a smaller or simpler one.";
                return;
            }
            pictureBase64 = result.Base64;
            pictureType = result.ContentType;
            previewUrl = result.PreviewUrl;
        }
        catch (Exception)
        {
            pictureError = "That picture can't be used. Try a smaller or simpler one.";
        }
    }

    private async Task ClearPictureAsync()
    {
        if (previewUrl is not null)
        {
            try { await JS.InvokeVoidAsync("sponsorsImage.revoke", previewUrl); } catch (Exception) { }
        }
        previewUrl = pictureBase64 = pictureType = null;
    }

    private async Task SubmitAsync()
    {
        message = null;
        serverInvalid.Clear();
        showErrors = true;
        if (Failing().Count > 0) return;

        submitting = true;
        try
        {
            var result = await Submissions.SubmitAsync(new SponsorSubmission(
                removing ? SponsorSubmissionType.Remove : SponsorSubmissionType.Add,
                removing ? null : name.Trim(),
                removing || string.IsNullOrWhiteSpace(link) ? null : link.Trim(),
                txid.Trim(),
                consent,
                removing || pictureBase64 is null ? null : Convert.FromBase64String(pictureBase64),
                pictureType,
                website));
            Apply(result);
        }
        finally
        {
            submitting = false;
        }
    }

    private void Apply(SponsorSubmissionResult result)
    {
        switch (result.State)
        {
            case SponsorSubmissionState.Created:
                done = true;
                doneTitle = removing ? "Removal requested" : "Submitted, awaiting review";
                doneText = removing
                    ? "A maintainer will review it. Once it is merged, your entry disappears from the list."
                    : "Thank you! A maintainer will review your entry. Once it is merged, it shows up on this page within about 10 minutes.";
                break;
            case SponsorSubmissionState.Duplicate:
                done = true;
                doneTitle = "Already submitted, awaiting review";
                doneText = "We already have this one. A maintainer will review it soon.";
                break;
            case SponsorSubmissionState.Invalid:
                foreach (var field in result.Fields ?? []) serverInvalid.Add(field);
                message = "Some details need fixing. Check the highlighted fields and try again.";
                break;
            case SponsorSubmissionState.NotVerified:
                message = result.Reason switch
                {
                    DonationRejection.NotFound => "We couldn't find that transaction yet. Check the ID, or wait a minute and try again.",
                    DonationRejection.TooFewConfirmations => "That donation needs a few more confirmations. Please try again in a couple of minutes.",
                    DonationRejection.WrongRecipient => "That transaction didn't pay the project's donation address. Please check the ID and send the right one.",
                    DonationRejection.BelowMinimum => "That donation is below the 1 DGB minimum for listing. You can donate more and use the new ID.",
                    _ => "We couldn't confirm that donation. Please check the ID and try again.",
                };
                break;
            case SponsorSubmissionState.AlreadyUsed:
                message = "That donation has already been used for a listing. Use a different donation's transaction ID.";
                break;
            case SponsorSubmissionState.RateLimited:
                message = "You've sent several requests recently. Please try again in about an hour.";
                break;
            case SponsorSubmissionState.QueueFull:
                message = "We're getting a lot of requests right now. Please try again later.";
                break;
            default:
                message = "We couldn't send that just now. Please try again later.";
                break;
        }
    }

    public async ValueTask DisposeAsync() => await ClearPictureAsync();

    private sealed class PictureResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("base64")] public string? Base64 { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("contentType")] public string? ContentType { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("previewUrl")] public string? PreviewUrl { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("error")] public string? Error { get; set; }
    }
}
