@implements IDisposable
@inject LocalizationService L

@* Shown beside every Digi-ID address that is displayed in full or can be copied (spec 009, FR-001/FR-002).
   Always visible and not dismissible: a Digi-ID address is a real DigiByte address, so someone could pay it, and the wallet
   does not watch it. The link leads to the "Recover funds" section on the Identity page. *@
<div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/10 rounded-xl border border-amber-200/60 dark:border-amber-900/30 @(Compact ? "px-2.5 py-2" : "px-3 py-2.5")"
     role="note" aria-label="@L.T("identity.addrWarning.title")">
    <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <div class="min-w-0 flex flex-col gap-1">
        <p class="@(Compact ? "text-[11px]" : "text-xs") text-amber-700 dark:text-amber-400 leading-relaxed">
            <b>@L.T("identity.addrWarning.title").</b> @L.T("identity.addrWarning.body")
        </p>
        <a href="/identity#recover-funds" @onclick="OnLinkClicked"
           class="@(Compact ? "text-[11px]" : "text-xs") font-semibold text-amber-800 dark:text-amber-300 underline underline-offset-2 hover:text-amber-900 dark:hover:text-amber-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded">@L.T("identity.addrWarning.link")</a>
    </div>
</div>

@code {
    /// <summary>Smaller padding and text, for the login detail dialog.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Raised when the link is followed, so a dialog showing the warning can close itself.</summary>
    [Parameter] public EventCallback OnLinkClicked { get; set; }

    protected override void OnInitialized() => L.OnLocaleChanged += OnLocaleChanged;

    private void OnLocaleChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnLocaleChanged -= OnLocaleChanged;
}
