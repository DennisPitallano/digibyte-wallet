@implements IDisposable
@inject NodeSourceStatusService Status

@* Small "may be out of date" tag shown next to the balance while no data source is reachable (FR-012). Only when node use is
   switched on, so behaviour with the feature off is unchanged. The last known balance itself comes from the cache Home already keeps. *@
@if (Status.View.Visible && Status.AllSourcesFailed)
{
    <span class="text-[9px] font-bold text-amber-700 dark:text-amber-300 bg-amber-500/20 px-1.5 py-0.5 rounded-full"
          title="No data source is reachable. Showing your last known balance.">May be out of date</span>
}

@code {
    protected override void OnInitialized() => Status.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnChanged;
}
