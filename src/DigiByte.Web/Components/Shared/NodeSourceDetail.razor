@using DigiByte.Wallet.Services

@* Detail panel for the data-source indicator: names the active source in plain language. Opened on demand only
   (specs/005-wallet-own-node-source/contracts/status-ui.md). *@
@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-card flex flex-col gap-4 max-h-[85vh] overflow-y-auto" tabindex="-1" role="dialog" aria-modal="true"
             aria-label="Data source" @ref="card" @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Data source</h3>
                <span class="mt-1.5 w-2.5 h-2.5 rounded-full flex-shrink-0 @DotClass" aria-hidden="true"></span>
            </div>

            <p class="text-sm text-slate-700 dark:text-slate-200">@View.Detail</p>

            @if (View.PrivacyLine is { } privacy)
            {
                <p class="text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-dgb-950 rounded-xl p-3">@privacy</p>
            }

            <button class="w-full py-3 bg-slate-100 dark:bg-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors"
                    @onclick="Close">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public NodeSourceStatusView View { get; set; } = default!;
    [Parameter] public EventCallback OnClosed { get; set; }

    private ElementReference card;
    private bool focusPending;
    private bool wasOpen;

    private string DotClass => View.Dot switch
    {
        NodeSourceDot.Green => "bg-green-500",
        NodeSourceDot.Amber => "bg-amber-500",
        NodeSourceDot.Red => "bg-red-500",
        _ => "bg-slate-400",
    };

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen) focusPending = true;
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the dialog so Escape works without a click first.
        if (focusPending && IsOpen)
        {
            focusPending = false;
            try { await card.FocusAsync(); } catch { }
        }
    }

    private async Task Close() => await OnClosed.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
