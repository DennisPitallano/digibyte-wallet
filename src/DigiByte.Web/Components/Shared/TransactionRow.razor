@* One row of a transaction list: direction icon, date, amount and confirmations. Shared by Home and the All transactions page. *@
<div class="flex items-center gap-3 px-3 py-2.5 bg-white dark:bg-dgb-900/60 rounded-xl border border-slate-100 dark:border-dgb-800/40 cursor-pointer hover:bg-slate-50 dark:hover:bg-dgb-800/40 transition-colors"
     role="button" tabindex="0" @onclick="() => OnOpen.InvokeAsync(Tx)">
    <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 @(sent ? "bg-red-50 dark:bg-red-900/20" : "bg-green-50 dark:bg-green-900/20")">
        <svg class="w-4 h-4 @(sent ? "text-red-500" : "text-green-500")" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            @if (sent)
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
            }
            else
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
            }
        </svg>
    </div>
    <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-slate-900 dark:text-white">@(sent ? "Sent" : "Received")</p>
        <p class="text-[10px] text-slate-400 dark:text-slate-500">@Tx.Timestamp.ToString("MMM d, h:mm tt")</p>
    </div>
    <div class="text-right">
        <p class="text-xs font-bold @(sent ? "text-red-500" : "text-green-500")">
            @(sent ? "-" : "+")@Tx.AmountDgb.ToString("N4") DGB
        </p>
        <ConfirmationBadge Confirmations="Tx.Confirmations" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TransactionRecord Tx { get; set; } = default!;
    [Parameter] public EventCallback<TransactionRecord> OnOpen { get; set; }

    private bool sent => Tx.Direction == TransactionDirection.Sent;
}
