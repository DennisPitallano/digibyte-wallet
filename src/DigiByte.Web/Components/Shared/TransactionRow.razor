@* One row of a transaction list: direction icon, who it was with (when known), time, memo, amount, fiat value and confirmations.
   Shared by Home and the All transactions page. *@
@using System.Globalization
@inject LocalizationService L
<div class="flex items-center gap-3 px-3 py-2.5 bg-white dark:bg-dgb-900/60 rounded-xl border border-slate-100 dark:border-dgb-800/40 cursor-pointer hover:bg-slate-50 dark:hover:bg-dgb-800/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dgb-500/40"
     role="button" tabindex="0" aria-label="@AriaLabel" @onclick="Open" @onkeydown="OnKeyDown">
    <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 @(isDd ? "bg-dgb-50 dark:bg-dgb-900/40" : sent ? "bg-red-50 dark:bg-red-900/20" : "bg-green-50 dark:bg-green-900/20")">
        @if (isDd)
        {
            @* A DigiDollar transaction: the dollar sign instead of a direction arrow, because it moves no DGB. *@
            <span class="text-sm font-bold text-dgb-500 dark:text-dgb-300" aria-hidden="true">$</span>
        }
        else
        {
        <svg class="w-4 h-4 @(sent ? "text-red-500" : "text-green-500")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            @if (sent)
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
            }
            else
            {
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
            }
        </svg>
        }
    </div>
    <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-slate-900 dark:text-white truncate">@Title</p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 truncate">
            @WhenText
            @if (!string.IsNullOrWhiteSpace(Tx.Memo))
            {
                <span> · @Tx.Memo</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(WalletAddressText))
        {
            <p class="text-[11px] text-slate-400 dark:text-slate-500 truncate" title="@WalletAddressText">
                <span class="font-mono">@ShortAddress(WalletAddressText)</span>@if (WalletAddressMore > 0)
                {
                    <span> @L.T("history.row.more_addresses", WalletAddressMore)</span>
                }
            </p>
        }
    </div>
    <div class="text-right flex-shrink-0">
        @if (HideAmounts)
        {
            <p class="text-xs font-bold text-slate-400 dark:text-slate-500 balance-mask" aria-label="@L.T("history.amount_hidden")">••••</p>
        }
        else if (isDd)
        {
            @* The dollar amounts of the DD outputs; the only DGB involved is the fee, shown below. *@
            <p class="text-xs font-bold tabular-nums text-slate-700 dark:text-slate-200">@Tx.DigiDollar!.OutputsText</p>
        }
        else
        {
            <p class="text-xs font-bold tabular-nums @(sent ? "text-red-500" : "text-green-500")">
                @(sent ? "-" : "+")@Tx.AmountDgb.ToString("N4") DGB
            </p>
        }
        <div class="flex items-center justify-end gap-1.5">
            @if (isDd && !HideAmounts)
            {
                <span class="text-[11px] tabular-nums text-slate-400 dark:text-slate-500">@L.T("history.row.fee", FeeText)</span>
            }
            else if (!HideAmounts && FiatPrice > 0)
            {
                <span class="text-[11px] tabular-nums text-slate-400 dark:text-slate-500">≈ @FiatSymbol@FiatText</span>
            }
            <ConfirmationBadge Confirmations="Tx.Confirmations" Verification="Tx.Verification" />
        </div>
    </div>
</div>

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    [Parameter, EditorRequired] public TransactionRecord Tx { get; set; } = default!;
    [Parameter] public EventCallback<TransactionRecord> OnOpen { get; set; }

    /// <summary>Contact or address-label name for the other side, when the caller knows one.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Fiat price of one DGB; 0 leaves the fiat value out.</summary>
    [Parameter] public decimal FiatPrice { get; set; }
    [Parameter] public string FiatSymbol { get; set; } = "";
    [Parameter] public int FiatDecimals { get; set; } = 2;

    /// <summary>The user chose to hide balances: amounts show as dots.</summary>
    [Parameter] public bool HideAmounts { get; set; }

    /// <summary>Show only the time (the list already has a day heading above this row).</summary>
    [Parameter] public bool TimeOnly { get; set; }

    /// <summary>The user's own address (or its label) this transaction used; nothing extra is shown when empty.</summary>
    [Parameter] public string? WalletAddressText { get; set; }

    /// <summary>How many other wallet addresses the transaction used besides <see cref="WalletAddressText"/>.</summary>
    [Parameter] public int WalletAddressMore { get; set; }

    /// <summary>Shortens a long address to its start and end; a label or short text is shown as is.</summary>
    private static string ShortAddress(string text) =>
        text.Length > 22 && !text.Contains(' ') ? $"{text[..10]}…{text[^6..]}" : text;

    private bool sent => Tx.Direction == TransactionDirection.Sent;

    /// <summary>A DigiDollar transaction: it moves no DGB apart from its fee.</summary>
    private bool isDd => Tx.DigiDollar is not null;

    /// <summary>The network fee with enough decimals to read: a few thousand satoshis is 0.0000X DGB.</summary>
    private string FeeText => (Tx.FeeSatoshis / 100_000_000m).ToString("0.########");

    private string DisplayName => !string.IsNullOrWhiteSpace(Name) ? Name! : Tx.CounterpartyName ?? "";

    private string Title => isDd ? Tx.DigiDollar!.Label : DisplayName.Length > 0
        ? (sent ? L.T("history.to_name", DisplayName) : L.T("history.from_name", DisplayName))
        : (sent ? L.T("history.sent") : L.T("history.received"));

    private string WhenText
    {
        get
        {
            var local = Tx.Timestamp.ToLocalTime();
            var culture = CultureInfo.CurrentCulture;
            var time = local.ToString("t", culture);
            if (TimeOnly) return time;
            var today = DateTime.Now.Date;
            if (local.Date == today) return L.T("history.when.today", time);
            if (local.Date == today.AddDays(-1)) return L.T("history.when.yesterday", time);
            return local.Year == today.Year
                ? L.T("history.when.date_time", local.ToString(L.T("history.format.month_day"), culture), time)
                : local.ToString(L.T("history.format.month_day_year"), culture);
        }
    }

    private string FiatText
    {
        get
        {
            var v = Tx.AmountDgb * FiatPrice;
            if (v >= 1m) return v.ToString("N" + FiatDecimals);
            return v >= 0.01m ? v.ToString("N2") : "<0.01";
        }
    }

    private string AriaLabel => HideAmounts
        ? L.T("history.row.aria_hidden", Title, WhenText)
        : isDd
            ? L.T("history.row.aria_dd", Title, Tx.DigiDollar!.OutputsText, FeeText, WhenText)
            : L.T("history.row.aria", Title, Tx.AmountDgb.ToString("N4"), WhenText);

    private Task Open() => OnOpen.InvokeAsync(Tx);

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? Open() : Task.CompletedTask;
}
