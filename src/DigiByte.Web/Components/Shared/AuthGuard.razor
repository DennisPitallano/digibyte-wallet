@inject WalletService WalletService
@inject AppState AppState
@inject NavigationManager Nav
@implements IDisposable

@if (isLoading)
{
    <div class="flex flex-col items-center justify-center min-h-[60vh] gap-4">
        <div class="relative">
            <div class="absolute inset-0 bg-dgb-500/20 rounded-full blur-2xl scale-150 glow-pulse"></div>
            <div class="relative animate-pulse">
                <DigiLogo Size="56" />
            </div>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 bg-dgb-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
            <div class="w-1.5 h-1.5 bg-dgb-500 rounded-full animate-bounce" style="animation-delay: 0.15s"></div>
            <div class="w-1.5 h-1.5 bg-dgb-500 rounded-full animate-bounce" style="animation-delay: 0.3s"></div>
        </div>
    </div>
}
else if (WalletService.IsUnlocked)
{
    @* The wallet's own session decides, not AppState.IsWalletUnlocked: the two can disagree after a reload or a lock,
       and a page shown over a locked session throws the first time it needs a key (UnlockGate). *@
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnAppStateChanged;
        var wallets = await WalletService.GetAllWalletsAsync();
        if (UnlockGate.RedirectFor(UnlockGate.Decide(wallets.Count > 0, WalletService.IsUnlocked)) is { } to)
        {
            if (to == UnlockGate.UnlockPath) AppState.IsWalletUnlocked = false;
            Nav.NavigateTo(to);
            return;
        }

        AppState.IsWalletCreated = true;
        AppState.IsWalletUnlocked = true;
        isLoading = false;
    }

    // Locked while the page is open (any lock path, including ones that only flip AppState): leave for the unlock screen.
    private void OnAppStateChanged()
    {
        // No wallet left (wiped, last one deleted): the page doing that goes to /welcome itself.
        if (isLoading || WalletService.IsUnlocked || !AppState.IsWalletCreated) return;
        _ = InvokeAsync(() =>
        {
            if (WalletService.IsUnlocked || !AppState.IsWalletCreated) return;
            AppState.IsWalletUnlocked = false;
            if (!Nav.Uri.Contains(UnlockGate.UnlockPath, StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo(UnlockGate.UnlockPath);
            StateHasChanged();
        });
    }

    public void Dispose() => AppState.OnChange -= OnAppStateChanged;
}
