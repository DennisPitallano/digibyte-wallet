@inject WalletService WalletService
@inject LocalizationService L

@* The wallet chooser on the Unlock screen. The screen used to list every other wallet under the PIN field, which
   pushed the page into scrolling once there were more than a few. The wallet's name is now a button that opens
   this sheet; the list scrolls inside it. *@
@if (IsOpen)
{
    <div class="fixed inset-0 z-[60] flex items-end justify-center" role="dialog" aria-modal="true"
         aria-labelledby="unlock-wallet-sheet-title" data-testid="unlock-wallet-sheet"
         @onclick="OnClose" @onkeydown="OnKeyDown">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

        <div class="relative w-full max-w-[480px] bg-white dark:bg-dgb-950 rounded-t-3xl shadow-2xl slide-up safe-area-bottom"
             @onclick:stopPropagation="true">
            <div class="flex justify-center pt-3 pb-1" aria-hidden="true">
                <div class="w-10 h-1 rounded-full bg-slate-300 dark:bg-dgb-700"></div>
            </div>

            <div class="flex items-center justify-between px-5 pb-3">
                <h3 id="unlock-wallet-sheet-title" class="block-title">@L.T("unlock.choose_wallet")</h3>
                <button type="button" class="icon-btn icon-btn-sm" @onclick="OnClose" aria-label="@L.T("more.close")">
                    <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="px-4 pb-4 max-h-[40vh] overflow-y-auto flex flex-col gap-2">
                @foreach (var wallet in Wallets)
                {
                    var isCurrent = wallet.Id == CurrentWalletId;
                    var isUnlocked = WalletService.IsWalletUnlockedInSession(wallet.Id);
                    var color = wallet.Color ?? "#0066FF";
                    <button type="button" data-testid="unlock-wallet-option"
                            aria-current="@(isCurrent ? "true" : "false")"
                            class="w-full flex items-center gap-3 p-3.5 rounded-2xl border transition-all text-left
                                   @(isCurrent
                                       ? "border-dgb-300 dark:border-dgb-600"
                                       : "bg-white dark:bg-dgb-900 border-slate-200 dark:border-dgb-800 hover:border-dgb-300 dark:hover:border-dgb-600")"
                            style="@(isCurrent ? $"background-color: {color}12; border-color: {color}40;" : "")"
                            @onclick="() => OnSelect.InvokeAsync(wallet)">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" aria-hidden="true"
                             style="background-color: @(isCurrent ? color : $"{color}18"); color: @(isCurrent ? "white" : color);">
                            @if (isUnlocked)
                            {
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@wallet.Name</p>
                                @if (wallet.WalletType == "xpub")
                                {
                                    <span class="text-[11px] font-bold text-sky-600 dark:text-sky-400 bg-sky-100 dark:bg-sky-900/30 px-1.5 py-0.5 rounded-full uppercase flex-shrink-0">@L.T("unlock.badge_watch")</span>
                                }
                                else if (wallet.WalletType == "privatekey")
                                {
                                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/30 px-1.5 py-0.5 rounded-full uppercase flex-shrink-0">@L.T("unlock.badge_wif")</span>
                                }
                            </div>
                            <p class="text-[11px] @(isUnlocked ? "text-green-500" : "text-slate-400 dark:text-slate-500")">
                                @L.T(isUnlocked ? "unlock.wallet_unlocked" : "unlock.wallet_locked")
                            </p>
                        </div>

                        @if (isCurrent)
                        {
                            <svg class="w-5 h-5 flex-shrink-0" style="color: @color;" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public List<WalletInfo> Wallets { get; set; } = [];
    [Parameter] public string? CurrentWalletId { get; set; }
    [Parameter] public EventCallback<WalletInfo> OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
