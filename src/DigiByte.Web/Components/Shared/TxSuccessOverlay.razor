@inject IJSRuntime JS
@inject SoundService Sounds
@inject BakuService Baku
@inject LocalizationService L
@* A send that went out: the same raised card as the first-payment celebration (docs/UI_STYLE.md). The page that shows it
   moves on by itself after a moment, so there is nothing to press. *@

<div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="tx-success-title" data-testid="tx-success">
    <div class="card-raised celebrate-card">
        <div class="celebrate-medal" aria-hidden="true">
            @* Moving decoration: left out when the device asks for reduced motion. *@
            <div class="celebrate-decor confetti-container" style="top:50%; left:50%; transform:translate(-50%,-50%);">
                @for (int i = 0; i < 18; i++)
                {
                    var angle = i * 20;
                    var distance = 50 + (i % 3) * 30;
                    var delay = (i * 0.04);
                    var color = _colors[i % _colors.Length];
                    var x = Math.Cos(angle * Math.PI / 180) * distance;
                    var y = Math.Sin(angle * Math.PI / 180) * distance;
                    <div class="confetti-particle"
                         style="left:calc(50% + @(x.ToString("F0", Inv))px); top:calc(50% + @(y.ToString("F0", Inv))px); background:@color; animation-delay:@(delay.ToString("F2", Inv))s; animation-duration:@((0.8 + i % 4 * 0.15).ToString("F2", Inv))s; width:@(4 + i % 3 * 2)px; height:@(4 + i % 3 * 2)px; border-radius:@(i % 2 == 0 ? "50%" : "1px");"></div>
                }
            </div>
            <div class="celebrate-decor success-ring"></div>
            <div class="celebrate-decor success-ring success-ring-2"></div>
            <div class="celebrate-coin">
                <SpinningCoin Size="72" />
            </div>
            <div class="celebrate-check">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
            </div>
        </div>

        <h3 id="tx-success-title" class="celebrate-title">@L.T("send.success.title")</h3>
        <div>
            <p class="celebrate-amount @(AmountText.Length > 9 ? "is-long" : "")" data-testid="tx-success-amount">@AmountText <span class="celebrate-unit">DGB</span></p>
            @if (RecipientCount > 1)
            {
                <p class="celebrate-detail mt-1">@L.T("send.success.recipients", RecipientCount)</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(Note))
        {
            <p class="celebrate-note" data-testid="send-note">@Note</p>
        }
        @if (!string.IsNullOrEmpty(TxId))
        {
            <p class="celebrate-txid" title="@TxId" data-testid="tx-success-txid">@ShortTxId</p>
        }

        @* Baku approves, only when the mascot is fully on. Its catalog title repeats the heading, so only the sentence shows. *@
        @if (Baku.Mode == BakuMode.Full && BakuCatalog.Find("send.done") is { } line)
        {
            <div class="celebrate-baku baku-celebrate">
                <img src="@BakuCatalog.PosePath(line.PoseId)" alt="" class="w-10 flex-shrink-0 object-contain select-none" draggable="false" />
                <p>@line.Body</p>
            </div>
        }
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("domHelpers.haptic", new[] { 15, 40, 25 }); } catch { }
            await Sounds.PlayAsync(Sound.Send);
        }
    }

    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string? TxId { get; set; }
    [Parameter] public int RecipientCount { get; set; } = 1;

    /// <summary>An extra line under the amount, such as "sent, not yet confirmed by peers".</summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    // Every digit that was sent, without trailing zeros.
    // Screen text: the chosen language's number style (spec 028).
    private string AmountText => Amount.ToString("0.########", System.Globalization.CultureInfo.CurrentCulture);

    // The first and last characters are enough to recognise a transaction; the full ID is in Activity.
    private string ShortTxId => TxId is { Length: > 20 } id ? $"{id[..10]}…{id[^8..]}" : TxId ?? "";

    private static readonly string[] _colors = [
        "#4ade80", "#22d3ee", "#a78bfa", "#fb923c",
        "#f472b6", "#fbbf24", "#34d399", "#60a5fa"
    ];
}
