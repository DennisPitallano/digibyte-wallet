@* Hold to confirm: for irreversible, value-moving actions only (see docs/UI_STYLE.md).
   Press and hold for HoldMs to confirm; letting go early cancels. Keyboard and screen-reader paths are in ConfirmGestureBase. *@
@inherits ConfirmGestureBase

<button type="button"
        class="confirm-hold @(State == Phase.Holding ? "is-holding" : "") @(State == Phase.Done ? "is-done" : "")"
        style="--confirm-hold: @(HoldMs)ms"
        aria-label="@AccessibleName"
        aria-busy="@(State == Phase.Done ? "true" : null)"
        aria-disabled="@(Disabled || State == Phase.Done ? "true" : null)"
        @onpointerdown="OnPointerDown"
        @onpointerup="CancelHold"
        @onpointerleave="CancelHold"
        @onpointercancel="CancelHold"
        @oncontextmenu:preventDefault="true"
        @onkeydown="OnKeyDown"
        @onkeyup="OnKeyUp"
        @onblur="OnBlur"
        @onclick="OnClick">
    <span class="confirm-hold-fill" aria-hidden="true"></span>
    <span class="confirm-hold-label" aria-hidden="true">
        @(State switch
        {
            Phase.Done => BusyLabel,
            Phase.Holding => "Keep holding…",
            _ => Armed ? "Activate again to confirm" : Label,
        })
    </span>
</button>
<span class="sr-only" role="status" aria-live="polite">@Announcement</span>

@code {
    protected override string GestureHint => "Press and hold";

    private Task OnPointerDown(PointerEventArgs e) =>
        e.Button == 0 ? StartHoldAsync() : Task.CompletedTask;
}
