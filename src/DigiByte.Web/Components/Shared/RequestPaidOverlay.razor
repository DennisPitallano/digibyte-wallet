@* The "Paid!" moment for the request on screen (spec 036, FR-010, FR-011): the amount received and the label, a brief
   vibration where the device has one, and nothing closes it but the person. Respects hide-amounts mode. *@
@using DigiByte.Wallet.Models
@using DigiByte.Wallet.Storage
@inject LocalizationService L
@inject IJSRuntime JS
@inject ISecureStorage Storage

@if (Request is { } paid)
{
    <div id="@DialogId" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="@TitleId" tabindex="-1"
         data-testid="request-paid-overlay" @onkeydown="OnKeyDown">
        <div class="card-raised celebrate-card">
            <div class="celebrate-medal" aria-hidden="true">
                <div class="celebrate-decor success-ring"></div>
                <div class="celebrate-decor success-ring success-ring-2"></div>
                <div class="celebrate-coin">
                    <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
            </div>

            <h3 id="@TitleId" class="celebrate-title" data-testid="request-paid-title">@L.T("request.paid_title")</h3>

            @if (hideAmounts)
            {
                <p class="celebrate-hidden" data-testid="request-paid-amount">••••</p>
            }
            else
            {
                <p class="celebrate-amount @(AmountText.Length > 9 ? "is-long" : "")" data-testid="request-paid-amount">
                    +@AmountText <span class="celebrate-unit">DGB</span>
                </p>
            }
            @if (!string.IsNullOrEmpty(paid.Label))
            {
                <p class="text-sm text-slate-500 dark:text-slate-400" data-testid="request-paid-label">@paid.Label</p>
            }

            <div class="flex flex-col gap-2 w-full mt-1">
                <button type="button" data-autofocus class="btn-primary w-full" data-testid="request-paid-done"
                        @onclick="DoneAsync">@L.T("request.paid_done")</button>
            </div>
        </div>
    </div>
}

@code {
    private const string DialogId = "request-paid-overlay";
    private const string TitleId = "request-paid-title";

    /// <summary>The request to celebrate; null hides the overlay.</summary>
    [Parameter] public PaymentRequest? Request { get; set; }

    /// <summary>The person tapped Done (or pressed Escape).</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    private bool hideAmounts;
    private string? shownId;

    private string AmountText => Request is { } r
        ? (r.Payments.Where(p => p.Confirmed).Sum(p => p.AmountSatoshis) / 100_000_000m)
            .ToString("#,0.########", System.Globalization.CultureInfo.CurrentCulture)
        : "";

    protected override async Task OnParametersSetAsync()
    {
        if (Request is null || Request.Id == shownId) return;
        try { hideAmounts = await Storage.GetAsync("pref:hideBalance") == "1"; } catch { hideAmounts = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Request is null || Request.Id == shownId) return;
        shownId = Request.Id;
        try { await JS.InvokeVoidAsync("domHelpers.trapFocus", DialogId); } catch { }
        try { await JS.InvokeVoidAsync("domHelpers.haptic", new[] { 15, 40, 25 }); } catch { }
    }

    private async Task DoneAsync()
    {
        shownId = null;
        try { await JS.InvokeVoidAsync("domHelpers.releaseFocus", DialogId); } catch { }
        await OnDone.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await DoneAsync();
    }
}
