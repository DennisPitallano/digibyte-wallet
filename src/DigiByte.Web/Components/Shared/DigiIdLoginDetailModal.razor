@using DigiByte.Wallet.Models

@if (IsOpen && Entry != null)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-card flex flex-col gap-4 max-h-[85vh] overflow-y-auto" tabindex="-1" role="dialog" aria-modal="true"
             aria-label="Login details for @Entry.Domain" @ref="card"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">Login details</h3>
                    <p class="text-xs text-slate-400 dark:text-slate-500 break-all">@Entry.Domain</p>
                </div>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 flex-shrink-0">Success</span>
            </div>

            <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl p-3 flex flex-col gap-3">
                <div class="flex flex-col gap-0.5">
                    <span class="text-[10px] text-slate-500 dark:text-slate-400">Date &amp; time</span>
                    <span class="text-xs text-slate-800 dark:text-slate-200">@Entry.Timestamp.ToLocalTime().ToString("MMMM d, yyyy h:mm:ss tt")</span>
                </div>

                <div class="flex flex-col gap-0.5">
                    <span class="text-[10px] text-slate-500 dark:text-slate-400">Connection</span>
                    @if (Entry.IsUnsecure == true)
                    {
                        <span class="text-xs font-semibold text-amber-600 dark:text-amber-400">Insecure (HTTP)</span>
                    }
                    else if (Entry.IsUnsecure == false)
                    {
                        <span class="text-xs text-slate-800 dark:text-slate-200">Secure (HTTPS)</span>
                    }
                    else
                    {
                        <span class="text-xs italic text-slate-400 dark:text-slate-500">Not recorded</span>
                    }
                </div>

                @Field("Callback URL", Entry.CallbackUrl)
                @Field("Signing address", Entry.Address)
                @Field("Challenge (nonce)", Entry.Nonce)
                @Field("Signed URI", Entry.Uri)
                @Field("Signature", Entry.Signature)
            </div>

            <button class="w-full py-3 bg-slate-100 dark:bg-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors"
                    @onclick="Close">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DigiIdLoginRecord? Entry { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference card;
    private bool focusPending;
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen) focusPending = true;
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the dialog so Escape works without a click first.
        if (focusPending && IsOpen)
        {
            focusPending = false;
            try { await card.FocusAsync(); } catch { }
        }
    }

    private async Task Close() => await OnClosed.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    private RenderFragment Field(string label, string? value) => __builder =>
    {
        <div class="flex flex-col gap-0.5">
            <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-slate-500 dark:text-slate-400">@label</span>
                @if (!string.IsNullOrEmpty(value))
                {
                    <CopyValueButton Value="@value" Label="@label.ToLowerInvariant()" />
                }
            </div>
            @if (string.IsNullOrEmpty(value))
            {
                <span class="text-xs italic text-slate-400 dark:text-slate-500">Not recorded</span>
            }
            else
            {
                <span class="text-[11px] font-mono text-slate-800 dark:text-slate-200 break-all select-all">@value</span>
            }
        </div>
    };
}
