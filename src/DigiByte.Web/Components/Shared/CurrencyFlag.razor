@* A currency's country flag (bundled SVGs, so nothing is fetched from a third party). Currencies shared by several countries with
   no single flag (the CFA francs) and unknown codes show a neutral badge with the currency symbol instead. *@
@if (FiatCurrencies.FlagFor(Code) is { } flag)
{
    <img src="/images/flags/@(flag).svg" alt="" loading="lazy" width="24" height="18"
         class="@Class rounded-[3px] object-cover shadow-sm ring-1 ring-black/10 shrink-0" />
}
else
{
    <span class="@Class rounded-[3px] bg-slate-200 dark:bg-dgb-800 text-slate-500 dark:text-slate-300 text-[9px] font-bold flex items-center justify-center shrink-0" aria-hidden="true">@Badge</span>
}

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter] public string Class { get; set; } = "w-6 h-[18px]";

    private string Badge => FiatCurrencies.SymbolFor(Code).Trim() is { Length: > 0 and <= 3 } s ? s : "¤";
}
