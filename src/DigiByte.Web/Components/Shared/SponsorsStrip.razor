@implements IDisposable
@inject SponsorsService SponsorSource

@* "Supported by": the newest few sponsors on the Home screen, linking to the full Sponsors page. This is decoration, never a dependency:
   it loads in the background after Home has painted, reuses a saved copy up to 30 minutes old (so Home does not ask GitHub every time),
   and on any problem it simply stays hidden. It never shows an error and never touches wallet data. *@

@if (entries.Count > 0)
{
    @* A compact pill that sits at the top of Home, on the same row as the wallet picker (right-aligned). *@
    <a href="/sponsors" title="Supported by our sponsors. See all" aria-label="Supported by @entries.Count of @total sponsors. See all sponsors"
       class="ml-auto mb-2 flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 min-w-0 rounded-full bg-slate-100 dark:bg-white/5 border border-rose-200/80 dark:border-rose-900/40 hover:border-rose-300 dark:hover:border-rose-700/60 transition-colors no-underline fade-in press-effect">
        <span class="text-rose-500 text-sm leading-none" aria-hidden="true">♥</span>
        <span class="hidden sm:inline text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 shrink-0">Supported by</span>
        <div class="flex items-center -space-x-1.5">
            @foreach (var sponsor in entries)
            {
                <span title="@sponsor.Name" class="rounded-full ring-2 ring-slate-100 dark:ring-dgb-950"><SponsorAvatar Name="@sponsor.Name" ImageUrl="@sponsor.ImageUrl" SizeClass="w-5 h-5" LetterClass="text-[10px]" /></span>
            }
        </div>
        @if (total > entries.Count)
        {
            <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 shrink-0 pr-1">+@(total - entries.Count)</span>
        }
    </a>
}

@code {
    private const int MaxShown = 4;
    private static readonly TimeSpan MaxAge = TimeSpan.FromMinutes(30);

    private IReadOnlyList<SponsorEntry> entries = [];
    private int total;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var result = await SponsorSource.LoadAsync(maxAge: MaxAge);
            if (disposed || result.List is not { Entries.Count: > 0 } list) return;
            entries = [.. list.Entries.Take(MaxShown)];
            total = list.Entries.Count;
            StateHasChanged();
        }
        catch (Exception)
        {
            // Stay hidden: the strip must never get in the way of the wallet.
        }
    }

    public void Dispose() => disposed = true;
}
