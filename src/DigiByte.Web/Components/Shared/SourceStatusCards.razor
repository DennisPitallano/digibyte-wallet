@implements IDisposable
@inject NodeSourceOptions Options
@inject INodeSourceState NodeState
@inject IServiceProvider Services
@inject P2pGatewayOptions GatewayOptions

@* The status of the wallet's own data sources (the own node and the light-client gateway): Baku's summary, a card per source
   with its readiness steps and heights, and a timeline of state changes. It reads only. With Public set (the Network status page
   everyone can open) it shows states, heights and plain wording only; the developer page also shows addresses, versions,
   settings and raw reason codes. *@
@{
    var gateway = Microsoft.Extensions.DependencyInjection.ServiceProviderKeyedServiceExtensions.GetKeyedService<NodeSourceMonitor>(Services, "gateway");
    var nodeView = new SourceView("Own node", "node", Options.Enabled, NodeState, Options.ApiUrl ?? "(not set, using NodeApiUrl)", "Node height",
        [("Node use", Options.Enabled ? "on" : "off"), ("Node API", Options.ApiUrl ?? "(not set, using NodeApiUrl)"), ("Was active this session", NodeState.NodeWasActive ? "yes" : "no")]);
    var gatewayView = new SourceView("Light-client gateway", "gateway", GatewayOptions.Enabled, gateway, GatewayOptions.ApiUrl ?? "(not set)", "Header height",
        [("Gateway use", GatewayOptions.Enabled ? "on" : "off"), ("Gateway API", GatewayOptions.ApiUrl ?? "(not set)"),
         ("Requested position", GatewayOptions.RequestedPosition.ToString()), ("Effective position", GatewayOptions.Position.ToString())]);
    var overall = Overall(nodeView, gatewayView);
}

<div class="dn flex flex-col gap-4">
    @* Hero: Baku reads the situation out loud. *@
    <header class="dn-card dn-hero dn-rise" style="--i:0">
        <img class="dn-baku" src="@BakuCatalog.PosePath(overall.Pose)" alt="" decoding="async" draggable="false" />
        <div class="dn-bubble">
            <span class="dn-kicker">Baku · @(Public ? "network watch" : "node watch")</span>
            <p class="dn-say" @key="overall.Say">@overall.Say</p>
        </div>
        <div class="dn-title">
            <h1>@(Public ? "Network status" : "Node diagnostics")</h1>
            @if (!Public) { <span class="dn-dev">Developer view</span> }
        </div>
    </header>

    @SourceCard(nodeView, 1)
    @SourceCard(gatewayView, 2)

    <section class="dn-card dn-rise" style="--i:3" aria-label="Recent changes">
        <h2 class="dn-h2">Recent changes</h2>
        @if (changes.Count == 0)
        {
            <p class="dn-muted">No change since this page was opened.</p>
        }
        else
        {
            <ol class="dn-timeline">
                @foreach (var c in changes.ToList())
                {
                    <li class="dn-tl" @key="c.Key"><span class="dn-tl-dot"></span><span class="dn-tl-time dn-num">@c.Time</span><span class="dn-tl-text">@c.Text</span></li>
                }
            </ol>
        }
    </section>

    @if (Public)
    {
        <p class="dn-muted dn-tiny dn-note">
            The wallet checks these sources against public block explorers. Your keys never leave your device, and a source is only used after it has stayed level with the chain for a while.
        </p>
    }
</div>

@code {
    /// <summary>True on the page everyone can open: states and heights only, in plain words.</summary>
    [Parameter] public bool Public { get; set; }

    private readonly List<ChangeEntry> changes = [];
    private NodeSourceMonitor? gatewayMonitor;
    private Timer? ticker;
    private int changeCounter;
    private string? lastGatewayText;

    private sealed record ChangeEntry(int Key, string Time, string Text);

    /// <summary>What one source card shows. Both the own node and the gateway are judged by the same readiness rules.</summary>
    private sealed record SourceView(string Title, string Kind, bool Enabled, INodeSourceState? State, string Api, string HeightLabel, (string Label, string Value)[] Config);

    protected override void OnInitialized()
    {
        NodeState.Changed += OnStateChanged;
        // The gateway card follows its own monitor, so it shows the first check as soon as it finishes.
        gatewayMonitor = Microsoft.Extensions.DependencyInjection.ServiceProviderKeyedServiceExtensions.GetKeyedService<NodeSourceMonitor>(Services, "gateway");
        if (gatewayMonitor is not null)
            gatewayMonitor.Changed += OnGatewayChanged;
        // A light tick keeps "checked 12 s ago" and the monitors' newest snapshots current without a reload.
        ticker = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnGatewayChanged()
    {
        // The monitor also raises this after a check that changed nothing, so only a different state is a change.
        var text = gatewayMonitor is null ? null : $"Gateway: {gatewayMonitor.State} ({gatewayMonitor.Reason})";
        if (text is not null && text != lastGatewayText)
        {
            lastGatewayText = text;
            Record(text);
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        Record($"Node: {NodeState.State} ({NodeState.Reason})");
        InvokeAsync(StateHasChanged);
    }

    private void Record(string text)
    {
        lock (changes)
        {
            changes.Insert(0, new ChangeEntry(++changeCounter, $"{DateTime.Now:HH:mm:ss}", text));
            if (changes.Count > 20) changes.RemoveAt(changes.Count - 1);
        }
    }

    // ---- Presentation helpers ----

    private static readonly string[] StepNames = ["Reachable", "Ready", "Steady", "Active"];

    /// <summary>How many of the four steps are done, and which one is being worked on (-1 for none).</summary>
    private static (int Done, int Now, bool Failed) Progress(INodeSourceState? s) => s?.State switch
    {
        NodeSourceState.Active => (4, -1, false),
        NodeSourceState.Stabilizing => (2, 2, false),
        NodeSourceState.NotReady => (1, 1, false),
        NodeSourceState.Unavailable => (0, 0, true),
        _ => (0, -1, false),
    };

    private static (string Class, string Label) Pill(SourceView v) => v.State?.State switch
    {
        _ when !v.Enabled || v.State is null => ("off", "off"),
        NodeSourceState.Active => ("ok", "active"),
        NodeSourceState.Stabilizing => ("wait", "stabilizing"),
        NodeSourceState.NotReady => ("wait", "not ready"),
        NodeSourceState.Unavailable => ("bad", "unreachable"),
        _ => ("off", "off"),
    };

    private static string ReasonText(NodeNotReadyReason r) => r switch
    {
        NodeNotReadyReason.None => "Nothing in the way.",
        NodeNotReadyReason.Disabled => "Switched off in the configuration.",
        NodeNotReadyReason.Unreachable => "The health report could not be fetched.",
        NodeNotReadyReason.Starting => "Still starting up.",
        NodeNotReadyReason.Syncing => "Still catching up with the chain.",
        NodeNotReadyReason.Unhealthy => "Reports itself as unhealthy.",
        NodeNotReadyReason.Txindex => "Still preparing its transaction index.",
        NodeNotReadyReason.Version => "Running a version the wallet does not accept.",
        NodeNotReadyReason.HeightDrift => "Its height differs from the explorers by more than the tolerance.",
        NodeNotReadyReason.Malformed => "The health report could not be read.",
        NodeNotReadyReason.ReadFailures => "Too many reads failed in a row.",
        _ => r.ToString(),
    };

    private static (string Pose, string Say) Overall(SourceView node, SourceView gateway)
    {
        var states = new[] { node, gateway }.Where(v => v.Enabled && v.State is not null).Select(v => v.State!.State).ToList();
        if (states.Count == 0)
            return ("guard", "Only the public explorers are in use right now. No own source is switched on.");
        if (states.Contains(NodeSourceState.Active))
            return ("celebrating", "A source has been steady long enough. The wallet uses it where it can.");
        if (states.Contains(NodeSourceState.Stabilizing))
            return ("thinking", "Level with the chain. I am waiting for it to stay that way before the wallet leans on it.");
        if (states.Contains(NodeSourceState.NotReady))
            return ("idea", "A source answered but is not ready yet. The wallet keeps using the explorers meanwhile.");
        return ("error", "I cannot reach the enabled source. The wallet is falling back to the explorers.");
    }

    private static string Ago(DateTime checkedAtUtc)
    {
        var s = (int)Math.Max(0, (DateTime.UtcNow - checkedAtUtc.ToUniversalTime()).TotalSeconds);
        return s < 60 ? $"{s} s ago" : $"{s / 60} min ago";
    }

    private RenderFragment SourceCard(SourceView v, int index) => __builder =>
    {
        var snap = v.State?.LastSnapshot;
        var pill = Pill(v);
        var (done, now, failed) = Progress(v.State);
        var health = snap?.Health;
        var delta = snap?.HeightDelta;
        var deltaOk = delta is not null && Math.Abs(delta.Value) <= Options.HeightTolerance;

        <section class="dn-card dn-rise @(done == 4 ? "dn-live" : "")" style="--i:@index" aria-label="@v.Title">
            <div class="dn-card-head">
                <span class="dn-ic @v.Kind" aria-hidden="true">
                    @if (v.Kind == "node")
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="2" /><rect x="3" y="14" width="18" height="6" rx="2" /><path d="M7 7h.01M7 17h.01" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" /></svg>
                    }
                </span>
                <div class="dn-card-title">
                    <h2>@v.Title</h2>
                    @if (!Public) { <span class="dn-muted dn-tiny dn-trunc">@v.Api</span> }
                </div>
                <span class="dn-pill @pill.Class" @key="pill.Label"><i class="dn-dot"></i>@pill.Label</span>
            </div>

            @if (!v.Enabled || v.State is null)
            {
                <p class="dn-muted">Switched off. The wallet does not ask this source.</p>
            }
            else
            {
                @* Readiness steps, drawn like the confirmation blocks: done is a check, the current step pulses. *@
                <div class="dn-steps" role="list" aria-label="Readiness">
                    @for (var i = 0; i < StepNames.Length; i++)
                    {
                        var cls = failed && i == now ? "bad" : i < done ? "done" : i == now ? "now" : "";
                        <div class="dn-step @cls @(done == 4 ? "wave" : "")" style="--d:@(i * 90)ms" role="listitem">
                            <span class="dn-node">
                                @if (cls == "done") { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg> }
                                else if (cls == "bad") { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M7 7l10 10M17 7 7 17" /></svg> }
                                else { <span class="dn-num">@(i + 1)</span> }
                            </span>
                            <span class="dn-step-name">@StepNames[i]</span>
                        </div>
                    }
                </div>
                <p class="dn-reason" @key="@($"{v.State.State}-{v.State.Reason}")">
                    @(v.State.State == NodeSourceState.Stabilizing ? "Level with the chain. Waiting out the steady period." : ReasonText(v.State.Reason))
                </p>

                @if (snap is not null)
                {
                    <div class="dn-heights">
                        <div class="dn-big">
                            <span class="dn-lbl">@v.HeightLabel</span>
                            <span class="dn-val dn-num" @key="health?.Blocks">@(health?.Blocks?.ToString("N0") ?? "-")</span>
                        </div>
                        <span class="dn-delta @(delta is null ? "" : deltaOk ? "ok" : "warn")" title="Height difference">
                            @(delta is null ? "–" : delta.Value == 0 ? "level" : (delta.Value > 0 ? "+" : "") + delta.Value)
                        </span>
                        <div class="dn-big right">
                            <span class="dn-lbl">Explorer height</span>
                            <span class="dn-val dn-num" @key="snap.ExplorerHeight">@(snap.ExplorerHeight?.ToString("N0") ?? "-")</span>
                        </div>
                    </div>

                    <div class="dn-tiles">
                        @Tile("Status", health?.Status ?? "-", null)
                        @Tile("Peers", health?.Peers?.ToString() ?? "-", null)
                        @Tile("Lag", health?.Lag?.ToString() ?? "-", health?.Lag is null ? null : health.Lag <= 2)
                        @if (!Public && v.Kind == "node")
                        {
                            @Tile("Version", health?.NodeVersion ?? "-", health?.VersionOk)
                            @Tile("Tx index", health is null ? "-" : (health.Txindex ? "ready" : "not ready"), health?.Txindex)
                        }
                    </div>

                    <p class="dn-checked">
                        <span class="dn-beat" @key="snap.CheckedAt"></span>
                        Checked @snap.CheckedAt.ToLocalTime().ToString("HH:mm:ss") · <span class="dn-num">@Ago(snap.CheckedAt)</span>
                        @if (snap.Inconclusive) { <span class="dn-chip warn">no explorer height</span> }
                    </p>
                }
                else
                {
                    <p class="dn-muted dn-shimmer">No check has finished yet.</p>
                }
            }

            @if (!Public)
            {
                <details class="dn-more">
                    <summary>Settings</summary>
                    <div class="dn-kv">
                        @foreach (var (label, value) in v.Config)
                        {
                            <div class="dn-kv-row"><span>@label</span><span class="dn-num">@value</span></div>
                        }
                        @if (v.State is not null && v.Enabled)
                        {
                            <div class="dn-kv-row"><span>State</span><span class="dn-num">@v.State.State</span></div>
                            <div class="dn-kv-row"><span>Reason</span><span class="dn-num">@v.State.Reason</span></div>
                        }
                    </div>
                </details>
            }
        </section>
    };

    private static RenderFragment Tile(string label, string value, bool? good) => __builder =>
    {
        <div class="dn-tile @(good is null ? "" : good == true ? "ok" : "warn")">
            <span class="dn-lbl">@label</span>
            <span class="dn-tile-val dn-num" @key="value">@value</span>
        </div>
    };

    public void Dispose()
    {
        ticker?.Dispose();
        NodeState.Changed -= OnStateChanged;
        if (gatewayMonitor is not null)
            gatewayMonitor.Changed -= OnGatewayChanged;
    }
}
