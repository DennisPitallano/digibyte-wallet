@implements IDisposable
@inject NodeSourceStatusService Status

@* Explains, before the user tries, that sending is unavailable while no data source is reachable (FR-012). Only when node use
   is switched on; it clears by itself when a source answers again. *@
@if (Status.View.Visible && Status.AllSourcesFailed)
{
    <div class="flex items-start gap-2 px-3 py-2 bg-red-500/10 border border-red-500/20 rounded-xl mb-3 fade-in" role="status">
        <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
        <span class="text-xs font-medium text-red-600 dark:text-red-400">Sending is unavailable until the connection returns. Your funds are safe; try again in a moment.</span>
    </div>
}

@code {
    protected override void OnInitialized() => Status.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnChanged;
}
