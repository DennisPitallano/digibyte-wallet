@inject IJSRuntime JS

<button type="button"
        class="flex-shrink-0 inline-flex items-center gap-1 text-[10px] font-semibold press-effect @(failed ? "text-red-500" : "text-dgb-500 hover:text-dgb-600")"
        aria-label="Copy @Label"
        @onclick="CopyAsync" @onclick:stopPropagation="true">
    @if (copied)
    {
        <span class="fade-in text-green-500">Copied</span>
    }
    else if (failed)
    {
        <span>Copy failed</span>
    }
    else
    {
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
        </svg>
        <span>Copy</span>
    }
</button>

@code {
    /// <summary>The exact, full text placed on the clipboard.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>Short noun used in the accessible name, e.g. "signing address".</summary>
    [Parameter] public string Label { get; set; } = "value";

    private bool copied;
    private bool failed;

    private async Task CopyAsync()
    {
        failed = false;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
            copied = true;
        }
        catch
        {
            copied = false;
            failed = true;
        }
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
        failed = false;
        StateHasChanged();
    }
}
