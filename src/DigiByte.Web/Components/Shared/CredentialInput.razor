@using DigiByte.Wallet.Storage
@inject LocalizationService L
@inject IJSRuntime JS

@* One input for both credential types: the six-digit PIN boxes, or a masked passphrase field with show/hide.
   The parent owns the value; this component only collects it. Rules and rejection reasons live in CredentialPolicy. *@

@if (Kind == CredentialKind.Pin)
{
    <PinInput @ref="pinInput" Length="6" AutoFocus="AutoFocus" Error="@Error"
              ValueChanged="OnValueChanged" OnComplete="OnSubmit" />
}
else
{
    <div class="w-full max-w-[320px] flex flex-col gap-2" data-testid="passphrase-input">
        <div class="relative">
            <input type="@(revealed ? "text" : "password")"
                   id="@inputId"
                   class="w-full h-12 pl-4 pr-20 rounded-xl border-2 outline-none bg-white dark:bg-dgb-900 text-slate-900 dark:text-white
                          @(string.IsNullOrEmpty(Error) ? "border-slate-200 dark:border-dgb-800 focus:border-dgb-500" : "border-red-400 dark:border-red-500")"
                   placeholder="@(Placeholder ?? L.T("credential.passphrase_placeholder"))"
                   aria-label="@(Placeholder ?? L.T("credential.passphrase_placeholder"))"
                   aria-invalid="@(!string.IsNullOrEmpty(Error))"
                   autocomplete="@(IsNew ? "new-password" : "current-password")"
                   autocapitalize="off" autocorrect="off" spellcheck="false"
                   data-testid="passphrase-field"
                   @bind="text" @bind:event="oninput" @bind:after="OnTextChanged"
                   @onkeydown="OnKeyDown" />
            <button type="button"
                    class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1 text-xs font-semibold text-dgb-500 hover:text-dgb-600"
                    data-testid="passphrase-toggle"
                    aria-pressed="@revealed"
                    @onclick="() => revealed = !revealed">
                @(revealed ? L.T("credential.hide") : L.T("credential.show"))
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Error))
        {
            <p role="alert" aria-live="assertive" class="text-sm text-red-500 font-medium text-center fade-in" data-testid="credential-error">@Error</p>
        }
    </div>
}

@code {
    [Parameter] public CredentialKind Kind { get; set; } = CredentialKind.Pin;
    [Parameter] public bool AutoFocus { get; set; } = true;
    /// <summary>True when the user is choosing a new credential (affects the browser's password-manager hint).</summary>
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>PIN: all six digits entered. Passphrase: Enter pressed.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    private PinInput? pinInput;
    private string text = "";
    private bool revealed;
    private readonly string inputId = "cred-" + Guid.NewGuid().ToString("N")[..6];
    private CredentialKind? lastKind;

    protected override void OnParametersSet()
    {
        // Switching between PIN and passphrase starts from an empty value.
        if (lastKind is not null && lastKind != Kind)
        {
            text = "";
            revealed = false;
        }
        lastKind = Kind;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Kind == CredentialKind.Passphrase && AutoFocus)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("domHelpers.focusElement", inputId);
        }
    }

    private Task OnValueChanged(string value) => ValueChanged.InvokeAsync(value);

    private Task OnTextChanged() => ValueChanged.InvokeAsync(text);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnSubmit.InvokeAsync();
    }

    public void Clear()
    {
        text = "";
        pinInput?.Clear();
        StateHasChanged();
    }
}
