@using DigiByte.Wallet.Storage
@inject LocalizationService L

@* Shown when a new wallet cannot get the stronger protection on this browser or device. The wallet is created with the
   earlier protection only if the user agrees; it is marked as such and upgrades by itself on a capable device (FR-021). *@

<div class="fixed inset-0 z-[300] flex items-center justify-center bg-black/60 backdrop-blur-sm scale-in" role="dialog" aria-modal="true" data-testid="legacy-consent">
    <div class="bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-3xl p-6 mx-6 max-w-sm shadow-2xl flex flex-col items-center gap-4"
         @onclick:stopPropagation="true">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white text-center">@L.T("legacy.title")</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 text-center leading-relaxed">
            @(Reason == CryptoFailure.ResourceExhausted ? L.T("legacy.reason_memory") : L.T("legacy.reason_browser"))
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400 text-center leading-relaxed">@L.T("legacy.body")</p>
        <div class="flex flex-col gap-2 w-full mt-2">
            <button class="w-full py-3.5 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-2xl press-effect"
                    data-testid="legacy-consent-agree" @onclick="() => OnAgree.InvokeAsync()">@L.T("legacy.agree")</button>
            <button class="w-full py-3 text-slate-500 dark:text-slate-400 text-sm font-medium"
                    data-testid="legacy-consent-cancel" @onclick="() => OnCancel.InvokeAsync()">@L.T("common.cancel")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public CryptoFailure Reason { get; set; } = CryptoFailure.Unsupported;
    [Parameter] public EventCallback OnAgree { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
