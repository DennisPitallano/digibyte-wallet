@* Home's "search further" offer (spec 027, FR-001 to FR-006): for a wallet that was brought onto this device and whose
   completed load found nothing, a way to the wider search on the Recovery page. It renders nothing until the coordinator
   says the wallet qualifies, so it never appears and then disappears. *@
@implements IDisposable
@inject SearchOfferCoordinator Offer
@inject NavigationManager Nav
@inject LocalizationService L

@if (visible)
{
    <div class="bg-white dark:bg-dgb-900/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4 @Class"
         role="region" aria-labelledby="search-further-offer-title" data-testid="search-further-offer">
        <p id="search-further-offer-title" class="text-xs font-semibold text-slate-900 dark:text-white">@L.T("home.search_offer.title")</p>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@L.T("home.search_offer.body")</p>
        <div class="flex gap-2 mt-3">
            <button type="button" class="btn-primary btn-sm flex-1"
                    data-testid="search-further-action" @onclick="SearchFurther">
                @L.T("home.search_offer.action")
            </button>
            <button type="button" class="btn-secondary btn-sm"
                    data-testid="search-further-dismiss" @onclick="DismissAsync">
                @L.T("home.search_offer.dismiss")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string? WalletId { get; set; }

    /// <summary>The wallet's type ("hd", "xpub", ...): only wallets with further addresses to search get the offer.</summary>
    [Parameter] public string? WalletType { get; set; }

    /// <summary>
    /// A number the page raises each time it finishes a history load. The wallet being recorded as empty changes no other
    /// parameter and raises no event, so without this the offer would ask once, too early, and never look again.
    /// </summary>
    [Parameter] public int LoadVersion { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool visible;
    private string? shownFor;
    // Each check gets a number; only the latest one may change what is shown.
    private int check;

    protected override void OnInitialized() => Offer.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        // Another wallet: its offer is decided afresh, and the previous wallet's must not stay on screen meanwhile.
        if (shownFor != WalletId) visible = false;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var mine = ++check;
        var walletId = WalletId;
        var show = await Offer.ShouldShowAsync(walletId, WalletType);
        if (mine != check) return;
        visible = show;
        shownFor = walletId;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    // Going to look is not an answer: the offer stays until a search finishes or it is dismissed (FR-004, FR-006).
    private void SearchFurther() => Nav.NavigateTo("/recovery?search=receive");

    private async Task DismissAsync()
    {
        check++;
        visible = false;
        await Offer.DismissAsync(WalletId);
    }

    public void Dispose() => Offer.Changed -= OnChanged;
}
