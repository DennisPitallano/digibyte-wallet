@* CSV export of transaction history (spec 031, contracts/export-sheet-ui.md). Opened from Activity (DGB) and the
   DigiDollar screen (DD). The file is built on the device; nothing is saved when the history can't be read in full,
   when nothing matches, or when the person cancels. *@
@using DigiByte.Wallet.Services.Export
@inject TransactionExportService Exporter
@inject AppState AppState
@inject IJSRuntime JS
@inject LocalizationService L
@inject NotificationService Notifications
@implements IDisposable

@if (IsOpen)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="export-title" @onclick="CloseIfIdle" @onkeydown="OnKeyDown">
        <div class="modal-card flex flex-col gap-4" @onclick:stopPropagation="true">
            <h3 id="export-title" class="block-title">@(Asset == ExportAsset.Dd ? L.T("export.title.dd") : L.T("export.title.dgb"))</h3>

            <fieldset class="flex flex-col gap-2" disabled="@running">
                <legend class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">@L.T("export.what")</legend>
                <label class="flex items-center gap-2 text-sm text-slate-800 dark:text-slate-200">
                    <input type="radio" name="export-scope" checked="@(scope == ExportScope.Everything)"
                           @onchange="() => scope = ExportScope.Everything" />
                    @L.T("export.scope.everything")
                </label>
            </fieldset>

            <p class="text-xs text-slate-500 dark:text-slate-400">
                @L.T("export.notice")
                @if (HideAmounts)
                {
                    <span> @L.T("export.notice.hidden")</span>
                }
            </p>

            @if (showProgress)
            {
                <div class="flex flex-col gap-1.5" role="status" aria-live="polite">
                    <div class="h-2 rounded-full bg-slate-100 dark:bg-dgb-800 overflow-hidden" role="progressbar"
                         aria-valuemin="0" aria-valuemax="@Math.Max(1, total)" aria-valuenow="@done" aria-label="@ProgressText">
                        <div class="h-full bg-dgb-500 transition-all" style="width: @(ProgressPercent)%"></div>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@ProgressText</p>
                </div>
            }

            @if (message is not null)
            {
                <p class="text-xs @(messageIsError ? "text-red-500" : "text-slate-600 dark:text-slate-300")" role="alert">
                    @message
                    @if (offerRetry)
                    {
                        <button type="button" class="font-semibold underline ml-1" @onclick="RunAsync">@L.T("export.try_again")</button>
                    }
                </p>
            }

            <div class="flex items-center gap-2">
                <button type="button" @ref="exportButton"
                        class="flex-1 min-h-[44px] bg-dgb-500 hover:bg-dgb-600 disabled:opacity-50 text-white font-semibold rounded-2xl press-effect"
                        disabled="@running" @onclick="RunAsync">
                    @L.T("export.export")
                </button>
                <button type="button" class="min-h-[44px] px-4 text-sm font-medium text-slate-500 dark:text-slate-400" @onclick="CancelOrClose">
                    @L.T("common.cancel")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ExportAsset Asset { get; set; } = ExportAsset.Dgb;

    /// <summary>The on-screen privacy toggle: the notice then says the file still holds real amounts (FR-012).</summary>
    [Parameter] public bool HideAmounts { get; set; }

    [Parameter] public EventCallback OnClosed { get; set; }
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    /// <summary>The progress bar and Cancel appear once reading has taken this long (FR-003, research R8).</summary>
    private static readonly TimeSpan ProgressDelay = TimeSpan.FromSeconds(1);

    private ExportScope scope = ExportScope.Everything;
    private bool running;
    private bool showProgress;
    private int done;
    private int total;
    private string? message;
    private bool messageIsError;
    private bool offerRetry;
    private bool wasOpen;
    private CancellationTokenSource? cts;
    private ElementReference exportButton;

    private string ProgressText => L.T("export.reading", done, total);
    private int ProgressPercent => total <= 0 ? 0 : (int)Math.Round(100.0 * done / total);

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            scope = ExportScope.Everything;
            message = null;
            offerRetry = false;
            showProgress = false;
        }
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !running && message is null)
        {
            try { await exportButton.FocusAsync(); } catch { /* not rendered yet */ }
        }
    }

    private async Task RunAsync()
    {
        if (running) return;
        running = true;
        message = null;
        offerRetry = false;
        done = total = 0;
        cts = new CancellationTokenSource();
        var token = cts.Token;
        StateHasChanged();

        // The bar appears only if reading takes longer than a moment, so quick exports don't flash it.
        _ = Task.Delay(ProgressDelay, token).ContinueWith(t =>
        {
            if (!t.IsCanceled && running) { showProgress = true; _ = InvokeAsync(StateHasChanged); }
        }, TaskScheduler.Default);

        try
        {
            var decimalMark = await DecimalMarkAsync();
            var progress = new Progress<HistoryExportProgress>(p =>
            {
                done = p.Done;
                total = p.Total;
                _ = InvokeAsync(StateHasChanged);
            });
            var env = new ExportEnvironment
            {
                DecimalMark = decimalMark,
                Language = L.CurrentLocale,
                TimeZone = TimeZoneInfo.Local,
                Now = DateTimeOffset.Now,
                FiatCurrency = AppState.FiatCurrency,
            };
            var result = await Exporter.ExportAsync(new ExportRequest { Asset = Asset, Scope = scope }, env, progress, token);
            await HandleAsync(result);
        }
        finally
        {
            running = false;
            showProgress = false;
            cts?.Cancel();
            cts?.Dispose();
            cts = null;
            StateHasChanged();
        }
    }

    private async Task HandleAsync(ExportResult result)
    {
        switch (result.Outcome)
        {
            case ExportOutcome.Ready:
                var saved = await JS.InvokeAsync<string>("saveCsvFile", result.Content, result.FileName);
                if (saved == "cancelled") return;   // the person closed the share sheet: nothing was saved
                Notifications.Success(L.T("export.saved", result.RowCount));
                await CloseAsync();
                break;
            case ExportOutcome.HistoryUnavailable:
                Show(L.T("export.unavailable"), error: true, retry: true);
                break;
            case ExportOutcome.NothingToExport:
                Show(L.T("export.nothing"), error: false, retry: false);
                break;
            case ExportOutcome.Locked:
                Show(L.T("export.locked"), error: true, retry: false);
                break;
            case ExportOutcome.Cancelled:
                break;
        }
    }

    private void Show(string text, bool error, bool retry)
    {
        message = text;
        messageIsError = error;
        offerRetry = retry;
    }

    private async Task<string> DecimalMarkAsync()
    {
        try { return await JS.InvokeAsync<string>("getDecimalMark"); }
        catch { return "."; }
    }

    private async Task CancelOrClose()
    {
        if (running) { cts?.Cancel(); return; }
        await CloseAsync();
    }

    private async Task CloseIfIdle()
    {
        if (!running) await CloseAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CancelOrClose();
    }

    private async Task CloseAsync()
    {
        wasOpen = false;
        await OnClosed.InvokeAsync();
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}
