@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject NavigationManager Nav
@inject AppState AppState
@inject WalletService WalletService
@inject IJSRuntime JS
@inject FirstReceiveCoordinator FirstReceive
@inject SoundService Sounds
@inject WalletSnapshotCache Snapshots
@inject ShellChrome Chrome
@inject LocalizationService L

@* Every component that shows translated text takes this value, so it re-renders when the language changes
   without a page reload (spec 028). It wraps the whole shell, so navigation and banners switch too. *@
<CascadingValue Name="Locale" Value="L.CurrentLocale">
<ToastContainer />
<BakuWarningDialog />
<PwaInstallBanner />
<PwaUpdateBanner />

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[999] focus:px-4 focus:py-2 focus:bg-dgb-500 focus:text-white focus:rounded-lg focus:text-sm focus:font-semibold">@L.T("layout.skip_to_content")</a>
<div class="flex flex-col h-dvh max-w-[480px] mx-auto relative bg-slate-50 dark:bg-dgb-950">
    <NodeSourceIndicator />
    <main id="main-content" class="flex-1 overflow-y-auto px-4 pt-4 safe-area-top @(ShowNav ? (InSharedWallet ? "main-with-nav main-with-shared-nav" : "main-with-nav") : "pb-4") scroll-smooth thin-scrollbar"
          role="main" @onclick="AppState.ResetLockTimer" @ontouchstart="AppState.ResetLockTimer">
        <OfflineBanner />
        <NodeDegradedBanner />
        @* Keyed on the path so the fade replays on every navigation, not only on first load. *@
        <div class="page-enter" @key="CurrentPath">
            @Body
        </div>
    </main>
    @if (ShowNav)
    {
        <NavMenu />
    }
</div>

<div id="modal-root"></div>

@* Version Info Modal — rendered at layout level to avoid transform containing block issues *@
@if (showVersionInfo)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="@L.T("layout.version.title")" @onclick="() => showVersionInfo = false">
        <div class="scale-in bg-white dark:bg-dgb-900 rounded-2xl shadow-2xl p-5 mx-4 max-w-xs w-full flex flex-col gap-4"
             @onclick:stopPropagation="true">
            <div class="flex items-center justify-between">
                <h3 class="block-title block-title-sm">@(autoWhatsNew ? L.T("layout.version.updated", AppVersion.Version) : L.T("layout.version.title"))</h3>
                <button type="button" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors"
                        aria-label="@L.T("more.close")" @onclick="() => showVersionInfo = false">
                    <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center">
                        <DigiLogo Size="24" />
                    </div>
                    <div>
                        <p class="text-sm font-bold text-slate-900 dark:text-white">@L.T("layout.app_name")</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">v@(AppVersion.Version)</p>
                    </div>
                </div>

                <div class="flex flex-col gap-2 text-xs">
                    <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-dgb-800">
                        <span class="text-slate-500 dark:text-slate-400">@L.T("layout.version.version")</span>
                        <span class="font-semibold text-slate-900 dark:text-white font-mono">@AppVersion.Version</span>
                    </div>
                    <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-dgb-800">
                        <span class="text-slate-500 dark:text-slate-400">@L.T("layout.version.channel")</span>
                        <span class="inline-flex items-center gap-1.5 font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full @(AppVersion.Channel switch { "alpha" => "bg-amber-500", "beta" => "bg-blue-500", "rc" => "bg-purple-500", _ => "bg-green-500" })"></span>
                            <span class="text-slate-900 dark:text-white capitalize">@ChannelName</span>
                        </span>
                    </div>
                    <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-dgb-800">
                        <span class="text-slate-500 dark:text-slate-400">@L.T("layout.version.platform")</span>
                        <span class="font-semibold text-slate-900 dark:text-white">@PlatformName</span>
                    </div>
                    <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-dgb-800">
                        <span class="text-slate-500 dark:text-slate-400">@L.T("layout.version.framework")</span>
                        <span class="font-semibold text-slate-900 dark:text-white">@FrameworkName</span>
                    </div>
                </div>

                <div>
                    <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">@L.T("layout.whats_new.title")</p>
                    <div class="flex flex-col gap-1.5 text-[11px] text-slate-600 dark:text-slate-300">
                        @* Keep in step with the newest CHANGELOG.md release when bumping the version. *@
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.1")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.2")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.3")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.4")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.5")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.6")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.7")</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-dgb-500 mt-0.5">●</span>
                            <span>@L.T("layout.whats_new.8")</span>
                        </div>
                    </div>
                </div>
            </div>

            <a href="/roadmap" class="w-full py-2 text-xs font-semibold text-center rounded-xl bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors">
                @L.T("layout.version.roadmap")
            </a>
        </div>
    </div>
}
</CascadingValue>

@code {
    private static readonly string[] HiddenNavPaths = ["/welcome", "/create-wallet", "/recover-wallet", "/unlock", "/about", "/roadmap", "/sponsors", "/analytics", "/deployment", "/help", "/help/multisig", "/multisig/room", "/recovery", "/pay"];
    private bool showVersionInfo;

    // Technology names, the same in every language.
    private const string PlatformName = "Blazor WASM (PWA)";
    private const string FrameworkName = ".NET 10";

    private string ChannelName => AppVersion.Channel switch
    {
        "alpha" => L.T("layout.channel.alpha"),
        "beta" => L.T("layout.channel.beta"),
        "rc" => L.T("layout.channel.rc"),
        "stable" => L.T("layout.channel.stable"),
        _ => AppVersion.Channel,
    };

    // "What's New" opens by itself once after an update (never on a fresh install).
    private const string SeenVersionKey = "dgb-seen-version";
    private bool autoWhatsNew;
    private bool whatsNewChecked;

    protected override async Task OnInitializedAsync()
    {
        // First-receive flow (spec 025): load the "first session ended" marker once. A device that already has a wallet
        // with saved history (an existing user after an update) is past its first session, whichever page opens first.
        try { await FirstReceive.InitializeAsync(AnyWalletHasSavedHistoryAsync); } catch { }
        // Optional chimes: when the user has turned Sounds on, get the files ready for the first tap.
        try { await Sounds.InitializeAsync(); } catch { }
    }

    private async Task<bool> AnyWalletHasSavedHistoryAsync()
    {
        foreach (var wallet in await WalletService.GetAllWalletsAsync())
            if ((await Snapshots.LoadAsync(wallet.Id)).Transactions is { Count: > 0 })
                return true;
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The first-payment celebration must not cover this window (spec 025, FR-023).
        FirstReceive.OtherDialogOpen = showVersionInfo;

        // Wait until the wallet is unlocked and Home is showing, so it never covers the unlock or setup screens.
        if (whatsNewChecked || CurrentPath != "/" || !WalletService.IsUnlocked) return;
        whatsNewChecked = true;
        try
        {
            var seen = await JS.InvokeAsync<string?>("localStorage.getItem", SeenVersionKey);
            if (seen == AppVersion.Version) return;
            await JS.InvokeVoidAsync("localStorage.setItem", SeenVersionKey, AppVersion.Version);
            if (seen is null) return; // first run on this device: nothing is "new" yet
            autoWhatsNew = true;
            showVersionInfo = true;
            StateHasChanged();
        }
        catch { }
    }

    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath;

    // Inside a shared wallet the menu carries a name tab on top, so the page needs a little more room under it.
    private bool InSharedWallet => ShellContext.Resolve(Nav.ToBaseRelativePath(Nav.Uri)).IsShared;

    private bool ShowNav
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLower();
            if (string.IsNullOrEmpty(path)) path = "/";
            return !HiddenNavPaths.Contains(path) && !Chrome.HideNav;
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Chrome.Changed += OnChromeChanged;
        AppState.OnAutoLocked += OnAutoLocked;
        VersionBadge.OnShowModal += OnShowVersionInfo;
        L.OnLocaleChanged += OnLocaleChanged;
    }

    // The language changed: re-render the shell and pass the new code down, without reloading the page.
    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    private void OnShowVersionInfo()
    {
        InvokeAsync(() =>
        {
            autoWhatsNew = false;
            showVersionInfo = true;
            StateHasChanged();
        });
    }

    private void OnAutoLocked()
    {
        InvokeAsync(() =>
        {
            Nav.NavigateTo("/unlock", forceLoad: false);
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        AppState.InAppNavigations++;
        InvokeAsync(StateHasChanged);
    }

    // A page asked for the whole screen, or gave it back (a sheet at the bottom, the signing room).
    private void OnChromeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Chrome.Changed -= OnChromeChanged;
        AppState.OnAutoLocked -= OnAutoLocked;
        VersionBadge.OnShowModal -= OnShowVersionInfo;
        L.OnLocaleChanged -= OnLocaleChanged;
    }
}
