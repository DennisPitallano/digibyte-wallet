@inject AppState AppState
@inject WalletService WalletService
@inject NavigationManager Nav
@implements IDisposable

@* The floating bottom menu (variant B in docs/UI_STYLE.md). Styles: nav-float* in wwwroot/css/app.css.
   The active tab has a filled icon on a pill tinted with the wallet's colour; the pill slides between tabs. *@
<nav class="nav-float nav-float-live" aria-label="Main navigation" style="--nav-accent: @Accent; --nav-index: @Math.Max(ActiveIndex, 0);">
    @* No pill on pages that belong to no tab (Send, Receive and so on). *@
    @if (ActiveIndex >= 0)
    {
        <span class="nav-float-pill" aria-hidden="true"></span>
    }
    @for (var i = 0; i < Tabs.Length; i++)
    {
        var tab = Tabs[i];
        var isActive = i == ActiveIndex;
        <a class="nav-float-tab" href="@tab.Href" aria-label="@tab.AriaLabel" aria-current="@(isActive ? "page" : null)">
            <span class="nav-float-icon">
                @if (isActive)
                {
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                        @foreach (var d in NavIcons.All[tab.Icon].Solid)
                        {
                            <path fill-rule="evenodd" clip-rule="evenodd" d="@d" />
                        }
                    </svg>
                }
                else
                {
                    <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        @foreach (var d in NavIcons.All[tab.Icon].Outline)
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" d="@d" />
                        }
                    </svg>
                }
            </span>
            <span>@tab.Label</span>
        </a>
    }
</nav>

@code {
    private record Tab(string Href, string Label, string AriaLabel, string Icon);

    // Same five destinations, order and accessible names as before the restyle.
    private static readonly Tab[] Tabs =
    [
        new("", "Wallet", "Wallet", "wallet"),
        new("payments", "Pay", "Payments", "pay"),
        new("transactions", "Activity", "Activity", "activity"),
        new("identity", "ID", "Identity", "id"),
        new("settings", "Settings", "Settings", "settings"),
    ];

    // The pill behind the active tab takes the current wallet's colour.
    private string Accent => WalletService.ActiveWallet?.Color ?? "#0066FF";

    // Which tab the current page belongs to, or -1 for none. Wallet matches the home page only;
    // the others also match their sub-pages (settings/..., identity/...), as NavLink did.
    private int ActiveIndex
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (path.Length == 0) return 0;
            for (var i = 1; i < Tabs.Length; i++)
            {
                if (path == Tabs[i].Href || path.StartsWith(Tabs[i].Href + "/", StringComparison.Ordinal)) return i;
            }
            return -1;
        }
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
