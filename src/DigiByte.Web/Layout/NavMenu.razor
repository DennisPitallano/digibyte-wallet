@inject AppState AppState
@inject WalletService WalletService
@inject NavigationManager Nav
@inject ShellActions Shell
@inject FirstReceiveCoordinator FirstReceive
@inject NotificationService Notifications
@inject ISecureStorage Storage
@inject IJSRuntime JS
@inject LocalizationService L
@inject MultisigWalletService Multisig
@inject ActiveWalletContext ActiveWallet
@inject ProposalHandoff Handoff
@inject PaymentHandoff PayHandoff
@inject MultisigAttentionState Attention
@implements IDisposable

@* The floating menu (variant C in docs/UI_STYLE.md): Wallet, Activity, a raised Scan button, Request, More.
   Styles: nav-float* in wwwroot/css/app.css. The active tab has a filled icon on a pill tinted with the wallet's colour.
   Scan and More are buttons, not pages: Scan opens the one app-wide scanner, More opens the one More list.

   Inside a shared wallet (specs/026-multisig-wallet-experience) the five places stay where they are but act on that
   shared wallet: Overview, Activity, Scan, Pending, More. The name tab on top of the bar says which shared wallet
   it is and opens the switcher, which is the way out. Layout/ShellContext decides the mode from the address. *@
<nav class="nav-float nav-float-live" aria-label="@NavLabel" data-shell="@(Shared ? "shared" : "personal")"
     style="--nav-accent: @Accent; --nav-index: @Math.Max(ActiveIndex, 0);">
    @* No pill on pages that belong to no tab (Send, Receive and so on). *@
    @if (ActiveIndex >= 0)
    {
        <span class="nav-float-pill" aria-hidden="true"></span>
    }

    @if (Shared)
    {
        <button type="button" class="nav-shared-tab" aria-haspopup="dialog" aria-expanded="@(showSwitcher ? "true" : "false")"
                aria-label="@string.Format(T("nav.shared.switch", "{0}, {1}. Switch wallet"), sharedConfig!.DisplayName, SharedScheme)"
                data-testid="nav-shared-tab" @onclick="OpenSwitcher">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
            </svg>
            @* The name only: the tab shares the bar's left half with nothing else, and the scheme is on the page's context line. *@
            <span class="nav-shared-tab-name">@sharedConfig.DisplayName</span>
        </button>

        <a class="nav-float-tab" href="@SharedHref("")" aria-label="@T("nav.overview.aria", "Overview of this shared wallet")"
           aria-current="@Current(WalletIndex)" data-testid="nav-overview">
            <span class="nav-float-icon">@Icon("overview", ActiveIndex == WalletIndex)</span>
            <span>@T("nav.overview", "Overview")</span>
        </a>
        <a class="nav-float-tab" href="@SharedHref("/activity")" aria-label="@T("nav.shared.activity.aria", "Activity of this shared wallet")"
           aria-current="@Current(ActivityIndex)">
            <span class="nav-float-icon">@Icon("activity", ActiveIndex == ActivityIndex)</span>
            <span>@T("nav.activity", "Activity")</span>
        </a>
    }
    else
    {
        <a class="nav-float-tab" href="" aria-label="@T("nav.wallet", "Wallet")" aria-current="@Current(WalletIndex)">
            <span class="nav-float-icon">@Icon("wallet", ActiveIndex == WalletIndex)</span>
            <span>@T("nav.wallet", "Wallet")</span>
        </a>
        <a class="nav-float-tab" href="transactions" aria-label="@T("nav.activity", "Activity")" aria-current="@Current(ActivityIndex)">
            <span class="nav-float-icon">@Icon("activity", ActiveIndex == ActivityIndex)</span>
            <span>@T("nav.activity", "Activity")</span>
        </a>
    }
    <button type="button" class="nav-float-scan" aria-label="@ScanAria" data-testid="nav-scan" @onclick="OpenScan">
        <span class="nav-float-scan-disc">@Icon("scan", false)</span>
        <span>@ScanLabel</span>
    </button>
    @if (Shared)
    {
        var needsYou = Attention.Current.NeedsYouFor(Context.SharedWalletId!);
        <a class="nav-float-tab" href="@SharedHref("/pending")" aria-label="@PendingLabel(needsYou)"
           aria-current="@Current(RequestIndex)" data-testid="nav-pending">
            <span class="nav-float-icon">
                @Icon("pending", ActiveIndex == RequestIndex)
                @if (needsYou > 0)
                {
                    <span class="nav-badge-count" aria-hidden="true" data-testid="nav-pending-count">@CountBadge.Text(needsYou)</span>
                }
            </span>
            <span>@T("nav.pending", "Pending")</span>
        </a>
    }
    else
    {
        <a class="nav-float-tab" href="payments" aria-label="@T("nav.request.aria", "Request a payment")" aria-current="@Current(RequestIndex)">
            <span class="nav-float-icon">@Icon("pay", ActiveIndex == RequestIndex)</span>
            <span>@T("nav.request", "Request")</span>
        </a>
    }
    <button type="button" class="nav-float-tab" aria-label="@MoreLabel" aria-haspopup="dialog"
            aria-expanded="@(showMore ? "true" : "false")" aria-current="@Current(MoreIndex)" data-testid="nav-more" @onclick="OpenMore">
        <span class="nav-float-icon">
            @Icon("more", ActiveIndex == MoreIndex)
            @* Multisig lives under More, so a waiting payment shows here from every personal screen (FR-010a).
               Inside a shared wallet the Pending tab carries that wallet's own count instead. *@
            @if (!Shared && NeedsYouTotal > 0)
            {
                <span class="nav-badge-count" aria-hidden="true" data-testid="nav-more-count">@CountBadge.Text(NeedsYouTotal)</span>
            }
        </span>
        <span>@T("nav.more", "More")</span>
    </button>

    @* Shown once to people who used the old menu, where Digi-ID and Settings were tabs. *@
    @if (showMovedTip && !Shared)
    {
        <div class="nav-moved-tip" role="status" data-testid="nav-moved-tip">
            <p><strong>@T("nav.moved.title", "Digi-ID and Settings moved.")</strong> @T("nav.moved.body", "They are under More now.")</p>
            <button type="button" class="btn-ghost btn-sm" @onclick="DismissMovedTipAsync">@T("nav.moved.dismiss", "Got it")</button>
        </div>
    }
</nav>

<QrScannerModal IsOpen="@showScanner" OnScanned="OnScannedAsync" OnClosed="CloseScanner" FromMenu="true" />

<SharedWalletSwitcher IsOpen="@(showSwitcher && Shared)" CurrentId="@Context.SharedWalletId" OnClosed="CloseSwitcher" />

@if (showMore)
{
    <div id="@MoreSheetId" class="more-sheet-overlay" role="dialog" aria-modal="true" aria-labelledby="more-sheet-title" tabindex="-1"
         data-testid="more-sheet" @onclick="CloseMoreAsync" @onkeydown="OnMoreKeyDown">
        <div class="more-sheet sheet-enter" @onclick:stopPropagation="true">
            <div class="more-sheet-grip" aria-hidden="true"></div>
            <div class="flex items-center justify-between px-5 pb-3">
                <h3 id="more-sheet-title" class="block-title">@T("more.title", "More")</h3>
                <button type="button" class="icon-btn -mr-2"
                        aria-label="@T("more.close", "Close")" @onclick="CloseMoreAsync">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="more-sheet-list">
                @foreach (var entry in MoreMenu.Items)
                {
                    var item = entry;
                    var blocked = item.NeedsKeys && IsWatchOnly;
                    var here = CurrentPath == item.Href || CurrentPath.StartsWith(item.Href + "/", StringComparison.Ordinal);
                    <button type="button" class="more-sheet-row" disabled="@blocked" aria-current="@(here ? "page" : null)"
                            data-autofocus="@(item == MoreMenu.Items[0] ? "true" : null)" @onclick="() => GoAsync(item.Href)">
                        <span class="more-sheet-icon" aria-hidden="true">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="@item.Icon" />
                            </svg>
                        </span>
                        <span class="flex-1 min-w-0 text-left">
                            <span class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-white">
                                @T($"more.item.{item.Href}.label", item.Label)
                                @if (item.Href == "multisig" && NeedsYouTotal > 0)
                                {
                                    <span class="min-w-[20px] text-center text-[11px] font-bold bg-red-600 text-white px-1.5 py-0.5 rounded-full" data-testid="more-multisig-count"
                                          aria-label="@NeedsYouText(NeedsYouTotal)">@CountBadge.Text(NeedsYouTotal)</span>
                                }
                            </span>
                            <span class="block text-xs text-slate-600 dark:text-slate-400">@(blocked ? T("more.watch_only", "Not available for watch-only wallets") : T($"more.item.{item.Href}.desc", item.Description))</span>
                        </span>
                        <svg class="w-4 h-4 text-slate-400 dark:text-slate-500 flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    // Column positions in the bar. Scan sits in the middle column (2) and is never "the current page".
    private const int WalletIndex = 0, ActivityIndex = 1, RequestIndex = 3, MoreIndex = 4;
    private const string MoreSheetId = "more-sheet";
    private const string MovedTipKey = MoreMenu.MovedTipKey;

    // The menu must never show a raw key: if the translation files could not be loaded, the English text is used.
    private string T(string key, string english)
    {
        var text = L.T(key);
        return text == key ? english : text;
    }

    private bool showScanner;
    private bool showMore;
    private bool showSwitcher;

    // The shared wallet the current page belongs to, once it has been read. Until then, and when it cannot be
    // read (not this wallet's, deleted, locked), the personal menu is shown: never a shared menu without a name.
    private MultisigWalletConfig? sharedConfig;
    private string? sharedLoadKey;

    // AppState.OnChange carries no detail, so the active wallet seen last is kept and compared (FR-008).
    private string lastWalletId = "";
    private bool focusMore;
    private bool showMovedTip;

    // The pill behind the active tab takes the current wallet's colour.
    private string Accent => WalletService.ActiveWallet?.Color ?? "#0066FF";
    private bool IsWatchOnly => WalletService.ActiveWallet?.WalletType == "xpub";
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    // Not lower-cased: a shared wallet's id is used exactly as the address has it.
    private ShellContext Context => ShellContext.Resolve(Nav.ToBaseRelativePath(Nav.Uri));
    private bool Shared => Context.IsShared && sharedConfig is not null && sharedConfig.WalletId == Context.SharedWalletId;
    private string SharedScheme => sharedConfig is null ? "" : $"{sharedConfig.RequiredSignatures}-of-{sharedConfig.TotalSigners}";
    private string SharedHref(string page) => $"multisig/{Uri.EscapeDataString(Context.SharedWalletId ?? "")}{page}";

    private string NavLabel => Shared
        ? string.Format(T("nav.shared.label", "{0} shared wallet navigation"), sharedConfig!.DisplayName)
        : T("nav.label", "Main navigation");

    // Every multisig payment that needs the person, across the active wallet's shared wallets.
    private int NeedsYouTotal => Attention.Current.NeedsYouTotal;

    private string NeedsYouText(int count) => count == 1
        ? T("nav.count.more.one", "1 multisig payment needs you")
        : string.Format(T("nav.count.more.other", "{0} multisig payments need you"), CountBadge.Text(count));

    private string MoreLabel
    {
        get
        {
            var label = T("nav.more.aria", "More: Digi-ID, Settings and other tools");
            return !Shared && NeedsYouTotal > 0 ? $"{label}. {NeedsYouText(NeedsYouTotal)}" : label;
        }
    }

    private string PendingLabel(int needsYou)
    {
        var label = T("nav.pending.aria", "Pending payments of this shared wallet");
        if (needsYou <= 0) return label;
        var count = needsYou == 1
            ? T("nav.count.pending.one", "1 payment needs you")
            : string.Format(T("nav.count.pending.other", "{0} payments need you"), CountBadge.Text(needsYou));
        return $"{label}. {count}";
    }

    // Which tab the current page belongs to, or -1 for none. Wallet matches the home page only; Activity and Request
    // also match their sub-pages; More matches every page its list leads to.
    private int ActiveIndex
    {
        get
        {
            if (Shared)
            {
                return Context.Section switch
                {
                    SharedSection.Overview => WalletIndex,
                    SharedSection.Activity => ActivityIndex,
                    SharedSection.Pending => RequestIndex,
                    _ => -1,
                };
            }
            var path = CurrentPath;
            if (path.Length == 0) return WalletIndex;
            if (Under(path, "transactions")) return ActivityIndex;
            if (Under(path, "payments")) return RequestIndex;
            return MoreMenu.Owns(path) ? MoreIndex : -1;
        }
    }

    private static bool Under(string path, string root) => path == root || path.StartsWith(root + "/", StringComparison.Ordinal);
    private string? Current(int index) => ActiveIndex == index ? "page" : null;

    private RenderFragment Icon(string name, bool solid) => builder =>
    {
        var icon = NavIcons.All[name];
        if (solid && icon.Solid.Length > 0)
        {
            builder.OpenElement(0, "svg");
            builder.AddAttribute(1, "aria-hidden", "true");
            builder.AddAttribute(2, "viewBox", "0 0 24 24");
            builder.AddAttribute(3, "fill", "currentColor");
            foreach (var d in icon.Solid)
            {
                builder.OpenElement(4, "path");
                builder.AddAttribute(5, "fill-rule", "evenodd");
                builder.AddAttribute(6, "clip-rule", "evenodd");
                builder.AddAttribute(7, "d", d);
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }
        builder.OpenElement(10, "svg");
        builder.AddAttribute(11, "aria-hidden", "true");
        builder.AddAttribute(12, "fill", "none");
        builder.AddAttribute(13, "viewBox", "0 0 24 24");
        builder.AddAttribute(14, "stroke-width", "1.8");
        builder.AddAttribute(15, "stroke", "currentColor");
        foreach (var d in icon.Outline)
        {
            builder.OpenElement(16, "path");
            builder.AddAttribute(17, "stroke-linecap", "round");
            builder.AddAttribute(18, "stroke-linejoin", "round");
            builder.AddAttribute(19, "d", d);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        FirstReceive.Changed += OnFirstReceiveChanged;
        Attention.Changed += OnAttentionChanged;
        Shell.SwitcherRequested += OnSwitcherRequested;
        lastWalletId = ActiveWallet.WalletId;
        ReadPointerNow();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSharedAsync();
        _ = Attention.EnsureLoadedAsync();
    }

    // Reads the shared wallet the address points at. The same checks the pages make: it must be one the active
    // wallet owns. The key includes the wallet and the unlock state, so it is read again when either changes.
    private async Task LoadSharedAsync()
    {
        var context = Context;
        var key = context.IsShared ? $"{context.SharedWalletId}|{ActiveWallet.WalletId}|{WalletService.IsUnlocked}" : null;
        if (key == sharedLoadKey) return;
        sharedLoadKey = key;
        if (key is null)
        {
            sharedConfig = null;
            showSwitcher = false;
            return;
        }

        MultisigWalletConfig? config = null;
        try { config = await Multisig.GetConfigAsync(context.SharedWalletId!, ActiveWallet.WalletId, ActiveWallet.PublicKey); }
        catch { /* unreadable: the personal menu stays */ }
        if (sharedLoadKey != key) return;   // the page changed while this was being read
        sharedConfig = config;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckMovedTipAsync();
            await ReadDeviceAsync();
        }
        if (focusMore && showMore)
        {
            focusMore = false;
            try { await JS.InvokeVoidAsync("domHelpers.trapFocus", MoreSheetId); } catch { }
        }
    }

    // ----- Scan -----

    // On a desktop the middle button pastes first, so it says so (specs/030-desktop-paste-scan, FR-005). It follows
    // the device, never the remembered choice, so one use of the camera does not rename the menu.
    private bool pasteFirst;

    private string ScanLabel => pasteFirst ? T("nav.paste_scan", "Paste / Scan") : T("nav.scan", "Scan");
    private string ScanAria => pasteFirst
        ? T("nav.paste_scan.aria", "Paste or scan a code to pay, sign in or open a shared wallet item")
        : T("nav.scan.aria", "Scan a QR code to pay or sign in");

    // Read synchronously before the first render, so a desktop never shows "Scan" first.
    private void ReadPointerNow()
    {
        try { if (JS is IJSInProcessRuntime js) pasteFirst = js.Invoke<bool>("qrScanner.finePointer"); }
        catch (Exception) { /* not ready: the camera check below still runs */ }
    }

    // Only the camera check is async; it can only turn a touch device with no camera into paste-first.
    private async Task ReadDeviceAsync()
    {
        try
        {
            var facts = await JS.InvokeAsync<DeviceFacts>("qrScanner.deviceFacts");
            var first = ScanInputMode.Decide(facts, null) == ScanEntry.Paste;
            if (first != pasteFirst)
            {
                pasteFirst = first;
                StateHasChanged();
            }
        }
        catch (Exception) { }
    }

    private void OpenScan()
    {
        showMore = false;
        showSwitcher = false;
        showScanner = true;
        SyncDialogFlag();
    }

    private void CloseScanner()
    {
        showScanner = false;
        SyncDialogFlag();
    }

    private async Task OnScannedAsync(string data)
    {
        showScanner = false;
        SyncDialogFlag();
        // Every payment (address, digibyte: request, this wallet's payment link) goes to Send in memory, as from /pay,
        // so its address and amount never reach the address bar (spec 030, FR-021; spec 032, FR-001). Inside a shared
        // wallet it goes to that shared wallet's Send (spec 026, FR-002a). The counter only makes the address new when
        // that Send is already open; it carries nothing.
        var sharedId = Shared ? Context.SharedWalletId : null;
        if (ScanRouter.TryPayment(data, Nav.BaseUri, out var payment))
        {
            PayHandoff.Set(payment, sharedId);
            Nav.NavigateTo(ScanRouter.SendPagePath(sharedId, ++scanCount));
            return;
        }

        var sharedName = Shared ? sharedConfig!.DisplayName : null;
        var route = ScanRouter.Route(data, Nav.BaseUri, sharedId);
        switch (route.Kind)
        {
            case ScanTarget.DigiId:
                // Digi-ID belongs to the personal wallet: say so before the shared wallet is left.
                if (sharedName is not null)
                    Notifications.Info(string.Format(T("scan.leaving_shared", "Digi-ID sign-in uses your own wallet, so you are leaving {0}."), sharedName));
                Nav.NavigateTo(route.Url!);
                break;

            case ScanTarget.RoomInvite:
                Nav.NavigateTo(route.Url!);
                break;

            case ScanTarget.MultisigProposal:
                // A proposal belongs to one multisig. Find which of this wallet's multisigs it spends from and hand it
                // over in memory; that page checks it and adds it, exactly as if it had been scanned there.
                var match = await Multisig.FindWalletForProposalAsync(route.Payload!, ActiveWallet.WalletId, ActiveWallet.PublicKey, "");
                if (match is null)
                {
                    Notifications.Warning(T("scan.proposal_elsewhere", "That proposal is for a multisig that isn't on this device."));
                    break;
                }
                Handoff.Set(match.WalletId, route.Payload!);
                // The counter makes the address new each time, so a page that is already open looks again.
                Nav.NavigateTo($"/multisig/{Uri.EscapeDataString(match.WalletId)}/pending?scanned={++scanCount}");
                break;

            case ScanTarget.MultisigRedeemScript:
                Shell.OfferRedeemScript(route.Payload!);
                Nav.NavigateTo("/multisig/import");
                break;

            default:
                // Never guess: a code the wallet does not understand opens nothing.
                Notifications.Warning(T("scan.unknown", "This wallet can't open that code. Scan a DigiByte address, a payment request, a Digi-ID login or a multisig code."));
                break;
        }
    }

    private int scanCount;

    // ----- More -----

    private void OpenMore()
    {
        showSwitcher = false;
        showMore = true;
        focusMore = true;
        if (showMovedTip) _ = DismissMovedTipAsync();
        SyncDialogFlag();
    }

    private async Task CloseMoreAsync()
    {
        if (!showMore) return;
        try { await JS.InvokeVoidAsync("domHelpers.releaseFocus", MoreSheetId); } catch { }
        showMore = false;
        SyncDialogFlag();
    }

    private async Task OnMoreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseMoreAsync();
    }

    private async Task GoAsync(string href)
    {
        await CloseMoreAsync();
        Nav.NavigateTo(href);
    }

    // ----- Shared-wallet switcher -----

    private void OpenSwitcher()
    {
        showMore = false;
        showSwitcher = true;
        SyncDialogFlag();
    }

    // A page's context line asked for the switcher.
    private void OnSwitcherRequested() => InvokeAsync(() =>
    {
        if (!Shared) return;
        OpenSwitcher();
        StateHasChanged();
    });

    private void CloseSwitcher()
    {
        showSwitcher = false;
        SyncDialogFlag();
    }

    // A first-payment celebration waits while Scan, More or the switcher is open (spec 025, FR-023).
    private void SyncDialogFlag() => FirstReceive.ShellDialogOpen = showScanner || showMore || showSwitcher;

    // ----- The one-time "moved" tip -----

    // Only a device that was in use before needs it: its first session is over. A wallet created on this version
    // never saw the old tabs, so creating one marks the tip as seen.
    private async Task CheckMovedTipAsync()
    {
        if (showMovedTip || !FirstReceive.FirstSessionEnded) return;
        try
        {
            if (await Storage.GetAsync(MovedTipKey) == "1") return;
        }
        catch { return; }
        showMovedTip = true;
        StateHasChanged();
    }

    private async Task DismissMovedTipAsync()
    {
        showMovedTip = false;
        try { await Storage.SetAsync(MovedTipKey, "1"); } catch { }
        StateHasChanged();
    }

    private void OnStateChanged() => InvokeAsync(async () =>
    {
        // Switching to another personal wallet ends shared-wallet mode: land on that wallet's home, never on a
        // shared wallet of the one just left (FR-008). Locking and unlocking the same wallet changes nothing here.
        var now = ActiveWallet.WalletId;
        var switched = now.Length > 0 && lastWalletId.Length > 0 && now != lastWalletId;
        if (now.Length > 0) lastWalletId = now;
        if (switched && Context.IsShared)
        {
            Nav.NavigateTo("/");
            return;
        }
        await LoadSharedAsync();
        StateHasChanged();
    });

    private void OnAttentionChanged() => InvokeAsync(StateHasChanged);
    private void OnFirstReceiveChanged() => InvokeAsync(CheckMovedTipAsync);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            // Any navigation closes the list (a link inside it, the browser's Back button).
            showMore = false;
            showSwitcher = false;
            SyncDialogFlag();
            StateHasChanged();
            await LoadSharedAsync();
            _ = Attention.EnsureLoadedAsync();
            StateHasChanged();
        });

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        FirstReceive.Changed -= OnFirstReceiveChanged;
        Attention.Changed -= OnAttentionChanged;
        Shell.SwitcherRequested -= OnSwitcherRequested;
        FirstReceive.ShellDialogOpen = false;
    }
}
