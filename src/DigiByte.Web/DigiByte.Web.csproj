<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Bump these when cutting a wallet-v* tag. CI passes -p:Version=…
         so the workflow build always matches the tag, and a git-derived
         override below keeps non-CI builds (Railway, manual publishes)
         in sync as long as the working tree has tags fetched. The
         literal values here are the floor — what dev runs and shallow
         clones (no tags) display in the footer. -->
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <InformationalVersion>0.9.0</InformationalVersion>
    <!-- IL Trimming for smaller WASM download -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Brotli compression for published output -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <!-- Number and date style follow the wallet's own language (English or Spanish, spec 028), not the browser's, so every
         browser loads the same ICU subset that has both. This also lets the culture be set at startup: with the default
         per-browser subsets Blazor refuses a culture other than the browser's. Adding a language outside English, French,
         Italian, German and Spanish means changing this file. -->
    <BlazorIcuDataFileName>icudt_EFIGS.dat</BlazorIcuDataFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <!-- Baku source art: the full-size green-screen sheets stay in the repo but are not published or
       precached. Only the sliced poses under images/mascot/poses/ ship (see tools/mascot-slice). -->
  <ItemGroup>
    <Content Remove="wwwroot\images\mascot\Gemini_Generated_Image_*.jpg" />
    <None Include="wwwroot\images\mascot\Gemini_Generated_Image_*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigiByte.Wallet\DigiByte.Wallet.csproj" />
    <ProjectReference Include="..\DigiByte.Crypto\DigiByte.Crypto.csproj" />
    <ProjectReference Include="..\DigiByte.P2P.Shared\DigiByte.P2P.Shared.csproj" />
  </ItemGroup>

  <!-- Rebuild Tailwind CSS on build (purged & minified).
       Hooked before BeforeBuild, not before Build: MSBuild runs a target's dependencies first and its
       BeforeTargets hooks second, and all of Build's work is in its dependencies. Hooked on Build, this ran
       after the build had already fingerprinted and compressed wwwroot, so a publish shipped a rebuilt
       tailwind.css next to a fingerprint and a .gz copy of the old one. The service worker checks files
       against those fingerprints and installs nothing if one differs (see tools/verify-sw-manifest.py). -->
  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" Condition="Exists('node_modules/.package-lock.json')">
    <Exec Command="npx tailwindcss -i ./wwwroot/css/tailwind-input.css -o ./wwwroot/css/tailwind.css --minify" />
  </Target>

  <!-- Inject SHA-256 hashes for inline scripts into the published CSP.
       Runs after Publish so we hash Blazor's fingerprinted importmap
       (whose contents move per build). See CspHashInject.targets. -->
  <Import Project="CspHashInject.targets" />

</Project>
