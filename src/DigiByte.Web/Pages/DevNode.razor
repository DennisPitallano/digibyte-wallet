@page "/dev/node"
@inject NodeSourceOptions Options
@inject IHttpClientFactory HttpFactory
@inject ExplorerBackends Explorers
@inject IConfiguration Config
@inject GatewayRouteTimer RouteTimer
@inject NavigationManager Nav
@inject GatewayClient Gateway
@inject P2pGatewayOptions GatewayOptions
@using System.Diagnostics
@using System.Text.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http

<PageTitle>Node diagnostics — DigiByte Wallet</PageTitle>

@* Developer view for the own-node mode (specs/005-wallet-own-node-source, FR-013) and the P2P light-client gateway
   (specs/011-p2p-spv-gateway). It exists only when the deployment turns on OwnNode:DevView; otherwise the route shows the
   normal "not found" page. It reads only and changes nothing for regular views. *@
@if (Options.DevView)
{
    <div class="dn flex flex-col gap-4 pb-8">
        <SourceStatusCards Public="false" />

        @* How fast each route to the gateway answers, so a deployment can choose with numbers. Reads /v1/health only. *@
        @if (RouteTimer.Routes.Count > 0)
        {
            <section class="dn-card dn-rise" style="--i:4" aria-label="Gateway route speed">
                <h2 class="dn-h2">Gateway route speed</h2>
                <p class="dn-muted">Asks each route for the gateway health report @routeSamples times, taking turns, and times the answers. A route is called faster only when the gap is clearly bigger than the variation. No wallet data is sent.@(RouteTimer.Routes.Count < 2 ? " Set SpvGateway:ApiUrlAlt to compare a second route." : "")</p>
                <button type="button" class="dn-btn press-effect" disabled="@measuring" @onclick="MeasureAsync">
                    @if (measuring) { <span class="dn-spin" aria-hidden="true"></span> }
                    @(measuring ? "Measuring..." : "Measure")
                </button>
                @if (timings is not null)
                {
                    var (verdict, gap) = timings.Count > 1 ? GatewayRouteComparison.Compare(timings[0], timings[1]) : (RouteVerdict.NotEnoughData, 0d);
                    GatewayRouteTiming? best = verdict switch { RouteVerdict.FirstFaster => timings[0], RouteVerdict.SecondFaster => timings[1], _ => null };
                    var slowest = timings.Where(t => t.MedianMs is not null).Max(t => t.MedianMs) ?? 1;
                    <div class="dn-report dn-pop" aria-live="polite">
                        @foreach (var t in timings)
                        {
                            var isBest = best is not null && t.Url == best.Url;
                            <div class="dn-route @(isBest ? "best" : "")">
                                <div class="dn-route-head">
                                    <span class="dn-addr dn-num">@t.Url</span>
                                    @if (isBest) { <span class="dn-chip ok">faster</span> }
                                </div>
                                <div class="dn-bar"><i style="width:@(t.MedianMs is null ? 0 : Math.Max(4, (int)(t.MedianMs.Value / slowest * 100)))%"></i></div>
                                <div class="dn-tiles">
                                    @Tile("Median", Ms(t.MedianMs), null)
                                    @Tile("Fastest", Ms(t.MinMs), null)
                                    @Tile("Spread", Ms(t.SpreadMs), null)
                                    @Tile("Slowest 5%", Ms(t.P95Ms), null)
                                    @Tile("Failed", $"{t.Failures} of {t.Count + t.Failures}", t.Failures == 0)
                                </div>
                            </div>
                        }
                        @if (timings.Count > 1)
                        {
                            <p class="dn-muted">
                                @switch (verdict)
                                {
                                    case RouteVerdict.NotEnoughData:
                                        <text>Not enough answers on both routes to compare. Run it again.</text>
                                        break;
                                    case RouteVerdict.AboutTheSame:
                                        <text>The routes are about the same speed: the <span class="dn-num">@gap.ToString("0.#") ms</span> gap between the medians is within the run-to-run variation. Choose on security.</text>
                                        break;
                                    default:
                                        <text>The faster route is quicker by <span class="dn-num">@gap.ToString("0.#") ms</span> at the median, more than the variation can explain. Run it again to be sure before relying on it.</text>
                                        break;
                                }
                            </p>
                        }
                    </div>
                }
            </section>
        }

        @* Balance speed: the explorer (one request per address) against the SPV gateway (one request per 100 addresses). Reads only. *@
        @if (GatewayOptions.HasApiUrl)
        {
            <section class="dn-card dn-rise" style="--i:5" aria-label="Balance speed">
                <h2 class="dn-h2">Balance speed: explorer vs gateway</h2>
                <p class="dn-muted">One address per line. Reads the balance of the whole list @benchRounds times from each source, taking turns, and times every read. The explorer asks once per address; the gateway asks once per 100 addresses and only knows blocks from its index start, so older funds can make the balances differ. Nothing is sent but the addresses.</p>
                <textarea class="dn-input" placeholder="D... or dgb1... (paste a wallet's addresses to see the real difference)" @bind="benchInput" @bind:event="oninput" aria-label="Addresses to time"></textarea>
                <button type="button" class="dn-btn press-effect" disabled="@(benchRunning || string.IsNullOrWhiteSpace(benchInput))" @onclick="BenchAsync">
                    @if (benchRunning) { <span class="dn-spin" aria-hidden="true"></span> }
                    @(benchRunning ? $"Timing... round {benchRound} of {benchRounds}" : "Run benchmark")
                </button>

                @if (bench is not null)
                {
                    var slowestBench = bench.Max(b => b.MedianMs) ?? 1;
                    <div class="dn-report dn-pop" aria-live="polite">
                        @foreach (var b in bench)
                        {
                            <div class="dn-route @(b == bench.OrderBy(x => x.MedianMs ?? double.MaxValue).First() && bench.All(x => x.MedianMs is not null) ? "best" : "")">
                                <div class="dn-route-head">
                                    <span class="dn-addr dn-num">@b.Name</span>
                                    <span class="dn-chip @(b.Error is null ? "ok" : "warn")">@(b.Error is null ? "ok" : "failed")</span>
                                </div>
                                <div class="dn-bar"><i style="width:@(b.MedianMs is null ? 0 : Math.Max(4, (int)(b.MedianMs.Value / slowestBench * 100)))%"></i></div>
                                <div class="dn-tiles">
                                    @Tile("Median", Ms(b.MedianMs), null)
                                    @Tile("Fastest", Ms(b.SamplesMs.Count == 0 ? null : b.SamplesMs.Min()), null)
                                    @Tile("Slowest", Ms(b.SamplesMs.Count == 0 ? null : b.SamplesMs.Max()), null)
                                    @Tile("Balance", b.BalanceSatoshis is null ? "-" : $"{b.BalanceSatoshis.Value / 1e8:N8} DGB", null)
                                    @Tile("Requests per read", b.Requests.ToString(), null)
                                </div>
                                @if (b.Error is not null) { <p class="dn-err">@b.Error</p> }
                            </div>
                        }
                        @{
                            var exp = bench[0]; var gw = bench[1];
                        }
                        @if (exp.MedianMs is not null && gw.MedianMs is not null)
                        {
                            <p class="dn-muted">The gateway is <span class="dn-num">@((Math.Max(exp.MedianMs.Value, gw.MedianMs.Value) / Math.Min(exp.MedianMs.Value, gw.MedianMs.Value)).ToString("0.0"))x</span> @(gw.MedianMs <= exp.MedianMs ? "faster" : "slower") at the median (@Ms(gw.MedianMs) against @Ms(exp.MedianMs)).
                            @if (exp.BalanceSatoshis == gw.BalanceSatoshis) { <text>The balances match.</text> }
                            else { <text>The balances differ by <span class="dn-num">@(Math.Abs((exp.BalanceSatoshis ?? 0) - (gw.BalanceSatoshis ?? 0)) / 1e8) DGB</span>: the gateway only sees blocks from height @benchIndexedFrom, and the explorer ignores unconfirmed funds.</text> }
                            </p>
                        }
                    </div>
                }
            </section>
        }

        @* Compare the node with the explorers. *@
        <section class="dn-card dn-rise" style="--i:5" aria-label="Compare">
            <h2 class="dn-h2">Compare the node with the explorers</h2>
            <p class="dn-muted">One address per line. The node scans once for the whole list, which can take about 15 seconds.</p>
            <textarea class="dn-input" placeholder="D... or dgb1..." @bind="addressInput" @bind:event="oninput" aria-label="Addresses to compare"></textarea>
            <button type="button" class="dn-btn press-effect" disabled="@(running || string.IsNullOrWhiteSpace(addressInput))" @onclick="RunAsync">
                @if (running) { <span class="dn-spin" aria-hidden="true"></span> }
                @(running ? "Comparing..." : "Compare")
            </button>

            @if (report is not null)
            {
                <div class="dn-report dn-pop" aria-live="polite">
                    <p class="dn-verdict @(report.AllMatch ? "ok" : "warn")">
                        <span class="dn-verdict-ic" aria-hidden="true">@(report.AllMatch ? "✓" : "!")</span>
                        @(report.AllMatch ? "Everything matches." : "Not everything matches.")
                    </p>
                    @if (report.Message is not null) { <p class="dn-muted">@report.Message</p> }
                    @if (report.NodeError is not null) { <p class="dn-err">Node: @report.NodeError</p> }
                    @if (report.ExplorerError is not null) { <p class="dn-err">Explorer: @report.ExplorerError</p> }

                    <div class="dn-tiles">
                        @Tile("Addresses", report.AddressCount.ToString(), null)
                        @Tile("Height", $"{report.NodeHeight?.ToString("N0") ?? "-"} / {report.ExplorerHeight?.ToString("N0") ?? "-"}", report.HeightMatches)
                        @Tile("Balance, satoshis", $"{report.NodeBalance?.ToString("N0") ?? "-"} / {report.ExplorerBalance?.ToString("N0") ?? "-"}", report.BalanceMatches)
                        @Tile("Spendable outputs", $"{report.NodeUtxoCount?.ToString() ?? "-"} / {report.ExplorerUtxoCount?.ToString() ?? "-"}", report.UtxosMatch)
                    </div>
                    <p class="dn-muted dn-tiny">Each value is node / explorer.</p>

                    @if (report.Rows.Count > 0)
                    {
                        <ul class="dn-rows">
                            @foreach (var r in report.Rows)
                            {
                                <li class="dn-row @(r.Matches ? "ok" : "warn")">
                                    <span class="dn-chip @(r.Matches ? "ok" : "warn")">@(r.Matches ? "match" : "differs")</span>
                                    <span class="dn-addr dn-num">@r.Address</span>
                                    <span class="dn-row-nums dn-num">node @(r.NodeBalance?.ToString() ?? "-")/@(r.NodeUtxoCount?.ToString() ?? "-") · explorer @(r.ExplorerBalance?.ToString() ?? "-")/@(r.ExplorerUtxoCount?.ToString() ?? "-")</span>
                                    @if (r.Error is not null) { <span class="dn-err">@r.Error</span> }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private string addressInput = "";
    private bool running;
    private NodeComparisonReport? report;

    protected override void OnInitialized()
    {
        if (!Options.DevView)
        {
            // With the developer view off the page does not exist for anyone.
            Nav.NavigateTo("not-found", replace: true);
        }
    }

    private const int routeSamples = 25;
    private bool measuring;
    private IReadOnlyList<GatewayRouteTiming>? timings;

    private async Task MeasureAsync()
    {
        measuring = true;
        timings = null;
        try
        {
            timings = await RouteTimer.MeasureAsync(routeSamples);
        }
        finally
        {
            measuring = false;
        }
    }

    private const int benchRounds = 5;
    private string benchInput = "";
    private bool benchRunning;
    private int benchRound;
    private int benchIndexedFrom;
    private List<BenchResult>? bench;

    private sealed class NoStoreHandler : DelegatingHandler
    {
        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
        {
            request.SetBrowserRequestCache(BrowserRequestCache.NoStore);
            return base.SendAsync(request, cancellationToken);
        }
    }

    private sealed class BenchResult(string name, int requests)
    {
        public string Name { get; } = name;
        public int Requests { get; set; } = requests;
        public List<double> SamplesMs { get; } = [];
        public long? BalanceSatoshis { get; set; }
        public string? Error { get; set; }
        public double? MedianMs => SamplesMs.Count == 0 ? null : SamplesMs.OrderBy(x => x).ElementAt(SamplesMs.Count / 2);
    }

    private async Task BenchAsync()
    {
        benchRunning = true;
        bench = null;
        var addresses = benchInput.Split(['\n', '\r', ',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries).Distinct().ToList();
        var explorer = new BenchResult("Explorer (digiexplorer.info), one request per address", addresses.Count);
        var gateway = new BenchResult($"Gateway ({GatewayOptions.ApiUrl}), one request per 100 addresses", (addresses.Count + 99) / 100);
        // A mainnet explorer client of its own: the gateway is mainnet only, and a dev build's default network is testnet.
        // digiexplorer.info answers with max-age=10, so without NoStore the repeat rounds would be served from the browser cache.
        var mainnetExplorer = new BlockchainApiService(new HttpClient(new NoStoreHandler { InnerHandler = new HttpClientHandler() }), isTestnet: false);
        try
        {
            // The gateway keeps blocks from this height; ask for everything it has.
            try
            {
                using var health = await HttpFactory.CreateClient("SpvGatewayHealth").GetAsync($"{GatewayOptions.ApiUrl}/v1/health");
                using var doc = JsonDocument.Parse(await health.Content.ReadAsStringAsync());
                benchIndexedFrom = doc.RootElement.GetProperty("indexedFromHeight").GetInt32();
            }
            catch (Exception e) { gateway.Error = $"Could not read the gateway health report: {e.Message}"; }

            for (benchRound = 1; benchRound <= benchRounds; benchRound++)
            {
                StateHasChanged();
                await TimeAsync(explorer, async () => await mainnetExplorer.GetBalanceAsync(addresses));
                if (gateway.Error is null || benchIndexedFrom > 0)
                {
                    await TimeAsync(gateway, async () =>
                    {
                        long total = 0;
                        foreach (var chunk in addresses.Chunk(GatewayClient.MaxPerRequest))
                            total += (await Gateway.GetUtxosAsync(chunk, benchIndexedFrom)).Utxos.Sum(u => u.Amount);
                        return total;
                    });
                }
            }
        }
        finally
        {
            bench = [explorer, gateway];
            benchRunning = false;
        }
    }

    private static async Task TimeAsync(BenchResult result, Func<Task<long>> read)
    {
        var clock = Stopwatch.StartNew();
        try
        {
            result.BalanceSatoshis = await read();
            result.SamplesMs.Add(clock.Elapsed.TotalMilliseconds);
            result.Error = null;
        }
        catch (Exception e)
        {
            result.Error = e.Message;
        }
    }

    private static string Ms(double? v) => v is null ? "-" : v.Value < 10 ? $"{v.Value:0.0} ms" : $"{v.Value:0} ms";

    private async Task RunAsync()
    {
        running = true;
        report = null;
        try
        {
            // A strict node client built just for this check, so the comparison asks the node directly whatever the monitor says.
            var nodeUrl = Options.ApiUrl ?? Config["NodeApiUrl"] ?? "http://localhost:5260";
            var node = new NodeApiBlockchainService(HttpFactory.CreateClient("NodeApi"), nodeUrl, strictErrors: true);
            var comparer = new NodeSourceComparer(node, Explorers.All, Options.HeightTolerance);
            report = await comparer.CompareAsync(addressInput.Split(['\n', '\r', ',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries));
        }
        finally
        {
            running = false;
        }
    }

    private static RenderFragment Tile(string label, string value, bool? good) => __builder =>
    {
        <div class="dn-tile @(good is null ? "" : good == true ? "ok" : "warn")">
            <span class="dn-lbl">@label</span>
            <span class="dn-tile-val dn-num" @key="value">@value</span>
        </div>
    };
}
