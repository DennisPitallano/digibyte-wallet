@page "/digidollar/send"
@inject DigiDollarViewModel Dd
@inject LocalizationService L

<PageTitle>@L.T("dd.send.title") — DigiByte Wallet</PageTitle>

<AuthGuard>
<DigiDollarRouteGuard RequireSend="true">
    <div class="flex flex-col gap-5">
        <PageHeader Title="@L.T("dd.send.title")" BackLabel="@L.T("dd.back")" BackHref="/digidollar" />
        <DigiDollarHealthBanner />
        <DigiDollarPriceLine />
        <DigiDollarSendForm />
    </div>
</DigiDollarRouteGuard>
</AuthGuard>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Balances, health and the pending-send state must be fresh before the form validates anything.
        try { await Dd.EnsureLoadedAsync(); }
        catch { /* DigiDollar failures stay inside DigiDollar */ }
    }
}
