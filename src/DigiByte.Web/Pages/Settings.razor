</div>

@code {
    // The wallet's credential type decides which input is shown (PIN boxes or a passphrase field).
    private CredentialKind credKind => WalletService.ActiveWallet?.Kind ?? CredentialKind.Pin;
    /// <summary>What to tell the user after a failed check: a wrong credential, or the real reason (out of memory, newer format).</summary>
    private string FailureText() =>
        CredentialText.ForFailure(L, credKind, WalletService.LastCredentialFailure ?? CryptoFailure.WrongCredential);
    private string PromptWord => credKind == CredentialKind.Pin ? "PIN" : "passphrase";
    private bool Ready(string value) => credKind == CredentialKind.Pin ? value.Length >= 6 : value.Length > 0;
    // Option labels are translation keys, translated at render so they follow the chosen language.
    private static readonly (string Mode, string LabelKey)[] ThemeModes =
    [
        ("system", "settings.theme.system"),
        ("light", "settings.theme.light"),
        ("dark", "settings.theme.dark"),
    ];
    private static readonly (BakuMode Mode, string LabelKey)[] BakuModes =
    [
        (BakuMode.Full, "settings.baku.full"),
        (BakuMode.GuardianOnly, "settings.baku.guardian"),
        (BakuMode.Off, "settings.baku.off"),
    ];

    private string ThemeHint => Theme.Mode switch
    {
        "system" => L.T("settings.appearance.system_hint"),
        "light" => L.T("settings.light_mode"),
        _ => L.T("settings.dark_mode"),
    };

    private bool bakuTipsReset;

    private string BakuModeHint => Baku.Mode switch
    {
        BakuMode.GuardianOnly => L.T("settings.baku.hint_guardian"),
        BakuMode.Off => L.T("settings.baku.hint_off"),
        _ => L.T("settings.baku.hint_full"),
    };

    /// <summary>A translated sentence whose {n} placeholders are filled with translated names shown in bold.</summary>
    private MarkupString Bold(string key, params string[] nameKeys) =>
        new(L.T(key, nameKeys.Select(k => (object)$"<strong>{System.Net.WebUtility.HtmlEncode(L.T(k))}</strong>").ToArray()));

    /// <summary>"For wallet <b>name</b> · send to co-signers", with the wallet name encoded and in bold.</summary>
    private MarkupString MultisigHint() =>
        new(L.T("settings.multisig.hint",
            "<b>" + System.Net.WebUtility.HtmlEncode(WalletService.ActiveWallet?.Name ?? L.T("settings.wallet_fallback")) + "</b>"));

    /// <summary>The Share icon shown inside the first iPhone install step, with a translated label.</summary>
    private string ShareIconMarkup() =>
        $"<svg class=\"inline w-4 h-4 -mt-0.5 text-dgb-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" aria-label=\"{System.Net.WebUtility.HtmlEncode(L.T("settings.install.ios.share"))}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 8.25H7.5a2.25 2.25 0 0 0-2.25 2.25v9a2.25 2.25 0 0 0 2.25 2.25h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25H15m0-3-3-3m0 0-3 3m3-3V15\" /></svg>";

    /// <summary>What "Check for Updates" tells the user for each answer from the page script.</summary>
    private string UpdateText(string? status) => L.T(LocaleReasonKeys.For(UpdateAdvice.ResultOf(status)));

    private async Task CopyMultisigPublicKey()
    {
        string? key = null;
        try { key = WalletService.GetPublicKey(); } catch { }
        if (string.IsNullOrEmpty(key)) return;
        try { await Clipboard.CopyAsync(key, message: L.T("settings.multisig.copied", WalletService.ActiveWallet?.Name ?? L.T("settings.wallet_fallback"))); }
        catch { } // clipboard blocked: nothing to confirm
    }

    private async Task ResetBakuTipsAsync()
    {
        await Baku.ResetTipsAsync();
        bakuTipsReset = true;
    }

    private string MerchantDashboardUrl => Config["MerchantDashboardUrl"] ?? "https://pay.dgbwallet.app";

    [Inject] private AppState AppState { get; set; } = default!;
    [Inject] private LocalizationService L10n { get; set; } = default!;
    [Inject] private WalletService WalletService { get; set; } = default!;
    [Inject] private BiometricService Biometric { get; set; } = default!;
    [Inject] private SpendingLimitService SpendingLimit { get; set; } = default!;

    // Delete wallet state
    private bool showDeleteConfirm;
    private string deletePin = "";
    private string? deleteError;
    private CredentialInput? deletePinInput;
    private int walletCount;

    // Cache clear state
    private bool isCacheClearing;
    private bool cacheCleared;
    private bool showLanguagePicker;
    private ElementReference languageButton;

    /// <summary>The page re-renders when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private string CurrentLanguageName => LocalizationService.SupportedLocales.GetValueOrDefault(L.CurrentLocale, L.CurrentLocale);

    private async Task CloseLanguagePicker()
    {
        showLanguagePicker = false;
        StateHasChanged();
        try { await languageButton.FocusAsync(); } catch { /* row not rendered */ }
    }

    // Install-app state (spec 019). The mode follows the table in specs/019-settings-install-app/data-model.md. The types
    // and the rule live in InstallAppState, which the first-payment celebration uses too (spec 025).
    private InstallState installState = new(false, false, false, false, false, false);
    private InstallMode installMode = InstallMode.Hidden;
    private bool installed;            // the browser reported a completed install
    private bool showInstallSteps;
    private bool focusInstallDialog;
    private ElementReference installDialogRef;
    private DotNetObjectReference<Settings>? installRef;

    private async Task RefreshInstallStateAsync()
    {
        try { installState = await JS.InvokeAsync<InstallState>("pwaInstall.getState"); }
        catch { return; } // interop unavailable (prerender / blocked): leave the row hidden
        installMode = installed ? InstallMode.Hidden : InstallAppState.ComputeInstallMode(installState);
        if (installMode == InstallMode.Hidden) showInstallSteps = false;
        StateHasChanged();
    }

    [JSInvokable] public Task OnInstallAvailable() => InvokeAsync(RefreshInstallStateAsync);
    [JSInvokable] public Task OnPromptUsed() => InvokeAsync(RefreshInstallStateAsync);
    [JSInvokable] public Task OnIosDetected() => InvokeAsync(RefreshInstallStateAsync);
    [JSInvokable]
    public Task OnAppInstalled() => InvokeAsync(() =>
    {
        installed = true;
        installMode = InstallMode.Hidden;
        showInstallSteps = false;
        StateHasChanged();
    });

    private async Task OnInstallTapped()
    {
        if (installMode == InstallMode.Native)
        {
            try
            {
                if (await JS.InvokeAsync<bool>("pwaInstall.prompt"))
                {
                    installed = true;
                    installMode = InstallMode.Hidden;
                    return;
                }
            }
            catch { }
            // Cancelled or unavailable: re-read so the row falls back to menu steps instead of a dead button.
            await RefreshInstallStateAsync();
            return;
        }

        showInstallSteps = true;
        focusInstallDialog = true;
    }

    private void CloseInstallSteps() => showInstallSteps = false;

    private void OnInstallDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showInstallSteps = false;
    }

    public async ValueTask DisposeAsync()
    {
        try { if (installRef is not null) await JS.InvokeVoidAsync("pwaInstall.unsubscribe", installRef); } catch { }
        installRef?.Dispose();
    }

    // Update check state
    private bool _updateChecking;
    private bool _updateFound;
    private string? _updateMessage;

    // Biometric state
    private bool biometricSupported;
    private bool biometricEnabled;
    private bool bioConfirmSendEnabled;
    private bool isBioToggling;
    private bool showBioPinVerify;
    private bool showBioDisableConfirm;
    private string bioPin = "";
    private string? bioPinError;
    private CredentialInput? bioPinInput;

    protected override async Task OnInitializedAsync()
    {
        try { await Theme.InitializeAsync(); } catch { }
        try { walletCount = (await WalletService.GetAllWalletsAsync()).Count; } catch { walletCount = 1; }
        soundsOn = await Sounds.IsEnabledAsync();
    }

    private bool soundsOn;

    private async Task ToggleSoundsAsync()
    {
        soundsOn = !soundsOn;
        await Sounds.SetEnabledAsync(soundsOn);
        // Turning it on plays the receive chime once, so the user hears what they chose.
        if (soundsOn) await Sounds.PlayAsync(Sound.Receive);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusInstallDialog)
        {
            focusInstallDialog = false;
            try { await installDialogRef.FocusAsync(); } catch { }
        }

        if (firstRender)
        {
            try
            {
                installRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("pwaInstall.registerCallback", installRef, new { promptUsed = true });
                await RefreshInstallStateAsync();

                // Arriving from the first-payment celebration's Install app button (spec 025, FR-027): open the steps
                // straight away where the browser has no install prompt of its own, then drop the marker from the address.
                if (new Uri(Nav.Uri).Query.Contains("install=1"))
                {
                    if (installMode is InstallMode.IosSteps or InstallMode.MenuSteps)
                    {
                        showInstallSteps = true;
                        focusInstallDialog = true;
                        StateHasChanged();
                    }
                    Nav.NavigateTo("/settings", replace: true);
                }
            }
            catch { }

            // JS interop must run after first render in Blazor WASM
            biometricSupported = await Biometric.IsSupportedAsync();
            if (biometricSupported)
            {
                biometricEnabled = await Biometric.IsEnabledAsync();
                if (biometricEnabled)
                    bioConfirmSendEnabled = await Biometric.IsConfirmSendEnabledAsync();
            }
            StateHasChanged();
        }
    }

    private string NetworkIconBg => AppState.NetworkMode switch
    {
        "mainnet" => "bg-green-50 dark:bg-green-900/20",
        "testnet" => "bg-amber-50 dark:bg-amber-900/20",
        _ => "bg-blue-50 dark:bg-blue-900/20",
    };

    private string NetworkIconColor => AppState.NetworkMode switch
    {
        "mainnet" => "text-green-500",
        "testnet" => "text-amber-500",
        _ => "text-blue-500",
    };

    private void GoToBackup() => Nav.NavigateTo("/backup-seed");

    private async Task CheckForUpdateAsync()
    {
        _updateChecking = true;
        _updateFound = false;
        _updateMessage = null;
        StateHasChanged();

        try
        {
            // Ask the browser to look for a new version now. The answer says whether one is ready, still
            // downloading, or absent; only a ready one is applied, so a check with nothing new never reloads.
            var status = await JS.InvokeAsync<string>("pwaCheckForUpdate");
            _updateMessage = UpdateText(status);
            if (status == "ready")
            {
                _updateFound = true;
                StateHasChanged();
                await Task.Delay(1200);
                if (!await JS.InvokeAsync<bool>("pwaApplyUpdate"))
                {
                    _updateFound = false;
                    _updateMessage = UpdateText("none");
                }
            }
        }
        catch
        {
            _updateMessage = UpdateText("failed");
        }
        finally
        {
            _updateChecking = false;
            StateHasChanged();
            // Clear the status message after a few seconds
            await Task.Delay(4000);
            _updateMessage = null;
            _updateFound = false;
            StateHasChanged();
        }
    }

    private async Task OnDisplayModeChanged(ChangeEventArgs e)
    {
        AppState.IsSimpleMode = e.Value?.ToString() == "true";
        await AppState.SavePreferenceAsync("dgb-display-mode", AppState.IsSimpleMode ? "simple" : "advanced");
    }

    private bool showCurrencyPicker;

    private async Task SelectCurrency(string currency)
    {
        showCurrencyPicker = false;
        AppState.FiatCurrency = currency;
        await AppState.SavePreferenceAsync("dgb-currency", currency);
        Cache.RemoveByPrefix("price");
        await Storage.RemoveAsync(DigiByte.Web.Services.WalletSnapshotCache.PriceKey);
        await Snapshots.ForgetFetchTimesAsync();
        await SyncStates.DeleteAllAsync();
        AppState.NotifyStateChanged();
    }

    private async Task OnNetworkChanged(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString() ?? "regtest";
        AppState.NetworkMode = mode;
        AppState.IsTestnet = mode != "mainnet";
        await AppState.SavePreferenceAsync("dgb-network", mode);
        AppState.NotifyStateChanged();
    }

    private async Task OnLockTimeoutChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var mins) && mins > 0)
        {
            AppState.LockTimeout = TimeSpan.FromMinutes(mins);
            await AppState.SavePreferenceAsync("dgb-lock-timeout", mins.ToString());
            AppState.ResetLockTimer();
        }
    }

    private async Task ToggleLockOnHidden()
    {
        await AppState.SetLockOnHiddenAsync(!AppState.LockOnHidden);
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deletePin = "";
        deleteError = null;
    }

    // ── Biometric toggle methods ──

    private void ToggleBiometric()
    {
        if (biometricEnabled)
            showBioDisableConfirm = true;
        else
            showBioPinVerify = true;
    }

    private byte[]? bioPendingSeed;
    private bool bioWeakConsent;
    private bool bioAcceptWeak;

    private async Task AcceptBioWeak()
    {
        bioAcceptWeak = true;
        bioWeakConsent = false;
        await ConfirmBioEnroll();
    }

    private void DeclineBioWeak()
    {
        Biometric.CancelPendingEnrollment();
        bioPendingSeed = null;
        bioAcceptWeak = false;
        CancelBioToggle();
    }

    private void CancelBioToggle()
    {
        bioWeakConsent = false;
        showBioPinVerify = false;
        showBioDisableConfirm = false;
        bioPin = "";
        bioPinError = null;
    }

    private async Task ConfirmBioEnroll()
    {
        if (!Ready(bioPin)) return;
        isBioToggling = true;
        bioPinError = null;
        StateHasChanged();

        try
        {
            var walletId = await WalletService.GetActiveWalletIdAsync();
            if (walletId == null) { bioPinError = L.T("settings.biometric.no_wallet"); return; }

            var seed = await WalletService.GetDecryptedSeedAsync(walletId, bioPin);
            if (seed == null)
            {
                bioPinError = FailureText();
                bioPin = "";
                bioPinInput?.Clear();
                return;
            }

            var info = await WalletService.GetWalletAsync(walletId);
            bioPendingSeed = seed;
            var outcome = await Biometric.EnrollAsync(walletId, info?.Name ?? "Wallet", seed, bioAcceptWeak);
            if (outcome == BiometricEnrollOutcome.NeedsWeakConsent)
            {
                // This browser cannot tie the key to the device's own security: ask before going on (FR-018b).
                bioWeakConsent = true;
                return;
            }
            bioPendingSeed = null;
            bioWeakConsent = false;
            bioAcceptWeak = false;
            var success = outcome == BiometricEnrollOutcome.Enrolled;
            if (success)
            {
                // Also enroll seeds for all other wallets
                var allWallets = await WalletService.GetAllWalletsAsync();
                foreach (var w in allWallets)
                {
                    if (w.Id != walletId)
                    {
                        // We can't decrypt other wallets' seeds without their PINs,
                        // so they'll be auto-enrolled on their next PIN unlock
                    }
                }
                biometricEnabled = true;
                CancelBioToggle();
            }
            else
            {
                bioPinError = L.T("settings.biometric.failed_or_cancelled");
            }
        }
        catch
        {
            bioPinError = L.T("settings.biometric.failed");
        }
        finally
        {
            isBioToggling = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmBioDisable()
    {
        await Biometric.DisableAsync();

        biometricEnabled = false;
        bioConfirmSendEnabled = false;
        CancelBioToggle();
    }

    private async Task ToggleBioConfirmSend()
    {
        bioConfirmSendEnabled = !bioConfirmSendEnabled;
        await Biometric.SetConfirmSendAsync(bioConfirmSendEnabled);
    }

    private async Task ConfirmDelete()
    {
        if (!Ready(deletePin)) return;
        deleteError = null;

        // Verify PIN is correct first
        var walletId = await WalletService.GetActiveWalletIdAsync();
        if (walletId == null) return;

        var success = await WalletService.UnlockWalletAsync(walletId, deletePin);
        if (!success)
        {
            deleteError = FailureText();
            deletePin = "";
            deletePinInput?.Clear();
            return;
        }

        // PIN verified — delete everything
        Cache.Clear();
        await Biometric.DisableAsync();
        if (walletId != null) await SpendingLimit.DeleteSettingsAsync(walletId);
        await WalletService.WipeAllDataAsync();
        AppState.IsWalletCreated = false;
        AppState.IsWalletUnlocked = false;
        Nav.NavigateTo("/welcome");
    }

    private async Task ClearAllCaches()
    {
        isCacheClearing = true;
        StateHasChanged();

        await Snapshots.ClearAllAsync();
        HistorySync.ResetAll(); // its in-memory copy of the saved summaries and history goes too

        isCacheClearing = false;
        cacheCleared = true;
        StateHasChanged();

        await Task.Delay(2000);
        cacheCleared = false;
        StateHasChanged();
    }
}
