@page "/settings"
@implements IAsyncDisposable
@inject LocalizationService L
@inject ThemeService Theme
@using DigiByte.Wallet.Storage
@inject NavigationManager Nav
@inject MemoryCacheService Cache
@inject ISecureStorage Storage
@inject DigiByte.Web.Services.WalletSnapshotCache Snapshots
@inject WalletHistorySync HistorySync
@inject WalletSyncStateStore SyncStates
@inject IWebAssemblyHostEnvironment HostEnv
@inject IJSRuntime JS
@inject IConfiguration Config
@inject BakuService Baku
@inject ClipboardService Clipboard
@inject SoundService Sounds

<PageTitle>@L.T("settings.page_title")</PageTitle>

@if (showInstallSteps)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm scale-in" role="dialog" aria-modal="true" aria-labelledby="install-steps-title"
         tabindex="-1" @ref="installDialogRef" @onkeydown="OnInstallDialogKey" @onclick="CloseInstallSteps">
        <div class="bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-2xl p-6 mx-4 max-w-sm w-full shadow-2xl flex flex-col gap-3" @onclick:stopPropagation="true">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                </div>
                <h3 id="install-steps-title" class="block-title">@(installMode == InstallMode.IosSteps ? L.T("settings.install.title_ios") : L.T("settings.install.title"))</h3>
            </div>
            @if (installMode == InstallMode.IosSteps)
            {
                <ol class="flex flex-col gap-2 text-sm text-slate-600 dark:text-slate-300 list-decimal pl-5 leading-relaxed">
                    <li>@((MarkupString)L.T("settings.install.ios.step1", ShareIconMarkup()))</li>
                    <li>@Bold("settings.install.ios.step2", "settings.install.ios.add_to_home")</li>
                    <li>@Bold("settings.install.ios.step3", "settings.install.ios.add")</li>
                </ol>
                @if (installState.NonSafariIos)
                {
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.install.ios.not_safari", L.T("settings.install.ios.add_to_home"))</p>
                }
            }
            else
            {
                <ol class="flex flex-col gap-2 text-sm text-slate-600 dark:text-slate-300 list-decimal pl-5 leading-relaxed">
                    <li>@L.T("settings.install.menu.step1")</li>
                    <li>@Bold("settings.install.menu.step2", "settings.install.menu.install_app", "settings.install.menu.add_to_home", "settings.install.menu.install_dgb")</li>
                    <li>@L.T("settings.install.menu.step3")</li>
                </ol>
            }
            <button type="button" class="btn-primary btn-sm mt-1"
                    @onclick="CloseInstallSteps">@L.T("settings.install.close")</button>
        </div>
    </div>
}

<div class="flex flex-col gap-4">
    <h2 class="page-title slide-up">@L.T("settings.title")</h2>
    <BakuMessage MessageId="settings.tip" />

    <div class="flex flex-col gap-2">
        <h3 class="section-label px-1 mt-1">@L.T("settings.section.wallet")</h3>
        @* Manage Wallets *@
        <a href="/settings/wallets" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.wallets.title")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@(walletCount == 1 ? L.T("settings.wallets.count.one", walletCount) : L.T("settings.wallets.count.other", walletCount))</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </a>

        @* Backup *@
        <button class="card card-interactive slide-up flex items-center gap-3 w-full p-4 text-left"
                @onclick="GoToBackup">
            <div class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.backup")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.backup.hint")</p>
            </div>
        </button>

        @* Recovery Tools *@
        <a href="/recovery" class="card card-interactive slide-up flex items-center gap-3 w-full p-4 text-left no-underline">
            <div class="w-9 h-9 rounded-xl bg-cyan-50 dark:bg-cyan-900/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.recovery_tools")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.recovery_tools.hint")</p>
            </div>
        </a>

        @* Share xpub — watch-only key for DigiPay / external services *@
        <a href="/settings/xpub" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-900/40 flex items-center justify-center">
                    <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.xpub")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.xpub.hint")</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </a>

        @* DigiDollar account key for DigiPay (specs/035 W1); the page explains when a wallet has none *@
        <a href="/settings/digidollar-key" data-testid="settings-dd-key" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.dd_key")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.dd_key.hint")</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </a>

        @* Multisig public key — what co-signers ask for when building a shared wallet *@
        @if (WalletService.IsUnlocked && WalletService.ActiveWallet?.WalletType != "xpub")
        {
            <button type="button" @onclick="CopyMultisigPublicKey" class="card card-interactive slide-up w-full flex items-center justify-between p-4 text-left">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-purple-50 dark:bg-purple-900/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.multisig.copy")</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@MultisigHint()</p>
                    </div>
                </div>
            </button>
        }

        @* Merchant Dashboard — for shop owners. Same URL pattern as the Payments page.
           Uses the actual DigiPay product logo so the card reads as the sibling
           product rather than a generic shop icon. *@
        <a href="@MerchantDashboardUrl" target="_blank" rel="noopener" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <img src="/digipay-logo.svg" alt="" class="w-9 h-9 shrink-0" />
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.merchant")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.merchant.hint")</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
        </a>

        <h3 class="section-label px-1 mt-4">@L.T("settings.section.security")</h3>
        @* How the wallet is protected, with the passphrase upgrade tip *@
        <WalletProtectionCard />

        @* Biometric Unlock *@
        @if (biometricSupported)
        {
            <div class="card slide-up flex items-center justify-between p-4 card-hover">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                        <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a48.667 48.667 0 0 0-1.418 8.773 7.498 7.498 0 0 1-1.332-5.023A7.5 7.5 0 0 1 7.864 4.243ZM14.25 14.25a2.25 2.25 0 0 0-4.5 0v.75a2.25 2.25 0 0 0 4.5 0v-.75Zm-2.25-6.75a4.5 4.5 0 0 0-4.5 4.5v.75a4.5 4.5 0 0 0 9 0v-.75a4.5 4.5 0 0 0-4.5-4.5Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.biometric")</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@(biometricEnabled ? L.T("settings.biometric.on") : L.T("settings.biometric.off"))</p>
                    </div>
                </div>
                <button class="relative w-12 h-7 rounded-full transition-colors duration-200 @(biometricEnabled ? "bg-dgb-500" : "bg-slate-300 dark:bg-dgb-700")"
                        @onclick="ToggleBiometric" disabled="@isBioToggling">
                    <span class="absolute top-1 left-1 h-5 w-5 bg-white rounded-full shadow transition-transform duration-200 @(biometricEnabled ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>

            @if (bioWeakConsent)
            {
                <BiometricNotice Mode="BiometricNotice.NoticeMode.Consent" OnPrimary="AcceptBioWeak" OnSecondary="DeclineBioWeak" />
            }

            @* Biometric PIN verification for enrollment *@
            @if (showBioPinVerify)
            {
                <div class="scale-in bg-dgb-50 dark:bg-dgb-900 rounded-2xl border border-dgb-200 dark:border-dgb-800 p-4 flex flex-col gap-3">
                    <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-center">@L.T("credential.enter_to_enable_biometric", CredentialText.Word(L, credKind))</p>
                    <CredentialInput Kind="credKind" @ref="bioPinInput" ValueChanged="(v) => bioPin = v" OnSubmit="ConfirmBioEnroll" Error="@bioPinError" />
                    <div class="flex gap-2">
                        <button class="btn-secondary btn-sm flex-1"
                                @onclick="CancelBioToggle">@L.T("common.cancel")</button>
                        <button class="btn-primary btn-sm flex-1"
                                @onclick="ConfirmBioEnroll" disabled="@(!Ready(bioPin) || isBioToggling)">
                            @(isBioToggling ? L.T("settings.biometric.setting_up") : L.T("settings.biometric.enable"))
                        </button>
                    </div>
                </div>
            }

            @* Biometric disable confirmation *@
            @if (showBioDisableConfirm)
            {
                <div class="scale-in bg-amber-50 dark:bg-amber-900/10 rounded-2xl border border-amber-200 dark:border-amber-900/30 p-4 flex flex-col gap-3">
                    <p class="text-xs text-amber-600 dark:text-amber-400 font-medium leading-relaxed">
                        @L.T("credential.biometric_disable_confirm", CredentialText.Word(L, credKind))
                    </p>
                    <div class="flex gap-2">
                        <button class="btn-secondary btn-sm flex-1"
                                @onclick="CancelBioToggle">@L.T("common.cancel")</button>
                        <button class="flex-1 py-2.5 bg-amber-500 text-white text-sm font-semibold rounded-xl press-effect"
                                @onclick="ConfirmBioDisable">@L.T("settings.biometric.disable")</button>
                    </div>
                </div>
            }

            @* Confirm Sends with Biometric *@
            @if (biometricEnabled)
            {
                <div class="card slide-up flex items-center justify-between p-4 card-hover">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                            <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.confirm_sends")</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.confirm_sends.hint")</p>
                        </div>
                    </div>
                    <button class="relative w-12 h-7 rounded-full transition-colors duration-200 @(bioConfirmSendEnabled ? "bg-dgb-500" : "bg-slate-300 dark:bg-dgb-700")"
                            @onclick="ToggleBioConfirmSend">
                        <span class="absolute top-1 left-1 h-5 w-5 bg-white rounded-full shadow transition-transform duration-200 @(bioConfirmSendEnabled ? "translate-x-5" : "translate-x-0")"></span>
                    </button>
                </div>
            }
        }

        @* Auto-Lock Timeout *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.auto_lock")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.auto_lock.hint")</p>
                </div>
            </div>
            <select value="@((int)AppState.LockTimeout.TotalMinutes)" @onchange="OnLockTimeoutChanged"
                    class="bg-slate-100 dark:bg-dgb-800 border-0 text-sm text-slate-700 dark:text-slate-300 rounded-lg px-3 py-1.5 outline-none">
                <option value="1">@L.T("settings.auto_lock.minutes", 1)</option>
                <option value="2">@L.T("settings.auto_lock.minutes", 2)</option>
                <option value="5">@L.T("settings.auto_lock.minutes", 5)</option>
                <option value="10">@L.T("settings.auto_lock.minutes", 10)</option>
                <option value="15">@L.T("settings.auto_lock.minutes", 15)</option>
                <option value="30">@L.T("settings.auto_lock.minutes", 30)</option>
            </select>
        </div>

        @* Lock on Tab Hidden *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.lock_hidden")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.lock_hidden.hint")</p>
                </div>
            </div>
            <button class="relative w-12 h-7 rounded-full transition-colors duration-200 @(AppState.LockOnHidden ? "bg-dgb-500" : "bg-slate-300 dark:bg-dgb-700")"
                    @onclick="ToggleLockOnHidden">
                <span class="absolute top-1 left-1 h-5 w-5 bg-white rounded-full shadow transition-transform duration-200 @(AppState.LockOnHidden ? "translate-x-5" : "translate-x-0")"></span>
            </button>
        </div>

        @* Spending Limits *@
        @if (WalletService.ActiveWallet?.WalletType != "xpub")
        {
        <a href="/settings/spending-limits" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-red-50 dark:bg-red-900/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.286ZM12 15.75h.008v.008H12v-.008Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.spending_limits")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.spending_limits.hint")</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </a>
        }

        <h3 class="section-label px-1 mt-4">@L.T("settings.section.display")</h3>
        @* Appearance: follow the device, or force light / dark *@
        <div class="card p-4 flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500 dark:text-dgb-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path class="dark:hidden" stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                        <path class="hidden dark:block" stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.appearance")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@ThemeHint</p>
                </div>
            </div>
            <div class="segmented" role="radiogroup" aria-label="@L.T("settings.appearance")">
                @foreach (var (mode, labelKey) in ThemeModes)
                {
                    var active = Theme.Mode == mode;
                    <button type="button" role="radio" aria-checked="@(active ? "true" : "false")"
                            class="segmented-item flex-1" aria-pressed="@(active ? "true" : "false")"
                            @onclick="() => Theme.SetModeAsync(mode)">@L.T(labelKey)</button>
                }
            </div>
        </div>

        @* Display Mode *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6Zm0 9.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25Zm9.75-9.75A2.25 2.25 0 0 1 15.75 3.75H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.display_mode")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@(AppState.IsSimpleMode ? L.T("settings.display_mode.simple") : L.T("settings.display_mode.advanced"))</p>
                </div>
            </div>
            <select value="@(AppState.IsSimpleMode ? "true" : "false")" @onchange="OnDisplayModeChanged"
                    class="bg-slate-100 dark:bg-dgb-800 border-0 text-sm text-slate-700 dark:text-slate-300 rounded-lg px-3 py-1.5 outline-none max-w-[11rem]">
                <option value="true">@L.T("settings.display_mode.simple")</option>
                <option value="false">@L.T("settings.display_mode.advanced")</option>
            </select>
        </div>

        @* Currency *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.currency")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@(FiatCurrencies.Find(AppState.FiatCurrency)?.Name ?? AppState.FiatCurrency)</p>
                </div>
            </div>
            <button type="button" class="flex items-center gap-2 bg-slate-100 dark:bg-dgb-800 text-sm font-semibold text-slate-700 dark:text-slate-300 rounded-lg pl-2.5 pr-2 py-1.5 press-effect"
                    aria-haspopup="dialog" aria-label="@L.T("settings.currency"): @AppState.FiatCurrency" @onclick="() => showCurrencyPicker = true">
                <CurrencyFlag Code="@AppState.FiatCurrency" />
                @AppState.FiatCurrency
                <svg class="w-3.5 h-3.5 text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </button>
        </div>

        <CurrencyPickerSheet IsOpen="showCurrencyPicker" Selected="@AppState.FiatCurrency" OnSelected="SelectCurrency" OnClosed="() => showCurrencyPicker = false" />

        @* Language (spec 028): opens the language sheet; the row shows the language in use. *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.language")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.language.hint")</p>
                </div>
            </div>
            <button @ref="languageButton" @onclick="() => showLanguagePicker = true"
                    aria-haspopup="dialog" aria-label="@L.T("settings.language"): @CurrentLanguageName" lang="@L.CurrentLocale"
                    class="bg-slate-100 dark:bg-dgb-800 text-sm text-slate-700 dark:text-slate-300 rounded-lg px-3 py-1.5">
                @CurrentLanguageName
                <svg class="w-3 h-3 inline ml-1 opacity-50" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
        </div>

        <LanguagePickerSheet IsOpen="showLanguagePicker" OnClosed="CloseLanguagePicker" />

        @* Baku — how much of the mascot guide and guardian to show. Warnings always stay visible as text. *@
        <div class="card slide-up p-4 flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <img src="@BakuCatalog.PosePath("greeting")" alt="" class="w-9 h-9 shrink-0 object-contain" loading="lazy" />
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.baku")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.baku.hint")</p>
                </div>
            </div>
            <div class="segmented" role="radiogroup" aria-label="@L.T("settings.baku.aria")">
                @foreach (var (mode, labelKey) in BakuModes)
                {
                    var active = Baku.Mode == mode;
                    <button type="button" role="radio" aria-checked="@(active ? "true" : "false")"
                            class="segmented-item flex-1" aria-pressed="@(active ? "true" : "false")"
                            @onclick="() => Baku.SetModeAsync(mode)">@L.T(labelKey)</button>
                }
            </div>
            <div class="flex items-center justify-between">
                <p class="text-[11px] text-slate-400 dark:text-slate-500">@BakuModeHint</p>
                <button type="button" class="text-xs font-semibold text-dgb-500 hover:text-dgb-600" @onclick="ResetBakuTipsAsync">@L.T("settings.baku.reset")</button>
            </div>
            @if (bakuTipsReset)
            {
                <p class="text-[11px] text-green-600 dark:text-green-400" role="status">@L.T("settings.baku.reset_done")</p>
            }
        </div>

        @* Sounds: a chime when a payment arrives and when a send goes out. Off unless turned on here. *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
                    </svg>
                </div>
                <div>
                    <p id="sounds-label" class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.sounds")</p>
                    <p id="sounds-hint" class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.sounds_hint")</p>
                </div>
            </div>
            <button type="button" role="switch" aria-checked="@(soundsOn ? "true" : "false")" aria-labelledby="sounds-label" aria-describedby="sounds-hint"
                    data-testid="sounds-switch"
                    class="relative shrink-0 w-12 h-7 rounded-full transition-colors duration-200 @(soundsOn ? "bg-dgb-500" : "bg-slate-300 dark:bg-dgb-700")"
                    @onclick="ToggleSoundsAsync">
                <span class="absolute top-1 left-1 h-5 w-5 bg-white rounded-full shadow transition-transform duration-200 @(soundsOn ? "translate-x-5" : "translate-x-0")"></span>
            </button>
        </div>

        @if (installMode != InstallMode.Hidden)
        {
            <h3 class="section-label px-1 mt-4">@L.T("settings.section.app")</h3>
            @* Install: shown only while the wallet is not installed (spec 019) *@
            <button type="button" @onclick="OnInstallTapped"
                    class="card card-interactive slide-up flex items-center gap-3 w-full p-4 text-left">
                <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.install")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@(installMode == InstallMode.IosSteps ? L.T("settings.install.hint_ios") : L.T("settings.install.hint"))</p>
                </div>
            </button>
        }

        <h3 class="section-label px-1 mt-4">@L.T("settings.section.network")</h3>
        @* Network *@
        <div class="card slide-up flex items-center justify-between p-4 card-hover">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl @NetworkIconBg flex items-center justify-center">
                    <svg class="w-5 h-5 @NetworkIconColor" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.network")</p>
                    <p class="text-xs @NetworkIconColor font-medium">@AppState.NetworkMode</p>
                </div>
            </div>
            <select value="@AppState.NetworkMode" @onchange="OnNetworkChanged"
                    class="bg-slate-100 dark:bg-dgb-800 border-0 text-sm text-slate-700 dark:text-slate-300 rounded-lg px-3 py-1.5 outline-none">
                <option value="regtest">@L.T("settings.network.regtest")</option>
                <option value="testnet">@L.T("settings.network.testnet")</option>
                <option value="mainnet">@L.T("settings.network.mainnet")</option>
            </select>
        </div>

        @* Sign a PSBT (Advanced mode only) *@
        @if (!AppState.IsSimpleMode)
        {
        <a href="/settings/psbt-sign" class="card card-interactive slide-up flex items-center gap-3 w-full p-4 text-left no-underline">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-900/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.psbt")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.psbt.hint")</p>
            </div>
        </a>
        }

        @* Consolidate UTXOs *@
        @if (WalletService.ActiveWallet?.WalletType != "xpub")
        {
        <a href="/consolidate" class="card card-interactive slide-up flex items-center justify-between p-4 no-underline">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-900/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.consolidate")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.consolidate.hint")</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </a>
        }

        @* About & Info *@
        <div class="mt-4 pt-4 border-t border-slate-200 dark:border-dgb-800">
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2 px-1">@L.T("settings.section.about")</p>
            <div class="flex flex-col gap-2">
                <a href="/about" class="card card-interactive flex items-center gap-3 w-full p-4 text-left no-underline">
                    <div class="w-9 h-9 rounded-xl bg-dgb-50 dark:bg-dgb-900/40 flex items-center justify-center">
                        <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.about")</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.about.hint")</p>
                    </div>
                </a>
                <a href="/roadmap" class="card card-interactive flex items-center gap-3 w-full p-4 text-left no-underline">
                    <div class="w-9 h-9 rounded-xl bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.roadmap")</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("settings.roadmap.hint")</p>
                    </div>
                </a>
                <a href="/sponsors" class="flex items-center gap-3 w-full p-4 bg-white dark:bg-dgb-900 rounded-2xl border border-rose-200 dark:border-rose-900/40 hover:bg-slate-50 dark:hover:bg-dgb-800 transition-all card-hover text-left no-underline">
                    <div class="w-9 h-9 rounded-xl bg-rose-50 dark:bg-rose-900/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("settings.sponsors")</p>
                        <p class="text-xs text-rose-500">@L.T("settings.sponsors.hint")</p>
                    </div>
                </a>
                <a href="/analytics" class="card card-interactive flex items-center gap-3 w-full p-4 text-left no-underline">
                    <div class="w-9 h-9 rounded-xl bg-purple-50 dark:bg-purple-900/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                        </svg>
