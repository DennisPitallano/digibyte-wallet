@page "/create-wallet"
@inject WalletService WalletService
@inject AppState AppState
@inject NavigationManager Nav
@inject LocalizationService L
@inject CommonPasswordList CommonList
@inject FirstReceiveCoordinator FirstReceive
@inject SearchOfferCoordinator SearchOffer
@inject ISecureStorage Storage
@using DigiByte.Wallet.Storage

<PageTitle>@(isAddWalletMode ? L.T("welcome.page_title_add") : L.T("create.page_title")) — @L.T("app.name")</PageTitle>

<div class="flex flex-col gap-5">
    @if (isAddWalletMode)
    {
        <button type="button" class="back-btn self-start"
                @onclick="GoBack">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <span>@L.T("dd.back")</span>
        </button>
    }

    @* Step Indicator *@
    <div class="flex items-center justify-center gap-2 mb-2 fade-in">
        @for (int i = 0; i < totalSteps; i++)
        {
            var idx = i;
            <div class="h-1.5 rounded-full transition-all duration-500 ease-out @(idx <= currentStepIndex ? "bg-dgb-500 w-10" : "bg-slate-200 dark:bg-dgb-800 w-6")"></div>
        }
    </div>

    @if (step == Step.NameWallet)
    {
        <BakuMessage MessageId="create.intro" />
        <div class="slide-up">
            <h2 class="page-title">@L.T("create.name_title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@L.T("create.name_hint")</p>
        </div>

        <div class="flex flex-col gap-3">
            <input type="text" @bind="walletName" @bind:event="oninput"
                   placeholder="@L.T("create.name_placeholder")"
                   maxlength="30" autocomplete="off"
                   class="input" />
            <p class="text-xs text-slate-400 dark:text-slate-500 text-right">@walletName.Length / 30</p>
        </div>

        @* Color Picker *@
        <div class="flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("create.color_label")</p>
            <div class="flex flex-wrap gap-2.5">
                @foreach (var c in WalletInfo.ColorPalette)
                {
                    var color = c;
                    <button class="w-9 h-9 rounded-full transition-all duration-200 press-effect ring-offset-2 ring-offset-white dark:ring-offset-dgb-950 @(walletColor == color ? "ring-2 scale-110" : "hover:scale-105")"
                            style="background-color: @color; @(walletColor == color ? $"box-shadow: 0 0 0 2px {color}40; --tw-ring-color: {color};" : "")"
                            @onclick="() => walletColor = color">
                        @if (walletColor == color)
                        {
                            <svg class="w-4 h-4 mx-auto text-white drop-shadow" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>

        <button class="btn-primary w-full"
                @onclick="NameContinue" disabled="@string.IsNullOrWhiteSpace(walletName)">
            @L.T("create.continue")
        </button>
    }
    else if (step == Step.GenerateMnemonic)
    {
        <BakuMessage MessageId="backup.why" />
        <div class="slide-up">
            <h2 class="page-title">@L.T("create.phrase_title")</h2>
            <p class="text-sm text-amber-600 dark:text-amber-400 mt-2 leading-relaxed bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-xl p-3">
                @* The word "only" stays bold in every language: it is the point of the warning. *@
                @Before("create.phrase_warning.lead")<strong>@L.T("create.phrase_warning.only")</strong>@After("create.phrase_warning.lead")
            </p>
        </div>

        <div class="grid grid-cols-3 gap-2">
            @for (int i = 0; i < words.Length; i++)
            {
                var idx = i;
                <div class="flex items-center gap-1.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl px-2.5 py-2.5 shadow-sm">
                    <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 w-4 text-right">@(idx + 1)</span>
                    <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">@words[idx]</span>
                </div>
            }
        </div>

        <button class="btn-primary w-full slide-up-delay-2"
                @onclick="GoToConfirm">
            @L.T("create.written")
        </button>
    }
    else if (step == Step.ConfirmMnemonic)
    {
        <div class="slide-up">
            <h2 class="page-title">@L.T("create.confirm_title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@Before("create.confirm_prompt")<strong class="text-dgb-500">#@(confirmWordIndex + 1)</strong>@After("create.confirm_prompt")</p>
        </div>

        <div class="flex flex-col gap-3">
            <input type="text" @bind="confirmInput" @bind:event="oninput"
                   placeholder="@L.T("create.confirm_placeholder", confirmWordIndex + 1)" autocomplete="off"
                   class="input" />
            @if (confirmError != null)
            {
                <InlineError Message="@confirmError" />
            }
        </div>

        <div class="flex flex-col gap-2 slide-up-delay-2">
            <button class="btn-primary w-full"
                    @onclick="VerifyWord" disabled="@string.IsNullOrWhiteSpace(confirmInput)">
                @(confirmStep < 2 ? L.T("create.next") : L.T("create.confirm"))
            </button>
            <button class="text-sm text-dgb-500 hover:text-dgb-600 font-medium py-2" @onclick="BackToMnemonic">
                @L.T("create.show_again")
            </button>
        </div>
    }
    else if (step == Step.SetPin)
    {
        <BakuMessage MessageId="backup.done" Class="baku-celebrate" />
        <div class="slide-up text-center">
            <h2 class="page-title">@(credKind == CredentialKind.Pin ? L.T("create.set_pin") : L.T("create.passphrase.title"))</h2>
            <div class="flex justify-center gap-2 mt-3" role="group" aria-label="@L.T("create.credential.choose")">
                <button type="button" data-testid="choose-pin"
                        class="choice"
                        aria-pressed="@(credKind == CredentialKind.Pin ? "true" : "false")" @onclick="() => SelectKindAsync(CredentialKind.Pin)">@L.T("create.credential.pin")</button>
                <button type="button" data-testid="choose-passphrase"
                        class="choice"
                        aria-pressed="@(credKind == CredentialKind.Passphrase ? "true" : "false")" @onclick="() => SelectKindAsync(CredentialKind.Passphrase)">@L.T("create.credential.passphrase")</button>
            </div>
            @if (credKind == CredentialKind.Pin)
            {
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-3">@L.T("create.pin_choose")</p>
                <p class="text-xs text-amber-600 dark:text-amber-400 mt-2 max-w-xs mx-auto" data-testid="pin-limitation-note">@L.T("create.pin_limitation")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 max-w-xs mx-auto" data-testid="passphrase-recommended">@L.T("create.passphrase.recommended")</p>
            }
            else
            {
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-3 max-w-xs mx-auto">@L.T("create.passphrase.explain")</p>
                <p class="text-xs text-amber-600 dark:text-amber-400 mt-2 max-w-xs mx-auto" data-testid="passphrase-unrecoverable">@L.T("create.passphrase.unrecoverable")</p>
            }
        </div>

        @if (credKind == CredentialKind.Passphrase)
        {
            <div class="flex flex-col gap-4 items-center">
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.passphrase.label")</p>
                <CredentialInput @ref="passInput1" Kind="CredentialKind.Passphrase" IsNew="true"
                                 ValueChanged="(v) => { passphrase = v; pinError = null; }" OnSubmit="CreateWalletAsync" Error="@pinError" />
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.passphrase.confirm")</p>
                <CredentialInput @ref="passInput2" Kind="CredentialKind.Passphrase" IsNew="true" AutoFocus="false"
                                 ValueChanged="(v) => { passphraseConfirm = v; pinError = null; }" OnSubmit="CreateWalletAsync" />
            </div>
        }
        else
        {
        <div class="flex flex-col gap-4 items-center">
            @if (!isConfirmingPin)
            {
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.pin_enter")</p>
                <PinInput @ref="pinInput1" ValueChanged="(v) => pin = v" OnComplete="GoToConfirmPin" Error="@pinError" />
            }
            else
            {
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.pin_confirm")</p>
                <PinInput @ref="pinInput2" ValueChanged="(v) => pinConfirm = v" OnComplete="CreateWalletAsync" Error="@pinError" />
                <button class="text-sm text-dgb-500 hover:text-dgb-600 font-medium" @onclick="BackToSetPin">@L.T("create.pin_change")</button>
            }
        </div>
        }

        <button class="btn-primary w-full slide-up-delay-3"
                @onclick="OnPinButtonClick"
                disabled="@(isCreating || (credKind == CredentialKind.Passphrase ? (passphrase.Length == 0 || passphraseConfirm.Length == 0) : ((!isConfirmingPin && pin.Length < 6) || (isConfirmingPin && pinConfirm.Length < 6))))">
            @if (isCreating)
            {
                <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span>@L.T("create.creating")</span>
            }
            else if (credKind == CredentialKind.Pin && !isConfirmingPin)
            {
                <span>@L.T("create.continue")</span>
            }
            else
            {
                <span>@L.T("create.create_button")</span>
            }
        </button>
    }

    <div class="flex items-center gap-3 text-xs text-slate-400 dark:text-slate-500 mt-2">
        <a href="/help" class="hover:text-dgb-500 transition-colors">@L.T("welcome.link.help")</a>
        <span>·</span>
        <a href="/about" class="hover:text-dgb-500 transition-colors">@L.T("welcome.link.about")</a>
    </div>

    <div class="flex flex-col items-center gap-1.5 mt-4">
        <VersionBadge />
        <p class="text-[11px] text-slate-400 dark:text-slate-500">@L.T("welcome.pillars")</p>
    </div>
</div>


@if (legacyReason is { } legacyWhy)
{
    <LegacyProtectionConsent Reason="legacyWhy" OnAgree="AgreeLegacyAsync" OnCancel="CancelLegacy" />
}

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    // The text before and after {0} in a translated sentence, so the highlighted part can sit wherever the language puts it.
    private string Before(string key) { var t = L.T(key); var i = t.IndexOf("{0}", StringComparison.Ordinal); return i < 0 ? t : t[..i]; }
    private string After(string key) { var t = L.T(key); var i = t.IndexOf("{0}", StringComparison.Ordinal); return i < 0 ? "" : t[(i + 3)..]; }

    // A browser that cannot run the stronger protection: the wallet is created with the earlier one only if the user agrees.
    private CryptoFailure? legacyReason;
    private bool legacyAgreed;

    private async Task AgreeLegacyAsync()
    {
        legacyAgreed = true;
        legacyReason = null;
        await CreateWalletAsync();
    }

    private void CancelLegacy() => legacyReason = null;

    private enum Step { NameWallet, GenerateMnemonic, ConfirmMnemonic, SetPin }
    private Step step = Step.GenerateMnemonic;
    private string[] words = [];
    private string mnemonic = "";
    private int confirmStep;
    private int confirmWordIndex;
    private string confirmInput = "";
    private string? confirmError;
    private readonly int[] confirmIndices = new int[3];
    private string pin = "";
    private string pinConfirm = "";
    private string? pinError;
    private bool isCreating;
    private bool isConfirmingPin;
    private CredentialKind credKind = CredentialKind.Pin;
    private string passphrase = "";
    private string passphraseConfirm = "";
    private CredentialInput? passInput1;
    private CredentialInput? passInput2;
    private PinInput? pinInput1;
    private PinInput? pinInput2;
    private bool isAddWalletMode;
    private string walletName = "";
    private string walletColor = WalletInfo.ColorPalette[0];

    private int totalSteps => isAddWalletMode ? 4 : 3;
    private int currentStepIndex => step switch
    {
        Step.NameWallet => 0,
        Step.GenerateMnemonic => isAddWalletMode ? 1 : 0,
        Step.ConfirmMnemonic => isAddWalletMode ? 2 : 1,
        Step.SetPin => isAddWalletMode ? 3 : 2,
        _ => 0
    };

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        isAddWalletMode = uri.Query.Contains("addWallet=true");
        step = isAddWalletMode ? Step.NameWallet : Step.GenerateMnemonic;

        GenerateMnemonicPhrase();
    }

    private void GenerateMnemonicPhrase()
    {
        var m = DigiByte.Crypto.KeyGeneration.MnemonicGenerator.Generate();
        mnemonic = m.ToString();
        words = mnemonic.Split(' ');
        var rng = new Random();
        var indices = Enumerable.Range(0, words.Length).OrderBy(_ => rng.Next()).Take(3).OrderBy(i => i).ToArray();
        Array.Copy(indices, confirmIndices, 3);
        confirmWordIndex = confirmIndices[0];
    }

    private void GoBack()
    {
        if (isAddWalletMode)
            Nav.NavigateTo("/welcome?addWallet=true");
        else
            Nav.NavigateTo("/welcome");
    }

    private void NameContinue()
    {
        if (string.IsNullOrWhiteSpace(walletName)) return;
        step = Step.GenerateMnemonic;
    }

    private void GoToConfirm() { confirmStep = 0; confirmWordIndex = confirmIndices[0]; confirmInput = ""; confirmError = null; step = Step.ConfirmMnemonic; }
    private void BackToMnemonic() { step = Step.GenerateMnemonic; }

    private void VerifyWord()
    {
        if (!string.Equals(confirmInput.Trim(), words[confirmWordIndex], StringComparison.OrdinalIgnoreCase)) { confirmError = L.T("create.word_incorrect"); return; }
        confirmError = null; confirmInput = ""; confirmStep++;
        if (confirmStep >= 3) { step = Step.SetPin; } else { confirmWordIndex = confirmIndices[confirmStep]; }
    }

    private async Task SelectKindAsync(CredentialKind kind)
    {
        if (kind == credKind || isCreating) return;
        credKind = kind;
        pin = ""; pinConfirm = ""; passphrase = ""; passphraseConfirm = "";
        isConfirmingPin = false;
        pinError = null;
        if (kind == CredentialKind.Passphrase)
            await CommonList.EnsureLoadedAsync(); // the deny list, so a common passphrase can be explained before anything is stored
    }

    private async Task OnPinButtonClick()
    {
        if (credKind == CredentialKind.Passphrase) await CreateWalletAsync();
        else if (isConfirmingPin) await CreateWalletAsync();
        else GoToConfirmPin();
    }

    private void GoToConfirmPin()
    {
        if (pin.Length < 6) { pinError = L.T("create.pin_incomplete"); return; }
        pinError = null;
        pinConfirm = "";
        isConfirmingPin = true;
    }

    private void BackToSetPin()
    {
        isConfirmingPin = false;
        pin = "";
        pinConfirm = "";
        pinError = null;
        pinInput1?.Clear();
    }

    private async Task CreateWalletAsync()
    {
        if (isCreating) return; // ignore repeat submissions while the key is being derived
        pinError = null;
        string credential;
        if (credKind == CredentialKind.Passphrase)
        {
            var check = CredentialPolicy.Check(passphrase, CommonList);
            if (!check.Accepted) { pinError = L.T(CredentialPolicy.ReasonKey(check.Reason)); return; }
            if (CredentialPolicy.Normalise(passphrase) != CredentialPolicy.Normalise(passphraseConfirm))
            {
                pinError = L.T("create.passphrase.mismatch"); passphraseConfirm = ""; passInput2?.Clear(); return;
            }
            credential = passphrase;
        }
        else
        {
            if (pin.Length < 6) { pinError = L.T("create.pin_incomplete"); return; }
            if (pin != pinConfirm) { pinError = L.T("create.pin_mismatch"); pinConfirm = ""; pinInput2?.Clear(); return; }
            credential = pin;
        }
        isCreating = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var name = isAddWalletMode ? walletName.Trim() : L.T("wallet.default_name"); // saved in the chosen language (spec 028)
            var color = isAddWalletMode ? walletColor : null;
            WalletService.SetNetworkMode(AppState.NetworkMode);
            var created = await WalletService.CreateWalletAsync(name, mnemonic, credential, color, credKind, legacyAgreed);
            // A wallet made from a phrase generated just now cannot have history, so it is known to be empty without waiting
            // for the network: its first payment will be celebrated (spec 025, FR-011). Nothing secret is stored for this.
            try { await FirstReceive.MarkCreatedEmptyAsync(created.Id); } catch { }
            // Created here from a new phrase: it never gets the "search further" offer (spec 027, FR-002a).
            await SearchOffer.MarkOriginAsync(created.Id, WalletOrigin.Created);
            // A wallet created on this menu never saw the old tabs: no "Digi-ID and Settings moved" tip for it.
            try { await Storage.SetAsync(DigiByte.Web.Layout.MoreMenu.MovedTipKey, "1"); } catch { }
            // Remember where this wallet started, so a later restore can begin there (specs/011-p2p-spv-gateway). Best effort.
            await WalletService.RecordBirthHeightAsync();
            AppState.IsWalletCreated = true; AppState.IsWalletUnlocked = true; AppState.NotifyStateChanged();
            Nav.NavigateTo("/");
        }
        catch (LegacyProtectionConsentRequiredException ex) { legacyReason = ex.Reason; }
        catch (Exception ex) { pinError = L.T("create.failed", ex.Message); }
        finally { isCreating = false; }
    }
}
