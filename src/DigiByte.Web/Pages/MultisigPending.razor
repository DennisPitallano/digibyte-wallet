@page "/multisig/{WalletId}/pending"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject ClipboardService Clipboard
@inject WalletService WalletService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SigningRoomClient Room
@implements IDisposable

<PageTitle>Pending Transactions — DigiByte Wallet</PageTitle>

<AuthGuard>
<div class="flex flex-col gap-4">
    <PageHeader Title="Pending Transactions" Subtitle="@config?.DisplayName" BackLabel="@(config?.DisplayName ?? "Multisig")" BackHref="@($"/multisig/{WalletId}")">
        <WalletChip />
    </PageHeader>

    @if (isLoading)
    {
        <div class="flex flex-col gap-3">
            @for (int i = 0; i < 2; i++)
            {
                <div class="p-4 bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800">
                    <div class="h-5 w-48 skeleton rounded"></div>
                    <div class="h-4 w-32 skeleton rounded mt-2"></div>
                </div>
            }
        </div>
    }
    else if (config == null)
    {
        <MultisigAccessNotice State="access" />
    }
    else
    {
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 rounded-xl" role="status">
                <p class="text-sm text-green-700 dark:text-green-300 break-words">@message</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800/30 rounded-xl" role="alert">
                <p class="text-sm text-red-600 dark:text-red-400 break-words">@error</p>
            </div>
        }

        @* A co-signer who was sent a room code (or does not have the payment yet) joins here (spec 018 follow-up) *@
        @if (config.OwnKeyIndex >= 0)
        {
            <button type="button" class="self-start inline-flex items-center gap-2 min-h-[44px] px-4 bg-white dark:bg-dgb-900 border border-dgb-300 dark:border-dgb-700 text-dgb-600 dark:text-dgb-300 text-sm font-semibold rounded-xl hover:bg-dgb-50 dark:hover:bg-dgb-800 transition-all press-effect"
                    @onclick='() => Nav.NavigateTo("/multisig/sign-room")'>
                <UxIcon Name="live" Class="w-4 h-4 shrink-0" />
                Join a room with a code
            </button>
        }

        @if (queue.Count == 0)
        {
            <EmptyState Message="Nothing is waiting. Payments that need signatures will appear here, or join a room with a code." ActionLabel="Create a payment"
                        OnAction='() => Nav.NavigateTo($"/multisig/{WalletId}/send")' />
        }
        else
        {
            <div class="flex flex-col gap-3">
                @if (queue.Count(q => q.Status == PendingTxStatus.Cancelled) > 1)
                {
                    <button class="self-end min-h-[44px] px-3 text-sm font-medium text-slate-500 hover:text-red-500" @onclick="() => RemoveCancelled(null)">Clear all cancelled</button>
                }
                @foreach (var tx in queue)
                {
                    var mine = MultisigWalletService.NeedsMySignature(tx, config);
                    var open = tx.Status is PendingTxStatus.AwaitingSignatures or PendingTxStatus.ReadyToFinalize;
                    var liveRoom = Room.Current?.UnsignedTxId == tx.UnsignedTxId && !string.IsNullOrEmpty(tx.UnsignedTxId);
                    var state = PendingStateClassifier.Classify(tx, LocalKey, liveRoom);
                    <div class="slide-up-delay-1 p-4 bg-white dark:bg-dgb-900 rounded-2xl border @(mine ? "border-dgb-300 dark:border-dgb-600" : "border-slate-200/80 dark:border-dgb-800") @(tx.Status == PendingTxStatus.Cancelled ? "opacity-60" : "")">
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <StatusBadge State="state" />
                            <span class="text-[11px] text-slate-400 shrink-0">@MultisigFormat.Age(tx.CreatedAt)</span>
                        </div>

                        <PaymentSummary Embedded="true" ShowCheckCue="mine"
                                        Summary="PaymentSummaryBuilder.Build(tx.AmountSatoshis, tx.FeeSatoshis, tx.DestinationAddress, tx.Memo, null)" />

                        @if (open)
                        {
                            <div class="mt-3"><SignerProgress Config="config" Pending="tx" /></div>
                        }

                        @if (tx.Status == PendingTxStatus.Failed && !string.IsNullOrEmpty(tx.FailureReason))
                        {
                            <p class="text-xs text-red-600 dark:text-red-400 mt-2 break-words" role="alert">Broadcast failed: @tx.FailureReason</p>
                        }

                        @* Actions *@
                        @if (open || tx.Status == PendingTxStatus.Failed)
                        {
                            <div class="flex flex-wrap gap-2 mt-3">
                                @if (tx.Status == PendingTxStatus.ReadyToFinalize)
                                {
                                    <button class="flex-1 min-h-[44px] py-2 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-xl transition-colors press-effect disabled:opacity-50"
                                            @onclick="() => BroadcastTransaction(tx)" disabled="@isBroadcasting">
                                        @(isBroadcasting && busyId == tx.Id ? "Broadcasting…" : "Broadcast")
                                    </button>
                                }
                                @if (tx.Status == PendingTxStatus.Failed)
                                {
                                    <button class="flex-1 min-h-[44px] py-2 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                                            @onclick="() => RetryBroadcast(tx)" disabled="@isBroadcasting">Retry broadcast</button>
                                }
                                @if (mine)
                                {
                                    <button class="flex-1 min-h-[44px] py-2 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl transition-colors press-effect disabled:opacity-50"
                                            @onclick="() => signConfirmFor = tx.Id" disabled="@isSigning">
                                        @(isSigning && busyId == tx.Id ? "Signing…" : "Sign")
                                    </button>
                                }
                                @if (open)
                                {
                                    <button class="min-h-[44px] px-3 text-sm font-semibold rounded-xl transition-all press-effect @(liveRoom ? "flex-1 bg-dgb-500 hover:bg-dgb-600 text-white" : "bg-white dark:bg-dgb-900 border border-dgb-300 dark:border-dgb-700 text-dgb-600 dark:text-dgb-300 hover:bg-dgb-50 dark:hover:bg-dgb-800")" @onclick="() => ToggleOnline(tx)" aria-expanded="@(onlineFor == tx.Id)">
                                        @(liveRoom ? "Open room" : "Sign together online")
                                    </button>
                                }
                                <button class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-dgb-800 transition-all press-effect" @onclick="() => ToggleShare(tx)" aria-expanded="@(shareFor == tx.Id)">Share</button>
                                @if (tx.Status != PendingTxStatus.Failed)
                                {
                                    <button class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-dgb-800 transition-all press-effect" @onclick="() => ToggleImport(tx)" aria-expanded="@(importFor == tx.Id)">Import signature</button>
                                }
                                <button class="min-h-[44px] px-3 text-sm font-medium text-slate-400 hover:text-red-500" @onclick="() => cancelFor = tx.Id">Cancel</button>
                            </div>
                        }

                        @if (tx.Status == PendingTxStatus.Cancelled)
                        {
                            <div class="flex justify-end mt-3">
                                <button class="min-h-[44px] px-3 text-sm font-medium text-slate-500 hover:text-red-500" @onclick="() => RemoveCancelled(tx.Id)">Remove from list</button>
                            </div>
                        }

                        @* Confirm signing: restate amount and recipient (spec 018, FR-007) *@
                        @if (signConfirmFor == tx.Id && mine)
                        {
                            <div class="mt-3 p-3 bg-white dark:bg-dgb-900 border border-dgb-300 dark:border-dgb-700 rounded-xl flex flex-col gap-2" role="alertdialog" aria-label="Confirm signing">
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">Sign @MultisigFormat.Dgb(tx.AmountSatoshis) DGB to @MultisigFormat.Short(tx.DestinationAddress)?</p>
                                <div class="flex gap-2">
                                    <button class="flex-1 min-h-[44px] py-2 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                                            disabled="@isSigning" @onclick="() => ConfirmSign(tx)">Confirm and sign</button>
                                    <button class="min-h-[44px] px-3 text-sm text-slate-500 font-medium" @onclick="() => signConfirmFor = null">Back</button>
                                </div>
                            </div>
                        }

                        @* Sign together online (specs/017-multisig-online-signing) *@
                        @if (onlineFor == tx.Id)
                        {
                            <div class="mt-3 p-3 bg-slate-50 dark:bg-dgb-800/50 rounded-xl border border-slate-200 dark:border-dgb-700 flex flex-col gap-2">
                                @if (config.OwnKeyIndex < 0)
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400" role="status">Watch-only copies can't join signing rooms. Use Share and Import signature instead.</p>
                                }
                                else if (onlineState == OnlineState.Checking)
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400" role="status">Checking the signing service…</p>
                                }
                                else if (onlineState == OnlineState.Unavailable)
                                {
                                    <p class="text-xs text-amber-700 dark:text-amber-300" role="status">Online signing is unavailable right now. You can still share and import signatures.</p>
                                }
                                else
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Open a room and share its code. Co-signers sign on their own devices and everyone sees signatures arrive live.</p>
                                    <label class="text-xs font-semibold text-slate-500 dark:text-slate-400" for="room-length">Room stays open for</label>
                                    <select id="room-length" @bind="lifetime" class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 rounded-xl text-sm text-slate-900 dark:text-white">
                                        @foreach (var minutes in lifetimes)
                                        {
                                            <option value="@minutes">@(minutes >= 60 ? $"{minutes / 60} hour{(minutes >= 120 ? "s" : "")}" : $"{minutes} minutes")</option>
                                        }
                                    </select>
                                    <label class="text-xs font-semibold text-slate-500 dark:text-slate-400" for="room-name">Your name in the room</label>
                                    <input id="room-name" @bind="roomName" @bind:event="oninput" maxlength="40"
                                           class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 rounded-xl text-sm text-slate-900 dark:text-white outline-none focus:border-dgb-500" />
                                    <div class="flex gap-2">
                                        <button class="flex-1 min-h-[44px] py-2 bg-dgb-500 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                                                disabled="@(isOpening || string.IsNullOrWhiteSpace(roomName))" @onclick="() => OpenRoomAsync(tx)">
                                            @(isOpening ? "Opening…" : "Open room")
                                        </button>
                                        <button class="min-h-[44px] px-3 text-sm text-slate-500 font-medium" @onclick="() => onlineFor = null">Close</button>
                                    </div>
                                }
                            </div>
                        }

                        @* Share panel *@
                        @if (shareFor == tx.Id)
                        {
                            <div class="mt-3 p-3 bg-slate-50 dark:bg-dgb-800/50 rounded-xl border border-slate-200 dark:border-dgb-700 flex flex-col gap-2">
                                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Send this to your co-signers so they can sign:</p>
                                <div class="flex flex-wrap gap-2">
                                    <button class="min-h-[44px] px-3 bg-dgb-500 text-white text-xs font-semibold rounded-xl press-effect" @onclick="() => CopyPsbt(tx)">Copy PSBT</button>
                                    <button class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 text-xs font-semibold text-slate-700 dark:text-slate-200 rounded-xl press-effect" @onclick="() => DownloadPsbt(tx)">Save as file</button>
                                </div>
                                @if (tx.PsbtBase64.Length <= 2200)
                                {
                                    <div class="flex justify-center pt-1"><QrImage Payload="@tx.PsbtBase64" Alt="Proposal QR code" /></div>
                                }
                                else
                                {
                                    <p class="text-[11px] text-slate-400">This proposal is too large for a QR code. Use Copy or Save as file.</p>
                                }
                            </div>
                        }

                        @* Import panel *@
                        @if (importFor == tx.Id)
                        {
                            <div class="mt-3 p-3 bg-slate-50 dark:bg-dgb-800/50 rounded-xl border border-slate-200 dark:border-dgb-700 flex flex-col gap-2">
                                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Add a co-signer's signed copy (paste, scan, or choose a file):</p>
                                <textarea @bind="importPsbtBase64" @bind:event="oninput" rows="3" aria-label="Signed PSBT from co-signer"
                                          placeholder="Base64-encoded PSBT…"
                                          class="w-full px-3 py-2 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 rounded-xl text-[11px] font-mono text-slate-900 dark:text-white outline-none focus:border-dgb-500 transition-all resize-none"></textarea>
                                <div class="flex flex-wrap gap-2">
                                    <button class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 text-xs font-semibold text-slate-700 dark:text-slate-200 rounded-xl press-effect" @onclick="PasteImport">Paste</button>
                                    <button class="min-h-[44px] px-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 text-xs font-semibold text-slate-700 dark:text-slate-200 rounded-xl press-effect" @onclick="() => showScanner = true">Scan QR</button>
                                    <label class="min-h-[44px] px-3 inline-flex items-center bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 text-xs font-semibold text-slate-700 dark:text-slate-200 rounded-xl cursor-pointer">
                                        Choose file
                                        <InputFile OnChange="OnFileChosen" class="hidden" accept=".txt,.psbt,text/plain" />
                                    </label>
                                </div>
                                @if (!string.IsNullOrEmpty(importNotice))
                                {
                                    <p class="text-xs text-amber-600 dark:text-amber-400" role="status">@importNotice</p>
                                }
                                <div class="flex gap-2">
                                    <button class="flex-1 min-h-[44px] py-2 bg-dgb-500 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                                            @onclick="() => ImportSignedPSBT(tx)" disabled="@(string.IsNullOrWhiteSpace(importPsbtBase64))">Merge signatures</button>
                                    <button class="min-h-[44px] px-3 text-sm text-slate-500 font-medium" @onclick="() => importFor = null">Close</button>
                                </div>
                            </div>
                        }

                        @* Cancel confirmation *@
                        @if (cancelFor == tx.Id)
                        {
                            <div class="mt-3 p-3 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30 rounded-xl" role="alertdialog" aria-label="Confirm cancel">
                                <p class="text-sm font-bold text-red-700 dark:text-red-300">Cancel this proposal?</p>
                                <p class="text-xs text-red-700 dark:text-red-400 leading-relaxed mt-1">
                                    This only cancels it on this device. Co-signers who already have a copy could still sign and broadcast it.
                                    This device will not broadcast it.
                                </p>
                                <div class="flex gap-2 mt-2">
                                    <button class="min-h-[44px] px-4 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold rounded-xl press-effect" @onclick="() => CancelProposal(tx)">Cancel proposal</button>
                                    <button class="min-h-[44px] px-3 text-xs font-medium text-slate-500" @onclick="() => cancelFor = null">Keep it</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<QrScannerModal IsOpen="@showScanner" OnScanned="OnScannedImport" OnClosed="@(() => showScanner = false)" />
</AuthGuard>

@code {
    [Parameter] public string WalletId { get; set; } = "";

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private List<PendingMultisigTransaction> queue = [];
    private bool isLoading = true;
    private bool isSigning;
    private bool isBroadcasting;
    private string? busyId;
    private string? shareFor;
    private string? importFor;
    private string? cancelFor;
    private bool showScanner;
    private string importPsbtBase64 = "";
    private string? importNotice;
    private string? message;
    private string? error;

    private string? loadedFor;
    private string? signConfirmFor;
    private string? LocalKey => config?.CoSigners.FirstOrDefault(c => c.IsLocal)?.PublicKeyHex;

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == WalletId) return;
        loadedFor = WalletId;
        isLoading = true;
        config = null;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;
            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
            await Reload();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Reload()
    {
        if (config is null) return;
        var all = await MultisigService.GetPendingTransactionsAsync(WalletId);
        queue = MultisigWalletService.SortPending(all.Where(p => p.Status != PendingTxStatus.Broadcast), config);
    }

    // ─── Sign together online (specs/017-multisig-online-signing) ───

    private enum OnlineState { Checking, Available, Unavailable }

    private string? onlineFor;
    private OnlineState onlineState = OnlineState.Checking;
    private List<int> lifetimes = [30];
    private int lifetime = 30;
    private string roomName = "";
    private bool isOpening;
    private bool roomEventsWired;

    private async Task ConfirmSign(PendingMultisigTransaction tx)
    {
        signConfirmFor = null;
        await SignTransaction(tx);
    }

    private async Task ToggleOnline(PendingMultisigTransaction tx)
    {
        if (Room.Current?.UnsignedTxId == tx.UnsignedTxId)
        {
            Nav.NavigateTo("/multisig/sign-room");
            return;
        }
        onlineFor = onlineFor == tx.Id ? null : tx.Id;
        if (onlineFor is null || config is null || config.OwnKeyIndex < 0) return;

        // Only now is the signing service contacted; nothing else on this page depends on it (FR-021).
        onlineState = OnlineState.Checking;
        roomName = string.IsNullOrWhiteSpace(roomName) ? ActiveWallet.WalletName : roomName;
        StateHasChanged();
        if (!await Room.CheckAvailabilityAsync())
        {
            onlineState = OnlineState.Unavailable;
            return;
        }
        try
        {
            var options = await Room.GetOptionsAsync();
            lifetimes = options.AllowedLifetimesMinutes.Count > 0 ? options.AllowedLifetimesMinutes : [options.DefaultLifetimeMinutes];
            lifetime = options.DefaultLifetimeMinutes;
            onlineState = OnlineState.Available;
        }
        catch
        {
            onlineState = OnlineState.Unavailable;
        }
    }

    private async Task OpenRoomAsync(PendingMultisigTransaction tx)
    {
        if (isOpening || config is null) return;   // a double tap opens one room (FR-026)
        isOpening = true;
        error = null;
        WireRoomEvents();
        try
        {
            var network = MultisigService.ActiveNetwork == DigiByte.Crypto.Networks.DigiByteNetwork.Testnet ? "test"
                : MultisigService.ActiveNetwork == DigiByte.Crypto.Networks.DigiByteNetwork.Regtest ? "regtest" : "main";
            await Room.OpenAsync(network, config.CoSigners.Select(c => c.PublicKeyHex).ToList(), config.RequiredSignatures,
                tx.PsbtBase64, tx.Memo, lifetime, roomName.Trim(), tx.UnsignedTxId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isOpening = false;
        }
    }

    private void WireRoomEvents()
    {
        if (roomEventsWired) return;
        roomEventsWired = true;
        Room.RoomStateReceived += OnRoomOpenedAsync;
        Room.ExistingRoomReceived += OnExistingRoomAsync;
        Room.ErrorReceived += OnRoomErrorAsync;
    }

    private Task OnRoomOpenedAsync(SigningRoomView _) => InvokeAsync(() =>
    {
        if (!isOpening) return;
        isOpening = false;
        Nav.NavigateTo("/multisig/sign-room");
    });

    // FR-019a: a room for this payment already exists; join it instead of opening a second one.
    private Task OnExistingRoomAsync(string code) => InvokeAsync(() =>
    {
        isOpening = false;
        Nav.NavigateTo($"/multisig/sign-room?code={Uri.EscapeDataString(code)}");
    });

    private Task OnRoomErrorAsync(string code, string message) => InvokeAsync(() =>
    {
        if (!isOpening) return;
        isOpening = false;
        error = message;
        StateHasChanged();
    });

    public void Dispose()
    {
        if (!roomEventsWired) return;
        Room.RoomStateReceived -= OnRoomOpenedAsync;
        Room.ExistingRoomReceived -= OnExistingRoomAsync;
        Room.ErrorReceived -= OnRoomErrorAsync;
    }

    private void ToggleShare(PendingMultisigTransaction tx) => shareFor = shareFor == tx.Id ? null : tx.Id;

    private void ToggleImport(PendingMultisigTransaction tx)
    {
        importFor = importFor == tx.Id ? null : tx.Id;
        importPsbtBase64 = "";
        importNotice = null;
    }

    private async Task SignTransaction(PendingMultisigTransaction tx)
    {
        if (isSigning) return;
        isSigning = true;
        busyId = tx.Id;
        error = null;
        message = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var privateKey = WalletService.GetPrivateKeyForMultisig();
            if (privateKey == null)
                throw new InvalidOperationException("Wallet is locked or private key unavailable.");

            var key = new NBitcoin.Key(Convert.FromHexString(privateKey));
            await MultisigService.SignPendingTransactionAsync(tx, key);
            await Reload();
            message = "Transaction signed. Share it with your co-signers.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSigning = false;
            busyId = null;
        }
    }

    private async Task CopyPsbt(PendingMultisigTransaction tx)
    {
        await Clipboard.CopyAsync(tx.PsbtBase64, toast: false);
        message = "Proposal copied. Share it with your co-signers.";
        error = null;
    }

    private async Task DownloadPsbt(PendingMultisigTransaction tx)
    {
        await JS.InvokeVoidAsync("downloadTextFile", tx.PsbtBase64, $"multisig-proposal-{tx.Id[..8]}.psbt.txt");
        message = "Proposal saved as a file.";
        error = null;
    }

    private async Task PasteImport()
    {
        string? text = null;
        try { text = await Clipboard.ReadAsync(); } catch { /* blocked */ }
        if (string.IsNullOrWhiteSpace(text))
        {
            importNotice = "Nothing to paste, or the browser blocked clipboard access.";
            return;
        }
        AcceptImportText(text);
    }

    private void OnScannedImport(string data)
    {
        showScanner = false;
        AcceptImportText(data);
        StateHasChanged();
    }

    private async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 512 * 1024);
            using var reader = new StreamReader(stream);
            AcceptImportText(await reader.ReadToEndAsync());
        }
        catch
        {
            importNotice = "That file couldn't be read. Use a small text file containing the PSBT.";
        }
    }

    private void AcceptImportText(string text)
    {
        var result = MultisigSendHelper.ClassifyScan(text);
        if (result.Kind == ScanKind.Psbt)
        {
            importPsbtBase64 = text.Trim();
            importNotice = null;
        }
        else
        {
            importNotice = result.Kind is ScanKind.Address or ScanKind.PaymentUri
                ? "That is an address, not a signed transaction (PSBT). Co-signers send you a PSBT to import here."
                : "That doesn't look like a signed transaction (PSBT).";
        }
    }

    private async Task ImportSignedPSBT(PendingMultisigTransaction tx)
    {
        error = null;
        message = null;
        try
        {
            await MultisigService.ImportSignedPSBTAsync(tx, importPsbtBase64.Trim());
            await Reload();
            importFor = null;
            importPsbtBase64 = "";
            importNotice = null;
            message = tx.HasEnoughSignatures ? "Signatures merged. It has enough signatures and is ready to broadcast." : "Signatures merged.";
        }
        catch (PsbtImportException ex)
        {
            importNotice = ex.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task BroadcastTransaction(PendingMultisigTransaction tx)
    {
        if (isBroadcasting) return;   // a double tap broadcasts once
        isBroadcasting = true;
        busyId = tx.Id;
        error = null;
        message = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var txId = await MultisigService.FinalizeAndBroadcastAsync(tx);
            await Reload();
            message = $"Transaction broadcast! TxID: {txId}";
        }
        catch (Exception ex)
        {
            await Reload();
            error = ex.Message;
        }
        finally
        {
            isBroadcasting = false;
            busyId = null;
        }
    }

    private async Task RetryBroadcast(PendingMultisigTransaction tx)
    {
        if (isBroadcasting) return;
        isBroadcasting = true;
        busyId = tx.Id;
        error = null;
        message = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var txId = await MultisigService.RetryBroadcastAsync(tx);
            await Reload();
            message = $"Transaction broadcast! TxID: {txId}";
        }
        catch (Exception ex)
        {
            await Reload();
            error = ex.Message;
        }
        finally
        {
            isBroadcasting = false;
            busyId = null;
        }
    }

    private async Task RemoveCancelled(string? id)
    {
        error = null;
        try
        {
            var n = await MultisigService.RemoveCancelledAsync(WalletId, id);
            await Reload();
            message = n == 1 ? "Removed from this device's list." : $"Removed {n} cancelled proposals from this device's list.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task CancelProposal(PendingMultisigTransaction tx)
    {
        error = null;
        try
        {
            await MultisigService.CancelPendingAsync(tx);
            cancelFor = null;
            await Reload();
            message = "Proposal cancelled on this device.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
