@page "/multisig/{WalletId}/pending"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject ClipboardService Clipboard
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject IJSRuntime JS
@inject SigningRoomClient Room
@inject ProposalHandoff Handoff
@inject MultisigAttentionState Attention

@*
    The Pending list (specs/026-multisig-wallet-experience, FR-018 to FR-025): what needs you first, then what waits on
    others, then cancelled. Each payment is a compact card with one button. Nothing is signed, broadcast, retried or
    cancelled from here: a card opens the payment's own screen (MultisigPendingDetail), where all of that lives with
    the full payment in view. This page keeps what belongs to the list: bringing a co-signer's proposal in, and
    clearing cancelled ones.
*@

<PageTitle>Pending — DigiByte Wallet</PageTitle>

<AuthGuard>
<div class="flex flex-col gap-4">
    <PageHeader Title="Pending" Subtitle="@Summary" BackLabel="@(config?.DisplayName ?? "Multisig")" BackHref="@($"/multisig/{WalletId}")">
        @if (config is not null && OpenCount > 0)
        {
            <button type="button" class="btn-secondary btn-sm shrink-0" aria-haspopup="dialog" data-testid="add-proposal" @onclick="() => addOpen = true">
                <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Add a proposal
            </button>
        }
    </PageHeader>
    @if (config is not null)
    {
        <div class="-mt-2"><SharedWalletContextLine Config="config" /></div>
    }

    @if (isLoading)
    {
        <div class="flex flex-col gap-3">
            @for (int i = 0; i < 2; i++)
            {
                <div class="card p-4">
                    <div class="h-5 w-48 skeleton rounded"></div>
                    <div class="h-4 w-32 skeleton rounded mt-2"></div>
                </div>
            }
        </div>
    }
    else if (config == null)
    {
        <MultisigAccessNotice State="access" />
    }
    else
    {
        @* You cancelled this proposal here: nothing is re-added unless you confirm (spec 022, FR-010) *@
        @if (cancelledPrompt is not null)
        {
            <div class="p-3 bg-white dark:bg-dgb-900 border border-amber-300 dark:border-amber-700/50 rounded-xl flex flex-col gap-2" role="alertdialog" aria-label="Restore cancelled proposal">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">You cancelled this proposal.</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@MultisigFormat.Dgb(cancelledPrompt.AmountSatoshis) DGB to @MultisigFormat.Short(cancelledPrompt.DestinationAddress). Restoring puts it back in your list so it can be signed again.</p>
                <div class="flex gap-2">
                    <button type="button" class="btn-primary btn-sm" @onclick="RestoreCancelledProposal">Restore this proposal</button>
                    <button type="button" class="btn-ghost btn-sm" @onclick="() => cancelledPrompt = null">Leave it cancelled</button>
                </div>
            </div>
        }

        @* The proposal belongs to another multisig of yours: offer to open it there (spec 022, FR-006) *@
        @if (otherWallet is not null)
        {
            <div class="p-3 bg-white dark:bg-dgb-900 border border-dgb-300 dark:border-dgb-700 rounded-xl flex flex-col gap-2" role="alertdialog" aria-label="Proposal is for another multisig">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">This proposal is for <span class="break-words">@otherWallet.Name</span>.</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">It is not added here. Open that multisig to add it there.</p>
                <div class="flex gap-2">
                    <button type="button" class="btn-primary btn-sm" @onclick="OpenOtherWallet">Open @otherWallet.Name</button>
                    <button type="button" class="btn-ghost btn-sm" @onclick="() => otherWallet = null">Not now</button>
                </div>
            </div>
        }

        @if (OpenCount == 0)
        {
            @* Nothing waiting (cancelled ones, if any, are folded below): one sentence and the two ways to change that (FR-022) *@
            <div class="card p-6 text-center flex flex-col items-center gap-3" data-testid="pending-empty">
                <p class="text-sm text-slate-600 dark:text-slate-400">Nothing is waiting. Payments that need signatures show up here.</p>
                <div class="flex flex-wrap justify-center gap-2">
                    <button type="button" class="btn-primary btn-sm" @onclick='() => Nav.NavigateTo($"/multisig/{WalletId}/send")'>Create a payment</button>
                    <button type="button" class="btn-secondary btn-sm" aria-haspopup="dialog" data-testid="add-proposal" @onclick="() => addOpen = true">Add a proposal</button>
                </div>
            </div>
        }

        @if (groups.Count > 0)
        {
            @if (groups.NeedsYou.Count > 0)
            {
                <section class="flex flex-col gap-3" aria-labelledby="group-needs-you">
                    <h3 id="group-needs-you" class="section-label">Needs you <span class="text-slate-400 dark:text-slate-500">· @groups.NeedsYou.Count</span></h3>
                    @foreach (var tx in groups.NeedsYou)
                    {
                        @Card(tx)
                    }
                </section>
            }

            @if (groups.WaitingForOthers.Count > 0)
            {
                <section class="flex flex-col gap-3" aria-labelledby="group-waiting">
                    <h3 id="group-waiting" class="section-label">Waiting for others <span class="text-slate-400 dark:text-slate-500">· @groups.WaitingForOthers.Count</span></h3>
                    @foreach (var tx in groups.WaitingForOthers)
                    {
                        @Card(tx)
                    }
                </section>
            }

            @if (groups.CantGoThrough.Count > 0)
            {
                @* Their coins were already spent: nothing to sign or wait for, only to cancel. Not counted as needing you. *@
                <section class="flex flex-col gap-3" aria-labelledby="group-cant">
                    <h3 id="group-cant" class="section-label">Can't go through <span class="text-slate-400 dark:text-slate-500">· @groups.CantGoThrough.Count</span></h3>
                    @foreach (var tx in groups.CantGoThrough)
                    {
                        @Card(tx)
                    }
                </section>
            }

            @if (groups.Cancelled.Count > 0)
            {
                @* Folded by default: finished business stays out of the way *@
                <section class="flex flex-col gap-3" aria-labelledby="group-cancelled">
                    <button type="button" class="detail-row" aria-expanded="@(cancelledOpen ? "true" : "false")" aria-controls="cancelled-list" @onclick="() => cancelledOpen = !cancelledOpen">
                        <h3 id="group-cancelled" class="section-label flex-1">Cancelled <span class="text-slate-400 dark:text-slate-500">· @groups.Cancelled.Count</span></h3>
                        <svg class="detail-row-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                    </button>
                    @if (cancelledOpen)
                    {
                        <div id="cancelled-list" class="flex flex-col gap-3">
                            @foreach (var tx in groups.Cancelled)
                            {
                                @Card(tx)
                            }

                            @if (!confirmClearCancelled)
                            {
                                <button type="button" class="self-end min-h-[44px] px-3 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-red-500" @onclick="() => confirmClearCancelled = true">
                                    @(groups.Cancelled.Count == 1 ? "Remove it from this device" : "Clear all cancelled")
                                </button>
                            }
                            else
                            {
                                <div class="p-3 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30 rounded-xl" role="alertdialog" aria-label="Confirm clear cancelled">
                                    <p class="text-sm font-bold text-red-700 dark:text-red-300">@(groups.Cancelled.Count == 1 ? "Remove this cancelled proposal?" : $"Remove {groups.Cancelled.Count} cancelled proposals?")</p>
                                    <p class="text-xs text-red-700 dark:text-red-400 leading-relaxed mt-1">@(groups.Cancelled.Count == 1 ? "It is" : "They are") deleted from this device, including Activity. This can't be undone.</p>
                                    <div class="flex gap-2 mt-2">
                                        <button type="button" class="btn-danger btn-sm" @onclick="ClearCancelled">Remove @(groups.Cancelled.Count == 1 ? "it" : groups.Cancelled.Count.ToString())</button>
                                        <button type="button" class="btn-ghost btn-sm" @onclick="() => confirmClearCancelled = false">Keep @(groups.Cancelled.Count == 1 ? "it" : "them")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }

        <AddProposalSheet IsOpen="addOpen" CanJoinRoom="@(config.OwnKeyIndex >= 0)"
                          OnScan="() => showScanner = true" OnPaste="PasteProposal" OnFile="OnProposalFileChosen"
                          OnJoinRoom='() => Nav.NavigateTo("/multisig/sign-room")' OnClosed="() => addOpen = false" />
    }
</div>

<QrScannerModal IsOpen="@showScanner" OnScanned="OnScannedProposal" OnClosed="@(() => showScanner = false)" />
</AuthGuard>

@code {
    [Parameter] public string WalletId { get; set; } = "";

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private PendingGroups groups = PendingGroups.Empty;
    private List<PendingMultisigTransaction> all = [];
    private bool isLoading = true;
    private bool addOpen;
    private bool cancelledOpen;
    private bool confirmClearCancelled;
    private bool showScanner;
    private string? loadedFor;

    // Receiving a co-signer's proposal (specs/022-multisig-proposal-scan-import)
    private string? highlightId;
    private string? scrollToId;
    private PendingMultisigTransaction? cancelledPrompt;
    private string cancelledPsbt = "";
    private ProposalWalletMatch? otherWallet;
    private string otherWalletPsbt = "";
    private HashSet<string> spentIds = [];
    private int highlightVersion;
    private string? LocalKey => config?.CoSigners.FirstOrDefault(c => c.IsLocal)?.PublicKeyHex;

    // Where the list was scrolled to when a payment was opened, per shared wallet, so Back lands in the same place
    // (Story 2, scenario 5). In memory only, and used once.
    private static readonly Dictionary<string, double> SavedScroll = [];
    private bool restoreScroll;

    // Payments still in play: everything except the cancelled ones.
    private int OpenCount => groups.NeedsYou.Count + groups.WaitingForOthers.Count + groups.CantGoThrough.Count;

    private string? Summary
    {
        get
        {
            if (isLoading || config is null || groups.Count == 0) return null;
            var parts = new List<string>();
            if (groups.NeedsYou.Count > 0) parts.Add(groups.NeedsYou.Count == 1 ? "1 needs you" : $"{groups.NeedsYou.Count} need you");
            if (groups.WaitingForOthers.Count > 0) parts.Add($"{groups.WaitingForOthers.Count} waiting for others");
            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }

    private RenderFragment Card(PendingMultisigTransaction tx) => __builder =>
    {
        var liveRoom = !string.IsNullOrEmpty(tx.UnsignedTxId) && Room.Current?.UnsignedTxId == tx.UnsignedTxId;
        var state = PendingStateClassifier.Classify(tx, LocalKey, liveRoom);
        var open = tx.Status is PendingTxStatus.AwaitingSignatures or PendingTxStatus.ReadyToFinalize;
        var spent = open && spentIds.Contains(tx.Id);
        var button = PendingCardActions.For(state, spent, config!.OwnKeyIndex < 0);
        <PendingCard @key="tx.Id" Pending="tx" Config="config" State="state" Button="button" CoinsSpent="spent"
                     Highlighted="@(highlightId == tx.Id)" OnOpen="OpenPayment" OnAction="p => OnCardAction(p, button.Action)" />
    };

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == WalletId)
        {
            // Already showing this multisig: the app-wide Scan may have just handed over a proposal for it.
            if (config is not null && Handoff.Take(WalletId) is { } scanned) await ReceiveProposalText(scanned);
            return;
        }
        loadedFor = WalletId;
        isLoading = true;
        config = null;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;
            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
            await Reload();
        }
        finally
        {
            isLoading = false;
        }

        if (config is null) return;
        restoreScroll = SavedScroll.ContainsKey(WalletId);

        // A proposal the user chose to open in this multisig from another one's page (spec 022, FR-006), or one the
        // menu's Scan read while another page was open.
        if (Handoff.Take(WalletId) is { } handedOver)
            await ReceiveProposalText(handedOver);
    }

    private async Task Reload()
    {
        if (config is null) return;
        all = await MultisigService.GetPendingTransactionsAsync(WalletId);
        // What is already known about spent coins is used at once; the check below then brings it up to date.
        Regroup();
        if (groups.Cancelled.Count == 0)
        {
            cancelledOpen = false;
            confirmClearCancelled = false;
        }
        _ = RefreshSpentAsync();
    }

    private void Regroup() =>
        groups = PendingGrouping.Group(all, LocalKey, id => spentIds.Contains(id) || Attention.IsSpent(id));

    /// <summary>Marks open proposals whose coins are already spent (spec 022, FR-007). Marks nothing when chain data is unavailable.</summary>
    private async Task RefreshSpentAsync()
    {
        var current = config;
        if (current is null) return;

        var inputsByProposal = new Dictionary<string, List<NBitcoin.OutPoint>>();
        foreach (var tx in all.Where(q => q.Status is PendingTxStatus.AwaitingSignatures or PendingTxStatus.ReadyToFinalize))
        {
            var facts = MultisigProposalReader.Read(tx.PsbtBase64, current, MultisigService.ActiveNetwork);
            if (facts.Problems.Count == 0)
                inputsByProposal[tx.Id] = facts.Inputs.Select(i => i.OutPoint).ToList();
        }

        var spent = inputsByProposal.Count == 0
            ? new HashSet<string>()
            : await MultisigService.GetSpentInputIdsAsync(current, inputsByProposal.Values.SelectMany(v => v).Distinct());

        var marked = inputsByProposal
            .Where(kv => kv.Value.Any(o => spent.Contains($"{o.Hash}:{o.N}")))
            .Select(kv => kv.Key)
            .ToHashSet();
        // The counts on the menu and on Home stop including payments that cannot go through.
        Attention.ReportSpent(inputsByProposal.Keys, marked);
        if (marked.SetEquals(spentIds)) return;

        spentIds = marked;
        Regroup();
        await InvokeAsync(StateHasChanged);
    }

    // ─── Opening a payment ───

    private async Task OpenPayment(PendingMultisigTransaction tx)
    {
        try { SavedScroll[WalletId] = await JS.InvokeAsync<double>("domHelpers.getMainScroll"); }
        catch { /* returning to the top is the fallback */ }
        Nav.NavigateTo($"/multisig/{WalletId}/pending/{Uri.EscapeDataString(tx.Id)}");
    }

    // Every button opens the payment's own screen, except the room button, which opens the room (FR-019a).
    private Task OnCardAction(PendingMultisigTransaction tx, PendingCardAction action)
    {
        if (action == PendingCardAction.OpenRoom)
        {
            Nav.NavigateTo("/multisig/sign-room");
            return Task.CompletedTask;
        }
        return OpenPayment(tx);
    }

    // ─── Receive a co-signer's proposal (specs/022-multisig-proposal-scan-import) ───

    private async Task OnScannedProposal(string data)
    {
        showScanner = false;
        await ReceiveProposalText(data);
        StateHasChanged();
    }

    private async Task PasteProposal()
    {
        string? text = null;
        try { text = await Clipboard.ReadAsync(); } catch { /* blocked */ }
        if (string.IsNullOrWhiteSpace(text))
        {
            Notifications.Warning("Nothing to paste, or the browser blocked clipboard access.");
            return;
        }
        await ReceiveProposalText(text);
    }

    private async Task OnProposalFileChosen(InputFileChangeEventArgs e)
    {
        string text;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 512 * 1024);
            using var reader = new StreamReader(stream);
            text = await reader.ReadToEndAsync();
        }
        catch
        {
            Notifications.Warning("That file couldn't be read. Use a small text file containing the proposal (PSBT).");
            return;
        }
        await ReceiveProposalText(text);
    }

    /// <summary>One path for scan, paste and file, so all three behave the same (spec 022, FR-002).</summary>
    private async Task ReceiveProposalText(string text)
    {
        if (config is null) return;
        cancelledPrompt = null;
        otherWallet = null;

        var kind = MultisigSendHelper.ClassifyScan(text).Kind;
        if (kind != ScanKind.Psbt)
        {
            Notifications.Warning(kind is ScanKind.Address or ScanKind.PaymentUri
                ? "That is an address, not a proposal. A co-signer shares a proposal (PSBT) for you to add here."
                : "That doesn't look like a proposal (PSBT).");
            return;
        }

        var psbt = text.Trim();
        try
        {
            var result = await MultisigService.ReceiveProposalAsync(config, psbt);
            await Reload();
            switch (result.Outcome)
            {
                case ProposalReceiveOutcome.Added:
                    Notifications.Success("Proposal added.");
                    Highlight(result.Pending.Id);
                    break;
                case ProposalReceiveOutcome.Merged:
                    Notifications.Success(result.NewSignatures == 1 ? "1 new signature added." : $"{result.NewSignatures} new signatures added.");
                    Highlight(result.Pending.Id);
                    break;
                case ProposalReceiveOutcome.AlreadyUpToDate:
                    Notifications.Info("Already up to date.");
                    Highlight(result.Pending.Id);
                    break;
                case ProposalReceiveOutcome.Cancelled:
                    cancelledPrompt = result.Pending;
                    cancelledPsbt = psbt;
                    break;
                case ProposalReceiveOutcome.Closed:
                    Notifications.Info("This payment was already sent. It is in Activity.");
                    break;
            }
            if (result.RejectedSigners.Count > 0)
                Notifications.Warning("A signature on that copy didn't check out and was ignored.");
        }
        catch (PsbtImportException ex)
        {
            // A proposal that spends another of this owner's multisigs is offered there instead (spec 022, FR-006).
            var match = await MultisigService.FindWalletForProposalAsync(psbt, ActiveWallet.WalletId, ActiveWallet.PublicKey, WalletId);
            if (match is not null)
            {
                otherWallet = match;
                otherWalletPsbt = psbt;
            }
            else
            {
                Notifications.Warning(ex.Message.Contains("not this multisig", StringComparison.OrdinalIgnoreCase)
                    ? ex.Message + " It may be for a multisig that isn't on this device."
                    : ex.Message);
            }
        }
        catch (Exception ex)
        {
            Notifications.Sticky(ex.Message, ToastType.Error);
        }
    }

    private async Task RestoreCancelledProposal()
    {
        if (cancelledPrompt is null) return;
        try
        {
            var restored = await MultisigService.RestoreCancelledAsync(cancelledPrompt, cancelledPsbt);
            cancelledPrompt = null;
            cancelledPsbt = "";
            await Reload();
            Notifications.Success("Proposal restored.");
            Highlight(restored.Id);
        }
        catch (PsbtImportException ex)
        {
            Notifications.Warning(ex.Message);
            cancelledPrompt = null;
        }
        catch (Exception ex)
        {
            Notifications.Sticky(ex.Message, ToastType.Error);
        }
    }

    private void OpenOtherWallet()
    {
        if (otherWallet is null) return;
        Handoff.Set(otherWallet.WalletId, otherWalletPsbt);
        var target = otherWallet.WalletId;
        otherWallet = null;
        otherWalletPsbt = "";
        Nav.NavigateTo($"/multisig/{target}/pending");
    }

    /// <summary>Scrolls to the card and rings it for a few seconds (spec 022, research R8).</summary>
    private void Highlight(string id)
    {
        // A card in the folded group must be visible to be found.
        if (groups.Cancelled.Any(p => p.Id == id)) cancelledOpen = true;
        highlightId = id;
        scrollToId = id;
        var version = ++highlightVersion;
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            if (version != highlightVersion) return;
            await InvokeAsync(() =>
            {
                highlightId = null;
                StateHasChanged();
            });
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToId is not null)
        {
            var id = scrollToId;
            scrollToId = null;
            restoreScroll = false;      // a just-added payment wins over the remembered place
            SavedScroll.Remove(WalletId);
            try { await JS.InvokeVoidAsync("domHelpers.scrollToElement", $"proposal-{id}"); }
            catch { /* scrolling is a nicety */ }
            return;
        }

        if (restoreScroll && !isLoading)
        {
            restoreScroll = false;
            if (SavedScroll.Remove(WalletId, out var top) && top > 0)
            {
                try { await JS.InvokeVoidAsync("domHelpers.setMainScroll", top); }
                catch { /* the top of the list is a fine place to land */ }
            }
        }
    }

    // ─── Clearing cancelled proposals (spec 020) ───

    private async Task ClearCancelled()
    {
        confirmClearCancelled = false;
        try
        {
            var n = await MultisigService.RemoveCancelledAsync(WalletId);
            await Reload();
            Notifications.Success(n == 1 ? "Removed from this device's list." : $"Removed {n} cancelled proposals from this device's list.");
        }
        catch (Exception ex)
        {
            Notifications.Sticky(ex.Message, ToastType.Error);
        }
    }
}
