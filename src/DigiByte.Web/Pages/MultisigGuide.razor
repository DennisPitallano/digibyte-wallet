@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private HashSet<string> openGuides = [];

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private void ToggleGuide(string id)
    {
        if (!openGuides.Remove(id))
            openGuides.Add(id);
    }

    // Names, product labels and standard identifiers that read the same in every language.
    private const string Multisig = "Multisig";
    private const string P2shP2wsh = "P2SH-P2WSH";
    private const string P2wsh = "P2WSH";
    private static readonly string[] DiagramNames = ["Alice", "Bob", "Charlie"];

    /// <summary>
    /// A translated sentence with its {n} values filled in. A plain string value is shown in bold; a MarkupString
    /// (from <see cref="Code"/> or <see cref="Person"/>) is inserted as is. The sentence and every value are HTML-encoded.
    /// </summary>
    private static MarkupString Rich(string template, params object[] parts) =>
        new(string.Format(System.Globalization.CultureInfo.InvariantCulture, Encode(template),
            parts.Select(p => (object)(p is MarkupString m ? m.Value : "<b>" + Encode(p?.ToString()) + "</b>")).ToArray()));

    private static MarkupString Code(string text, string cssClass = "text-[11px]") =>
        new($"<code class=\"{cssClass}\">{Encode(text)}</code>");

    private static MarkupString Person(string name) =>
        new($"<b class=\"text-indigo-600 dark:text-indigo-400\">{Encode(name)}</b>");

    private static string Encode(string? text) => System.Net.WebUtility.HtmlEncode(text ?? "");

    private (string Name, string Description)[] Standards =>
    [
        ("BIP67", L.T("ms.guide.tech.bip67")),
        ("BIP174", L.T("ms.guide.tech.bip174")),
        ("OP_CMS", L.T("ms.guide.tech.op_cms")),
    ];

    // Function and opcode names stay as they are in the code; only the words around them are translated.
    private string TechnicalFlow =>
        $"{L.T("ms.guide.tech.flow_create")}:\n" +
        "  MultisigService.CreateRedeemScript(M, pubKeys[])\n" +
        "  → BIP67 sort → OP_M [key1] [key2] ... [keyN] OP_N OP_CMS\n" +
        $"  → Hash → {L.T("ms.guide.tech.flow_address")}\n\n" +
        $"{L.T("ms.guide.tech.flow_spend")}:\n" +
        "  CreateMultisigPSBT(redeemScript, utxos, dest, amt)\n" +
        "  → PSBT with witnessUtxo + redeemScript hints\n" +
        $"  → SignPSBT(psbt, privKey, redeemScript)  ×M {L.T("ms.guide.tech.flow_signers")}\n" +
        "  → CombinePSBTs(original, signed1, signed2...)\n" +
        "  → FinalizePSBT(combined) → extract raw tx\n" +
        "  → BroadcastTransactionAsync(rawTx)";

