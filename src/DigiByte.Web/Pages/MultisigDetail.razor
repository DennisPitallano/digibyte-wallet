@page "/multisig/{WalletId}"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject ClipboardService Clipboard
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(config?.DisplayName ?? "Multisig") — DigiByte Wallet</PageTitle>

<AuthGuard>
@if (isLoading)
{
    <div class="flex flex-col gap-4">
        <div class="h-6 w-48 skeleton rounded"></div>
        <div class="h-32 skeleton rounded-2xl"></div>
        <div class="h-20 skeleton rounded-2xl"></div>
    </div>
}
else if (config == null)
{
    <MultisigAccessNotice State="access" />
}
else
{
    var myWatchOnly = !config.CoSigners.Any(c => c.IsLocal);
    <div class="flex flex-col gap-3">
        <MultisigHeader Title="@config.DisplayName" Required="config.RequiredSignatures" Total="config.TotalSigners"
                        IsWatchOnly="myWatchOnly" OnRename="() => renameOpen = true" OnBack="@(() => Nav.NavigateTo("/multisig"))" />

        @* Balance + address *@
        <div class="slide-up-delay-1 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200/80 dark:border-dgb-800 p-4">
            <p class="text-xs text-slate-500 dark:text-slate-400">Balance</p>
            @if (isLoadingBalance)
            {
                <div class="h-8 w-40 skeleton rounded-lg mt-1" aria-label="Loading balance"></div>
            }
            else if (balanceSatoshis is null)
            {
                <div class="flex items-center gap-2 mt-1">
                    <p class="text-lg font-bold text-slate-400">Balance unavailable</p>
                    <button type="button" class="min-h-[44px] px-2 text-xs font-semibold text-dgb-500" @onclick="LoadBalance">Retry</button>
                </div>
                <p class="text-[11px] text-amber-600 dark:text-amber-400" role="status">Couldn't reach the network. Your funds are not affected.</p>
            }
            else
            {
                <p class="text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">@MultisigFormat.Dgb(balanceSatoshis.Value) <span class="text-base font-bold text-slate-400">DGB</span></p>
            }

            <div class="flex items-center gap-2 mt-3 pt-3 border-t border-slate-100 dark:border-dgb-800">
                <p class="flex-1 min-w-0 text-[11px] font-mono text-slate-600 dark:text-slate-300 truncate" title="@config.Address">@MultisigFormat.Short(config.Address, 14, 8)</p>
                <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-dgb-600 dark:text-dgb-400" aria-label="Copy address" @onclick="CopyAddress">@(copied ? "Copied!" : "Copy")</button>
                <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-slate-600 dark:text-slate-300" aria-label="Show address QR code" @onclick="() => receiveOpen = true">QR</button>
            </div>
        </div>

        @* Primary actions *@
        <div class="grid grid-cols-3 gap-2 slide-up-delay-1">
            <button type="button" class="min-h-[56px] flex flex-col items-center justify-center gap-0.5 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-2xl press-effect"
                    @onclick="CreateTransaction">
                <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" /></svg>
                <span class="text-xs">Send</span>
            </button>
            <button type="button" class="min-h-[56px] flex flex-col items-center justify-center gap-0.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-900 dark:text-white font-semibold rounded-2xl press-effect"
                    @onclick="() => receiveOpen = true">
                <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 4.5 15 15m0 0V8.25m0 11.25H8.25" /></svg>
                <span class="text-xs">Receive</span>
            </button>
            <button type="button" class="relative min-h-[56px] flex flex-col items-center justify-center gap-0.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-900 dark:text-white font-semibold rounded-2xl press-effect"
                    @onclick="ViewPendingTxs">
                <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                <span class="text-xs">Pending</span>
                @if (pendingCount > 0)
                {
                    <span class="absolute top-1.5 right-2 min-w-[18px] text-center text-[10px] bg-amber-500 text-white px-1 py-0.5 rounded-full" aria-label="@pendingCount pending">@pendingCount</span>
                }
            </button>
        </div>

        @if (needsMySignature > 0)
        {
            <button type="button" class="w-full min-h-[44px] flex items-center justify-between gap-2 p-3 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30 rounded-2xl text-left press-effect"
                    @onclick="ViewPendingTxs">
                <span class="text-sm font-semibold text-amber-800 dark:text-amber-300">@(needsMySignature == 1 ? "1 payment needs your signature" : $"{needsMySignature} payments need your signature")</span>
                <span class="text-xs font-bold text-amber-700 dark:text-amber-400">Review →</span>
            </button>
        }

        @* Backup *@
        <BackupCard Config="config" />

        @* Co-signers *@
        <div class="rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200/80 dark:border-dgb-800">
            <button type="button" class="w-full flex items-center justify-between gap-2 p-3 min-h-[44px] text-left" aria-expanded="@signersOpen" @onclick="() => signersOpen = !signersOpen">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Co-signers (@config.RequiredSignatures required of @config.TotalSigners)</span>
                <svg class="w-4 h-4 text-slate-400 transition-transform @(signersOpen ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </button>
            @if (signersOpen)
            {
                <div class="px-3 pb-3 flex flex-col gap-2">
                    @foreach (var signer in config.CoSigners)
                    {
                        <CoSignerRow Signer="signer" IsOwn="signer.IsLocal" OnRename="RenameCoSigner" />
                    }
                    <p class="text-[11px] text-slate-400">Tap a co-signer to see and verify their full public key.</p>
                </div>
            }
        </div>

        @* Recent activity *@
        <div class="rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200/80 dark:border-dgb-800">
            <div class="flex items-center justify-between gap-2 p-3">
                <button type="button" class="flex-1 min-h-[44px] text-left" aria-expanded="@activityOpen" @onclick="() => activityOpen = !activityOpen">
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Recent activity</span>
                </button>
                <button type="button" class="min-h-[44px] px-2 text-xs font-semibold text-dgb-500" @onclick="ViewActivity">View all</button>
            </div>
            @if (activityOpen)
            {
                <div class="px-3 pb-3">
                    <ActivityList Entries="recentActivity" ShowFilters="false" IsLoading="isLoadingActivity" IsPartial="activityPartial"
                                  EmptyTitle="No activity yet" EmptyHint="Receive funds or create a payment and it will show up here."
                                  OnSelect="OpenActivityEntry" />
                </div>
            }
        </div>

        @* Remove *@
        <div class="pt-1">
            @if (!confirmRemove)
            {
                <button type="button" class="min-h-[44px] text-xs font-medium text-slate-400 hover:text-red-500" @onclick="() => confirmRemove = true">Remove this multisig from this wallet</button>
            }
            else
            {
                <div class="p-3 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30 rounded-2xl" role="alertdialog" aria-label="Confirm removing multisig">
                    <p class="text-sm font-bold text-red-700 dark:text-red-300">Remove "@config.DisplayName"?</p>
                    <p class="text-xs text-red-700 dark:text-red-400 leading-relaxed mt-1">
                        Your seed phrase alone <b>cannot recover</b> a multisig. Without the redeem script you could lose access to its funds.
                        @(config.BackupAt is null ? "You haven't backed it up yet." : "You backed it up " + MultisigFormat.When(config.BackupAt.Value) + ".")
                        If another wallet on this device also owns it, it stays there.
                    </p>
                    <div class="flex items-center gap-2 mt-2 flex-wrap">
                        <button type="button" class="min-h-[44px] px-3 text-xs font-semibold text-dgb-600 dark:text-dgb-400 bg-white dark:bg-dgb-900 rounded-xl press-effect" @onclick="DownloadBackupFirst">Download backup</button>
                        <button type="button" class="min-h-[44px] px-3 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold rounded-xl press-effect disabled:opacity-50" disabled="@isRemoving" @onclick="RemoveWallet">Remove</button>
                        <button type="button" class="min-h-[44px] px-3 text-xs font-medium text-slate-500" @onclick="() => confirmRemove = false">Cancel</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <ReceiveSheet IsOpen="receiveOpen" Address="@config.Address" OnClosed="() => receiveOpen = false" />
    <RenameDialog IsOpen="renameOpen" Title="Rename multisig" Initial="@config.DisplayName" OnSave="RenameWallet" OnClosed="() => renameOpen = false" />
}
</AuthGuard>

@code {
    [Parameter] public string WalletId { get; set; } = "";

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private bool isLoading = true;
    private bool isLoadingBalance;
    private long? balanceSatoshis;
    private bool copied;
    private int pendingCount;
    private int needsMySignature;
    private bool signersOpen;
    private bool activityOpen = true;
    private bool receiveOpen;
    private bool renameOpen;
    private bool confirmRemove;
    private bool isRemoving;
    private bool isLoadingActivity;
    private bool activityPartial;
    private List<ActivityEntry> recentActivity = [];

    private string? loadedFor;

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == WalletId) return;
        loadedFor = WalletId;
        isLoading = true;
        config = null;
        balanceSatoshis = null;
        recentActivity = [];
        pendingCount = 0;
        needsMySignature = 0;
        confirmRemove = false;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;

            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
            if (config != null)
            {
                var pending = await MultisigService.GetPendingTransactionsAsync(WalletId);
                pendingCount = pending.Count(p => p.Status is PendingTxStatus.AwaitingSignatures or PendingTxStatus.ReadyToFinalize);
                needsMySignature = MultisigWalletService.CountNeedingMySignature(pending, config);
                _ = LoadBalance();
                _ = LoadActivity();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBalance()
    {
        isLoadingBalance = true;
        StateHasChanged();
        try
        {
            balanceSatoshis = await MultisigService.GetBalanceAsync(config!);
        }
        catch { balanceSatoshis = null; }   // unknown stays unknown: never shown as 0
        finally
        {
            isLoadingBalance = false;
            StateHasChanged();
        }
    }

    private async Task LoadActivity()
    {
        isLoadingActivity = true;
        StateHasChanged();
        try
        {
            var page = await MultisigService.GetActivityAsync(config!, 0, 25);
            recentActivity = page.Entries.Take(4).ToList();
            activityPartial = page.IsPartial;
        }
        catch { activityPartial = true; }
        finally
        {
            isLoadingActivity = false;
            StateHasChanged();
        }
    }

    private async Task CopyAddress()
    {
        await Clipboard.CopyAsync(config!.Address, toast: false);
        copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        copied = false;
    }

    private async Task<RenameResult> RenameWallet(string name)
    {
        var result = await MultisigService.RenameWalletAsync(WalletId, name);
        if (result.Ok) config!.Name = result.Name;
        return result;
    }

    private Task<RenameResult> RenameCoSigner(string publicKeyHex, string name) =>
        MultisigService.RenameCoSignerAsync(WalletId, publicKeyHex, name);

    private async Task DownloadBackupFirst()
    {
        var (filename, content) = MultisigWalletService.BuildBackup(config!);
        await JS.InvokeVoidAsync("downloadTextFile", content, filename);
        await MultisigService.MarkBackedUpAsync(WalletId);
        config!.BackupAt = DateTime.UtcNow;
    }

    private async Task RemoveWallet()
    {
        isRemoving = true;
        try
        {
            await MultisigService.DeleteWalletAsync(WalletId, ActiveWallet.WalletId);
            Nav.NavigateTo("/multisig");
        }
        finally { isRemoving = false; }
    }

    private void OpenActivityEntry(ActivityEntry entry) => Nav.NavigateTo($"/multisig/{WalletId}/activity");

    private void CreateTransaction() => Nav.NavigateTo($"/multisig/{WalletId}/send");
    private void ViewPendingTxs() => Nav.NavigateTo($"/multisig/{WalletId}/pending");
    private void ViewActivity() => Nav.NavigateTo($"/multisig/{WalletId}/activity");
}
