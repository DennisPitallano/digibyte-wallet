@page "/multisig/{WalletId}"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IBlockchainService Blockchain
@inject AppState AppState
@inject NotificationService Notifications
@inject ISecureStorage Storage

<PageTitle>@(config?.DisplayName ?? "Multisig") — DigiByte Wallet</PageTitle>

<AuthGuard>
@if (isLoading)
{
    <div class="flex flex-col gap-4">
        <div class="h-6 w-48 skeleton rounded"></div>
        <div class="h-32 skeleton rounded-2xl"></div>
        <div class="h-20 skeleton rounded-2xl"></div>
    </div>
}
else if (config == null)
{
    <MultisigAccessNotice State="access" />
}
else
{
    var myWatchOnly = !config.CoSigners.Any(c => c.IsLocal);
    <PullToRefresh OnRefresh="PullRefresh">
    <div class="flex flex-col gap-3">
        <PageHeader BackLabel="Multisig" BackHref="/multisig">
            <TitleContent>
                <button type="button" class="flex items-center gap-1.5 max-w-full min-h-[32px] text-left group" aria-label="Rename multisig" @onclick="() => renameOpen = true">
                    <h2 class="page-title truncate">@config.DisplayName</h2>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-dgb-500 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                    </svg>
                </button>
            </TitleContent>
            <ChildContent>
                <span class="text-[11px] font-bold text-dgb-600 dark:text-dgb-300 bg-dgb-50 dark:bg-dgb-900 border border-dgb-200 dark:border-dgb-700/50 px-2.5 py-1 rounded-full shrink-0">@config.RequiredSignatures-of-@config.TotalSigners</span>
            </ChildContent>
        </PageHeader>
        @* The title already has the name and scheme; this says whose shared wallet it is and opens the switcher. *@
        <div class="-mt-1"><SharedWalletContextLine Config="config" ShowName="false" /></div>

        @* Balance card, like the wallet dashboard's *@
        <div class="slide-up-delay-1">
            <MultisigBalanceCard Address="@config.Address" BalanceSatoshis="balanceSatoshis" IsLoading="isLoadingBalance" IsWatchOnly="myWatchOnly"
                                 DgbPrice="dgbPrice" OnRefresh="Refresh" OnShowQr="() => receiveOpen = true" />
        </div>

        @* Everyday actions, in the wallet dashboard's icon-tile style. Only the two that are this page's own:
           Scan, Pending and Activity are on the menu while a shared wallet is open (spec 026, FR-007). *@
        <div class="flex justify-center gap-5 mt-1 slide-up-delay-1">
            <button type="button" class="flex flex-col items-center gap-1 group" @onclick="CreateTransaction">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                    <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                    </svg>
                </div>
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Send</span>
            </button>
            <button type="button" class="flex flex-col items-center gap-1 group" @onclick="() => receiveOpen = true">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                    <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                    </svg>
                </div>
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Receive</span>
            </button>
        </div>

        @if (needsMySignature > 0)
        {
            <button type="button" class="w-full flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2.5 min-h-[44px] rounded-xl border border-amber-200 dark:border-amber-800/30 text-left press-effect" @onclick="ViewPendingTxs">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <span class="flex-1 text-xs text-amber-700 dark:text-amber-400 font-medium">@(needsMySignature == 1 ? "1 payment needs your signature" : $"{needsMySignature} payments need your signature")</span>
                <span class="text-xs font-bold text-amber-700 dark:text-amber-400">Review</span>
            </button>
        }

        @* Backup *@
        <BackupCard Config="config" />

        @* Co-signers *@
        <CollapsePanel Title="@($"Co-signers ({config.RequiredSignatures} required of {config.TotalSigners})")" @bind-IsOpen="signersOpen"
                       IconPath="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z">
            @foreach (var signer in config.CoSigners)
            {
                <CoSignerRow Signer="signer" IsOwn="signer.IsLocal" OnRename="RenameCoSigner" />
            }
            <p class="text-xs text-slate-400 dark:text-slate-500">Tap a co-signer to see and verify their full public key.</p>
        </CollapsePanel>

        @* Recent activity: same heading and rows as the wallet's Transactions list *@
        <div class="flex items-center justify-between mt-1">
            <h3 class="section-label">Recent activity</h3>
            <div class="flex items-center gap-2">
                @if (isLoadingActivity)
                {
                    <div class="w-2.5 h-2.5 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin" role="status" aria-label="Loading activity"></div>
                }
                <button type="button" class="min-h-[32px] text-[11px] text-dgb-500 font-medium" @onclick="ViewActivity">View all</button>
            </div>
        </div>
        <ActivityList Entries="recentActivity" ShowFilters="false" IsLoading="isLoadingActivity" IsPartial="activityPartial"
                      EmptyTitle="No activity yet" EmptyHint="Receive funds or create a payment and it will show up here."
                      OnSelect="OpenActivityEntry" />

        @* Remove *@
        <div class="pt-1">
            @if (!confirmRemove)
            {
                <button type="button" class="min-h-[44px] text-xs font-medium text-slate-400 hover:text-red-500" @onclick="() => confirmRemove = true">Remove this multisig from this wallet</button>
            }
            else
            {
                <div class="flex flex-col gap-2 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30 px-3 py-3 rounded-xl" role="alertdialog" aria-label="Confirm removing multisig">
                    <p class="text-sm font-bold text-red-700 dark:text-red-300">Remove "@config.DisplayName"?</p>
                    <p class="text-xs text-red-700 dark:text-red-400 font-medium leading-relaxed">
                        Your seed phrase alone <b>cannot recover</b> a multisig. Without the redeem script you could lose access to its funds.
                        @(config.BackupAt is null ? "You haven't backed it up yet." : "You backed it up " + MultisigFormat.When(config.BackupAt.Value) + ".")
                        If another wallet on this device also owns it, it stays there.
                    </p>
                    <div class="flex gap-2">
                        <button type="button" class="btn-secondary btn-sm flex-1" @onclick="DownloadBackupFirst">Download backup</button>
                        <button type="button" class="btn-danger btn-sm flex-1" disabled="@isRemoving" @onclick="RemoveWallet">Remove</button>
                        <button type="button" class="min-h-[44px] px-3 text-sm font-medium text-slate-500" @onclick="() => confirmRemove = false">Cancel</button>
                    </div>
                </div>
            }
        </div>
    </div>
    </PullToRefresh>

    <ReceiveSheet IsOpen="receiveOpen" Address="@config.Address" Name="@config.DisplayName" OnClosed="() => receiveOpen = false" />
    <RenameDialog IsOpen="renameOpen" Title="Rename multisig" Initial="@config.DisplayName" OnSave="RenameWallet" OnClosed="() => renameOpen = false" />
}
</AuthGuard>

@code {
    [Parameter] public string WalletId { get; set; } = "";

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private bool isLoading = true;
    private bool isLoadingBalance;
    private long? balanceSatoshis;
    private decimal dgbPrice;
    private int needsMySignature;
    private bool signersOpen;
    private bool receiveOpen;
    private bool renameOpen;
    private bool confirmRemove;
    private bool isRemoving;
    private bool isLoadingActivity;
    private bool isRefreshing;      // a refresh (first load, pull or button) is running; others are ignored
    private int loadGeneration;
    private bool activityPartial;
    private List<ActivityEntry> recentActivity = [];

    private string? loadedFor;

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == WalletId) return;
        loadedFor = WalletId;
        isLoading = true;
        config = null;
        balanceSatoshis = null;
        dgbPrice = 0;
        recentActivity = [];
        needsMySignature = 0;
        confirmRemove = false;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;

            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
            if (config != null)
            {
                // The home shortcut comes back here next time (spec 026, FR-009). Only this shared wallet's id is
                // saved, per personal wallet, on this device. Failing to save it changes nothing else.
                if (!string.IsNullOrEmpty(owner))
                {
                    try { await Storage.SetAsync(SharedWalletShortcut.StorageKey(owner), WalletId); } catch { }
                }

                var pending = await MultisigService.GetPendingTransactionsAsync(WalletId);
                needsMySignature = MultisigWalletService.CountNeedingMySignature(pending, config);
                _ = LoadPrice();
                _ = FirstLoadAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    // The first balance/activity load. Pulls and button taps are ignored until it finishes, so they never overlap it.
    private async Task FirstLoadAsync()
    {
        var generation = ++loadGeneration;
        isRefreshing = true;
        try { await Task.WhenAll(LoadBalance(), LoadActivity()); }
        finally
        {
            if (generation == loadGeneration) isRefreshing = false;   // a newer wallet's load owns the flag now
        }
    }

    // The balance card's refresh button: same as always, except it is ignored while another refresh is running.
    private async Task Refresh()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        try
        {
            await LoadBalance();
            await LoadActivity();
        }
        finally { isRefreshing = false; }
    }

    // Pull down to refresh: reloads balance and activity; if either can't be reached, keeps what is on screen and says so.
    private async Task PullRefresh()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        try
        {
            var balanceOk = await LoadBalance(keepPreviousOnFailure: true);
            var activityOk = await LoadActivity(keepPreviousOnFailure: true);
            if (!balanceOk || !activityOk) Notifications.Error("Couldn't refresh");
        }
        finally { isRefreshing = false; }
    }

    private async Task LoadPrice()
    {
        try { dgbPrice = await Blockchain.GetDgbPriceAsync(AppState.FiatCurrency); }
        catch { dgbPrice = 0; }   // no price just means no fiat line
        StateHasChanged();
    }

    // Returns false when the balance could not be fetched. By default that shows "unknown"; with keepPreviousOnFailure
    // the last known balance stays on screen instead.
    private async Task<bool> LoadBalance(bool keepPreviousOnFailure = false)
    {
        isLoadingBalance = true;
        StateHasChanged();
        try
        {
            balanceSatoshis = await MultisigService.GetBalanceAsync(config!);
            return true;
        }
        catch
        {
            if (!keepPreviousOnFailure) balanceSatoshis = null;   // unknown stays unknown: never shown as 0
            return false;
        }
        finally
        {
            isLoadingBalance = false;
            StateHasChanged();
        }
    }

    // Returns false when the chain could not be reached (the service then returns only local proposals, marked partial).
    // By default the partial page is shown; with keepPreviousOnFailure the activity already on screen stays as it is.
    private async Task<bool> LoadActivity(bool keepPreviousOnFailure = false)
    {
        isLoadingActivity = true;
        StateHasChanged();
        try
        {
            var page = await MultisigService.GetActivityAsync(config!, 0, 25);
            if (page.IsPartial && keepPreviousOnFailure) return false;
            recentActivity = page.Entries.Take(4).ToList();
            activityPartial = page.IsPartial;
            return !page.IsPartial;
        }
        catch
        {
            if (!keepPreviousOnFailure) activityPartial = true;
            return false;
        }
        finally
        {
            isLoadingActivity = false;
            StateHasChanged();
        }
    }

    private async Task<RenameResult> RenameWallet(string name)
    {
        var result = await MultisigService.RenameWalletAsync(WalletId, name);
        if (result.Ok) config!.Name = result.Name;
        return result;
    }

    private Task<RenameResult> RenameCoSigner(string publicKeyHex, string name) =>
        MultisigService.RenameCoSignerAsync(WalletId, publicKeyHex, name);

    private async Task DownloadBackupFirst()
    {
        var (filename, content) = MultisigWalletService.BuildBackup(config!);
        await JS.InvokeVoidAsync("downloadTextFile", content, filename);
        await MultisigService.MarkBackedUpAsync(WalletId);
        config!.BackupAt = DateTime.UtcNow;
    }

    private async Task RemoveWallet()
    {
        isRemoving = true;
        try
        {
            await MultisigService.DeleteWalletAsync(WalletId, ActiveWallet.WalletId);
            Nav.NavigateTo("/multisig");
        }
        finally { isRemoving = false; }
    }

    private void OpenActivityEntry(ActivityEntry entry) => Nav.NavigateTo($"/multisig/{WalletId}/activity");

    private void CreateTransaction() => Nav.NavigateTo($"/multisig/{WalletId}/send");
    private void ViewPendingTxs() => Nav.NavigateTo($"/multisig/{WalletId}/pending");

    private void ViewActivity() => Nav.NavigateTo($"/multisig/{WalletId}/activity");
}
