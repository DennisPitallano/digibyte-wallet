@page "/recover-wallet"
@using DigiByte.Wallet.Storage
@inject WalletService WalletService
@inject AppState AppState
@inject NavigationManager Nav
@inject DigiByte.Wallet.Services.P2pGatewayOptions Gateway
@inject SearchOfferCoordinator SearchOffer
@inject LocalizationService L

<PageTitle>@(isAddWalletMode ? L.T("welcome.page_title_add") : L.T("recover.page_title")) — @L.T("app.name")</PageTitle>

<div class="flex flex-col gap-5">
    @if (isAddWalletMode)
    {
        <button type="button" class="back-btn self-start"
                @onclick="GoBack">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <span>@L.T("dd.back")</span>
        </button>
    }

    @* Step Indicator *@
    <div class="flex items-center justify-center gap-2 mb-2 fade-in">
        @for (int i = 0; i < totalSteps; i++)
        {
            var idx = i;
            <div class="h-1.5 rounded-full transition-all duration-500 ease-out @(idx <= currentStepIndex ? "bg-dgb-500 w-10" : "bg-slate-200 dark:bg-dgb-800 w-6")"></div>
        }
    </div>

    @if (step == Step.NameWallet)
    {
        <div class="slide-up">
            <h2 class="page-title">@L.T("create.name_title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@L.T("create.name_hint")</p>
        </div>

        <div class="flex flex-col gap-3">
            <input type="text" @bind="walletName" @bind:event="oninput"
                   placeholder="@L.T("create.name_placeholder")"
                   maxlength="30" autocomplete="off"
                   class="input" />
            <p class="text-xs text-slate-400 dark:text-slate-500 text-right">@walletName.Length / 30</p>
        </div>

        @* Color Picker *@
        <div class="flex flex-col gap-2">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("create.color_label")</p>
            <div class="flex flex-wrap gap-2.5">
                @foreach (var c in WalletInfo.ColorPalette)
                {
                    var color = c;
                    <button class="w-9 h-9 rounded-full transition-all duration-200 press-effect ring-offset-2 ring-offset-white dark:ring-offset-dgb-950 @(walletColor == color ? "ring-2 scale-110" : "hover:scale-105")"
                            style="background-color: @color; @(walletColor == color ? $"box-shadow: 0 0 0 2px {color}40; --tw-ring-color: {color};" : "")"
                            @onclick="() => walletColor = color">
                        @if (walletColor == color)
                        {
                            <svg class="w-4 h-4 mx-auto text-white drop-shadow" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>

        <button class="btn-primary w-full"
                @onclick="NameContinue" disabled="@string.IsNullOrWhiteSpace(walletName)">
            @L.T("create.continue")
        </button>
    }
    else if (step == Step.EnterMnemonic)
    {
        <BakuMessage MessageId="recover.intro" />
        <div class="slide-up">
            <h2 class="page-title">@L.T("recover.title")</h2>
        </div>

        @* Recovery method toggle *@
        <div class="segmented slide-up-delay-1">
            <button class="segmented-item flex-1" aria-pressed="@(!isPrivateKeyMode ? "true" : "false")"
                    @onclick="() => isPrivateKeyMode = false">@L.T("recover.mode_phrase")</button>
            <button class="segmented-item flex-1" aria-pressed="@(isPrivateKeyMode ? "true" : "false")"
                    @onclick="() => isPrivateKeyMode = true">@L.T("recover.mode_key")</button>
        </div>

        @if (!isPrivateKeyMode)
        {
            @* Mnemonic input mode toggle *@
            <div class="segmented slide-up-delay-1">
                <button class="segmented-item flex-1" aria-pressed="@(!wordByWordMode ? "true" : "false")"
                        @onclick="() => SwitchInputMode(false)">@L.T("recover.paste_all")</button>
                <button class="segmented-item flex-1" aria-pressed="@(wordByWordMode ? "true" : "false")"
                        @onclick="() => SwitchInputMode(true)">@L.T("recover.word_by_word")</button>
            </div>

            <div class="flex flex-col gap-3 slide-up-delay-1">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        @(wordByWordMode ? L.T("recover.word_by_word_hint") : L.T("recover.paste_hint"))
                    </p>
                    <button type="button" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors"
                            @onclick="() => showMnemonic = !showMnemonic" title="@(showMnemonic ? L.T("recover.hide_phrase") : L.T("recover.show_phrase"))">
                        @if (showMnemonic)
                        {
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        }
                    </button>
                </div>

                @if (!wordByWordMode)
                {
                    @* Paste-all mode *@
                    <div class="relative">
                        @if (showMnemonic)
                        {
                            <textarea @bind="mnemonicInput" @bind:event="oninput" rows="4"
                                      placeholder="@L.T("recover.phrase_placeholder")"
                                      autocomplete="off" spellcheck="false" autocapitalize="off"
                                      class="input resize-none"></textarea>
                        }
                        else
                        {
                            <textarea @bind="mnemonicInput" @bind:event="oninput" rows="4"
                                      placeholder="@L.T("recover.phrase_placeholder")"
                                      autocomplete="off" spellcheck="false" autocapitalize="off"
                                      style="-webkit-text-security: disc; text-security: disc;"
                                      class="input resize-none"></textarea>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(mnemonicInput))
                    {
                        var wc = mnemonicInput.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 text-right">@L.T("recover.word_count", wc, wc > 12 ? 24 : 12)</p>
                    }
                }
                else
                {
                    @* Word-by-word mode *@
                    <div class="flex items-center justify-between gap-3">
                        @* Progress, so a missing word is noticed before Continue. *@
                        <p class="text-sm text-slate-600 dark:text-slate-300" aria-live="polite" data-testid="seed-progress">
                            @Before("recover.progress", wordCount)<span class="font-semibold text-slate-900 dark:text-white">@FilledWords</span>@After("recover.progress", wordCount)
                            @if (InvalidWords > 0)
                            {
                                <span class="text-red-600 dark:text-red-400">@(InvalidWords == 1 ? L.T("recover.not_recognised.one", InvalidWords) : L.T("recover.not_recognised.other", InvalidWords))</span>
                            }
                        </p>
                        <div class="seed-count" role="group" aria-label="@L.T("recover.word_count_label")">
                            <button type="button" aria-pressed="@(wordCount == 12 ? "true" : "false")" @onclick="() => SetWordCount(12)">12</button>
                            <button type="button" aria-pressed="@(wordCount == 24 ? "true" : "false")" @onclick="() => SetWordCount(24)">24</button>
                        </div>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("recover.tip_paste")</p>
                    @* Each word is one box with its number inside. The grid picks two or three columns to fit the screen,
                       and boxes can shrink, so nothing runs off the side. *@
                    <div class="seed-grid">
                        @for (int i = 0; i < wordCount; i++)
                        {
                            var idx = i;
                            var state = string.IsNullOrEmpty(wordInputs[idx]) ? "" : IsWordValid(idx) ? "is-valid" : "is-invalid";
                            <div class="seed-cell @state">
                                <label class="seed-cell-num" for="@($"seed-word-{idx + 1}")" aria-hidden="true">@((idx + 1).ToString())</label>
                                <input id="@($"seed-word-{idx + 1}")" type="@(showMnemonic ? "text" : "password")"
                                       aria-label="@L.T("recover.word_aria", idx + 1, wordCount)"
                                       aria-invalid="@(state == "is-invalid" ? "true" : null)"
                                       value="@wordInputs[idx]"
                                       @oninput="(e) => OnWordInput(idx, e.Value?.ToString() ?? string.Empty)"
                                       @onfocus="() => OnWordFocus(idx)"
                                       @onblur="() => OnWordBlur(idx)"
                                       @onkeydown="(e) => OnWordKeyDown(idx, e)"
                                       autocomplete="off" spellcheck="false" autocapitalize="off"
                                       />
                                @if (activeWordIndex == idx && suggestions.Length > 0)
                                {
                                    <div class="seed-suggest">
                                        @for (int j = 0; j < suggestions.Length; j++)
                                        {
                                            var sIdx = j;
                                            var word = suggestions[sIdx];
                                            <button type="button"
                                                    class="@(sIdx == selectedSuggestion ? "is-active" : "")"
                                                    @onmousedown:preventDefault
                                                    @onmousedown="() => SelectSuggestion(idx, word)">
                                                @if (showMnemonic)
                                                {
                                                    @word
                                                }
                                                else
                                                {
                                                    <span>@word[..Math.Min(2, word.Length)]<span class="text-slate-400">@(new string('•', Math.Max(0, word.Length - 2)))</span></span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (mnemonicError != null)
                {
                    <InlineError Message="@mnemonicError" />
                }
            </div>

            <div class="flex flex-col gap-2">
                <button class="btn-primary w-full"
                        @onclick="ValidateMnemonic" disabled="@IsMnemonicEmpty">
                    @L.T("create.continue")
                </button>
                <button type="button" class="btn-ghost btn-sm" @onclick="GoBack">@L.T("dd.back")</button>
            </div>
        }
        else
        {
            @* Private Key (WIF) input *@
            <div class="flex flex-col gap-3 slide-up-delay-1">
                <p class="text-sm text-slate-500 dark:text-slate-400">@L.T("recover.wif_hint")</p>
                <div class="flex gap-1.5">
                    <input type="password" @bind="wifInput" @bind:event="oninput"
                           placeholder="@L.T("recover.wif_placeholder")"
                           autocomplete="off" spellcheck="false"
                           class="input flex-1 font-mono" />
                    <button type="button" class="w-12 h-12 rounded-xl bg-dgb-500 text-white flex items-center justify-center hover:bg-dgb-600 transition-all flex-shrink-0 press-effect"
                            @onclick="() => showScanner = true" title="@L.T("dd.send.scan")" aria-label="@L.T("dd.send.scan")">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5Z" />
                        </svg>
                    </button>
                </div>

                @* Address preview *@
                @if (previewAddress != null)
                {
                    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 rounded-xl p-3">
                        <p class="text-xs text-green-600 dark:text-green-400 font-semibold mb-1">@L.T("recover.address_preview")</p>
                        <p class="text-xs font-mono text-green-700 dark:text-green-300 break-all">@previewAddress</p>
                    </div>
                }

                @if (wifError != null)
                {
                    <InlineError Message="@wifError" />
                }
            </div>

            <div class="flex flex-col gap-2">
                <button class="btn-primary w-full"
                        @onclick="ValidateWif" disabled="@string.IsNullOrWhiteSpace(wifInput)">
                    @L.T("create.continue")
                </button>
                <button type="button" class="btn-ghost btn-sm" @onclick="GoBack">@L.T("dd.back")</button>
            </div>
        }
    }
    else if (step == Step.SetPin)
    {
        <div class="slide-up text-center">
            <h2 class="page-title">@L.T("create.set_pin")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@L.T("create.pin_choose")</p>
        </div>

        <div class="flex flex-col gap-4 items-center">
            @if (!isConfirmingPin)
            {
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.pin_enter")</p>
                <PinInput @ref="rPinInput1" ValueChanged="(v) => pin = v" OnComplete="GoToConfirmPin" Error="@pinError" />
            }
            else
            {
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("create.pin_confirm")</p>
                <PinInput @ref="rPinInput2" ValueChanged="(v) => pinConfirm = v" OnComplete="RecoverAsync" Error="@pinError" />
                <button class="text-sm text-dgb-500 hover:text-dgb-600 font-medium" @onclick="BackToSetPin">@L.T("create.pin_change")</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(restoreNote))
        {
            <p class="text-xs text-amber-600 dark:text-amber-400 text-center" role="status" data-testid="restore-note">@restoreNote</p>
        }
        @if (restorePercent >= 0)
        {
            <p class="text-xs text-slate-500 text-center" role="status">@L.T("recover.restoring_gateway")</p>
        }
        @if (Gateway.Enabled && !isPrivateKeyMode)
        {
            @* Optional: when the wallet was first used. With it, a restore through the light-client gateway reads only the blocks since then. *@
            <div class="flex flex-col gap-1">
                <label for="first-use" class="text-xs font-semibold text-slate-500 dark:text-slate-400">@L.T("recover.first_use_label")</label>
                <input id="first-use" type="date" class="input"
                       max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" @bind="firstUse" />
                <p class="text-[11px] text-slate-400">@L.T("recover.first_use_hint")</p>
            </div>
        }

        <button class="btn-primary w-full slide-up-delay-2"
                @onclick="OnPinButtonClick"
                disabled="@(isRecovering || (!isConfirmingPin && pin.Length < 6) || (isConfirmingPin && pinConfirm.Length < 6))">
            @if (isRecovering)
            {
                <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span>@(restorePercent < 0 ? L.T("recover.recovering") : L.T("recover.restoring_percent", restorePercent))</span>
            }
            else if (!isConfirmingPin)
            {
                <span>@L.T("create.continue")</span>
            }
            else
            {
                <span>@L.T("recover.recover_button")</span>
            }
        </button>
    }

    @* QR Scanner for WIF *@
    <QrScannerModal IsOpen="@showScanner" OnScanned="OnQrScanned" OnClosed="() => showScanner = false" />
</div>


@if (legacyReason is { } legacyWhy)
{
    <LegacyProtectionConsent Reason="legacyWhy" OnAgree="AgreeLegacyAsync" OnCancel="CancelLegacy" />
}

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    // The text before and after {0} in a translated sentence (other values filled in), so the highlighted part can sit
    // wherever the language puts it.
    private string Before(string key, params object[] rest) { var t = L.T(key, [(object)"{0}", .. rest]); var i = t.IndexOf("{0}", StringComparison.Ordinal); return i < 0 ? t : t[..i]; }
    private string After(string key, params object[] rest) { var t = L.T(key, [(object)"{0}", .. rest]); var i = t.IndexOf("{0}", StringComparison.Ordinal); return i < 0 ? "" : t[(i + 3)..]; }

    // A browser that cannot run the stronger protection: the wallet is created with the earlier one only if the user agrees.
    private CryptoFailure? legacyReason;
    private bool legacyAgreed;

    private async Task AgreeLegacyAsync()
    {
        legacyAgreed = true;
        legacyReason = null;
        await RecoverAsync();
    }

    private void CancelLegacy() => legacyReason = null;

    private enum Step { NameWallet, EnterMnemonic, SetPin }
    private Step step = Step.EnterMnemonic;

    // Mnemonic fields
    private string mnemonicInput = "";
    private string? mnemonicError;
    private bool showMnemonic;
    private bool wordByWordMode;
    private int wordCount = 12;
    private string[] wordInputs = new string[24];

    // Auto-suggest
    private static readonly string[] bip39Words = DigiByte.Crypto.KeyGeneration.MnemonicGenerator.GetWordList();
    private int activeWordIndex = -1;
    private string[] suggestions = [];
    private int selectedSuggestion;

    private bool IsMnemonicEmpty => wordByWordMode
        ? wordInputs.Take(wordCount).All(string.IsNullOrWhiteSpace)
        : string.IsNullOrWhiteSpace(mnemonicInput);

    // Private Key fields
    private bool isPrivateKeyMode;
    private string wifInput = "";
    private string? wifError;
    private string? previewAddress;
    private bool showScanner;

    // PIN fields
    private string pin = "";
    private string pinConfirm = "";
    private string? pinError;
    private bool isRecovering;
    private DateTime? firstUse;
    private string? restoreNote;
    private int restorePercent = -1;
    private bool isConfirmingPin;
    private PinInput? rPinInput1;
    private PinInput? rPinInput2;

    // Add-wallet mode
    private bool isAddWalletMode;
    private string walletName = "";
    private string walletColor = WalletInfo.ColorPalette[0];

    private int totalSteps => isAddWalletMode ? 3 : 2;
    private int currentStepIndex => step switch
    {
        Step.NameWallet => 0,
        Step.EnterMnemonic => isAddWalletMode ? 1 : 0,
        Step.SetPin => isAddWalletMode ? 2 : 1,
        _ => 0
    };

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        isAddWalletMode = uri.Query.Contains("addWallet=true");
        step = isAddWalletMode ? Step.NameWallet : Step.EnterMnemonic;
        Array.Fill(wordInputs, "");
    }

    private void GoBack()
    {
        if (isAddWalletMode)
            Nav.NavigateTo("/welcome?addWallet=true");
        else
            Nav.NavigateTo("/welcome");
    }

    private void NameContinue()
    {
        if (string.IsNullOrWhiteSpace(walletName)) return;
        step = Step.EnterMnemonic;
    }

    private void SwitchInputMode(bool toWordByWord)
    {
        if (wordByWordMode == toWordByWord) return;
        mnemonicError = null;

        if (toWordByWord && !string.IsNullOrWhiteSpace(mnemonicInput))
        {
            // Transfer paste-all text into individual word inputs
            var words = mnemonicInput.Trim().ToLower().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (words.Length > 12) wordCount = 24;
            Array.Fill(wordInputs, "");
            for (int i = 0; i < Math.Min(words.Length, wordInputs.Length); i++)
                wordInputs[i] = words[i];
        }
        else if (!toWordByWord)
        {
            // Transfer word inputs back into paste-all text
            var words = wordInputs.Take(wordCount).Where(w => !string.IsNullOrWhiteSpace(w)).Select(w => w.Trim().ToLower());
            mnemonicInput = string.Join(' ', words);
        }

        wordByWordMode = toWordByWord;
    }

    private void SetWordCount(int count)
    {
        wordCount = count;
        if (count == 12)
            Array.Fill(wordInputs, "", 12, 12); // clear words 13-24
    }

    private static readonly char[] WordSeparators = [' ', ',', '\n', '\r', '\t'];

    private void OnWordChanged(int index, string value)
    {
        mnemonicError = null;

        // Split on space, comma, or newline — handles paste of full phrase
        var parts = value.Trim().Split(WordSeparators, StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w.Trim().ToLower()).Where(w => w.Length > 0).ToArray();

        if (parts.Length > 1)
        {
            // Pasted multiple words — distribute starting from this index
            if (parts.Length > 12) wordCount = 24;
            else if (index == 0 && parts.Length == 12) wordCount = 12;
            for (int i = 0; i < parts.Length && (index + i) < wordInputs.Length; i++)
                wordInputs[index + i] = parts[i];
            suggestions = [];
            activeWordIndex = -1;
        }
        else
        {
            wordInputs[index] = parts.Length == 1 ? parts[0] : string.Empty;
        }
    }

    private void OnWordInput(int index, string value)
    {
        OnWordChanged(index, value);
        UpdateSuggestions(index);
    }

    private void OnWordFocus(int index)
    {
        activeWordIndex = index;
        UpdateSuggestions(index);
    }

    private void OnWordBlur(int index)
    {
        // Delay to allow click on suggestion
        activeWordIndex = -1;
        suggestions = [];
    }

    private void UpdateSuggestions(int index)
    {
        var input = wordInputs[index]?.Trim().ToLower();
        if (string.IsNullOrEmpty(input) || input.Length < 1)
        {
            suggestions = [];
            selectedSuggestion = 0;
            return;
        }

        suggestions = bip39Words
            .Where(w => w.StartsWith(input, StringComparison.Ordinal))
            .Take(6)
            .ToArray();
        selectedSuggestion = 0;

        // Auto-accept if exact match
        if (suggestions.Length == 1 && suggestions[0] == input)
            suggestions = [];
    }

    private void SelectSuggestion(int index, string word)
    {
        wordInputs[index] = word;
        suggestions = [];
        activeWordIndex = -1;
    }

    private void OnWordKeyDown(int index, KeyboardEventArgs e)
    {
        if (suggestions.Length == 0) return;

        if (e.Key == "ArrowDown")
        {
            selectedSuggestion = Math.Min(selectedSuggestion + 1, suggestions.Length - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            selectedSuggestion = Math.Max(selectedSuggestion - 1, 0);
        }
        else if (e.Key == "Enter" || e.Key == "Tab")
        {
            wordInputs[index] = suggestions[selectedSuggestion];
            suggestions = [];
            activeWordIndex = -1;
        }
        else if (e.Key == "Escape")
        {
            suggestions = [];
            activeWordIndex = -1;
        }
    }

    private int FilledWords => wordInputs.Take(wordCount).Count(w => !string.IsNullOrWhiteSpace(w));
    private int InvalidWords => Enumerable.Range(0, wordCount).Count(i => !IsWordValid(i));

    private bool IsWordValid(int index)
    {
        var w = wordInputs[index];
        return string.IsNullOrEmpty(w) || Array.BinarySearch(bip39Words, w) >= 0;
    }

    private void ValidateMnemonic()
    {
        mnemonicError = null;

        string cleaned;
        if (wordByWordMode)
        {
            var words = wordInputs.Take(wordCount).Select(w => w?.Trim().ToLower() ?? "").ToArray();
            if (words.Any(string.IsNullOrWhiteSpace))
            {
                var emptyIndices = words.Select((w, i) => string.IsNullOrWhiteSpace(w) ? i + 1 : -1).Where(i => i > 0);
                var missing = $"{string.Join(", ", emptyIndices.Take(5))}{(emptyIndices.Count() > 5 ? "..." : "")}";
                mnemonicError = emptyIndices.Count() == 1 ? L.T("recover.missing.one", missing) : L.T("recover.missing.other", missing);
                return;
            }
            cleaned = string.Join(' ', words);
        }
        else
        {
            cleaned = string.Join(' ', mnemonicInput.Trim().ToLower()
                .Split(' ', StringSplitOptions.RemoveEmptyEntries));
        }

        var wordCount2 = cleaned.Split(' ').Length;
        if (wordCount2 != 12 && wordCount2 != 24) { mnemonicError = L.T("recover.wrong_count", wordCount2); return; }
        if (!DigiByte.Crypto.KeyGeneration.MnemonicGenerator.IsValid(cleaned)) { mnemonicError = L.T("recover.invalid_phrase"); return; }
        mnemonicInput = cleaned;
        step = Step.SetPin;
    }

    private void ValidateWif()
    {
        wifError = null;
        previewAddress = null;

        if (string.IsNullOrWhiteSpace(wifInput))
        {
            wifError = L.T("recover.wif_empty");
            return;
        }

        if (!DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.IsValidWif(wifInput.Trim()))
        {
            wifError = L.T("recover.wif_invalid");
            return;
        }

        // Show address preview
        try
        {
            var network = DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.DetectNetwork(wifInput.Trim()) ?? WalletService.CurrentNetworkPublic;
            previewAddress = DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.GetAddress(
                wifInput.Trim(), network, NBitcoin.ScriptPubKeyType.Segwit);
        }
        catch { }

        step = Step.SetPin;
    }

    private void OnQrScanned(string data)
    {
        showScanner = false;
        wifInput = data.Trim();
        // Try to show preview immediately
        try
        {
            if (DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.IsValidWif(wifInput))
            {
                var network = DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.DetectNetwork(wifInput.Trim()) ?? WalletService.CurrentNetworkPublic;
                previewAddress = DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.GetAddress(
                    wifInput, network, NBitcoin.ScriptPubKeyType.Segwit);
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task OnPinButtonClick()
    {
        if (isConfirmingPin) await RecoverAsync();
        else GoToConfirmPin();
    }

    private void GoToConfirmPin()
    {
        if (pin.Length < 6) { pinError = L.T("create.pin_incomplete"); return; }
        pinError = null; pinConfirm = ""; isConfirmingPin = true;
    }

    private void BackToSetPin()
    {
        isConfirmingPin = false; pin = ""; pinConfirm = ""; pinError = null;
        rPinInput1?.Clear();
    }

    private async Task RecoverAsync()
    {
        pinError = null;
        if (pin.Length < 6) { pinError = L.T("create.pin_incomplete"); return; }
        if (pin != pinConfirm) { pinError = L.T("create.pin_mismatch"); pinConfirm = ""; rPinInput2?.Clear(); return; }
        isRecovering = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            WalletService.SetNetworkMode(AppState.NetworkMode);
            if (isPrivateKeyMode)
            {
                var name = isAddWalletMode ? walletName.Trim() : L.T("wallet.imported_name"); // saved in the chosen language (spec 028)
                var color = isAddWalletMode ? walletColor : null;
                await WalletService.CreateWalletFromWifAsync(name, wifInput.Trim(), pin, color, allowLegacyProtection: legacyAgreed);
            }
            else
            {
                var name = isAddWalletMode ? walletName.Trim() : L.T("wallet.default_name"); // saved in the chosen language (spec 028)
                var color = isAddWalletMode ? walletColor : null;
                var restored = await WalletService.CreateWalletAsync(name, mnemonicInput, pin, color, allowLegacyProtection: legacyAgreed);
                // Restored from an existing phrase: it may get the "search further" offer (spec 027, FR-002a).
                await SearchOffer.MarkOriginAsync(restored.Id, WalletOrigin.Restored);
            }
            AppState.IsWalletCreated = true; AppState.IsWalletUnlocked = true; AppState.NotifyStateChanged();
            await RestoreThroughGatewayAsync();
            Nav.NavigateTo("/");
        }
        catch (LegacyProtectionConsentRequiredException ex) { legacyReason = ex.Reason; }
        catch (Exception ex) { pinError = L.T("recover.failed", ex.Message); }
        finally { isRecovering = false; }
    }
    /// <summary>
    /// With the light-client gateway on and a date given, restore through it first (specs/011-p2p-spv-gateway). It returns nothing when the
    /// gateway is not used here, and the ordinary discovery then runs as it always did. When the gateway does not keep blocks that far
    /// back, say so before carrying on with the explorers.
    /// </summary>
    private async Task RestoreThroughGatewayAsync()
    {
        if (!Gateway.Enabled || isPrivateKeyMode || firstUse is null)
            return;
        restorePercent = 0;
        StateHasChanged();
        var progress = new Progress<double>(p => { restorePercent = (int)Math.Round(p * 100); InvokeAsync(StateHasChanged); });
        var result = await WalletService.RestoreViaGatewayAsync(new DateTimeOffset(DateTime.SpecifyKind(firstUse.Value, DateTimeKind.Utc)), deep: false, progress);
        restorePercent = -1;
        if (result?.Outcome == DigiByte.Wallet.Services.RestoreOutcome.UseExplorer)
        {
            restoreNote = result.Message;
            StateHasChanged();
            await Task.Delay(3500);
        }
    }
}
