@page "/multisig/create"
@inject MultisigWalletService MultisigService
@inject WalletService WalletService
@inject ActiveWalletContext ActiveWallet
@inject AppState AppState
@inject ClipboardService Clipboard
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalizationService L

<PageTitle>@L.T("ms.create.page_title")</PageTitle>

<AuthGuard>
<div class="flex flex-col gap-5">
    @* Same step language as the online creation room (spec 018, FR-008) *@
    @if (step != Step.Done)
    {
        <StepIndicator Steps="ManualSteps" Current="(int)step" />
    }

    @if (step == Step.Configure)
    {
        <div class="slide-up">
            <h2 class="page-title">@L.T("ms.create.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@L.T("ms.create.subtitle")</p>
        </div>

        <div class="flex flex-col gap-4">
            @* Wallet Name *@
            <div class="flex flex-col gap-1.5 slide-up-delay-1">
                <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("ms.create.name_label")</label>
                <input type="text" @bind="walletName" placeholder="@L.T("ms.create.name_placeholder")"
                       class="input" />
            </div>

            @* M-of-N Configuration *@
            <div class="card slide-up-delay-1 p-4">
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">@L.T("ms.create.scheme")</p>
                <div class="flex items-center gap-3">
                    <div class="flex flex-col items-center gap-1">
                        <label class="text-[11px] text-slate-400 uppercase">@L.T("ms.create.required")</label>
                        <select @bind="requiredSigs"
                                class="w-16 px-2 py-2 bg-slate-50 dark:bg-dgb-800 border border-slate-200 dark:border-dgb-700 rounded-xl text-center text-slate-900 dark:text-white font-bold outline-none">
                            @for (int m = 1; m <= totalSigners; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>
                    <span class="text-lg font-bold text-slate-400 mt-4">@L.T("ms.create.of")</span>
                    <div class="flex flex-col items-center gap-1">
                        <label class="text-[11px] text-slate-400 uppercase">@L.T("ms.create.total")</label>
                        <select @bind="totalSigners" @bind:after="OnTotalChanged"
                                class="w-16 px-2 py-2 bg-slate-50 dark:bg-dgb-800 border border-slate-200 dark:border-dgb-700 rounded-xl text-center text-slate-900 dark:text-white font-bold outline-none">
                            @for (int n = 2; n <= 7; n++)
                            {
                                <option value="@n">@n</option>
                            }
                        </select>
                    </div>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2" aria-live="polite">@DescribeScheme(requiredSigs, totalSigners)</p>
            </div>
        </div>

        <button class="btn-primary w-full slide-up-delay-2"
                @onclick="GoToAddSigners" disabled="@string.IsNullOrWhiteSpace(walletName)">
            @L.T("ms.create.next_signers")
        </button>

        <div class="flex items-center gap-3 slide-up-delay-2">
            <div class="flex-1 h-px bg-slate-200 dark:bg-dgb-800"></div>
            <span class="text-[11px] text-slate-400 dark:text-slate-500 uppercase">@L.T("ms.create.or")</span>
            <div class="flex-1 h-px bg-slate-200 dark:bg-dgb-800"></div>
        </div>

        <a href="/multisig/room" class="flex items-center justify-center gap-2 w-full py-3 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 text-purple-600 dark:text-purple-400 font-semibold rounded-2xl hover:bg-purple-100 dark:hover:bg-purple-900/30 transition-colors press-effect slide-up-delay-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
            </svg>
            @L.T("ms.create.together")
        </a>

        <a href="/help/multisig" class="flex items-center justify-center gap-1.5 text-xs text-purple-500 hover:text-purple-600 font-medium py-2 slide-up-delay-2">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
            @L.T("ms.wallets.empty.guide")
        </a>
    }
    else if (step == Step.AddSigners)
    {
        <div class="slide-up">
            <h2 class="page-title">@L.T("ms.create.signers.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @L.T("ms.create.signers.subtitle")
            </p>
        </div>

        @* Own key (auto-populated) *@
        <div class="slide-up-delay-1 p-3 bg-dgb-50 dark:bg-dgb-900/50 rounded-2xl border border-dgb-200 dark:border-dgb-700">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-4 h-4 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-dgb-700 dark:text-dgb-300">@L.T("ms.create.you")</p>
                    <p class="text-[11px] text-dgb-600/80 dark:text-dgb-400/80 truncate">@Rich(L.T("ms.create.own_wallet"), WalletService.ActiveWallet?.Name ?? L.T("ms.create.wallet_fallback"))</p>
                    <p class="text-[11px] font-mono text-dgb-500/70 truncate">@ownPubKeyHex</p>
                </div>
                <button type="button" class="text-[11px] font-bold text-dgb-600 dark:text-dgb-400 bg-dgb-100 dark:bg-dgb-800 px-2.5 py-1 rounded-full press-effect disabled:opacity-50"
                        @onclick="CopyOwnKey" disabled="@string.IsNullOrWhiteSpace(ownPubKeyHex)">@L.T("ms.create.copy")</button>
            </div>
            <p class="text-[11px] text-dgb-600/80 dark:text-dgb-400/80 leading-relaxed mt-2">@L.T("ms.create.own_key_hint")</p>
        </div>

        @* Longer help stays folded so the step shows one short instruction (spec 018, FR-013) *@
        <CollapsePanel Title="@L.T("ms.create.how.title")" @bind-IsOpen="showHow">
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                @Rich(L.T("ms.create.how.ask"), L.T("ms.create.how.path"), L.T("ms.create.copy"))
                @Rich(L.T("ms.create.how.paste"), "02", "03")
            </p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">@L.T("ms.create.how.switch")</p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                <b>@L.T("ms.create.how.restore_q")</b> @L.T("ms.create.how.restore")
            </p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                @Rich(L.T("ms.create.how.draft"), L.T("ms.create.how.draft_button"))
            </p>
        </CollapsePanel>

        @* Co-signer entries *@
        <div class="flex items-center justify-between px-1">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("ms.create.cosigners")</p>
            <p class="text-[11px] font-semibold @(ValidCount == coSignerEntries.Count ? "text-green-600 dark:text-green-400" : "text-slate-400 dark:text-slate-500")">
                @L.T("ms.create.added", ValidCount, coSignerEntries.Count)
            </p>
        </div>
        <div class="flex flex-col gap-3">
            @for (int i = 0; i < coSignerEntries.Count; i++)
            {
                var idx = i;
                var entry = coSignerEntries[idx];
                var state = GetKeyState(entry);
                <div class="slide-up-delay-1 flex flex-col gap-2 p-3 bg-white dark:bg-dgb-900 rounded-2xl border @(state == KeyState.Valid ? "border-green-300 dark:border-green-700/50" : "border-slate-200/80 dark:border-dgb-800")">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-400 w-4">@(idx + 2)</span>
                        <input type="text" @bind="entry.Name" @bind:event="oninput" placeholder="@L.T("ms.create.signer_name_placeholder")" maxlength="40" autocomplete="off"
                               class="input flex-1" />
                        @if (state == KeyState.Valid)
                        {
                            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-label="@L.T("ms.create.valid_key")"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" @bind="entry.PubKeyHex" @bind:event="oninput" placeholder="@L.T("ms.create.signer_key_placeholder")"
                               autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="@L.T("ms.create.signer_key_aria", idx + 2)"
                               class="flex-1 min-w-0 px-3 py-2 bg-slate-50 dark:bg-dgb-800 border @(state is KeyState.Invalid or KeyState.Duplicate ? "border-red-300 dark:border-red-700/60" : "border-slate-200 dark:border-dgb-700") rounded-xl text-[11px] font-mono text-slate-900 dark:text-white outline-none focus:border-dgb-500 transition-all" />
                        <button type="button" @onclick="() => PasteKey(entry)"
                                class="flex-shrink-0 text-[11px] font-bold text-dgb-600 dark:text-dgb-400 bg-dgb-100 dark:bg-dgb-800 px-3 py-2 rounded-xl press-effect">@L.T("send.paste")</button>
                    </div>
                    @if (state == KeyState.Invalid)
                    {
                        <p class="text-[11px] text-red-500 dark:text-red-400">@L.T("ms.create.key_invalid")</p>
                    }
                    else if (state == KeyState.Duplicate)
                    {
                        <p class="text-[11px] text-red-500 dark:text-red-400">@L.T("ms.create.key_duplicate")</p>
                    }
                </div>
            }
        </div>

@if (draftWalletMismatch)
        {
            <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 px-3 py-2.5">
                <p class="text-[11px] text-amber-700 dark:text-amber-400 leading-relaxed">
                    @Rich(L.T("ms.create.draft_mismatch"), draftOwnWalletName)
                </p>
            </div>
        }

@if (!string.IsNullOrEmpty(error))
        {
            <InlineError Message="@error" />
        }

        <div class="flex flex-col gap-2 slide-up-delay-2">
            <button class="btn-secondary w-full"
                    @onclick="SaveDraft" disabled="@isSavingDraft">
                @(isSavingDraft ? L.T("ms.create.saving") : L.T("ms.create.save_draft"))
            </button>
            <button class="btn-primary w-full"
                    @onclick="GoToReview" disabled="@(!AllSignersValid())">
                @(AllSignersValid() ? L.T("ms.create.review_button") : coSignerEntries.Count - ValidCount == 1 ? L.T("ms.create.complete_more.one") : L.T("ms.create.complete_more.other", coSignerEntries.Count - ValidCount))
            </button>
            <button type="button" class="btn-ghost btn-sm" @onclick="BackToConfigure">@L.T("nav.back")</button>
        </div>
    }
    else if (step == Step.Review)
    {
        <div class="slide-up">
            <h2 class="page-title">@L.T("ms.create.review.title")</h2>
        </div>

        <div class="card slide-up-delay-1 p-4">
            <div class="flex flex-col gap-3">
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400">@L.T("ms.create.review.name")</span>
                    <span class="text-sm font-semibold text-slate-900 dark:text-white">@walletName</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400">@L.T("ms.create.review.type")</span>
                    <span class="text-sm font-semibold text-dgb-500">@L.T("ms.create.scheme_label", requiredSigs, totalSigners)</span>
                </div>
                <hr class="border-slate-100 dark:border-dgb-800" />
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("ms.create.cosigners")</p>
                <div class="flex items-start gap-2">
                    <span class="text-xs text-dgb-500 font-bold mt-0.5">1.</span>
                    <div class="min-w-0">
                        <p class="text-sm text-slate-900 dark:text-white font-medium">@L.T("ms.create.you")</p>
                        <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500">@ShortKey(ownPubKeyHex)</p>
                    </div>
                </div>
                @for (int i = 0; i < coSignerEntries.Count; i++)
                {
                    <div class="flex items-start gap-2">
                        <span class="text-xs text-dgb-500 font-bold mt-0.5">@(i + 2).</span>
                        <div class="min-w-0">
                            <p class="text-sm text-slate-900 dark:text-white font-medium">@coSignerEntries[i].Name.Trim()</p>
                            <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500">@ShortKey(coSignerEntries[i].PubKeyHex.Trim())</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="slide-up-delay-1 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 px-3 py-2.5">
            <p class="text-[11px] text-amber-700 dark:text-amber-400 leading-relaxed">
                @Rich(L.T("ms.create.review.warning"), L.T("ms.create.review.warning_check"), L.T("ms.create.redeem_script"))
            </p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <InlineError Message="@error" />
        }

        <div class="flex flex-col gap-2 slide-up-delay-2">
            <button class="btn-primary w-full"
                    @onclick="CreateWallet" disabled="@isCreating">
                @if (isCreating)
                {
                    <div class="flex items-center justify-center gap-2">
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>@L.T("ms.create.creating")</span>
                    </div>
                }
                else
                {
                    <span>@L.T("ms.create.title")</span>
                }
            </button>
            <button type="button" class="btn-ghost btn-sm" @onclick="BackToSigners">@L.T("nav.back")</button>
        </div>
    }
    else if (step == Step.Done && createdConfig != null)
    {
        <div class="slide-up flex flex-col items-center text-center gap-2">
            <div class="w-14 h-14 rounded-full bg-green-100 dark:bg-green-900/20 flex items-center justify-center">
                <svg class="w-7 h-7 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            </div>
            <h2 class="page-title">@L.T("ms.create.done.title")</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">@L.T("ms.create.scheme_label", createdConfig.RequiredSignatures, createdConfig.TotalSigners) · @createdConfig.Address.Substring(0, Math.Min(12, createdConfig.Address.Length))…</p>
        </div>

        <div class="slide-up-delay-1 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 px-3 py-2.5">
            <p class="text-xs font-bold text-amber-800 dark:text-amber-300 mb-1">@L.T("ms.create.done.backup_title")</p>
            <p class="text-[11px] text-amber-700 dark:text-amber-400 leading-relaxed">
                @Rich(L.T("ms.create.done.backup_body"), L.T("ms.create.done.backup_cant"))
            </p>
        </div>

        <div class="slide-up-delay-1 flex flex-col gap-2">
            <button class="btn-primary w-full" @onclick="DownloadBackup">
                @(backupSaved ? L.T("ms.create.done.downloaded") : L.T("ms.create.done.download"))
            </button>
            <button class="btn-secondary w-full" @onclick="CopyRedeemScript">
                @L.T("ms.create.done.copy_script")
            </button>
        </div>

        <div class="slide-up-delay-2 flex flex-col gap-2">
            <button class="w-full py-3 @(backupSaved ? "bg-dgb-500 hover:bg-dgb-600 text-white shadow-lg shadow-dgb-500/25" : "bg-slate-100 dark:bg-dgb-800 text-slate-500 dark:text-slate-400") font-semibold rounded-2xl transition-all press-effect"
                    @onclick="OpenCreatedWallet">
                @L.T("ms.create.done.open")
            </button>
            @if (!backupSaved)
            {
                <p class="text-[11px] text-center text-slate-400 dark:text-slate-500">@L.T("ms.create.done.later")</p>
            }
        </div>
    }
</div>
</AuthGuard>

@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    /// <summary>A translated sentence with its {n} values in bold; the sentence and the values are both HTML-encoded.</summary>
    private static MarkupString Rich(string template, params string[] bold) =>
        new(string.Format(System.Globalization.CultureInfo.InvariantCulture, System.Net.WebUtility.HtmlEncode(template),
            bold.Select(b => (object)("<b>" + System.Net.WebUtility.HtmlEncode(b) + "</b>")).ToArray()));

    private bool showHow;
    private string[] ManualSteps => [L.T("ms.create.step.setup"), L.T("ms.create.cosigners"), L.T("ms.create.step.confirm")];

    /// <summary>One plain-language sentence for the chosen M-of-N scheme (same cases as SchemeExplainer).</summary>
    private string DescribeScheme(int required, int total)
    {
        if (total < 1 || required < 1 || required > total) return "";
        if (required == total) return L.T("ms.create.explain.all", total);
        if (required == 1) return L.T("ms.create.explain.any_one", total);
        return L.T("ms.create.explain.some", required, total);
    }

    private enum Step { Configure, AddSigners, Review, Done }
    private Step step = Step.Configure;
    private DigiByte.Wallet.Models.MultisigWalletConfig? createdConfig;
    private bool backupSaved;

    private async Task DownloadBackup()
    {
        if (createdConfig == null) return;
        var (fileName, content) = MultisigWalletService.BuildBackup(createdConfig);
        await JS.InvokeVoidAsync("downloadTextFile", content, fileName);
        backupSaved = true;
    }

    private async Task CopyRedeemScript()
    {
        if (createdConfig == null) return;
        try { await Clipboard.CopyAsync(createdConfig.RedeemScriptHex, message: L.T("ms.create.script_copied")); }
        catch { }
    }

    private void OpenCreatedWallet() =>
        Nav.NavigateTo(createdConfig == null ? "/multisig" : $"/multisig/{createdConfig.WalletId}");

    private string walletName = "";
    private int requiredSigs = 2;
    private int totalSigners = 3;
    private string ownPubKeyHex = "";
    private string? error;
    private bool isCreating;

    private List<CoSignerEntry> coSignerEntries = [];

    private class CoSignerEntry
    {
        public string Name { get; set; } = "";
        public string PubKeyHex { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        InitCoSignerSlots();

        // Get own public key from the active wallet
        if (WalletService.IsUnlocked)
        {
            try
            {
                var ownKey = WalletService.GetPublicKey();
                if (ownKey != null)
                    ownPubKeyHex = ownKey;
            }
            catch { }
        }
    }

    private void InitCoSignerSlots()
    {
        var neededSlots = totalSigners - 1; // -1 for own key
        while (coSignerEntries.Count < neededSlots)
            coSignerEntries.Add(new CoSignerEntry());
        while (coSignerEntries.Count > neededSlots)
            coSignerEntries.RemoveAt(coSignerEntries.Count - 1);
    }

    private void OnTotalChanged()
    {
        if (requiredSigs > totalSigners)
            requiredSigs = totalSigners;
        InitCoSignerSlots();
    }

    private enum KeyState { Empty, Invalid, Duplicate, Valid }

    private KeyState GetKeyState(CoSignerEntry entry)
    {
        var hex = entry.PubKeyHex.Trim();
        if (hex.Length == 0) return KeyState.Empty;
        if (!IsValidPubKeyHex(hex)) return KeyState.Invalid;

        var normalized = hex.ToLowerInvariant();
        if (normalized == ownPubKeyHex.Trim().ToLowerInvariant()) return KeyState.Duplicate;
        // Only the later of two identical entries is flagged, so the first one stays "valid".
        var index = coSignerEntries.IndexOf(entry);
        for (int j = 0; j < index; j++)
            if (coSignerEntries[j].PubKeyHex.Trim().ToLowerInvariant() == normalized)
                return KeyState.Duplicate;
        return KeyState.Valid;
    }

    private int ValidCount => coSignerEntries.Count(e => GetKeyState(e) == KeyState.Valid && !string.IsNullOrWhiteSpace(e.Name));

    private bool AllSignersValid()
    {
        return !string.IsNullOrWhiteSpace(ownPubKeyHex) && ValidCount == coSignerEntries.Count && !draftWalletMismatch;
    }

    // ─── Drafts ───

    [SupplyParameterFromQuery(Name = "draft")] public string? DraftId { get; set; }

    private string? draftId;
    private string draftOwnWalletName = "";
    private bool draftWalletMismatch;
    private bool isSavingDraft;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(DraftId)) return;
        var draft = await MultisigService.GetDraftAsync(DraftId, ActiveWallet.WalletId, ActiveWallet.PublicKey);
        if (draft == null) return; // deleted or never existed: start a fresh setup

        draftId = draft.Id;
        walletName = draft.Name;
        totalSigners = Math.Clamp(draft.TotalSigners, 2, 7);
        requiredSigs = Math.Clamp(draft.RequiredSignatures, 1, totalSigners);
        InitCoSignerSlots();
        for (int i = 0; i < coSignerEntries.Count && i < draft.CoSigners.Count; i++)
        {
            coSignerEntries[i].Name = draft.CoSigners[i].Name;
            coSignerEntries[i].PubKeyHex = draft.CoSigners[i].PublicKeyHex;
        }

        draftOwnWalletName = string.IsNullOrWhiteSpace(draft.OwnWalletName) ? L.T("ms.create.original_wallet") : draft.OwnWalletName;
        draftWalletMismatch = !string.IsNullOrEmpty(draft.OwnPublicKeyHex)
            && !string.Equals(draft.OwnPublicKeyHex, ownPubKeyHex, StringComparison.OrdinalIgnoreCase);
        step = Step.AddSigners;
    }

    private async Task SaveDraft()
    {
        isSavingDraft = true;
        error = null;
        try
        {
            var draft = new DigiByte.Wallet.Models.MultisigDraft
            {
                Id = draftId ?? "",
                Name = walletName.Trim(),
                RequiredSignatures = requiredSigs,
                TotalSigners = totalSigners,
                // Keep the original owner's key when resuming under a different wallet, so the warning stays accurate.
                OwnPublicKeyHex = draftWalletMismatch ? "" : ownPubKeyHex,
                OwnWalletName = WalletService.ActiveWallet?.Name ?? "",
                OwnerWalletId = ActiveWallet.WalletId,
                CoSigners = coSignerEntries.Select(e => new DigiByte.Wallet.Models.DraftCoSigner
                {
                    Name = e.Name.Trim(),
                    PublicKeyHex = e.PubKeyHex.Trim(),
                }).ToList(),
            };
            if (draftWalletMismatch)
            {
                var existing = await MultisigService.GetDraftAsync(draftId!, ActiveWallet.WalletId, ActiveWallet.PublicKey);
                if (existing != null)
                {
                    draft.OwnPublicKeyHex = existing.OwnPublicKeyHex;
                    draft.OwnWalletName = existing.OwnWalletName;
                }
            }
            await MultisigService.SaveDraftAsync(draft);
            Nav.NavigateTo("/multisig");
        }
        catch (ArgumentException)
        {
            error = L.T("ms.create.error.draft_name");   // the only rule the service checks: a draft needs a name
        }
        catch (Exception)
        {
            error = L.T("ms.create.error.draft");
        }
        finally
        {
            isSavingDraft = false;
        }
    }

    // Compressed keys only: 33 bytes, 02/03 prefix. This is what the guide asks co-signers for.
    private static bool IsValidPubKeyHex(string hex)
    {
        if (hex.Length != 66) return false;
        try
        {
            return new NBitcoin.PubKey(hex).IsCompressed;
        }
        catch { return false; }
    }

    private static string ShortKey(string hex) =>
        hex.Length > 20 ? $"{hex[..10]}…{hex[^8..]}" : hex;

    private async Task PasteKey(CoSignerEntry entry)
    {
        var text = await Clipboard.ReadAsync();
        if (!string.IsNullOrWhiteSpace(text))
            entry.PubKeyHex = text.Trim();
    }

    private async Task CopyOwnKey()
    {
        if (string.IsNullOrWhiteSpace(ownPubKeyHex)) return;
        try { await Clipboard.CopyAsync(ownPubKeyHex, message: L.T("settings.multisig.copied", WalletService.ActiveWallet?.Name ?? L.T("ms.create.wallet_fallback"))); }
        catch { } // clipboard blocked: the key is still on screen
    }

    private void GoToAddSigners() => step = Step.AddSigners;
    private void GoToReview()
    {
        error = null;
        if (!AllSignersValid())
        {
            error = L.T("ms.create.error.signers");
            return;
        }
        step = Step.Review;
    }

    private void BackToConfigure() => step = Step.Configure;
    private void BackToSigners() => step = Step.AddSigners;

    private async Task CreateWallet()
    {
        isCreating = true;
        error = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var coSigners = new List<DigiByte.Wallet.Models.CoSigner>
            {
                new() { Name = WalletService.ActiveWallet?.Name ?? L.T("wallet.default_name"), PublicKeyHex = ownPubKeyHex, IsLocal = true }
            };

            foreach (var entry in coSignerEntries)
            {
                coSigners.Add(new DigiByte.Wallet.Models.CoSigner
                {
                    Name = entry.Name.Trim(),
                    PublicKeyHex = entry.PubKeyHex.Trim(),
                    IsLocal = false,
                });
            }

            createdConfig = await MultisigService.CreateMultisigWalletAsync(walletName, requiredSigs, coSigners, ownerWalletId: ActiveWallet.WalletId);
            if (draftId != null)
            {
                try { await MultisigService.DeleteDraftAsync(draftId); } catch { } // the wallet exists; a leftover draft is harmless
            }
            step = Step.Done;
        }
        catch (Exception)
        {
            error = L.T("ms.create.error.create");
        }
        finally
        {
            isCreating = false;
        }
    }
}
