@code {
    private enum Step { Form, Review, Done }

    private static readonly (string Label, decimal Share)[] AmountShares = [("25%", 0.25m), ("50%", 0.5m), ("75%", 0.75m), ("Max", 1m)];

    [Parameter] public string WalletId { get; set; } = "";
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    // A recipient (and amount) scanned with the menu's Scan while this shared wallet was open
    // (specs/026-multisig-wallet-experience, FR-002a). Only an address and an amount ever travel this way.
    [SupplyParameterFromQuery(Name = "address")] public string? QueryAddress { get; set; }
    [SupplyParameterFromQuery(Name = "amount")] public string? QueryAmount { get; set; }
    private string? appliedQuery;

    // The menu now hands a payment over in memory instead (specs/032-desktop-receive-everywhere, FR-001): the address
    // only says "a payment is waiting" with a counter, which also makes the page look again when it is already open.
    [SupplyParameterFromQuery(Name = "link")] public int? Link { get; set; }
    private DigiByte.Wallet.Services.PaymentLinkData? handedPayment;

    // The payment to fill in: one handed over in memory, else one in the address (older links).
    private string? PrefillAddress => handedPayment?.Address ?? (string.IsNullOrWhiteSpace(QueryAddress) ? null : QueryAddress.Trim());
    private decimal? PrefillAmount => handedPayment is not null
        ? handedPayment.AmountDgb
        : decimal.TryParse(QueryAmount, System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out var amount) && amount > 0 ? amount : null;

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private bool isLoading = true;
    private string? loadedFor;
    private RecipientInput? recipient;
    private bool showScanner;

    private Step step = Step.Form;
    private List<UtxoInfo>? utxos;
    private bool utxosFailed;
    private decimal dgbPrice;

    private string destination = "";
    private string amountText = "";
    private (string Text, decimal Value)? amountPick;
    private AmountEntryResult? amountAmbiguity;
    private string? memo;
    private bool useMax;
    private decimal? shareUsed;
    private int feeRate = MultisigWalletService.DefaultFeeRateSatPerVByte;

    private DestinationCheck? destCheck;
    private string? destinationError;
    private string? amountError;
    private SendEstimate? estimate;

    private bool isCreating;
    private bool isSigning;
    private string? error;
    private string? message;
    private PendingMultisigTransaction? created;

    // Several recipients (specs/029-multisig-multiple-recipients). Rows stay while the page is open, even with the mode off.
    private bool batchMode;
    private bool showBatchInfo;
    private List<RecipientRows.Row> rows = [new(), new()];
    private RecipientRows? rowsRef;
    private int scannerRowIndex = -1;
    private string? batchError;
    private bool batchRowsOk;
    private List<long> batchAmounts = [];
    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);
    private string submissionToken = Guid.NewGuid().ToString("N");

    private long Spendable => utxos?.Sum(u => u.AmountSatoshis) ?? 0;
    private bool CanContinue => batchMode
        ? batchRowsOk && rows.Count >= RecipientRows.MinRows && estimate is { Ok: true } && utxos is not null
        : destCheck?.Ok == true && estimate is { Ok: true } && utxos is not null;
    private bool IsShareActive(decimal share) => useMax ? share == 1m : shareUsed == share;

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        // Taken once per hand-over; a payment handed over for another shared wallet never carries over to this one.
        var handed = Link is not null ? PayHandoff.Take(WalletId) : null;
        if (loadedFor != WalletId) handedPayment = null;
        if (handed is not null) handedPayment = handed;

        if (loadedFor == WalletId)
        {
            // Same shared wallet, new scan: fill the form again.
            if (config is not null && ApplyQueryPrefill()) Recalculate();
            return;
        }
        loadedFor = WalletId;
        appliedQuery = null;
        isLoading = true;
        config = null;
        step = Step.Form;
        utxos = null;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;
            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
        }
        finally { isLoading = false; }

        if (config != null)
        {
            ApplyQueryPrefill();   // LoadUtxos ends with Recalculate, which checks what was filled in
            _ = LoadPrice();
            _ = LoadContactNames();
            await LoadUtxos();
        }
    }

    // Puts a scanned recipient and amount into the form, once per scan. They go through the same checks as typed
    // values (Recalculate); nothing is trusted because it came from an address. Returns true when something was filled in.
    private bool ApplyQueryPrefill()
    {
        var query = $"{Link}|{PrefillAddress}|{PrefillAmount}";
        if (PrefillAddress is null || query == appliedQuery) return false;
        appliedQuery = query;
        if (step != Step.Form) return false;

        destination = PrefillAddress;
        if (PrefillAmount is { } amount)
        {
            useMax = false;
            shareUsed = null;
            SetAmountText(amount);
        }
        return true;
    }

    private void PayFromPersonalWallet()
    {
        // Handed over in memory, so the payment stays out of the address bar here too (spec 032, FR-007).
        PayHandoff.Set(new DigiByte.Wallet.Services.PaymentLinkData(PrefillAddress!, PrefillAmount, null, null));
        Nav.NavigateTo(ScanRouter.SendPagePath(null, Link.GetValueOrDefault() + 1));
    }

    // What the Contacts button lists, loaded once for every recipient field: this device's wallets first (the wallet that
    // owns this shared wallet included, so paying it back is one tap), then saved contacts. Only addresses valid on this
    // network are offered. Names shown next to addresses come only from here, never from a proposal (FR-011a).
    private List<Contact> contactList = [];

    private async Task LoadContactNames()
    {
        try
        {
            var all = await Contacts.GetAllWithWalletsAsync(WalletService);
            var activeId = WalletService.ActiveWallet?.Id;
            if (activeId is not null && WalletService.GetReceivingAddressForWallet(activeId) is { Length: > 0 } ownerAddress)
            {
                all.Insert(0, new Contact
                {
                    Id = $"wallet:{activeId}",
                    Name = WalletService.ActiveWallet!.Name,
                    Address = ownerAddress,
                    Notes = "My wallet",
                    IsWallet = true,
                    WalletColor = WalletService.ActiveWallet.Color,
                });
            }
            var network = MultisigService.ActiveNetwork;
            contactList = all
                .Where(c => !string.IsNullOrWhiteSpace(c.Address) && !string.IsNullOrWhiteSpace(c.Name)
                            && DigiByte.Crypto.Addresses.AddressValidator.IsValid(c.Address.Trim(), network)
                            && !string.Equals(c.Address.Trim(), config?.Address, StringComparison.OrdinalIgnoreCase))
                .GroupBy(c => c.Address.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .ToList();
            contactNames = contactList.ToDictionary(c => c.Address.Trim(), c => c.Name, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            contactList = [];
            contactNames = new(StringComparer.OrdinalIgnoreCase);
        }
        StateHasChanged();
    }

    private string? ContactNameFor(string address) => contactNames.TryGetValue(address.Trim(), out var name) ? name : null;

    private string RecipientsText(int count) =>
        count == 1 ? L.T("ms.send.batch.to_n.one", count) : L.T("ms.send.batch.to_n.other", count);

    private IReadOnlyList<ProposalRecipient> BatchLines() =>
        rows.Select((r, i) => new ProposalRecipient(r.Address.Trim(), i < batchAmounts.Count ? batchAmounts[i] : 0)).ToList();

    private void ToggleBatchMode()
    {
        batchMode = !batchMode;
        if (rows.Count < RecipientRows.MinRows)
            while (rows.Count < RecipientRows.MinRows) rows.Add(new());
        Recalculate();
    }

    private void OnRowsChanged() => Recalculate();

    private void OpenScannerForRow(int index)
    {
        scannerRowIndex = index;
        showScanner = true;
    }

    private async Task LoadPrice()
    {
        try { dgbPrice = await Blockchain.GetDgbPriceAsync(AppState.FiatCurrency); }
        catch { dgbPrice = 0; }
        StateHasChanged();
    }

    private async Task LoadUtxos()
    {
        utxosFailed = false;
        utxos = null;
        StateHasChanged();
        try
        {
            utxos = await MultisigService.GetSpendableUtxosAsync(config!);
        }
        catch { utxosFailed = true; }
        Recalculate();
        StateHasChanged();
    }

    private async Task OnQrScanned(string data)
    {
        showScanner = false;
        var row = scannerRowIndex;
        scannerRowIndex = -1;
        if (batchMode)
        {
            // Only the row whose Scan button was tapped is filled.
            if (rowsRef is not null && row >= 0) await rowsRef.ApplyScannedAsync(row, data);
            return;
        }
        if (recipient is not null) await recipient.ApplyScannedAsync(data);
    }

    private Task OnAddressChanged(string value)
    {
        destination = value;
        Recalculate();
        return Task.CompletedTask;
    }

    private Task OnPaymentLink(ScanResult link)
    {
        if (link.AmountDgb is { } amount && amount > 0)
        {
            useMax = false;
            shareUsed = null;
            SetAmountText(amount);
        }
        if (!string.IsNullOrWhiteSpace(link.Label) && string.IsNullOrWhiteSpace(memo))
            memo = link.Label;
        Recalculate();
        return Task.CompletedTask;
    }

    private void OnAmountInput(ChangeEventArgs e)
    {
        useMax = false;
        shareUsed = null;
        amountText = e.Value?.ToString() ?? "";
        amountPick = null;
        Recalculate();
    }

    private void OnMemoInput(ChangeEventArgs e)
    {
        memo = e.Value?.ToString();
        Recalculate();
    }

    private void SetFeeRate(int rate)
    {
        feeRate = rate;
        Recalculate();
    }

    private void OnCustomFee(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var rate) && rate >= 1) feeRate = rate;
        Recalculate();
    }

    private void ToggleMax()
    {
        useMax = !useMax;
        shareUsed = null;
        if (!useMax) amountText = "";
        Recalculate();
    }

    private void SetAmountShare(decimal share)
    {
        if (share == 1m)
        {
            useMax = true;
            shareUsed = null;
            Recalculate();
            return;
        }

        useMax = false;
        shareUsed = share;
        // A share of what can be sent after the fee, rounded down to a whole satoshi.
        var memoBytes = string.IsNullOrWhiteSpace(memo) ? 0 : System.Text.Encoding.UTF8.GetByteCount(memo);
        var max = MultisigSendHelper.EstimateSend(utxos ?? [], feeRate, 0, config!.RequiredSignatures, config.TotalSigners, config.AddressType, memoBytes, max: true);
        var sats = (long)Math.Floor(max.MaxSendableSatoshis * share);
        SetAmountText(sats / 100_000_000m);
        Recalculate();
    }

    private void Recalculate()
    {
        if (batchMode)
        {
            RecalculateBatch();
            return;
        }

        // Destination: only complain once something has been entered.
        destCheck = string.IsNullOrWhiteSpace(destination) ? null : MultisigSendHelper.ValidateDestination(destination, MultisigService.ActiveNetwork, config?.Address);
        destinationError = destCheck is { Ok: false } ? DestinationMessage(destCheck) : null;

        amountError = null;
        amountAmbiguity = null;
        estimate = null;
        if (config is null || utxos is null) return;

        var memoBytes = string.IsNullOrWhiteSpace(memo) ? 0 : System.Text.Encoding.UTF8.GetByteCount(memo);
        long amountSat = 0;
        if (!useMax)
        {
            if (string.IsNullOrWhiteSpace(amountText)) return;
            if (!ReadAmount(amountText, amountPick, out amountSat, out amountAmbiguity, out var parseError))
            {
                amountError = parseError;
                return;
            }
        }

        estimate = MultisigSendHelper.EstimateSend(utxos, feeRate, amountSat, config.RequiredSignatures, config.TotalSigners, config.AddressType, memoBytes, useMax);
        if (!estimate.Ok)
            amountError = EstimateMessage(estimate);
        else if (useMax)
            SetAmountText(estimate.AmountSatoshis / 100_000_000m);
    }

    // Checks every row (ValidateRecipients), then estimates the whole payment once every row is fine. A row's message
    // appears only once that row has something in the field it is about.
    private void RecalculateBatch()
    {
        batchError = null;
        estimate = null;
        batchRowsOk = false;
        batchAmounts = [];
        var parseErrors = new string?[rows.Count];
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            long sats = 0;
            row.Ambiguity = null;
            if (!string.IsNullOrWhiteSpace(row.AmountText)
                && !ReadAmount(row.AmountText, row.Pick, out sats, out var ambiguity, out parseErrors[i]))
            {
                sats = 0;
                row.Ambiguity = ambiguity;
            }
            batchAmounts.Add(sats);
        }

        var problems = MultisigSendHelper.ValidateRecipients(
            rows.Select((r, i) => (r.Address.Trim(), batchAmounts[i])).ToList(), MultisigService.ActiveNetwork, config?.Address);

        var allOk = true;
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var problem = problems[i];
            var hasAddress = !string.IsNullOrWhiteSpace(row.Address);
            var hasAmount = !string.IsNullOrWhiteSpace(row.AmountText);
            row.AddressError = hasAddress ? problem switch
            {
                RecipientProblem.WrongNetwork => L.T("ms.send.error.wrong_network"),
                RecipientProblem.InvalidAddress => L.T("ms.send.error.invalid_address"),
                RecipientProblem.Repeated => L.T("ms.send.batch.error.repeated"),
                RecipientProblem.OwnAddress => L.T("ms.send.batch.error.own_address"),
                _ => null,
            } : null;
            // The amount is checked on its own, so a row with an address problem still says when its amount is too small.
            row.AmountError = row.Ambiguity is not null ? null : parseErrors[i] ?? (!hasAmount ? null
                : batchAmounts[i] <= 0 ? L.T("ms.send.error.no_amount")
                : batchAmounts[i] < MultisigSendHelper.DustThresholdSatoshis ? L.T("ms.send.error.below_minimum", MultisigSendHelper.DustThresholdSatoshis / 100_000_000m)
                : null);
            if (problem is not null || parseErrors[i] is not null || row.Ambiguity is not null) allOk = false;
        }
        batchRowsOk = allOk;

        if (!allOk || config is null || utxos is null) return;

        var memoBytes = string.IsNullOrWhiteSpace(memo) ? 0 : System.Text.Encoding.UTF8.GetByteCount(memo);
        estimate = MultisigSendHelper.EstimateSend(utxos, feeRate, batchAmounts, config.RequiredSignatures, config.TotalSigners, config.AddressType, memoBytes);
        if (!estimate.Ok)
            batchError = estimate.Problem == SendProblem.OverSpendable
                ? L.T("ms.send.batch.short", MultisigFormat.Dgb(estimate.ShortfallSatoshis))
                : EstimateMessage(estimate);
    }

    private const decimal AmountMaxDgb = 21_000_000_000m;

    // Typed amounts are read like the main Send page's (spec 028, AmountEntry): a comma or a point is the decimal mark, and
    // "1.234" asks which was meant. A value the page filled in itself (a link, a share, Max), or one the person picked
    // after the question, is kept as long as the text is unchanged.
    private bool ReadAmount(string text, (string Text, decimal Value)? pick, out long satoshis, out AmountEntryResult? ambiguity, out string? error)
    {
        satoshis = 0;
        ambiguity = null;
        error = null;
        if (pick is { } p && p.Text == text)
        {
            satoshis = (long)(p.Value * 100_000_000m);
            return true;
        }

        var result = AmountEntry.Parse(text, 8, AmountMaxDgb);
        switch (result.Kind)
        {
            case AmountEntryKind.Value:
                satoshis = (long)(result.Amount!.Value * 100_000_000m);
                return true;
            case AmountEntryKind.Ambiguous:
                ambiguity = result;
                return false;
            case AmountEntryKind.Invalid:
                error = AmountEntryText.Error(L, result, 8, AmountMaxDgb);
                return false;
            default:
                return true;
        }
    }

    private void SetAmountText(decimal dgb)
    {
        amountText = dgb.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture);
        amountPick = (amountText, dgb);
    }

    private void PickAmount(decimal value)
    {
        amountPick = (amountText, value);
        Recalculate();
    }

    // The helper's reasons, worded in the chosen language (its Error text stays English for logs and exceptions).
    private string? DestinationMessage(DestinationCheck check) => check.Problem switch
    {
        DestinationProblem.Missing => L.T("ms.send.error.address_missing"),
        DestinationProblem.WrongNetwork => L.T("ms.send.error.wrong_network"),
        DestinationProblem.Invalid => L.T("ms.send.error.invalid_address"),
        _ => check.Error,
    };

    private string? EstimateMessage(SendEstimate e) => e.Problem switch
    {
        SendProblem.NoFunds => L.T("ms.send.error.no_funds"),
        SendProblem.FeeNotCovered => L.T("ms.send.error.fee_not_covered"),
        SendProblem.NoAmount => L.T("ms.send.error.no_amount"),
        SendProblem.BelowMinimum => L.T("ms.send.error.below_minimum", MultisigSendHelper.DustThresholdSatoshis / 100_000_000m),
        SendProblem.OverSpendable => L.T("ms.send.error.over_spendable", (e.SpendableSatoshis / 100_000_000m).ToString("N8")),
        _ => e.Error,
    };

    private void GoToReview()
    {
        Recalculate();
        if (!CanContinue) return;
        error = null;
        submissionToken = Guid.NewGuid().ToString("N");
        step = Step.Review;
    }

    private async Task Confirm()
    {
        if (isCreating || estimate is not { Ok: true }) return;   // a double tap acts once
        isCreating = true;
        error = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            if (batchMode)
            {
                var recipients = rows.Select((r, i) => (r.Address.Trim(), batchAmounts[i] / 100_000_000m)).ToList();
                created = await MultisigService.CreateSpendingPSBTAsync(config!, recipients, feeRate, memo, submissionToken);
            }
            else
            {
                var amountDgb = estimate.AmountSatoshis / 100_000_000m;
                created = await MultisigService.CreateSpendingPSBTAsync(
                    config!, destination.Trim(), amountDgb, feeRate, memo, submissionToken);
            }
            step = Step.Done;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task SignNow()
    {
        if (isSigning || created is null) return;
        isSigning = true;
        error = null;
        message = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var privateKey = WalletService.GetPrivateKeyForMultisig()
                ?? throw new InvalidOperationException(L.T("ms.pendingDetail.error.locked"));
            var key = new NBitcoin.Key(Convert.FromHexString(privateKey));
            created = await MultisigService.SignPendingTransactionAsync(created, key);
            message = created.HasEnoughSignatures
                ? L.T("ms.send.signed_ready")
                : L.T("ms.send.signed", created.SignatureCount, created.RequiredSignatures);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSigning = false;
        }
    }

    private async Task SharePsbt()
    {
        if (created is null) return;
        await Clipboard.CopyAsync(created.PsbtBase64, toast: false);
        message = L.T("ms.send.copied");
    }
}
