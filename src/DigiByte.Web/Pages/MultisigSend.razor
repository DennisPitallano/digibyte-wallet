@page "/multisig/{WalletId}/send"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject WalletService WalletService
@inject ClipboardService Clipboard
@inject IBlockchainService Blockchain
@inject AppState AppState
@inject NavigationManager Nav
@inject LocalizationService L
@inject ContactService Contacts
@inject PaymentHandoff PayHandoff

<PageTitle>@L.T("ms.send.page_title")</PageTitle>

<AuthGuard>
@if (isLoading)
{
    <div class="flex items-center justify-center py-12">
        <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
    </div>
}
else if (config == null)
{
    <MultisigAccessNotice State="access" />
    @* A scanned payment was meant to start here; when this shared wallet can't be opened, offer the personal wallet (FR-002a). *@
    @if (PrefillAddress is not null)
    {
        <div class="flex justify-center -mt-6 pb-8">
            <button type="button" class="btn-secondary btn-sm" data-testid="pay-from-personal" @onclick="PayFromPersonalWallet">@L.T("ms.send.pay_personal", ActiveWallet.WalletName)</button>
        </div>
    }
}
else
{
    <div class="flex flex-col gap-4">
        <PageHeader Title="@(step == Step.Done ? L.T("ms.send.created.title") : L.T("ms.send.title"))" BackLabel="@config.DisplayName" BackHref="@($"/multisig/{WalletId}")" />
        <div class="-mt-2"><SharedWalletContextLine Config="config" /></div>

        @if (step != Step.Done)
        {
            @* Multiple recipients toggle, like the Send page's (specs/029-multisig-multiple-recipients) *@
            <div class="flex items-center justify-between slide-up">
                <div class="flex items-center gap-1.5">
                    <button type="button" class="choice" aria-pressed="@(batchMode ? "true" : "false")" @onclick="ToggleBatchMode" data-testid="batch-toggle">
                        <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                        @L.T("send.batch.toggle")
                    </button>
                    <button type="button" @onclick="() => showBatchInfo = true"
                            class="w-6 h-6 rounded-full bg-slate-100 dark:bg-dgb-800 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-dgb-700 transition-all flex-shrink-0"
                            title="@L.T("send.batch.what_is")" aria-label="@L.T("send.batch.what_is")">
                        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                        </svg>
                    </button>
                </div>
                @if (batchMode)
                {
                    <span class="text-xs text-slate-400 dark:text-slate-500">@L.T("send.batch.count", rows.Count)</span>
                }
            </div>

            @if (batchMode)
            {
                <div class="slide-up-delay-1">
                    <RecipientRows @ref="rowsRef" Rows="rows" ContactList="contactList" RowsChanged="OnRowsChanged" OnScanRequested="OpenScannerForRow" />
                </div>
                @if (utxosFailed)
                {
                    <p class="flex items-center gap-1 text-xs text-amber-500">@L.T("ms.send.funds_failed") <button type="button" class="min-h-[32px] px-1 font-semibold text-dgb-500" @onclick="LoadUtxos">@L.T("ms.send.retry")</button></p>
                }
                else if (utxos is not null)
                {
                    <p class="text-xs text-slate-400 dark:text-slate-500">@L.T("send.available", (Spendable / 100_000_000m).ToString("N4")) · @L.T("send.minimum", MultisigSendHelper.DustThresholdSatoshis / 100_000_000m)</p>
                }
                @if (dgbPrice > 0 && estimate is { Ok: true, AmountSatoshis: > 0 })
                {
                    <p class="text-xs text-slate-400 dark:text-slate-500" data-testid="batch-fiat">
                        ~ @AppState.FiatSymbol@((estimate.AmountSatoshis / 100_000_000m * dgbPrice).ToString("N" + AppState.FiatDecimals)) @AppState.FiatCurrency
                        <span class="italic ml-1">@L.T("send.estimate_note")</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(batchError)) { <InlineError Message="@batchError" /> }
            }
            else
            {
            @* Recipient: type, paste, scan or pick a contact, like the Send page *@
            <div class="slide-up-delay-1">
                <RecipientInput @ref="recipient" Address="@destination" AddressChanged="OnAddressChanged" Error="@destinationError" ContactList="contactList"
                                IsOwnAddress="@(destCheck?.IsOwnAddress ?? false)" OnPaymentLink="OnPaymentLink"
                                OnScanRequested="() => showScanner = true" />
            </div>

            @* Amount *@
            <div class="flex flex-col gap-1.5 slide-up-delay-2">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider" for="ms-amount">@L.T("send.amount")</label>
                    @if (utxosFailed)
                    {
                        <span class="flex items-center gap-1 text-xs text-amber-500">@L.T("ms.send.funds_failed") <button type="button" class="min-h-[32px] px-1 font-semibold text-dgb-500" @onclick="LoadUtxos">@L.T("ms.send.retry")</button></span>
                    }
                    else if (utxos is null)
                    {
                        <span class="flex items-center gap-1.5 text-xs text-dgb-500">
                            <span>@L.T("send.available_label")</span>
                            <span class="inline-block w-16 h-3.5 skeleton rounded"></span>
                        </span>
                    }
                    else
                    {
                        <button type="button" @onclick="ToggleMax" class="min-h-[32px] text-xs font-semibold text-dgb-500 hover:text-dgb-400 transition-colors">
                            @L.T("send.available", (Spendable / 100_000_000m).ToString("N4"))
                        </button>
                    }
                </div>
                <div class="flex items-center bg-white dark:bg-dgb-900 border rounded-xl focus-within:ring-2 focus-within:ring-dgb-500/20 transition-all @(string.IsNullOrEmpty(amountError) ? "border-slate-200 dark:border-dgb-800 focus-within:border-dgb-500" : "border-red-400")">
                    <input id="ms-amount" type="text" inputmode="decimal" value="@amountText" @oninput="OnAmountInput" placeholder="0.00" autocomplete="off"
                           aria-invalid="@(!string.IsNullOrEmpty(amountError))"
                           class="flex-1 min-w-0 px-4 py-3 bg-transparent text-sm text-slate-900 dark:text-white outline-none" />
                    <span class="flex items-center mr-2 px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-dgb-800">
                        <span class="text-sm font-bold text-dgb-500">DGB</span>
                    </span>
                </div>
                @* Quick amounts: a share of what can be sent *@
                <div class="flex gap-2" role="group" aria-label="@L.T("send.quick_amounts")">
                    @foreach (var (label, share) in AmountShares)
                    {
                        var fraction = share;
                        <button type="button" class="choice flex-1" aria-pressed="@(IsShareActive(fraction) ? "true" : "false")"
                                @onclick="() => SetAmountShare(fraction)" disabled="@(utxos is null || Spendable <= 0)">@(fraction == 1m ? L.T("send.quick_max") : label)</button>
                    }
                </div>
                @if (dgbPrice > 0 && estimate is { AmountSatoshis: > 0 })
                {
                    <p class="text-xs text-slate-400 dark:text-slate-500">
                        ~ @AppState.FiatSymbol@((estimate.AmountSatoshis / 100_000_000m * dgbPrice).ToString("N" + AppState.FiatDecimals)) @AppState.FiatCurrency
                        <span class="italic ml-1">@L.T("send.estimate_note")</span>
                    </p>
                }
                <p class="text-xs text-slate-400 dark:text-slate-500">@L.T("send.minimum", MultisigSendHelper.DustThresholdSatoshis / 100_000_000m)</p>
                @if (amountAmbiguity is { Kind: AmountEntryKind.Ambiguous } ambiguous)
                {
                    <AmountAmbiguityChoice AsDecimal="ambiguous.AsDecimal!.Value" AsThousands="ambiguous.AsThousands!.Value" OnPicked="PickAmount" />
                }
                @if (!string.IsNullOrEmpty(amountError)) { <InlineError Message="@amountError" /> }
            </div>
            }

            @* Advanced mode: fee control, like the Send page *@
            @if (!AppState.IsSimpleMode)
            {
                <div class="flex flex-col gap-1.5 slide-up-delay-3">
                    <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("send.fee_rate")</label>
                    <div class="flex gap-2">
                        <button class="choice flex-1" aria-pressed="@(feeRate == 100 ? "true" : "false")" @onclick="() => SetFeeRate(100)">@L.T("send.fee_slow")</button>
                        <button class="choice flex-1" aria-pressed="@(feeRate == 200 ? "true" : "false")" @onclick="() => SetFeeRate(200)">@L.T("send.fee_normal")</button>
                        <button class="choice flex-1" aria-pressed="@(feeRate == 400 ? "true" : "false")" @onclick="() => SetFeeRate(400)">@L.T("send.fee_fast")</button>
                    </div>
                    <input type="number" inputmode="numeric" value="@feeRate" @onchange="OnCustomFee" min="1" placeholder="@L.T("send.fee_custom_placeholder")" aria-label="@L.T("ms.send.fee_custom_aria")"
                           class="input" />
                </div>
            }

            @* Memo *@
            <div class="flex flex-col gap-1.5 slide-up-delay-3">
                <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider" for="ms-memo">@L.T("send.memo")</label>
                <input id="ms-memo" type="text" value="@memo" @oninput="OnMemoInput" maxlength="80" placeholder="@L.T("send.memo_placeholder")"
                       class="input" />
            </div>

            @* Fee display *@
            <div class="flex flex-col gap-1.5 px-4 py-3 bg-slate-50 dark:bg-dgb-900/50 rounded-xl border border-slate-100 dark:border-dgb-800 slide-up-delay-4" aria-live="polite">
                @if (batchMode)
                {
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.batch.total_amount")</span>
                        <span class="text-xs text-slate-700 dark:text-slate-300 font-semibold tabular-nums">@(estimate is { Ok: true } ? MultisigFormat.Dgb(estimate.AmountSatoshis) + " DGB" : "—")</span>
                    </div>
                }
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.fee")</span>
                    <span class="text-xs text-slate-700 dark:text-slate-300 font-semibold tabular-nums">@(estimate is { Ok: true } ? "~" + MultisigFormat.Dgb(estimate.FeeSatoshis) + " DGB" : "—")</span>
                </div>
                @if (batchMode)
                {
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.batch.grand_total")</span>
                        <span class="text-xs text-slate-700 dark:text-slate-300 font-semibold tabular-nums">@(estimate is { Ok: true } ? MultisigFormat.Dgb(estimate.AmountSatoshis + estimate.FeeSatoshis) + " DGB" : "—")</span>
                    </div>
                }
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("ms.send.left")</span>
                    <span class="text-xs text-slate-700 dark:text-slate-300 font-semibold tabular-nums">@(estimate is { Ok: true } ? MultisigFormat.Dgb(estimate.RemainingSatoshis) + " DGB" : "—")</span>
                </div>
                @if (estimate is { Ok: true, ChangeSatoshis: 0 } && !useMax)
                {
                    <p class="text-[11px] text-slate-400 dark:text-slate-500">@L.T("ms.send.leftover_note")</p>
                }
            </div>

            <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl slide-up-delay-4">
                <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">@L.T("ms.send.needs.before") <b>@L.T("ms.send.of", config.RequiredSignatures, config.TotalSigners)</b> @L.T("ms.send.needs.after")</p>
            </div>

            <button class="btn-primary btn-sm slide-up-delay-5 w-full mt-2"
                    disabled="@(!CanContinue)" @onclick="GoToReview">
                <span>@L.T("send.review")</span>
            </button>
        }
        else if (created is not null)
        {
            @* Proposal created: the same card style as the Send confirmation *@
            <div class="flex flex-col items-center gap-2 pt-2 slide-up-delay-1">
                <div class="w-12 h-12 rounded-full bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                </div>
                <h3 class="block-title block-title-lg">@L.T("ms.send.created.title")</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 text-center max-w-[260px]">@(created.RequiredSignatures == 1 ? L.T("ms.send.created.needs.one", created.RequiredSignatures) : L.T("ms.send.created.needs.other", created.RequiredSignatures))</p>
            </div>

            <div class="bg-slate-50 dark:bg-dgb-950 rounded-2xl p-4 flex flex-col gap-3 slide-up-delay-1">
                @if (created.RecipientCount > 1)
                {
                    <div class="flex justify-between items-center">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.to")</span>
                        <span class="text-xs font-semibold text-dgb-500">@RecipientsText(created.RecipientCount)</span>
                    </div>
                    <RecipientLines Lines="created.AllRecipients" NameFor="ContactNameFor" />
                }
                else
                {
                <div class="flex justify-between items-start">
                    <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.to")</span>
                    <p class="text-[11px] font-mono text-slate-900 dark:text-white max-w-[210px] text-right break-words leading-relaxed">@MultisigFormat.Chunk(created.DestinationAddress)</p>
                </div>
                }
                <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                <div class="flex justify-between">
                    <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.amount")</span>
                    <span class="text-sm font-bold text-slate-900 dark:text-white tabular-nums">@MultisigFormat.Dgb(created.AmountSatoshis) DGB</span>
                </div>
                <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                <div class="flex justify-between">
                    <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("ms.send.signatures")</span>
                    <span class="text-xs text-slate-600 dark:text-slate-300 tabular-nums">@L.T("ms.send.of", created.SignatureCount, created.RequiredSignatures)</span>
                </div>
            </div>

            @if (created.RecipientCount > 1)
            {
                <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl" data-testid="update-notice">
                    <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">@L.T("ms.send.batch.update_notice")</p>
                </div>
            }
            @if (!string.IsNullOrEmpty(message))
            {
                <p class="text-xs text-green-600 dark:text-green-400 font-medium text-center" role="status">@message</p>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <InlineError Message="@error" />
            }

            <div class="flex flex-col gap-2">
                @if (MultisigWalletService.NeedsMySignature(created, config))
                {
                    <button class="btn-primary btn-sm w-full" disabled="@isSigning" @onclick="SignNow">
                        @(isSigning ? L.T("ms.pendingDetail.sign.busy") : L.T("ms.send.sign_now"))
                    </button>
                }
                <button class="btn-secondary btn-sm w-full" @onclick="SharePsbt">
                    @L.T("ms.send.copy_share")
                </button>
                <button class="w-full min-h-[44px] py-2.5 text-sm font-semibold text-dgb-500" @onclick='() => Nav.NavigateTo(created is null ? $"/multisig/{WalletId}/pending" : $"/multisig/{WalletId}/pending/{Uri.EscapeDataString(created.Id)}")'>
                    @L.T("ms.send.open_payment")
                </button>
            </div>
        }
    </div>

    @* Confirm modal: same card as the Send page's "Confirm Send" *@
    @if (step == Step.Review && estimate is { Ok: true })
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="@L.T("ms.send.confirm.aria")" @onclick="() => { if (!isCreating) { step = Step.Form; error = null; } }">
            <div class="modal-card flex flex-col gap-5" @onclick:stopPropagation="true">
                <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                        <svg class="w-6 h-6 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                        </svg>
                    </div>
                    <h3 class="block-title block-title-lg">@L.T("ms.send.confirm.title")</h3>
                    <span class="text-xs font-semibold text-dgb-500 bg-dgb-50 dark:bg-dgb-900 px-2 py-0.5 rounded-md">@L.T("ms.send.confirm.signatures", config.RequiredSignatures, config.TotalSigners)</span>
                </div>

                <div class="bg-slate-50 dark:bg-dgb-950 rounded-2xl p-4 flex flex-col gap-3 @(batchMode ? "max-h-[45vh] overflow-y-auto" : "")">
                    @if (batchMode)
                    {
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.to")</span>
                            <span class="text-xs font-semibold text-dgb-500">@RecipientsText(rows.Count)</span>
                        </div>
                        <RecipientLines Lines="BatchLines()" NameFor="ContactNameFor" />
                        <p class="text-[11px] text-slate-400 dark:text-slate-500">@L.T("send.confirm.check_address")</p>
                    }
                    else
                    {
                    <div class="flex justify-between items-start">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.to")</span>
                        <div class="text-right">
                            <p class="text-xs font-mono font-medium text-slate-900 dark:text-white max-w-[210px] ml-auto break-words leading-relaxed" aria-label="@destination.Trim()">@MultisigFormat.Chunk(destination.Trim())</p>
                            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">@L.T("send.confirm.check_address")</p>
                        </div>
                    </div>
                    }
                    <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@(batchMode ? L.T("send.batch.total_amount") : L.T("send.amount"))</span>
                        <span class="text-sm font-bold text-slate-900 dark:text-white tabular-nums">@MultisigFormat.Dgb(estimate.AmountSatoshis) DGB</span>
                    </div>
                    <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.network_fee")</span>
                        <span class="text-xs text-slate-600 dark:text-slate-300 tabular-nums">~@MultisigFormat.Dgb(estimate.FeeSatoshis) DGB</span>
                    </div>
                    <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.total")</span>
                        <span class="text-xs text-slate-600 dark:text-slate-300 tabular-nums">@MultisigFormat.Dgb(estimate.AmountSatoshis + estimate.FeeSatoshis) DGB</span>
                    </div>
                    <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("ms.send.left")</span>
                        <span class="text-xs text-slate-600 dark:text-slate-300 tabular-nums">@MultisigFormat.Dgb(estimate.RemainingSatoshis) DGB</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(memo))
                    {
                        <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                        <div class="flex justify-between gap-3">
                            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("history.detail.memo")</span>
                            <span class="text-xs text-slate-600 dark:text-slate-300 text-right break-words">@memo</span>
                        </div>
                    }
                </div>

                @if (!batchMode && destCheck?.IsOwnAddress == true)
                {
                    <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl">
                        <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">@L.T("ms.send.own_address")</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(error))
                {
                    <InlineError Message="@error" Class="justify-center" />
                }

                <div class="flex gap-3">
                    <button class="btn-secondary btn-sm flex-1"
                            @onclick="() => { step = Step.Form; error = null; }" disabled="@isCreating">
                        @L.T("common.cancel")
                    </button>
                    <button class="btn-primary btn-sm flex-1"
                            @onclick="Confirm" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                            <span>@L.T("create.creating")</span>
                        }
                        else
                        {
                            <span>@L.T("ms.send.create")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}
