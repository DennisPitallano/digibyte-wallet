@page "/unlock"
@inject WalletService WalletService
@inject AppState AppState
@inject NavigationManager Nav
@inject MemoryCacheService Cache
@inject BiometricService Biometric
@inject LocalizationService L
@inject CommonPasswordList CommonList
@using DigiByte.Wallet.Storage

<PageTitle>Unlock Wallet</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[75vh] gap-8">
    <div class="flex flex-col items-center gap-3 float-in">
        <div class="relative">
            <div class="absolute inset-0 bg-dgb-500/15 rounded-full blur-2xl scale-150 glow-pulse"></div>
            <DigiLogo Size="72" Class="relative" />
        </div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Welcome back</h2>
        @if (!string.IsNullOrEmpty(walletName))
        {
            <div class="flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm">
                <span class="w-3 h-3 rounded-full flex-shrink-0 shadow-lg" style="background-color: @walletColor; box-shadow: 0 0 8px @(walletColor)66;"></span>
                <span class="text-base font-bold text-white tracking-wide">@walletName</span>
            </div>
        }
            <p class="text-sm text-slate-400 dark:text-slate-500">@(credKind == CredentialKind.Pin ? "Enter your 6-digit PIN" : L.T("unlock.passphrase_prompt"))</p>
        </div>

    @* Baku greets until the user starts typing, then steps aside (never covers the PIN field). *@
    @if (pin.Length == 0 && !showForgotPin && !isUnlocking)
    {
        <BakuMessage MessageId="unlock.greeting" Compact="true" Class="w-full max-w-[320px]" />
    }

    @if (deferredNote is not null)
    {
        <div class="w-full max-w-[320px] rounded-2xl border border-slate-500/30 bg-slate-500/10 p-4 text-center" data-testid="deferred-note">
            <p class="text-xs text-slate-600 dark:text-slate-300">@deferredNote</p>
            <button class="mt-3 px-4 py-2 rounded-xl bg-dgb-500 text-white text-sm font-semibold press-effect"
                    data-testid="deferred-note-ok" @onclick="DismissDeferredAsync">@L.T("biometric.weak.ok")</button>
        </div>
    }

    @if (showUpgradeNotice)
    {
        <div class="w-full max-w-[320px] rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-center" data-testid="upgrade-notice">
            <p class="text-sm font-bold text-slate-900 dark:text-white">@L.T("upgrade.notice.title")</p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2">@L.T("upgrade.notice.body")</p>
            <button class="mt-3 px-4 py-2 rounded-xl bg-dgb-500 text-white text-sm font-semibold press-effect"
                    data-testid="upgrade-notice-ok" @onclick="DismissUpgradeNoticeAsync">@L.T("upgrade.notice.ok")</button>
        </div>
    }

    @* Biometric unlock button *@
    @if (biometricEnabled)
    {
        <div class="flex flex-col items-center gap-2 slide-up-delay-1">
            <button class="w-16 h-16 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm flex items-center justify-center hover:bg-white/20 transition-all press-effect disabled:opacity-50"
                    @onclick="BiometricUnlockAsync" disabled="@isBiometricUnlocking">
                @if (isBiometricUnlocking)
                {
                    <svg class="animate-spin h-7 w-7 text-dgb-400" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                }
                else
                {
                    <svg class="w-7 h-7 text-dgb-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a48.667 48.667 0 0 0-1.418 8.773 7.498 7.498 0 0 1-1.332-5.023A7.5 7.5 0 0 1 7.864 4.243ZM14.25 14.25a2.25 2.25 0 0 0-4.5 0v.75a2.25 2.25 0 0 0 4.5 0v-.75Zm-2.25-6.75a4.5 4.5 0 0 0-4.5 4.5v.75a4.5 4.5 0 0 0 9 0v-.75a4.5 4.5 0 0 0-4.5-4.5Z" />
                    </svg>
                }
            </button>
            <p class="text-[10px] text-slate-500">Tap to use biometric</p>
        </div>

        <div class="flex items-center gap-3 w-full max-w-[280px]">
            <div class="flex-1 h-px bg-slate-300 dark:bg-dgb-800"></div>
            <span class="text-[10px] text-slate-400 dark:text-slate-500 uppercase tracking-widest">@L.T(credKind == CredentialKind.Pin ? "unlock.or_pin" : "unlock.or_passphrase")</span>
            <div class="flex-1 h-px bg-slate-300 dark:bg-dgb-800"></div>
        </div>
    }

    <div class="flex flex-col items-center gap-5 slide-up-delay-2">
        <CredentialInput @ref="pinInput" Kind="credKind"
                         ValueChanged="OnPinChanged"
                         OnSubmit="UnlockAsync"
                         Error="@error" />

        <button class="w-full max-w-[280px] py-3.5 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-2xl shadow-lg shadow-dgb-500/25 hover:shadow-xl hover:shadow-dgb-500/30 transition-all press-effect disabled:opacity-50"
                @onclick="UnlockAsync" disabled="@(isUnlocking || !Ready(pin, credKind))">
            @if (isUnlocking)
            {
                <span class="flex items-center justify-center gap-2">
                    <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Unlocking...
                </span>
            }
            else
            {
                <span>Unlock</span>
            }
        </button>
        @* Forgot PIN link *@
        <button class="text-xs text-slate-400 hover:text-dgb-500 font-medium mt-2 transition-colors"
                @onclick="() => showForgotPin = true">
            @(credKind == CredentialKind.Pin ? "Forgot PIN?" : L.T("unlock.forgot_passphrase"))
        </button>
    </div>

    @* Forgot PIN expanded section *@
    @if (showForgotPin)
    {
        <div class="w-full max-w-[340px] flex flex-col gap-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-2xl p-4 scale-in">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">Recovery Options</h3>
                <button class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-dgb-800 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors"
                        @onclick="CancelForgot">
                    <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (!showSeedInput && !showDeleteConfirm)
            {
                <button class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-dgb-950 hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors text-left"
                        @onclick="() => showSeedInput = true">
                    <div class="w-8 h-8 rounded-lg bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("unlock.reset_title", CredentialText.Word(L, credKind))</p>
                        <p class="text-[10px] text-slate-400">@L.T("unlock.reset_sub")</p>
                    </div>
                </button>

                <button class="flex items-center gap-3 p-3 rounded-xl bg-red-50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 transition-colors text-left"
                        @onclick="() => showDeleteConfirm = true">
                    <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-900/20 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-red-600 dark:text-red-400">Delete wallet & start over</p>
                        <p class="text-[10px] text-red-400 dark:text-red-500">This cannot be undone</p>
                    </div>
                </button>
            }

            @* Seed phrase input for PIN reset *@
            @if (showSeedInput)
            {
                <textarea @bind="seedInput" rows="3" placeholder="Enter your 24-word recovery phrase..."
                          autocomplete="off" spellcheck="false"
                          class="w-full px-3 py-2.5 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-xl text-xs text-slate-900 dark:text-white outline-none focus:border-dgb-500 resize-none leading-relaxed"></textarea>
                @if (resetError != null)
                {
                    <p class="text-xs text-red-500 font-medium">@resetError</p>
                }
                @if (showNewPin)
                {
                    <div class="flex justify-center gap-2" role="group" aria-label="@L.T("create.credential.choose")">
                        <button type="button" data-testid="reset-choose-pin"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold border-2 @(resetKind == CredentialKind.Pin ? "border-dgb-500 text-dgb-500" : "border-slate-200 dark:border-dgb-800 text-slate-500")"
                                @onclick="() => SelectResetKindAsync(CredentialKind.Pin)">@L.T("create.credential.pin")</button>
                        <button type="button" data-testid="reset-choose-passphrase"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold border-2 @(resetKind == CredentialKind.Passphrase ? "border-dgb-500 text-dgb-500" : "border-slate-200 dark:border-dgb-800 text-slate-500")"
                                @onclick="() => SelectResetKindAsync(CredentialKind.Passphrase)">@L.T("create.credential.passphrase")</button>
                    </div>
                    <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-center">@(resetKind == CredentialKind.Pin ? "New PIN" : L.T("recover.new_passphrase"))</p>
                    <CredentialInput @ref="resetPinInput" Kind="resetKind" IsNew="true" ValueChanged="(v) => newPin = v" OnSubmit="ConfirmResetPin" Error="@resetError" />
                }
                <div class="flex gap-2">
                    <button class="flex-1 py-2 bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect"
                            @onclick="CancelForgot">Cancel</button>
                    @if (!showNewPin)
                    {
                        <button class="flex-1 py-2 bg-dgb-500 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                                @onclick="VerifySeed" disabled="@string.IsNullOrWhiteSpace(seedInput)">Verify</button>
                    }
                </div>
            }

            @* Delete confirmation *@
            @if (showDeleteConfirm)
            {
                <div class="bg-red-50 dark:bg-red-900/10 rounded-xl p-3">
                    <p class="text-xs text-red-600 dark:text-red-400 font-medium leading-relaxed">
                        This will permanently delete your wallet and all data. If you don't have your recovery phrase, your funds will be lost forever.
                    </p>
                </div>
                <input type="text" @bind="deleteConfirmText" placeholder="Type DELETE to confirm"
                       class="w-full px-3 py-2.5 bg-slate-50 dark:bg-dgb-950 border border-red-300 dark:border-red-800 rounded-xl text-sm text-slate-900 dark:text-white outline-none text-center uppercase tracking-widest" />
                <div class="flex gap-2">
                    <button class="flex-1 py-2 bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect"
                            @onclick="CancelForgot">Cancel</button>
                    <button class="flex-1 py-2 bg-red-500 text-white text-sm font-semibold rounded-xl press-effect disabled:opacity-50"
                            @onclick="DeleteWallet" disabled="@(deleteConfirmText?.ToUpper() != "DELETE")">Delete Forever</button>
                </div>
            }
        </div>
    }
    @if (allWallets.Count > 1)
    {
        <div class="flex flex-col items-center gap-2 slide-up-delay-3">
            <p class="text-xs text-slate-400 dark:text-slate-500 font-medium">Or unlock a different wallet:</p>
            @foreach (var w in allWallets.Where(w => w.Id != walletId))
            {
                var wc = w.Color ?? "#0066FF";
                <button class="flex items-center gap-1.5 text-xs text-dgb-500 hover:text-dgb-600 font-semibold transition-colors"
                        @onclick="() => SwitchToWallet(w.Id, w.Name, w.Color)">
                    <span class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: @wc;"></span>
                    @w.Name
                    @if (WalletService.IsWalletUnlockedInSession(w.Id))
                    {
                        <span class="text-green-500 ml-1">(unlocked)</span>
                    }
                </button>
            }
        </div>
    }
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-slate-400 dark:text-slate-500 slide-up-delay-3">
        <a href="/help" class="hover:text-dgb-500 transition-colors">Help</a>
        <span>·</span>
        <a href="/about" class="hover:text-dgb-500 transition-colors">About</a>
        <span>·</span>
        <a href="/roadmap" class="hover:text-dgb-500 transition-colors">Roadmap</a>
        <span>·</span>
        <a href="/sponsors" class="font-semibold text-rose-500 hover:text-rose-400 transition-colors whitespace-nowrap"><span aria-hidden="true">♥</span> Sponsors</a>
        <span>·</span>
        <a href="/analytics" class="hover:text-dgb-500 transition-colors">Analytics</a>
        <span>·</span>
        <a href="/deployment" class="hover:text-dgb-500 transition-colors">Deployment</a>
    </div>

    <div class="flex flex-col items-center gap-1.5 slide-up-delay-3">
        <VersionBadge />
        <p class="text-[10px] text-slate-400 dark:text-slate-500">Speed · Security · Scalability</p>
    </div>
</div>

@if (bioNotice is { } noticeMode)
{
    <BiometricNotice Mode="noticeMode" Busy="bioNoticeBusy" Error="@bioNoticeError"
                     OnPrimary="BioNoticePrimaryAsync" OnSecondary="BioNoticeSecondaryAsync" />
}

@* Biometric enrollment prompt — shown after first successful PIN unlock *@
@if (showBioEnrollPrompt)
{
    <BiometricEnrollPrompt WalletId="@(walletId ?? "")"
                           WalletName="@walletName"
                           DecryptedSeed="@(lastDecryptedSeed ?? Array.Empty<byte>())"
                           OnEnrolled="OnBioEnrolled"
                           OnDismissed="OnBioDismissed" />
}

@code {
    /// <summary>
    /// After a successful unlock, go back to the page that asked for it (?returnUrl=/identity?uri=...), else Home.
    /// Only same-site relative paths are followed, so the parameter can't be used as an open redirect.
    /// </summary>
    private void GoAfterUnlock()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var target = query["returnUrl"];
        var isLocalPath = !string.IsNullOrEmpty(target)
            && target.StartsWith('/')
            && !target.StartsWith("//", StringComparison.Ordinal)
            && !target.StartsWith("/\\", StringComparison.Ordinal);
        Nav.NavigateTo(isLocalPath ? target! : "/");
    }

    private CredentialInput? pinInput;
    private CredentialKind credKind = CredentialKind.Pin;
    private CredentialKind resetKind = CredentialKind.Pin;

    private static bool Ready(string value, CredentialKind kind) =>
        kind == CredentialKind.Pin ? value.Length >= 6 : value.Length > 0;
    private string pin = "";
    private string? error;
    private bool isUnlocking;
    private string? walletId;

    // Brute-force protection (the same rule as PSBT signing)
    private readonly PinAttemptThrottle pinThrottle = new();

    // Forgot PIN state
    private bool showForgotPin;
    private bool showSeedInput;
    private bool showDeleteConfirm;
    private bool showNewPin;
    private string seedInput = "";
    private string newPin = "";
    private string? resetError;
    private string deleteConfirmText = "";
    private CredentialInput? resetPinInput;
    private string walletName = "";
    private string walletColor = "#0066FF";
    private List<WalletInfo> allWallets = [];

    // Biometric state
    private bool biometricSupported;
    private bool biometricEnabled;
    private bool isBiometricUnlocking;
    private bool showBioEnrollPrompt;
    private byte[]? lastDecryptedSeed;
    private bool biometricChecked;

    protected override async Task OnInitializedAsync()
    {
        pinThrottle.Localize = L.T;
        // Reset biometric check so it runs fresh each navigation
        biometricChecked = false;
        biometricEnabled = false;

        // Check for wallet-specific unlock via query param
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var requestedId = query["walletId"];

        allWallets = await WalletService.GetAllWalletsAsync();
        if (allWallets.Count == 0) { Nav.NavigateTo("/welcome"); return; }

        if (!string.IsNullOrEmpty(requestedId))
        {
            walletId = requestedId;
        }
        else
        {
            walletId = await WalletService.GetActiveWalletIdAsync();
        }

        if (walletId == null)
        {
            walletId = allWallets.First().Id;
        }

        var info = allWallets.FirstOrDefault(w => w.Id == walletId);
        walletName = info?.Name ?? "";
        credKind = info?.Kind ?? CredentialKind.Pin;
        walletColor = info?.Color ?? "#0066FF";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!biometricChecked)
        {
            biometricChecked = true;

            // JS interop must run after first render in Blazor WASM
            biometricSupported = await Biometric.IsSupportedAsync();
            if (biometricSupported)
            {
                biometricEnabled = await Biometric.IsEnabledAsync();
                // Also check this wallet has its seed enrolled
                if (biometricEnabled && walletId != null && !await Biometric.HasWalletSeedAsync(walletId))
                    biometricEnabled = false;
            }
            StateHasChanged();

            // Auto-trigger biometric if enrolled
            if (biometricEnabled && walletId != null)
            {
                await BiometricUnlockAsync();
            }
        }
    }

    private void OnPinChanged(string value) => pin = value;

    private async Task UnlockAsync()
    {
        if (walletId == null || !Ready(pin, credKind) || isUnlocking) return;

        // Check lockout
        if (pinThrottle.IsLockedOut)
        {
            error = pinThrottle.LockoutMessage;
            pin = "";
            pinInput?.Clear();
            return;
        }

        error = null; isUnlocking = true;
        StateHasChanged();
        try
        {
            WalletService.SetNetworkMode(AppState.NetworkMode);
            var success = await WalletService.UnlockWalletAsync(walletId, pin);
            if (success)
            {
                pinThrottle.RecordSuccess();

                // One-time notice after an automatic upgrade to the stronger protection (the old copy stays for 7 days).
                if (WalletService.TakeMigrationNotice(walletId))
                {
                    AppState.IsWalletCreated = true;
                    AppState.IsWalletUnlocked = true;
                    AppState.ActiveWalletName = walletName;
                    AppState.NotifyStateChanged();
                    showUpgradeNotice = true;
                    return;
                }

                // The automatic upgrade could not run on this device: say so calmly, once. The wallet works as before.
                var deferred = WalletService.TakeMigrationDeferred(walletId);
                if (deferred is not null)
                {
                    AppState.IsWalletCreated = true;
                    AppState.IsWalletUnlocked = true;
                    AppState.ActiveWalletName = walletName;
                    AppState.NotifyStateChanged();
                    deferredNote = CredentialText.MigrationDeferred(L, deferred.Value);
                    return;
                }

                await FinishUnlockAsync();
            }
            else
            {
                // Exponential backoff after 3 wrong attempts: 15s, 30s, 60s, 120s, ...
                // A problem that is not the user's mistake (out of memory, newer format) is explained and not counted.
                pinThrottle.Kind = credKind;
                var failure = WalletService.LastCredentialFailure;
                error = CredentialMessages.CountsAsAttempt(failure)
                    ? pinThrottle.RecordFailure()
                    : CredentialText.ForFailure(L, credKind, failure!.Value);
                pin = "";
                pinInput?.Clear();
            }
        }
        catch (Exception ex) { error = $"Error: {ex.Message}"; }
        finally { isUnlocking = false; }
    }

    private bool showUpgradeNotice;
    private string? deferredNote;

    private async Task DismissDeferredAsync()
    {
        deferredNote = null;
        await FinishUnlockAsync();
    }

    // One-time biometric notices (upgrade offer, plain notice)
    private BiometricNotice.NoticeMode? bioNotice;
    private bool bioNoticeBusy;
    private string? bioNoticeError;

    private void ShowBioNotice(BiometricNotice.NoticeMode mode)
    {
        AppState.IsWalletCreated = true;
        AppState.IsWalletUnlocked = true;
        AppState.ActiveWalletName = walletName;
        AppState.NotifyStateChanged();
        bioNoticeError = null;
        bioNotice = mode;
    }

    private async Task BioNoticePrimaryAsync()
    {
        if (bioNotice == BiometricNotice.NoticeMode.Upgrade)
        {
            bioNoticeBusy = true;
            bioNoticeError = null;
            StateHasChanged();
            try
            {
                var outcome = await Biometric.UpgradeAsync(walletName);
                if (outcome == BiometricUpgradeOutcome.Failed)
                {
                    bioNoticeError = L.T("biometric.upgrade.failed");
                    return;
                }
            }
            catch
            {
                bioNoticeError = L.T("biometric.upgrade.failed");
                return;
            }
            finally
            {
                bioNoticeBusy = false;
            }
        }
        else
        {
            await Biometric.AcknowledgeWeakWarningAsync();
        }

        bioNotice = null;
        await FinishUnlockAsync(); // may show the next notice
    }

    private async Task BioNoticeSecondaryAsync()
    {
        await Biometric.DeclineUpgradeAsync();
        bioNotice = null;
        await FinishUnlockAsync();
    }

    private async Task DismissUpgradeNoticeAsync()
    {
        showUpgradeNotice = false;
        await FinishUnlockAsync();
    }

    /// <summary>What follows a successful unlock: the biometric offer, then back to the page that asked.</summary>
    private async Task FinishUnlockAsync()
    {
        if (walletId == null) return;

        // An enrolment made before the key was tied to the device's own security: offer the one-time upgrade, then show the
        // one-time plain notice where the upgrade is not possible or was declined.
        if (await Biometric.NeedsUpgradePromptAsync())
        {
            ShowBioNotice(BiometricNotice.NoticeMode.Upgrade);
            return;
        }
        if (await Biometric.NeedsWeakWarningAsync())
        {
            ShowBioNotice(BiometricNotice.NoticeMode.Plain);
            return;
        }

        // Check if we should offer biometric enrollment
        // Re-check IsEnabledAsync directly to avoid race with OnAfterRenderAsync
        if (await Biometric.IsSupportedAsync() && !await Biometric.IsEnabledAsync() && !await Biometric.IsDismissedAsync())
        {
            lastDecryptedSeed = await WalletService.GetDecryptedSeedAsync(walletId, pin);
            if (lastDecryptedSeed != null)
            {
                showBioEnrollPrompt = true;
                // Don't navigate yet — wait for enrollment decision
                AppState.IsWalletCreated = true;
                AppState.IsWalletUnlocked = true;
                AppState.ActiveWalletName = walletName;
                AppState.NotifyStateChanged();
                return;
            }
        }

        // Auto-add this wallet's seed if biometric enabled but seed not yet enrolled
        if (await Biometric.IsEnabledAsync() && !await Biometric.HasWalletSeedAsync(walletId))
        {
            var seed = await WalletService.GetDecryptedSeedAsync(walletId, pin);
            if (seed != null)
                await Biometric.AddWalletSeedAsync(walletId, seed);
        }

        AppState.IsWalletCreated = true;
        AppState.IsWalletUnlocked = true;
        AppState.ActiveWalletName = walletName;
        AppState.NotifyStateChanged();
        GoAfterUnlock();
    }

    private async Task BiometricUnlockAsync()
    {
        if (walletId == null || isBiometricUnlocking) return;
        isBiometricUnlocking = true;
        error = null;
        StateHasChanged();

        try
        {
            WalletService.SetNetworkMode(AppState.NetworkMode);
            var seed = await Biometric.UnlockAsync(walletId);
            if (seed != null)
            {
                var success = await WalletService.UnlockWalletFromSeedAsync(walletId, seed);
                if (success)
                {
                    AppState.IsWalletCreated = true;
                    AppState.IsWalletUnlocked = true;
                    AppState.ActiveWalletName = walletName;
                    AppState.NotifyStateChanged();
                    GoAfterUnlock();
                    return;
                }
            }
            error = CredentialText.BiometricFailed(L, credKind);
        }
        catch
        {
            error = CredentialText.BiometricFailed(L, credKind);
        }
        finally
        {
            isBiometricUnlocking = false;
            StateHasChanged();
        }
    }

    private void OnBioEnrolled()
    {
        showBioEnrollPrompt = false;
        lastDecryptedSeed = null;
        GoAfterUnlock();
    }

    private void OnBioDismissed()
    {
        showBioEnrollPrompt = false;
        lastDecryptedSeed = null;
        GoAfterUnlock();
    }

    private void CancelForgot()
    {
        showForgotPin = false;
        showSeedInput = false;
        showDeleteConfirm = false;
        showNewPin = false;
        seedInput = "";
        newPin = "";
        resetError = null;
        deleteConfirmText = "";
    }

    private void VerifySeed()
    {
        resetError = null;
        if (string.IsNullOrWhiteSpace(seedInput)) { resetError = "Enter your recovery phrase."; return; }

        var cleaned = string.Join(' ', seedInput.Trim().ToLower().Split(' ', StringSplitOptions.RemoveEmptyEntries));
        if (!DigiByte.Crypto.KeyGeneration.MnemonicGenerator.IsValid(cleaned)
            && !DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.IsValidWif(seedInput.Trim()))
        {
            resetError = "Invalid recovery phrase or private key.";
            return;
        }

        showNewPin = true;
    }

    private async Task SelectResetKindAsync(CredentialKind kind)
    {
        if (kind == resetKind) return;
        resetKind = kind;
        newPin = "";
        resetError = null;
        resetPinInput?.Clear();
        if (kind == CredentialKind.Passphrase) await CommonList.EnsureLoadedAsync();
    }

    private async Task ConfirmResetPin()
    {
        if (walletId == null || !Ready(newPin, resetKind)) return;
        resetError = null;

        if (resetKind == CredentialKind.Passphrase)
        {
            var check = CredentialPolicy.Check(newPin, CommonList);
            if (!check.Accepted) { resetError = L.T(CredentialPolicy.ReasonKey(check.Reason)); return; }
        }

        var seed = seedInput.Trim();
        var success = await WalletService.ResetPinAsync(walletId, seed, newPin, resetKind);
        if (success)
        {
            credKind = resetKind;
            pinThrottle.Kind = credKind;
            // Auto-unlock with the new credential
            WalletService.SetNetworkMode(AppState.NetworkMode);
            var unlocked = await WalletService.UnlockWalletAsync(walletId, newPin);
            if (unlocked)
            {
                AppState.IsWalletCreated = true;
                AppState.IsWalletUnlocked = true;
                AppState.NotifyStateChanged();
                GoAfterUnlock();
            }
        }
        else
        {
            resetError = "Could not verify. Check your recovery phrase.";
            newPin = "";
            resetPinInput?.Clear();
        }
    }

    private async Task DeleteWallet()
    {
        if (deleteConfirmText?.ToUpper() != "DELETE") return;
        Cache.Clear();
        // Clean up biometric data
        await Biometric.DisableAsync();
        await WalletService.WipeAllDataAsync();
        AppState.IsWalletCreated = false;
        AppState.IsWalletUnlocked = false;
        Nav.NavigateTo("/welcome");
    }

    private async Task SwitchToWallet(string id, string name, string? color = null)
    {
        if (WalletService.IsWalletUnlockedInSession(id))
        {
            // Already unlocked — switch instantly
            await WalletService.SwitchWalletAsync(id);
            AppState.IsWalletCreated = true;
            AppState.IsWalletUnlocked = true;
            AppState.ActiveWalletName = name;
            AppState.NotifyStateChanged();
            GoAfterUnlock();
        }
        else
        {
            // Needs PIN — reload this page for the other wallet
            walletId = id;
            walletName = name;
            walletColor = color ?? "#0066FF";
            credKind = allWallets.FirstOrDefault(w => w.Id == id)?.Kind ?? CredentialKind.Pin;
            pin = "";
            error = null;
            pinThrottle.RecordSuccess(); // A different wallet starts with a clean count, as before.
            pinInput?.Clear();
            CancelForgot();

            // Refresh biometric state for the new wallet
            biometricEnabled = biometricSupported && await Biometric.IsEnabledAsync() && await Biometric.HasWalletSeedAsync(id);
            showBioEnrollPrompt = false;
            lastDecryptedSeed = null;

            StateHasChanged();
        }
    }
}
