@page "/recovery"
@inject NavigationManager Nav
@inject WalletService WalletService
@inject NotificationService Notify
@inject IJSRuntime JS
@inject SearchOfferCoordinator SearchOffer
@inject LocalizationService L
@inject AppState AppState
@implements IDisposable

<PageTitle>@L.T("recovery.page_title")</PageTitle>

<div class="flex flex-col gap-4">
    <PageHeader Title="@L.T("recovery.title")" BackHref="/settings"
                Subtitle="@L.T("recovery.subtitle")" />

    @* Active Wallet Info *@
    @if (WalletService.ActiveWallet is { } wallet)
    {
        var wColor = wallet.Color ?? "#0066FF";
        <div class="card slide-up-delay-1 flex items-center gap-3 p-3.5">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background-color: @wColor; color: white;">
                @if (wallet.WalletType == "xpub")
                {
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                }
                else if (wallet.WalletType == "privatekey")
                {
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                    </svg>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                    </svg>
                }
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@wallet.Name</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500">
                    @L.T("recovery.wallet.destination")
                    @if (wallet.WalletType == "xpub")
                    {
                        <span class="text-sky-500 ml-1">· @L.T("recovery.wallet.watch_only")</span>
                    }
                    else if (wallet.WalletType == "privatekey")
                    {
                        <span class="text-amber-500 ml-1">· WIF</span>
                    }
                </p>
            </div>
        </div>
    }

    @* Current Wallet — BIP44 legacy scan (HD wallets only) *@
    @if (isHdWallet)
    {
        <div class="card slide-up-delay-1 p-4">
            <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                </svg>
                <p class="text-sm font-semibold text-slate-900 dark:text-white">@L.T("recovery.legacy.title")</p>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-3">
                @L.T("recovery.legacy.intro")
            </p>

            @if (legacyScanComplete && legacyBalance > 0)
            {
                <div class="bg-green-50 dark:bg-green-900/10 rounded-xl p-3 border border-green-200 dark:border-green-900/30 mb-3">
                    <p class="text-sm font-semibold text-green-700 dark:text-green-300">
                        @FoundOn(legacyBalance, legacyResults.Count)
                    </p>
                    <div class="flex flex-col gap-1.5 mt-2">
                        @foreach (var addr in legacyResults)
                        {
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-1.5 min-w-0">
                                    <span class="text-[10px] font-medium px-1 py-0.5 rounded bg-slate-100 dark:bg-dgb-800 text-slate-500 dark:text-slate-400 flex-shrink-0">@addr.PathLabel</span>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">@addr.Address</p>
                                </div>
                                <span class="text-[11px] font-semibold text-green-600 dark:text-green-400 flex-shrink-0 tabular-nums">@((addr.BalanceSatoshis / 100_000_000m).ToString("N8"))</span>
                            </div>
                        }
                    </div>
                </div>
                <button class="w-full py-2.5 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-xl transition-all press-effect disabled:opacity-50 flex items-center justify-center gap-2"
                        @onclick="SweepLegacyFunds" disabled="@isLegacySweeping">
                    @if (isLegacySweeping)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>@L.T("recovery.sweeping")</span>
                    }
                    else
                    {
                        <span>@L.T("recovery.legacy.move")</span>
                    }
                </button>
                @if (isLegacySweeping)
                {
                    <p class="text-[11px] text-green-600 dark:text-green-400 mt-1.5 text-center">@L.T("recovery.broadcasting")</p>
                }
                @if (legacySweepError != null)
                {
                    <InlineError Message="@legacySweepError" />
                }
            }
            else if (legacyScanComplete && legacyBalance == 0)
            {
                <div class="bg-slate-50 dark:bg-dgb-800/30 rounded-xl p-3 text-center">
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("recovery.legacy.none")</p>
                    <button class="mt-2 text-[11px] text-dgb-500 hover:text-dgb-600 font-medium hover:underline" @onclick="ScanLegacyPaths">@L.T("recovery.scan_again")</button>
                </div>
            }
            else if (legacySweepTxId != null)
            {
                <div class="bg-green-50 dark:bg-green-900/10 rounded-xl p-3 border border-green-200 dark:border-green-900/30">
                    <div class="flex items-center gap-2 mb-1">
                        <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <p class="text-xs font-semibold text-green-700 dark:text-green-300">@L.T("recovery.legacy.moved")</p>
                    </div>
                    <p class="text-[11px] text-green-600 dark:text-green-400 font-mono break-all">@L.T("recovery.txid", legacySweepTxId)</p>
                    <button class="mt-2 text-[11px] text-dgb-500 hover:text-dgb-600 font-medium hover:underline" @onclick="ScanLegacyPaths">@L.T("recovery.scan_again")</button>
                </div>
            }
            else
            {
                <button class="btn-primary btn-sm w-full"
                        @onclick="ScanLegacyPaths" disabled="@isLegacyScanning">
                    @if (isLegacyScanning)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>@L.T("recovery.scanning", scanProgress)</span>
                    }
                    else
                    {
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                        </svg>
                        <span>@L.T("recovery.legacy.scan")</span>
                    }
                </button>
                @if (isLegacyScanning)
                {
                    <div class="mt-2">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[11px] text-slate-500 dark:text-slate-400">@(scanCurrentLabel ?? L.T("recovery.preparing"))</span>
                            <span class="text-[11px] font-semibold text-dgb-500">@scanProgress%</span>
                        </div>
                        <div class="w-full bg-slate-200 dark:bg-dgb-700 rounded-full h-1.5 overflow-hidden">
                            <div class="bg-dgb-500 h-1.5 rounded-full transition-all duration-300" style="width: @(scanProgress)%"></div>
                        </div>
                    </div>
                }
            }
            @if (legacyScanError != null)
            {
                <InlineError Message="@legacyScanError" />
            }
        </div>
    }

    @* Current Wallet — receive addresses past the normal search (seed and watch-only wallets) *@
    @if (hasDerivedAddresses)
    {
        <div id="receive-search" class="card slide-up-delay-1 p-4">
            <p class="text-sm font-semibold text-slate-900 dark:text-white mb-2">@L.T("recovery.missing.title")</p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-3">
                @L.T("recovery.missing.intro")
            </p>

            <label for="receive-search-upto" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">
                @L.T("recovery.receive_search.label")
            </label>
            <input id="receive-search-upto" data-testid="receive-search-upto" type="number" inputmode="numeric"
                   min="1" max="@WalletService.MaxReceiveSearch" step="1"
                   class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-dgb-700 bg-white dark:bg-dgb-900 text-sm text-slate-900 dark:text-white"
                   value="@receiveSearchInput" @oninput="OnReceiveSearchInput" disabled="@isReceiveScanning"
                   aria-describedby="receive-search-note" aria-invalid="@(ReceiveSearchUpTo is null ? "true" : "false")" />
            @if (ReceiveSearchUpTo is null)
            {
                <InlineError Message="@L.T("recovery.receive_search.range_error")" />
            }
            @if (WalletService.ReceiveSearchedTo > 0)
            {
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                    @L.T("recovery.receive_search.last_searched", Count(WalletService.ReceiveSearchedTo))
                </p>
            }
            @* Always on show, and it follows the field: the search asks the public block explorer about this many addresses. *@
            <p id="receive-search-note" data-testid="receive-search-explorer-note" class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 mb-3">
                @L.T("recovery.receive_search.explorer_note", Count(ReceiveSearchUpTo ?? WalletService.MaxReceiveSearch))
            </p>

            @if (receiveSearchMessage is not null)
            {
                <div data-testid="receive-search-result" role="status" class="mb-2">
                    @if (receiveSearchIsProblem)
                    {
                        <InlineError Message="@receiveSearchMessage" />
                    }
                    else
                    {
                        <div class="bg-slate-50 dark:bg-dgb-800/30 rounded-xl p-3 text-center">
                            <p class="text-xs text-slate-600 dark:text-slate-300">@receiveSearchMessage</p>
                        </div>
                    }
                    @if (receiveSearchAdded is not null)
                    {
                        @* A search that stopped or failed still keeps what it found: say so. *@
                        <p class="text-xs text-slate-600 dark:text-slate-300 mt-2">@receiveSearchAdded</p>
                    }
                    @if (receiveSearchResult is { ShowForeignIssuerNotice: true })
                    {
                        <p class="text-[11px] text-amber-700 dark:text-amber-400 mt-2">@L.T("recovery.receive_search.foreign_issuer_notice")</p>
                    }
                    @if (receiveSearchResult is { Outcome: ReceiveSearchOutcome.Finished, LeavesUnwatched: true })
                    {
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">@L.T("recovery.receive_search.leaves_unwatched")</p>
                    }
                    @if (receiveSearchResult is { SuggestSearchingFurther: true } near)
                    {
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">@L.T("recovery.receive_search.search_further_hint")</p>
                        <button type="button" class="btn-secondary btn-sm w-full mt-1" data-testid="receive-search-further"
                                @onclick="() => FillSearchFurther(near.RequestedUpTo)">
                            @L.T("recovery.receive_search.search_further_action")
                        </button>
                    }
                </div>
            }

            <button id="receive-search-start" data-testid="receive-search-start" class="btn-primary btn-sm w-full"
                    @onclick="SearchReceiveAddresses" disabled="@(isReceiveScanning || ReceiveSearchUpTo is null)">
                @if (isReceiveScanning)
                {
                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                }
                <span>@L.T("recovery.receive_search.start")</span>
            </button>
            @if (isReceiveScanning)
            {
                <button type="button" class="btn-secondary btn-sm w-full mt-2" data-testid="receive-search-cancel"
                        @onclick="CancelReceiveSearch" disabled="@(receiveSearchCancel?.IsCancellationRequested ?? true)">
                    @L.T("recovery.receive_search.cancel")
                </button>
            }
            @if (isReceiveScanning && receiveSearchProgress is { } running)
            {
                @* Not a live region: it changes every batch, some 250 times in a full search. The result is announced when it ends. *@
                <p data-testid="receive-search-progress" class="text-[11px] text-slate-500 dark:text-slate-400 mt-2 text-center">
                    @L.T("recovery.receive_search.progress", Count(running.CheckedUpTo), Count(running.RequestedUpTo), Count(running.FoundSoFar))
                </p>
            }
            @if (isReceiveScanning)
            {
                <p data-testid="receive-search-keep-open" class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 text-center">
                    @L.T("recovery.receive_search.keep_open")
                </p>
            }
        </div>
    }

    @* External Sweep Section *@
    <div class="@(isHdWallet ? "slide-up-delay-2" : "slide-up-delay-1")">
        @if (isHdWallet)
        {
            <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2 px-1">@L.T("recovery.external.heading")</p>
        }
    </div>

    @* Input Section *@
    <div class="@(isHdWallet ? "slide-up-delay-2" : "slide-up-delay-1") bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4">
        @* Input type tabs *@
        <div class="flex gap-2 mb-3">
            <button class="choice" aria-pressed="@(inputMode == InputMode.Mnemonic ? "true" : "false")"
                    @onclick="() => SwitchMode(InputMode.Mnemonic)">
                @L.T("recovery.mode.seed")
            </button>
            <button class="choice" aria-pressed="@(inputMode == InputMode.Wif ? "true" : "false")"
                    @onclick="() => SwitchMode(InputMode.Wif)">
                @L.T("recovery.mode.wif")
            </button>
        </div>

        @if (inputMode == InputMode.Mnemonic)
        {
            <textarea @bind="inputText" @bind:event="oninput" rows="3"
                      placeholder="@L.T("recovery.seed_placeholder")"
                      class="input resize-none font-mono"></textarea>
        }
        else
        {
            <input type="text" @bind="inputText" @bind:event="oninput"
                   placeholder="@L.T("recovery.wif_placeholder")"
                   class="input font-mono" />
        }

        <button class="btn-primary btn-sm w-full mt-3"
                @onclick="ScanForFunds" disabled="@(isScanning || string.IsNullOrWhiteSpace(inputText))">
            @if (isScanning)
            {
                <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                <span>@L.T("recovery.scanning", scanProgress)</span>
            }
            else
            {
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <span>@L.T("recovery.scan_funds")</span>
            }
        </button>

        @if (scanError != null)
        {
            <InlineError Message="@scanError" />
        }
    </div>

    @* Scan Progress *@
    @if (isScanning)
    {
        <div class="slide-up bg-slate-50 dark:bg-dgb-800/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                    <div class="w-5 h-5 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
                    <p class="text-xs font-medium text-slate-700 dark:text-slate-300">@(scanCurrentLabel ?? L.T("recovery.preparing"))</p>
                </div>
                <span class="text-xs font-semibold text-dgb-500">@scanProgress%</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-dgb-700 rounded-full h-1.5 overflow-hidden">
                <div class="bg-dgb-500 h-1.5 rounded-full transition-all duration-300" style="width: @(scanProgress)%"></div>
            </div>
        </div>
    }

    @* Results *@
    @if (scanComplete && discoveredAddresses.Count > 0)
    {
        <div class="slide-up bg-green-50 dark:bg-green-900/10 rounded-2xl border border-green-200 dark:border-green-800 p-4">
            <div class="flex items-center gap-2 mb-3">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <p class="text-sm font-semibold text-green-800 dark:text-green-300">
                    @FoundOn(totalDiscovered, discoveredAddresses.Count)
                </p>
            </div>

            @* Address list *@
            <div class="flex flex-col gap-2">
                @foreach (var addr in discoveredAddresses)
                {
                    <div class="bg-white dark:bg-dgb-900 rounded-xl p-3 border border-green-100 dark:border-green-900/30">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-medium px-1.5 py-0.5 rounded bg-slate-100 dark:bg-dgb-800 text-slate-500 dark:text-slate-400">@addr.PathLabel</span>
                            <span class="text-xs font-semibold text-green-600 dark:text-green-400 tabular-nums">@((addr.BalanceSatoshis / 100_000_000m).ToString("N8")) DGB</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 font-mono truncate">@addr.Address</p>
                    </div>
                }
            </div>

            @* Sweep button *@
            <button class="w-full mt-3 py-2.5 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-xl transition-all press-effect disabled:opacity-50 flex items-center justify-center gap-2"
                    @onclick="SweepFunds" disabled="@isSweeping">
                @if (isSweeping)
                {
                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    <span>@L.T("recovery.sweeping")</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                    </svg>
                    <span>@L.T("recovery.sweep_all")</span>
                }
            </button>
            @if (isSweeping)
            {
                <p class="text-[11px] text-green-600 dark:text-green-400 mt-1.5 text-center">@L.T("recovery.broadcasting")</p>
            }
            @if (sweepError != null)
            {
                <InlineError Message="@sweepError" />
            }
        </div>
    }
    else if (scanComplete && discoveredAddresses.Count == 0)
    {
        <div class="slide-up bg-slate-50 dark:bg-dgb-800/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4 text-center">
            <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
            </svg>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@L.T("recovery.none.title")</p>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">
                @if (inputMode == InputMode.Mnemonic)
                {
                    <span>@L.T("recovery.none.seed")</span>
                }
                else
                {
                    <span>@L.T("recovery.none.wif")</span>
                }
            </p>
        </div>
    }

    @* Sweep Success *@
    @if (sweepTxId != null)
    {
        <div class="slide-up bg-green-50 dark:bg-green-900/10 rounded-2xl border border-green-200 dark:border-green-800 p-4">
            <div class="flex items-center gap-2 mb-1">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <p class="text-sm font-semibold text-green-800 dark:text-green-300">@L.T("recovery.swept")</p>
            </div>
            <p class="text-[11px] text-green-600 dark:text-green-400 font-mono break-all">@L.T("recovery.txid", sweepTxId)</p>
        </div>
    }

    @* Info section *@
    <div class="slide-up-delay-2 bg-slate-50 dark:bg-dgb-800/30 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4">
        <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">@L.T("recovery.how.title")</p>
        <div class="flex flex-col gap-2 text-[11px] text-slate-500 dark:text-slate-400">
            <div class="flex gap-2">
                <span class="font-bold text-dgb-500">1.</span>
                <span>@L.T("recovery.how.step1")</span>
            </div>
            <div class="flex gap-2">
                <span class="font-bold text-dgb-500">2.</span>
                <span>@L.T("recovery.how.step2")</span>
            </div>
            <div class="flex gap-2">
                <span class="font-bold text-dgb-500">3.</span>
                <span>@L.T("recovery.how.step3")</span>
            </div>
        </div>
        <div class="mt-3 p-2.5 bg-amber-50 dark:bg-amber-900/10 rounded-lg border border-amber-200/50 dark:border-amber-900/20">
            <p class="text-[11px] text-amber-600 dark:text-amber-400">
                <strong>@L.T("recovery.security_note.label")</strong> @L.T("recovery.security_note.body")
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private enum InputMode { Mnemonic, Wif }

    /// <summary>"Found 1.5 DGB on 2 addresses", in the chosen language and its number style.</summary>
    private string FoundOn(long satoshis, int addresses) =>
        L.T(addresses == 1 ? "recovery.found.one" : "recovery.found.other", (satoshis / 100_000_000m).ToString("N8"), Count(addresses));

    private InputMode inputMode = InputMode.Mnemonic;
    private string? inputText;
    private bool isScanning;
    private bool scanComplete;
    private string? scanError;
    private List<RecoveryAddressInfo> discoveredAddresses = [];
    private long totalDiscovered;
    private bool isSweeping;
    private string? sweepError;
    private string? sweepTxId;
    private int scanProgress;
    private string? scanCurrentLabel;

    // Current wallet legacy scan state
    private bool isHdWallet;
    private bool isLegacyScanning;
    private bool legacyScanComplete;
    private string? legacyScanError;
    private long legacyBalance;
    private List<RecoveryAddressInfo> legacyResults = [];
    private bool isLegacySweeping;
    private string? legacySweepError;
    private string? legacySweepTxId;

    // Current wallet receive address search state
    private bool hasDerivedAddresses;
    private bool isReceiveScanning;
    private string receiveSearchInput = "";
    private ReceiveSearchResult? receiveSearchResult;
    private ReceiveSearchProgress? receiveSearchProgress;
    private string? receiveSearchMessage;
    private string? receiveSearchAdded;
    private CancellationTokenSource? receiveSearchCancel;
    private bool disposed;

    /// <summary>Asks the running search to stop. It stops between batches, within a few seconds.</summary>
    private void CancelReceiveSearch() => receiveSearchCancel?.Cancel();

    /// <summary>Leaving the page stops a running search (spec 027, FR-024). What it had found is already saved.</summary>
    public void Dispose()
    {
        disposed = true;
        receiveSearchCancel?.Cancel();
    }
    // A failed, refused or untrusted search is shown as a problem, never in the calm style of "nothing found".
    private bool receiveSearchIsProblem;

    /// <summary>The count in the field when it is a whole number from 1 to 5,000; otherwise null and the search cannot start.</summary>
    private int? ReceiveSearchUpTo =>
        int.TryParse(receiveSearchInput, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var n)
        && n >= 1 && n <= WalletService.MaxReceiveSearch ? n : null;

    private static string Count(int value) => value.ToString("N0");

    private void OnReceiveSearchInput(ChangeEventArgs e) => receiveSearchInput = e.Value?.ToString()?.Trim() ?? "";

    /// <summary>Puts a count 500 further on in the field. It does not start the search: the person decides (spec 027, FR-012a).</summary>
    private void FillSearchFurther(int from) =>
        receiveSearchInput = Math.Min(WalletService.MaxReceiveSearch, from + 500).ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>"receive" when the person came from Home's "search further" offer: the search card is brought into view (spec 027, FR-004).</summary>
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Search != "receive" || !hasDerivedAddresses) return;
        try
        {
            await JS.InvokeVoidAsync("domHelpers.scrollToElement", "receive-search");
            await JS.InvokeVoidAsync("domHelpers.focusElement", "receive-search-upto");
        }
        catch { /* The card is on the page either way. */ }
    }

    protected override void OnInitialized()
    {
        isHdWallet = WalletService.IsUnlocked
            && WalletService.ActiveWallet?.WalletType == "hd";
        hasDerivedAddresses = WalletService.IsUnlocked
            && WalletService.ActiveWallet?.WalletType is "hd" or "xpub";
        if (hasDerivedAddresses)
            receiveSearchInput = WalletService.DefaultReceiveSearchUpTo.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task SearchReceiveAddresses()
    {
        if (isReceiveScanning || ReceiveSearchUpTo is not { } upTo) return;
        isReceiveScanning = true;
        receiveSearchResult = null;
        receiveSearchProgress = null;
        receiveSearchMessage = null;
        receiveSearchAdded = null;
        receiveSearchIsProblem = false;
        receiveSearchCancel = new CancellationTokenSource();
        // The person started this and is watching it: the wallet must not lock for inactivity in the middle of it. A full
        // search takes minutes, and a lock ends it. Each batch counts as activity; the lock is back to normal when it ends.
        AppState.ResetLockTimer();
        StateHasChanged();

        var progress = new Progress<ReceiveSearchProgress>(update =>
        {
            receiveSearchProgress = update;
            if (disposed) return;
            AppState.ResetLockTimer();
            InvokeAsync(StateHasChanged);
        });

        // The wallet the search is for: the offer is answered for that one, whichever is active when it returns.
        var walletId = WalletService.ActiveWallet?.Id;
        try
        {
            var result = await WalletService.SearchReceiveAddressesAsync(upTo, progress, receiveSearchCancel.Token);
            receiveSearchResult = result;
            (receiveSearchMessage, receiveSearchIsProblem) = Describe(result);
            if (result.Outcome is ReceiveSearchOutcome.Cancelled or ReceiveSearchOutcome.Failed && result.AddedIndexes.Count > 0)
                receiveSearchAdded = FoundText(result);
            // Only a search that finished answers Home's offer: not one that failed, was refused or had nothing to check
            // (spec 027, FR-006).
            if (result.Outcome == ReceiveSearchOutcome.Finished)
                await SearchOffer.MarkSearchedAsync(walletId);
        }
        catch (Exception)
        {
            // A lookup failed part way. Say how far it got, and never that nothing was found.
            var covered = receiveSearchProgress?.CheckedUpTo ?? 0;
            receiveSearchMessage = covered > 0
                ? L.T("recovery.receive_search.failed", Count(covered))
                : L.T("recovery.receive_search.could_not_start");
            receiveSearchIsProblem = true;
        }
        finally
        {
            isReceiveScanning = false;
            if (!disposed) StateHasChanged();
        }
    }

    /// <summary>"Searched the first N addresses. M added (amount)."</summary>
    private string FoundText(ReceiveSearchResult result) => L.T("recovery.receive_search.finished_found",
        Count(result.ReachedUpTo), Count(result.AddedIndexes.Count),
        result.AddedSatoshis is { } satoshis
            ? $"{(satoshis / 100_000_000m).ToString("N8")} DGB"
            : L.T("recovery.receive_search.amount_unavailable"));

    /// <summary>What to say for each way a search can end. Extents are counts ("the first N addresses"), never an address index.</summary>
    private (string Message, bool IsProblem) Describe(ReceiveSearchResult result) => result.Outcome switch
    {
        ReceiveSearchOutcome.Finished when result.AddedIndexes.Count > 0 => (FoundText(result), false),
        ReceiveSearchOutcome.Finished => (L.T("recovery.receive_search.finished_none", Count(result.ReachedUpTo)), false),
        ReceiveSearchOutcome.NothingToCheck => (L.T("recovery.receive_search.nothing_to_check", Count(result.AlreadyCheckedUpTo)), false),
        ReceiveSearchOutcome.Untrusted => (L.T("recovery.receive_search.untrusted"), true),
        ReceiveSearchOutcome.Cancelled => (L.T("recovery.receive_search.cancelled", Count(result.ReachedUpTo)), true),
        _ => (result.ReachedUpTo > 0
            ? L.T("recovery.receive_search.failed", Count(result.ReachedUpTo))
            : L.T("recovery.receive_search.could_not_start"), true),
    };

    private void SwitchMode(InputMode mode)
    {
        inputMode = mode;
        inputText = null;
        scanComplete = false;
        scanError = null;
        discoveredAddresses = [];
        sweepTxId = null;
        sweepError = null;
    }

    private async Task ScanForFunds()
    {
        if (string.IsNullOrWhiteSpace(inputText)) return;

        isScanning = true;
        scanComplete = false;
        scanError = null;
        scanProgress = 0;
        scanCurrentLabel = null;
        discoveredAddresses = [];
        sweepTxId = null;
        sweepError = null;
        StateHasChanged();

        var progress = new Progress<int>(pct =>
        {
            scanProgress = pct;
            InvokeAsync(StateHasChanged);
        });

        void onLabel(string label)
        {
            scanCurrentLabel = label;
            InvokeAsync(StateHasChanged);
        }

        try
        {
            if (inputMode == InputMode.Mnemonic)
            {
                var words = inputText.Trim();
                if (!DigiByte.Crypto.KeyGeneration.MnemonicGenerator.IsValid(words))
                {
                    scanError = L.T("recovery.error.invalid_seed");
                    return;
                }
                discoveredAddresses = await WalletService.ScanExternalMnemonicAsync(words, progress, onLabel);
            }
            else
            {
                var wif = inputText.Trim();
                if (!DigiByte.Crypto.KeyGeneration.PrivateKeyImporter.IsValidWif(wif))
                {
                    scanError = L.T("recovery.error.invalid_wif");
                    return;
                }
                discoveredAddresses = await WalletService.ScanExternalWifAsync(wif, progress, onLabel);
            }

            totalDiscovered = discoveredAddresses.Sum(a => a.BalanceSatoshis);
            scanComplete = true;
        }
        catch (Exception ex)
        {
            scanError = ex.Message;
        }
        finally
        {
            isScanning = false;
            StateHasChanged();
        }
    }

    private async Task SweepFunds()
    {
        if (discoveredAddresses.Count == 0) return;

        isSweeping = true;
        sweepError = null;
        StateHasChanged();

        try
        {
            sweepTxId = await WalletService.SweepExternalFundsAsync(discoveredAddresses);
            discoveredAddresses = [];
            scanComplete = false;
            inputText = null;
            Notify.Success(L.T("recovery.toast.swept"));
        }
        catch (Exception ex)
        {
            sweepError = ex.Message;
        }
        finally
        {
            isSweeping = false;
            StateHasChanged();
        }
    }

    private async Task ScanLegacyPaths()
    {
        isLegacyScanning = true;
        legacyScanError = null;
        legacyScanComplete = false;
        scanProgress = 0;
        scanCurrentLabel = null;
        StateHasChanged();

        var progress = new Progress<int>(pct =>
        {
            scanProgress = pct;
            InvokeAsync(StateHasChanged);
        });

        void onLabel(string label)
        {
            scanCurrentLabel = label;
            InvokeAsync(StateHasChanged);
        }

        try
        {
            legacyResults = await WalletService.ScanCurrentWalletOldPathsAsync(progress, onLabel);
            legacyBalance = legacyResults.Sum(a => a.BalanceSatoshis);
            legacyScanComplete = true;
        }
        catch (Exception ex)
        {
            legacyScanError = ex.Message;
        }
        finally
        {
            isLegacyScanning = false;
            StateHasChanged();
        }
    }

    private async Task SweepLegacyFunds()
    {
        isLegacySweeping = true;
        legacySweepError = null;
        StateHasChanged();

        try
        {
            legacySweepTxId = await WalletService.SweepCurrentWalletOldPathsAsync(legacyResults);
            legacyBalance = 0;
            legacyResults = [];
            legacyScanComplete = false;
            Notify.Success(L.T("recovery.toast.moved"));
        }
        catch (Exception ex)
        {
            legacySweepError = ex.Message;
        }
        finally
        {
            isLegacySweeping = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Nav.NavigateTo("/settings");
}
