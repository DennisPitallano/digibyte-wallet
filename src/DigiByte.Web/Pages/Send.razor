    // Loading & price state
    private bool isLoadingBalance = true;
    private bool isLoadingPrice = true;
    private bool isFormDisabled => isLoadingBalance || isLoadingPrice;
    private decimal dgbPrice;
    private decimal amountDgb => isAmountInFiat ? (dgbPrice > 0 ? amount / dgbPrice : 0) : amount;
    private decimal amountFiat => isAmountInFiat ? amount : amount * dgbPrice;

    // The amount as typed (spec 028). `amount` holds the value it reads as, 0 when there is none yet.
    private const decimal AmountMaxDgb = 21_000_000_000m;
    private string amountText = "";
    private (string Text, decimal Value)? amountPick;
    private AmountEntryResult? amountEntry;
    private int AmountDecimals => isAmountInFiat ? 2 : 8;
    /// <summary>"0.00" or "0,00": the chosen language's decimal mark, like the amounts the wallet writes.</summary>
    private static string AmountPlaceholder => 0m.ToString("0.00", System.Globalization.CultureInfo.CurrentCulture);
    private decimal AmountMax => isAmountInFiat ? 1_000_000_000_000m : AmountMaxDgb;

    private void OnAmountInput(ChangeEventArgs e)
    {
        amountText = e.Value?.ToString() ?? "";
        amountPick = null; // any edit clears an earlier pick
        var result = AmountEntry.Parse(amountText, AmountDecimals, AmountMax);
        amount = result.Kind == AmountEntryKind.Value ? result.Amount!.Value : 0;
        amountEntry = result.Kind is AmountEntryKind.Ambiguous or AmountEntryKind.Invalid ? result : null;
        UpdateAmountWarning();
        RecalcFee();
    }

    private void PickAmount(decimal value)
    {
        amountPick = (amountText, value);
        amount = value;
        amountEntry = null;
        UpdateAmountWarning();
        RecalcFee();
    }

    /// <summary>
    /// An amount set by the wallet (a link, a scan, Max, a share, the unit toggle): written in the chosen style and
    /// recorded as already settled, so it never asks "which did you mean" until the person edits it (FR-013a).
    /// </summary>
    private void SetAmount(decimal value)
    {
        amount = value;
        var format = isAmountInFiat ? "0.##" : "0.########";
        amountText = value > 0 ? value.ToString(format, System.Globalization.CultureInfo.CurrentCulture) : "";
        amountPick = amountText.Length > 0 ? (amountText, value) : null;
        amountEntry = null;
    }

    private string? amountWarning;
    private bool hasUnconfirmedUtxos;
    private SpendingCheckResult? spendingCheck;

    private void UpdateAmountWarning()
    {
        var dgb = amountDgb;
        if (amount <= 0 || isFormDisabled)
            amountWarning = null;
        else if (dgb > 0 && dgb < 0.0001m)
            amountWarning = L.T("send.warn.below_minimum");
        else if (!isLoadingBalance && dgb > availableBalance)
            amountWarning = L.T("send.warn.exceeds_balance", availableBalance.ToString("N4"));
        else
            amountWarning = null;
    }

    private string FormatFiat(decimal value)
    {
        var decimals = AppState.FiatDecimals; // 0 for yen, rupiah, shillings and similar
        if (value == 0) return 0m.ToString("N" + decimals); // "0,00" in Spanish, never a hand-built "0.00"
        var abs = Math.Abs(value);
        if (abs >= 1m) return value.ToString("N" + decimals);
        if (abs >= 0.01m) return value.ToString("N4");
        if (abs >= 0.001m) return value.ToString("N5");
        if (abs >= 0.0001m) return value.ToString("N6");
        return value.ToString("N8");
    }

    private void ToggleAmountMode()
    {
        // Convert the current amount to the other unit
        var converted = amount <= 0 ? 0
            : isAmountInFiat ? Math.Round(amountDgb, 8)   // fiat -> DGB
            : Math.Round(amountFiat, 2);                  // DGB -> fiat
        isAmountInFiat = !isAmountInFiat;
        if (converted > 0) SetAmount(converted);
        else if (amountEntry is not null) OnAmountInput(new ChangeEventArgs { Value = amountText }); // re-check against the new unit
    }

    // Checked again here with the same rules as the address query; any note stays off the memo.
    private bool TryTakeHandoff()
    {
        if (PayHandoff.Take() is not { } link) return false;
        if (link.Address.Length <= 128 && DigiByte.Crypto.Addresses.AddressValidator.IsValid(link.Address))
        {
            destinationAddress = link.Address;
            if (link.AmountDgb is { } linkAmount && linkAmount > 0 && linkAmount < 21_000_000_000m)
            {
                isAmountInFiat = false; // a link's amount is in DGB
                SetAmount(linkAmount);
            }
        }
        return true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!new Uri(e.Location).AbsolutePath.Equals("/send", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(() =>
        {
            if (!TryTakeHandoff()) return;
            RecalcFee();
            StateHasChanged();
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        AppState.ResetLockTimer();

        // A payment link (opened on /pay, or pasted in the menu) hands its payment over in memory, never in the
        // address (spec 030, FR-021). A link that arrives while Send is open is taken in OnLocationChanged.
        Nav.LocationChanged += OnLocationChanged;
        if (!TryTakeHandoff())
        {
            // Parse query params immediately (no I/O) — with validation
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var qAddr = query["address"];
            if (qAddr != null && qAddr.Length <= 128 && DigiByte.Crypto.Addresses.AddressValidator.IsValid(qAddr))
                destinationAddress = qAddr;
            var qName = query["name"];
            if (qName != null && qName.Length <= 64)
                recipientName = qName;
            // A link amount is digits and one point only: "?amount=1,5" is left empty, never read as 15.
            if (query["amount"] != null && decimal.TryParse(query["amount"], System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out var qtyAmount) && qtyAmount > 0 && qtyAmount < 21_000_000_000m)
                SetAmount(qtyAmount);
        }

        // Detect wallet address type for fee estimation
        if (WalletService.IsUnlocked)
        {
            try
            {
                var addr = await WalletService.GetReceivingAddressAsync();
                walletUsesSegWit = addr.StartsWith("dgb1");
            }
            catch { walletUsesSegWit = true; }
        }
        RecalcFee();

        // The saved balance shows at once as the available amount (spec 023, FR-017); the fresh read below replaces it. It is
        // display only: balanceLoadedAt stays unset, so the send step reads the balance again, and the coins are always read fresh.
        if ((await Snapshots.LoadAsync(WalletService.ActiveWallet?.Id ?? "")).Balance is { } savedBalance)
        {
            availableBalance = savedBalance.AvailableDgb;
            isLoadingBalance = false;
        }

        // Run balance + contacts in parallel, then price only if we have a balance
        var contactsTask = ContactService.GetAllWithWalletsAsync(WalletService);
        var balanceTask = Task.Run(async () =>
        {
            try { var b = await WalletService.GetBalanceAsync(); availableBalance = b.AvailableDgb; balanceLoadedAt = DateTime.UtcNow; }
            catch { }
            finally { isLoadingBalance = false; await InvokeAsync(StateHasChanged); }
        });

        contactList = await contactsTask;
        await balanceTask;

        // Only fetch price if there's a balance to convert
        if (availableBalance > 0)
        {
            try
            {
                dgbPrice = await Cache.GetOrFetchAsync(
                    $"price:{AppState.FiatCurrency}",
                    () => Blockchain.GetDgbPriceAsync(AppState.FiatCurrency),
                    TimeSpan.FromMinutes(5));
            }
            catch { }
        }
        isLoadingPrice = false;
        StateHasChanged();
    }

