@page "/send"
@using DigiByte.Wallet.Services
@inject LocalizationService L
@inject WalletService WalletService
@inject ContactService ContactService
@inject IBlockchainService Blockchain
@inject AppState AppState
@inject NavigationManager Nav
@inject MemoryCacheService Cache
@inject ISecureStorage Storage
@inject DigiByte.Web.Services.WalletSnapshotCache Snapshots
@inject BiometricService Biometric
@inject SpendingLimitService SpendingLimit
@inject BakuService Baku
@inject NodeSourceStatusService NodeStatus
@inject IJSRuntime JS
@inject DigiByte.Web.Services.PaymentHandoff PayHandoff
@implements IDisposable

<PageTitle>@L.T("send.page_title")</PageTitle>

<AuthGuard>
<SendUnavailableNotice />
@if (WalletService.ActiveWallet?.WalletType == "xpub")
{
    <div class="flex flex-col items-center justify-center gap-4 py-12 text-center">
        <div class="w-16 h-16 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center">
            <svg class="w-8 h-8 text-sky-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
        </div>
        <h2 class="block-title block-title-lg">@L.T("send.watch_only.title")</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-[260px]">@L.T("send.watch_only.body")</p>
        <button class="btn-primary btn-sm"
                @onclick='() => Nav.NavigateTo("/")'>
            @L.T("send.watch_only.back")
        </button>
    </div>
}
else
{
<div class="flex flex-col gap-4">
    <PageHeader Title="@L.T("send.title")">
        @{ var sendWalletColor = WalletService.ActiveWallet?.Color ?? "#0066FF"; }
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <div class="w-2 h-2 rounded-full" style="background-color: @sendWalletColor;"></div>
            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[100px]">@(WalletService.ActiveWallet?.Name ?? L.T("nav.wallet"))</span>
        </div>
    </PageHeader>

    @* Batch Mode Toggle *@
    <div class="flex items-center justify-between slide-up">
        <div class="flex items-center gap-1.5">
            <button type="button" @onclick="ToggleBatchMode"
                    class="choice" aria-pressed="@(isBatchMode ? "true" : "false")">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
                @L.T("send.batch.toggle")
            </button>
            <button type="button" @onclick="() => showBatchInfo = true"
                    class="w-6 h-6 rounded-full bg-slate-100 dark:bg-dgb-800 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-dgb-700 transition-all flex-shrink-0"
                    title="@L.T("send.batch.what_is")" aria-label="@L.T("send.batch.what_is")">
                <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
            </button>
        </div>
        @if (isBatchMode)
        {
            <span class="text-xs text-slate-400 dark:text-slate-500">@L.T("send.batch.count", batchRecipients.Count)</span>
        }
    </div>

    @if (isBatchMode)
    {
        @* === BATCH MODE === *@
        <div class="flex flex-col gap-3 slide-up-delay-1">
            @for (int i = 0; i < batchRecipients.Count; i++)
            {
                var index = i;
                var r = batchRecipients[index];
                <div class="bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl p-3 flex flex-col gap-2 @(index > 0 ? "slide-up" : "")">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("send.batch.recipient_n", index + 1)</span>
                        @if (batchRecipients.Count > 2)
                        {
                            <button type="button" @onclick="() => RemoveBatchRecipient(index)"
                                    class="text-slate-400 hover:text-red-500 transition-colors p-0.5" title="@L.T("send.batch.remove")" aria-label="@L.T("send.batch.remove")">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        }
                    </div>
                    <div class="flex gap-1.5">
                        <input type="text" value="@r.Address" @oninput="(e) => OnBatchAddressChanged(index, e)"
                               placeholder="@L.T("send.address_placeholder")"
                               autocomplete="off" spellcheck="false"
                               class="input flex-1" />
                        <button type="button" @onclick="() => ShowBatchScanner(index)"
                                class="icon-btn icon-btn-primary icon-btn-sm flex-shrink-0"
                                title="@L.T("send.scan_qr")" aria-label="@L.T("send.scan_qr")">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 14.625v2.625m3.375-2.625v2.625" />
                            </svg>
                        </button>
                        <button type="button" @onclick="() => ShowBatchContactPicker(index)"
                                class="icon-btn icon-btn-sm flex-shrink-0"
                                title="@L.T("send.pick_contact")" aria-label="@L.T("send.pick_contact")">
                            <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0" />
                            </svg>
                        </button>
                    </div>
                    @if (batchContactPickerIndex == index && contactList.Count > 0)
                    {
                        <div class="scale-in bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-lg max-h-28 overflow-y-auto">
                            @foreach (var c in contactList)
                            {
                                var contact = c;
                                <button class="w-full flex items-center gap-2 px-2.5 py-1.5 hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors text-left"
                                        @onclick="() => SelectBatchContact(index, contact)">
                                    @if (contact.IsWallet)
                                    {
                                        <div class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: @(contact.WalletColor ?? "#0066FF")20;">
                                            <svg class="w-2.5 h-2.5" style="color: @(contact.WalletColor ?? "#0066FF");" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                                            </svg>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-5 h-5 rounded-full bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                                            <span class="text-[11px] font-bold text-dgb-600 dark:text-dgb-400">@contact.Name[..1].ToUpper()</span>
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        <p class="text-xs font-medium text-slate-900 dark:text-white truncate">@contact.Name</p>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(r.Name))
                    {
                        <div class="flex items-center gap-1.5">
                            <div class="w-4 h-4 rounded-full bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center">
                                <span class="text-[10px] font-bold text-dgb-600 dark:text-dgb-400">@r.Name[..1].ToUpper()</span>
                            </div>
                            <span class="text-[11px] font-medium text-dgb-600 dark:text-dgb-400">@r.Name</span>
                        </div>
                    }
                    <div class="flex items-center bg-slate-50 dark:bg-dgb-950 border border-slate-100 dark:border-dgb-800 rounded-lg">
                        <input type="text" inputmode="decimal" autocomplete="off" value="@r.AmountText" @oninput="(e) => OnBatchAmountChanged(index, e)"
                               placeholder="@AmountPlaceholder" aria-invalid="@(r.Entry is { Kind: AmountEntryKind.Invalid } ? "true" : "false")"
                               class="flex-1 px-3 py-2 bg-transparent text-xs text-slate-900 dark:text-white outline-none" />
                        <span class="text-xs font-bold text-dgb-500 pr-3">DGB</span>
                    </div>
                    @if (r.Entry is { Kind: AmountEntryKind.Ambiguous } rowAmbiguous)
                    {
                        <AmountAmbiguityChoice AsDecimal="rowAmbiguous.AsDecimal!.Value" AsThousands="rowAmbiguous.AsThousands!.Value"
                                               OnPicked="v => PickBatchAmount(index, v)" />
                    }
                    @if (r.Entry is { Kind: AmountEntryKind.Invalid } rowInvalid)
                    {
                        <InlineError Message="@AmountEntryText.Error(L, rowInvalid, 8, AmountMaxDgb)" />
                    }
                    @if (!string.IsNullOrEmpty(r.Error))
                    {
                        <InlineError Message="@r.Error" />
                    }
                </div>
            }

            @* Add Recipient button *@
            @if (batchRecipients.Count < 20)
            {
                <button type="button" @onclick="AddBatchRecipient"
                        class="w-full py-2.5 border-2 border-dashed border-slate-200 dark:border-dgb-800 rounded-xl text-xs font-semibold text-slate-400 dark:text-slate-500 hover:border-dgb-300 dark:hover:border-dgb-600 hover:text-dgb-500 transition-all">
                    @L.T("send.batch.add")
                </button>
            }

            @* Batch Summary *@
            <div class="bg-slate-50 dark:bg-dgb-900/50 rounded-xl border border-slate-100 dark:border-dgb-800 p-3 flex flex-col gap-1.5">
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.batch.total_amount")</span>
                    <span class="text-xs font-bold text-slate-900 dark:text-white tabular-nums">@BatchTotal.ToString("N8") DGB</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.fee")</span>
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 tabular-nums">~@estimatedFee.ToString("N4") DGB</span>
                </div>
                <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                <div class="flex justify-between">
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.batch.grand_total")</span>
                    <span class="text-xs font-bold text-dgb-500 tabular-nums">~@((BatchTotal + estimatedFee).ToString("N8")) DGB</span>
                </div>
                @if (!isLoadingBalance)
                {
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.batch.remaining")</span>
                        <span class="text-xs font-medium @(availableBalance - BatchTotal - estimatedFee < 0 ? "text-red-500" : "text-slate-600 dark:text-slate-300")">
                            @((availableBalance - BatchTotal - estimatedFee).ToString("N4")) DGB
                        </span>
                    </div>
                }
            </div>

            @if (batchError != null)
            {
                <InlineError Message="@batchError" Class="justify-center" />
            }
        </div>
    }
    else
    {
    <div class="flex flex-col gap-1.5 slide-up-delay-1">
        <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("send.recipient")</label>
            @if (string.IsNullOrEmpty(recipientName))
            {
                <button type="button" class="flex items-center gap-1 text-xs font-semibold text-dgb-500 hover:text-dgb-400 transition-colors disabled:opacity-50"
                        @onclick="PasteRecipientAsync" disabled="@isFormDisabled">
                    <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                    </svg>
                    @L.T("send.paste")
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(recipientName))
        {
            <div class="flex items-center gap-2 bg-dgb-50 dark:bg-dgb-900 border border-dgb-200 dark:border-dgb-700 rounded-xl px-3 py-2.5">
                <div class="w-7 h-7 rounded-full bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center">
                    <span class="text-xs font-bold text-dgb-600 dark:text-dgb-400">@recipientName[..1].ToUpper()</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-dgb-700 dark:text-dgb-300">@recipientName</p>
                    <p class="text-xs font-mono text-dgb-500/70 truncate">@destinationAddress</p>
                </div>
                <button class="text-dgb-400 hover:text-dgb-600 p-1" @onclick="ClearRecipient">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        }
        else
        {
            <div class="flex gap-1.5">
                <input type="text" @bind="destinationAddress" @bind:event="oninput" @bind:after="RecalcFee"
                       placeholder="@L.T("send.recipient_placeholder")"
                       autocomplete="off" spellcheck="false"
                       class="input flex-1" />
                <button class="icon-btn icon-btn-primary flex-shrink-0"
                        @onclick="() => showScanner = true" title="@L.T("send.scan_qr")" aria-label="@L.T("send.scan_qr")">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 14.625v2.625m3.375-2.625v2.625" />
                    </svg>
                </button>
                <button class="icon-btn flex-shrink-0"
                        @onclick="() => showContactPicker = !showContactPicker" title="@L.T("send.contacts")" aria-label="@L.T("send.contacts")">
                    <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                </button>
            </div>
            @* Contact Picker *@
            @if (showContactPicker && contactList.Count > 0)
            {
                <div class="scale-in bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl max-h-40 overflow-y-auto">
                    @foreach (var c in contactList)
                    {
                        var contact = c;
                        <button class="w-full flex items-center gap-2 px-3 py-2 hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors text-left"
                                @onclick="() => SelectContact(contact)">
                            @if (contact.IsWallet)
                            {
                                <div class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: @(contact.WalletColor ?? "#0066FF")20;">
                                    <svg class="w-3.5 h-3.5" style="color: @(contact.WalletColor ?? "#0066FF");" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                                    </svg>
                                </div>
                            }
                            else
                            {
                                <div class="w-7 h-7 rounded-full bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                                    <span class="text-xs font-bold text-dgb-600 dark:text-dgb-400">@contact.Name[..1].ToUpper()</span>
                                </div>
                            }
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-900 dark:text-white truncate">@contact.Name</p>
                                <p class="text-xs font-mono text-slate-400 truncate">@contact.Address</p>
                            </div>
                        </button>
                    }
                </div>
            }
        }
        @if (addressError != null) { <InlineError Message="@addressError" /> }
    </div>

    @* Amount *@
    <div class="flex flex-col gap-1.5 slide-up-delay-2">
        <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("send.amount")</label>
            @if (isLoadingBalance)
            {
                <span class="flex items-center gap-1.5 text-xs text-dgb-500">
                    <span>@L.T("send.available_label")</span>
                    <span class="inline-block w-16 h-3.5 skeleton rounded"></span>
                </span>
            }
            else
            {
                <button type="button" @onclick="SetMaxAmount"
                        class="text-xs font-semibold text-dgb-500 hover:text-dgb-400 transition-colors">
                    @L.T("send.available", availableBalance.ToString("N4"))
                </button>
            }
        </div>
        <div class="flex items-center bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl focus-within:border-dgb-500 focus-within:ring-2 focus-within:ring-dgb-500/20 transition-all @(isFormDisabled ? "opacity-50" : "")">
            @* Text, not a number field: a number field drops or rewrites a comma depending on the browser (spec 028). *@
            <input type="text" inputmode="decimal" autocomplete="off" value="@amountText" @oninput="OnAmountInput" placeholder="@AmountPlaceholder"
                   aria-invalid="@(amountEntry is { Kind: AmountEntryKind.Invalid } ? "true" : "false")"
                   disabled="@isFormDisabled"
                   class="flex-1 px-4 py-3 bg-transparent text-sm text-slate-900 dark:text-white outline-none disabled:cursor-not-allowed" />
            <button type="button" @onclick="ToggleAmountMode" disabled="@isFormDisabled"
                    class="flex items-center gap-1 mr-2 px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-dgb-800 hover:bg-slate-200 dark:hover:bg-dgb-700 transition-colors press-effect disabled:cursor-not-allowed">
                <span class="text-sm font-bold text-dgb-500">@(isAmountInFiat ? AppState.FiatCurrency : "DGB")</span>
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                </svg>
            </button>
        </div>
        @* Quick amounts: a share of what is available *@
        <div class="flex gap-2" role="group" aria-label="@L.T("send.quick_amounts")">
            @foreach (var (label, share) in AmountShares)
            {
                var fraction = share;
                <button type="button" class="btn-secondary btn-sm flex-1"
                        @onclick="() => SetAmountShare(fraction)" disabled="@(isFormDisabled || isLoadingBalance || availableBalance <= 0)">@label</button>
            }
        </div>
        <p class="text-xs text-slate-400 dark:text-slate-500">
            @if (isLoadingPrice)
            {
                <span class="inline-block w-24 h-3.5 skeleton rounded align-middle"></span>
            }
            else if (isAmountInFiat)
            {
                <span>~ @amountDgb.ToString("N8") DGB</span>
            }
            else
            {
                <span>~ @AppState.FiatSymbol@FormatFiat(amountFiat) @AppState.FiatCurrency</span>
            }
            @if (amount > 0 && !isLoadingPrice)
            {
                <span class="italic ml-1">@L.T("send.estimate_note")</span>
            }
        </p>
        <p class="text-xs text-slate-400 dark:text-slate-500">@L.T("send.minimum", 0.0001m)</p>
        @if (amountEntry is { Kind: AmountEntryKind.Ambiguous } ambiguous)
        {
            <AmountAmbiguityChoice AsDecimal="ambiguous.AsDecimal!.Value" AsThousands="ambiguous.AsThousands!.Value"
                                   Unit="@(isAmountInFiat ? AppState.FiatCurrency : "DGB")" OnPicked="PickAmount" />
        }
        @if (amountEntry is { Kind: AmountEntryKind.Invalid } invalid) { <InlineError Message="@AmountEntryText.Error(L, invalid, AmountDecimals, AmountMax)" /> }
        @if (amountError != null) { <InlineError Message="@amountError" /> }
        @if (amountWarning != null) { <p class="text-xs text-amber-500 font-medium">@amountWarning</p> }
    </div>
    } @* end single-recipient mode *@

    @* Advanced Mode: Fee Control *@
    @if (!AppState.IsSimpleMode)
    {
        <div class="flex flex-col gap-1.5 slide-up-delay-3">
            <div class="flex items-center gap-1.5">
                <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("send.fee_rate")</label>
                <button type="button" @onclick="() => showFeeInfo = true" class="text-slate-400 hover:text-dgb-500 transition-colors" title="@L.T("send.what_is_this")" aria-label="@L.T("send.what_is_this")">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
                    </svg>
                </button>
            </div>
            <div class="flex gap-2">
                <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all @(feeLevel == "low" ? "bg-dgb-500 text-white" : "bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-400")"
                        @onclick="SetFeeLow" disabled="@isFormDisabled">@L.T("send.fee_slow")</button>
                <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all @(feeLevel == "med" ? "bg-dgb-500 text-white" : "bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-400")"
                        @onclick="SetFeeMed" disabled="@isFormDisabled">@L.T("send.fee_normal")</button>
                <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all @(feeLevel == "high" ? "bg-dgb-500 text-white" : "bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-400")"
                        @onclick="SetFeeHigh" disabled="@isFormDisabled">@L.T("send.fee_fast")</button>
            </div>
            <input type="number" inputmode="numeric" @bind="customFeeRate" min="1" placeholder="@L.T("send.fee_custom_placeholder")" disabled="@isFormDisabled"
                   class="input" />
        </div>
    }

    @* Memo *@
    <div class="flex flex-col gap-1.5 slide-up-delay-3">
        <label class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("send.memo")</label>
        <input type="text" @bind="memo" @bind:event="oninput" @bind:after="RecalcFee" placeholder="@L.T("send.memo_placeholder")" disabled="@isFormDisabled"
               class="input" />
    </div>

    @if (!isBatchMode)
    {
    @* Fee Display (single mode only — batch has its own summary) *@
    <div class="flex justify-between px-4 py-3 bg-slate-50 dark:bg-dgb-900/50 rounded-xl border border-slate-100 dark:border-dgb-800 slide-up-delay-4">
        <div class="flex items-center gap-1.5">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@L.T("send.fee")</span>
            @if (AppState.IsSimpleMode)
            {
                <button type="button" @onclick="() => showFeeInfo = true" class="text-slate-400 hover:text-dgb-500 transition-colors" title="@L.T("send.what_is_this")" aria-label="@L.T("send.what_is_this")">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
                    </svg>
                </button>
            }
        </div>
        <span class="text-xs text-slate-700 dark:text-slate-300 font-semibold tabular-nums">~@estimatedFee.ToString("N4") DGB</span>
    </div>
    }

    <button class="btn-primary slide-up-delay-5 w-full mt-2"
            @onclick="PreviewSend"
            disabled="@(isFormDisabled || isReviewing || (!isBatchMode && (string.IsNullOrWhiteSpace(destinationAddress) || amount <= 0)) || (isBatchMode && (batchRecipients.Count < 2 || BatchAmountsUnsettled)))">
        @if (isFormDisabled || isReviewing)
        {
            <span class="flex items-center justify-center gap-2">
                <span class="w-4 h-4 border-2 border-white/40 border-t-white rounded-full animate-spin"></span>
                @(isReviewing ? L.T("send.reviewing") : L.T("send.loading"))
            </span>
        }
        else
        {
            <span>@L.T("send.review")</span>
        }
    </button>

    @* Batch Info Modal *@
    @if (showBatchInfo)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onclick="() => showBatchInfo = false">
            <div class="modal-card flex flex-col gap-3 max-w-sm max-h-[80vh]" @onclick:stopPropagation="true">
                <div class="flex items-center gap-3 flex-shrink-0">
                    <div class="w-9 h-9 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4.5 h-4.5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                    </div>
                    <h3 class="block-title block-title-sm">@L.T("send.batch_info.title")</h3>
                </div>

                <div class="flex flex-col gap-2.5 text-xs text-slate-600 dark:text-slate-300 leading-relaxed overflow-y-auto overscroll-contain pr-1">
                    <p>@((MarkupString)L.T("send.batch_info.intro"))</p>

                    <div class="bg-green-50 dark:bg-green-900/10 rounded-xl p-2.5 border border-green-100 dark:border-green-900/20">
                        <p class="text-[11px] font-semibold text-green-600 dark:text-green-400 uppercase mb-1.5">@L.T("send.batch_info.advantages")</p>
                        <ul class="flex flex-col gap-0.5 text-[11px] text-slate-600 dark:text-slate-300">
                            <li><strong>@L.T("send.batch_info.fees_term")</strong> — @L.T("send.batch_info.fees_desc")</li>
                            <li><strong>@L.T("send.batch_info.faster_term")</strong> — @L.T("send.batch_info.faster_desc")</li>
                            <li><strong>@L.T("send.batch_info.clutter_term")</strong> — @L.T("send.batch_info.clutter_desc")</li>
                            <li><strong>@L.T("send.batch_info.utxo_term")</strong> — @L.T("send.batch_info.utxo_desc")</li>
                        </ul>
                    </div>

                    <div class="bg-amber-50 dark:bg-amber-900/10 rounded-xl p-2.5 border border-amber-100 dark:border-amber-900/20">
                        <p class="text-[11px] font-semibold text-amber-600 dark:text-amber-400 uppercase mb-1.5">@L.T("send.batch_info.know")</p>
                        <ul class="flex flex-col gap-0.5 text-[11px] text-slate-600 dark:text-slate-300">
                            <li><strong>@L.T("send.batch_info.all_term")</strong> — @L.T("send.batch_info.all_desc")</li>
                            <li><strong>@L.T("send.batch_info.privacy_term")</strong> — @L.T("send.batch_info.privacy_desc")</li>
                            <li><strong>@L.T("send.batch_info.max_term")</strong>, @L.T("send.batch_info.max_desc")</li>
                        </ul>
                    </div>

                    <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl p-2.5 border border-slate-100 dark:border-dgb-800">
                        <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase mb-1.5">@L.T("send.batch_info.scenarios")</p>
                        <ul class="flex flex-col gap-0.5 text-[11px] text-slate-600 dark:text-slate-300">
                            <li><strong>@L.T("send.batch_info.payroll_term")</strong> — @L.T("send.batch_info.payroll_desc")</li>
                            <li><strong>@L.T("send.batch_info.donations_term")</strong> — @L.T("send.batch_info.donations_desc")</li>
                            <li><strong>@L.T("send.batch_info.group_term")</strong> — @L.T("send.batch_info.group_desc")</li>
                            <li><strong>@L.T("send.batch_info.consolidation_term")</strong> — @L.T("send.batch_info.consolidation_desc")</li>
                        </ul>
                    </div>
                </div>

                <button class="btn-primary btn-sm w-full flex-shrink-0"
                        @onclick="() => showBatchInfo = false">@L.T("send.got_it")</button>
            </div>
        </div>
    }

    @* Fee Info Modal *@
    @if (showFeeInfo)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onclick="() => showFeeInfo = false">
            <div class="modal-card flex flex-col gap-4 max-w-sm" @onclick:stopPropagation="true">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                        </svg>
                    </div>
                    <h3 class="block-title">@L.T("send.fee_info.title")</h3>
                </div>

                <div class="flex flex-col gap-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    <p>@((MarkupString)L.T("send.fee_info.intro"))</p>

                    <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl p-3 border border-slate-100 dark:border-dgb-800">
                        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase mb-2">@L.T("send.fee_info.comparison")</p>
                        <div class="flex flex-col gap-1.5 text-xs">
                            <div class="flex justify-between"><span>@L.T("send.fee_info.bank_wire")</span><span class="font-semibold">$15 – $45</span></div>
                            <div class="flex justify-between"><span>@L.T("send.fee_info.paypal")</span><span class="font-semibold">1.5% – 3%</span></div>
                            <div class="flex justify-between"><span>@L.T("send.fee_info.western_union")</span><span class="font-semibold">$5 – $50</span></div>
                            <div class="flex justify-between text-dgb-500 font-semibold"><span>DigiByte</span><span>@L.T("send.fee_info.dgb_cost")</span></div>
                        </div>
                    </div>

                    <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl p-3 border border-slate-100 dark:border-dgb-800">
                        <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase mb-2">@L.T("send.fee_info.speed_options")</p>
                        <div class="flex flex-col gap-1.5 text-xs">
                            <div class="flex justify-between"><span>@L.T("send.fee_info.slow")</span><span>@L.T("send.fee_info.slow_desc")</span></div>
                            <div class="flex justify-between"><span>@L.T("send.fee_info.normal")</span><span>@L.T("send.fee_info.normal_desc")</span></div>
                            <div class="flex justify-between"><span>@L.T("send.fee_info.fast")</span><span>@L.T("send.fee_info.fast_desc")</span></div>
                        </div>
                    </div>

                    <p class="text-xs text-slate-400 dark:text-slate-500">@((MarkupString)L.T("send.fee_info.footer"))</p>
                </div>

                <button class="btn-primary btn-sm w-full"
                        @onclick="() => showFeeInfo = false">@L.T("send.got_it")</button>
            </div>
        </div>
    }

    @* Confirm Modal — centered card *@
    @if (showConfirm)
    {
        <div class="modal-overlay" role="dialog" aria-modal="true" @onclick="() => { if (!isSending) { showConfirm = false; sendError = null; } }">
            <div class="modal-card flex flex-col gap-5" @onclick:stopPropagation="true">
                @* Header *@
                <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                        <svg class="w-6 h-6 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                        </svg>
                    </div>
                    <h3 class="block-title block-title-lg">@(isBatchMode ? L.T("send.confirm.title_batch") : L.T("send.confirm.title"))</h3>
                    @if (isBatchMode)
                    {
                        <span class="text-xs font-semibold text-dgb-500 bg-dgb-50 dark:bg-dgb-900 px-2 py-0.5 rounded-md">@L.T("send.confirm.recipients", batchRecipients.Count)</span>
                    }
                </div>

                @* Details *@
                <div class="bg-slate-50 dark:bg-dgb-950 rounded-2xl p-4 flex flex-col gap-3 @(isBatchMode ? "max-h-48 overflow-y-auto" : "")">
                    @if (isBatchMode)
                    {
                        @foreach (var r in batchRecipients)
                        {
                            <div class="flex justify-between items-start">
                                <div class="min-w-0 flex-1">
                                    @if (!string.IsNullOrEmpty(r.Name))
                                    {
                                        <p class="text-xs font-semibold text-slate-900 dark:text-white">@r.Name</p>
                                        <p class="text-[11px] font-mono text-slate-400 truncate">@TruncateAddress(r.Address)</p>
                                    }
                                    else
                                    {
                                        <p class="text-[11px] font-mono font-medium text-slate-900 dark:text-white truncate">@TruncateAddress(r.Address)</p>
                                    }
                                </div>
                                <span class="text-xs font-bold text-slate-900 dark:text-white ml-2 flex-shrink-0 tabular-nums">@r.Amount.ToString("N8") DGB</span>
                            </div>
                            <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                        }
                        <div class="flex justify-between">
                            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.total")</span>
                            <span class="text-sm font-bold text-slate-900 dark:text-white tabular-nums">@BatchTotal.ToString("N8") DGB</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex justify-between items-start">
                            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.to")</span>
                            <div class="text-right">
                                @if (!string.IsNullOrEmpty(recipientName))
                                {
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@recipientName</p>
                                    <p class="text-[11px] font-mono text-slate-400 max-w-[210px] ml-auto break-words leading-relaxed" aria-label="@destinationAddress">@ChunkAddress(destinationAddress)</p>
                                }
                                else
                                {
                                    <p class="text-xs font-mono font-medium text-slate-900 dark:text-white max-w-[210px] ml-auto break-words leading-relaxed" aria-label="@destinationAddress">@ChunkAddress(destinationAddress)</p>
                                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">@L.T("send.confirm.check_address")</p>
                                }
                            </div>
                        </div>
                        <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                        <div class="flex justify-between">
                            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.amount")</span>
                            <span class="text-sm font-bold text-slate-900 dark:text-white tabular-nums">@amountDgb.ToString("N8") DGB</span>
                        </div>
                    }
                    <div class="h-px bg-slate-200 dark:bg-dgb-800"></div>
                    <div class="flex justify-between">
                        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium uppercase">@L.T("send.confirm.network_fee")</span>
                        <span class="text-xs text-slate-600 dark:text-slate-300 tabular-nums">~@estimatedFee.ToString("N4") DGB</span>
                    </div>
                </div>

                @if (hasUnconfirmedUtxos)
                {
                    <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl">
                        <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                        </svg>
                        <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">@L.T("send.confirm.unconfirmed")</p>
                    </div>
                }

                @if (spendingCheck is { Warning: true, Message: not null })
                {
                    <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/20 px-3 py-2 rounded-xl border border-amber-200 dark:border-amber-800/30">
                        <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                        </svg>
                        <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">@spendingCheck.Message</p>
                    </div>
                }

                @if (sendError != null)
                {
                    <InlineError Message="@sendError" Class="justify-center" />
                    <BakuMessage MessageId="send.error" Compact="true" />
                }

                @* Actions: sliding is the deliberate step for a send that cannot be undone (docs/UI_STYLE.md). *@
                <div class="flex flex-col gap-2">
                    <SlideToConfirm @ref="sendSlide" Label="@L.T("send.confirm.slide")" BusyLabel="@L.T("send.confirm.slide_busy")"
                                    ActionDescription="@ConfirmDescription" OnConfirmed="ConfirmSend" />
                    <button type="button" class="btn-ghost w-full"
                            @onclick="() => { showConfirm = false; sendError = null; }" disabled="@isSending">
                        @L.T("common.cancel")
                    </button>
                </div>
            </div>
        </div>
    }

    @* QR Scanner *@
    @* Success overlay *@
    @if (sentTxId != null)
    {
        <TxSuccessOverlay Amount="@(isBatchMode ? BatchTotal : amountDgb)" TxId="@sentTxId" RecipientCount="@(isBatchMode ? batchRecipients.Count : 1)" Note="@sentNote" />
    }

    <QrScannerModal IsOpen="@showScanner" OnScanned="OnQrScanned" OnClosed="() => showScanner = false" />
</div>
}
</AuthGuard>

@code {
    private string destinationAddress = "";
    private string recipientName = "";
    private decimal amount;
    private decimal availableBalance;
    private DateTime balanceLoadedAt = DateTime.MinValue;
    private static readonly TimeSpan BalanceFreshness = TimeSpan.FromSeconds(15);
    private string memo = "";
