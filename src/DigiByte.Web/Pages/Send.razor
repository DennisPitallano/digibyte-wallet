    // The share labels stay numbers; only "Max" is a word (spec 028).
    private (string Label, decimal Share)[] AmountShares => [("25%", 0.25m), ("50%", 0.5m), ("75%", 0.75m), (L.T("send.quick_max"), 1m)];

    private void SetAmountShare(decimal share)
    {
        if (share >= 1m) { SetMaxAmount(); }
        else
        {
            var dgb = Math.Floor(availableBalance * share * 100_000_000m) / 100_000_000m;
            SetAmount(isAmountInFiat ? Math.Round(dgb * dgbPrice, 2) : dgb);
        }
        UpdateAmountWarning();
        RecalcFee();
    }

    /// <summary>Fills the recipient from the clipboard: a plain address or a digibyte: payment link (which may carry an amount).</summary>
    private async Task PasteRecipientAsync()
    {
        addressError = null;
        string text;
        try { text = (await JS.InvokeAsync<string>("navigator.clipboard.readText"))?.Trim() ?? ""; }
        catch { addressError = L.T("send.error.clipboard_blocked"); return; }
        if (text.Length == 0) { addressError = L.T("send.error.clipboard_empty"); return; }
        if (text.Length > 512) { addressError = L.T("send.error.not_address"); return; }
        OnQrScanned(text);
    }

    /// <summary>The address in groups of four, so it can be compared group by group.</summary>
    private static string ChunkAddress(string addr) =>
        string.Join(" ", Enumerable.Range(0, (addr.Length + 3) / 4).Select(i => addr.Substring(i * 4, Math.Min(4, addr.Length - i * 4))));

    private void SetMaxAmount()
    {
        SetAmount(isAmountInFiat ? Math.Round(availableBalance * dgbPrice, 2) : availableBalance);
    }

    private void SetFeeLow() => SetFee("low", 100);
    private void SetFeeMed() => SetFee("med", 200);
    private void SetFeeHigh() => SetFee("high", 400);

    private void SetFee(string level, int rate)
    {
        feeLevel = level;
        customFeeRate = rate;
        RecalcFee();
    }

    private void OnQrScanned(string data)
    {
        showScanner = false;

        // Parse digibyte: URI or raw address
        var parsed = DigiByte.Wallet.Models.PaymentRequest.FromUri(data);
        var scannedAddress = parsed?.Address ?? data.Trim();
        var scannedAmount = parsed?.AmountDgb;
        var scannedMemo = parsed?.Message;

        if (isBatchMode && batchScannerIndex >= 0 && batchScannerIndex < batchRecipients.Count)
        {
            batchRecipients[batchScannerIndex].Address = scannedAddress;
            batchRecipients[batchScannerIndex].Name = "";
            batchRecipients[batchScannerIndex].Error = null;
            if (scannedAmount.HasValue)
                SetBatchAmount(batchRecipients[batchScannerIndex], scannedAmount.Value);
            batchScannerIndex = -1;
        }
        else
        {
            destinationAddress = scannedAddress;
            if (scannedAmount.HasValue)
            {
                isAmountInFiat = false; // a link's amount is in DGB
                SetAmount(scannedAmount.Value);
            }
            if (!string.IsNullOrEmpty(scannedMemo)) memo = scannedMemo ?? "";
        }

        RecalcFee();
        StateHasChanged();
    }

    private async Task PreviewSend()
    {
        addressError = null;
        hasUnconfirmedUtxos = false;
        spendingCheck = null;
        amountError = null;
        batchError = null;
        hasUnconfirmedUtxos = false;

        // Refresh balance if stale (best-effort; fall back to cached on failure)
        if (DateTime.UtcNow - balanceLoadedAt > BalanceFreshness)
        {
            try
            {
                var b = await WalletService.GetBalanceAsync();
                availableBalance = b.AvailableDgb;
                balanceLoadedAt = DateTime.UtcNow;
            }
            catch { /* keep cached value; node will reject if truly insufficient */ }
        }

        if (isBatchMode)
        {
            // Batch validation
            var ownAddresses = WalletService.GetAllAddresses();
            var seenAddresses = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            bool hasErrors = false;

            foreach (var r in batchRecipients)
            {
                r.Error = null;
                if (string.IsNullOrWhiteSpace(r.Address))
                {
                    r.Error = L.T("send.error.address_required");
                    hasErrors = true;
                }
                else if (!DigiByte.Crypto.Addresses.AddressValidator.IsValid(r.Address))
                {
                    r.Error = L.T("send.error.invalid_address");
                    hasErrors = true;
                }
                else if (!seenAddresses.Add(r.Address))
                {
                    r.Error = L.T("send.error.duplicate_address");
                    hasErrors = true;
                }
                else if (ownAddresses.Contains(r.Address.Trim()))
                {
                    r.Error = L.T("send.error.own_address_batch");
                    hasErrors = true;
                }

                if (r.Amount <= 0)
                {
                    r.Error = (r.Error ?? "") + " " + L.T("send.error.amount_zero_batch");
                    hasErrors = true;
                }
                else if (r.Amount < 0.0001m)
                {
                    r.Error = (r.Error ?? "") + " " + L.T("send.error.below_minimum_batch");
                    hasErrors = true;
                }
            }

            if (hasErrors) return;

            if (BatchTotal + estimatedFee > availableBalance)
            {
                batchError = L.T("send.error.batch_insufficient", (BatchTotal + estimatedFee).ToString("N4"), availableBalance.ToString("N4"));
                return;
            }
        }
        else
        {
        if (!DigiByte.Crypto.Addresses.AddressValidator.IsValid(destinationAddress))
        {
            addressError = L.T("send.error.invalid_address");
            return;
        }
        if (WalletService.GetAllAddresses().Contains(destinationAddress.Trim()))
        {
            addressError = L.T("send.error.own_address");
            return;
        }
        if (amountDgb <= 0)
        {
            amountError = L.T("send.error.amount_zero");
            return;
        }
        if (amountDgb < 0.0001m)
        {
            amountError = L.T("send.error.below_minimum");
            return;
        }
        if (amountDgb + estimatedFee > availableBalance)
        {
            amountError = amountDgb > availableBalance
                ? L.T("send.error.insufficient", availableBalance.ToString("N4"))
                : L.T("send.error.insufficient_with_fee", estimatedFee.ToString("N4"), availableBalance.ToString("N4"));
            return;
        }
        }

        isReviewing = true;
        StateHasChanged();
        await Task.Yield();

        // Check for unconfirmed UTXOs
        try
        {
            var addresses = WalletService.GetAllAddresses();
            var utxos = await Blockchain.GetUtxosAsync(addresses);
            hasUnconfirmedUtxos = utxos.Any(u => u.Confirmations == 0);
        }
        catch { }
        finally { isReviewing = false; }

        // Check spending limits
        try
        {
            var walletId = await WalletService.GetActiveWalletIdAsync();
            if (walletId != null)
            {
                var sendAmount = isBatchMode ? BatchTotal : amountDgb;
                spendingCheck = await SpendingLimit.CheckLimitAsync(walletId, sendAmount);
                if (spendingCheck is { Allowed: false })
                {
                    sendError = spendingCheck.Message;
                    return;
                }
            }
        }
        catch { spendingCheck = null; }

        // Baku, the guardian: warn about a new address or half the balance, but never block a confirmed send.
        if (!await GuardSendAsync()) return;

        showConfirm = true;
    }

    private async Task<bool> GuardSendAsync()
    {
        try
        {
            var contacts = (await ContactService.GetAllAsync()).Select(c => c.Address);
            var history = await WalletService.GetTransactionHistoryAsync(0, 500);
            var known = KnownAddressProvider.Build(contacts, KnownAddressProvider.SentAddresses(history));
            var risk = isBatchMode
                ? SendRiskEvaluator.EvaluateBatch(batchRecipients.Select(r => r.Address), BatchTotal, availableBalance, known)
                : SendRiskEvaluator.Evaluate(amountDgb, availableBalance, destinationAddress, known);
            return await Baku.ConfirmSendRiskAsync(risk);
        }
        catch
        {
            return true; // if the guardian cannot check (e.g. offline history), it never blocks a legitimate send
        }
    }

    private string? sentTxId;
    private string? sentNote;

    // The slide control on the confirm card. It locks after one confirmation; Reset() unlocks it when a send fails.
    private SlideToConfirm? sendSlide;

    // What the slide confirms, for screen readers.
    private string ConfirmDescription => isBatchMode
        ? L.T("send.confirm.describe_batch", BatchTotal.ToString("N8"), batchRecipients.Count)
        : L.T("send.confirm.describe", amountDgb.ToString("N8"), string.IsNullOrEmpty(recipientName) ? destinationAddress : recipientName);

    private async Task ConfirmSend()
    {
        sendError = null; isSending = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            // Biometric send confirmation (if enabled)
            if (await Biometric.IsConfirmSendEnabledAsync())
            {
                var verified = await Biometric.VerifyIdentityAsync();
                if (!verified)
                {
                    sendError = L.T("send.error.biometric");
                    isSending = false;
                    sendSlide?.Reset();
                    return;
                }
            }

            string txId;
            if (isBatchMode)
            {
                var recipients = batchRecipients
                    .Select(r => (r.Address, r.Amount))
                    .ToList();
                txId = await WalletService.SendBatchAsync(recipients, memo, customFeeRate);
            }
            else
            {
                txId = await WalletService.SendAsync(destinationAddress, amountDgb, memo, customFeeRate);
            }
            // Invalidate in-memory + IndexedDB caches after successful send (by wallet id: these were never removed before spec 023)
            Cache.RemoveByPrefix("price");
            await Snapshots.InvalidateAsync(WalletService.ActiveWallet?.Id);
            isSending = false;
            sentTxId = txId;
            // When the light-client gateway carried the send and no peer has confirmed it yet, say so; the wallet keeps watching.
            sentNote = Blockchain is FallbackBlockchainService { LastBroadcast.IsUnconfirmedByPeers: true }
                ? L.T("send.unconfirmed_by_peers")
                : null;
            showConfirm = false;
            StateHasChanged();
            // Show success briefly, then go home and trigger a fresh fetch
            await Task.Delay(1200);
            Nav.NavigateTo("/?refresh=1", forceLoad: false);
        }
        catch (Exception ex)
        {
            // With node use on and no source reachable, say so plainly instead of showing a raw network error.
            sendError = NodeStatus.View.Visible && NodeStatus.AllSourcesFailed
                ? L.T("send.unavailable")
                : MapSendError(ex.Message);
            isSending = false;
            sendSlide?.Reset();
        }
    }

    private string MapSendError(string message) => message switch
    {
        _ when message.Contains("too-long-mempool-chain", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.mempool_chain"),
        _ when message.Contains("insufficient fee", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.fee_too_low"),
        _ when message.Contains("dust", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.dust"),
        _ when message.Contains("txn-mempool-conflict", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.mempool_conflict"),
        _ when message.Contains("bad-txns-inputs-missingorspent", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.inputs_spent"),
        _ when message.Contains("Broadcast failed on all backends", StringComparison.OrdinalIgnoreCase)
              || message.Contains("503", StringComparison.OrdinalIgnoreCase)
              || message.Contains("Service Unavailable", StringComparison.OrdinalIgnoreCase)
              || message.Contains("net_http_message_not_success", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.servers_down"),
        _ when message.Contains("timed out", StringComparison.OrdinalIgnoreCase)
              || message.Contains("timeout", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.timeout"),
        _ when message.Contains("No such host", StringComparison.OrdinalIgnoreCase)
              || message.Contains("name resolution", StringComparison.OrdinalIgnoreCase)
              || message.Contains("network is unreachable", StringComparison.OrdinalIgnoreCase)
            => L.T("send.error.no_network"),
        _ => message
    };

    private static string TruncateAddress(string addr) => addr.Length <= 16 ? addr : $"{addr[..8]}...{addr[^8..]}";

    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }
}
