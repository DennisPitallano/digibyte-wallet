@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — DigiByte Wallet</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[70vh] text-center gap-5">
    <div class="relative float-in">
        <div class="absolute inset-0 bg-dgb-500/15 rounded-full blur-2xl scale-150" aria-hidden="true"></div>
        <DigiLogo Size="64" Class="relative" />
    </div>
    <div class="slide-up">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Page not found</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-[280px]">
            That link does not lead anywhere in the wallet. Your funds are not affected.
        </p>
    </div>
    <div class="flex flex-col gap-2 w-full max-w-[260px] slide-up">
        <a href="/" class="w-full py-3 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-2xl shadow-lg shadow-dgb-500/25 transition-all press-effect no-underline">
            Go to Wallet
        </a>
        <a href="/help" class="w-full py-3 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-2xl hover:bg-slate-50 dark:hover:bg-dgb-800 transition-all press-effect no-underline">
            Help Center
        </a>
    </div>
</div>
