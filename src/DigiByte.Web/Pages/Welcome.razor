@page "/welcome"
@inject NavigationManager Nav

<PageTitle>@(isAddWalletMode ? "Add Wallet" : "Welcome") — DigiByte Wallet</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[80vh] text-center gap-8">
    <div class="flex flex-col items-center gap-3 float-in">
        @if (isAddWalletMode)
        {
            <button type="button" class="back-btn self-start ml-4 mb-2"
                    @onclick="GoHome">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
                <span>Back to wallet</span>
            </button>
        }
        <div class="relative">
            <div class="absolute inset-0 bg-dgb-500/20 rounded-full blur-2xl scale-150 glow-pulse"></div>
            <div class="float">
                <DigiLogo Size="80" Class="relative drop-shadow-xl" />
            </div>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2">
            @if (isAddWalletMode)
            {
                <span>Add <span class="text-dgb-500">Wallet</span></span>
            }
            else
            {
                <span>Digi<span class="text-dgb-500">Byte</span></span>
            }
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 font-medium tracking-wide">
            @(isAddWalletMode ? "Create or import an additional wallet" : "Your money. Your keys. Your freedom.")
        </p>
    </div>

    @if (!isAddWalletMode)
    {
        <BakuMessage MessageId="welcome.greeting" Large="true" Class="w-full max-w-[320px] text-left" />
    }

    @* Shared button styles (docs/UI_STYLE.md): one primary action, the other two secondary. Each entrance animation is on
       a wrapper so it does not hold the button's own hover and press movement. *@
    <div class="flex flex-col gap-3 w-full max-w-[280px]">
        <div class="slide-up-delay-2">
            <button type="button" class="btn-primary w-full" @onclick="CreateWallet">
                Create New Wallet
            </button>
        </div>
        <div class="slide-up-delay-3">
            <button type="button" class="btn-secondary w-full" @onclick="RecoverWallet">
                Recover Existing Wallet
            </button>
        </div>
        <div class="slide-up-delay-3">
            <button type="button" class="btn-secondary w-full" @onclick="ImportXpub">
                Watch-Only (xpub)
            </button>
        </div>
    </div>

    @if (!isAddWalletMode)
    {
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-slate-400 dark:text-slate-500 slide-up-delay-3">
            <a href="/help" class="hover:text-dgb-500 transition-colors">Help</a>
            <span>·</span>
            <a href="/about" class="hover:text-dgb-500 transition-colors">About</a>
            <span>·</span>
            <a href="/roadmap" class="hover:text-dgb-500 transition-colors">Roadmap</a>
            <span>·</span>
            <a href="/sponsors" class="font-semibold text-rose-500 hover:text-rose-400 transition-colors whitespace-nowrap"><span aria-hidden="true">♥</span> Sponsors</a>
            <span>·</span>
            <a href="/analytics" class="hover:text-dgb-500 transition-colors">Analytics</a>
            <span>·</span>
            <a href="/deployment" class="hover:text-dgb-500 transition-colors">Deployment</a>
        </div>

        <div class="flex flex-col items-center gap-2 slide-up-delay-3">
            <VersionBadge />
            <p class="text-[11px] text-slate-400 dark:text-slate-500 tracking-wide">Speed · Security · Scalability</p>
        </div>
    }
</div>

@code {
    private bool isAddWalletMode;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        isAddWalletMode = uri.Query.Contains("addWallet=true");
    }

    private void GoHome() => Nav.NavigateTo("/");
    private void CreateWallet() => Nav.NavigateTo(isAddWalletMode ? "/create-wallet?addWallet=true" : "/create-wallet");
    private void RecoverWallet() => Nav.NavigateTo(isAddWalletMode ? "/recover-wallet?addWallet=true" : "/recover-wallet");
    private void ImportXpub() => Nav.NavigateTo(isAddWalletMode ? "/import-xpub?addWallet=true" : "/import-xpub");
}
