@page "/transactions"
@inject WalletService WalletService
@inject ContactService ContactService
@inject IBlockchainService Blockchain
@inject MemoryCacheService Cache
@inject ISecureStorage Storage
@inject AddressLabelService LabelService
@inject AppState AppState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Activity — DigiByte Wallet</PageTitle>

<PullToRefresh OnRefresh="LoadAsync">
<div class="flex flex-col gap-3">
    <div class="slide-up">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Activity</h2>
        @if (!loading && !failed)
        {
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                @(shown.Count == all.Count ? $"{all.Count} in total" : $"{shown.Count} of {all.Count}")
            </p>
        }
    </div>

    @* This month at a glance *@
    @if (!loading && !failed && all.Count > 0)
    {
        var (monthIn, monthOut) = MonthTotals();
        <div class="grid grid-cols-2 gap-2" aria-label="This month">
            <div class="bg-white dark:bg-dgb-900/60 rounded-xl border border-slate-100 dark:border-dgb-800/40 px-3 py-2.5">
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Received this month</p>
                <p class="text-sm font-bold tabular-nums text-green-500 mt-0.5">@(hideAmounts ? "••••" : "+" + monthIn.ToString("N2")) <span class="text-[11px] font-semibold text-slate-400">DGB</span></p>
            </div>
            <div class="bg-white dark:bg-dgb-900/60 rounded-xl border border-slate-100 dark:border-dgb-800/40 px-3 py-2.5">
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Sent this month</p>
                <p class="text-sm font-bold tabular-nums text-red-500 mt-0.5">@(hideAmounts ? "••••" : "-" + monthOut.ToString("N2")) <span class="text-[11px] font-semibold text-slate-400">DGB</span></p>
            </div>
        </div>
    }

    @* Search: name, address, label, memo, transaction ID or amount *@
    <div class="flex items-center gap-2 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl px-3 focus-within:border-dgb-500 focus-within:ring-2 focus-within:ring-dgb-500/20 transition-all">
        <svg class="w-4 h-4 text-slate-400 flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <input type="search" value="@query" @oninput="OnQueryInput" placeholder="Search name, address, memo or amount"
               aria-label="Search transactions" autocomplete="off" spellcheck="false"
               class="flex-1 min-w-0 py-2.5 bg-transparent text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 outline-none" />
        @if (query.Length > 0)
        {
            <button type="button" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors" aria-label="Clear search" @onclick="ClearQuery">
                <svg class="w-4 h-4 text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>

    <div class="relative flex flex-wrap items-center gap-2">
        <div class="flex gap-2" role="tablist" aria-label="Filter transactions">
            @foreach (var (key, label) in Filters)
            {
                var selected = filter == key;
                <button role="tab" aria-selected="@selected"
                        class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors @(selected ? "bg-dgb-500 text-white" : "bg-white dark:bg-dgb-900 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-dgb-800")"
                        @onclick="() => SetFilter(key)">@label</button>
            }
        </div>

        @* Address filter: the wallet's own addresses that appear in the activity *@
        @if (usedAddresses.Count > 0)
        {
            <div class="flex items-center gap-1">
                <button type="button" aria-haspopup="listbox" aria-expanded="@showAddressPicker"
                        class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors max-w-[14rem] @(selectedAddress != null ? "bg-dgb-500 text-white" : "bg-white dark:bg-dgb-900 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-dgb-800")"
                        @onclick="() => showAddressPicker = !showAddressPicker">
                    <span class="truncate">@(SelectedAddressText ?? "Addresses")</span>
                    <svg class="w-3 h-3 flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                @if (selectedAddress != null)
                {
                    <button type="button" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors" aria-label="Clear address filter" @onclick="ClearAddress">
                        <svg class="w-4 h-4 text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
                @if (showAddressPicker)
                {
                    <div class="fixed inset-0 z-20" @onclick="() => showAddressPicker = false"></div>
                    <ul role="listbox" aria-label="Your addresses"
                        class="absolute left-0 right-0 top-full mt-1 z-30 max-h-72 overflow-y-auto thin-scrollbar bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl shadow-lg p-1">
                        @foreach (var used in usedAddresses)
                        {
                            var isSelected = selectedAddress != null && AddressKey.Normalize(selectedAddress) == used.Key;
                            <li role="option" aria-selected="@isSelected">
                                @if (editingKey == used.Key)
                                {
                                    @* Naming the address: Enter saves, Escape cancels; an empty name removes the label *@
                                    <div class="flex items-center gap-1 px-3 py-2">
                                        <input type="text" @ref="renameInput" @bind="editLabelText" @bind:event="oninput" maxlength="40"
                                               @onkeydown="e => OnRenameKey(e, used)"
                                               placeholder="Name, e.g. Donations" aria-label="Name for @ShortAddress(used.Address)"
                                               class="flex-1 min-w-0 px-2 py-1 text-xs bg-slate-50 dark:bg-dgb-800 border border-slate-200 dark:border-dgb-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 outline-none focus:ring-1 focus:ring-dgb-500/30" />
                                        <button type="button" class="p-1 text-green-500 press-effect" aria-label="Save name" @onclick="() => SaveRenameAsync(used)">
                                            <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                        </button>
                                        <button type="button" class="p-1 text-slate-400 press-effect" aria-label="Cancel" @onclick="CancelRename">
                                            <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center rounded-lg hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors @(isSelected ? "bg-dgb-50 dark:bg-dgb-800" : "")">
                                        <button type="button" class="flex-1 min-w-0 flex items-center justify-between gap-3 pl-3 pr-1 py-2 text-left"
                                                @onclick="() => SelectAddress(used.Address)">
                                            <span class="min-w-0">
                                                @if (!string.IsNullOrEmpty(used.Label))
                                                {
                                                    <span class="block text-xs font-semibold text-slate-900 dark:text-white truncate">@used.Label</span>
                                                }
                                                <span class="block text-[11px] font-mono text-slate-500 dark:text-slate-400 truncate">@ShortAddress(used.Address)</span>
                                            </span>
                                            <span class="text-[11px] tabular-nums text-slate-400 flex-shrink-0">@used.TransactionCount</span>
                                        </button>
                                        <button type="button" class="p-2 text-slate-400 hover:text-dgb-500 transition-colors flex-shrink-0" aria-label="@(string.IsNullOrEmpty(used.Label) ? "Name this address" : "Rename this address")" title="Name this address"
                                                @onclick="() => StartRename(used)">
                                            <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    @if (loading)
    {
        <div class="flex flex-col gap-1">
            @for (var i = 0; i < 6; i++)
            {
                <div class="h-[58px] rounded-xl skeleton"></div>
            }
        </div>
    }
    else if (failed)
    {
        <div class="bg-amber-50 dark:bg-amber-900/10 rounded-2xl border border-amber-200 dark:border-amber-900/30 p-5 text-center" role="alert">
            <p class="text-sm text-amber-800 dark:text-amber-300">Couldn't load your transactions. Check your connection and try again.</p>
            <button class="mt-3 px-4 py-2 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl press-effect transition-colors" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (shown.Count == 0)
    {
        <div class="bg-white dark:bg-dgb-900/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-6 text-center">
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                @(all.Count == 0 ? "No transactions yet" : query.Length > 0 ? $"Nothing matches \"{query}\"" : selectedAddress != null ? "No transactions match this address and filter" : "No transactions match this filter")
            </p>
            @if (all.Count > 0 && query.Length > 0)
            {
                <button class="mt-2 text-xs font-semibold text-dgb-500 hover:text-dgb-600" @onclick="ClearQuery">Clear search</button>
            }
            @if (all.Count > 0 && selectedAddress != null)
            {
                <button class="mt-2 ml-3 text-xs font-semibold text-dgb-500 hover:text-dgb-600" @onclick="ClearAddress">Clear address filter</button>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col gap-0.5">
            @foreach (var day in shown.Take(visibleCount).GroupBy(t => t.Timestamp.ToLocalTime().Date))
            {
                <h3 @key="day.Key" class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mt-2 mb-1 px-1">@DayLabel(day.Key)</h3>
                @foreach (var tx in day)
                {
                    <TransactionRow @key="tx.TxId" Tx="tx" OnOpen="OpenTx" Name="@NameFor(tx)" TimeOnly="true"
                                    WalletAddressText="@WalletAddressOf(tx).Primary" WalletAddressMore="WalletAddressOf(tx).MoreCount"
                                    FiatPrice="price" FiatSymbol="@AppState.FiatSymbol" FiatDecimals="AppState.FiatDecimals"
                                    HideAmounts="hideAmounts" />
                }
            }
        </div>
        @if (shown.Count > visibleCount)
        {
            <button class="self-center px-4 py-2 text-sm font-semibold text-dgb-600 dark:text-dgb-400 bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800 hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors"
                    @onclick="() => visibleCount += PageSize">
                Show more
            </button>
        }
    }
</div>
</PullToRefresh>

<TransactionDetailModal IsOpen="@(selected != null)" Tx="@selected"
    OnClosed="() => selected = null"
    OnAddContact="AddCounterpartyToContacts" />

@code {
    private const int PageSize = 50;
    private const int MaxLoaded = 1000;
    private static readonly (string Key, string Label)[] Filters = [("all", "All"), ("received", "Received"), ("sent", "Sent")];

    private List<TransactionRecord> all = [];
    private List<TransactionRecord> shown = [];
    private string filter = "all";
    private string query = "";
    private int visibleCount = PageSize;
    private bool loading = true;
    private bool failed;
    private TransactionRecord? selected;

    // Display extras; each is optional and the list works without them.
    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);
    private decimal price;
    private bool hideAmounts;

    // Labels of the wallet's own addresses (normalized address -> label), for the address line on each row.
    private IReadOnlyDictionary<string, string> walletAddressLabels = new Dictionary<string, string>();

    private (string? Primary, int MoreCount) WalletAddressOf(TransactionRecord tx) =>
        ActivityAddressIndex.Display(tx, walletAddressLabels);

    // Address filter: the wallet's own addresses that appear in the loaded activity, and the one chosen (null = all).
    private IReadOnlyList<UsedAddress> usedAddresses = [];
    private string? selectedAddress;
    private bool showAddressPicker;

    private string? SelectedAddressText =>
        selectedAddress is null ? null
        : usedAddresses.FirstOrDefault(u => u.Key == AddressKey.Normalize(selectedAddress)) is { } u && !string.IsNullOrEmpty(u.Label)
            ? u.Label
            : ShortAddress(selectedAddress);

    private static string ShortAddress(string address) =>
        address.Length > 22 ? $"{address[..10]}…{address[^6..]}" : address;

    private void RefreshUsedAddresses() =>
        usedAddresses = ActivityAddressIndex.Build(all, walletAddressLabels);

    private void SelectAddress(string address)
    {
        selectedAddress = address;
        showAddressPicker = false;
        visibleCount = PageSize;
        _ = SaveAddressPrefAsync(address);
        ApplyFilter();
    }

    private void ClearAddress()
    {
        selectedAddress = null;
        showAddressPicker = false;
        visibleCount = PageSize;
        _ = SaveAddressPrefAsync(null);
        ApplyFilter();
    }

    // The chosen address is remembered per wallet, so it is still chosen the next time Activity opens (FR-011).
    private string? AddressPrefKey => WalletService.ActiveWallet is { } w ? $"pref:activityAddress:{w.Id}" : null;
    private bool addressPrefRestored;

    private async Task SaveAddressPrefAsync(string? address)
    {
        try
        {
            if (AddressPrefKey is not { } key) return;
            if (address is null) await Storage.RemoveAsync(key);
            else await Storage.SetAsync(key, address);
        }
        catch { }
    }

    /// <summary>Puts back the remembered address, once, if it still has activity; otherwise forgets it.</summary>
    private async Task RestoreAddressPrefAsync()
    {
        if (addressPrefRestored) return;
        addressPrefRestored = true;
        try
        {
            if (AddressPrefKey is not { } key) return;
            var saved = await Storage.GetAsync(key);
            if (string.IsNullOrEmpty(saved)) return;
            if (usedAddresses.FirstOrDefault(u => u.Key == AddressKey.Normalize(saved)) is { } match)
                selectedAddress = match.Address;
            else
                await Storage.RemoveAsync(key);
        }
        catch { }
    }

    // Naming an address from the picker (FR-012). Uses the same label store as the Receive page.
    private string? editingKey;
    private string editLabelText = "";

    private ElementReference renameInput;
    private bool focusRenameInput;

    private void StartRename(UsedAddress used)
    {
        editingKey = used.Key;
        editLabelText = used.Label ?? "";
        focusRenameInput = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Put the cursor in the name box as soon as it appears.
        if (!focusRenameInput || editingKey is null) return;
        focusRenameInput = false;
        try { await renameInput.FocusAsync(); } catch { }
    }

    private void CancelRename() => editingKey = null;

    private async Task OnRenameKey(KeyboardEventArgs e, UsedAddress used)
    {
        if (e.Key == "Enter") await SaveRenameAsync(used);
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task SaveRenameAsync(UsedAddress used)
    {
        if (WalletService.ActiveWallet is not { } wallet) return;
        try { await LabelService.SetLabelAsync(wallet.Id, used.Address, editLabelText); }
        catch { return; }
        editingKey = null;
        await LoadWalletLabelsAsync();
        RefreshUsedAddresses();
        ApplyFilter();
    }

    private async Task LoadWalletLabelsAsync()
    {
        try
        {
            if (WalletService.ActiveWallet is not { } wallet) return;
            var labels = await LabelService.GetAllAsync(wallet.Id);
            walletAddressLabels = ActivityAddressIndex.BuildLabelLookup(
                labels.Select(kv => new KeyValuePair<string, string>(kv.Key, kv.Value.Label)));
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        try { hideAmounts = await Storage.GetAsync("pref:hideBalance") == "1"; } catch { }
        _ = LoadExtrasAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        StateHasChanged();
        try
        {
            all = await WalletService.GetTransactionHistoryAsync(0, MaxLoaded);
            RefreshUsedAddresses();
            await RestoreAddressPrefAsync();
            // A chosen address that no longer appears (for example after a refresh) would leave an empty list with no way out.
            if (selectedAddress != null && !usedAddresses.Any(u => u.Key == AddressKey.Normalize(selectedAddress)))
            {
                selectedAddress = null;
                _ = SaveAddressPrefAsync(null);
            }
            ApplyFilter();
        }
        catch (Exception)
        {
            // A locked wallet or a network problem: the same message either way; Try again re-runs the load.
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Contact names and the fiat price: nice to have, so failures are ignored.</summary>
    private async Task LoadExtrasAsync()
    {
        try
        {
            var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var c in await ContactService.GetAllWithWalletsAsync(WalletService))
                if (!string.IsNullOrWhiteSpace(c.Address)) names[c.Address] = c.Name;
            contactNames = names;
        }
        catch { }

        try
        {
            var p = await Cache.GetOrFetchAsync(
                $"price:{AppState.FiatCurrency}",
                () => Blockchain.GetDgbPriceAsync(AppState.FiatCurrency),
                TimeSpan.FromMinutes(5));
            if (p > 0) price = p;
        }
        catch { }

        await LoadWalletLabelsAsync();

        // Search matches contact names and address labels too, so re-run it now that they are loaded.
        if (!loading && !failed)
        {
            RefreshUsedAddresses();
            ApplyFilter();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void SetFilter(string key)
    {
        filter = key;
        visibleCount = PageSize;
        ApplyFilter();
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        query = (e.Value?.ToString() ?? "").Trim();
        visibleCount = PageSize;
        ApplyFilter();
    }

    private void ClearQuery()
    {
        query = "";
        visibleCount = PageSize;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<TransactionRecord> result = filter switch
        {
            "received" => all.Where(t => t.Direction == TransactionDirection.Received),
            "sent" => all.Where(t => t.Direction == TransactionDirection.Sent),
            _ => all,
        };
        if (selectedAddress != null) result = result.Where(t => ActivityAddressIndex.Matches(t, selectedAddress));
        if (query.Length > 0) result = result.Where(Matches);
        shown = result.ToList();
    }

    private bool Matches(TransactionRecord t)
    {
        const StringComparison ci = StringComparison.OrdinalIgnoreCase;
        return (NameFor(t)?.Contains(query, ci) ?? false)
            || (t.CounterpartyAddress?.Contains(query, ci) ?? false)
            || ActivityAddressIndex.MatchesText(t, query, walletAddressLabels)
            || (t.Memo?.Contains(query, ci) ?? false)
            || t.TxId.Contains(query, ci)
            || t.AmountDgb.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture).Contains(query, ci);
    }

    private string? NameFor(TransactionRecord tx) =>
        tx.CounterpartyAddress is { Length: > 0 } a && contactNames.TryGetValue(a, out var n) ? n : tx.CounterpartyName;

    /// <summary>DGB received and sent since the first of the current month (local time), from the loaded history.</summary>
    private (decimal In, decimal Out) MonthTotals()
    {
        var now = DateTime.Now;
        var start = new DateTime(now.Year, now.Month, 1);
        decimal received = 0, sent = 0;
        foreach (var t in all)
        {
            if (t.Timestamp.ToLocalTime() < start) continue;
            if (t.Direction == TransactionDirection.Received) received += t.AmountDgb; else sent += t.AmountDgb;
        }
        return (received, sent);
    }

    private static string DayLabel(DateTime day)
    {
        var today = DateTime.Now.Date;
        if (day == today) return "Today";
        if (day == today.AddDays(-1)) return "Yesterday";
        return day.ToString(day.Year == today.Year ? "ddd, MMM d" : "MMM d, yyyy");
    }

    private void OpenTx(TransactionRecord tx) => selected = tx;

    private void AddCounterpartyToContacts(string address)
    {
        selected = null;
        Nav.NavigateTo($"/contacts?add={Uri.EscapeDataString(address)}");
    }

}
