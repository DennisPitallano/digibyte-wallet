@page "/transactions"
@inject WalletService WalletService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>All transactions — DigiByte Wallet</PageTitle>

<div class="flex flex-col gap-3">
    <button class="flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-dgb-500 transition-colors w-fit -mb-1" @onclick="GoBack">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
        Back
    </button>

    <div class="slide-up">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">All transactions</h2>
        @if (!loading && !failed)
        {
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@all.Count in total</p>
        }
    </div>

    <div class="flex gap-2" role="tablist" aria-label="Filter transactions">
        @foreach (var (key, label) in Filters)
        {
            var selected = filter == key;
            <button role="tab" aria-selected="@selected"
                    class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors @(selected ? "bg-dgb-500 text-white" : "bg-white dark:bg-dgb-900 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-dgb-800")"
                    @onclick="() => SetFilter(key)">@label</button>
        }
    </div>

    @if (loading)
    {
        <div class="flex flex-col gap-1">
            @for (var i = 0; i < 6; i++)
            {
                <div class="h-[58px] rounded-xl skeleton"></div>
            }
        </div>
    }
    else if (failed)
    {
        <div class="bg-amber-50 dark:bg-amber-900/10 rounded-2xl border border-amber-200 dark:border-amber-900/30 p-5 text-center" role="alert">
            <p class="text-sm text-amber-800 dark:text-amber-300">Couldn't load your transactions. Check your connection and try again.</p>
            <button class="mt-3 px-4 py-2 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl press-effect transition-colors" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (shown.Count == 0)
    {
        <div class="bg-white dark:bg-dgb-900/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-6 text-center">
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">@(all.Count == 0 ? "No transactions yet" : "No transactions match this filter")</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-0.5">
            @foreach (var tx in shown.Take(visibleCount))
            {
                <TransactionRow @key="tx.TxId" Tx="tx" OnOpen="OpenTx" />
            }
        </div>
        @if (shown.Count > visibleCount)
        {
            <button class="self-center px-4 py-2 text-sm font-semibold text-dgb-600 dark:text-dgb-400 bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800 hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors"
                    @onclick="() => visibleCount += PageSize">
                Show more
            </button>
        }
    }
</div>

<TransactionDetailModal IsOpen="@(selected != null)" Tx="@selected"
    OnClosed="() => selected = null"
    OnAddContact="AddCounterpartyToContacts" />

@code {
    private const int PageSize = 50;
    private const int MaxLoaded = 1000;
    private static readonly (string Key, string Label)[] Filters = [("all", "All"), ("received", "Received"), ("sent", "Sent")];

    private List<TransactionRecord> all = [];
    private List<TransactionRecord> shown = [];
    private string filter = "all";
    private int visibleCount = PageSize;
    private bool loading = true;
    private bool failed;
    private TransactionRecord? selected;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        failed = false;
        StateHasChanged();
        try
        {
            all = await WalletService.GetTransactionHistoryAsync(0, MaxLoaded);
            ApplyFilter();
        }
        catch (Exception)
        {
            // A locked wallet or a network problem: the same message either way; Try again re-runs the load.
            failed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private void SetFilter(string key)
    {
        filter = key;
        visibleCount = PageSize;
        ApplyFilter();
    }

    private void ApplyFilter() => shown = filter switch
    {
        "received" => all.Where(t => t.Direction == TransactionDirection.Received).ToList(),
        "sent" => all.Where(t => t.Direction == TransactionDirection.Sent).ToList(),
        _ => all,
    };

    private void OpenTx(TransactionRecord tx) => selected = tx;

    private void AddCounterpartyToContacts(string address)
    {
        selected = null;
        Nav.NavigateTo($"/contacts?add={Uri.EscapeDataString(address)}");
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
}
