@page "/digidollar"
@using DigiByte.Wallet.Models
@using DigiByte.Wallet.Services
@implements IDisposable
@inject DigiDollarViewModel Dd
@inject UsageCounter UsageCounter
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L.T("dd.title")</PageTitle>

<AuthGuard>
<DigiDollarRouteGuard>
    @{
        var d = Dd.Dashboard;
        var vis = Dd.Visibility;
    }
    <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between slide-up">
            <div class="flex items-center gap-2">
                <DigiDollarLogo Size="28" />
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">@L.T("dd.title")</h2>
            </div>
            <button class="w-9 h-9 rounded-xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center press-effect"
                    aria-label="@L.T("dd.refresh")" title="@L.T("dd.refresh")" disabled="@Dd.IsRefreshing"
                    @onclick="RefreshAsync">
                <svg class="w-4 h-4 text-slate-500 @(Dd.IsRefreshing ? "animate-spin" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </button>
        </div>

        <DigiDollarHealthBanner />
        <DigiDollarPriceLine />

        @if (d is null && Dd.Scan is null)
        {
            <div class="flex flex-col items-center gap-3 py-12" role="status" aria-label="@L.T("dd.loading")">
                <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                <p class="text-sm text-slate-500 dark:text-slate-400">@L.T("dd.loading")</p>
            </div>
        }
        else if (Dd.Scan is { } scan)
        {
            <div class="flex flex-col items-center gap-3 py-12 text-center" role="status">
                <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@L.T("dd.scanning")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("dd.scanning.progress", scan.AddressesChecked, scan.ActiveFound)</p>
            </div>
        }
        else if (d!.State == DdViewState.NotActive)
        {
            <div class="flex flex-col items-center gap-3 py-12 text-center" role="status">
                <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs">@L.T("dd.notActive")</p>
            </div>
        }
        else if (d.State == DdViewState.Unavailable)
        {
            <div class="flex flex-col items-center gap-3 py-12 text-center" role="alert">
                <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs">@L.T("dd.unavailable.state")</p>
                <button class="px-4 py-2 text-sm font-semibold rounded-xl bg-dgb-500 text-white press-effect" @onclick="RefreshAsync">@L.T("dd.retry")</button>
                <a class="text-xs font-medium text-dgb-500" href="/digidollar/receive">@L.T("dd.receive")</a>
            </div>
        }
        else
        {
            var balance = d.Balance!;
            <div class="scale-in bg-white dark:bg-dgb-900 rounded-3xl border border-slate-200/80 dark:border-dgb-800 p-5 shadow-sm flex flex-col gap-1">
                <p class="text-xs font-medium text-slate-500 dark:text-slate-400">@L.T("dd.balance")</p>
                <p class="text-3xl font-bold tabular-nums text-slate-900 dark:text-white">@Dd.Usd(balance.ConfirmedCents)</p>
                @if (balance.PendingCents != 0)
                {
                    <p class="text-xs tabular-nums text-slate-500 dark:text-slate-400">@L.T("dd.pending"): @Dd.Usd(balance.PendingCents)</p>
                }
            </div>

            <div class="flex gap-2">
                <button class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl press-effect"
                        @onclick="@(() => Nav.NavigateTo("/digidollar/receive"))">
                    @L.T("dd.receive")
                </button>
                @if (vis.SendVisible && d.State != DdViewState.UnavailableCached)
                {
                    <button class="flex-1 py-2.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl press-effect"
                            @onclick="@(() => Nav.NavigateTo("/digidollar/send"))">
                        @L.T("dd.send")
                    </button>
                }
            </div>

            @if (d.State == DdViewState.Empty)
            {
                <div class="flex flex-col items-center gap-1 py-6 text-center">
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@L.T("dd.empty")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("dd.empty.hint")</p>
                </div>
            }
            else
            {
                <h3 class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("dd.history")</h3>
                <ul class="flex flex-col divide-y divide-slate-100 dark:divide-dgb-800 bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800" aria-label="@L.T("dd.history")">
                    @foreach (var tx in d.History)
                    {
                        <li class="px-4 py-3 flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-900 dark:text-white">@DirectionLabel(tx)</p>
                                @if (tx.CounterpartyAddress is { } who)
                                {
                                    <p class="font-mono text-[11px] text-slate-500 dark:text-slate-400 truncate" title="@who">@Short(who)</p>
                                }
                                <p class="text-[11px] text-slate-400 dark:text-slate-500">
                                    @tx.Timestamp.ToLocalTime().ToString("g", Dd.Culture)
                                    &middot; @StatusLabel(tx)
                                </p>
                                @if (Dd.ExplorerTxUrl(tx.Txid) is { } url)
                                {
                                    <a class="text-[11px] font-medium text-dgb-500" href="@url" target="_blank" rel="noopener">@L.T("dd.history.explorer")</a>
                                }
                            </div>
                            <p class="text-sm font-bold tabular-nums shrink-0 @(tx.Direction == DdDirection.Received ? "text-emerald-600 dark:text-emerald-400" : "text-slate-900 dark:text-white")">
                                @(tx.Direction == DdDirection.Received ? "+" : tx.Direction == DdDirection.Sent ? "−" : "")@Dd.Usd(tx.AmountCents)
                            </p>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</DigiDollarRouteGuard>
</AuthGuard>

@code {
    protected override async Task OnInitializedAsync()
    {
        Dd.Changed += OnChanged;
        Dd.StartPolling();
        try { await Dd.EnsureLoadedAsync(); }
        catch { /* DigiDollar failures stay inside DigiDollar */ }

        // Anonymous aggregate count of DigiDollar section views (numerator of SC-005); only when the page is really shown.
        if (Dd.Visibility.Visible) _ = UsageCounter.RecordAsync("dd_section_view");
    }

    private Task RefreshAsync() => Dd.RefreshAsync();

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private string DirectionLabel(DigiDollarTransaction tx) => tx.Direction switch
    {
        DdDirection.Received => L.T("dd.history.received"),
        DdDirection.Sent => L.T("dd.history.sent"),
        _ => L.T("dd.history.self"),
    };

    private string StatusLabel(DigiDollarTransaction tx) => tx.Status switch
    {
        DdTxStatus.Pending => L.T("dd.status.pending"),
        DdTxStatus.Failed => L.T("dd.status.failed"),
        _ => L.T("dd.status.confirmations", tx.Confirmations),
    };

    private static string Short(string address) =>
        address.Length <= 18 ? address : $"{address[..8]}…{address[^6..]}";

    public void Dispose()
    {
        Dd.Changed -= OnChanged;
        Dd.StopPolling();
    }
}
