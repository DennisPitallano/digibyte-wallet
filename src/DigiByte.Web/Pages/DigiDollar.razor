@page "/digidollar"
@using DigiByte.Wallet.Models
@using DigiByte.Wallet.Services
@implements IDisposable
@inject DigiDollarViewModel Dd
@inject UsageCounter UsageCounter
@inject LocalizationService L
@inject NavigationManager Nav
@inject AppState AppState
@inject NotificationService Notifications

<PageTitle>@L.T("dd.title")</PageTitle>

<AuthGuard>
<DigiDollarRouteGuard>
    @{
        var d = Dd.Dashboard;
        var vis = Dd.Visibility;
    }
    <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between slide-up">
            <div class="flex items-center gap-2.5">
                <DigiDollarLogo Size="30" />
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">@L.T("dd.title")</h2>
                @if (AppState.NetworkMode != "mainnet")
                {
                    <span class="text-[9px] font-bold text-amber-700 dark:text-amber-300 bg-amber-500/20 px-1.5 py-0.5 rounded-full uppercase">@AppState.NetworkMode</span>
                }
            </div>
            <button class="w-9 h-9 rounded-xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center press-effect text-slate-500 dark:text-slate-400"
                    aria-label="@L.T("dd.refresh")" title="@L.T("dd.refresh")" disabled="@Dd.IsRefreshing"
                    @onclick="RefreshAsync">
                <DdIcon Name="refresh" Class="@("w-4 h-4 " + (Dd.IsRefreshing ? "animate-spin" : ""))" StrokeWidth="2" />
            </button>
        </div>

        <DigiDollarHealthBanner OracleDetails="false" />
        <BakuMessage MessageId="dd.tip" />

        @if (d is null && Dd.Scan is null)
        {
            <div class="flex flex-col items-center gap-3 py-12" role="status" aria-label="@L.T("dd.loading")">
                <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                <p class="text-sm text-slate-500 dark:text-slate-400">@L.T("dd.loading")</p>
            </div>
            <OracleStatusPanel Health="null" Loading="true" Culture="Dd.Culture" />
        }
        else if (Dd.Scan is { } scan)
        {
            <div class="flex flex-col items-center gap-3 py-12 text-center" role="status">
                <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@L.T("dd.scanning")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("dd.scanning.progress", scan.AddressesChecked, scan.ActiveFound)</p>
            </div>
        }
        else if (d!.State == DdViewState.NotActive)
        {
            <div class="flex flex-col items-center gap-3 py-10 text-center" role="status">
                <span class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-dgb-800 text-slate-400 flex items-center justify-center"><DdIcon Name="clock" Class="w-7 h-7" /></span>
                <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs">@L.T("dd.notActive")</p>
            </div>
        }
        else if (d.State == DdViewState.Unavailable)
        {
            <div class="flex flex-col items-center gap-3 py-10 text-center" role="alert">
                <span class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-dgb-800 text-slate-400 flex items-center justify-center"><DdIcon Name="offline" Class="w-7 h-7" /></span>
                <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs">@L.T("dd.unavailable.state")</p>
                <button class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-xl bg-dgb-500 text-white press-effect" @onclick="RefreshAsync">
                    <DdIcon Name="refresh" Class="w-4 h-4" StrokeWidth="2" />@L.T("dd.retry")
                </button>
                <a class="text-xs font-medium text-dgb-500" href="/digidollar/receive">@L.T("dd.receive")</a>
            </div>
        }
        else
        {
            var balance = d.Balance!;
            var canSend = vis.SendVisible && d.State != DdViewState.UnavailableCached;

            @* Balance hero *@
            <div class="scale-in relative overflow-hidden rounded-3xl bg-gradient-to-br from-dgb-900 via-dgb-800 to-dgb-600 p-5 text-white shadow-lg shadow-dgb-900/20">
                <div class="absolute -right-6 -top-6 opacity-[0.12] pointer-events-none" aria-hidden="true"><DigiDollarLogo Size="150" /></div>
                <p class="relative text-xs font-medium text-dgb-200">@L.T("dd.balance")</p>
                <p class="relative text-4xl font-extrabold tabular-nums tracking-tight mt-1">@Dd.Usd(balance.ConfirmedCents)</p>
                @if (balance.PendingCents != 0)
                {
                    <p class="relative mt-2 inline-flex items-center gap-1.5 text-xs tabular-nums text-dgb-100 bg-white/10 rounded-full px-2.5 py-1">
                        <DdIcon Name="clock" Class="w-3.5 h-3.5" />@L.T("dd.pending"): @Dd.Usd(balance.PendingCents)
                    </p>
                }
            </div>

            @* Quick actions: same look as the DGB buttons on Home *@
            <div class="flex justify-center gap-6 slide-up-delay-1">
                <button class="flex flex-col items-center gap-1 group" @onclick="@(() => Nav.NavigateTo("/digidollar/receive"))">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <DdIcon Name="receive" Class="w-5 h-5 text-dgb-500" StrokeWidth="2" />
                    </div>
                    <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">@L.T("dd.receive")</span>
                </button>
                @if (canSend)
                {
                    <button class="flex flex-col items-center gap-1 group" @onclick="@(() => Nav.NavigateTo("/digidollar/send"))">
                        <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                            <DdIcon Name="send" Class="w-5 h-5 text-dgb-500" StrokeWidth="2" />
                        </div>
                        <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">@L.T("dd.send")</span>
                    </button>
                    <button class="flex flex-col items-center gap-1 group" @onclick="@(() => Nav.NavigateTo("/digidollar/send?scan=1"))">
                        <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                            <DdIcon Name="qr" Class="w-5 h-5 text-dgb-500" StrokeWidth="2" />
                        </div>
                        <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">@L.T("dd.scan")</span>
                    </button>
                }
                @* Teaser only: minting is a separate, later release. Nothing here starts a mint flow. *@
                <button class="flex flex-col items-center gap-1 group" aria-disabled="true"
                        @onclick="@(() => Notifications.Show(L.T("dd.mint.toast"), ToastType.Info, 3000))">
                    <div class="relative w-12 h-12 rounded-2xl bg-white/60 dark:bg-dgb-900/60 border border-dashed border-slate-300 dark:border-dgb-700 flex items-center justify-center group-active:scale-90 transition-transform">
                        <DdIcon Name="mint" Class="w-5 h-5 text-slate-400 dark:text-slate-500" StrokeWidth="2" />
                        <span class="absolute -top-1.5 -right-2 text-[8px] font-bold uppercase tracking-wide bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 px-1.5 py-0.5 rounded-full">@L.T("dd.mint.soon")</span>
                    </div>
                    <span class="text-[10px] font-semibold text-slate-400 dark:text-slate-500">@L.T("dd.mint")</span>
                </button>
            </div>

            <OracleStatusPanel Health="d.Health" Culture="Dd.Culture" />

            @if (d.State == DdViewState.Empty)
            {
                <div class="flex flex-col items-center gap-2 py-6 text-center">
                    <span class="w-14 h-14 rounded-2xl bg-dgb-50 dark:bg-dgb-800 text-dgb-500 flex items-center justify-center"><DdIcon Name="inbox" Class="w-7 h-7" /></span>
                    <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">@L.T("dd.empty")</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-[16rem]">@L.T("dd.empty.hint")</p>
                    <button class="mt-1 inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-xl bg-dgb-500 hover:bg-dgb-600 text-white press-effect"
                            @onclick="@(() => Nav.NavigateTo("/digidollar/receive"))">
                        <DdIcon Name="qr" Class="w-4 h-4" StrokeWidth="2" />@L.T("dd.empty.cta")
                    </button>
                </div>
            }
            else
            {
                <h3 class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">@L.T("dd.history.title")</h3>
                <ul class="flex flex-col divide-y divide-slate-100 dark:divide-dgb-800 bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200/80 dark:border-dgb-800" aria-label="@L.T("dd.history")">
                    @foreach (var tx in d.History)
                    {
                        var received = tx.Direction == DdDirection.Received;
                        <li class="px-4 py-3 flex items-center gap-3">
                            <span class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 @(tx.Status == DdTxStatus.Failed ? "bg-red-50 dark:bg-red-900/30 text-red-500" : received ? "bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-300" : "bg-dgb-50 dark:bg-dgb-800 text-dgb-600 dark:text-dgb-300")">
                                <DdIcon Name="@(tx.Status == DdTxStatus.Failed ? "warning" : received ? "receive" : "send")" Class="w-[18px] h-[18px]" StrokeWidth="2" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white">@DirectionLabel(tx)</p>
                                    @if (tx.Status == DdTxStatus.Pending)
                                    {
                                        <span class="text-[10px] font-semibold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/25 px-1.5 py-0.5 rounded-full">@L.T("dd.status.pending")</span>
                                    }
                                    else if (tx.Status == DdTxStatus.Failed)
                                    {
                                        <span class="text-[10px] font-semibold text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-900/25 px-1.5 py-0.5 rounded-full">@L.T("dd.status.failed")</span>
                                    }
                                </div>
                                @if (tx.CounterpartyAddress is { } who)
                                {
                                    <p class="font-mono text-[11px] text-slate-500 dark:text-slate-400 truncate" title="@who">@Short(who)</p>
                                }
                                <p class="text-[11px] text-slate-400 dark:text-slate-500">
                                    @tx.Timestamp.ToLocalTime().ToString("g", Dd.Culture)
                                    @if (tx.Status == DdTxStatus.Confirmed)
                                    {
                                        <span>&middot; @StatusLabel(tx)</span>
                                    }
                                </p>
                                @if (Dd.ExplorerTxUrl(tx.Txid) is { } url)
                                {
                                    <a class="text-[11px] font-medium text-dgb-500" href="@url" target="_blank" rel="noopener">@L.T("dd.history.explorer")</a>
                                }
                            </div>
                            <p class="text-sm font-bold tabular-nums shrink-0 @(received ? "text-emerald-600 dark:text-emerald-400" : "text-slate-900 dark:text-white")">
                                @(received ? "+" : tx.Direction == DdDirection.Sent ? "−" : "")@Dd.Usd(tx.AmountCents)
                            </p>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</DigiDollarRouteGuard>
</AuthGuard>

@code {
    protected override async Task OnInitializedAsync()
    {
        Dd.Changed += OnChanged;
        Dd.StartPolling();
        try { await Dd.EnsureLoadedAsync(); }
        catch { /* DigiDollar failures stay inside DigiDollar */ }

        // Anonymous aggregate count of DigiDollar section views (numerator of SC-005); only when the page is really shown.
        if (Dd.Visibility.Visible) _ = UsageCounter.RecordAsync("dd_section_view");
    }

    private Task RefreshAsync() => Dd.RefreshAsync();

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private string DirectionLabel(DigiDollarTransaction tx) => tx.Direction switch
    {
        DdDirection.Received => L.T("dd.history.received"),
        DdDirection.Sent => L.T("dd.history.sent"),
        _ => L.T("dd.history.self"),
    };

    private string StatusLabel(DigiDollarTransaction tx) => tx.Status switch
    {
        DdTxStatus.Pending => L.T("dd.status.pending"),
        DdTxStatus.Failed => L.T("dd.status.failed"),
        _ => L.T("dd.status.confirmations", tx.Confirmations),
    };

    private static string Short(string address) =>
        address.Length <= 18 ? address : $"{address[..8]}…{address[^6..]}";

    public void Dispose()
    {
        Dd.Changed -= OnChanged;
        Dd.StopPolling();
    }
}
