@page "/help"
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L

<PageTitle>@L.T("help.page_title")</PageTitle>

<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between -mb-2">
        <button type="button" class="back-btn" @onclick="GoBack">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <span>@L.T("nav.back")</span>
        </button>
        <a href="/" class="flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-dgb-500 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.5 1.5 0 0 1 2.121 0L22.28 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
            @L.T("help.home")
        </a>
    </div>
    <div class="slide-up">
        <h2 class="page-title">@L.T("help.title")</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@L.T("help.intro_text")</p>
    </div>

    <BakuMessage MessageId="help.intro" />

    @* Search / Filter *@
    <div class="slide-up-delay-1">
        <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="@L.T("help.search_placeholder")"
                   class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-dgb-500/30 focus:border-dgb-500 transition-all" />
        </div>
    </div>

    @if (!FilteredSections.Any())
    {
        <BakuMessage MessageId="help.no-results" />
    }

    @* Sections *@
    <div class="flex flex-col gap-2 slide-up-delay-2">
        @foreach (var section in FilteredSections)
        {
            var isOpen = openSections.Contains(section.Id);
            <div class="card overflow-hidden">
                <button class="w-full flex items-center gap-3 p-4 text-left hover:bg-slate-50 dark:hover:bg-dgb-800/50 transition-colors"
                        @onclick="() => ToggleSection(section.Id)">
                    <div class="w-9 h-9 rounded-xl @(section.IconBg) flex items-center justify-center flex-shrink-0">
                        @((MarkupString)section.IconSvg)
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@(section.Title)</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@(section.Subtitle)</p>
                    </div>
                    <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 flex-shrink-0 @(isOpen ? "rotate-180" : "")"
                         fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                @if (isOpen)
                {
                    <div class="px-4 pb-4 border-t border-slate-100 dark:border-dgb-800">
                        <div class="flex flex-col gap-3 pt-3">
                            @foreach (var qa in section.Items)
                            {
                                <div>
                                    <p class="text-xs font-semibold text-slate-800 dark:text-slate-200 mb-1">@qa.Question</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">@Rendered(qa.Answer)</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* Report Issue / Suggest Feature *@
    <div class="slide-up-delay-3 mt-2">
        <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2 px-1">@L.T("help.feedback.title")</p>

        <div class="card p-4 flex flex-col gap-3">
            <div class="flex gap-2">
                <button class="flex-1 py-2 text-xs font-semibold rounded-xl transition-colors @(feedbackType == "bug" ? "bg-red-500 text-white" : "bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-300") press-effect"
                        @onclick='() => feedbackType = "bug"'>
                    @L.T("help.feedback.report_bug")
                </button>
                <button class="flex-1 py-2 text-xs font-semibold rounded-xl transition-colors @(feedbackType == "feature" ? "bg-dgb-500 text-white" : "bg-slate-100 dark:bg-dgb-800 text-slate-600 dark:text-slate-300") press-effect"
                        @onclick='() => feedbackType = "feature"'>
                    @L.T("help.feedback.suggest")
                </button>
            </div>

            <input type="text" @bind="feedbackTitle" placeholder="@(feedbackType == "bug" ? L.T("help.feedback.bug_placeholder") : L.T("help.feedback.feature_placeholder"))"
                   class="input" />

            <textarea @bind="feedbackBody" rows="3" placeholder="@L.T("help.feedback.body_placeholder")"
                      class="input resize-none"></textarea>

            <button class="btn-primary btn-sm w-full"
                    disabled="@(string.IsNullOrWhiteSpace(feedbackTitle))"
                    @onclick="SubmitFeedback">
                @L.T("help.feedback.open")
            </button>

            <a href="https://github.com/DennisPitallano/digibyte-wallet/issues" target="_blank" rel="noopener"
               class="text-center text-[11px] text-dgb-500 hover:text-dgb-600 font-medium transition-colors">
                @L.T("help.feedback.browse") &rarr;
            </a>
        </div>
    </div>

    <div class="pb-4"></div>
</div>

@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private string searchQuery = "";
    private string feedbackType = "bug";
    private string feedbackTitle = "";
    private string feedbackBody = "";
    private HashSet<string> openSections = [];

    private async Task GoBack()
    {
        // If the user navigated directly to /help (shared link, typed URL, new tab),
        // history.back() would leave the app. Fall back to the home page in that case.
        var canGoBack = await JS.InvokeAsync<bool>("domHelpers.canGoBackInApp");
        if (canGoBack)
        {
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }

    private void ToggleSection(string id)
    {
        if (!openSections.Remove(id))
            openSections.Add(id);
    }

    private async Task SubmitFeedback()
    {
        var label = feedbackType == "bug" ? "bug" : "enhancement";
        var title = Uri.EscapeDataString(feedbackTitle);
        var body = Uri.EscapeDataString(feedbackBody);
        var url = $"https://github.com/DennisPitallano/digibyte-wallet/issues/new?title={title}&body={body}&labels={label}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private IEnumerable<HelpSection> FilteredSections =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? sections
            : sections.Where(s =>
                s.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                s.Subtitle.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                s.Items.Any(i =>
                    i.Question.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Answer.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    /// <summary>
    /// An answer is kept in the translation files as plain text with a little markup, never raw HTML: **bold**, `code`,
    /// [link](/path or https://…), lines starting with "- " (bullets) or "1. " (numbered steps), and line breaks.
    /// Everything else is encoded, so a translation can't break the page.
    /// </summary>
    private static MarkupString Rendered(string text)
    {
        var html = new System.Text.StringBuilder();
        string? list = null;   // "ul" or "ol" while inside a list
        var afterText = false; // the previous line was text, so the next one starts after a line break
        foreach (var line in text.Replace("\r\n", "\n").Split('\n'))
        {
            var bullet = line.StartsWith("- ", StringComparison.Ordinal);
            var step = System.Text.RegularExpressions.Regex.Match(line, @"^\d+\. ");
            var kind = bullet ? "ul" : step.Success ? "ol" : null;
            if (kind != list && list is not null) { html.Append("</").Append(list).Append('>'); list = null; }
            if (kind is not null)
            {
                if (list is null)
                {
                    html.Append('<').Append(kind).Append(kind == "ul"
                        ? " class='mt-1 ml-2 list-disc list-inside flex flex-col gap-1'>"
                        : " class='mt-1 ml-2 list-decimal list-inside flex flex-col gap-1'>");
                    list = kind;
                }
                html.Append("<li>").Append(Inline(line[(bullet ? 2 : step.Length)..])).Append("</li>");
                afterText = false;
                continue;
            }
            if (afterText) html.Append("<br/>");
            html.Append(Inline(line));
            afterText = true;
        }
        if (list is not null) html.Append("</").Append(list).Append('>');
        return new MarkupString(html.ToString());
    }

    private static string Inline(string text)
    {
        var s = System.Net.WebUtility.HtmlEncode(text);
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*\*(.+?)\*\*", "<b>$1</b>");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"`(.+?)`", "<code>$1</code>");
        return System.Text.RegularExpressions.Regex.Replace(s, @"\[([^\]]+)\]\(((?:/|https://)[^)\s]*)\)", m =>
        {
            var href = m.Groups[2].Value;
            var external = href.StartsWith("https://", StringComparison.Ordinal);
            var color = href.StartsWith("/help/multisig", StringComparison.Ordinal) ? "text-purple-500"
                : href.StartsWith("/identity", StringComparison.Ordinal) ? "text-blue-500" : "text-dgb-500";
            return $"<a href='{href}'{(external ? " target='_blank' rel='noopener'" : "")} class='{color} underline'>{m.Groups[1].Value}</a>";
        });
    }

    private record QA(string Question, string Answer);
    private record HelpSection(string Id, string Title, string Subtitle, string IconBg, string IconSvg, QA[] Items);

