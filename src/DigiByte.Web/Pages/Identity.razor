@page "/identity"
@inject WalletService WalletService
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable
@inject IConfiguration Config
@inject ISecureStorage Storage
@inject BakuService Baku
@inject LocalizationService L

<PageTitle>@L.T("identity.title") — @L.T("app.name")</PageTitle>

<div class="flex flex-col gap-4">
    <div class="flex items-center justify-between slide-up">
        <h2 class="page-title">@L.T("identity.title")</h2>
        @{ var idWalletColor = WalletService.ActiveWallet?.Color ?? "#0066FF"; }
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <div class="w-2 h-2 rounded-full" style="background-color: @idWalletColor;"></div>
            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[100px]">@(WalletService.ActiveWallet?.Name ?? L.T("nav.wallet"))</span>
        </div>
    </div>

    <BakuMessage MessageId="digiid.intro" />

    @* How it works *@
    <div class="card slide-up-delay-1 p-4 flex flex-col gap-3">
        <h3 class="block-title block-title-sm">@L.T("identity.description")</h3>
        <div class="flex flex-col gap-2">
            <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="text-xs font-bold text-dgb-500">1</span>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-400">@L.T("identity.step1")</p>
            </div>
            <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="text-xs font-bold text-dgb-500">2</span>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-400">@L.T("identity.step2")</p>
            </div>
            <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="text-xs font-bold text-dgb-500">3</span>
                </div>
                <p class="text-sm text-slate-600 dark:text-slate-400">@L.T("identity.step3")</p>
            </div>
        </div>
    </div>

    @* Scan / Paste URI *@
    <div class="slide-up-delay-2 flex flex-col gap-3">
        <button class="btn-primary w-full"
                @onclick="ScanDigiId">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
            </svg>
            @L.T("identity.scan")
        </button>

        <div class="flex items-center gap-3">
            <div class="flex-1 h-px bg-slate-200 dark:bg-dgb-800"></div>
            <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">@L.T("identity.orPaste")</span>
            <div class="flex-1 h-px bg-slate-200 dark:bg-dgb-800"></div>
        </div>

        <div class="flex gap-2">
            <input type="text" @bind="digiIdUri" placeholder="@L.T("identity.uriPlaceholder")"
                   class="input flex-1 font-mono" />
            <button class="btn-primary btn-sm"
                    @onclick="AuthenticateAsync" disabled="@(string.IsNullOrWhiteSpace(digiIdUri) || isAuthenticating)">
                @(isAuthenticating ? "..." : L.T("identity.sign"))
            </button>
        </div>

        @if (parseError != null)
        {
            <InlineError Message="@parseError?.Invoke()" />
        }
    </div>

    @* Auth confirmation *@
    @if (pendingRequest != null && !isAuthenticating && authResult == AuthResult.None)
    {
        <div class="scale-in bg-white dark:bg-dgb-900 rounded-2xl border-2 border-dgb-300 dark:border-dgb-700 p-5 flex flex-col gap-4 shadow-lg shadow-dgb-500/10">
            <div class="flex flex-col items-center gap-2">
                <div class="w-12 h-12 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                    <svg class="w-6 h-6 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                </div>
                <h3 class="block-title">@L.T("identity.authWith")</h3>
            </div>

            <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl px-4 py-3 border border-slate-200/60 dark:border-dgb-800">
                <p class="text-base font-bold text-slate-900 dark:text-white text-center">@pendingRequest.Domain</p>
                <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500 mt-1 text-center truncate">@pendingRequest.CallbackUrl</p>
            </div>

            @if (pendingAddress != null)
            {
                <div class="bg-slate-50 dark:bg-dgb-950 rounded-xl px-4 py-3 border border-slate-200/60 dark:border-dgb-800 flex flex-col gap-1.5">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">@L.T("identity.signingAddress")</span>
                        <CopyValueButton Value="@pendingAddress" Label="@L.T("identity.signingAddress.copy")" />
                    </div>
                    <p class="text-xs font-mono text-slate-800 dark:text-slate-200 break-all select-all">@pendingAddress</p>
                </div>
                <DigiIdAddressWarning />
            }

            @if (pendingRequest.IsUnsecure)
            {
                <div class="flex items-start gap-2 bg-amber-50 dark:bg-amber-900/10 rounded-xl px-3 py-2.5 border border-amber-200/60 dark:border-amber-900/30">
                    <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                    </svg>
                    <p class="text-xs text-amber-700 dark:text-amber-400 leading-relaxed">
                        <b>@L.T("identity.insecure.title")</b> — @L.T("identity.insecure.body")
                    </p>
                </div>
            }

            <div class="bg-dgb-50/50 dark:bg-dgb-800/30 rounded-xl p-3">
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed text-center">
                    @L.T("identity.confirm.note")
                </p>
            </div>

            <div class="flex gap-3">
                <button class="btn-secondary flex-1"
                        @onclick="CancelAuth">@L.T("common.cancel")</button>
                <button class="btn-primary flex-1"
                        @onclick="ConfirmAuthAsync">
                    @L.T("identity.approve")
                </button>
            </div>
        </div>
    }

    @* Signing in progress — step animation *@
    @if (isAuthenticating)
    {
        <div class="scale-in bg-white dark:bg-dgb-900 rounded-2xl border border-slate-200 dark:border-dgb-800 p-5 flex flex-col items-center gap-4 shadow-lg">
            <div class="w-14 h-14 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center">
                <div class="w-7 h-7 border-[3px] border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
            </div>
            <div class="flex flex-col items-center gap-1">
                <p class="text-sm font-bold text-slate-900 dark:text-white">@L.T("identity.authenticating")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">@pendingRequest?.Domain</p>
            </div>

            <div class="w-full flex flex-col gap-2">
                @* Step 1: Signing *@
                <div class="flex items-center gap-3 p-2.5 rounded-lg @(authStep >= 1 ? "bg-dgb-50/50 dark:bg-dgb-800/30" : "opacity-40")">
                    @if (authStep > 1)
                    {
                        <div class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        </div>
                    }
                    else if (authStep == 1)
                    {
                        <div class="w-6 h-6 flex items-center justify-center flex-shrink-0">
                            <div class="w-4 h-4 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    }
                    else
                    {
                        <div class="w-6 h-6 rounded-full border-2 border-slate-300 dark:border-dgb-700 flex-shrink-0"></div>
                    }
                    <span class="text-xs font-medium @(authStep >= 1 ? "text-slate-700 dark:text-slate-300" : "text-slate-400 dark:text-slate-600")">@L.T("identity.step.signing")</span>
                </div>

                @* Step 2: Sending *@
                <div class="flex items-center gap-3 p-2.5 rounded-lg @(authStep >= 2 ? "bg-dgb-50/50 dark:bg-dgb-800/30" : "opacity-40")">
                    @if (authStep > 2)
                    {
                        <div class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        </div>
                    }
                    else if (authStep == 2)
                    {
                        <div class="w-6 h-6 flex items-center justify-center flex-shrink-0">
                            <div class="w-4 h-4 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    }
                    else
                    {
                        <div class="w-6 h-6 rounded-full border-2 border-slate-300 dark:border-dgb-700 flex-shrink-0"></div>
                    }
                    <span class="text-xs font-medium @(authStep >= 2 ? "text-slate-700 dark:text-slate-300" : "text-slate-400 dark:text-slate-600")">@L.T("identity.step.sending", pendingRequest?.Domain ?? L.T("identity.server"))</span>
                </div>

                @* Step 3: Verifying *@
                <div class="flex items-center gap-3 p-2.5 rounded-lg @(authStep >= 3 ? "bg-dgb-50/50 dark:bg-dgb-800/30" : "opacity-40")">
                    @if (authStep > 3)
                    {
                        <div class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                        </div>
                    }
                    else if (authStep == 3)
                    {
                        <div class="w-6 h-6 flex items-center justify-center flex-shrink-0">
                            <div class="w-4 h-4 border-2 border-dgb-500 border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    }
                    else
                    {
                        <div class="w-6 h-6 rounded-full border-2 border-slate-300 dark:border-dgb-700 flex-shrink-0"></div>
                    }
                    <span class="text-xs font-medium @(authStep >= 3 ? "text-slate-700 dark:text-slate-300" : "text-slate-400 dark:text-slate-600")">@L.T("identity.step.verifying")</span>
                </div>
            </div>
        </div>
    }

    @* Success *@
    @if (authResult == AuthResult.Success)
    {
        <div class="scale-in bg-green-50 dark:bg-green-900/10 rounded-2xl border border-green-200 dark:border-green-800/30 p-5 flex flex-col items-center gap-3">
            <div class="w-14 h-14 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center check-pop">
                <svg class="w-7 h-7 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
            </div>
            <div class="text-center">
                <p class="text-base font-bold text-green-700 dark:text-green-400">@L.T("identity.success.title")</p>
                <p class="text-sm text-green-600 dark:text-green-500 mt-0.5">@{ var loggedIn = L.T("identity.success.loggedIn").Split("{0}", 2); }@loggedIn[0]<b>@lastAuthDomain</b>@(loggedIn.Length > 1 ? loggedIn[1] : "")</p>
            </div>
            <div class="w-full bg-green-100/50 dark:bg-green-900/20 rounded-xl px-3 py-2 flex flex-col gap-1">
                <div class="flex flex-col gap-1">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-[11px] text-green-600/70 dark:text-green-500/70">@L.T("identity.success.addressUsed")</span>
                        <CopyValueButton Value="@lastAuthAddress" Label="@L.T("identity.success.addressCopy")" />
                    </div>
                    <span class="text-[11px] font-mono text-green-700 dark:text-green-400 break-all select-all">@lastAuthAddress</span>
                    <DigiIdAddressWarning Compact="true" />
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-[11px] text-green-600/70 dark:text-green-500/70">@L.T("identity.success.time")</span>
                    <span class="text-[11px] text-green-700 dark:text-green-400">@DateTime.Now.ToString("h:mm:ss tt")</span>
                </div>
            </div>
            @* The site that opened this sign-in (?return=, same site as the request only): never automatic. *@
            <SiteReturnButton ReturnTo="@siteReturn" />
            <button class="text-xs text-green-600 dark:text-green-400 font-medium hover:underline mt-1" @onclick="ResetState">@L.T("identity.success.another")</button>
        </div>
    }

    @* Failure *@
    @if (authResult == AuthResult.Failed)
    {
        <div class="scale-in bg-red-50 dark:bg-red-900/10 rounded-2xl border border-red-200 dark:border-red-800/30 p-5 flex flex-col items-center gap-3">
            <div class="w-14 h-14 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                <svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </div>
            <div class="text-center">
                <p class="text-base font-bold text-red-700 dark:text-red-400">@L.T("identity.failed.title")</p>
                <InlineError Message="@authErrorTitle?.Invoke()" />
            </div>
            @if (authErrorDetail != null)
            {
                <div class="w-full bg-red-100/50 dark:bg-red-900/20 rounded-xl px-3 py-2.5">
                    <p class="text-[11px] text-red-600/80 dark:text-red-400/80 leading-relaxed">@authErrorDetail()</p>
                </div>
            }
            <div class="flex gap-2 w-full">
                <button class="btn-secondary btn-sm flex-1"
                        @onclick="ResetState">@L.T("identity.dismiss")</button>
                <button class="btn-primary btn-sm flex-1"
                        @onclick="RetryAuth">@L.T("identity.recover.retry")</button>
            </div>
        </div>
    }

    @* Recent Authentications *@
    @if (authHistory.Count > 0)
    {
        <div class="slide-up-delay-3">
            <div class="flex items-center justify-between mb-2">
                <h3 class="section-label">@L.T("identity.history.title")</h3>
                <button class="text-[11px] text-red-400 hover:text-red-500 font-medium transition-colors press-effect"
                        @onclick="ClearHistoryAsync">@L.T("identity.history.clear")</button>
            </div>
            <div class="flex flex-col gap-1.5">
                @for (var i = 0; i < authHistory.Count; i++)
                {
                    var e = authHistory[i];
                    var rowKey = i;
                    <button type="button" @key="e" @ref="rowRefs[rowKey]" @onclick="() => OpenDetails(e, rowKey)"
                            aria-label="@L.T("identity.history.details", e.Domain)"
                            class="w-full text-left flex items-center gap-3 p-3 bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800 hover:border-dgb-300 dark:hover:border-dgb-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-dgb-500 transition-colors">
                        <div class="w-8 h-8 rounded-full bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-dgb-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3" />
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@e.Domain</p>
                            <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500 truncate">@TruncateAddress(e.Address)</p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">@FormatRelativeTime(e.Timestamp)</p>
                            <p class="text-[11px] text-slate-300 dark:text-slate-600">@L.T("history.when.date_time", e.Timestamp.ToLocalTime().ToString(L.T("history.format.month_day")), e.Timestamp.ToLocalTime().ToString("t"))</p>
                        </div>
                    </button>
                }
            </div>
        </div>
    }

    @* Recover funds (spec 009): the section carries id="recover-funds", which the warning beside every Digi-ID address links to. *@
    <DigiIdRecoverFunds />
</div>

<DigiIdLoginDetailModal IsOpen="@(selectedEntry != null)" Entry="selectedEntry" OnClosed="CloseDetailsAsync" />

<QrScannerModal IsOpen="@showScanner" OnScanned="OnQrScanned" OnClosed="() => showScanner = false" />

@code {
    /// <summary>Re-render when the language changes (spec 028).</summary>
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private enum AuthResult { None, Success, Failed }

    private const string HistoryStorageKey = DigiIdLoginRecord.HistoryStorageKey;
    private const int MaxHistoryEntries = 50;

    private string digiIdUri = "";
    // Messages are kept as text producers, so they follow a language switch while shown.
    private Func<string>? parseError;
    private bool isAuthenticating;
    private int authStep; // 0=idle, 1=signing, 2=sending, 3=verifying
    private AuthResult authResult = AuthResult.None;
    private string? lastAuthDomain;
    private string? lastAuthAddress;
    private Func<string>? authErrorTitle;
    private Func<string>? authErrorDetail;
    private bool showScanner;
    private DigiByte.Crypto.DigiId.DigiIdRequest? pendingRequest;
    private List<DigiIdLoginRecord> authHistory = [];
    private string? pendingAddress;
    private DigiIdLoginRecord? selectedEntry;
    private int selectedRow = -1;
    private readonly Dictionary<int, ElementReference> rowRefs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
        Nav.LocationChanged += OnLocationChanged;
        await HandleIncomingUriAsync();
    }

    // The menu's Scan button can deliver a login code while this page is already open: the address changes but the
    // page is not created again, so it has to look at the address a second time.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(HandleIncomingUriAsync);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private string? handledUri;
    // The ?return= address the arriving code came with (unchecked), and the checked one shown after approval.
    private string? incomingReturn;
    private DigiByte.Wallet.Services.SiteReturn? siteReturn;

    private async Task HandleIncomingUriAsync()
    {
        // Auto-populate from query parameter if present
        // Sources: PWA protocol handler (?uri=web+digiid:...) or API redirect (?uri=digiid://...)
        var navUri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(navUri.Query);
        var incomingUri = query["uri"];
        var returnParam = query["return"];
        
        if (!string.IsNullOrEmpty(incomingUri))
        {
            // PWA protocol_handlers use "web+digiid" scheme — normalize to "digiid"
            if (incomingUri.StartsWith("web+digiid://", StringComparison.OrdinalIgnoreCase))
                incomingUri = "digiid://" + incomingUri.Substring("web+digiid://".Length);

            if (incomingUri.StartsWith("digiid://", StringComparison.OrdinalIgnoreCase))
            {
                // Opened from a link while the wallet is locked: unlock first, then come back with the same URI.
                if (!WalletService.IsUnlocked)
                {
                    var back = "/identity?uri=" + Uri.EscapeDataString(incomingUri);
                    // The site's return address comes back too; it is checked only after approval.
                    if (!string.IsNullOrEmpty(returnParam)) back += "&return=" + Uri.EscapeDataString(returnParam);
                    Nav.NavigateTo("/unlock?returnUrl=" + Uri.EscapeDataString(back));
                    return;
                }

                // Each arriving code is acted on once, however many times the address is looked at.
                if (incomingUri == handledUri) return;
                handledUri = incomingUri;
                incomingReturn = returnParam;

                digiIdUri = incomingUri;
                StateHasChanged();
                await Task.Delay(100); // brief delay for UI to render
                await AuthenticateAsync();
            }
        }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var json = await Storage.GetAsync(HistoryStorageKey);
            if (json != null)
                authHistory = System.Text.Json.JsonSerializer.Deserialize<List<DigiIdLoginRecord>>(json) ?? [];
        }
        catch { /* non-critical — start fresh if storage fails */ }
    }

    private async Task SaveHistoryAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(authHistory);
            await Storage.SetAsync(HistoryStorageKey, json);
        }
        catch { }
    }

    private async Task ClearHistoryAsync()
    {
        authHistory.Clear();
        selectedEntry = null;
        rowRefs.Clear();
        await Storage.RemoveAsync(HistoryStorageKey);
    }

    private void ScanDigiId()
    {
        showScanner = true;
    }

    private void OnQrScanned(string value)
    {
        showScanner = false;
        digiIdUri = value;
        StateHasChanged();

        // Auto-parse if it looks like a Digi-ID URI
        if (value.StartsWith("digiid://", StringComparison.OrdinalIgnoreCase))
        {
            _ = AuthenticateAsync();
        }
    }

    private async Task AuthenticateAsync()
    {
        parseError = null;
        authResult = AuthResult.None;

        var request = DigiByte.Crypto.DigiId.DigiIdService.ParseUri(digiIdUri.Trim());
        if (request == null)
        {
            parseError = () => L.T("identity.error.invalidUri");
            return;
        }

        pendingRequest = request;
        pendingAddress = TryGetSigningAddress(request.Domain);
    }

    // Same derivation the signing step uses, so what the user sees is what gets signed.
    // Null when the wallet is locked or watch-only; Approve then reports the wallet error as before.
    private string? TryGetSigningAddress(string domain)
    {
        try { return WalletService.GetDigiIdAddress(domain); }
        catch (InvalidOperationException) { return null; }
    }

    private void CancelAuth()
    {
        pendingRequest = null;
        pendingAddress = null;
    }

    private void OpenDetails(DigiIdLoginRecord entry, int row)
    {
        selectedEntry = entry;
        selectedRow = row;
    }

    private async Task CloseDetailsAsync()
    {
        var row = selectedRow;
        selectedEntry = null;
        selectedRow = -1;
        StateHasChanged();

        // Return focus to the row that opened the dialog.
        if (rowRefs.TryGetValue(row, out var el))
        {
            try { await el.FocusAsync(); } catch { }
        }
    }

    private void ResetState()
    {
        authResult = AuthResult.None;
        siteReturn = null;
        parseError = null;
        authErrorTitle = null;
        authErrorDetail = null;
        pendingRequest = null;
        pendingAddress = null;
        digiIdUri = "";
    }

    /// <summary>Returns the proxy's short reason when the reply is a proxy refusal ({"source":"proxy","reason":...}); null for a real site reply.</summary>
    private static string? ReadProxyReason(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object
                && root.TryGetProperty("source", out var source) && source.GetString() == "proxy"
                && root.TryGetProperty("reason", out var reason))
                return reason.GetString() ?? "";
        }
        catch (System.Text.Json.JsonException) { }
        return null;
    }

    private async Task RetryAuth()
    {
        authResult = AuthResult.None;
        authErrorTitle = null;
        authErrorDetail = null;

        if (pendingRequest != null)
        {
            await ConfirmAuthAsync();
        }
    }

    private async Task ConfirmAuthAsync()
    {
        if (pendingRequest == null) return;

        // Baku, the guardian: warn on a first-time or insecure (HTTP) site. Never blocks a confirmed login.
        var risk = DigiIdRiskEvaluator.Evaluate(
            pendingRequest.Domain, pendingRequest.IsUnsecure, authHistory.Select(h => h.Domain));
        if (!await Baku.ConfirmDigiIdRiskAsync(risk)) return;

        isAuthenticating = true;
        authStep = 1;
        parseError = null;
        authResult = AuthResult.None;
        StateHasChanged();

        try
        {
            // Step 1: Sign the URI with site-specific HD key (m/13'/siteIndex'/0'/0)
            var response = await WalletService.SignDigiIdAsync(pendingRequest);

            // Step 2: POST the signed response via API proxy (avoids CORS)
            authStep = 2;
            StateHasChanged();
            await Task.Delay(200); // brief visual pause for step transition

            var apiBase = Config["PriceApiUrl"]?.Replace("/api/price", "") ?? "http://localhost:5007";
            var proxyPayload = new
            {
                callbackUrl = pendingRequest.CallbackUrl,
                address = response.Address,
                uri = response.Uri,
                signature = response.Signature,
            };
            var httpResponse = await Http.PostAsJsonAsync($"{apiBase}/api/digiid/callback", proxyPayload);

            // Step 3: Verify server response
            authStep = 3;
            StateHasChanged();
            await Task.Delay(200);

            if (!httpResponse.IsSuccessStatusCode)
            {
                var body = await httpResponse.Content.ReadAsStringAsync();
                var statusCode = (int)httpResponse.StatusCode;

                // The proxy refused or could not reach the site (it says so with source:"proxy"); that is not the site rejecting the signature.
                var proxyReason = ReadProxyReason(body);
                if (proxyReason is not null)
                {
                    authErrorTitle = () => L.T("identity.error.proxy.title");
                    var proxyKey = proxyReason switch
                    {
                        "must use https" => "identity.error.proxy.https",
                        "site unreachable" => "identity.error.proxy.unreachable",
                        "rate limited" => "identity.error.proxy.rateLimited",
                        "bad signature" => "identity.error.proxy.badSignature",
                        _ => "identity.error.proxy.other",
                    };
                    authErrorDetail = () => L.T(proxyKey);
                    authResult = AuthResult.Failed;
                    return;
                }

                var domain = pendingRequest.Domain;
                authErrorTitle = statusCode switch
                {
                    401 or 403 => () => L.T("identity.error.rejected.title", domain),
                    404 => () => L.T("identity.error.notFound.title", domain),
                    >= 500 => () => L.T("identity.error.server.title", domain),
                    _ => () => L.T("identity.error.status.title", domain, statusCode)
                };
                authErrorDetail = statusCode switch
                {
                    401 or 403 => () => L.T("identity.error.rejected.detail"),
                    404 => () => L.T("identity.error.notFound.detail"),
                    >= 500 => () => L.T("identity.error.server.detail", statusCode),
                    // The site's own reply is shown as it came.
                    _ => !string.IsNullOrWhiteSpace(body) ? () => body : null
                };

                authResult = AuthResult.Failed;
                return;
            }

            // Success
            lastAuthDomain = pendingRequest.Domain;
            // Offer the way back only for the code that arrived with it, and only to the same site as the request.
            siteReturn = pendingRequest.OriginalUri == handledUri
                ? DigiByte.Wallet.Services.SiteReturnUrl.ForDigiId(incomingReturn, pendingRequest.CallbackUrl)
                : null;
            lastAuthAddress = response.Address;

            authHistory.Insert(0, new DigiIdLoginRecord
            {
                Domain = pendingRequest.Domain,
                Address = response.Address,
                Timestamp = DateTime.UtcNow,
                CallbackUrl = pendingRequest.CallbackUrl,
                Uri = pendingRequest.OriginalUri,
                Nonce = pendingRequest.Nonce,
                Signature = response.Signature,
                IsUnsecure = pendingRequest.IsUnsecure,
            });

            // Keep last MaxHistoryEntries, then persist
            if (authHistory.Count > MaxHistoryEntries)
                authHistory = authHistory.Take(MaxHistoryEntries).ToList();
            await SaveHistoryAsync();

            pendingRequest = null;
            pendingAddress = null;
            authResult = AuthResult.Success;
            digiIdUri = "";
        }
        catch (HttpRequestException)
        {
            var unreachable = pendingRequest?.Domain;
            authErrorTitle = () => L.T("identity.error.unreachable.title", unreachable ?? L.T("identity.server"));
            authErrorDetail = () => L.T("identity.error.unreachable.detail");
            authResult = AuthResult.Failed;
        }
        catch (InvalidOperationException ex)
        {
            authErrorTitle = () => L.T("identity.error.wallet");
            var message = ex.Message; // written by the wallet service
            authErrorDetail = () => message;
            authResult = AuthResult.Failed;
        }
        catch (Exception ex)
        {
            authErrorTitle = () => L.T("identity.error.unexpected");
            var message = ex.Message;
            authErrorDetail = () => message;
            authResult = AuthResult.Failed;
        }
        finally
        {
            isAuthenticating = false;
            authStep = 0;
        }
    }

    private static string TruncateAddress(string address)
    {
        if (address.Length <= 16) return address;
        return $"{address[..8]}…{address[^6..]}";
    }

    private string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        if (diff.TotalMinutes < 1) return L.T("identity.time.justNow");
        if (diff.TotalHours < 1) return L.T("identity.time.minutes", (int)diff.TotalMinutes);
        if (diff.TotalDays < 1) return L.T("identity.time.hours", (int)diff.TotalHours);
        if (diff.TotalDays < 7) return L.T("identity.time.days", (int)diff.TotalDays);
        return utcTime.ToLocalTime().ToString(L.T("history.format.month_day"));
    }
}
