@page "/multisig"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject NavigationManager Nav
@inject AppState AppState

<PageTitle>Multisig Wallets — DigiByte Wallet</PageTitle>

<AuthGuard>
<div class="flex flex-col gap-4">
    <PageHeader Title="Multisig Wallets">
        <button class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-xl bg-dgb-500 hover:bg-dgb-600 text-white transition-colors press-effect"
                aria-label="Create multisig wallet"
                @onclick='() => Nav.NavigateTo("/multisig/create")'>
            <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </button>
    </PageHeader>

    @if (isLoading)
    {
        <div class="flex flex-col gap-3">
            @for (int i = 0; i < 2; i++)
            {
                <div class="card p-4">
                    <div class="h-5 w-40 skeleton rounded"></div>
                    <div class="h-4 w-60 skeleton rounded mt-2"></div>
                </div>
            }
        </div>
    }
    else
    {
        @if (unassigned.Count > 0 && !unassignedDismissed)
        {
            <div class="p-4 bg-amber-50 dark:bg-amber-900/10 rounded-2xl border border-amber-200 dark:border-amber-800/30 slide-up-delay-1" role="region" aria-label="Unassigned multisigs">
                <p class="text-sm font-bold text-amber-800 dark:text-amber-300">Unassigned multisigs</p>
                <p class="text-xs text-amber-700 dark:text-amber-400 mt-0.5 leading-relaxed">
                    These were saved before multisigs were tied to a wallet and none of your wallets' keys is in them.
                    Claim one to add it to <b>@ActiveWallet.WalletName</b>.
                </p>
                <div class="flex flex-col gap-2 mt-3">
                    @foreach (var item in unassigned)
                    {
                        <div class="flex items-center justify-between gap-2 p-2.5 bg-white/70 dark:bg-dgb-900/60 rounded-xl">
                            <span class="text-sm font-medium text-slate-900 dark:text-white truncate">@item.Name</span>
                            <button type="button" class="min-h-[44px] px-4 bg-dgb-500 hover:bg-dgb-600 text-white text-xs font-semibold rounded-xl press-effect shrink-0"
                                    @onclick="() => Claim(item.Id)">Claim</button>
                        </div>
                    }
                </div>
                <button type="button" class="min-h-[44px] mt-1 text-xs font-medium text-amber-700 dark:text-amber-400" @onclick="() => unassignedDismissed = true">Not now</button>
            </div>
        }

        @if (wallets.Count == 0 && drafts.Count == 0)
        {
            <div class="flex flex-col items-center justify-center gap-4 py-12 text-center slide-up-delay-1">
                <div class="w-16 h-16 rounded-full bg-dgb-50 dark:bg-dgb-900/50 flex items-center justify-center">
                    <svg class="w-8 h-8 text-dgb-400" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">No Multisig Wallets</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-[260px]">
                        Create a shared wallet that requires multiple signatures to spend funds.
                    </p>
                </div>
                <button class="btn-primary btn-sm"
                        @onclick='() => Nav.NavigateTo("/multisig/create")'>
                    Create Multisig Wallet
                </button>
            </div>
        }
        else
        {
            @if (drafts.Count > 0)
            {
                <div class="flex flex-col gap-2 slide-up-delay-1">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-1">Drafts · waiting for co-signers</p>
                    @foreach (var draft in drafts)
                    {
                        var filled = draft.CoSigners.Count(c => !string.IsNullOrWhiteSpace(c.PublicKeyHex));
                        var needed = draft.TotalSigners - 1;
                        <div class="p-4 bg-amber-50/60 dark:bg-amber-900/10 rounded-2xl border border-amber-200/80 dark:border-amber-800/30">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <button type="button" class="flex items-center gap-1.5 max-w-full min-h-[32px] text-left group" aria-label="Rename draft @draft.Name"
                                            @onclick="() => StartRenameDraft(draft)">
                                        <span class="text-sm font-semibold text-slate-900 dark:text-white truncate">@draft.Name</span>
                                        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-dgb-500 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                                    </button>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">@draft.Label draft · @filled of @needed co-signer keys added</p>
                                </div>
                                <span class="text-[11px] font-bold text-amber-700 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/30 px-2 py-0.5 rounded-full flex-shrink-0">DRAFT</span>
                            </div>
                            <div class="flex items-center gap-2 mt-3">
                                <button class="btn-primary btn-sm flex-1"
                                        @onclick="() => ContinueDraft(draft.Id)">Continue</button>
                                @if (confirmDeleteId == draft.Id)
                                {
                                    <button class="btn-danger btn-sm"
                                            @onclick="() => DeleteDraft(draft.Id)">Delete draft?</button>
                                    <button class="min-h-[44px] py-2 px-3 text-xs font-medium text-slate-500" @onclick="() => confirmDeleteId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="min-h-[44px] py-2 px-3 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-red-500"
                                            @onclick="() => confirmDeleteId = draft.Id">Delete</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (attention.Total > 0)
            {
                <p class="flex items-center gap-2 px-1 text-xs font-semibold text-slate-600 dark:text-slate-300" role="status">
                    <AttentionBadge Count="attention.Total" />
                    <span>@(attention.Total == 1 ? "1 payment needs your signature" : $"{attention.Total} payments need your signature")</span>
                </p>
            }

            <div class="flex flex-col gap-2">
                @foreach (var (wallet, config) in wallets)
                {
                    <div class="card slide-up-delay-1 card-hover">
                        <div class="flex items-center">
                            <button class="flex-1 min-w-0 p-4 pr-2 text-left" aria-label="Open @wallet.Name" @onclick="() => OpenWallet(wallet.Id)">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-dgb-50 dark:bg-dgb-800 flex items-center justify-center shrink-0">
                                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@wallet.Name</p>
                                            <AttentionBadge Count="attention.For(wallet.Id)" />
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            @(config?.RequiredSignatures)-of-@(config?.TotalSigners) multisig
                                        </p>
                                    </div>
                                </div>
                                @if (config != null)
                                {
                                    <p class="text-[11px] font-mono text-slate-400 dark:text-slate-500 mt-2 truncate">@MultisigFormat.Short(config.Address, 12, 8)</p>
                                }
                            </button>
                            <button type="button" class="min-w-[44px] min-h-[44px] mr-1 flex items-center justify-center text-slate-400 hover:text-dgb-500" aria-label="Rename @wallet.Name"
                                    @onclick="() => StartRenameWallet(wallet)">
                                <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* Import option *@
    <div class="slide-up-delay-2">
        <button class="w-full min-h-[44px] py-3 text-sm text-dgb-500 hover:text-dgb-600 font-medium"
                @onclick='() => Nav.NavigateTo("/multisig/import")'>
            Import Existing Multisig Wallet
        </button>
    </div>
</div>

<RenameDialog IsOpen="@(renameWallet is not null || renameDraft is not null)"
              Title="@(renameDraft is not null ? "Rename draft" : "Rename multisig")"
              Initial="@(renameDraft?.Name ?? renameWallet?.Name ?? "")"
              OnSave="SaveRename"
              OnClosed="OnRenameClosed" />
</AuthGuard>

@code {
    private record WalletEntry(string Id, string Name);

    private bool isLoading = true;
    private List<(WalletEntry Wallet, MultisigWalletConfig? Config)> wallets = [];
    private List<MultisigDraft> drafts = [];
    private AttentionSummary attention = new([]);
    private List<(string Id, string Name)> unassigned = [];
    private bool unassignedDismissed;
    private string? confirmDeleteId;
    private WalletEntry? renameWallet;
    private MultisigDraft? renameDraft;

    private void ContinueDraft(string draftId) => Nav.NavigateTo($"/multisig/create?draft={draftId}");

    private async Task DeleteDraft(string draftId)
    {
        await MultisigService.DeleteDraftAsync(draftId);
        drafts.RemoveAll(d => d.Id == draftId);
        confirmDeleteId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try { await Load(); }
        finally { isLoading = false; }
    }

    private async Task Load()
    {
        var owner = ActiveWallet.WalletId;
        var key = ActiveWallet.PublicKey;
        drafts = await MultisigService.ListDraftsAsync(owner, key);
        wallets = [];
        foreach (var (id, name) in await MultisigService.ListWalletsAsync(owner, key))
        {
            var config = await MultisigService.GetConfigAsync(id, owner, key);
            wallets.Add((new WalletEntry(id, name), config));
        }
        unassigned = await MultisigService.ListUnassignedAsync();
        await LoadAttentionAsync();
    }

    // Counts come from the proposals saved on this device; this list only shows the active wallet's multisigs,
    // which are readable while the app is unlocked, so no extra unlock is needed (spec 018, FR-012).
    private async Task LoadAttentionAsync()
    {
        var pending = new List<PendingMultisigTransaction>();
        foreach (var (wallet, _) in wallets)
        {
            try { pending.AddRange(await MultisigService.GetPendingTransactionsAsync(wallet.Id)); }
            catch { /* a wallet whose proposals can't be read simply shows no badge */ }
        }
        var keys = wallets.ToDictionary(w => w.Wallet.Id, w => w.Config?.CoSigners.FirstOrDefault(c => c.IsLocal)?.PublicKeyHex);
        attention = AttentionCounter.Count(pending, id => keys.GetValueOrDefault(id));
    }

    private async Task Claim(string walletId)
    {
        await MultisigService.ClaimAsync(walletId, ActiveWallet.WalletId);
        await Load();
    }

    private void StartRenameWallet(WalletEntry wallet) { renameDraft = null; renameWallet = wallet; }
    private void StartRenameDraft(MultisigDraft draft) { renameWallet = null; renameDraft = draft; }

    private async Task<RenameResult> SaveRename(string name)
    {
        var result = renameDraft is not null
            ? await MultisigService.RenameDraftAsync(renameDraft.Id, name)
            : renameWallet is not null
                ? await MultisigService.RenameWalletAsync(renameWallet.Id, name)
                : new RenameResult(false, "Nothing to rename.", false, null);
        if (result.Ok) await Load();
        return result;
    }

    private void OnRenameClosed()
    {
        renameWallet = null;
        renameDraft = null;
    }

    private void OpenWallet(string walletId)
    {
        Nav.NavigateTo($"/multisig/{walletId}");
    }
}
