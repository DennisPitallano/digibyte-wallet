@page "/"
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject ClipboardService Clipboard
@inject UsageCounter UsageCounter
@inject ContactService ContactService
@inject AddressLabelService LabelService
@inject WalletService WalletService
@inject NetworkStatusService Network
@inject MemoryCacheService Cache
@inject IBlockchainService Blockchain
@inject ISecureStorage Storage
@inject TransactionTracker TxTracker
@inject MarketSnapshotService Market
@inject NotificationService Notifications

<PageTitle>DigiByte Wallet — Self-Custodial DGB Wallet</PageTitle>

<AuthGuard>
    <OnboardingWalkthrough />
    <div class="flex flex-col gap-4" @ontouchstart="OnTouchStart" @ontouchmove="OnTouchMove" @ontouchend="OnTouchEnd">
        @* Pull-to-refresh indicator *@
        @if (pullDistance > 0)
        {
            <div class="flex justify-center -mb-2 transition-all duration-150" style="height: @(Math.Min(pullDistance / 2, 40))px; opacity: @(Math.Min(pullDistance / 80.0, 1))">
                <div class="w-6 h-6 border-2 border-dgb-500 border-t-transparent rounded-full @(isRefreshing ? "animate-spin" : "")"
                     style="transform: rotate(@(pullDistance * 2)deg)"></div>
            </div>
        }

        @* ===== Balance + Actions (normal flow) ===== *@
        <div>
            @* Wallet Header: wallet picker on the left, "Supported by" pill on the right. Either may be absent; an empty row takes no space. *@
            <div class="flex items-center gap-2">
            @if (allWallets.Count > 1)
            {
                var activeColor = WalletService.ActiveWallet?.Color ?? "#0066FF";
                <button class="flex items-center gap-1.5 mb-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 hover:border-dgb-300 dark:hover:border-dgb-400/30 transition-all press-effect"
                        @onclick="() => showWalletPicker = true">
                    <div class="w-2.5 h-2.5 rounded-full flex-shrink-0 shadow-sm" style="background-color: @activeColor;"></div>
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 truncate max-w-[140px]">@(WalletService.ActiveWallet?.Name ?? "Wallet")</span>
                    <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
            }
                @* Newest sponsors: loads quietly in the background and hides itself on any problem. *@
                <SponsorsStrip />
            </div>

            @* Balance Card Stack *@
            <div class="relative">
            @if (allWallets.Count > 1)
            {
                @for (var i = Math.Min(allWallets.Count - 1, 2); i >= 1; i--)
                {
                    var ni = (activeCardIndex + i) % allWallets.Count;
                    var lc = allWallets[ni].Color ?? "#0066FF";
                    <div class="absolute inset-x-0 top-1 bottom-1 rounded-2xl border border-white/[0.06]"
                         style="transform: translateX(@(i * 10)px) scale(@(1 - i * 0.04)); background: linear-gradient(135deg, @(lc)18, @(lc)08); z-index: @(5 - i);"></div>
                }
            }
            @* Balance Card. With a finish chosen, the card becomes that material in the wallet's colour and its text stays light. *@
            @{ var cardTexture = WalletInfo.NormalizeTexture(WalletService.ActiveWallet?.Texture); }
            <div class="@(cardTexture == WalletInfo.DefaultTexture ? "" : "dark wallet-card-textured") relative overflow-hidden rounded-2xl bg-white dark:bg-gradient-to-br dark:from-dgb-900 dark:via-dgb-800 dark:to-dgb-700 border border-dgb-200 dark:border-dgb-700/50 px-5 py-4 text-dgb-900 dark:text-white shadow-lg shadow-gray-200/50 dark:shadow-dgb-900/25"
                 style="z-index: 10; transform: translateX(@(cardSwipeOffset)px); @(isCardAnimating ? "transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);" : "")">
                @* Tinted with the wallet's own colour, so multi-wallet users can tell wallets apart at a glance *@
                <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full blur-2xl" style="background-color: @(WalletService.ActiveWallet?.Color ?? "#0066FF")40;"></div>
                @* The wallet's chosen finish (leather, cotton, plastic, metal), set in Manage Wallets. "smooth" draws nothing. *@
                <div class="wallet-tex wallet-tex-@cardTexture" style="--wc: @(WalletService.ActiveWallet?.Color ?? "#0066FF");" aria-hidden="true"></div>
                <div class="absolute left-0 top-4 bottom-4 w-1 rounded-r-full" style="background-color: @(WalletService.ActiveWallet?.Color ?? "#0066FF");"></div>
                <div class="absolute -bottom-6 -left-6 w-20 h-20 bg-dgb-50/50 dark:bg-dgb-400/10 rounded-full blur-xl"></div>
                <div class="absolute -bottom-4 -right-4 opacity-[0.08] dark:opacity-[0.10] pointer-events-none">
                    <SpinningCoin Size="120" />
                </div>
                <div class="relative">
                    <div class="flex items-center gap-2">
                        <p class="text-xs text-dgb-600 dark:text-dgb-200 font-medium">Total Balance</p>
                        @if (AppState.NetworkMode != "mainnet")
                        {
                            <span class="text-[11px] font-bold text-amber-700 dark:text-amber-300 bg-amber-500/20 px-1.5 py-0.5 rounded-full uppercase">@AppState.NetworkMode</span>
                        }
                        @if (WalletService.ActiveWallet?.WalletType == "xpub")
                        {
                            <span class="text-[11px] font-bold text-sky-700 dark:text-sky-300 bg-sky-500/20 px-1.5 py-0.5 rounded-full uppercase">Watch-Only</span>
                        }
                        @if (isLoadingBalance)
                        {
                            <div class="w-2.5 h-2.5 border-2 border-dgb-500 dark:border-dgb-300 border-t-transparent rounded-full animate-spin"></div>
                        }
                        <OutOfDateTag />
                        <div class="flex-1"></div>
                        <button type="button" class="p-1 rounded-lg hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors"
                                title="@(hideBalance ? "Show balance" : "Hide balance")" aria-label="@(hideBalance ? "Show balance" : "Hide balance")" aria-pressed="@(hideBalance ? "true" : "false")"
                                @onclick="ToggleHideBalanceAsync">
                            <svg class="w-4 h-4 text-dgb-500 dark:text-dgb-300" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                @if (hideBalance)
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                                }
                                else
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                }
                            </svg>
                        </button>
                        <button type="button" class="p-1 rounded-lg hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors disabled:opacity-40" title="Refresh" aria-label="Refresh"
                                @onclick="ManualRefreshAsync" disabled="@isRefreshing">
                            <svg class="w-4 h-4 text-dgb-500 dark:text-dgb-300 @(isRefreshing ? "animate-spin" : "")" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182M20.015 4.356v4.992" />
                            </svg>
                        </button>
                        <button type="button" class="p-1 rounded-lg hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors" title="Wallet Info" aria-label="Wallet info"
                                @onclick="() => showWalletInfo = true">
                            <svg class="w-4 h-4 text-dgb-500 dark:text-dgb-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                            </svg>
                        </button>
                    </div>
                    @if (isLoadingBalance && balance.ConfirmedSatoshis == 0)
                    {
                        <div class="h-9 w-40 skeleton mt-1 rounded-lg" style="background:rgba(0,102,204,0.1)"></div>
                        <div class="h-4 w-24 skeleton mt-1.5 rounded" style="background:rgba(0,102,204,0.08)"></div>
                    }
                    else if (hideBalance)
                    {
                        <h1 class="text-3xl font-extrabold mt-0.5 balance-mask" aria-label="Balance hidden">••••••</h1>
                        <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5">Balance hidden</p>
                    }
                    else if (AppState.IsSimpleMode)
                    {
                        <h1 class="@BalanceSize(AppState.FiatSymbol + FormatFiat(fiatValue)) font-extrabold mt-0.5 tracking-tight whitespace-nowrap tabular-nums">@AppState.FiatSymbol@FormatFiat(ShownFiat)</h1>
                        @if (isLoadingPrice)
                        {
                            <div class="h-4 w-28 skeleton mt-1 rounded" style="background:rgba(0,102,204,0.08)"></div>
                        }
                        else
                        {
                            <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5 tabular-nums">@ShownDgb.ToString("N8") DGB</p>
                        }
                    }
                    else
                    {
                        <h1 class="@BalanceSize(balance.TotalDgb.ToString("N8")) font-extrabold mt-0.5 tracking-tight whitespace-nowrap tabular-nums">@ShownDgb.ToString("N8") <span class="text-base font-bold opacity-80">DGB</span></h1>
                        @if (isLoadingPrice)
                        {
                            <div class="h-4 w-28 skeleton mt-1 rounded" style="background:rgba(0,102,204,0.08)"></div>
                        }
                        else
                        {
                            <p class="text-xs text-dgb-500 dark:text-dgb-300 mt-0.5 tabular-nums">@AppState.FiatSymbol@FormatFiat(ShownFiat) @AppState.FiatCurrency</p>
                        }
                    }

                    @* DGB price move: 24h change and a 7-day sparkline; opens Analytics. Left out when the data is unavailable. *@
                    @if (market is not null)
                    {
                        var up = market.Change24h >= 0;
                        <a href="/analytics" class="mt-1.5 flex items-center gap-2 w-fit no-underline"
                           aria-label="DGB price @(up ? "up" : "down") @Math.Abs(market.Change24h).ToString("N2") percent in 24 hours. Open analytics.">
                            <span class="inline-flex items-center gap-1 text-[11px] font-semibold tabular-nums px-1.5 py-0.5 rounded-full @(up ? "text-green-700 dark:text-green-300 bg-green-500/15" : "text-red-700 dark:text-red-300 bg-red-500/15")">
                                <span aria-hidden="true">@(up ? "▲" : "▼")</span>@Math.Abs(market.Change24h).ToString("N2")%
                            </span>
                            <span class="text-[11px] text-dgb-500/80 dark:text-dgb-300/80">DGB 24h</span>
                            @if (market.SparkPath is not null)
                            {
                                <svg viewBox="0 0 100 24" preserveAspectRatio="none" class="w-16 h-5" aria-hidden="true">
                                    <path d="@market.SparkPath" fill="none" stroke="@(market.SparkUp ? "#22c55e" : "#ef4444")" stroke-width="1.5"
                                          stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                                </svg>
                                <span class="text-[11px] text-dgb-500/80 dark:text-dgb-300/80">7d</span>
                            }
                        </a>
                    }

                    @* Wallet address with copy & QR *@
                    @if (!string.IsNullOrEmpty(receivingAddress))
                    {
                        <div class="flex items-center gap-1.5 mt-2 pt-2 border-t border-dgb-300/30 dark:border-white/10">
                            <span class="text-[11px] font-mono text-dgb-500/70 dark:text-dgb-300/80 truncate flex-1">@TruncateAddress(receivingAddress)</span>
                            <button type="button" class="p-1 rounded hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors" title="Copy address" aria-label="Copy address"
                                    @onclick="CopyAddress">
                                <svg class="w-3.5 h-3.5 text-dgb-500 dark:text-dgb-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                                </svg>
                            </button>
                            <button type="button" class="p-1 rounded hover:bg-dgb-200/50 dark:hover:bg-white/10 transition-colors" title="Show QR code" aria-label="Show QR code"
                                    @onclick="ShowAddressQr">
                                <svg class="w-3.5 h-3.5 text-dgb-500 dark:text-dgb-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 14.625v2.625m3.375-2.625v2.625m-6.75 0h8.25" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
            @* Wallet Indicators *@
            @if (allWallets.Count > 1)
            {
                <div class="flex justify-center gap-1.5 mt-2.5" style="position: relative; z-index: 15;">
                    @for (var i = 0; i < allWallets.Count; i++)
                    {
                        var idx = i;
                        var dc = allWallets[idx].Color ?? "#0066FF";
                        <div class="rounded-full transition-all duration-300 @(idx == activeCardIndex ? "w-5 h-1.5" : "w-1.5 h-1.5 opacity-40")"
                             style="background-color: @dc;"></div>
                    }
                </div>
            }
            </div> @* end card stack *@

            @* Action buttons: the four everyday actions plus More, which opens a sheet with the rest. *@
            <div class="flex justify-center gap-5 mt-3">
                <button type="button" class="flex flex-col items-center gap-1 group disabled:opacity-40" @onclick="OnSend" disabled="@isWatchOnly">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                        </svg>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Send</span>
                </button>
                <button type="button" class="flex flex-col items-center gap-1 group" @onclick="OnReceive">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                        </svg>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Receive</span>
                </button>
                <button type="button" class="flex flex-col items-center gap-1 group" @onclick="OnScan">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 14.625v2.625m3.375-2.625v2.625M16.875 20.25h-3.375v-2.625" />
                        </svg>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Scan</span>
                </button>
                <button type="button" class="flex flex-col items-center gap-1 group" @onclick="OnContacts">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Contacts</span>
                </button>
                <button type="button" class="flex flex-col items-center gap-1 group" @onclick="() => showMore = true" aria-haspopup="dialog">
                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 flex items-center justify-center shadow-sm group-active:scale-90 transition-transform">
                        <svg class="w-5 h-5 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                        </svg>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">More</span>
                </button>
            </div>
        </div>

        @* ===== DigiDollar (view/send switches, seed wallets only; loads independently of DGB) ===== *@
        <DigiDollarHomeCard DgbSatoshis="@(balance.ConfirmedSatoshis + balance.UnconfirmedSatoshis)" />
        <DigiDollarUnavailableLine />

        @* ===== TX AREA ===== *@
        <div>
            @* Quick Contacts *@
            @if (quickContacts.Count > 0 && !isWatchOnly)
            {
                <div class="mt-2 flex items-center gap-3">
                    <h3 class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider leading-tight shrink-0">Quick<br />send</h3>
                    <div class="flex-1 min-w-0 flex gap-3 overflow-x-auto thin-scrollbar">
                        @foreach (var c in quickContacts)
                        {
                            var contact = c;
                            <button @key="contact.Address" class="flex flex-col items-center gap-1 min-w-[52px] press-effect"
                                    @onclick="() => SendToContact(contact)">
                                @if (contact.IsWallet)
                                {
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background-color: @(contact.WalletColor ?? "#0066FF")20;">
                                        <svg class="w-4 h-4" style="color: @(contact.WalletColor ?? "#0066FF");" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" />
                                        </svg>
                                    </div>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-dgb-100 dark:bg-dgb-800 flex items-center justify-center">
                                        <span class="text-xs font-bold text-dgb-600 dark:text-dgb-400">@contact.Name[..1].ToUpper()</span>
                                    </div>
                                }
                                <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[52px]">@contact.Name</span>
