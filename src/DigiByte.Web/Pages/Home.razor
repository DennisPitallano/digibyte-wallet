    /// <summary>Counts the headline balance from the old value to the new one (about 0.6s, ease-out). Skipped under reduced motion.</summary>
    private async Task AnimateBalanceAsync(decimal from, decimal to)
    {
        var token = ++_animToken;
        try
        {
            if (await JS.InvokeAsync<bool>("domHelpers.prefersReducedMotion")) return;
        }
        catch { return; }

        const int steps = 18;
        for (var i = 1; i < steps; i++)
        {
            if (token != _animToken) return;
            var eased = 1 - Math.Pow(1 - i / (double)steps, 3);
            animatedDgb = from + (to - from) * (decimal)eased;
            StateHasChanged();
            await Task.Delay(33);
        }
        if (token == _animToken)
        {
            animatedDgb = null;
            StateHasChanged();
        }
    }

