        <= 15 => "text-[1.65rem] leading-8",
        _ => "text-2xl",
    };

    private string FormatFiat(decimal value)
    {
        var decimals = AppState.FiatDecimals; // 0 for yen, rupiah, shillings and similar
        if (value == 0) return decimals == 0 ? "0" : "0." + new string('0', decimals);
        var abs = Math.Abs(value);
        if (abs >= 1m) return value.ToString("N" + decimals);
        if (abs >= 0.01m) return value.ToString("N4");
        if (abs >= 0.001m) return value.ToString("N5");
        if (abs >= 0.0001m) return value.ToString("N6");
        return value.ToString("N8");
    }

