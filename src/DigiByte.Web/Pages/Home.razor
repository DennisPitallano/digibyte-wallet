                <p class="addr-balance text-[11px] font-mono text-slate-500 dark:text-slate-400 text-center break-all leading-relaxed select-all">@receivingAddress</p>
                <div class="flex gap-2 w-full">
                    <button class="btn-primary btn-sm flex-1"
                            @onclick="CopyAddress">Copy</button>
