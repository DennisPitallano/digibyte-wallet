    @* Address QR Code Modal *@
    @if (showAddressQr)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm" role="dialog" aria-modal="true" @onclick="() => showAddressQr = false">
            <div class="scale-in bg-white dark:bg-dgb-900 rounded-2xl shadow-2xl p-5 mx-4 max-w-xs w-full flex flex-col items-center gap-3"
                 @onclick:stopPropagation="true">
                <h3 class="block-title block-title-sm">Your Receiving Address</h3>
                @if (!string.IsNullOrEmpty(addressQrDataUri))
                {
