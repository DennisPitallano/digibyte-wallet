    @* Wallet Picker Bottom Sheet *@
    <WalletPickerSheet IsOpen="@showWalletPicker"
                       OnClose="() => showWalletPicker = false"
                       OnWalletSelected="OnWalletSwitched"
                       Wallets="@allWallets"
                       ActiveWalletId="@(WalletService.ActiveWallet?.Id)" />
</AuthGuard>

@code {
    [Inject] private AppState AppState { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private List<Contact> quickContacts = [];
    private WalletBalance balance = new();
    private decimal dgbPrice;
    // The main figure and its fiat value are the confirmed balance only (spec 023, FR-016); pending shows on its own line.
    private decimal fiatValue => balance.ConfirmedDgb * dgbPrice;
    private List<TransactionRecord> transactions = [];
    private bool isLoadingBalance;
    private bool isLoadingTx;
    private bool txLoadedOnce; // a history load has finished (well or badly) for the wallet on show
    private bool balanceLoadedOnce; // the same for a balance read
    // Nothing saved and no read finished yet: the zero in <see cref="balance"/> is only its starting value, not a balance.
    private bool NothingReadYet => !hasCachedData && !balanceLoadedOnce;
    private bool isLoadingPrice;
    private bool hasCachedData; // true = loaded real data from IndexedDB
    private bool fetchFailed; // true = network fetch errored (not just empty)
    private bool balanceFetchFailed;
    private bool txFetchFailed;
    // The last balance / history read was taken before the wallet had finished finding its used addresses. Such a read
    // covers only the addresses known then, so a zero or an empty list is not shown as fact and is not saved.
    private bool balanceUnsettled;
    private bool txUnsettled;
    private bool _settledRefetchDone;
    private bool SearchingAddresses => balanceUnsettled || txUnsettled;
    private string receivingAddress = "";
    private bool showAddressQr;
    private string? addressQrDataUri;
    private bool showWalletInfo;
    private bool isWatchOnly => WalletService.ActiveWallet?.WalletType == "xpub";
    private bool showWalletPicker;
    private List<WalletInfo> allWallets = [];

    // Hide-balance preference (kept across sessions on this device)
    private const string HideBalanceKey = "pref:hideBalance";
    private bool hideBalance;

    // Count-up when the balance changes: holds the in-between value while animating, null otherwise.
    private decimal? animatedDgb;
    private int _animToken;
    private decimal ShownDgb => animatedDgb ?? balance.ConfirmedDgb;
    private decimal ShownFiat => ShownDgb * dgbPrice;

    // 24h change + sparkline for the balance card
    private MarketSnapshot? market;

    // Contact names by address, to title transaction rows ("To Alice")
    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);

    // Getting-started checklist inputs
    private bool checklistReady;
    private bool hasUserContact;

    // Pull-to-refresh state
    private double pullDistance;
    private double touchStartY;
    private bool isRefreshing;
    private const double RefreshThreshold = 80;

    // Card carousel state
    private int activeCardIndex;
    private double touchStartX;
    private double cardSwipeOffset;
    private string swipeDirection = "";
    private bool isCardAnimating;
    private const double SwipeThreshold = 60;

    // The saved figures (cache:balance:{id}, cache:transactions:{id}, cache:lastFetch:{id}, cache:dgbPrice) go through
    // WalletSnapshotCache, which Transactions, Receive and Send read too (spec 023).
    private string ActiveWalletId => WalletService.ActiveWallet?.Id ?? "";

    protected override async Task OnInitializedAsync()
    {
        // Reset auto-lock timer on page load
        AppState.ResetLockTimer();

        // Anonymous aggregate count of home-screen views (denominator of SC-005); fire and forget.
        _ = UsageCounter.RecordAsync("home_view");

        WalletService.SetNetworkMode(AppState.NetworkMode);

        // Load wallet list for switcher
        try { allWallets = await WalletService.GetAllWalletsAsync(); } catch { }
        activeCardIndex = allWallets.FindIndex(w => w.Id == WalletService.ActiveWallet?.Id);
        if (activeCardIndex < 0) activeCardIndex = 0;

        _refreshLoop = new AutoRefreshLoop(JS);
        _announcer = new IncomingPaymentAnnouncer(Notifications, JS, Sounds);
        FirstReceive.Changed += OnFirstReceiveChanged;
        WalletService.AddressSearchFinished += OnAddressSearchFinished;

        // Fire all I/O in parallel — UI renders immediately with skeleton states
        var contactsTask = ContactService.GetAllWithWalletsAsync(WalletService);
        var addressTask = WalletService.IsUnlocked
            ? WalletService.GetReceivingAddressAsync()
            : Task.FromResult("");

        try { hideBalance = await Storage.GetAsync(HideBalanceKey) == "1"; } catch { }
        _ = LoadMarketAsync();

        // Try IndexedDB cache first — instant display
        await LoadFromCacheAsync();

        // The receiving address is derived on the device, so it must not wait for the network: an empty wallet shows it
        // (with its QR code) as the first thing to do, including offline (spec 025, FR-007).
        try { receivingAddress = await addressTask; } catch { }
        StateHasChanged();

        // Check if redirected from a send — force fresh fetch after a short delay
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var forceRefresh = uri.Query.Contains("refresh=1");

        if (forceRefresh)
        {
            // Brief delay so the explorer has a moment to index the new mempool tx,
            // then fetch fresh data immediately.
            await Task.Delay(750);
            await FetchAndCacheAsync();
        }
        else if (hasCachedData && !IsCacheStale())
        {
            // Cache is fresh — no network needed, render cached data
        }
        else if (hasCachedData)
        {
            // Cache exists but stale — show cached data now, refresh in background
            _ = FetchAndCacheAsync();
        }
        else
        {
            // No cache at all (first load) — must await network so UI gets data
            await FetchAndCacheAsync();
        }

        // Contacts & address are fast (IndexedDB) — await them
        try { ApplyContacts(await contactsTask); } catch { }
        checklistReady = true;

        // Start the always-on background refresh poller so incoming funds and new
        // transactions appear within ~15s without requiring a manual pull-to-refresh.
        StartAutoRefreshPoller();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-size tx list + disable page scroll (this page handles its own)
        await JS.InvokeVoidAsync("domHelpers.autoSizeTxList");
    }

    public async ValueTask DisposeAsync()
    {
        _animToken++; // stop any running count-up
        // Stop pending-tx confirmation poller
        if (_confirmationPollTimer != null)
        {
            await _confirmationPollTimer.DisposeAsync();
            _confirmationPollTimer = null;
        }
        // Stop background auto-refresh poller
        FirstReceive.Changed -= OnFirstReceiveChanged;
        WalletService.AddressSearchFinished -= OnAddressSearchFinished;
        if (_refreshLoop is not null) await _refreshLoop.StopAsync();
        // Restore page scroll when leaving this page
        try { await JS.InvokeVoidAsync("domHelpers.restoreScroll"); }
        catch { }
    }

    // ── Background auto-refresh poller ──────────────────────────────────────
    // Re-fetches balance + transactions every 15s (matches DGB's ~15s block
    // time) while the Home page is mounted, so newly received funds show up
    // automatically without a manual pull-to-refresh.
    //
    // Two optimizations to avoid unnecessary network/explorer load:
    //   1. Visibility pause — skip ticks while the tab is backgrounded.
    //   2. Idle backoff   — when fetched data hasn't changed, gradually
    //      stretch the effective interval (15s → 30s → 60s, capped). Resets
    //      to 15s the moment something changes or the user manually refreshes.
    //
    // The timer and the pacing live in AutoRefreshLoop / RefreshPacer, which the Receive page uses too (spec 025).
    // Created in OnInitializedAsync, not injected: each belongs to this page and ends with it.
    private AutoRefreshLoop _refreshLoop = null!;
    private IncomingPaymentAnnouncer _announcer = null!;
    private bool _isFetching;
    private string? _lastDataSignature;

    private void StartAutoRefreshPoller() =>
        _refreshLoop.Start(() => InvokeAsync(FetchAndCacheAsync), () => _isFetching);

    private void OnFirstReceiveChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The wallet has finished finding its used addresses. If what is on screen was read before that (or the read failed
    /// while the search was competing with it), read again now instead of waiting for the next background check, which can
    /// be a minute away. A read still running is followed up by <see cref="FetchAndCacheAsync"/> itself.
    /// </summary>
    private void OnAddressSearchFinished(string walletId) => _ = InvokeAsync(() =>
    {
        if (walletId != ActiveWalletId || _isFetching) return Task.CompletedTask;
        return SearchingAddresses || balanceFetchFailed || txFetchFailed ? FetchAndCacheAsync() : Task.CompletedTask;
    });

    /// <summary>Compute a cheap fingerprint of the current visible state to
    /// detect whether a fetch surfaced anything new.</summary>
    private string ComputeDataSignature() =>
        $"{balance.ConfirmedSatoshis}:{balance.UnconfirmedSatoshis}:{transactions.Count}:{(transactions.Count > 0 ? transactions[0].TxId : "")}";

    private void UpdateBackoffFromFetchResult()
    {
        var sig = ComputeDataSignature();
        var changed = sig != _lastDataSignature;
        if (changed) _lastDataSignature = sig;
        // Unchanged fetches stretch the interval (15 s, then 30 s, then 60 s); a change returns it to 15 s.
        _refreshLoop.Report(changed);
    }

    // ── Pending-transaction confirmation polling ────────────────────────────

    private System.Threading.Timer? _confirmationPollTimer;

    /// <summary>
    /// Starts a 15-second repeating timer that re-fetches confirmations for any
    /// unconfirmed transactions, mirroring DGB's ~15-second block time so the UI
    /// updates automatically without a manual pull-to-refresh.
    /// </summary>
    private void StartConfirmationPoller()
    {
        if (_confirmationPollTimer != null) return; // already running
        _confirmationPollTimer = new System.Threading.Timer(
            async _ => await PollPendingConfirmationsAsync(),
            null,
            dueTime: TimeSpan.FromSeconds(15),
            period: TimeSpan.FromSeconds(15));
    }

    private void StopConfirmationPoller()
    {
        _confirmationPollTimer?.Dispose();
        _confirmationPollTimer = null;
    }

    private async Task PollPendingConfirmationsAsync()
    {
        try
        {
            var hasPending = transactions.Any(t => t.Confirmations < 6);
            if (!hasPending)
            {
                StopConfirmationPoller();
                return;
            }

            TxTracker.SetActiveWallet(ActiveWalletId);
            await TxTracker.UpdateConfirmationsAsync(Blockchain);
            var updated = await TxTracker.GetAllAsync();

            // Merge updated confirmations into the current list
            foreach (var tx in transactions)
            {
                var fresh = updated.FirstOrDefault(u => u.TxId == tx.TxId);
                if (fresh != null && fresh.Confirmations != tx.Confirmations)
                    tx.Confirmations = fresh.Confirmations;
            }

            await InvokeAsync(StateHasChanged);

            if (!transactions.Any(t => t.Confirmations < 6))
                StopConfirmationPoller();
        }
        catch { /* ignore transient errors — will retry next interval */ }
    }

    /// <summary>Load balance, txs, and price from IndexedDB cache for instant display.</summary>
    private async Task LoadFromCacheAsync()
    {
        try
        {
            // Also loads the fetch time into the in-memory cache, so IsCacheStale() works on a fresh app start.
            var snapshot = await Snapshots.LoadAsync(ActiveWalletId);
            if (snapshot.Balance is { } cachedBalance)
            {
                balance = cachedBalance;
                hasCachedData = true;
            }

            if (snapshot.Price is { } p)
                dgbPrice = p;

            if (snapshot.Transactions is { Count: > 0 } cachedTxs)
            {
                transactions = cachedTxs;
                _announcer.Seed(ActiveWalletId, cachedTxs);
                // Saved history is enough to know this wallet did not start empty; it never celebrates (spec 025, FR-011).
                await FirstReceive.ObserveAsync(ActiveWalletId, cachedTxs, HistorySource.SavedSnapshot);
            }

            if (hasCachedData) StateHasChanged();
        }
        catch { }
    }

    private bool IsCacheStale()
    {
        // We don't await the timestamp here — check in-memory cache instead.
        // Short threshold so the first render after navigating back to Home
        // triggers a fresh network fetch rather than showing stale data.
        if (Cache.TryGet<DateTime>($"lastFetchTime:{ActiveWalletId}", out var ts))
            return (DateTime.UtcNow - ts).TotalSeconds > 30;
        return true; // no timestamp = treat as stale
    }

    /// <summary>Fetch fresh data from network, then persist to IndexedDB.</summary>
    private async Task FetchAndCacheAsync()
    {
        // Reentrancy guard so the background poller can't stack overlapping fetches
        if (_isFetching) return;
        _isFetching = true;

        // Guard against stale results when user switches wallets during a background fetch
        var walletIdAtStart = ActiveWalletId;

        try
        {
        fetchFailed = false;
        balanceFetchFailed = false;
        txFetchFailed = false;
        await Task.WhenAll(LoadBalanceAsync(), LoadTransactionsAsync());

        // Abort if user switched wallets while we were fetching
        if (ActiveWalletId != walletIdAtStart) return;

        // Only fetch price if we have a balance to convert
        if (!balanceFetchFailed && balance.ConfirmedDgb > 0)
            await LoadPriceAsync();

        // Abort if user switched wallets while we were fetching
        if (ActiveWalletId != walletIdAtStart) return;

        // Mark as failed only if both balance AND tx fetches errored
        fetchFailed = balanceFetchFailed && txFetchFailed;

        // Cache whatever we got (even zeros — a 0 balance is valid data)
        // Not when it was read before the address search finished: that zero is not known to be true, and saved it would
        // be shown as the balance on the next start.
        if (!fetchFailed && !SearchingAddresses)
            await SaveToCacheAsync();

        // Update poller backoff based on whether anything actually changed.
        UpdateBackoffFromFetchResult();

        StateHasChanged();
        }
        finally
        {
            _isFetching = false;
            // The search finished while this read was running: what it returned is already out of date.
            if (ActiveWalletId == walletIdAtStart && WalletService.IsUnlocked && WalletService.AddressesSettled
                && (SearchingAddresses || balanceFetchFailed || txFetchFailed) && !_settledRefetchDone)
            {
                _settledRefetchDone = true; // Once per wallet: a read that keeps failing is left to the background check.
                _ = InvokeAsync(FetchAndCacheAsync);
            }
        }
    }

    /// <summary>Persist balance, txs, and price to IndexedDB + update timestamp.</summary>
    private async Task SaveToCacheAsync()
    {
        await Snapshots.SaveAsync(ActiveWalletId, balance, transactions, dgbPrice);
    }

    private async Task LoadBalanceAsync()
    {
        isLoadingBalance = true;
        // Show the placeholder now. Without this the first load of a wallet with nothing saved keeps showing the initial
        // zero until the read returns, because nothing else renders between setting the flag and the result.
        StateHasChanged();
        try
        {
            // Keyed on the confirmed figure, so a pending payment that is dropped never moves the main balance (FR-016).
            var before = balance.ConfirmedDgb;
            var hadData = hasCachedData || before > 0;
            balance = await WithTimeout(WalletService.GetBalanceAsync());
            balanceUnsettled = !balance.AddressesSettled;
            if (hadData && !hideBalance && balance.ConfirmedDgb != before)
                _ = AnimateBalanceAsync(before, balance.ConfirmedDgb);
        }
        catch { balanceFetchFailed = true; }
        finally { isLoadingBalance = false; balanceLoadedOnce = true; StateHasChanged(); }
    }

    /// <summary>
    /// Stops waiting on a network read after <see cref="LoadTimeoutSeconds"/> so the page shows "Unable to load" with Retry
    /// in place of skeletons that never resolve. The read itself is left to finish or fail in the background.
    /// </summary>
    private const int LoadTimeoutSeconds = 20;
    private static async Task<T> WithTimeout<T>(Task<T> task)
    {
        if (await Task.WhenAny(task, Task.Delay(TimeSpan.FromSeconds(LoadTimeoutSeconds))) == task)
            return await task;
        _ = task.ContinueWith(t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
        throw new TimeoutException();
    }

    private async Task LoadPriceAsync()
    {
        isLoadingPrice = true;
        try
        {
            var p = await Cache.GetOrFetchAsync(
                $"price:{AppState.FiatCurrency}",
                () => Blockchain.GetDgbPriceAsync(AppState.FiatCurrency),
                TimeSpan.FromMinutes(5));
            if (p > 0) dgbPrice = p;
        }
        catch { }
        finally { isLoadingPrice = false; StateHasChanged(); }
    }

    private async Task LoadTransactionsAsync()
    {
        isLoadingTx = true;
        StateHasChanged(); // As in LoadBalanceAsync: the list's placeholder must be on screen while this runs.
        try
        {
            var walletId = ActiveWalletId;
            // The load reports its own completeness: with Receive also checking, loads can overlap (spec 025, FR-015).
            var load = await WithTimeout(WalletService.LoadTransactionHistoryAsync());
            transactions = load.Transactions;
            txUnsettled = !load.AddressesSettled;
            await LoadWalletAddressLabelsAsync();
            if (ActiveWalletId == walletId)
            {
                // A wallet that started empty celebrates its first payment once; that payment gets no ordinary notice.
                var firstPayment = await FirstReceive.ObserveAsync(walletId, transactions, FirstReceiveCoordinator.SourceOf(load));
                await _announcer.AnnounceAsync(walletId, transactions, hideBalance, firstPayment?.TxIds);
            }

            // Start poller if any txs are still under 6 confirmations
            if (transactions.Any(t => t.Confirmations < 6))
                StartConfirmationPoller();
            else
                StopConfirmationPoller();
        }
        catch { txFetchFailed = true; }
        finally { isLoadingTx = false; txLoadedOnce = true; StateHasChanged(); }
    }

