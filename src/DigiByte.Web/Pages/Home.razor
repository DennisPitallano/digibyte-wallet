    private string CacheKeyTx => $"cache:transactions:{ActiveWalletId}";
    private string CacheKeyTimestamp => $"cache:lastFetch:{ActiveWalletId}";

    protected override async Task OnInitializedAsync()
    {
        // Reset auto-lock timer on page load
        AppState.ResetLockTimer();

        // Anonymous aggregate count of home-screen views (denominator of SC-005); fire and forget.
        _ = UsageCounter.RecordAsync("home_view");

        WalletService.SetNetworkMode(AppState.NetworkMode);

        // Load wallet list for switcher
        try { allWallets = await WalletService.GetAllWalletsAsync(); } catch { }
        activeCardIndex = allWallets.FindIndex(w => w.Id == WalletService.ActiveWallet?.Id);
        if (activeCardIndex < 0) activeCardIndex = 0;

        // Fire all I/O in parallel — UI renders immediately with skeleton states
        var contactsTask = ContactService.GetAllWithWalletsAsync(WalletService);
        var addressTask = WalletService.IsUnlocked
            ? WalletService.GetReceivingAddressAsync()
            : Task.FromResult("");

        try { hideBalance = await Storage.GetAsync(HideBalanceKey) == "1"; } catch { }
        _ = LoadMarketAsync();

        // Try IndexedDB cache first — instant display
        await LoadFromCacheAsync();

        // Check if redirected from a send — force fresh fetch after a short delay
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var forceRefresh = uri.Query.Contains("refresh=1");

        if (forceRefresh)
        {
            // Brief delay so the explorer has a moment to index the new mempool tx,
            // then fetch fresh data immediately.
            await Task.Delay(750);
            await FetchAndCacheAsync();
        }
        else if (hasCachedData && !IsCacheStale())
        {
            // Cache is fresh — no network needed, render cached data
        }
        else if (hasCachedData)
        {
            // Cache exists but stale — show cached data now, refresh in background
            _ = FetchAndCacheAsync();
        }
        else
        {
            // No cache at all (first load) — must await network so UI gets data
            await FetchAndCacheAsync();
        }

        // Contacts & address are fast (IndexedDB) — await them
        try { ApplyContacts(await contactsTask); } catch { }
        checklistReady = true;
        try { receivingAddress = await addressTask; } catch { }

        // Start the always-on background refresh poller so incoming funds and new
        // transactions appear within ~15s without requiring a manual pull-to-refresh.
        StartAutoRefreshPoller();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-size tx list + disable page scroll (this page handles its own)
        await JS.InvokeVoidAsync("domHelpers.autoSizeTxList");
    }

    public async ValueTask DisposeAsync()
    {
        _animToken++; // stop any running count-up
        // Stop pending-tx confirmation poller
        if (_confirmationPollTimer != null)
        {
            await _confirmationPollTimer.DisposeAsync();
            _confirmationPollTimer = null;
        }
        // Stop background auto-refresh poller
        if (_autoRefreshTimer != null)
        {
            await _autoRefreshTimer.DisposeAsync();
            _autoRefreshTimer = null;
        }
        // Restore page scroll when leaving this page
        try { await JS.InvokeVoidAsync("domHelpers.restoreScroll"); }
        catch { }
    }

    // ── Background auto-refresh poller ──────────────────────────────────────
    // Re-fetches balance + transactions every 15s (matches DGB's ~15s block
    // time) while the Home page is mounted, so newly received funds show up
    // automatically without a manual pull-to-refresh.
    //
    // Two optimizations to avoid unnecessary network/explorer load:
    //   1. Visibility pause — skip ticks while the tab is backgrounded.
    //   2. Idle backoff   — when fetched data hasn't changed, gradually
    //      stretch the effective interval (15s → 30s → 60s, capped). Resets
    //      to 15s the moment something changes or the user manually refreshes.
    private System.Threading.Timer? _autoRefreshTimer;
    private bool _isFetching;
    private int _idleStreak;          // consecutive unchanged fetches
    private int _ticksUntilNextFetch; // base-tick countdown (1 tick = 15s)
    private string? _lastDataSignature;

    private void StartAutoRefreshPoller()
    {
        if (_autoRefreshTimer != null) return;
        _idleStreak = 0;
        _ticksUntilNextFetch = 1;
        _autoRefreshTimer = new System.Threading.Timer(
            async _ => await OnAutoRefreshTickAsync(),
            null,
            dueTime: TimeSpan.FromSeconds(15),
            period: TimeSpan.FromSeconds(15));
    }

    private async Task OnAutoRefreshTickAsync()
    {
        if (_isFetching) return;

        // Pause while tab is hidden (minimized, screen off, switched away).
        try
        {
            if (await JS.InvokeAsync<bool>("domHelpers.isHidden")) return;
        }
        catch { /* JS unavailable — assume visible and continue */ }

        // Idle backoff: only fetch every Nth tick once the chain looks quiet.
        if (--_ticksUntilNextFetch > 0) return;

        try { await InvokeAsync(FetchAndCacheAsync); } catch { }
    }

    /// <summary>Compute a cheap fingerprint of the current visible state to
    /// detect whether a fetch surfaced anything new.</summary>
    private string ComputeDataSignature() =>
        $"{balance.ConfirmedSatoshis}:{balance.UnconfirmedSatoshis}:{transactions.Count}:{(transactions.Count > 0 ? transactions[0].TxId : "")}";

    private void UpdateBackoffFromFetchResult()
    {
        var sig = ComputeDataSignature();
        if (sig == _lastDataSignature)
        {
            _idleStreak++;
        }
        else
        {
            _idleStreak = 0;
            _lastDataSignature = sig;
        }
        // 0 unchanged → next fetch in 1 tick (15s)
        // 1-2 unchanged → 2 ticks (30s)
        // 3+ unchanged → 4 ticks (60s, cap)
        _ticksUntilNextFetch = _idleStreak switch
        {
            0 => 1,
            <= 2 => 2,
            _ => 4,
        };
    }

    // ── Pending-transaction confirmation polling ────────────────────────────

    private System.Threading.Timer? _confirmationPollTimer;

    /// <summary>
    /// Starts a 15-second repeating timer that re-fetches confirmations for any
    /// unconfirmed transactions, mirroring DGB's ~15-second block time so the UI
    /// updates automatically without a manual pull-to-refresh.
    /// </summary>
    private void StartConfirmationPoller()
    {
        if (_confirmationPollTimer != null) return; // already running
        _confirmationPollTimer = new System.Threading.Timer(
            async _ => await PollPendingConfirmationsAsync(),
            null,
            dueTime: TimeSpan.FromSeconds(15),
            period: TimeSpan.FromSeconds(15));
    }

    private void StopConfirmationPoller()
    {
        _confirmationPollTimer?.Dispose();
        _confirmationPollTimer = null;
    }

    private async Task PollPendingConfirmationsAsync()
    {
        try
        {
            var hasPending = transactions.Any(t => t.Confirmations < 6);
            if (!hasPending)
            {
                StopConfirmationPoller();
                return;
            }

            TxTracker.SetActiveWallet(ActiveWalletId);
            await TxTracker.UpdateConfirmationsAsync(Blockchain);
            var updated = await TxTracker.GetAllAsync();

            // Merge updated confirmations into the current list
            foreach (var tx in transactions)
            {
                var fresh = updated.FirstOrDefault(u => u.TxId == tx.TxId);
                if (fresh != null && fresh.Confirmations != tx.Confirmations)
                    tx.Confirmations = fresh.Confirmations;
            }

            await InvokeAsync(StateHasChanged);

            if (!transactions.Any(t => t.Confirmations < 6))
                StopConfirmationPoller();
        }
        catch { /* ignore transient errors — will retry next interval */ }
    }

    /// <summary>Load balance, txs, and price from IndexedDB cache for instant display.</summary>
    private async Task LoadFromCacheAsync()
    {
        try
        {
            var balJson = await Storage.GetAsync(CacheKeyBalance);
            if (balJson != null)
            {
                var cached = System.Text.Json.JsonSerializer.Deserialize<WalletBalance>(balJson);
                if (cached != null)
                {
                    balance = cached;
                    hasCachedData = true;
                }
            }

            var priceJson = await Storage.GetAsync(CacheKeyPrice);
            if (priceJson != null && decimal.TryParse(priceJson, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var p) && p > 0)
                dgbPrice = p;

            var txJson = await Storage.GetAsync(CacheKeyTx);
            if (txJson != null)
            {
                var cached = System.Text.Json.JsonSerializer.Deserialize<List<TransactionRecord>>(txJson);
                if (cached != null && cached.Count > 0)
                {
                    transactions = cached;
                    knownTxIds ??= cached.Select(t => t.TxId).ToHashSet();
                }
            }

            if (hasCachedData) StateHasChanged();

            // Load timestamp so IsCacheStale() works on fresh app start
            var tsJson = await Storage.GetAsync(CacheKeyTimestamp);
            if (tsJson != null && long.TryParse(tsJson, out var ticks))
                Cache.Set($"lastFetchTime:{ActiveWalletId}", new DateTime(ticks, DateTimeKind.Utc), TimeSpan.FromMinutes(10));
        }
        catch { }
    }

    private bool IsCacheStale()
    {
        // We don't await the timestamp here — check in-memory cache instead.
        // Short threshold so the first render after navigating back to Home
        // triggers a fresh network fetch rather than showing stale data.
        if (Cache.TryGet<DateTime>($"lastFetchTime:{ActiveWalletId}", out var ts))
            return (DateTime.UtcNow - ts).TotalSeconds > 30;
        return true; // no timestamp = treat as stale
    }

    /// <summary>Fetch fresh data from network, then persist to IndexedDB.</summary>
    private async Task FetchAndCacheAsync()
    {
        // Reentrancy guard so the background poller can't stack overlapping fetches
        if (_isFetching) return;
        _isFetching = true;

        // Guard against stale results when user switches wallets during a background fetch
        var walletIdAtStart = ActiveWalletId;

        try
        {
        fetchFailed = false;
        balanceFetchFailed = false;
        txFetchFailed = false;
        await Task.WhenAll(LoadBalanceAsync(), LoadTransactionsAsync());

        // Abort if user switched wallets while we were fetching
        if (ActiveWalletId != walletIdAtStart) return;

        // Only fetch price if we have a balance to convert
        if (!balanceFetchFailed && balance.TotalDgb > 0)
            await LoadPriceAsync();

        // Abort if user switched wallets while we were fetching
        if (ActiveWalletId != walletIdAtStart) return;

        // Mark as failed only if both balance AND tx fetches errored
        fetchFailed = balanceFetchFailed && txFetchFailed;

        // Cache whatever we got (even zeros — a 0 balance is valid data)
        if (!fetchFailed)
            await SaveToCacheAsync();

        // Update poller backoff based on whether anything actually changed.
        UpdateBackoffFromFetchResult();

        StateHasChanged();
        }
        finally { _isFetching = false; }
    }

    /// <summary>Persist balance, txs, and price to IndexedDB + update timestamp.</summary>
    private async Task SaveToCacheAsync()
    {
        try
        {
            var now = DateTime.UtcNow;
            await Storage.SetAsync(CacheKeyBalance, System.Text.Json.JsonSerializer.Serialize(balance));
            await Storage.SetAsync(CacheKeyTx, System.Text.Json.JsonSerializer.Serialize(transactions));
            if (dgbPrice > 0)
                await Storage.SetAsync(CacheKeyPrice, dgbPrice.ToString(System.Globalization.CultureInfo.InvariantCulture));
            await Storage.SetAsync(CacheKeyTimestamp, now.Ticks.ToString());
            Cache.Set($"lastFetchTime:{ActiveWalletId}", now, TimeSpan.FromMinutes(10));
        }
        catch { }
    }

    private async Task LoadBalanceAsync()
    {
        isLoadingBalance = true;
        try
        {
            var before = balance.TotalDgb;
            var hadData = hasCachedData || before > 0;
            balance = await WithTimeout(WalletService.GetBalanceAsync());
            if (hadData && !hideBalance && balance.TotalDgb != before)
                _ = AnimateBalanceAsync(before, balance.TotalDgb);
        }
        catch { balanceFetchFailed = true; }
        finally { isLoadingBalance = false; StateHasChanged(); }
    }

    /// <summary>
    /// Stops waiting on a network read after <see cref="LoadTimeoutSeconds"/> so the page shows "Unable to load" with Retry
    /// in place of skeletons that never resolve. The read itself is left to finish or fail in the background.
    /// </summary>
    private const int LoadTimeoutSeconds = 20;
    private static async Task<T> WithTimeout<T>(Task<T> task)
    {
        if (await Task.WhenAny(task, Task.Delay(TimeSpan.FromSeconds(LoadTimeoutSeconds))) == task)
            return await task;
        _ = task.ContinueWith(t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
        throw new TimeoutException();
    }

    // Transaction IDs already seen for this wallet; null until the first list (cache or network) has been recorded.
    private HashSet<string>? knownTxIds;

    /// <summary>
    /// Says "received" once per incoming transaction that appears while Home is open. It goes by transaction ID,
    /// not by a change in the balance figure: a balance read can come back low when an explorer drops some
    /// address lookups, and the next good read would then look like money arriving.
    /// </summary>
    private async Task AnnounceNewReceivedAsync()
    {
        if (knownTxIds is null)
        {
            // First list for this wallet: record it without announcing anything.
            knownTxIds = transactions.Select(t => t.TxId).ToHashSet();
            return;
        }

        // Only recent transactions count as arrivals; an older one showing up late is history filling in.
        var cutoff = DateTime.UtcNow.AddMinutes(-15);
        var arrived = transactions
            .Where(t => !knownTxIds.Contains(t.TxId)
                        && t.Direction == TransactionDirection.Received
                        && (t.Confirmations <= 2 || t.Timestamp.ToUniversalTime() >= cutoff))
            .ToList();
        foreach (var t in transactions) knownTxIds.Add(t.TxId);
        if (arrived.Count == 0) return;

        var message = hideBalance
            ? (arrived.Count == 1 ? "Payment received" : $"{arrived.Count} payments received")
            : arrived.Count == 1
                ? $"+{arrived[0].AmountDgb:0.########} DGB received"
                : $"{arrived.Count} payments received, +{arrived.Sum(t => t.AmountDgb):0.########} DGB";
        Notifications.Success(message);
        try { await JS.InvokeVoidAsync("domHelpers.haptic", new[] { 15, 40, 25 }); } catch { }
    }

    private async Task LoadPriceAsync()
    {
        isLoadingPrice = true;
        try
        {
            var p = await Cache.GetOrFetchAsync(
                $"price:{AppState.FiatCurrency}",
                () => Blockchain.GetDgbPriceAsync(AppState.FiatCurrency),
                TimeSpan.FromMinutes(5));
            if (p > 0) dgbPrice = p;
        }
        catch { }
        finally { isLoadingPrice = false; StateHasChanged(); }
    }

    private async Task LoadTransactionsAsync()
    {
        isLoadingTx = true;
        try
        {
            transactions = await WithTimeout(WalletService.GetTransactionHistoryAsync());
            await AnnounceNewReceivedAsync();

            // Start poller if any txs are still under 6 confirmations
            if (transactions.Any(t => t.Confirmations < 6))
                StartConfirmationPoller();
            else
                StopConfirmationPoller();
        }
        catch { txFetchFailed = true; }
        finally { isLoadingTx = false; StateHasChanged(); }
    }

