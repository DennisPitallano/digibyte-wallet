            </div>

            @* Transaction List — scrollable *@
            @* Placeholder rows only until the first load has answered. After that an empty wallet keeps showing its address
               while the background check runs, instead of blinking to placeholders every few seconds (spec 025). *@
            @if ((isLoadingTx || !hasCachedData) && transactions.Count == 0 && !txLoadedOnce)
            {
                @* Skeleton rows while loading *@
                <div class="flex flex-col gap-1">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="flex items-center gap-3 px-3 py-3 rounded-xl">
                            <div class="w-8 h-8 rounded-full skeleton"></div>
                            <div class="flex-1 flex flex-col gap-1.5">
                                <div class="h-3 w-16 skeleton rounded"></div>
                                <div class="h-2.5 w-24 skeleton rounded"></div>
                            </div>
                            <div class="flex flex-col items-end gap-1.5">
                                <div class="h-3 w-20 skeleton rounded"></div>
                                <div class="h-2 w-10 skeleton rounded"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (transactions.Count == 0)
            {
                @if (fetchFailed)
                {
                    <div class="bg-white dark:bg-dgb-900/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-6 text-center">
                        <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-amber-100 dark:bg-amber-900/20 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                            </svg>
                        </div>
                        <p class="text-xs font-medium text-amber-600 dark:text-amber-400">Unable to load data</p>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Check your connection, then try again</p>
                        <button type="button" class="btn-primary btn-sm mt-3"
                                @onclick="ManualRefreshAsync" disabled="@isRefreshing">@(isRefreshing ? "Trying..." : "Try again")</button>
                    </div>
                    @* The address does not depend on the network, so it stays available while the history cannot be read
                       (spec 025, FR-007, FR-008). No mascot line here: nothing is known about this wallet's history yet. *@
                    <ReceiveEmptyState Address="@receivingAddress" Class="mt-3" />
                }
                else if (SearchingAddresses)
                {
                    @* The list is empty only as far as the addresses checked so far: say so instead of "nothing yet". The
                       address stays on show, as it does not depend on the search (spec 025, FR-007). *@
                    <div class="bg-white dark:bg-dgb-900/50 rounded-2xl border border-slate-200/80 dark:border-dgb-800 p-4 mb-3 flex items-start gap-3"
                         role="status" data-testid="home-searching-addresses">
                        <div class="w-4 h-4 mt-0.5 shrink-0 border-2 border-dgb-500 dark:border-dgb-300 border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                        <div>
                            <p class="text-xs font-semibold text-slate-900 dark:text-white">@L.T("home.searching.title")</p>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">@L.T("home.searching.body")</p>
                        </div>
                    </div>
                    <ReceiveEmptyState Address="@receivingAddress" />
                }
                else
                {
                    @* Nothing here yet: the address to share is the next step (spec 025, FR-003). The mascot's message is the
                       only explanatory copy; the empty state stands on its own when the mascot is off or the tip was dismissed. *@
                    <BakuMessage MessageId="home.empty" Class="mb-3" />
                    <ReceiveEmptyState Address="@receivingAddress" />
                }
            }
            else
            {
                <div id="tx-list" class="overflow-y-auto thin-scrollbar flex flex-col gap-0.5 rounded-xl">
                    <Virtualize Items="@transactions" Context="tx" OverscanCount="5">
                        <TransactionRow @key="tx.TxId" Tx="tx" OnOpen="OpenTxDetail" Name="@NameFor(tx)"
                                        WalletAddressText="@WalletAddressText(tx)" WalletAddressMore="WalletAddressMore(tx)"
                                        FiatPrice="dgbPrice" FiatSymbol="@AppState.FiatSymbol" FiatDecimals="AppState.FiatDecimals"
                                        HideAmounts="hideBalance" />
                    </Virtualize>
                </div>
            }


        </div>
    </div>

    <TransactionDetailModal IsOpen="@(selectedTx != null)" Tx="@selectedTx"
        OnClosed="() => selectedTx = null"
        OnAddContact="AddCounterpartyToContacts" />

    @* The wallet's first payment, celebrated once. It waits while one of this page's dialogs is open (spec 025, FR-023). *@
    <FirstReceiveCelebration Blocked="@(selectedTx != null || showWalletInfo || showAddressQr || showWalletPicker)" />

    @* Wallet Info Modal *@
    @if (showWalletInfo)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm" role="dialog" aria-modal="true" @onclick="() => showWalletInfo = false">
            <div class="scale-in bg-white dark:bg-dgb-900 rounded-2xl shadow-2xl p-5 mx-4 max-w-xs w-full flex flex-col gap-3"
                 @onclick:stopPropagation="true">
                <div class="flex items-center justify-between">
