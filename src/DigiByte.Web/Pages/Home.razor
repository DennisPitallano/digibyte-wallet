    // More → Multisig always opens the list, so the list stays one tap away.
    private async Task OnMultisig()
    {
        string? target = null;
        try
        {
            await MultisigAttention.EnsureLoadedAsync();
            var owner = ActiveWalletContext.WalletId;
            var ids = MultisigAttention.Wallets.Select(w => w.Id).ToList();
            string? lastUsed = null;
            if (!string.IsNullOrEmpty(owner))
            {
                try { lastUsed = await Storage.GetAsync(SharedWalletShortcut.StorageKey(owner)); } catch { }
            }
            target = SharedWalletShortcut.Target(lastUsed, ids);
        }
        catch { /* the list is always a safe place to land */ }

        Nav.NavigateTo(target is null ? "/multisig" : $"/multisig/{Uri.EscapeDataString(target)}");
    }

    private void ApplyContacts(List<Contact> all)
    {
        quickContacts = all.Take(6).ToList();
        hasUserContact = all.Any(c => !c.IsWallet);
        var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in all)
            if (!string.IsNullOrWhiteSpace(c.Address)) names[c.Address] = c.Name;
        contactNames = names;
    }

