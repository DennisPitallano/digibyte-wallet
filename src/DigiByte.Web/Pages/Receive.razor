@page "/receive"
@implements IAsyncDisposable
@inject WalletService WalletService
@inject ClipboardService Clipboard
@inject AddressLabelService LabelService
@inject AppState AppState
@inject ISecureStorage Storage
@inject DigiByte.Web.Services.WalletSnapshotCache Snapshots
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FirstReceiveCoordinator FirstReceive
@inject SoundService Sounds
@inject NotificationService Notifications

<PageTitle>Receive DGB — DigiByte Wallet</PageTitle>

<AuthGuard>
<div class="flex flex-col items-center gap-5">
    <PageHeader Title="Receive DigiByte">
        @{ var recvWalletColor = WalletService.ActiveWallet?.Color ?? "#0066FF"; }
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <div class="w-2 h-2 rounded-full" style="background-color: @recvWalletColor;"></div>
            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[100px]">@(WalletService.ActiveWallet?.Name ?? "Wallet")</span>
        </div>
    </PageHeader>

    <BakuMessage MessageId="receive.tip" Class="w-full" />

    @* Address format selector — WIF wallets only (HD wallets always use SegWit via BIP84) *@
    @if (isWifWallet)
    {
        <div class="segmented slide-up-delay-1 w-full">
            <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 @(addressFormat == "legacy" ? "bg-white dark:bg-dgb-800 text-dgb-500 shadow-sm" : "text-slate-500 dark:text-slate-400")"
                    @onclick="SetLegacy">
                Legacy (D...)
            </button>
            <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 @(addressFormat == "segwit" ? "bg-white dark:bg-dgb-800 text-dgb-500 shadow-sm" : "text-slate-500 dark:text-slate-400")"
                    @onclick="SetSegwit">
                SegWit (dgb1...)
            </button>
        </div>
    }

    @if (address != null)
    {
        <div class="card scale-in p-6 flex flex-col items-center gap-4 w-full card-hover">
            <div class="qr-frame">
                <img src="@qrDataUrl" alt="QR Code" class="w-48 h-48 rounded-lg" />
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="bg-white rounded-full p-1.5 shadow-md">
                        <DigiLogo Size="32" />
                    </div>
                </div>
            </div>

            @* Reusing an address links payments together. Shown only when the address on show is known to be used; never blocks copy or share. *@
            @if (onShowUsed)
            {
                <p class="w-full text-center text-[11px] leading-snug text-amber-600 dark:text-amber-400" role="note">
                    This address has been used before. A new address is better for privacy.
                </p>
            }

            <div class="w-full flex flex-col items-center gap-3 fade-in-delay-2">
                @if (requestAmount is not null)
                {
                    <p class="text-lg font-bold tabular-nums text-slate-900 dark:text-white" aria-live="polite">
                        @requestAmount.Value.ToString("0.########") <span class="text-sm font-bold text-dgb-500">DGB</span>
                    </p>
                }
                <p class="addr-balance font-mono text-xs text-slate-600 dark:text-slate-400 break-all text-center bg-slate-50 dark:bg-dgb-950 rounded-xl px-4 py-3 w-full border border-slate-100 dark:border-dgb-800">
                    @address
                </p>
                <div class="flex gap-2 w-full">
                    <button class="btn-primary btn-sm flex-1"
                            @onclick="CopyAddress">
                        @(copied ? "Copied!" : requestAmount is not null ? "Copy Payment Link" : "Copy Address")
                    </button>
                    <button class="btn-secondary btn-sm"
                            @onclick="ShareAddress">
                        Share
                    </button>
                </div>
                <button class="flex items-center justify-center gap-1.5 w-full py-2 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-dgb-500 transition-colors"
                        @onclick="DownloadQr">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                    Download QR
                </button>
            </div>
        </div>

        @* Request a specific amount: the QR code, Copy and Share switch to a payment link that fills in the amount for the sender. *@
        <div class="w-full bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800">
            <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2.5 text-left"
                    aria-expanded="@(showRequest ? "true" : "false")" aria-controls="request-amount-panel" @onclick="ToggleRequest">
                <span class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
                    <svg class="w-4 h-4 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    Request a specific amount
                </span>
                <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 @(showRequest ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            @if (showRequest)
            {
                <div id="request-amount-panel" class="px-3 pb-3 flex flex-col gap-2 fade-in">
                    <div class="flex items-center bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-xl focus-within:border-dgb-500 transition-all">
                        <input type="text" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-label="Amount in DGB"
                               value="@requestAmountText" @oninput="OnRequestAmountInput"
                               class="flex-1 min-w-0 px-3 py-2.5 bg-transparent text-sm tabular-nums text-slate-900 dark:text-white outline-none" />
                        <span class="pr-3 text-sm font-bold text-dgb-500">DGB</span>
                    </div>
                    <input type="text" maxlength="60" placeholder="What is it for? (optional)" aria-label="Note for the sender"
                           value="@requestNote" @oninput="OnRequestNoteInput"
                           class="input" />
                    @if (requestError is not null)
                    {
                        <p class="text-xs text-red-500 font-medium" role="alert">@requestError</p>
                    }
                    else if (requestAmount is not null)
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400">The QR code and payment link now ask for this amount. Wallets that scan it fill it in for the sender.</p>
                    }
                    else
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400">Enter an amount to put it in the QR code.</p>
                    }
                </div>
            }
        </div>

        @* Your addresses: every receiving address generated so far. Folded on every visit; the newest 10, then 10 more at a time. *@
        @if (!isWifWallet)
        {
            <div class="w-full bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800">
                <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2.5 text-left"
                        aria-expanded="@(listOpen ? "true" : "false")" aria-controls="your-addresses-panel" @onclick="ToggleListAsync">
                    <span class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
                        <svg class="w-4 h-4 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm0 5.25h.007v.008H3.75V12Zm0 5.25h.007v.008H3.75v-.008Z" />
                        </svg>
                        Your addresses (@GeneratedCount)
                    </span>
                    <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 @(listOpen ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                @if (listOpen)
                {
                    <div id="your-addresses-panel" class="px-1.5 pb-1.5 flex flex-col gap-0.5 fade-in">
                        @if (listLoading && entries.Count == 0)
                        {
                            <p class="px-2 py-3 text-xs text-slate-400 text-center">Loading addresses...</p>
                        }
                        @foreach (var entry in entries)
                        {
                            @if (editingIndex == entry.Index)
                            {
                                @* Naming the address: Enter saves, Escape cancels; an empty name removes the label. *@
                                <div @key="entry.Index" class="flex items-center gap-1 px-2.5 py-2">
                                    <input type="text" @ref="renameInput" @bind="editLabelText" @bind:event="oninput" maxlength="50"
                                           @onkeydown="e => OnRenameKey(e, entry)"
                                           placeholder="Name, e.g. Donations" aria-label="Name for @ShortAddress(entry.Address)"
                                           class="flex-1 min-w-0 px-2 py-1 text-xs bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 outline-none focus:border-dgb-500" />
                                    <button type="button" class="p-1 text-green-500 press-effect" aria-label="Save name" @onclick="() => SaveRenameAsync(entry)">
                                        <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                    </button>
                                    <button type="button" class="p-1 text-slate-400 press-effect" aria-label="Cancel" @onclick="CancelRename">
                                        <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div @key="entry.Index" class="flex items-center rounded-lg transition-colors hover:bg-slate-50 dark:hover:bg-dgb-800 @(entry.IsOnShow ? "bg-dgb-50 dark:bg-dgb-800" : "")">
                                    <button type="button" aria-current="@(entry.IsOnShow ? "true" : "false")"
                                            class="flex-1 min-w-0 flex items-center justify-between gap-3 pl-2.5 pr-1 py-2 text-left"
                                            @onclick="() => SelectEntry(entry)">
                                        <span class="min-w-0">
                                            @if (!string.IsNullOrEmpty(entry.Label))
                                            {
                                                <span class="block text-xs font-semibold text-slate-900 dark:text-white truncate">@entry.Label</span>
                                            }
                                            <span class="block text-[11px] font-mono text-slate-500 dark:text-slate-400 truncate" title="@entry.Address">@ShortAddress(entry.Address)</span>
                                            <span class="block text-[10px] @StatusClass(entry.Status)">@StatusText(entry)</span>
                                        </span>
                                        @if (entry.IsOnShow)
                                        {
                                            <span class="text-[11px] font-semibold text-dgb-500 flex-shrink-0">Showing</span>
                                        }
                                    </button>
                                    @* Only a used address has anything to show on Activity; unused and unknown ones get no action. *@
                                    @if (entry.Status == ReceiveAddressStatus.Used)
                                    {
                                        <button type="button" class="px-1.5 py-1 text-[11px] font-semibold text-dgb-600 dark:text-dgb-400 hover:underline flex-shrink-0"
                                                aria-label="View activity for this address" @onclick="() => ViewActivityAsync(entry)">
                                            View activity
                                        </button>
                                    }
                                    <button type="button" class="p-2 text-slate-400 hover:text-dgb-500 transition-colors flex-shrink-0"
                                            aria-label="@(string.IsNullOrEmpty(entry.Label) ? "Name this address" : "Rename this address")" title="Name this address"
                                            @onclick="() => StartRename(entry)">
                                        <svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                    </button>
                                </div>
                            }
                        }
                        @if (shownCount < GeneratedCount)
                        {
                            <button type="button" class="self-center mt-1 px-3 py-1.5 text-xs font-semibold text-dgb-600 dark:text-dgb-400 disabled:opacity-50"
                                    disabled="@listLoading" @onclick="ShowMoreAsync">
                                Show more
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if (!isWifWallet)
        {
            <button class="text-sm text-dgb-500 hover:text-dgb-600 font-medium transition-colors slide-up-delay-3 disabled:opacity-50" @onclick="GenerateNewAddress" disabled="@isGenerating">
                Generate new address
            </button>
            @if (generateError != null)
            {
                <InlineError Message="@generateError" Class="justify-center" />
            }
        }

        @* Address Label *@
        @if (address != null)
        {
            <div class="w-full slide-up-delay-3">
                <div class="flex items-center gap-2 bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800 px-3 py-2">
                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                    </svg>
                    <input type="text" placeholder="Label this address (e.g. Donations, Salary)"
                           maxlength="50"
                           value="@addressLabel"
                           @oninput="OnLabelInput"
                           @onblur="SaveLabel"
                           class="flex-1 bg-transparent text-xs text-slate-700 dark:text-slate-300 placeholder-slate-400 dark:placeholder-slate-500 outline-none" />
                    @if (!string.IsNullOrEmpty(addressLabel))
                    {
                        <button class="p-0.5 rounded hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors" @onclick="ClearLabel" title="Remove label" aria-label="Remove label">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex items-center justify-center h-40">
            <p class="text-sm text-slate-400">Generating address...</p>
        </div>
    }
</div>

@* The wallet's first payment, celebrated once (spec 025). Receive has no dialog of its own that could be in the way. *@
<FirstReceiveCelebration Blocked="false" />
</AuthGuard>

@code {
    private string? address;
    private string? qrDataUrl;
    private bool copied;
    private bool isGenerating;
    private string? generateError;
    private string addressFormat = "legacy";
    private bool isWifWallet;
    private string addressLabel = "";

    // Request a specific amount (not saved; Payments keeps saved requests)
    private bool showRequest;
    private string requestAmountText = "";
    private string requestNote = "";
    private decimal? requestAmount;
    private string? requestError;

    /// <summary>What the QR code, Copy and Share carry: a digibyte: payment link when an amount is set, else the bare address.</summary>
    private string? Payload => address is null || requestAmount is null
        ? address
        : new PaymentRequest
        {
            Id = "",
            Address = address,
            AmountDgb = requestAmount,
            Label = string.IsNullOrWhiteSpace(requestNote) ? null : requestNote.Trim(),
        }.ToUri();

    private void ToggleRequest()
    {
        showRequest = !showRequest;
        if (!showRequest)
        {
            // Closing the panel goes back to the plain address.
            requestAmountText = "";
            requestNote = "";
            requestAmount = null;
            requestError = null;
            GenerateQrCode();
        }
    }

    private void OnRequestAmountInput(ChangeEventArgs e)
    {
        requestAmountText = (e.Value?.ToString() ?? "").Trim();
        requestError = null;
        if (requestAmountText.Length == 0)
        {
            requestAmount = null;
        }
        else if (!decimal.TryParse(requestAmountText.Replace(',', '.'), System.Globalization.NumberStyles.AllowDecimalPoint,
                     System.Globalization.CultureInfo.InvariantCulture, out var value) || value <= 0)
        {
            requestAmount = null;
            requestError = "Enter an amount above zero, for example 12.5";
        }
        else if (value > 21_000_000_000m || decimal.Round(value, 8) != value)
        {
            requestAmount = null;
            requestError = "Use at most 8 decimal places and no more than 21 billion DGB";
        }
        else
        {
            requestAmount = value;
        }
        GenerateQrCode();
    }

    private void OnRequestNoteInput(ChangeEventArgs e)
    {
        requestNote = e.Value?.ToString() ?? "";
        if (requestAmount is not null) GenerateQrCode();
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.ResetLockTimer();
        isWifWallet = WalletService.ActiveWallet?.WalletType == "privatekey";
        // Default to segwit for HD wallets, legacy for WIF
        addressFormat = isWifWallet ? "legacy" : "segwit";
        await GenerateAddress();

        // Someone showing this page is waiting to be paid, so it checks for incoming payments by itself, at Home's pace
        // (spec 025, FR-024). Both pieces belong to this page and end with it.
        _refreshLoop = new AutoRefreshLoop(JS);
        _announcer = new IncomingPaymentAnnouncer(Notifications, JS, Sounds);
        try { hideAmounts = await Storage.GetAsync("pref:hideBalance") == "1"; } catch { }

        _ = LoadHistoryAsync(); // background: the page and the QR code never wait for it
        _ = LoadWalletLabelsAsync();

        // The history load above skips private-key wallets (they have no address list), so check them once here: every
        // wallet type is then checked when the page opens, not 15 seconds later.
        if (isWifWallet) _ = CheckForPaymentsAsync();
        _refreshLoop.Start(CheckForPaymentsAsync);
    }

    // ── Incoming payments while this page is open (spec 025, FR-024 to FR-026) ──
    private AutoRefreshLoop _refreshLoop = null!;
    private IncomingPaymentAnnouncer _announcer = null!;
    private bool hideAmounts;
    private string? _lastCheckSignature;

    /// <summary>
    /// One check, from the loop or on opening: is there a new payment? A check that cannot read the chain changes nothing on
    /// the page and shows no error; the loop simply tries again later (FR-025).
    /// </summary>
    private async Task CheckForPaymentsAsync()
    {
        if (!WalletService.IsUnlocked || WalletService.ActiveWallet is not { } wallet)
        {
            _refreshLoop.Report(changed: false);
            return;
        }

        WalletService.HistoryLoad load;
        try { load = await WalletService.LoadTransactionHistoryAsync(0, 50); }
        catch { _refreshLoop.Report(changed: false); return; }
        if (!load.Complete || WalletService.ActiveWallet?.Id != wallet.Id)
        {
            _refreshLoop.Report(changed: false);
            return;
        }

        await ReportLoadAsync(wallet.Id, load);

        var top = load.Transactions.Count > 0 ? load.Transactions[0] : null;
        var signature = $"{load.Transactions.Count}:{top?.TxId}:{load.Transactions.Count(t => t.Confirmations == 0)}";
        var changed = signature != _lastCheckSignature;
        _lastCheckSignature = signature;
        _refreshLoop.Report(changed);

        // Keep the "used" marks on the address list current, without dropping the older history already loaded.
        if (changed && !isWifWallet && HasWalletAddressData(load.Transactions))
        {
            var known = history?.Select(t => t.TxId).ToHashSet() ?? [];
            var added = load.Transactions.Where(t => !known.Contains(t.TxId)).ToList();
            if (added.Count > 0) ApplyHistory(history is null ? added : [.. added, .. history]);
        }
    }

    /// <summary>
    /// Tells the first-receive coordinator and the "payment received" notice about a load that read the chain, and saves
    /// the list the way Activity does, so that Home (which starts from the saved list) does not announce the same payment again.
    /// </summary>
    private async Task ReportLoadAsync(string walletId, WalletService.HistoryLoad load)
    {
        var firstPayment = await FirstReceive.ObserveAsync(walletId, load.Transactions, FirstReceiveCoordinator.SourceOf(load));
        await _announcer.AnnounceAsync(walletId, load.Transactions, hideAmounts, firstPayment?.TxIds);
        if (load.Complete)
            _ = Snapshots.SaveTransactionsAsync(walletId, load.Transactions.Take(50).ToList());
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshLoop is not null) await _refreshLoop.StopAsync();
    }

    // ── Your addresses (spec 012) ──
    // The list starts folded on every visit and nothing about it is saved. The address on show also starts as the newest
    // one on every visit. Switching only changes what this page shows; it never moves the wallet's current receiving index.
    private bool listOpen;
    private bool listLoading;
    private int shownCount;
    private readonly Dictionary<int, string> derivedByIndex = new();
    private IReadOnlyList<ReceiveAddressEntry> entries = [];
    private IReadOnlyDictionary<string, string> walletAddressLabels = new Dictionary<string, string>();

    /// <summary>
    /// The receive indexes the list shows, oldest first: the run from the first address and, after a search has found
    /// payments far along, those addresses and the ones handed out since, up to the address on show (spec 027, FR-015b).
    /// Not always an unbroken run, so the list pages by position in this, never by index.
    /// </summary>
    private IReadOnlyList<int> ListedIndexes
    {
        get
        {
            var listed = WalletService.IsUnlocked ? WalletService.GetListedReceiveIndexes() : [];
            return listed.Count > 0 ? listed : [.. Enumerable.Range(0, (WalletService.ActiveWallet?.NextReceivingIndex ?? 0) + 1)];
        }
    }

    /// <summary>How many receiving addresses the list has.</summary>
    private int GeneratedCount => ListedIndexes.Count;

    private static string ShortAddress(string text) =>
        text.Length > 22 ? $"{text[..10]}…{text[^6..]}" : text;

    // Which addresses were used, from history the wallet already has: Home's cached copy first, and one background load
    // only when that holds no wallet-address data. Until it is known every entry says "Status unknown", never "Unused".
    private IReadOnlyList<TransactionRecord>? history;
    private bool historyLoading;
    private bool onShowUsed;

    private static string StatusText(ReceiveAddressEntry entry) => entry.Status switch
    {
        ReceiveAddressStatus.Used => $"Used · {entry.TransactionCount} transaction{(entry.TransactionCount == 1 ? "" : "s")}",
        ReceiveAddressStatus.Unused => "Unused",
        _ => "Status unknown",
    };

    private static string StatusClass(ReceiveAddressStatus status) => status switch
    {
        ReceiveAddressStatus.Used => "text-amber-600 dark:text-amber-400",
        ReceiveAddressStatus.Unused => "text-green-600 dark:text-green-400",
        _ => "text-slate-400 dark:text-slate-500",
    };

    /// <summary>Updates the privacy notice: the address on show is used, according to the history known so far.</summary>
    private void RefreshOnShowStatus() =>
        onShowUsed = !isWifWallet && address is not null
            && ReceiveAddressList.StatusOf(address, history).Status == ReceiveAddressStatus.Used;

    private static bool HasWalletAddressData(IReadOnlyList<TransactionRecord>? records) =>
        records is not null && records.Any(t => t.WalletAddresses.Count > 0 || t.WalletReceivedAddresses.Count > 0);

    private async Task LoadHistoryAsync()
    {
        if (isWifWallet || historyLoading || WalletService.ActiveWallet is not { } wallet) return;
        historyLoading = true;
        try
        {
            // 1. The saved history shows at once (spec 023, FR-017); unreadable saved data is the same as none.
            var saved = (await Snapshots.LoadAsync(wallet.Id)).Transactions;
            if (HasWalletAddressData(saved)) ApplyHistory(saved);
            if (saved is { Count: > 0 })
            {
                // Saved history is already known: it is never announced, and it is enough to record that this wallet did
                // not start empty (spec 025, FR-011).
                _announcer.Seed(wallet.Id, saved);
                await FirstReceive.ObserveAsync(wallet.Id, saved, HistorySource.SavedSnapshot);
            }

            // 2. Then the same history call Home and Activity use, in the background of what is on screen. That call returns
            //    whatever it could read, so an answer that couldn't reach the chain replaces nothing, and only a history that
            //    carries wallet addresses is used; otherwise every status stays as it was (unknown, never "unused").
            try
            {
                // The load reports its own completeness: this page's automatic check can overlap it (spec 025, FR-015).
                var load = await WalletService.LoadTransactionHistoryAsync(0, 1000);
                var loaded = load.Transactions;
                if (WalletService.ActiveWallet?.Id == wallet.Id)
                {
                    if (load.Complete && HasWalletAddressData(loaded)) ApplyHistory(loaded);
                    await ReportLoadAsync(wallet.Id, load);
                }
            }
            catch { /* offline or locked: the saved statuses stay */ }
        }
        finally { historyLoading = false; }
    }

    private void ApplyHistory(IReadOnlyList<TransactionRecord>? records)
    {
        history = records;
        RefreshOnShowStatus();
        if (shownCount > 0) RebuildEntries();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleListAsync()
    {
        listOpen = !listOpen;
        // The addresses are derived the first time the row is opened, so a visit that never opens it costs nothing.
        if (listOpen && shownCount == 0)
            await ShowWindowAsync(Math.Min(ReceiveAddressList.PageSize, GeneratedCount));
    }

    private Task ShowMoreAsync() => ShowWindowAsync(ReceiveAddressList.NextWindow(shownCount, GeneratedCount));

    /// <summary>Derives the addresses a window of <paramref name="count"/> newest addresses still lacks, then rebuilds the list.</summary>
    private async Task ShowWindowAsync(int count)
    {
        if (listLoading) return;
        listLoading = true;
        try
        {
            await Task.Yield(); // let the page paint "Loading" before the derivation work starts
            var listed = ListedIndexes;
            var (start, size) = ReceiveAddressList.WindowStart(listed.Count - 1, count);
            // One by one: the listed indexes can have gaps, so a range starting at the first missing one would be wrong.
            foreach (var missing in listed.Skip(start).Take(size).Where(i => !derivedByIndex.ContainsKey(i)).ToList())
                foreach (var (index, derivedAddress) in await WalletService.GetReceivingAddressesAsync(1, missing))
                    derivedByIndex[index] = derivedAddress;
            shownCount = count;
            RebuildEntries();
        }
        catch { /* the list is a convenience: leave it as it was */ }
        finally { listLoading = false; }
    }

    private void RebuildEntries()
    {
        var listed = ListedIndexes;
        var (start, _) = ReceiveAddressList.WindowStart(listed.Count - 1, shownCount);
        var window = new List<(int Index, string Address)>();
        for (var position = listed.Count - 1; position >= start; position--)
            if (derivedByIndex.TryGetValue(listed[position], out var a)) window.Add((listed[position], a));
        entries = ReceiveAddressList.Build(window, history, walletAddressLabels, address);
    }

    /// <summary>Puts the chosen address in the QR code, copy, share and download; the amount and note stay as they are.</summary>
    private async Task SelectEntry(ReceiveAddressEntry entry)
    {
        address = entry.Address;
        GenerateQrCode();
        await LoadLabel();
        RefreshOnShowStatus();
        RebuildEntries();
    }

    private async Task GenerateAddress()
    {
        address = await WalletService.GetReceivingAddressAsync(addressFormat);
        GenerateQrCode();
        await LoadLabel();
        RefreshOnShowStatus();
    }

    private async Task SetLegacy() => await SetFormat("legacy");
    private async Task SetSegwit() => await SetFormat("segwit");

    private async Task SetFormat(string format)
    {
        if (format == addressFormat) return;
        addressFormat = format;
        await GenerateAddress();
    }

    private void GenerateQrCode()
    {
        var payload = Payload;
        if (payload == null) return;
        using var qrGenerator = new QRCoder.QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(payload, QRCoder.QRCodeGenerator.ECCLevel.H);
        using var qrCode = new QRCoder.PngByteQRCode(qrCodeData);
        var png = qrCode.GetGraphic(10, [0, 35, 82], [255, 255, 255]);
        qrDataUrl = $"data:image/png;base64,{Convert.ToBase64String(png)}";
    }

    private async Task CopyAddress()
    {
        if (Payload is not { } payload) return;
        await Clipboard.CopyAsync(payload, toast: false);
        copied = true; StateHasChanged();
        await Task.Delay(2000);
        copied = false; StateHasChanged();
    }

    private async Task ShareAddress()
    {
        if (Payload is not { } payload) return;
        try { await JS.InvokeVoidAsync("navigator.share", new { title = requestAmount is not null ? "DigiByte payment request" : "My DigiByte Address", text = payload }); }
        catch { await CopyAddress(); }
    }

    private async Task DownloadQr()
    {
        if (qrDataUrl == null) return;
        await JS.InvokeVoidAsync("downloadDataUrl", qrDataUrl, $"digibyte-{address?[..8]}.png");
    }

    private async Task GenerateNewAddress()
    {
        isGenerating = true;
        generateError = null;
        try
        {
            var (newIndex, newAddress) = await WalletService.GenerateNewReceivingAddressAsync();
            address = newAddress;
            GenerateQrCode();
            await LoadLabel();
            RefreshOnShowStatus();

            // The new address is the newest entry and the one on show. Only a list that was already opened needs updating.
            derivedByIndex[newIndex] = newAddress;
            // Through the window, not by adding one row: after a search has found addresses far along, the first new address
            // changes which addresses the list holds, and the ones now in view may not have been derived yet.
            if (shownCount > 0)
                await ShowWindowAsync(Math.Min(shownCount + 1, GeneratedCount));
        }
        catch (InvalidOperationException ex)
        {
            generateError = ex.Message;
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task LoadLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        addressLabel = await LabelService.GetLabelAsync(WalletService.ActiveWallet.Id, address) ?? "";
    }

    private void OnLabelInput(ChangeEventArgs e)
    {
        addressLabel = e.Value?.ToString() ?? "";
    }

    private async Task SaveLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        await LabelService.SetLabelAsync(WalletService.ActiveWallet.Id, address, addressLabel);
        await LoadWalletLabelsAsync(); // the list shows the same name at once
    }

    private async Task ClearLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        addressLabel = "";
        await LabelService.RemoveLabelAsync(WalletService.ActiveWallet.Id, address);
        await LoadWalletLabelsAsync();
    }

    // ── Names in the list (spec 012): the same labels as the box under the QR code and as the Activity page ──

    private int? editingIndex;
    private string editLabelText = "";
    private ElementReference renameInput;
    private bool focusRenameInput;

    /// <summary>Loads the whole label store (once per change) and rebuilds the list so every entry shows its name.</summary>
    private async Task LoadWalletLabelsAsync()
    {
        try
        {
            if (WalletService.ActiveWallet is not { } wallet) return;
            var labels = await LabelService.GetAllAsync(wallet.Id);
            walletAddressLabels = ActivityAddressIndex.BuildLabelLookup(
                labels.Select(kv => new KeyValuePair<string, string>(kv.Key, kv.Value.Label)));
            if (shownCount > 0) RebuildEntries();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* names are a convenience: the list still works without them */ }
    }

    private void StartRename(ReceiveAddressEntry entry)
    {
        editingIndex = entry.Index;
        editLabelText = entry.Label ?? "";
        focusRenameInput = true;
    }

    private void CancelRename() => editingIndex = null;

    private async Task OnRenameKey(KeyboardEventArgs e, ReceiveAddressEntry entry)
    {
        if (e.Key == "Enter") await SaveRenameAsync(entry);
        else if (e.Key == "Escape") CancelRename();
    }

    /// <summary>Sets, changes or (with an empty name) removes the label of a listed address.</summary>
    private async Task SaveRenameAsync(ReceiveAddressEntry entry)
    {
        if (WalletService.ActiveWallet is not { } wallet) return;
        try { await LabelService.SetLabelAsync(wallet.Id, entry.Address, editLabelText); }
        catch { return; }
        editingIndex = null;
        await LoadWalletLabelsAsync();
        // The box under the QR code shows the name of the address on show.
        if (AddressKey.Normalize(entry.Address) == AddressKey.Normalize(address ?? "")) await LoadLabel();
    }

    /// <summary>
    /// Opens Activity filtered to this address. Activity restores the address it remembers (the same preference the Activity
    /// picker writes) once its history has loaded, so nothing new is needed on that page.
    /// </summary>
    private async Task ViewActivityAsync(ReceiveAddressEntry entry)
    {
        try
        {
            if (WalletService.ActiveWallet is { } wallet)
                await Storage.SetAsync($"pref:activityAddress:{wallet.Id}", entry.Address);
        }
        catch { /* the filter is a convenience: Activity still opens */ }
        Nav.NavigateTo("/transactions");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Put the cursor in the name box as soon as it appears.
        if (!focusRenameInput || editingIndex is null) return;
        focusRenameInput = false;
        try { await renameInput.FocusAsync(); } catch { }
    }
}
