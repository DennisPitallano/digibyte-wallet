@page "/receive"
@inject WalletService WalletService
@inject ClipboardService Clipboard
@inject AddressLabelService LabelService
@inject AppState AppState
@inject IJSRuntime JS

<PageTitle>Receive DGB — DigiByte Wallet</PageTitle>

<AuthGuard>
<div class="flex flex-col items-center gap-5">
    <PageHeader Title="Receive DigiByte">
        @{ var recvWalletColor = WalletService.ActiveWallet?.Color ?? "#0066FF"; }
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <div class="w-2 h-2 rounded-full" style="background-color: @recvWalletColor;"></div>
            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500 truncate max-w-[100px]">@(WalletService.ActiveWallet?.Name ?? "Wallet")</span>
        </div>
    </PageHeader>

    <BakuMessage MessageId="receive.tip" Class="w-full" />

    @* Address format selector — WIF wallets only (HD wallets always use SegWit via BIP84) *@
    @if (isWifWallet)
    {
        <div class="slide-up-delay-1 flex bg-slate-100 dark:bg-dgb-900 rounded-xl p-1 gap-0.5 w-full">
            <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 @(addressFormat == "legacy" ? "bg-white dark:bg-dgb-800 text-dgb-500 shadow-sm" : "text-slate-500 dark:text-slate-400")"
                    @onclick="SetLegacy">
                Legacy (D...)
            </button>
            <button class="flex-1 py-2 text-xs font-semibold rounded-lg transition-all duration-200 @(addressFormat == "segwit" ? "bg-white dark:bg-dgb-800 text-dgb-500 shadow-sm" : "text-slate-500 dark:text-slate-400")"
                    @onclick="SetSegwit">
                SegWit (dgb1...)
            </button>
        </div>
    }

    @if (address != null)
    {
        <div class="scale-in bg-white dark:bg-dgb-900 rounded-3xl border border-slate-200/80 dark:border-dgb-800 p-6 shadow-sm flex flex-col items-center gap-4 w-full card-hover">
            <div class="bg-white rounded-2xl p-3 shadow-inner relative">
                <img src="@qrDataUrl" alt="QR Code" class="w-48 h-48 rounded-lg" />
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="bg-white rounded-full p-1.5 shadow-md">
                        <DigiLogo Size="32" />
                    </div>
                </div>
            </div>

            <div class="w-full flex flex-col items-center gap-3 fade-in-delay-2">
                @if (requestAmount is not null)
                {
                    <p class="text-lg font-bold tabular-nums text-slate-900 dark:text-white" aria-live="polite">
                        @requestAmount.Value.ToString("0.########") <span class="text-sm font-bold text-dgb-500">DGB</span>
                    </p>
                }
                <p class="font-mono text-xs text-slate-600 dark:text-slate-400 break-all text-center bg-slate-50 dark:bg-dgb-950 rounded-xl px-4 py-3 w-full border border-slate-100 dark:border-dgb-800">
                    @address
                </p>
                <div class="flex gap-2 w-full">
                    <button class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-600 text-white text-sm font-semibold rounded-xl hover:shadow-lg hover:shadow-dgb-500/25 transition-all press-effect"
                            @onclick="CopyAddress">
                        @(copied ? "Copied!" : requestAmount is not null ? "Copy Payment Link" : "Copy Address")
                    </button>
                    <button class="py-2.5 px-4 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-dgb-800 hover:border-dgb-300 dark:hover:border-dgb-600 transition-all press-effect"
                            @onclick="ShareAddress">
                        Share
                    </button>
                </div>
                <button class="flex items-center justify-center gap-1.5 w-full py-2 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-dgb-500 transition-colors"
                        @onclick="DownloadQr">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                    Download QR
                </button>
            </div>
        </div>

        @* Request a specific amount: the QR code, Copy and Share switch to a payment link that fills in the amount for the sender. *@
        <div class="w-full bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800">
            <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2.5 text-left"
                    aria-expanded="@(showRequest ? "true" : "false")" aria-controls="request-amount-panel" @onclick="ToggleRequest">
                <span class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
                    <svg class="w-4 h-4 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    Request a specific amount
                </span>
                <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 @(showRequest ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            @if (showRequest)
            {
                <div id="request-amount-panel" class="px-3 pb-3 flex flex-col gap-2 fade-in">
                    <div class="flex items-center bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-xl focus-within:border-dgb-500 transition-all">
                        <input type="text" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-label="Amount in DGB"
                               value="@requestAmountText" @oninput="OnRequestAmountInput"
                               class="flex-1 min-w-0 px-3 py-2.5 bg-transparent text-sm tabular-nums text-slate-900 dark:text-white outline-none" />
                        <span class="pr-3 text-sm font-bold text-dgb-500">DGB</span>
                    </div>
                    <input type="text" maxlength="60" placeholder="What is it for? (optional)" aria-label="Note for the sender"
                           value="@requestNote" @oninput="OnRequestNoteInput"
                           class="w-full px-3 py-2.5 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-xl text-sm text-slate-900 dark:text-white outline-none focus:border-dgb-500 transition-all" />
                    @if (requestError is not null)
                    {
                        <p class="text-xs text-red-500 font-medium" role="alert">@requestError</p>
                    }
                    else if (requestAmount is not null)
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400">The QR code and payment link now ask for this amount. Wallets that scan it fill it in for the sender.</p>
                    }
                    else
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400">Enter an amount to put it in the QR code.</p>
                    }
                </div>
            }
        </div>

        @* Your addresses: every receiving address generated so far. Folded on every visit; the newest 10, then 10 more at a time. *@
        @if (!isWifWallet)
        {
            <div class="w-full bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800">
                <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2.5 text-left"
                        aria-expanded="@(listOpen ? "true" : "false")" aria-controls="your-addresses-panel" @onclick="ToggleListAsync">
                    <span class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
                        <svg class="w-4 h-4 text-dgb-500" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm0 5.25h.007v.008H3.75V12Zm0 5.25h.007v.008H3.75v-.008Z" />
                        </svg>
                        Your addresses (@GeneratedCount)
                    </span>
                    <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 @(listOpen ? "rotate-180" : "")" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                @if (listOpen)
                {
                    <div id="your-addresses-panel" class="px-1.5 pb-1.5 flex flex-col gap-0.5 fade-in">
                        @if (listLoading && entries.Count == 0)
                        {
                            <p class="px-2 py-3 text-xs text-slate-400 text-center">Loading addresses...</p>
                        }
                        @foreach (var entry in entries)
                        {
                            <button type="button" @key="entry.Index" aria-current="@(entry.IsOnShow ? "true" : "false")"
                                    class="w-full flex items-center justify-between gap-3 px-2.5 py-2 rounded-lg text-left transition-colors hover:bg-slate-50 dark:hover:bg-dgb-800 @(entry.IsOnShow ? "bg-dgb-50 dark:bg-dgb-800" : "")"
                                    @onclick="() => SelectEntry(entry)">
                                <span class="min-w-0">
                                    @if (!string.IsNullOrEmpty(entry.Label))
                                    {
                                        <span class="block text-xs font-semibold text-slate-900 dark:text-white truncate">@entry.Label</span>
                                    }
                                    <span class="block text-[11px] font-mono text-slate-500 dark:text-slate-400 truncate" title="@entry.Address">@ShortAddress(entry.Address)</span>
                                </span>
                                @if (entry.IsOnShow)
                                {
                                    <span class="text-[11px] font-semibold text-dgb-500 flex-shrink-0">Showing</span>
                                }
                            </button>
                        }
                        @if (shownCount < GeneratedCount)
                        {
                            <button type="button" class="self-center mt-1 px-3 py-1.5 text-xs font-semibold text-dgb-600 dark:text-dgb-400 disabled:opacity-50"
                                    disabled="@listLoading" @onclick="ShowMoreAsync">
                                Show more
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if (!isWifWallet)
        {
            <button class="text-sm text-dgb-500 hover:text-dgb-600 font-medium transition-colors slide-up-delay-3 disabled:opacity-50" @onclick="GenerateNewAddress" disabled="@isGenerating">
                Generate new address
            </button>
            @if (generateError != null)
            {
                <InlineError Message="@generateError" Class="justify-center" />
            }
        }

        @* Address Label *@
        @if (address != null)
        {
            <div class="w-full slide-up-delay-3">
                <div class="flex items-center gap-2 bg-white dark:bg-dgb-900 rounded-xl border border-slate-200 dark:border-dgb-800 px-3 py-2">
                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                    </svg>
                    <input type="text" placeholder="Label this address (e.g. Donations, Salary)"
                           maxlength="50"
                           value="@addressLabel"
                           @oninput="OnLabelInput"
                           @onblur="SaveLabel"
                           class="flex-1 bg-transparent text-xs text-slate-700 dark:text-slate-300 placeholder-slate-400 dark:placeholder-slate-500 outline-none" />
                    @if (!string.IsNullOrEmpty(addressLabel))
                    {
                        <button class="p-0.5 rounded hover:bg-slate-100 dark:hover:bg-dgb-800 transition-colors" @onclick="ClearLabel" title="Remove label" aria-label="Remove label">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex items-center justify-center h-40">
            <p class="text-sm text-slate-400">Generating address...</p>
        </div>
    }
</div>
</AuthGuard>

@code {
    private string? address;
    private string? qrDataUrl;
    private bool copied;
    private bool isGenerating;
    private string? generateError;
    private string addressFormat = "legacy";
    private bool isWifWallet;
    private string addressLabel = "";

    // Request a specific amount (not saved; Payments keeps saved requests)
    private bool showRequest;
    private string requestAmountText = "";
    private string requestNote = "";
    private decimal? requestAmount;
    private string? requestError;

    /// <summary>What the QR code, Copy and Share carry: a digibyte: payment link when an amount is set, else the bare address.</summary>
    private string? Payload => address is null || requestAmount is null
        ? address
        : new PaymentRequest
        {
            Id = "",
            Address = address,
            AmountDgb = requestAmount,
            Label = string.IsNullOrWhiteSpace(requestNote) ? null : requestNote.Trim(),
        }.ToUri();

    private void ToggleRequest()
    {
        showRequest = !showRequest;
        if (!showRequest)
        {
            // Closing the panel goes back to the plain address.
            requestAmountText = "";
            requestNote = "";
            requestAmount = null;
            requestError = null;
            GenerateQrCode();
        }
    }

    private void OnRequestAmountInput(ChangeEventArgs e)
    {
        requestAmountText = (e.Value?.ToString() ?? "").Trim();
        requestError = null;
        if (requestAmountText.Length == 0)
        {
            requestAmount = null;
        }
        else if (!decimal.TryParse(requestAmountText.Replace(',', '.'), System.Globalization.NumberStyles.AllowDecimalPoint,
                     System.Globalization.CultureInfo.InvariantCulture, out var value) || value <= 0)
        {
            requestAmount = null;
            requestError = "Enter an amount above zero, for example 12.5";
        }
        else if (value > 21_000_000_000m || decimal.Round(value, 8) != value)
        {
            requestAmount = null;
            requestError = "Use at most 8 decimal places and no more than 21 billion DGB";
        }
        else
        {
            requestAmount = value;
        }
        GenerateQrCode();
    }

    private void OnRequestNoteInput(ChangeEventArgs e)
    {
        requestNote = e.Value?.ToString() ?? "";
        if (requestAmount is not null) GenerateQrCode();
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.ResetLockTimer();
        isWifWallet = WalletService.ActiveWallet?.WalletType == "privatekey";
        // Default to segwit for HD wallets, legacy for WIF
        addressFormat = isWifWallet ? "legacy" : "segwit";
        await GenerateAddress();
    }

    // ── Your addresses (spec 012) ──
    // The list starts folded on every visit and nothing about it is saved. The address on show also starts as the newest
    // one on every visit. Switching only changes what this page shows; it never moves the wallet's current receiving index.
    private bool listOpen;
    private bool listLoading;
    private int shownCount;
    private readonly Dictionary<int, string> derivedByIndex = new();
    private IReadOnlyList<ReceiveAddressEntry> entries = [];
    private IReadOnlyDictionary<string, string> walletAddressLabels = new Dictionary<string, string>();

    /// <summary>How many receiving addresses the wallet has generated: indexes 0 to the current one.</summary>
    private int GeneratedCount => (WalletService.ActiveWallet?.NextReceivingIndex ?? 0) + 1;

    private static string ShortAddress(string text) =>
        text.Length > 22 ? $"{text[..10]}…{text[^6..]}" : text;

    private async Task ToggleListAsync()
    {
        listOpen = !listOpen;
        // The addresses are derived the first time the row is opened, so a visit that never opens it costs nothing.
        if (listOpen && shownCount == 0)
            await ShowWindowAsync(Math.Min(ReceiveAddressList.PageSize, GeneratedCount));
    }

    private Task ShowMoreAsync() => ShowWindowAsync(ReceiveAddressList.NextWindow(shownCount, GeneratedCount));

    /// <summary>Derives the addresses a window of <paramref name="count"/> newest addresses still lacks, then rebuilds the list.</summary>
    private async Task ShowWindowAsync(int count)
    {
        if (listLoading) return;
        listLoading = true;
        try
        {
            await Task.Yield(); // let the page paint "Loading" before the derivation work starts
            var newest = GeneratedCount - 1;
            var (start, size) = ReceiveAddressList.WindowStart(newest, count);
            var missing = Enumerable.Range(start, size).Where(i => !derivedByIndex.ContainsKey(i)).ToList();
            if (missing.Count > 0)
            {
                var derived = await WalletService.GetReceivingAddressesAsync(missing.Count, missing[0]);
                foreach (var (index, derivedAddress) in derived) derivedByIndex[index] = derivedAddress;
            }
            shownCount = count;
            RebuildEntries();
        }
        catch { /* the list is a convenience: leave it as it was */ }
        finally { listLoading = false; }
    }

    private void RebuildEntries()
    {
        var newest = GeneratedCount - 1;
        var (start, _) = ReceiveAddressList.WindowStart(newest, shownCount);
        var window = new List<(int Index, string Address)>();
        for (var i = newest; i >= start; i--)
            if (derivedByIndex.TryGetValue(i, out var a)) window.Add((i, a));
        entries = ReceiveAddressList.Build(window, history: null, walletAddressLabels, address);
    }

    /// <summary>Puts the chosen address in the QR code, copy, share and download; the amount and note stay as they are.</summary>
    private async Task SelectEntry(ReceiveAddressEntry entry)
    {
        address = entry.Address;
        GenerateQrCode();
        await LoadLabel();
        RebuildEntries();
    }

    private async Task GenerateAddress()
    {
        address = await WalletService.GetReceivingAddressAsync(addressFormat);
        GenerateQrCode();
        await LoadLabel();
    }

    private async Task SetLegacy() => await SetFormat("legacy");
    private async Task SetSegwit() => await SetFormat("segwit");

    private async Task SetFormat(string format)
    {
        if (format == addressFormat) return;
        addressFormat = format;
        await GenerateAddress();
    }

    private void GenerateQrCode()
    {
        var payload = Payload;
        if (payload == null) return;
        using var qrGenerator = new QRCoder.QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(payload, QRCoder.QRCodeGenerator.ECCLevel.H);
        using var qrCode = new QRCoder.PngByteQRCode(qrCodeData);
        var png = qrCode.GetGraphic(10, [0, 35, 82], [255, 255, 255]);
        qrDataUrl = $"data:image/png;base64,{Convert.ToBase64String(png)}";
    }

    private async Task CopyAddress()
    {
        if (Payload is not { } payload) return;
        await Clipboard.CopyAsync(payload, toast: false);
        copied = true; StateHasChanged();
        await Task.Delay(2000);
        copied = false; StateHasChanged();
    }

    private async Task ShareAddress()
    {
        if (Payload is not { } payload) return;
        try { await JS.InvokeVoidAsync("navigator.share", new { title = requestAmount is not null ? "DigiByte payment request" : "My DigiByte Address", text = payload }); }
        catch { await CopyAddress(); }
    }

    private async Task DownloadQr()
    {
        if (qrDataUrl == null) return;
        await JS.InvokeVoidAsync("downloadDataUrl", qrDataUrl, $"digibyte-{address?[..8]}.png");
    }

    private async Task GenerateNewAddress()
    {
        isGenerating = true;
        generateError = null;
        try
        {
            var (newIndex, newAddress) = await WalletService.GenerateNewReceivingAddressAsync();
            address = newAddress;
            GenerateQrCode();
            await LoadLabel();

            // The new address is the newest entry and the one on show. Only a list that was already opened needs updating.
            derivedByIndex[newIndex] = newAddress;
            if (shownCount > 0)
            {
                shownCount = Math.Min(shownCount + 1, GeneratedCount);
                RebuildEntries();
            }
        }
        catch (InvalidOperationException ex)
        {
            generateError = ex.Message;
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task LoadLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        addressLabel = await LabelService.GetLabelAsync(WalletService.ActiveWallet.Id, address) ?? "";
    }

    private void OnLabelInput(ChangeEventArgs e)
    {
        addressLabel = e.Value?.ToString() ?? "";
    }

    private async Task SaveLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        await LabelService.SetLabelAsync(WalletService.ActiveWallet.Id, address, addressLabel);
    }

    private async Task ClearLabel()
    {
        if (address == null || WalletService.ActiveWallet == null) return;
        addressLabel = "";
        await LabelService.RemoveLabelAsync(WalletService.ActiveWallet.Id, address);
    }
}
