@page "/multisig/sign-room"
@implements IAsyncDisposable
@inject SigningRoomClient Room
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject WalletService WalletService
@inject ClipboardService Clipboard
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject ShellChrome Chrome
@inject IJSRuntime JS
@inject LocalizationService L
@inject ContactService Contacts

@using DigiByte.Crypto.Networks

@*
    Online multisig signing room (specs/017-multisig-online-signing), laid out as in
    specs/026-multisig-wallet-experience: a bar with the code and time left, a three-step tracker, one headline, the
    payment once, who has signed, and the viewer's one button pinned to the bottom. The bottom menu is hidden while
    the room is live or showing its result; the join screen keeps it. Everything shown about the payment comes from the
    transaction itself, checked against this device's multisig; the room only relays public data. Signing happens here,
    on this device. Room display names are shown only here and never change local co-signer labels (FR-025).
*@

<PageTitle>@L.T("ms.signing.page_title")</PageTitle>

@* While redirecting to unlock (with the code kept), AuthGuard must not render: it would redirect again and drop the code. *@
@if (!redirectingToUnlock)
{
<AuthGuard>
<div class="flex flex-col gap-4">
    @* The live room has its own bar at the top; every other state of this page has the usual header. *@
    @if (phase != Phase.InRoom)
    {
        <PageHeader Title="@(phase == Phase.Ended ? L.T("ms.signing.title_ended") : L.T("ms.signing.title"))" BackLabel="@(pending is not null ? L.T("ms.signing.back_payment") : config is not null ? L.T("nav.pending") : L.T("more.item.multisig.label"))" BackHref="@BackHref" />
        @if (config is not null)
        {
            <div class="-mt-2"><SharedWalletContextLine Config="config" Static="@(phase == Phase.Ended)" /></div>
        }
    }

    @switch (phase)
    {
        case Phase.Connecting:
            <div class="p-6 text-center text-sm text-slate-500 dark:text-slate-400" role="status">@L.T("ms.signing.connecting")</div>
            break;

        case Phase.Unavailable:
            <div class="card p-4">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@L.T("ms.signing.unavailable_title")</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@L.T("ms.signing.unavailable_desc")</p>
                <button type="button" class="btn-primary btn-sm mt-3" @onclick='() => Nav.NavigateTo("/multisig")'>@L.T("ms.signing.back_to_multisig")</button>
            </div>
            break;

        case Phase.Join:
            <div class="card p-4 flex flex-col gap-3" data-testid="room-join">
                <p class="text-sm text-slate-600 dark:text-slate-300">@L.T("ms.signing.join_intro")</p>

                <p class="section-label">@L.T("ms.signing.room_code")</p>
                <RoomCodeInput @bind-Value="code" OnScan="() => showScanner = true" OnSubmit="JoinAsync" />

                @* Which wallet the co-signer key comes from: the room only lets this wallet's multisigs in. *@
                <p class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400" data-testid="room-joining-as">
                    @L.T("ms.signing.joining_as")
                    <span class="w-2 h-2 rounded-full shrink-0" style="background-color: @ActiveWallet.WalletColor;" aria-hidden="true"></span>
                    <span class="font-semibold text-slate-800 dark:text-slate-100 truncate">@ActiveWallet.WalletName</span>
                </p>

                <label class="section-label" for="room-name">@L.T("ms.signing.your_name")</label>
                <input id="room-name" @bind="displayName" @bind:event="oninput" maxlength="40" class="input" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="text-sm text-red-600 dark:text-red-400 break-words" role="alert">@error</p>
                }

                <button type="button" class="btn-primary" data-testid="room-join-button"
                        disabled="@(busy || code.Length != RoomCodeInput.Length || string.IsNullOrWhiteSpace(displayName))" @onclick="JoinAsync">
                    @(busy ? L.T("ms.signing.joining") : L.T("ms.signing.join"))
                </button>

                @if (otherWallets.Count > 0)
                {
                    <div class="pt-3 border-t border-slate-100 dark:border-dgb-800">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">@L.T("ms.signing.other_wallets")</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var w in otherWallets)
                            {
                                <button type="button" class="btn-secondary btn-sm" @onclick="() => SwitchWalletAndRetryAsync(w.Id)">
                                    @(WalletService.IsWalletUnlocked(w.Id) ? L.T("ms.signing.switch_to", w.Name) : L.T("ms.signing.unlock", w.Name))
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            break;

        case Phase.Ended:
            @* The result: what happened, what was kept, and one next step (spec 026, FR-033) *@
            <div class="card p-5 flex flex-col gap-3" role="status" data-testid="room-result">
                <p class="block-title">@EndedTitle</p>
                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="text-sm text-red-600 dark:text-red-400 break-words" role="alert">@error</p>
                }
                @if (pending is not null)
                {
                    <div><StatusBadge State="PendingStateClassifier.Classify(pending, Room.MyKey, false)" /></div>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        @(pending.SignatureCount == 1 ? L.T("ms.signing.saved.one", pending.RequiredSignatures) : L.T("ms.signing.saved.other", pending.SignatureCount, pending.RequiredSignatures))
                        @(pending.Status == PendingTxStatus.Broadcast ? "" : L.T("ms.signing.carry_on"))
                    </p>
                    @if (!string.IsNullOrEmpty(pending.BroadcastTxId))
                    {
                        <div>
                            <p class="section-label">@L.T("ms.signing.txid")</p>
                            <p class="mt-1 font-mono text-xs break-all text-slate-700 dark:text-slate-300 select-all">@pending.BroadcastTxId</p>
                        </div>
                        <button type="button" class="btn-secondary btn-sm self-start" @onclick="() => Clipboard.CopyAsync(pending.BroadcastTxId)">@L.T("ms.signing.copy_txid")</button>
                    }
                }
                <button type="button" class="btn-primary mt-1" data-testid="room-result-next" @onclick="GoNext">
                    @(pending is null ? L.T("ms.signing.back_to_multisig") : pending.Status == PendingTxStatus.Broadcast ? L.T("ms.signing.view_activity") : L.T("ms.signing.open_payment"))
                </button>
            </div>
            break;

        case Phase.InRoom when view is not null:
            var stage = Stage;
            var inviteUpFront = InviteUpFront;
            var countdown = RoomCountdown.For(Remaining);

            <RoomBar InviteCode="@view.InviteCode" Countdown="countdown" Spoken="@RoomCountdown.Spoken(Remaining)"
                     IsReconnecting="Room.IsReconnecting" OnBack="() => Nav.NavigateTo(BackHref)" OnMenu="() => menuOpen = true" />

            @if (config is not null)
            {
                <div class="-mt-2"><SharedWalletContextLine Config="config" Static="true" /></div>
            }

            <RoomStageTracker Stage="stage" />

            <ConnectionBanner IsReconnecting="Room.IsReconnecting" />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800/30 rounded-xl" role="alert">
                    <p class="text-sm text-red-600 dark:text-red-400 break-words">@error</p>
                </div>
            }
            @foreach (var warning in warnings)
            {
                <div class="p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-xl" role="alert">
                    <p class="text-sm text-amber-700 dark:text-amber-300 break-words">@warning</p>
                </div>
            }
            @if (coinsSpent)
            {
                <div class="p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-xl" role="alert">
                    <p class="text-sm text-amber-700 dark:text-amber-300">@L.T("ms.signing.coins_spent")</p>
                </div>
            }

            @* One headline from this viewer's point of view. Its button is pinned at the bottom of the screen. *@
            @if (pending is not null)
            {
                <RoomHeadlineCard Headline="Headline" ShowAction="false" />
            }
            else
            {
                <div class="p-3 text-center text-sm text-slate-500 dark:text-slate-400" role="status">@L.T("ms.signing.checking")</div>
            }

            @* The host's first job while co-signers are missing: get them in (FR-029) *@
            @if (inviteUpFront)
            {
                <RoomInvite InviteCode="@view.InviteCode" InviteLink="@InviteLink" Prominent="true"
                            OnShare="ShareInviteAsync" OnCopyLink="CopyLinkAsync" OnCopyCode="CopyCodeAsync" />
            }

            @* The payment, once, read from the transaction itself (FR-026) *@
            @if (facts is not null)
            {
                <PaymentSummary Summary="Summary" ShowCheckCue="CanSign">
                    <Details>
                        @if (!string.IsNullOrWhiteSpace(view.Memo) && view.Memo != facts.Memo)
                        {
                            <p class="text-xs text-slate-500 dark:text-slate-400 break-words">@L.T("ms.signing.memo", view.Memo)</p>
                        }
                        <p class="text-xs text-slate-500 dark:text-slate-400">@L.T("ms.signing.inputs", facts.Inputs.Count)</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 break-all">@L.T("ms.signing.unsigned_txid") <span class="font-mono">@view.UnsignedTxId</span></p>
                    </Details>
                </PaymentSummary>
            }

            @* Who has signed and who is here (FR-030) *@
            <div class="card p-4 flex flex-col gap-3">
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100" data-testid="room-signature-count">
                    @L.T("ms.signing.sig_count", SignedCount, view.RequiredSignatures)
                    <span class="font-normal text-slate-500 dark:text-slate-400">· @(MoreNeeded == 0 ? L.T("ms.signing.enough") : MoreNeeded == 1 ? L.T("ms.signing.more.one") : L.T("ms.signing.more.other", MoreNeeded))</span>
                </p>
                <SignerList Cards="SignerOrder.Sort(Cards)" />
            </div>

            @if (view.Status == SigningRoomStatus.Broadcast && view.BroadcastTxId is not null)
            {
                <div class="p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 rounded-xl flex flex-col gap-2" role="status">
                    <p class="text-sm font-semibold text-green-700 dark:text-green-300">@L.T("ms.signing.sent")</p>
                    <p class="text-xs font-mono break-all text-green-700 dark:text-green-300">@view.BroadcastTxId</p>
                    <button type="button" class="btn-secondary btn-sm self-start" @onclick="() => Clipboard.CopyAsync(view.BroadcastTxId)">@L.T("ms.signing.copy_txid")</button>
                </div>
            }
            @if (broadcastFailure is not null)
            {
                <p class="text-xs text-red-600 dark:text-red-400 break-words" role="alert">@L.T("ms.signing.broadcast_failed", broadcastFailure)</p>
            }

            @* Folded: enough co-signers are here, or the viewer did not open the room. One tap opens it again. *@
            @if (!inviteUpFront && view.Status == SigningRoomStatus.Open)
            {
                <RoomInvite InviteCode="@view.InviteCode" InviteLink="@InviteLink" Prominent="false"
                            OnShare="ShareInviteAsync" OnCopyLink="CopyLinkAsync" OnCopyCode="CopyCodeAsync" />
            }

            @* The viewer's one next step, pinned to the bottom of the screen; the menu is hidden in the room (FR-028).
               A confirm step takes the button's place, so it appears where the person just tapped. *@
            @if (pending is not null)
            {
                @if (confirmSign && facts is not null && CanSign)
                {
                    <StickyAction DisabledReason="@ConnectionReason">
                        <div class="p-3 bg-white dark:bg-dgb-900 border border-dgb-300 dark:border-dgb-700 rounded-2xl flex flex-col gap-3" role="alertdialog" aria-label="@L.T("ms.signing.confirm_aria")">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@L.T("ms.signing.confirm_question", MultisigFormat.Dgb(facts.AmountSat), facts.Recipients.Count > 1 ? L.T("send.confirm.recipients", facts.Recipients.Count) : MultisigFormat.Short(facts.DestinationAddress))</p>
                            <div class="flex gap-2">
                                <button type="button" class="btn-primary btn-sm flex-1" data-testid="room-confirm-sign"
                                        disabled="@(busy || Room.IsReconnecting)" @onclick="ConfirmSignAsync">@(busy ? L.T("ms.signing.signing") : L.T("ms.signing.confirm_sign"))</button>
                                <button type="button" class="btn-ghost btn-sm" disabled="@busy" @onclick="() => confirmSign = false">@L.T("nav.back")</button>
                            </div>
                        </div>
                    </StickyAction>
                }
                else if (confirmDecline)
                {
                    <StickyAction>
                        <div class="p-3 bg-slate-50 dark:bg-dgb-900 border border-slate-200 dark:border-dgb-700 rounded-2xl" role="alertdialog" aria-label="@L.T("ms.signing.decline_aria")">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@L.T("ms.signing.decline_question")</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@L.T("ms.signing.decline_desc")</p>
                            <div class="flex gap-2 mt-2">
                                <button type="button" class="btn-secondary btn-sm" @onclick="DeclineAsync">@L.T("ms.signing.decline")</button>
                                <button type="button" class="btn-ghost btn-sm" @onclick="() => confirmDecline = false">@L.T("nav.back")</button>
                            </div>
                        </div>
                    </StickyAction>
                }
                else if (Headline.Action != PrimaryAction.None && !string.IsNullOrEmpty(Headline.ActionLabel))
                {
                    var headline = Headline;
                    <StickyAction DisabledReason="@ConnectionReason">
                        <button type="button" class="btn-primary w-full" data-testid="room-main-action" disabled="@HeadlineBusy"
                                @onclick="() => OnHeadlineAction(headline.Action)">
                            @(HeadlineBusy && !string.IsNullOrEmpty(HeadlineBusyLabel) ? HeadlineBusyLabel : headline.ActionLabel)
                        </button>
                        @if (CanSign)
                        {
                            @* Refusing is always possible, and deliberately quieter than signing (Story 3, scenario 9) *@
                            <button type="button" class="self-center min-h-[44px] px-3 text-sm font-medium text-slate-500 dark:text-slate-400" @onclick="() => confirmDecline = true">@L.T("ms.signing.decline_to_sign")</button>
                        }
                    </StickyAction>
                }
            }
            break;
    }
</div>

<RoomMenu IsOpen="@(menuOpen && phase == Phase.InRoom)" IsHost="IsCreator" OnLeave="LeaveAsync" OnCloseRoom="CloseAsync" OnClosed="() => menuOpen = false" />
<QrScannerModal IsOpen="@showScanner" OnScanned="OnInviteScanned" OnClosed="@(() => showScanner = false)" />
</AuthGuard>
}

@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private enum Phase { Connecting, Unavailable, Join, InRoom, Ended }

    private bool redirectingToUnlock;

    private Phase phase = Phase.Connecting;
    private string code = "";
    private string displayName = "";
    private SigningRoomView? view;
    private MultisigWalletConfig? config;
    private PendingMultisigTransaction? pending;
    private ProposalFacts? facts;
    private string? error;
    private bool menuOpen;
    private bool showScanner;
    // The tracker only moves forward during one visit: a co-signer going offline does not take it back to Invite.
    private RoomStageKind furthestStage = RoomStageKind.Invite;
    private readonly List<string> warnings = [];
    private bool busy;
    private bool broadcasting;
    private string? broadcastFailure;
    private string? claimHolder;
    private bool confirmDecline;
    private bool confirmSign;
    private readonly PresenceDebouncer presence = new();
    private bool coinsSpent;
    private string? endReason;
    private List<WalletInfo> otherWallets = [];
    private CancellationTokenSource? ticker;
    private bool resolving;

    private string HeaderSubtitle => config?.DisplayName ?? "Multisig";
    // The payment's own screen when the payment is known: that is where it is finished or cancelled now (spec 026).
    private string BackHref => config is null ? "/multisig"
        : pending is null ? $"/multisig/{config.WalletId}/pending"
        : $"/multisig/{config.WalletId}/pending/{Uri.EscapeDataString(pending.Id)}";
    private string InviteLink => view is null ? "" : $"{Nav.BaseUri}multisig/sign-room?code={view.InviteCode}";
    private bool IsCreator => view?.Participants.Any(p => p.IsCreator && Same(p.PublicKeyHex, Room.MyKey)) == true;
    private bool IMSigned => pending is not null && Room.MyKey is not null && pending.SignedBy.Any(k => Same(k, Room.MyKey));
    private bool IDeclined => view?.Participants.Any(p => Same(p.PublicKeyHex, Room.MyKey) && p.Action == SigningParticipantAction.Declined) == true;
    private bool CanSign => pending is not null && !IMSigned && !IDeclined && pending.Status is PendingTxStatus.AwaitingSignatures or PendingTxStatus.ReadyToFinalize;

    private RoomPhase PhaseOfRoom => view!.Status switch
    {
        SigningRoomStatus.Broadcast => RoomPhase.Broadcast,
        SigningRoomStatus.Complete => RoomPhase.Complete,
        _ => RoomPhase.Open,
    };

    private int PresentOrSigned => RoomStage.PresentOrSigned(Cards);
    private int MoreNeeded => Math.Max(0, (view?.RequiredSignatures ?? 0) - SignedCount);
    private bool InviteUpFront => RoomStage.InviteProminent(IsCreator, PresentOrSigned, view!.RequiredSignatures, PhaseOfRoom);
    private TimeSpan Remaining => view is null ? TimeSpan.Zero : view.ExpiresAt - DateTimeOffset.UtcNow;
    private string? ConnectionReason => Room.IsReconnecting ? L.T("ms.signing.waiting_connection") : null;

    private RoomStageKind Stage
    {
        get
        {
            var now = RoomStage.For(PhaseOfRoom, PresentOrSigned, SignedCount, view!.RequiredSignatures);
            if (now > furthestStage) furthestStage = now;
            return furthestStage;
        }
    }

    private int SignedCount => Math.Min(pending?.SignatureCount ?? view?.SignedKeys.Count ?? 0, view?.RequiredSignatures ?? 0);
    private bool ClaimedByOther => claimHolder is not null && !Same(claimHolder, Room.MyKey);

    private RoomHeadline Headline
    {
        get
        {
            var headline = Localized(SigningRoomHeadline.For(PhaseOfRoom, IMSigned, IDeclined, SignedCount, view!.RequiredSignatures,
                view.Status == SigningRoomStatus.Open && view.Unreachable, isWatchOnly: false));
            // A failed broadcast keeps the same button, worded as a retry.
            return headline.Action == PrimaryAction.Broadcast && broadcastFailure is not null
                ? headline with { ActionLabel = L.T("ms.signing.retry_broadcast") }
                : headline;
        }
    }

    // SigningRoomHeadline words its result in English; each of its outcomes has one action, which says which words to show
    // (this page never asks for the watch-only outcome).
    private RoomHeadline Localized(RoomHeadline h)
    {
        var required = view!.RequiredSignatures;
        var missing = Math.Max(1, required - SignedCount);
        return h.Action switch
        {
            PrimaryAction.View => h with { Title = L.T("ms.signing.h.sent_title"), Detail = L.T("ms.signing.h.sent_detail"), ActionLabel = L.T("ms.signing.h.sent_action") },
            PrimaryAction.Broadcast => h with { Title = L.T("ms.signing.h.ready_title"), Detail = L.T("ms.signing.h.ready_detail", SignedCount, required), ActionLabel = L.T("ms.signing.h.ready_action") },
            PrimaryAction.GoToPending => h with { Title = L.T("ms.signing.h.unreachable_title"), Detail = L.T("ms.signing.h.unreachable_detail"), ActionLabel = L.T("ms.signing.open_payment") },
            PrimaryAction.ReviewAndSign => h with { Title = L.T("ms.signing.h.needed_title"), Detail = L.T("ms.signing.h.needed_detail", SignedCount, required), ActionLabel = L.T("ms.signing.h.needed_action") },
            _ when IDeclined => h with { Title = L.T("ms.signing.h.declined_title"), Detail = L.T("ms.signing.h.declined_detail") },
            _ => h with { Title = missing == 1 ? L.T("ms.signing.h.waiting.one") : L.T("ms.signing.h.waiting.other", missing), Detail = L.T("ms.signing.h.signed_detail") },
        };
    }

    private bool HeadlineBusy => busy || broadcasting || Room.IsReconnecting || (Headline.Action == PrimaryAction.Broadcast && ClaimedByOther);
    private string? HeadlineBusyLabel => broadcasting ? L.T("ms.signing.broadcasting")
        : Headline.Action == PrimaryAction.Broadcast && ClaimedByOther ? L.T("ms.signing.broadcasting_by", NameOf(claimHolder!))
        : busy ? L.T("ms.signing.signing") : null;

    // Every recipient, read from the room's PSBT (never from the room), with warnings; names only from this device's contacts.
    private PaymentSummaryModel Summary => PaymentSummaryBuilder.Build(
        facts!.Recipients, facts.FeeSat, facts.Memo, facts.ChangeSat > 0 ? facts.ChangeSat : null, facts.Warnings,
        a => contactNames.TryGetValue(a.Trim(), out var name) ? name : null);

    private Dictionary<string, string> contactNames = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<SignerCardModel> Cards => SignerCards.Build(
        view!.CoSignerKeys.Select(SignerInputFor).ToList(), Room.MyKey, presence.IsOnline);

    private string EndedTitle => endReason switch
    {
        SigningRoomEndReasons.Expired => L.T("ms.signing.end.expired"),
        SigningRoomEndReasons.Closed => L.T("ms.signing.end.closed"),
        SigningRoomEndReasons.Broadcast => L.T("ms.signing.end.broadcast"),
        "superseded" => L.T("ms.signing.end.superseded"),
        "connection_lost" => L.T("ms.signing.end.connection_lost"),
        "left" => L.T("ms.signing.end.left"),
        "refused" => L.T("ms.signing.end.refused"),
        _ => L.T("ms.signing.end.default"),
    };

    protected override void OnInitialized()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        code = RoomCodeInput.Clean(query["code"]);

        // A locked wallet unlocks first, then comes back here with the code still in the link (FR-003). The return
        // address is built from the code, never from the current address, so it can't nest.
        if (!WalletService.IsUnlocked)
        {
            redirectingToUnlock = true;
            // This page can start a second time while the address already shows /unlock; only the first start redirects.
            if (!new Uri(Nav.Uri).AbsolutePath.EndsWith("/multisig/sign-room", StringComparison.OrdinalIgnoreCase)) return;
            var back = "/multisig/sign-room" + (code.Length > 0 ? $"?code={Uri.EscapeDataString(code)}" : "");
            redirectingToUnlock = true;
            Nav.NavigateTo($"/unlock?returnUrl={Uri.EscapeDataString(back)}");
            return;
        }
        displayName = ActiveWallet.WalletName;

        Room.RoomStateReceived += OnRoomStateAsync;
        Room.SignatureAdded += OnSignatureAddedAsync;
        Room.BroadcastGranted += OnBroadcastGrantedAsync;
        Room.BroadcastClaimed += OnBroadcastClaimedAsync;
        Room.Broadcasted += OnBroadcastedAsync;
        Room.BroadcastFailed += OnBroadcastFailedAsync;
        Room.RoomEnded += OnRoomEndedAsync;
        Room.ErrorReceived += OnErrorAsync;
        Room.ConnectionChanged += OnConnectionChangedAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!WalletService.IsUnlocked) return;

        try
        {
            contactNames = (await Contacts.GetAllAsync())
                .Where(c => !string.IsNullOrWhiteSpace(c.Address) && !string.IsNullOrWhiteSpace(c.Name))
                .GroupBy(c => c.Address.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().Name, StringComparer.OrdinalIgnoreCase);
        }
        catch { /* names are optional */ }

        // Opened from a payment's screen or its card: the room is already there.
        if (Room.Current is { } current && (code.Length == 0 || current.InviteCode == code))
        {
            await OnRoomStateAsync(current);
            StartTicker();
            return;
        }

        if (!await Room.CheckAvailabilityAsync())
        {
            phase = Phase.Unavailable;
            return;
        }
        phase = Phase.Join;
        await LoadOtherWalletsAsync();
    }

    // ─── Joining ───

    private async Task JoinAsync()
    {
        if (busy) return;
        if (code.Length != RoomCodeInput.Length)
        {
            error = L.T("ms.signing.err.enter_code");
            return;
        }
        busy = true;
        error = null;
        try
        {
            await Room.JoinAsync(code, displayName.Trim());
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadOtherWalletsAsync()
    {
        try
        {
            var all = await WalletService.GetAllWalletsAsync();
            otherWallets = all.Where(w => w.Id != ActiveWallet.WalletId).ToList();
        }
        catch { otherWallets = []; }
    }

    /// <summary>The payment may belong to another wallet on this device (US3 scenario 2): switch to it and try again.</summary>
    private async Task SwitchWalletAndRetryAsync(string walletId)
    {
        error = null;
        if (!WalletService.IsWalletUnlocked(walletId))
        {
            var back = $"/multisig/sign-room?code={Uri.EscapeDataString(code)}";
            Nav.NavigateTo($"/unlock?returnUrl={Uri.EscapeDataString(back)}");
            return;
        }
        try
        {
            await WalletService.SwitchWalletAsync(walletId);
            displayName = ActiveWallet.WalletName;
            await LoadOtherWalletsAsync();
            // With no code typed yet, only switch; the person enters the code and joins as this wallet.
            if (code.Length == RoomCodeInput.Length) await JoinAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // ─── Room events ───

    private async Task OnRoomStateAsync(SigningRoomView state)
    {
        await InvokeAsync(async () =>
        {
            view = state;
            foreach (var key in state.CoSignerKeys)
                presence.Observe(key, state.Participants.Any(p => Same(p.PublicKeyHex, key) && p.Online));
            claimHolder = state.BroadcastClaimHolder;
            if (phase is Phase.Join or Phase.Connecting) phase = Phase.InRoom;
            if (pending is null && state.IncludesPayload && !resolving)
                await ResolveLocalAsync(state);
            if (pending is not null && state.Status == SigningRoomStatus.Broadcast && state.BroadcastTxId is { } txId)
                await MarkSentAsync(txId);
            StartTicker();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Finds this device's multisig and proposal for the room and checks them (FR-005), saves the payment if new (FR-006),
    /// merges the room's verified signatures (FR-011) and hands over signatures held here (FR-012).
    /// </summary>
    private async Task ResolveLocalAsync(SigningRoomView state)
    {
        resolving = true;
        try
        {
            if (!SameNetwork(state.Network))
            {
                await RefuseAsync(L.T("ms.signing.refuse.network"));
                return;
            }

            config = await MultisigService.FindByRedeemScriptAsync(state.CoSignerKeys, state.RequiredSignatures, ActiveWallet.WalletId, ActiveWallet.PublicKey);
            if (config is null)
            {
                var owners = await MultisigService.FindOwnerWalletIdsByRedeemScriptAsync(state.CoSignerKeys, state.RequiredSignatures);
                await RefuseAsync(owners.Count > 0
                    ? L.T("ms.signing.refuse.other_wallet")
                    : L.T("ms.signing.refuse.not_here"));
                return;
            }
            if (config.OwnKeyIndex < 0)
            {
                await RefuseAsync(L.T("ms.signing.refuse.watch_only"));
                return;
            }

            var existing = (await MultisigService.GetPendingTransactionsAsync(config.WalletId))
                .FirstOrDefault(p => string.Equals(p.UnsignedTxId, state.UnsignedTxId, StringComparison.OrdinalIgnoreCase));
            if (existing is not null)
            {
                if (existing.Status == PendingTxStatus.Cancelled)
                {
                    await RefuseAsync(L.T("ms.signing.refuse.cancelled"));
                    return;
                }
                if (MultisigService.CheckProposalMatches(existing, config, state.PsbtBase64!) is { } mismatch)
                {
                    await RefuseAsync(mismatch);
                    return;
                }
            }

            pending = await MultisigService.AdoptProposalAsync(config, state.PsbtBase64!);
            foreach (var copy in state.SignedPsbts)
                await MergeAsync(copy.PublicKeyHex, copy.PsbtBase64);

            facts = MultisigProposalReader.Read(pending.PsbtBase64, config, MultisigService.ActiveNetwork);

            // Signatures held here that the room doesn't have yet (e.g. imported offline) go to the room.
            var roomHas = state.SignedKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
            if (pending.SignedBy.Any(k => !roomHas.Contains(k)))
                await Room.SubmitSignatureAsync(pending.PsbtBase64);

            await CheckCoinsAsync();
        }
        catch (PsbtImportException ex)
        {
            await RefuseAsync(ex.Message);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            resolving = false;
        }
    }

    private async Task RefuseAsync(string reason)
    {
        error = reason;
        endReason = "refused";
        phase = Phase.Ended;
        await Room.LeaveAsync();
    }

    private async Task OnSignatureAddedAsync(string publicKeyHex, string psbtBase64)
    {
        await InvokeAsync(async () =>
        {
            if (pending is null) return;
            await MergeAsync(publicKeyHex, psbtBase64);
            StateHasChanged();
        });
    }

    private async Task MergeAsync(string fromKey, string psbtBase64)
    {
        if (pending is null || pending.Status is PendingTxStatus.Broadcast or PendingTxStatus.Cancelled) return;
        try
        {
            var result = await MultisigService.MergeRoomSignaturesAsync(pending, psbtBase64);
            if (result.Rejected.Count > 0)
                warnings.Add(L.T("ms.signing.warn.bad_signature", NameOf(fromKey)));
        }
        catch (PsbtImportException ex)
        {
            warnings.Add(L.T("ms.signing.warn.bad_copy", NameOf(fromKey), ex.Message));
        }
    }

    private async Task OnBroadcastGrantedAsync()
    {
        await InvokeAsync(async () =>
        {
            if (pending is null) return;
            broadcasting = true;
            broadcastFailure = null;
            StateHasChanged();
            try
            {
                var txId = pending.Status == PendingTxStatus.Failed
                    ? await MultisigService.RetryBroadcastAsync(pending)
                    : await MultisigService.FinalizeAndBroadcastAsync(pending);
                await Room.ReportBroadcastAsync(true, txId);
            }
            catch (Exception ex)
            {
                broadcastFailure = ex.Message;
                await Room.ReportBroadcastAsync(false, ex.Message);
            }
            finally
            {
                broadcasting = false;
                StateHasChanged();
            }
        });
    }

    private Task OnBroadcastClaimedAsync(string holderKey) => InvokeAsync(() =>
    {
        claimHolder = holderKey;
        StateHasChanged();
    });

    private async Task OnBroadcastedAsync(string txId)
    {
        await InvokeAsync(async () =>
        {
            await MarkSentAsync(txId);
            broadcastFailure = null;
            Notifications.Success(L.T("ms.signing.toast.sent"));
            StateHasChanged();
        });
    }

    private async Task MarkSentAsync(string txId)
    {
        if (pending is null || pending.Status == PendingTxStatus.Broadcast) return;
        try { await MultisigService.MarkBroadcastAsync(pending, txId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private Task OnBroadcastFailedAsync(string reason) => InvokeAsync(() =>
    {
        broadcastFailure = reason;
        claimHolder = null;
        StateHasChanged();
    });

    private Task OnRoomEndedAsync(string reason) => InvokeAsync(() =>
    {
        // The room ended under an open confirm step (its time ran out, the host closed it): say that nothing more
        // was signed. A signature made before this moment is already saved.
        if (confirmSign && reason is SigningRoomEndReasons.Expired or SigningRoomEndReasons.Closed)
            Notifications.Info(L.T("ms.signing.toast.ended_unconfirmed"));
        confirmSign = false;
        confirmDecline = false;
        menuOpen = false;
        endReason = reason;
        phase = Phase.Ended;
        StopTicker();
        StateHasChanged();
    });

    private Task OnErrorAsync(string errorCode, string message) => InvokeAsync(async () =>
    {
        // The service's own wording is English; the codes this page knows are said in the chosen language.
        error = errorCode switch
        {
            SigningRoomErrors.InvalidCode => L.T("ms.signing.err.invalid_code"),
            SigningRoomErrors.RateLimited => L.T("ms.signing.err.rate_limited"),
            _ => message,
        };
        if (errorCode == SigningRoomErrors.InvalidCode && phase == Phase.Join) await LoadOtherWalletsAsync();
        StateHasChanged();
    });

    private Task OnConnectionChangedAsync() => InvokeAsync(StateHasChanged);

    // ─── Actions ───

    private async Task OnHeadlineAction(PrimaryAction action)
    {
        switch (action)
        {
            case PrimaryAction.ReviewAndSign:
                confirmSign = true;
                break;
            case PrimaryAction.Broadcast:
                await BroadcastAsync();
                break;
            case PrimaryAction.GoToPending:
                Nav.NavigateTo(BackHref);
                break;
            case PrimaryAction.View:
                Nav.NavigateTo(config is null ? "/multisig" : $"/multisig/{config.WalletId}/activity");
                break;
        }
    }

    private async Task ConfirmSignAsync()
    {
        await SignAsync();
        if (IMSigned) { confirmSign = false; Notifications.Success(L.T("ms.signing.toast.signed")); }
    }

    private async Task SignAsync()
    {
        if (busy || pending is null) return;   // a double tap signs once
        busy = true;
        error = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var privateKey = WalletService.GetPrivateKeyForMultisig()
                ?? throw new InvalidOperationException(L.T("ms.room.err.locked"));
            using var key = new NBitcoin.Key(Convert.FromHexString(privateKey));
            await MultisigService.SignPendingTransactionAsync(pending, key);   // saved here first, so nothing is lost
            await Room.SubmitSignatureAsync(pending.PsbtBase64);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeclineAsync()
    {
        confirmDecline = false;
        try { await Room.DeclineAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task BroadcastAsync()
    {
        if (broadcasting || pending is null) return;   // a double tap broadcasts once
        broadcastFailure = null;
        try { await Room.ClaimBroadcastAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CloseAsync()
    {
        try { await Room.CloseAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LeaveAsync()
    {
        await Room.LeaveAsync();
        endReason = "left";
        phase = Phase.Ended;
        StopTicker();
    }

    private async Task CopyLinkAsync()
    {
        await Clipboard.CopyAsync(InviteLink, toast: false);
        Notifications.Success(L.T("ms.signing.toast.link_copied"));
    }

    private async Task CopyCodeAsync()
    {
        if (view is null) return;
        await Clipboard.CopyAsync(view.InviteCode, toast: false);
        Notifications.Success(L.T("ms.signing.toast.code_copied"));
    }

    // The device's own share sheet where there is one; otherwise the link is copied.
    private async Task ShareInviteAsync()
    {
        if (view is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new
            {
                title = L.T("ms.signing.share_title"),
                text = L.T("ms.signing.share_text", view.InviteCode),
                url = InviteLink,
            });
        }
        catch { await CopyLinkAsync(); }
    }

    // A scanned invite fills in the code; the person still presses Join. Anything else is refused, never guessed at.
    private void OnInviteScanned(string data)
    {
        showScanner = false;
        string? scanned = null;
        var route = ScanRouter.Route(data, Nav.BaseUri);
        const string marker = "/multisig/sign-room?code=";
        if (route.Kind == ScanTarget.RoomInvite && route.Url is { } url && url.StartsWith(marker, StringComparison.OrdinalIgnoreCase))
            scanned = url[marker.Length..];
        else if (data.Trim().Length == RoomCodeInput.Length && RoomCodeInput.Clean(data).Length == RoomCodeInput.Length)
            scanned = data.Trim();

        if (scanned is null)
        {
            error = L.T("ms.signing.err.not_invite");
        }
        else
        {
            code = RoomCodeInput.Clean(scanned);
            error = null;
        }
        StateHasChanged();
    }

    // The result screen's one button: Activity when the payment was sent, the payment's own screen otherwise.
    private void GoNext() =>
        Nav.NavigateTo(config is not null && pending is { Status: PendingTxStatus.Broadcast }
            ? $"/multisig/{config.WalletId}/activity"
            : BackHref);

    // The bottom menu is hidden while the room is live or showing its result, so the pinned button owns the bottom
    // of the screen (FR-028). The join screen keeps the menu.
    protected override void OnAfterRender(bool firstRender) =>
        Chrome.SetHideNav(!redirectingToUnlock && phase is Phase.InRoom or Phase.Ended);

    // ─── Checks and timers ───

    /// <summary>FR-022: the payment can't complete once its coins are spent elsewhere.</summary>
    private async Task CheckCoinsAsync()
    {
        if (config is null || facts is null || pending is null || pending.Status == PendingTxStatus.Broadcast) return;
        // Shared with the pending list (specs/022): empty when chain data is unavailable, so nothing is guessed. Spent coins
        // never become unspent again, so once flagged it stays flagged.
        var spent = await MultisigService.GetSpentInputIdsAsync(config, facts.Inputs.Select(i => i.OutPoint));
        coinsSpent = coinsSpent || spent.Count > 0;
    }

    private void StartTicker()
    {
        if (ticker is not null) return;
        ticker = new CancellationTokenSource();
        var token = ticker.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            var seconds = 0;
            var checking = false;
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                seconds++;
                if (seconds % 60 == 0 && !checking)
                {
                    checking = true;
                    await InvokeAsync(CheckCoinsAsync);
                    checking = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }, token);
    }

    private void StopTicker()
    {
        ticker?.Cancel();
        ticker?.Dispose();
        ticker = null;
    }

    // ─── Display helpers ───

    private SignerInput SignerInputFor(string key)
    {
        var local = config?.CoSigners.FirstOrDefault(c => Same(c.PublicKeyHex, key));
        var participant = view?.Participants.FirstOrDefault(p => Same(p.PublicKeyHex, key));
        var mine = Same(key, Room.MyKey);
        var name = local?.Name ?? participant?.DisplayName ?? MultisigFormat.Short(key);
        if (!mine && participant is not null && participant.DisplayName != name)
            name += $" ({participant.DisplayName})";

        var status = pending?.SignedBy.Any(k => Same(k, key)) == true || view?.SignedKeys.Any(k => Same(k, key)) == true ? SignerStatus.Signed
            : participant?.Action == SigningParticipantAction.Declined ? SignerStatus.Declined
            : SignerStatus.Waiting;

        return new SignerInput(key, name, participant?.Online == true, status, participant?.IsCreator == true);
    }

    private string NameOf(string key)
    {
        if (Same(key, Room.MyKey)) return L.T("ms.signing.you");
        var participant = view?.Participants.FirstOrDefault(p => Same(p.PublicKeyHex, key));
        var local = config?.CoSigners.FirstOrDefault(c => Same(c.PublicKeyHex, key));
        return local?.Name ?? participant?.DisplayName ?? MultisigFormat.Short(key);
    }

    private bool SameNetwork(string roomNetwork)
    {
        var mine = MultisigService.ActiveNetwork == DigiByteNetwork.Testnet ? "test"
            : MultisigService.ActiveNetwork == DigiByteNetwork.Regtest ? "regtest" : "main";
        var theirs = (roomNetwork ?? "").Trim().ToLowerInvariant() switch
        {
            "mainnet" => "main",
            "testnet" => "test",
            var n => n,
        };
        return mine == theirs;
    }

    private static bool Same(string? a, string? b) => a is not null && b is not null && string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    public ValueTask DisposeAsync()
    {
        Chrome.SetHideNav(false);
        StopTicker();
        Room.RoomStateReceived -= OnRoomStateAsync;
        Room.SignatureAdded -= OnSignatureAddedAsync;
        Room.BroadcastGranted -= OnBroadcastGrantedAsync;
        Room.BroadcastClaimed -= OnBroadcastClaimedAsync;
        Room.Broadcasted -= OnBroadcastedAsync;
        Room.BroadcastFailed -= OnBroadcastFailedAsync;
        Room.RoomEnded -= OnRoomEndedAsync;
        Room.ErrorReceived -= OnErrorAsync;
        Room.ConnectionChanged -= OnConnectionChangedAsync;
        return ValueTask.CompletedTask;
    }
}
