@page "/multisig/{WalletId}/activity"
@inject MultisigWalletService MultisigService
@inject ActiveWalletContext ActiveWallet
@inject ClipboardService Clipboard
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalizationService L

<PageTitle>@L.T("ms.activity.page_title")</PageTitle>

<AuthGuard>
@if (isLoading)
{
    <div class="flex flex-col gap-3">
        <div class="h-6 w-48 skeleton rounded"></div>
        <div class="h-14 skeleton rounded-xl"></div>
        <div class="h-14 skeleton rounded-xl"></div>
    </div>
}
else if (config == null)
{
    <MultisigAccessNotice State="access" />
}
else
{
    <div class="flex flex-col gap-3">
        <PageHeader Title="@L.T("nav.activity")" BackLabel="@config.DisplayName" BackHref="@($"/multisig/{WalletId}")" />
        <div class="-mt-2"><SharedWalletContextLine Config="config" /></div>

        <ActivityList Entries="entries" Filter="filter" IsLoading="isLoadingMore" IsPartial="isPartial" HasMore="hasMore"
                      OnFilterChanged="f => filter = f" OnSelect="entry => selected = entry" OnLoadMore="LoadMore"
                      EmptyTitle="@EmptyTitle" EmptyHint="@EmptyHint">
            <EmptyActions>
                @if (filter == ActivityFilter.All)
                {
                    <button type="button" class="btn-primary btn-sm" @onclick="() => receiveOpen = true">@L.T("wallet.receive")</button>
                    <button type="button" class="min-h-[44px] px-4 bg-white dark:bg-dgb-900 border border-slate-200 dark:border-dgb-800 text-xs font-semibold rounded-xl text-slate-700 dark:text-slate-200 press-effect"
                            @onclick='() => Nav.NavigateTo($"/multisig/{WalletId}/send")'>@L.T("wallet.send")</button>
                }
            </EmptyActions>
        </ActivityList>
    </div>

    <ReceiveSheet IsOpen="receiveOpen" Address="@config.Address" Name="@config.DisplayName" OnClosed="() => receiveOpen = false" />

    @if (selected is not null)
    {
        var e = selected;
        <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="@L.T("ms.activity.details")" @onclick="() => selected = null">
            <div class="modal-card flex flex-col gap-3 max-h-[85vh] overflow-y-auto" @onclick:stopPropagation="true">
                <div class="flex items-center justify-between gap-2">
                    <h3 class="block-title">@DetailTitle(e)</h3>
                    <button type="button" class="min-w-[44px] min-h-[44px] text-slate-400" aria-label="@L.T("ms.activity.close_details")" @onclick="() => selected = null">✕</button>
                </div>
                <p class="text-2xl font-extrabold @(e.Direction == ActivityDirection.In ? "text-green-600 dark:text-green-400" : "text-slate-900 dark:text-white")">
                    @(e.Direction == ActivityDirection.In ? "+" : e.Direction == ActivityDirection.Out ? "−" : "")@MultisigFormat.Dgb(e.AmountSatoshis) <span class="text-base text-slate-400">DGB</span>
                </p>

                <dl class="flex flex-col gap-2 text-xs">
                    <div><dt class="text-slate-400">@L.T("ms.activity.when")</dt><dd class="text-slate-800 dark:text-slate-100">@MultisigFormat.When(e.Timestamp)</dd></div>
                    @if (e.FeeSatoshis is not null && e.FeeSatoshis > 0)
                    {
                        <div><dt class="text-slate-400">@L.T("dd.confirm.fee")</dt><dd class="text-slate-800 dark:text-slate-100">@MultisigFormat.Dgb(e.FeeSatoshis.Value) DGB</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(e.Counterparty))
                    {
                        <div>
                            <dt class="text-slate-400">@(e.Direction == ActivityDirection.In ? L.T("history.detail.from") : L.T("history.detail.to"))@(e.MoreCount > 0 ? " " + L.T("ms.activity.more", e.MoreCount) : "")</dt>
                            <dd class="font-mono break-all text-slate-800 dark:text-slate-100 select-all">@e.Counterparty</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(e.Memo))
                    {
                        <div><dt class="text-slate-400">@L.T("history.detail.memo")</dt><dd class="text-slate-800 dark:text-slate-100">@e.Memo</dd></div>
                    }
                    @if (e.SignedCount is not null)
                    {
                        <div><dt class="text-slate-400">@L.T("ms.activity.signatures")</dt><dd class="text-slate-800 dark:text-slate-100">@L.T("ms.activity.signed_of", e.SignedCount ?? 0, e.RequiredCount ?? 0)</dd></div>
                    }
                    @if (e.Confirmations is not null)
                    {
                        <div><dt class="text-slate-400">@L.T("ms.activity.confirmations")</dt><dd class="text-slate-800 dark:text-slate-100">@e.Confirmations</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(e.TxId))
                    {
                        <div>
                            <dt class="text-slate-400">@L.T("ms.activity.txid")</dt>
                            <dd class="font-mono break-all text-slate-800 dark:text-slate-100 select-all">@e.TxId</dd>
                        </div>
                    }
                </dl>

                <ol class="flex flex-col gap-1 text-[11px] text-slate-500 dark:text-slate-400 border-l-2 border-slate-200 dark:border-dgb-800 pl-3" aria-label="@L.T("ms.activity.timeline")">
                    @foreach (var step in Timeline(e))
                    {
                        <li>@step</li>
                    }
                </ol>

                <div class="flex items-center gap-2 flex-wrap">
                    @if (!string.IsNullOrEmpty(e.TxId))
                    {
                        <button type="button" class="btn-secondary btn-sm" @onclick="() => CopyTxId(e.TxId!)">@(copiedTx ? L.T("receive.copied") : L.T("ms.activity.copy_txid"))</button>
                        <button type="button" class="btn-secondary btn-sm" @onclick="() => OpenExplorer(e.TxId!)">@L.T("ms.activity.explorer")</button>
                    }
                    @if (e.IsPending || e.Kind == ActivityKind.Failed)
                    {
                        <button type="button" class="btn-primary btn-sm" @onclick='() => Nav.NavigateTo(string.IsNullOrEmpty(e.ProposalId) ? $"/multisig/{WalletId}/pending" : $"/multisig/{WalletId}/pending/{Uri.EscapeDataString(e.ProposalId)}")'>@L.T("ms.activity.open_payment")</button>
                    }
                </div>
            </div>
        </div>
    }
}
</AuthGuard>

@code {
    [CascadingParameter(Name = "Locale")] public string? Locale { get; set; }

    private const int PageSize = 25;

    [Parameter] public string WalletId { get; set; } = "";

    private MultisigWalletConfig? config;
    private MultisigAccessState access = MultisigAccessState.NotFound;
    private bool isLoading = true;
    private bool isLoadingMore;
    private bool isPartial;
    private bool hasMore;
    private bool receiveOpen;
    private bool copiedTx;
    private int chainLoaded;
    private ActivityFilter filter = ActivityFilter.All;
    private List<ActivityEntry> entries = [];
    private ActivityEntry? selected;

    private string EmptyTitle => filter switch
    {
        ActivityFilter.Received => L.T("ms.activity.empty.received"),
        ActivityFilter.Sent => L.T("ms.activity.empty.sent"),
        ActivityFilter.Pending => L.T("ms.activity.empty.pending"),
        ActivityFilter.Failed => L.T("ms.activity.empty.failed"),
        _ => L.T("ms.activity.empty.title"),
    };
    private string EmptyHint => filter == ActivityFilter.All
        ? L.T("ms.activity.empty.hint")
        : L.T("ms.activity.empty.filter_hint");

    private string? loadedFor;

    // Runs again when the same page is reused for a different multisig (e.g. a link to another one).
    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == WalletId) return;
        loadedFor = WalletId;
        isLoading = true;
        config = null;
        try
        {
            var owner = ActiveWallet.WalletId;
            var key = ActiveWallet.PublicKey;
            access = await MultisigService.GetAccessStateAsync(WalletId, owner, key);
            if (access != MultisigAccessState.Owned) return;
            config = await MultisigService.GetConfigAsync(WalletId, owner, key);
            if (config != null) await LoadPage(first: true);
        }
        finally { isLoading = false; }
    }

    private async Task LoadMore() => await LoadPage(first: false);

    private async Task LoadPage(bool first)
    {
        isLoadingMore = true;
        StateHasChanged();
        try
        {
            var page = await MultisigService.GetActivityAsync(config!, first ? 0 : chainLoaded, PageSize);
            isPartial = page.IsPartial;
            hasMore = page.HasMore;
            if (!page.IsPartial) chainLoaded += PageSize;

            foreach (var entry in page.Entries)
            {
                // The chain version of a broadcast proposal replaces the local "sent" line, so it shows once.
                if (!string.IsNullOrEmpty(entry.TxId))
                    entries.RemoveAll(e => string.Equals(e.TxId, entry.TxId, StringComparison.OrdinalIgnoreCase));
                entries.Add(entry);
            }
            entries = entries.OrderByDescending(e => e.Timestamp).ToList();
        }
        finally
        {
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private string DetailTitle(ActivityEntry e) => e.Kind switch
    {
        ActivityKind.Received => L.T("history.received"),
        ActivityKind.Sent => L.T("history.sent"),
        ActivityKind.ProposalAwaiting => L.T("ms.activity.kind.awaiting"),
        ActivityKind.ProposalReady => L.T("ms.activity.kind.ready"),
        ActivityKind.Failed => L.T("ms.activity.kind.failed"),
        ActivityKind.Cancelled => L.T("ms.activity.kind.cancelled"),
        _ => L.T("ms.activity.kind.transaction"),
    };

    private List<string> Timeline(ActivityEntry e)
    {
        var steps = new List<string>();
        if (e.ProposalId is not null)
        {
            steps.Add(L.T("ms.activity.step.proposed", MultisigFormat.When(e.Timestamp)));
            if (e.SignedCount is not null) steps.Add(L.T("ms.activity.step.signatures", e.SignedCount.Value, e.RequiredCount ?? 0));
        }
        switch (e.Kind)
        {
            case ActivityKind.ProposalReady: steps.Add(L.T("ms.activity.step.ready")); break;
            case ActivityKind.Failed: steps.Add(L.T("ms.activity.step.failed")); break;
            case ActivityKind.Cancelled: steps.Add(L.T("ms.activity.step.cancelled")); break;
            case ActivityKind.Sent:
            case ActivityKind.Received:
                steps.Add(e.Kind == ActivityKind.Sent ? L.T("ms.activity.step.broadcast") : L.T("ms.activity.step.seen"));
                steps.Add((e.Confirmations ?? 0) switch
                {
                    0 => L.T("ms.activity.step.first_confirmation"),
                    1 => L.T("ms.activity.step.confirmations.one"),
                    < 6 => L.T("ms.activity.step.confirmations.other", e.Confirmations!.Value),
                    _ => L.T("ms.activity.step.confirmed"),
                });
                break;
        }
        return steps;
    }

    private async Task CopyTxId(string txId)
    {
        await Clipboard.CopyAsync(txId, toast: false);
        copiedTx = true;
        StateHasChanged();
        await Task.Delay(2000);
        copiedTx = false;
    }

    private async Task OpenExplorer(string txId) =>
        await JS.InvokeVoidAsync("open", $"https://digiexplorer.info/tx/{txId}", "_blank");
}
