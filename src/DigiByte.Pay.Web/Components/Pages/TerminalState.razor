@* A final checkout state (confirmed, underpaid, expired, refunded, voided): icon, plain-language
   heading, what it means and what to do next (FR-009). No QR code or address is ever shown for a
   final state, so nobody pays an expired or cancelled invoice. Confirmed finishes the confirming
   screen's ring (ConfirmationProgress) so the two read as one flow; the rest use the receipt's seal. *@
@{
    var state = CheckoutStates.For(Status);
    var confirmed = Status == "confirmed";
    var showReceipt = !string.IsNullOrEmpty(Txid) && !string.IsNullOrEmpty(SessionId) && Status is "confirmed" or "refunded" or "underpaid";
    var returnsToShop = confirmed && !string.IsNullOrWhiteSpace(ReturnUrl);
    var required = CheckoutStates.ConfirmationsRequired;
    const double circumference = 2 * Math.PI * 52;
}
<div class="ui-terminal @(confirmed ? "is-confirmed" : "")">
    @if (confirmed)
    {
        <div class="ui-confirm-ring ui-terminal-ring" aria-hidden="true">
            <svg viewBox="0 0 120 120" width="120" height="120">
                <circle class="ui-confirm-ring-track" cx="60" cy="60" r="52" />
                <circle class="ui-confirm-ring-fill ui-terminal-ring-draw" cx="60" cy="60" r="52"
                        stroke-dasharray="@circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                        style="--ui-ring-length: @circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
            </svg>
            <span class="ui-confirm-ring-center"><Icon Name="check" Class="ui-terminal-check" /></span>
        </div>
    }
    else
    {
        <span class="ui-receipt-seal @SealClass(state.Tone)" aria-hidden="true">
            <Icon Name="@state.Icon" Class="w-8 h-8" />
        </span>
    }

    <div class="ui-terminal-copy">
        <h2 class="block-title">@state.Heading</h2>
        <p class="ui-checkout-muted">@state.Explanation</p>
    </div>

    @if (confirmed)
    {
        <p class="ui-terminal-final">
            <span class="ui-receipt-dots" aria-hidden="true">
                @for (var i = 0; i < required; i++)
                {
                    <span class="is-done"></span>
                }
            </span>
            <span>@required of @required confirmations · Final</span>
        </p>
    }

    @if (Status == "underpaid" && ExpectedSatoshis > 0)
    {
        <dl class="ui-terminal-amounts">
            <div><dt>Received</dt><dd class="font-mono tabular-nums">@FormatAmount(ReceivedSatoshis)</dd></div>
            <div><dt>Expected</dt><dd class="font-mono tabular-nums">@FormatAmount(ExpectedSatoshis)</dd></div>
        </dl>
    }

    @if (!string.IsNullOrEmpty(Txid) && Status is "confirmed" or "refunded")
    {
        <div class="ui-checkout-copyrow w-full">
            <div class="min-w-0 flex-1 text-left">
                <p class="section-label">Transaction ID</p>
                <p id="terminal-txid" class="ui-checkout-address">@Txid</p>
            </div>
            <CopyButton Value="@Txid" Label="Copy transaction ID" TargetId="terminal-txid" SuccessText="Transaction ID copied" Variant="icon" />
        </div>
    }

    @* Merchant return flow (confirmed only, when the shop gave a return URL). checkout-countdown.js
       watches [data-digipay-return-merchant] and returns after 8 seconds (paused while the receipt link
       is pointed at or focused, so the shopper can still reach it); the button works at once. In the
       embed iframe the shop's page does the navigating (data-digipay-return-link). With no shop to go
       back to, the receipt is the main action. *@
    @if (returnsToShop)
    {
        <div data-digipay-return-merchant
             data-digipay-return-url="@ReturnUrl"
             data-digipay-return-seconds="8"
             class="w-full flex flex-col items-center gap-2">
            <a href="@ReturnUrl" class="btn-primary w-full" data-digipay-return-link>Back to the shop</a>
            <p class="ui-checkout-muted">Returning automatically in <span data-digipay-return-countdown>8</span>…</p>
        </div>
    }

    @if (showReceipt)
    {
        <a href="@ReceiptHref" class="@(confirmed && !returnsToShop ? "btn-primary" : "btn-secondary") w-full" data-digipay-return-pause>
            <Icon Name="receipt" Class="w-4 h-4" />
            <span>View receipt</span>
        </a>
    }

    @if (Status is "expired" or "voided" && !string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <a href="@ReturnUrl" class="btn-primary w-full" data-digipay-return-link>Back to the shop</a>
    }
</div>

@code {
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string? Txid { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    /// <summary>Receipt link, carrying a shop-set theme when there is one.</summary>
    [Parameter] public string? ReceiptHref { get; set; }

    [Parameter] public long ReceivedSatoshis { get; set; }
    [Parameter] public long ExpectedSatoshis { get; set; }
    [Parameter] public string Currency { get; set; } = "DGB";

    protected override void OnParametersSet() =>
        ReceiptHref ??= SessionId is null ? null : $"/pay/{Uri.EscapeDataString(SessionId)}/receipt";

    private static string SealClass(BadgeTone tone) => tone switch
    {
        BadgeTone.Success => "",
        BadgeTone.Danger => "is-danger",
        BadgeTone.Refund => "is-refund",
        BadgeTone.Info => "is-pending",
        _ => "is-neutral",
    };

    private string FormatAmount(long sats) =>
        (sats / 100_000_000m).ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) + (Currency == "DD" ? " DD" : " DGB");
}
