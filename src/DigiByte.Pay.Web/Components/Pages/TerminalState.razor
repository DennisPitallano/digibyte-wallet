@* A final checkout state (confirmed, underpaid, expired, refunded, voided): icon, plain-language
   heading, what it means and what to do next (FR-009). No QR code or address is ever shown for a
   final state, so nobody pays an expired or cancelled invoice. *@
@{
    var state = CheckoutStates.For(Status);
    var showReceipt = !string.IsNullOrEmpty(Txid) && !string.IsNullOrEmpty(SessionId) && Status is "confirmed" or "refunded" or "underpaid";
}
<div class="ui-terminal">
    <span class="ui-terminal-icon ui-badge-@StatusBadge.ToneClass(state.Tone)" aria-hidden="true">
        <Icon Name="@state.Icon" Class="w-7 h-7" />
    </span>
    <h2 class="block-title">@state.Heading</h2>
    <p class="ui-checkout-muted">@state.Explanation</p>

    @if (Status == "underpaid" && ExpectedSatoshis > 0)
    {
        <dl class="ui-terminal-amounts">
            <div><dt>Received</dt><dd class="font-mono tabular-nums">@FormatAmount(ReceivedSatoshis)</dd></div>
            <div><dt>Expected</dt><dd class="font-mono tabular-nums">@FormatAmount(ExpectedSatoshis)</dd></div>
        </dl>
    }

    @if (!string.IsNullOrEmpty(Txid) && Status is "confirmed" or "refunded")
    {
        <div class="ui-checkout-copyrow w-full">
            <div class="min-w-0 flex-1 text-left">
                <p class="section-label">Transaction ID</p>
                <p id="terminal-txid" class="ui-checkout-address">@Txid</p>
            </div>
            <CopyButton Value="@Txid" Label="Copy transaction ID" TargetId="terminal-txid" SuccessText="Transaction ID copied" Variant="icon" />
        </div>
    }

    @if (showReceipt)
    {
        <a href="@ReceiptHref" class="btn-secondary w-full">View receipt</a>
    }

    @* Merchant return flow (confirmed only, when the shop gave a return URL). checkout-countdown.js
       watches [data-digipay-return-merchant] and returns after 5 seconds; the button works at once. *@
    @if (Status == "confirmed" && !string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <div data-digipay-return-merchant
             data-digipay-return-url="@ReturnUrl"
             data-digipay-return-seconds="5"
             class="w-full flex flex-col items-center gap-2">
            <a href="@ReturnUrl" class="btn-primary w-full">Back to the shop</a>
            <p class="ui-checkout-muted">Returning automatically in <span data-digipay-return-countdown>5</span>…</p>
        </div>
    }
    else if (Status is "expired" or "voided" && !string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <a href="@ReturnUrl" class="btn-primary w-full">Back to the shop</a>
    }
</div>

@code {
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string? Txid { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    /// <summary>Receipt link, carrying a shop-set theme when there is one.</summary>
    [Parameter] public string? ReceiptHref { get; set; }

    [Parameter] public long ReceivedSatoshis { get; set; }
    [Parameter] public long ExpectedSatoshis { get; set; }
    [Parameter] public string Currency { get; set; } = "DGB";

    protected override void OnParametersSet() =>
        ReceiptHref ??= SessionId is null ? null : $"/pay/{Uri.EscapeDataString(SessionId)}/receipt";

    private string FormatAmount(long sats) =>
        (sats / 100_000_000m).ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) + (Currency == "DD" ? " DD" : " DGB");
}
