@page "/"
@layout SiteLayout
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@using System.Net.Http.Json

<PageTitle>DigiPay — accept DigiByte on your site</PageTitle>
<HeadContent><meta name="description" content="Accept DigiByte on your website, at the counter or by invoice. DigiPay is non-custodial: payments go straight to your own wallet, with no DigiPay fees." /></HeadContent>


    <main id="main" class="flex-1 page-enter">
        @* Hero — stagger the eyebrow badge, headline, subhead, and CTA row
           so the fold animates in like a single composed block. Two paths: merchants
           (sign in) and developers (quickstart / API reference). *@
        @* Hero on a full-width decorative background: a soft glow, a fading grid and slowly drifting shapes
           (digipay-docs.css; still for reduced motion). *@
        <div class="dp-hero-wrap">
            <div class="dp-hero-bg" aria-hidden="true">
                <span class="dp-hero-grid"></span>
                @* Payment and merchant scenes floating at the edges, away from the headline. Decorative only. *@
                <svg class="dp-hero-flow" viewBox="0 0 1200 520" preserveAspectRatio="none">
                    <path d="M150 140 C 380 60, 820 60, 1050 150" />
                    <path d="M170 390 C 420 470, 780 470, 1030 380" />
                </svg>

                <div class="dp-hf dp-hf-receipt">
                    <div class="dp-hf-row"><span class="dp-hf-store"><Icon Name="store" Class="w-3.5 h-3.5" /></span><span class="dp-hf-strong">Kape Corner</span></div>
                    <div class="dp-hf-amount">₱1,250.00</div>
                    <div class="dp-hf-sub">≈ 7,847.57 DGB</div>
                    <div class="dp-hf-paid"><Icon Name="check" Class="w-3 h-3" />Paid</div>
                </div>

                <div class="dp-hf dp-hf-qr">
                    @* A real DigiByte QR: DigiPay's own tip address (the footer's "Tip us"). Scanning opens a wallet with
                       the address filled in; nothing is sent until the person confirms. *@
                    <img class="dp-hf-qrcode" src="@TipQr" alt="" width="60" height="60" />
                    <span class="dp-hf-sub">Tip DigiPay</span>
                </div>

                <div class="dp-hf dp-hf-toast">
                    <span class="dp-hf-check"><Icon Name="check" Class="w-4 h-4" /></span>
                    <div>
                        <div class="dp-hf-strong">Payment received</div>
                        <div class="dp-hf-sub">+42 DGB · just now</div>
                    </div>
                </div>

                <div class="dp-hf dp-hf-confirm">
                    <span class="dp-hf-dots"><i></i><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="dp-hf-sub">6 of 6 confirmations</span>
                </div>

                <div class="dp-hf dp-hf-shop">
                    <span class="dp-hf-shopicon"><Icon Name="package" Class="w-4 h-4" /></span>
                    <div>
                        <div class="dp-hf-strong">Online store</div>
                        <div class="dp-hf-sub">New order paid</div>
                    </div>
                </div>

                <span class="dp-hf-coin dp-hf-coin-a"><img src="/digibyte-logo.svg" alt="" width="40" height="40" /></span>
                <span class="dp-hf-coin dp-hf-coin-b"><img src="/digibyte-logo.svg" alt="" width="40" height="40" /></span>
            </div>
            <section class="dp-hero max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 text-center">
                <div class="inline-block px-3 py-1 bg-dgb-500/10 text-dgb-500 rounded-full text-xs font-semibold mb-5 slide-up">
                    No DigiPay fees · Non-custodial · 15-second blocks
                </div>
                <h1 class="text-3xl sm:text-5xl font-bold leading-[1.1] tracking-tight max-w-4xl mx-auto slide-up-delay-1">
                    Accept DigiByte on your site.<br class="hidden sm:block" />
                    <span class="sm:inline"> Without holding a cent of it.</span>
                </h1>
                <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed slide-up-delay-2">
                    DigiPay derives a fresh address per invoice from your wallet's xpub, watches the chain,
                    and notifies your server the moment a payment lands. Sign in with Digi-ID, paste an
                    xpub, start accepting DGB in under a minute.
                </p>
                <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center slide-up-delay-3">
                    @* Primary CTA swaps based on auth state — boot script sets
                       data-digipay-auth on <html> before paint, CSS hides whichever
                       variant doesn't match. *@
                    <a href="/merchant/signin" data-auth-show="out"
                       class="btn-primary inline-flex items-center justify-center gap-1.5">
                        Start accepting DGB →
                    </a>
                    <a href="/merchant" data-auth-show="in"
                       class="btn-primary inline-flex items-center justify-center gap-1.5">
                        <Icon Name="dashboard" Class="w-4 h-4" />
                        Open dashboard →
                    </a>
                    <a href="/docs#quickstart"
                       class="btn-secondary inline-flex items-center justify-center gap-1.5">
                        <Icon Name="code" Class="w-4 h-4" />
                        Developer quickstart
                    </a>
                </div>
                @* Developer strip — integrators scanning for "is there an API / a package for my
                   stack" get a direct answer without scrolling. *@
                <div class="mt-5 flex flex-wrap justify-center items-center gap-x-4 gap-y-1 text-[0.6875rem] sm:text-xs text-slate-500 dark:text-slate-400 slide-up-delay-4">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">For developers:</span>
                    <a href="/docs/api" class="hover:text-dgb-500 transition-colors no-underline">API reference</a>
                    <span class="opacity-40" aria-hidden="true">·</span>
                    <a href="/sdks" class="hover:text-dgb-500 transition-colors no-underline">SDKs for Node, Python, .NET</a>
                    <span class="opacity-40" aria-hidden="true">·</span>
                    <a href="/docs/woocommerce" class="hover:text-dgb-500 transition-colors no-underline">WooCommerce plugin</a>
                </div>
                @* Only pitch the wallet to signed-out visitors — signed-in merchants
                   already have a wallet (they signed in with Digi-ID). *@
                <p class="mt-5 text-xs text-slate-500 dark:text-slate-400" data-auth-show="out">
                    New to DigiByte? Grab a wallet first —
                    <a href="https://dgbwallet.app" target="_blank" rel="noopener" class="text-dgb-500 hover:underline">dgbwallet.app</a>.
                </p>
            </section>
        </div>

        @* Public stats strip. Aggregates only — no merchant ids, no sessions —
           so privacy is preserved while still giving visitors a read on momentum.
           Fetched while the page is rendered on the server; skipped entirely if the
           API is down rather than showing a spinner. *@
        @if (Stats is { } stats)
        {
            @* Live numbers: they count up once the page is live (wwwroot/js/count-up.js); the server-rendered HTML
               already holds the real figures, for search engines and anyone without JavaScript. *@
            <section class="dp-stats" aria-labelledby="dp-stats-title" @ref="statsRef">
                <div class="dp-stats-head">
                    <span class="dp-stats-live"><span class="dp-stats-dot" aria-hidden="true"></span>Live on DigiPay</span>
                    <h2 id="dp-stats-title" class="sr-only">DigiPay in numbers</h2>
                    <span class="dp-stats-updated">Updated @UpdatedText(stats.GeneratedAt)</span>
                </div>
                <div class="dp-stats-grid">
                    @StatTile("users", null, stats.Merchants, 0, "Merchants", "accepting DigiByte", 0)
                    @StatTile("store", null, stats.Stores, 0, "Stores", "online shops and counters", 1)
                    @StatTile("receipt", null, stats.Sessions, 0, "Payments", $"{stats.PaidSessions:N0} paid so far", 2)
                    @StatTile(null, "/digibyte-logo.svg", stats.TotalDgb, 0, "DGB processed", "to merchants' own wallets", 3)
                </div>
            </section>
        }

        @* The problem DigiPay solves — contrasted with the status quo so the value prop is concrete, not abstract. *@
        <section class="dp-after-stats max-w-6xl mx-auto px-4 sm:px-6 pb-10 sm:pb-14">
            <p class="text-center text-[0.6875rem] sm:text-xs font-bold tracking-widest text-dgb-500 uppercase mb-2">The problem</p>
            <h2 class="text-center text-2xl sm:text-3xl font-bold mb-8 sm:mb-10 tracking-tight max-w-3xl mx-auto">Why accepting crypto is usually painful</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 max-w-4xl mx-auto">
                <div class="card p-5 sm:p-6 !border-red-200 dark:!border-red-800/40">
                    <div class="text-[0.6875rem] font-bold tracking-widest uppercase text-red-500 dark:text-red-400 mb-2">Without DigiPay</div>
                    <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed m-0 list-disc pl-5">
                        <li>Custodial gateway holds your funds and takes a cut, plus KYC forms.</li>
                        <li>Every customer sees the same address — anyone can see your revenue.</li>
                        <li>You build the mempool watcher, webhook signer, and retry queue yourself.</li>
                        <li>Self-hosted BTCPay is powerful but heavy — needs a full node + hours to configure.</li>
                        <li>Price volatility during payment means you either eat the swing or ship reconciliation code.</li>
                    </ul>
                </div>
                <div class="card p-5 sm:p-6 !border-emerald-200 dark:!border-emerald-800/30">
                    <div class="text-[0.6875rem] font-bold tracking-widest uppercase text-emerald-700 dark:text-emerald-300 mb-2">With DigiPay</div>
                    <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed m-0 list-disc pl-5">
                        <li>Non-custodial by design — you paste an xpub, funds flow straight to your wallet.</li>
                        <li>No DigiPay fees. The shopper's wallet pays only the normal DigiByte network fee.</li>
                        <li>Fresh receive address per invoice via BIP84 derivation. Nothing links between payments.</li>
                        <li>Hosted checkout, signed webhooks, late-payment reconciliation all handled.</li>
                        <li>No node needed — DigiPay queries DigiByte explorers on your behalf.</li>
                        <li>Sign in with your wallet (Digi-ID). No password, no email, no KYC.</li>
                    </ul>
                </div>
            </div>
        </section>

        @* Use cases: one card per way of getting paid (UseCases.All, shared with /use-cases), each opening its section. *@
        <section class="dp-uc-teaser" aria-labelledby="uc-teaser-title">
            <p class="text-center section-label mb-2">Use cases</p>
            <h2 id="uc-teaser-title" class="text-center text-2xl sm:text-3xl font-bold mb-2 tracking-tight">Who this is for</h2>
            <p class="dp-uc-lead text-center">Online, at the counter, by invoice or as a tip. Pick the one that sounds like you.</p>
            <div class="dp-uc-teaser-grid">
                @foreach (var (uc, i) in UseCases.All.Select((u, i) => (u, i)))
                {
                    <a href="@($"/use-cases#{uc.Key}")" class="dp-uc-mini" style="--i: @i">
                        <span class="dp-uc-icon" aria-hidden="true"><Icon Name="@uc.Icon" Class="w-5 h-5" /></span>
                        <span class="dp-uc-mini-text">
                            <span class="dp-uc-mini-title">@uc.Title</span>
                            <span class="dp-uc-mini-summary">@uc.Summary</span>
                        </span>
                        <Icon Name="arrow-right" Class="w-4 h-4 dp-uc-mini-arrow" />
                    </a>
                }
            </div>
            <p class="text-center mt-5"><a href="/use-cases" class="btn-secondary btn-sm">See all use cases <Icon Name="arrow-right" Class="w-4 h-4" /></a></p>
        </section>

        @* Features *@
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
            <p class="text-center text-[0.6875rem] sm:text-xs font-bold tracking-widest text-dgb-500 uppercase mb-2">What you get</p>
            <h2 class="text-center text-2xl sm:text-3xl font-bold mb-8 sm:mb-10 tracking-tight">Everything you need, nothing you don't</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                <Feature IconName="zap" Title="Hosted checkout"
                    Body="A buyer-facing page with QR + wallet deep link. Live status via SignalR — no polling your merchant UI." />
                <Feature IconName="shield" Title="Non-custodial"
                    Body="DGB payments go straight to your wallet: DigiPay never holds your keys or your DGB. DigiDollar (beta) is the exception: DigiPay holds it until it's paid out to your own DD address." />
                <Feature IconName="bell" Title="Signed webhooks"
                    Body="HMAC-SHA256 POST on every state change: seen, paid, confirmed, underpaid, expired, refunded, voided. Failed deliveries retry automatically, and any delivery can be replayed from the dashboard." />
                <Feature IconName="gift" Title="Donation button"
                    Body="Zero-backend tip jar — paste a single anchor tag or a data-attribute on any page." />
                <Feature IconName="package" Title="7 KB JS embed"
                    Body="Drop-in script opens the checkout as a modal on the merchant's own page — buyer never leaves your site." />
                <Feature IconName="fingerprint" Title="Sign in with Digi-ID"
                    Body="No password, no email, no KYC. Your DigiByte wallet is your account — sign a challenge, you're in." />
            </div>
        </section>

        @* Steps — the site menu's "How it works" link lands here (/#how-it-works). *@
        <section id="how-it-works" class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
            <p class="text-center text-[0.6875rem] sm:text-xs font-bold tracking-widest text-dgb-500 uppercase mb-2">How it works</p>
            <h2 class="text-center text-2xl sm:text-3xl font-bold mb-8 sm:mb-10 tracking-tight">From zero to first payment in four steps</h2>
            <div class="grid gap-3 max-w-2xl mx-auto">
                <Step N="1" Title="Sign in with Digi-ID"
                    Body="Scan a QR with your DigiByte wallet. No account, no password — your wallet is your identity." />
                <Step N="2" Title="Paste an xpub or address"
                    Body="Account-level xpub gives you a fresh address per invoice (recommended). A single address works too for tip jars." />
                <Step N="3" Title="Create a session"
                    Body="One POST from your server returns a checkoutUrl. Redirect your buyer there, or open it as a modal with our 7 KB embed." />
                <Step N="4" Title="Get paid, get notified"
                    Body="Buyer pays. DigiPay detects the tx in the mempool, tracks confirmations, and POSTs a signed webhook to your server at each state change." />
            </div>
            <div class="text-center mt-8 flex flex-col sm:flex-row gap-3 justify-center">
                <a href="/docs#quickstart" class="btn-secondary inline-flex items-center justify-center">
                    Developer quickstart
                </a>
                <a href="/embed/demo.html" target="_blank" class="btn-secondary inline-flex items-center justify-center">
                    Live embed demo →<span class="sr-only"> (opens in a new tab)</span>
                </a>
            </div>
        </section>

        @* Recently shipped — a short strip; the full roadmap lives in one place (ProductStatus,
           rendered on /features#roadmap) so the two pages can't disagree. *@
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
            <p class="text-center text-[0.6875rem] sm:text-xs font-bold tracking-widest text-dgb-500 uppercase mb-2">Status</p>
            <h2 class="text-center text-2xl sm:text-3xl font-bold mb-2 tracking-tight">Recently shipped</h2>
            <p class="text-center text-sm text-slate-500 dark:text-slate-400 mb-8">DigiPay is in @ProductStatus.Stage and open source.</p>
            <ul class="dp-shipped-list max-w-5xl mx-auto">
                @foreach (var item in ProductStatus.InStage(RoadmapStage.Shipped).Take(6))
                {
                    <li class="card dp-shipped-item">
                        <Icon Name="check-circle" Class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
                        <div class="min-w-0"><strong>@item.Title</strong><span>@item.Description</span></div>
                    </li>
                }
            </ul>
            <p class="text-center mt-6">
                <a href="@ProductStatus.RoadmapHref" class="text-sm font-semibold text-dgb-500 hover:underline">See the full roadmap →</a>
            </p>
        </section>

        @* Support card — doubles as a live demo of the donation button: the link goes to DigiPay's
           own hosted tip page, the same page the embed's data-digipay-button opens. A plain link (not
           the embed script) so it works before the live connection is up and survives re-rendering. *@
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
            <div class="card max-w-3xl mx-auto p-6 sm:p-8 text-center">
                <p class="text-[0.6875rem] sm:text-xs font-bold tracking-widest text-dgb-500 uppercase mb-2">Support the project</p>
                <h2 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Built by humans, runs on DigiByte</h2>
                <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed mb-6 max-w-xl mx-auto">
                    If DigiPay saves you from writing a payment gateway yourself, throw us a few DGB. 100% of donations fund infrastructure and continued development — the button below uses DigiPay's own donation page, so you're also seeing a live demo.
                </p>
                <div class="flex justify-center">
                    <a href="/pay/button?to=dgb1qvc2d6umstxzrs5xypmvw5wt33mchec4z7ejqaa&name=DigiPay&label=Thanks+for+supporting+DigiPay%21"
                       target="_blank" rel="noopener" class="dp-tip-button">
                        Tip DGB<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-4">
                    Or copy the address: <span class="font-mono text-[0.6875rem] break-all">dgb1qvc2d6umstxzrs5xypmvw5wt33mchec4z7ejqaa</span>
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                    <a href="/docs#donation-button" class="text-dgb-500 hover:underline">Want one of these on your own site?</a>
                </p>
            </div>
        </section>

        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 text-center">
            <h2 class="text-2xl sm:text-3xl font-bold mb-6 tracking-tight" data-auth-show="out">Ready?</h2>
            <h2 class="text-2xl sm:text-3xl font-bold mb-6 tracking-tight" data-auth-show="in">Jump back in</h2>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="/merchant/signin" data-auth-show="out"
                   class="btn-primary inline-flex items-center justify-center">
                    Start accepting DGB
                </a>
                <a href="/merchant" data-auth-show="in"
                   class="btn-primary inline-flex items-center justify-center gap-1.5">
                    <Icon Name="dashboard" Class="w-4 h-4" />
                    Open dashboard
                </a>
                <a href="/docs#quickstart"
                   class="btn-secondary inline-flex items-center justify-center">
                    Developer quickstart
                </a>
                <a href="/docs/api"
                   class="btn-secondary inline-flex items-center justify-center">
                    API reference
                </a>
            </div>
            <p class="mt-5 text-xs text-slate-500 dark:text-slate-400" data-auth-show="out">
                Need a DigiByte wallet to sign in? Install one at
                <a href="https://dgbwallet.app" target="_blank" rel="noopener" class="text-dgb-500 hover:underline">dgbwallet.app</a>.
            </p>
        </section>
    </main>


@code {
    /// <summary>
    /// Public counters. Fetched while the page is rendered on the server and carried over to the live
    /// page (PersistentState), so they arrive in the first HTML and aren't fetched twice.
    /// </summary>
    [PersistentState]
    public StatsDto? Stats { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Stats is not null) return;
        // Best-effort — if the API is unreachable we silently skip the strip rather
        // than blocking the home page load.
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
            Stats = await http.GetFromJsonAsync<StatsDto>("/v1/pay/public/stats", cts.Token);
        }
        catch { /* swallow — strip just won't render */ }
    }

    private ElementReference statsRef;

    // DigiPay's tip address (also in the footer and the tip section below), as a digibyte: payment request.
    private const string TipUri = "digibyte:dgb1qvc2d6umstxzrs5xypmvw5wt33mchec4z7ejqaa?label=DigiPay";

    /// <summary>The hero's QR tile: a real, scannable code for <see cref="TipUri"/>, made once per process.</summary>
    private static readonly string TipQr = MakeQr(TipUri);

    private static string MakeQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.M);
        using var png = new QRCoder.PngByteQRCode(data);
        return "data:image/png;base64," + Convert.ToBase64String(png.GetGraphic(4));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page is live: count the numbers up (skipped for reduced motion inside the script).
        if (!firstRender || Stats is null) return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/count-up.js");
            await module.InvokeVoidAsync("countUp", statsRef);
        }
        catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
    }

    private static string UpdatedText(DateTime generatedAt)
    {
        var age = DateTime.UtcNow - DateTime.SpecifyKind(generatedAt, DateTimeKind.Utc);
        return age.TotalMinutes < 1 ? "just now" : age.TotalHours < 1 ? $"{(int)age.TotalMinutes} min ago" : $"{(int)age.TotalHours} h ago";
    }

    private RenderFragment StatTile(string? icon, string? image, decimal value, int decimals, string label, string caption, int index) => __builder =>
    {
        var text = value.ToString("N" + decimals, System.Globalization.CultureInfo.InvariantCulture);
        <div class="dp-stat" style="--i: @index">
            <span class="dp-stat-icon" aria-hidden="true">
                @if (image is not null)
                {
                    <img src="@image" alt="" width="22" height="22" />
                }
                else
                {
                    <Icon Name="@icon" Class="w-5 h-5" />
                }
            </span>
            <p class="dp-stat-value tabular-nums" data-count-to="@value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-decimals="@decimals">@text</p>
            <p class="dp-stat-label">@label</p>
            <p class="dp-stat-caption">@caption</p>
        </div>
    };

    public sealed record StatsDto(int Merchants, int Stores, int Sessions, int PaidSessions, decimal TotalDgb, DateTime GeneratedAt);
}
