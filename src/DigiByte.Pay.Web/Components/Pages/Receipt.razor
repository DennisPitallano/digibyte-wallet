@page "/pay/{SessionId}/receipt"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHttpClientFactory HttpFactory
@inject PersistentComponentState AppState
@inject ILogger<Receipt> Log
@inject IJSRuntime JS
@using System.Globalization
@using System.Net.Http.Json

@* Shopper's proof of payment (spec 032, US1): outcome, amount, a slip of the details, the
   transaction ID with a copy button and a QR of it, and a Blockchair PDF receipt like the wallet's. Read-only, no live connection:
   until the payment is final it re-reads the session every 15 seconds so the confirmations move.
   Prints dark on white in either theme (FR-028). Same components and states as the checkout. *@

<PageTitle>@PageTitleText</PageTitle>

<main id="main" class="ui-shopper-page page-enter">
    <div class="w-full max-w-md">
        @if (loadFailed)
        {
            <div class="card ui-checkout ui-checkout-center">
                <StatusBadge Status="@CheckoutStates.LoadFailed" />
                <h1 class="page-title">This receipt could not be loaded</h1>
                <p class="ui-checkout-muted">Check your connection and try again. If it keeps happening, ask the merchant for a copy.</p>
                <button type="button" class="btn-primary w-full" @onclick="LoadAsync" disabled="@loading">
                    <Icon Name="refresh" Class="w-4 h-4" />
                    <span>@(loading ? "Trying again…" : "Try again")</span>
                </button>
            </div>
        }
        else if (session == null)
        {
            <div class="card ui-checkout ui-checkout-center" aria-busy="true">
                <h1 class="sr-only">Loading receipt</h1>
                <Loader Text="Loading receipt…" />
            </div>
        }
        else if (string.IsNullOrEmpty(session.PaidTxid))
        {
            @* Not paid yet (waiting, detected, expired): nothing to show, so send the shopper back. *@
            <div class="card ui-checkout ui-checkout-center">
                <StatusBadge Status="@session.Status" />
                <h1 class="page-title">No payment yet</h1>
                <p class="ui-checkout-muted">This payment hasn't been made. The receipt appears here once the transaction is sent.</p>
                <a href="@CheckoutHref" class="btn-primary w-full">Back to the payment</a>
            </div>
        }
        else
        {
            var confirmed = session.Status == "confirmed";
            var (heading, seal, sealIcon) = session.Status switch
            {
                "confirmed" => ("Payment confirmed", "", "check-circle"),
                "underpaid" => ("Partial payment received", "is-danger", "alert"),
                "refunded" => ("Payment refunded", "is-refund", "undo"),
                _ => ("Payment received", "is-pending", "clock"),
            };
            var required = CheckoutStates.ConfirmationsRequired;
            var confs = Math.Clamp(session.Confirmations, 0, required);
            var isDd = session.Currency == "DD";
            <article class="card ui-checkout ui-receipt" aria-labelledby="receipt-heading">
                @* Hero: outcome first, then who was paid and how much. *@
                <header class="ui-receipt-hero">
                    <span class="ui-receipt-seal @seal" aria-hidden="true">
                        <Icon Name="@sealIcon" Class="w-8 h-8" />
                    </span>
                    <h1 id="receipt-heading" class="page-title">@heading</h1>
                    <p class="ui-checkout-merchant">Paid to <strong class="ui-receipt-merchant">@(merchantName ?? "the merchant")</strong></p>
                </header>

                <div class="ui-checkout-amount">
                    @if (isDd && session.AmountCentsDd is { } ddCents)
                    {
                        <p class="ui-checkout-big">@FormatUsd(ddCents) <span class="ui-checkout-unit">USD</span></p>
                        <p class="ui-checkout-muted">Paid in DigiDollar</p>
                    }
                    else if (session.FiatAmount is { } fiatAmt && !string.IsNullOrWhiteSpace(session.FiatCurrency))
                    {
                        <p class="ui-checkout-big">@Fiat.Format(fiatAmt, session.FiatCurrency) <span class="ui-checkout-unit">@session.FiatCurrency!.ToUpperInvariant()</span></p>
                        <p class="ui-checkout-muted"><span class="font-mono tabular-nums">@FormatDgb(session.AmountSatoshis)</span> DGB</p>
                    }
                    else
                    {
                        <p class="ui-checkout-big">@FormatDgb(session.AmountSatoshis) <span class="ui-checkout-unit">DGB</span></p>
                    }
                </div>

                @* Tear line: everything below reads like a printed slip. *@
                <div class="ui-receipt-tear" aria-hidden="true"></div>

                <dl class="ui-receipt-facts">
                    @if (!string.IsNullOrWhiteSpace(session.Label))
                    {
                        <div><dt>For</dt><dd class="ui-receipt-wrap">@session.Label</dd></div>
                    }
                    @if (session.Status == "underpaid")
                    {
                        <div><dt>Received</dt><dd class="font-mono tabular-nums">@FormatReceived(session.ReceivedSatoshis, isDd)</dd></div>
                    }
                    <div><dt>Paid at</dt><dd class="font-mono tabular-nums">@PaidAtText</dd></div>
                    <div>
                        <dt>Status</dt>
                        <dd class="ui-receipt-status @(confirmed ? "is-final" : "")">
                            <span class="ui-receipt-dots" aria-hidden="true">
                                @for (var i = 1; i <= required; i++)
                                {
                                    <span class="@(i <= confs ? "is-done" : "")"></span>
                                }
                            </span>
                            <span>@StatusText(session.Status) · @confs/@required</span>
                        </dd>
                    </div>
                    <div><dt>Reference</dt><dd class="font-mono ui-receipt-wrap">@session.Id</dd></div>
                </dl>

                <div class="ui-receipt-tear" aria-hidden="true"></div>

                @* Proof: the txid to copy, and a QR of it to check from a phone or from paper. *@
                <section class="ui-receipt-proof" aria-label="Transaction">
                    <div class="qr-frame qr-frame-sm shrink-0">
                        <img src="@qrDataUrl" alt="QR code of the transaction ID" width="104" height="104" class="ui-receipt-qr" />
                    </div>
                    <div class="min-w-0 flex-1 flex flex-col gap-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="section-label">Transaction ID</p>
                            <CopyButton Value="@session.PaidTxid" Label="Copy transaction ID" TargetId="receipt-txid" SuccessText="Transaction ID copied" Variant="icon" Class="ui-no-print" />
                        </div>
                        <p id="receipt-txid" class="ui-checkout-address ui-receipt-txid">@session.PaidTxid</p>
                        <p class="ui-receipt-note">Scan or search this ID in any DigiByte explorer to check the payment.</p>
                    </div>
                </section>

                <div class="ui-receipt-actions ui-no-print">
                    <a href="@BlockchairPdfHref" target="_blank" rel="noopener" class="btn-primary w-full">
                        <Icon Name="download" Class="w-4 h-4" />
                        <span>Download PDF receipt</span>
                        <span class="ui-receipt-via">via Blockchair</span>
                        <span class="sr-only">(opens in a new tab)</span>
                    </a>
                    <div class="ui-receipt-actions-row">
                        <a href="@BlockchairTxHref" target="_blank" rel="noopener" class="btn-secondary">
                            <span>View transaction</span>
                            <Icon Name="external-link" Class="w-4 h-4" />
                            <span class="sr-only">(opens in a new tab)</span>
                        </a>
                        <button type="button" @onclick="PrintAsync" class="btn-secondary">
                            <Icon Name="printer" Class="w-4 h-4" />
                            <span>Print</span>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(session.ReturnUrl))
                    {
                        @* In the embed iframe checkout-countdown.js hands this to the shop's page instead. *@
                        <a href="@session.ReturnUrl" class="btn-secondary w-full" data-digipay-return-link>
                            <Icon Name="arrow-left" Class="w-4 h-4" />
                            <span>Back to the shop</span>
                        </a>
                    }
                </div>
            </article>
        }
        @* Light / Dark / Match my device for the shopper (FR-026). A shop-set ?theme= wins for this view. *@
        <div class="ui-shopper-footer ui-no-print">
            <ThemePicker Compact="true" />
        </div>
    </div>
</main>

@code {
    [Parameter] public string SessionId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "theme")] public string? Theme { get; set; }

    private SessionDto? session;
    private string? merchantName;
    private string? qrDataUrl;
    private bool loadFailed;
    private bool loading;

    // Same explorer the wallet uses for transaction PDFs (TransactionDetailModal).
    private string BlockchairTxHref => $"https://blockchair.com/digibyte/transaction/{Uri.EscapeDataString(session?.PaidTxid ?? "")}";
    private string BlockchairPdfHref => BlockchairTxHref + ".pdf";

    // When the payment landed (falls back to when it was requested). The prerendered page can't
    // know the shopper's time zone, so it says UTC; once interactive the browser's zone is used,
    // with its offset ("UTC+1") so a printed receipt is still unambiguous.
    private readonly LocalClock clock = new();

    private string PaidAtText => clock.ShowWithZone(session?.PaidAt ?? session?.CreatedAt ?? DateTime.UtcNow);

    private string PageTitleText => merchantName is null ? "Receipt · DigiPay" : $"Receipt from {merchantName} · DigiPay";

    private string CheckoutHref
    {
        get
        {
            var t = Theme?.ToLowerInvariant();
            return $"/pay/{Uri.EscapeDataString(SessionId)}" + (t is "light" or "dark" ? $"?theme={t}" : "");
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    // The page is rendered on the server first (shopper pages, FR-013a). The session fetched then is
    // handed to the interactive copy so it doesn't flash "Loading…" and fetch it again.
    private const string PersistKey = "digipay-session";
    private PersistingComponentStateSubscription? persisting;
    private GetSessionResponse? loaded;

    protected override void OnInitialized() =>
        persisting = AppState.RegisterOnPersisting(() =>
        {
            if (loaded is not null) AppState.PersistAsJson(PersistKey, loaded);
            return Task.CompletedTask;
        });

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = AppState.TryTakeFromJson<GetSessionResponse>(PersistKey, out var restored) && restored?.Session is not null
                ? restored
                : await http.GetFromJsonAsync<GetSessionResponse>($"/v1/pay/sessions/{Uri.EscapeDataString(SessionId)}");
            if (response?.Session is null)
            {
                Log.LogInformation("Receipt session {SessionId} not found", SessionId);
                loadFailed = true;
                return;
            }
            loaded = response;
            session = response.Session;
            merchantName = response.MerchantName;
            loadFailed = false;
            // The bare txid, not an explorer URL, so any scanner or explorer can use it.
            if (!string.IsNullOrEmpty(session.PaidTxid)) qrDataUrl = GenerateQr(session.PaidTxid);
        }
        catch (Exception ex)
        {
            // Details go to the server log only (FR-010).
            Log.LogWarning(ex, "Receipt could not load session {SessionId}", SessionId);
            loadFailed = true;
        }
        finally { loading = false; }
    }

    // Until the payment is final the receipt re-reads the session so its confirmations move. Runs only
    // once interactive (OnAfterRender never runs while prerendering) and stops on dispose.
    /// <summary>How often a receipt that isn't final yet is refreshed. A parameter so tests can shorten it.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(15);

    private readonly CancellationTokenSource lifetime = new();
    private Task? pollLoop;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Show the time in the shopper's own zone (never runs while prerendering).
        if (firstRender && await clock.InitAsync(JS)) StateHasChanged();
        if (pollLoop is null && session is not null && !CheckoutStates.IsFinal(session.Status))
            pollLoop = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (session is not null && !CheckoutStates.IsFinal(session.Status) && await timer.WaitForNextTickAsync(lifetime.Token))
            {
                try
                {
                    var http = HttpFactory.CreateClient("PayApi");
                    var response = await http.GetFromJsonAsync<GetSessionResponse>($"/v1/pay/sessions/{Uri.EscapeDataString(SessionId)}", lifetime.Token);
                    if (response?.Session is not { } fresh) continue;
                    await InvokeAsync(() =>
                    {
                        var hadTxid = session?.PaidTxid;
                        session = fresh;
                        merchantName = response.MerchantName ?? merchantName;
                        if (!string.IsNullOrEmpty(fresh.PaidTxid) && fresh.PaidTxid != hadTxid) qrDataUrl = GenerateQr(fresh.PaidTxid);
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch (Exception ex) { Log.LogDebug(ex, "Receipt refresh failed for {SessionId}", SessionId); }
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        persisting?.Dispose();
        lifetime.Cancel();
        if (pollLoop is not null) { try { await pollLoop; } catch { } }
        lifetime.Dispose();
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    private static string GenerateQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.M);
        using var qr = new QRCoder.PngByteQRCode(data);
        return $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(6))}";
    }

    private static string FormatDgb(long sats) =>
        (sats / 100_000_000m).ToString("0.########", CultureInfo.InvariantCulture);

    private static string StatusText(string status) => status switch
    {
        "confirmed" => "Final",
        "underpaid" => "Underpaid",
        "refunded" => "Refunded",
        _ => "Confirming",
    };

    // DigiDollar sessions keep received USD cents in ReceivedSatoshis.
    private static string FormatReceived(long received, bool isDd) =>
        isDd ? FormatUsd(received) + " USD" : FormatDgb(received) + " DGB";

    private static string FormatUsd(long cents) =>
        (cents / 100m).ToString("0.00", CultureInfo.InvariantCulture);


    public record GetSessionResponse(SessionDto Session, string? MerchantName);

    public record SessionDto(
        string Id, string Address, long AmountSatoshis, decimal Amount,
        string? FiatCurrency, decimal? FiatAmount, string? Label, string? Memo,
        string Status, DateTime CreatedAt, DateTime ExpiresAt,
        long ReceivedSatoshis, int Confirmations, string? PaidTxid,
        string Uri, string CheckoutUrl,
        DateTime? PaidAt = null,
        // DigiDollar: Currency = "DGB" (default) or "DD"; for DD, AmountCentsDd carries USD cents.
        string Currency = "DGB",
        long? AmountCentsDd = null,
        // Optional merchant URL the shopper goes back to (the same one the checkout uses).
        string? ReturnUrl = null);
}
