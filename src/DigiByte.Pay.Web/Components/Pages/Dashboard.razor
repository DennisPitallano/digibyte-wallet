    /// <summary>Copies a snippet or link and confirms with a notice (FR-022); explains when the browser blocks it.</summary>
    private async Task CopySnippetAsync(string variant, string snippet)
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("digipayClipboard.copy", snippet); }
        catch (JSException) { ok = false; }
        copiedSnippet = variant;
        if (ok) Toasts.Success(variant == "link" ? "Link copied" : "Snippet copied");
        else Toasts.Info("Your browser blocked copying. Select the text and copy it by hand.");
    }

    /// <summary>PATCHes the active store; returns the response body, or sets the error and returns null.</summary>
    private async Task<(bool Ok, string? Error, StoreUpdateDto? Body)> PatchStoreAsync(object body)
    {
        var http = HttpFactory.CreateClient("PayApi");
        var response = await http.SendAsync(AuthedRequest(HttpMethod.Patch, $"/v1/pay/stores/{activeStoreId}", JsonContent.Create(body)));
        if (!response.IsSuccessStatusCode) return (false, await ApiError.ReadAsync(response), null);
        StoreUpdateDto? dto = null;
        try { dto = await response.Content.ReadFromJsonAsync<StoreUpdateDto>(); } catch (System.Text.Json.JsonException) { }
        return (true, null, dto);
    }

    private async Task SaveReceiveAsync()
    {
        if (activeStore is null) return;
        busy = true; patchError = null; StateHasChanged();
        try
        {
            var (ok, error, _) = await PatchStoreAsync(new { addressOrXpub = receiveInput.Trim() });
            if (!ok) { patchError = error; return; }
            await RefreshStoreAsync();
            receiveInput = "";
            showEditReceive = false;
            Toasts.Success("Saved. Payments to this store go to the new address.");
            if (activeStore?.HasReceive == true) { await LoadSessionsAsync(); await LoadDonationAddressAsync(); }
        }
        catch (Exception ex) { patchError = Plain(ex, "patchError"); }
        finally { busy = false; StateHasChanged(); }
    }

    private async Task CreateSessionAsync()
    {
        if (activeStore is null) return;
        busy = true; createError = null; createdSession = null; createdSessionQr = null; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var label = string.IsNullOrWhiteSpace(newLabel) ? null : newLabel;
            var memo = string.IsNullOrWhiteSpace(newMemo) ? null : newMemo;
            var content = newCurrency == "DD"
                ? JsonContent.Create(new { currency = "DD", amountCentsDd = (long)(newAmount * 100m), storeId = activeStoreId, label, memo })
                : JsonContent.Create(new { amount = newAmount, storeId = activeStoreId, label, memo });
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Post, "/v1/pay/sessions", content));
            if (!response.IsSuccessStatusCode) { createError = await ApiError.ReadAsync(response); return; }
            createdSession = await response.Content.ReadFromJsonAsync<CreatedSession>();
            if (createdSession is not null) createdSessionQr = GenerateLinkQr(createdSession.CheckoutUrl);
            newAmount = 0; newLabel = ""; newMemo = "";
            await Task.WhenAll(LoadSessionsAsync(), LoadCountsAsync());
        }
        catch (Exception ex) { createError = Plain(ex, "createError"); }
        finally { busy = false; StateHasChanged(); }
    }

    /// <summary>Switches the link form to fiat and fetches the live price for it.</summary>
    private async Task UseFiatPriceAsync()
    {
        linkPriceMode = "fiat";
        await LoadLinkPriceAsync();
    }

    /// <summary>
    /// The live DGB price in the chosen currency, from the same public endpoint the POS uses.
    /// Without it a fiat link can't be priced, so the create button stays off.
    /// </summary>
    private async Task LoadLinkPriceAsync()
    {
        linkPriceLoading = true; linkDgbPrice = null; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var resp = await http.GetAsync($"/v1/pay/public/price?currency={Uri.EscapeDataString(linkFiatCurrency.ToLowerInvariant())}");
            if (resp.IsSuccessStatusCode)
            {
                var quote = await resp.Content.ReadFromJsonAsync<PriceQuote>();
                if (quote is not null && quote.DgbPrice > 0) { linkDgbPrice = quote.DgbPrice; linkPriceSource = quote.Source; }
            }
        }
        catch (Exception ex) { Log.LogWarning(ex, "Dashboard: price lookup failed"); }
        finally { linkPriceLoading = false; StateHasChanged(); }
    }

    private async Task CreatePaymentLinkAsync()
    {
        if (activeStore is null || !LinkFormValid) return;
        busy = true; linkError = null; createdLink = null; linkQrDataUrl = null; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            // A fiat link is charged in DGB at the live price: fiat / (fiat per DGB), rounded to
            // 1 satoshi. The price is sent along so the session records the rate it was made at.
            decimal amountDgb = 0m;
            decimal? priceAtCreation = null;
            if (linkPriceMode == "dd")
            {
                // DigiDollar: no price, no conversion; the dollars are the amount.
            }
            else if (linkPriceMode == "dgb")
            {
                amountDgb = linkAmountDgb;
            }
            else
            {
                if (LinkFiatToDgb is not decimal converted || linkDgbPrice is not decimal price)
                {
                    linkError = "The live DGB price isn't available right now. Try again in a moment, or price the link in DGB.";
                    return;
                }
                amountDgb = converted;
                priceAtCreation = price;
            }
            var expirySeconds = (linkExpiryMinutes is int m && m > 0)
                ? Math.Clamp(m, 1, 1440) * 60
                : (int?)null;
            var content = linkPriceMode == "dd"
                ? JsonContent.Create(new
                {
                    currency = "DD",
                    amountCentsDd = (long)(linkAmountDd * 100m),
                    storeId = activeStoreId,
                    label = string.IsNullOrWhiteSpace(linkLabel) ? null : linkLabel.Trim(),
                    memo = string.IsNullOrWhiteSpace(linkMemo) ? null : linkMemo.Trim(),
                    expiresInSeconds = expirySeconds,
                })
                : JsonContent.Create(new
            {
                amount = amountDgb,
                storeId = activeStoreId,
                label = string.IsNullOrWhiteSpace(linkLabel) ? null : linkLabel.Trim(),
                memo = string.IsNullOrWhiteSpace(linkMemo) ? null : linkMemo.Trim(),
                fiatCurrency = linkPriceMode == "fiat" ? linkFiatCurrency : null,
                // specs/033 US3: a fiat-priced link lets the buyer pay in DGB or DD where the store offers it.
                buyerChoice = linkPriceMode == "fiat" ? true : (bool?)null,
                fiatAmount = linkPriceMode == "fiat" ? (decimal?)Fiat.Round(linkAmountFiat, linkFiatCurrency) : null,
                dgbPriceAtCreation = priceAtCreation,
                expiresInSeconds = expirySeconds,
            });
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Post, "/v1/pay/sessions", content));
            if (!response.IsSuccessStatusCode)
            {
                linkError = await ApiError.ReadAsync(response);
                linkDdFailed = linkPriceMode == "dd";
                return;
            }
            linkDdFailed = false;
            createdLink = await response.Content.ReadFromJsonAsync<SessionRow>();
            if (createdLink is not null)
                linkQrDataUrl = GenerateLinkQr(createdLink.CheckoutUrl);
            await Task.WhenAll(LoadSessionsAsync(), LoadCountsAsync());
        }
        catch (Exception ex) { linkError = Plain(ex, "linkError"); }
        finally { busy = false; StateHasChanged(); }
    }

    private void ResetLinkForm()
    {
        createdLink = null;
        linkQrDataUrl = null;
        linkError = null;
        linkAmountDgb = 0;
        linkAmountFiat = 0;
        linkAmountDd = 0;
        linkDdFailed = false;
        linkLabel = "";
        linkMemo = "";
        linkExpiryMinutes = null;
    }

    private static string GenerateLinkQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.M);
        using var qr = new QRCoder.PngByteQRCode(data);
        return $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(6))}";
    }

    private string FormatLinkAmount(SessionRow s)
    {
        if (s.Currency == "DD") return RowAmount(s);
        if (s.FiatAmount is decimal f && !string.IsNullOrWhiteSpace(s.FiatCurrency))
            return $"{FormatFiat(f, s.FiatCurrency)} (≈ {s.Amount:0.########} DGB)";
        return $"{s.Amount:0.########} DGB";
    }

    private static string MailtoHref(SessionRow s)
    {
        var subject = string.IsNullOrWhiteSpace(s.Label) ? "Payment link" : s.Label;
        var body = $"Pay here: {s.CheckoutUrl}";
        return $"mailto:?subject={Uri.EscapeDataString(subject)}&body={Uri.EscapeDataString(body)}";
    }

    private static string SmsHref(SessionRow s)
    {
        // sms: with body= works on iOS / most Android SMS apps; the payer's
        // device picks the recipient.
        var body = string.IsNullOrWhiteSpace(s.Label)
            ? $"Pay here: {s.CheckoutUrl}"
            : $"{s.Label}: {s.CheckoutUrl}";
        return $"sms:?body={Uri.EscapeDataString(body)}";
    }

    private async Task ShareLinkAsync()
    {
        if (createdLink is null) return;
        try
        {
            await JS.InvokeVoidAsync("digipayShareLink", new
            {
                title = string.IsNullOrWhiteSpace(createdLink.Label) ? "Payment link" : createdLink.Label,
                text = string.IsNullOrWhiteSpace(createdLink.Label) ? "Pay here:" : $"{createdLink.Label}:",
                url = createdLink.CheckoutUrl,
            });
        }
        catch
        {
            // Web Share API unavailable (desktop browsers without it) — fall back
            // to copying the URL silently. The Copy button is right there too.
            await CopySnippetAsync("link", createdLink.CheckoutUrl);
        }
