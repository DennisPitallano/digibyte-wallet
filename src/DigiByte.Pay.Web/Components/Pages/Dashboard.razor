@page "/merchant"
@page "/merchant/{Section}"
@implements IAsyncDisposable
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ToastService Toasts
@using System.Net.Http.Json

<PageTitle>@(notFound || storeNotFound ? "Not found" : CurrentSection.Label) · DigiPay</PageTitle>

@* Shared class strings for consistency *@
@{
    const string Card = "card p-5 sm:p-6 flex flex-col gap-3";
    const string Btn = "btn-primary";
    const string BtnGhost = "btn-secondary";
    const string Input = "input";
    const string Eyebrow = "section-label";
    const string Muted = "dp-muted";
    const string Pre = "bg-slate-900 text-slate-100 rounded-lg p-3 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-all m-0 leading-relaxed";
    const string H2 = "block-title";
    const string H1 = "page-title";
}

@if (bootstrapError != null)
{
    <main class="min-h-dvh flex items-center justify-center p-4 bg-slate-50 dark:bg-dgb-950 text-slate-900 dark:text-white font-sans">
        <div class="card p-6 text-center max-w-md flex flex-col gap-3 items-center">
            <h1 class="block-title">Your dashboard couldn't be loaded</h1>
            <p class="ui-checkout-muted">Check your connection and try again.</p>
            <button type="button" class="btn-primary" @onclick="RetryBootstrapAsync">Try again</button>
        </div>
    </main>
}
else if (account == null)
{
    <main class="min-h-dvh flex items-center justify-center p-4 bg-slate-50 dark:bg-dgb-950 text-slate-900 dark:text-white font-sans">
        <Loader Text="Loading your dashboard…" />
    </main>
}
else
{
    <DashboardShell ActiveKey="@(notFound || storeNotFound ? null : activeTab)" AccountName="@account.DisplayName" DigiIdAddress="@account.DigiIdAddress"
                    Stores="@ShellStores" ActiveStoreId="@activeStoreId" OnStoreChanged="OnStoreSwitchedAsync"
                    Narrow="@(CurrentSection.Narrow && !notFound && !storeNotFound)">
        <ChildContent>
            @if (notFound || storeNotFound)
            {
                <div class="card p-6 flex flex-col gap-3 items-start">
                    <h1 class="page-title">Page not found</h1>
                    <p class="ui-checkout-muted">@(storeNotFound ? "That store isn't one of yours, or it no longer exists." : "There's no dashboard page at this address.")</p>
                    <a href="/merchant" class="btn-primary btn-sm">Back to Overview</a>
                </div>
            }
            else
            {
            <div class="contents">
            @if (DdChoiceNoticeShown)
            {
                @* specs/033 FR-030: once, for merchants who had DigiDollar on when buyer choice arrived. *@
                <div class="ui-banner ui-banner-info mb-4 flex-col items-stretch" role="status" data-dd-choice-notice>
                    <div class="flex gap-2">
                        <Icon Name="info" Class="" />
                        <p>Buyers can now pay in DGB or DigiDollar on payments priced in a regular currency (payment links and POS sales). They pick at checkout, and you see which currency they paid in.</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        @if (activeStore is { DigiDollarEnabled: true, BuyerChoiceEnabled: true } store)
                        {
                            <button class="@BtnGhost" @onclick="TurnOffBuyerChoiceFromNoticeAsync">Turn off for @store.Name</button>
                        }
                        <button class="btn-secondary btn-sm" @onclick="DismissDdChoiceNoticeAsync">Got it</button>
                    </div>
                </div>
            }
            @if (activeStore is null)
            {
                <div class="flex items-baseline justify-between mb-1"><h1 class="@H1">Set up your store</h1></div>
                <p class="@Muted mb-6">A store is where your payments go: it has its own receive address, payments and webhook. Add one to start taking DigiByte.</p>
                <section class="@Card">
                    <button class="@Btn self-start" @onclick='() => SwitchTab("stores")'>Add a store</button>
                </section>
            }
            else if (activeTab == "overview")
            {
                <div class="flex items-baseline justify-between gap-2 flex-wrap mb-1 slide-up">
                    <h1 class="@H1">Overview</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong></span>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">Summary of this store's activity.</p>

                @if (ShowChecklist)
                {
                    @GettingStarted
                }

                @if (activeStore.HasReceive)
                {
                    @if (WebhookFailing)
                    {
                        @* FR-024: recent deliveries are failing; link straight to the log. *@
                        <div class="ui-banner ui-banner-warning mb-4" role="status">
                            <Icon Name="alert" Class="" />
                            <p>Webhook deliveries to your server are failing. <a href="@($"{HrefFor(DashboardSections.ForKey("webhook"))}#delivery-log")" class="font-semibold underline">See the delivery log</a> to find out why.</p>
                        </div>
                    }
                    @* Totals for this store, all time (the API's counts, not just the first page).
                       Underpaid needs the merchant to act, so it has its own tile apart from Expired. *@
                    <div class="dash-stats mb-6">
                        <Stat Label="All payments" Value="@CountText(allTotal)" Href="@PaymentsHref(null)" />
                        <Stat Label="Paid" Value="@CountText(Sum("paid", "confirmed"))" Hint="Received or confirmed" />
                        <Stat Label="Waiting" Value="@CountText(Sum("pending", "seen"))" Href="@PaymentsHref("pending")" Hint="Not paid yet" />
                        <Stat Label="Underpaid" Value="@CountText(Sum("underpaid"))" Href="@PaymentsHref("underpaid")"
                              Attention="@(Sum("underpaid") > 0)" Hint="@(Sum("underpaid") > 0 ? "Needs your action" : "Nothing to sort out")" />
                        <Stat Label="Expired" Value="@CountText(Sum("expired"))" Href="@PaymentsHref("expired")" Hint="Closed unpaid" />
                    </div>

                    @* How sales are trending: revenue and payments per day on the merchant's own days, with the
                       outcome split and a comparison with the period before (GET /stores/{id}/stats/daily). *@
                    <SalesOverview Token="@(token ?? string.Empty)" StoreId="@activeStoreId" TimeZoneId="@clock.Zone.Id"
                                   Currency="@activeStore.DefaultCurrency" />

                    <section class="@Card scale-in-delay-2">
                        <h2 class="@H2">New payment</h2>
                        <p class="@Muted m-0">Create a payment and show its QR code to your customer.</p>
                        <a href="@HrefFor(DashboardSections.ForKey("new"))" class="btn-primary self-start"><Icon Name="plus" Class="w-4 h-4" /><span>New payment</span></a>
                    </section>
                }
            }
            else if (activeTab == "new")
            {
                <div class="flex items-center gap-2 mb-1 slide-up">
                    <a href="@HrefFor(DashboardSections.ForKey("overview"))" class="back-btn" aria-label="Back to Overview"><Icon Name="arrow-left" Class="w-5 h-5" /></a>
                    <h1 class="@H1">New payment</h1>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">For <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong>. Your customer scans the code or opens the link to pay.</p>

                @if (!activeStore.HasReceive)
                {
                    @* FR-023: say why payments can't be created yet and go straight to the fix. *@
                    <div class="ui-banner ui-banner-warning mb-4">
                        <Icon Name="alert" Class="" />
                        <p>This store can't take payments yet: it has no DigiByte address or xpub to receive to. Add one in Settings first.</p>
                    </div>
                    <a href="@($"{HrefFor(DashboardSections.ForKey("settings"))}#receive")" class="btn-primary">Go to Settings</a>
                }
                else
                {
                    <section class="@Card scale-in-delay-1">
                        @if (DdOffered)
                        {
                            @* specs/033 US2: a one-off payment can be in DigiDollar (1 DD = $1). *@
                            <div class="segmented w-fit" role="group" aria-label="Payment in">
                                <button type="button" class="segmented-item" aria-pressed="@(newCurrency == "DGB" ? "true" : "false")"
                                        @onclick='() => SetNewCurrency("DGB")'>DGB</button>
                                <button type="button" class="segmented-item" aria-pressed="@(newCurrency == "DD" ? "true" : "false")"
                                        @onclick='() => SetNewCurrency("DD")'>DigiDollar</button>
                            </div>
                        }
                        <div class="field">
                            <label class="field-label" for="np-amount">@(newCurrency == "DD" ? "Amount (US dollars, paid in DD)" : "Amount (DGB)")</label>
                            <input id="np-amount" @bind="newAmount" type="number" inputmode="decimal" step="@(newCurrency == "DD" ? "0.01" : "0.00000001")" min="0" placeholder="0.00" class="input" />
                            @if (newCurrency == "DD")
                            {
                                <p class="field-hint">1 DD = $1. From $1.00 to $100,000.00.</p>
                            }
                        </div>
                        <div class="field">
                            <label class="field-label" for="np-label">Label <span class="font-normal opacity-70">(optional)</span></label>
                            <input id="np-label" @bind="newLabel" placeholder="What it's for" class="input" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="np-memo">Memo or invoice number <span class="font-normal opacity-70">(optional)</span></label>
                            <input id="np-memo" @bind="newMemo" class="input" />
                        </div>
                        <button class="btn-primary w-full" @onclick="CreateSessionAsync" disabled="@(busy || !NewPaymentValid)" aria-busy="@(busy ? "true" : null)">
                            @(busy ? "Creating…" : "Create payment")
                        </button>
                        @if (createError != null) { <p class="field-error" role="alert">@createError</p> }
                        @if (createdSession != null)
                        {
                            <div class="ui-banner ui-banner-info flex-col items-stretch">
                                <p class="font-semibold">Payment created</p>
                                @if (!string.IsNullOrEmpty(createdSessionQr))
                                {
                                    @* The customer scans this to open the checkout. *@
                                    <div class="qr-frame self-center">
                                        <img src="@createdSessionQr" alt="QR code for the checkout link" class="w-40 h-40" />
                                    </div>
                                }
                                <div class="ui-checkout-copyrow">
                                    <div class="min-w-0 flex-1">
                                        <p class="section-label">Checkout link</p>
                                        <p id="np-link" class="ui-checkout-address">@createdSession.CheckoutUrl</p>
                                    </div>
                                    <CopyButton Value="@createdSession.CheckoutUrl" Label="Copy checkout link" TargetId="np-link" SuccessText="Link copied" Variant="icon" />
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@SessionHref(createdSession.Id)" class="btn-primary btn-sm">View payment</a>
                                    <a href="@createdSession.CheckoutUrl" target="_blank" rel="noopener" class="btn-secondary btn-sm">Open the checkout <span class="sr-only">(opens in a new tab)</span></a>
                                </div>
                            </div>
                        }
                    </section>
                }
            }
            else if (activeTab == "analytics")
            {
                @if (activeStore is null)
                {
                    <p class="@Muted">Pick a store.</p>
                }
                else
                {
                    <AnalyticsPanel Token="@(token ?? string.Empty)" StoreId="@activeStoreId" />
                }
            }
            else if (activeTab == "sessions")
            {
                <div class="flex items-baseline justify-between gap-2 flex-wrap mb-1 slide-up">
                    <h1 class="@H1">Payments</h1>
                    <div class="flex gap-2">
                        @* Bookkeeping export — same filter scope as the visible
                           list (this store, current activeStoreId), capped at
                           10 000 rows server-side. *@
                        <button class="@BtnGhost btn-sm" @onclick="ExportSessionsCsvAsync" disabled="@exportingCsv"
                                aria-busy="@(exportingCsv ? "true" : null)" title="Download as CSV">
                            @(exportingCsv ? "Exporting…" : "Export CSV")
                        </button>
                        <button class="@BtnGhost btn-sm" @onclick="LoadSessionsAsync" disabled="@loadingSessions"
                                aria-busy="@(loadingSessions ? "true" : null)">
                            <Icon Name="refresh" Class="w-4 h-4" /><span>Refresh</span>
                        </button>
                    </div>
                </div>
                <p class="@Muted mb-4 slide-up-delay-1">
                    Payments for <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong>, newest first.
                    @if (PollingSessions) { <span>Updates on its own while a payment is in progress.</span> }
                </p>

                @* Status filter: uses the API's ?status= and lives in the address (?status=underpaid),
                   so the Overview tiles can link straight to a filtered list. *@
                <div class="segmented dash-filter mb-4" role="group" aria-label="Show payments">
                    @foreach (var (value, label) in StatusFilters)
                    {
                        <button type="button" class="segmented-item" aria-pressed="@(statusFilter == value ? "true" : "false")"
                                @onclick="() => Nav.NavigateTo(PaymentsHref(value))">@label</button>
                    }
                </div>

                <section class="@Card scale-in-delay-1">
                    @if (sessions == null) { <Skeleton Shape="row" Count="4" /> }
                    else if (sessions.Count == 0 && statusFilter is not null)
                    {
                        <EmptyState Title="@($"No {FilterLabel(statusFilter).ToLowerInvariant()} payments")"
                                    Text="Nothing in this store matches this filter."
                                    ActionLabel="Show all payments" ActionHref="@PaymentsHref(null)"
                                    BakuPose="thinking" Class="border-0 shadow-none p-0" />
                    }
                    else if (sessions.Count == 0)
                    {
                        <EmptyState Title="No payments yet"
                                    Text="Every payment you create, from here, a payment link, your shop or a POS tablet, shows up in this list."
                                    ActionLabel="Create your first payment" ActionHref="@HrefFor(DashboardSections.ForKey("new"))"
                                    BakuPose="greeting" Class="border-0 shadow-none p-0" />
                    }
                    else
                    {
                        <p class="@Muted m-0" aria-live="polite">Showing @sessions.Count of @sessionsTotal</p>
                        <ul class="list-none p-0 m-0 flex flex-col gap-2">
                            @foreach (var s in sessions)
                            {
                                @* Click opens the merchant detail page (timeline, address, webhook log). *@
                                <li>
                                    <a href="@SessionHref(s.Id)"
                                       class="dash-row-link flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-3 p-3 border border-slate-200 dark:border-dgb-800 rounded-lg text-inherit hover:bg-slate-50 dark:hover:bg-dgb-800 transition-colors">
                                        <div class="min-w-0">
                                            <div class="font-bold text-[0.9375rem] tabular-nums flex items-center gap-1.5 flex-wrap">
                                                @RowAmount(s)
                                                @if (s.Extra is { } extra)
                                                {
                                                    <span class="ui-badge ui-badge-refund" data-extra-flag>Extra @extra.Currency received, refund the buyer</span>
                                                }
                                                @if (s.FiatAmount is decimal fiat && !string.IsNullOrWhiteSpace(s.FiatCurrency))
                                                {
                                                    <span class="dash-fiat">@FormatFiat(fiat, s.FiatCurrency)</span>
                                                }
                                                @if (s.Source is not null && s.Source.StartsWith("pos", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    @* Countertop-origin marker — kept subtle so it reads as
                                                       a context chip, not a status. Source is "pos" or
                                                       "pos:DeviceName"; show the device name in the tooltip. *@
                                                    var deviceName = s.Source.Length > 4 && s.Source[3] == ':'
                                                        ? s.Source[4..]
                                                        : null;
                                                    var tooltip = string.IsNullOrEmpty(deviceName)
                                                        ? "Created from POS tablet"
                                                        : $"Created from POS tablet — {deviceName}";
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[0.625rem] font-semibold uppercase tracking-wider bg-dgb-500/10 text-dgb-500" title="@tooltip">
                                                        <Icon Name="zap" Class="w-2.5 h-2.5" />POS
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(s.ReturnUrl))
                                                {
                                                    @* Buyer is sent back to the merchant's site after payment
                                                       confirms. Show the host so a merchant glancing at the
                                                       list can spot which integration the session came from
                                                       (handy on a multi-shop store with one DigiPay account). *@
                                                    var host = "merchant";
                                                    if (System.Uri.TryCreate(s.ReturnUrl, System.UriKind.Absolute, out var ru))
                                                    {
                                                        host = ru.Host;
                                                    }
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[0.625rem] font-semibold uppercase tracking-wider bg-emerald-500/10 text-emerald-700 dark:text-emerald-400" title="@($"Returns buyer to {s.ReturnUrl}")">
                                                        <Icon Name="external-link" Class="w-2.5 h-2.5" />@host
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(s.Label)) { <div class="@Muted">@s.Label</div> }
                                        </div>
                                        <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-1.5 shrink-0">
                                            <StatusBadge Status="@s.Status" />
                                            <div class="@Muted">@clock.Show(s.CreatedAt)</div>
                                        </div>
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (sessions.Count < sessionsTotal)
                        {
                            <button type="button" class="btn-secondary btn-sm self-center" @onclick="LoadMoreSessionsAsync"
                                    disabled="@loadingMore" aria-busy="@(loadingMore ? "true" : null)">
                                @(loadingMore ? "Loading…" : "Load more")
                            </button>
                        }
                    }
                </section>
            }
            else if (activeTab == "links")
            {
                <div class="flex items-baseline justify-between gap-2 flex-wrap mb-1 slide-up">
                    <h1 class="@H1">Payment links</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong></span>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">
                    Generate a shareable checkout URL for an exact amount — send it via SMS, email, WhatsApp,
                    or a QR-printed receipt. The customer pays with any DigiByte wallet; you watch the status
                    on the Payments page or via webhook.
                </p>

                @if (!activeStore.HasReceive)
                {
                    <section class="@Card scale-in-delay-1">
                        <h2 class="@H2">Configure where to receive payments</h2>
                        <p class="@Muted m-0">Set a DigiByte address or BIP84 xpub in Settings before creating links.</p>
                        <button class="@Btn self-start" @onclick='() => SwitchTab("settings")'>Go to Settings</button>
                    </section>
                }
                else
                {
                    <section class="@Card scale-in-delay-1">
                        <h2 class="@H2">Create a link</h2>

                        @* Currency toggle: DGB (default) vs fiat. A fiat-priced link is converted to
                           DGB here at the live price (/v1/pay/public/price, as the POS does) and the
                           DGB amount is locked in when the link is created. *@
                        <div class="segmented w-fit" role="group" aria-label="Price in">
                            <button type="button" class="segmented-item" aria-pressed="@(linkPriceMode == "dgb" ? "true" : "false")"
                                    @onclick='() => linkPriceMode = "dgb"'>DGB</button>
                            <button type="button" class="segmented-item" aria-pressed="@(linkPriceMode == "fiat" ? "true" : "false")"
                                    @onclick="UseFiatPriceAsync">Your currency</button>
                            @if (DdOffered)
                            {
                                <button type="button" class="segmented-item" aria-pressed="@(linkPriceMode == "dd" ? "true" : "false")"
                                        @onclick="UseDdPrice">DigiDollar</button>
                            }
                        </div>

                        @if (linkPriceMode == "dd")
                        {
                            @* specs/033 US2: priced and paid in DigiDollar, 1 DD = $1. No price lookup. *@
                            <div class="field">
                                <label class="field-label" for="link-amount-dd">Amount (US dollars, paid in DD)</label>
                                <input id="link-amount-dd" @bind="linkAmountDd" @bind:event="oninput" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0.00" class="@Input" />
                                <p class="field-hint">1 DD = $1. From $1.00 to $100,000.00. The customer pays in DigiDollar.</p>
                            </div>
                        }
                        else if (linkPriceMode == "dgb")
                        {
                            <div class="field">
                                <label class="field-label" for="link-amount-dgb">Amount (DGB)</label>
                                <input id="link-amount-dgb" @bind="linkAmountDgb" type="number" inputmode="decimal" step="0.00000001" min="0" placeholder="0.00" class="@Input" />
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <div class="field">
                                    <label class="field-label" for="link-amount-fiat">Amount</label>
                                    <input id="link-amount-fiat" @bind="linkAmountFiat" @bind:event="oninput" type="number" inputmode="decimal" step="@LinkFiatStep" min="0" placeholder="@LinkFiatPlaceholder" class="@Input" />
                                </div>
                                <div class="field">
                                    <label class="field-label" for="link-currency">Currency</label>
                                    @* The wallet's currency list, searchable and grouped by region (Shared/Ui/CurrencyPicker). *@
                                    <button id="link-currency" type="button" class="@Input dash-currency-btn" aria-haspopup="dialog"
                                            aria-label="@($"Currency: {Fiat.Name(linkFiatCurrency)}, change")" @onclick="() => linkPickerOpen = true">
                                        <CurrencyFlag Code="@linkFiatCurrency" />
                                        <span class="dash-currency-code">@linkFiatCurrency</span>
                                        <span class="dash-currency-name">@Fiat.Name(linkFiatCurrency)</span>
                                        <Icon Name="chevron-down" Class="w-4 h-4" />
                                    </button>
                                    <CurrencyPicker Id="link-currency-picker" IsOpen="linkPickerOpen" Selected="@linkFiatCurrency" Preferred="@StoreFiatDefault"
                                                    Title="Price the link in" Hint="The customer pays the DGB equivalent at the live price when the link is created."
                                                    OnSelected="PickLinkCurrencyAsync" OnClosed="() => linkPickerOpen = false" />
                                </div>
                            </div>
                            @if (linkPriceLoading)
                            {
                                <p class="@Muted m-0" role="status">Getting the live DGB price…</p>
                            }
                            else if (linkDgbPrice is decimal price)
                            {
                                <p class="@Muted m-0" role="status">
                                    1 DGB = @Fiat.Rate(price, linkFiatCurrency) @linkFiatCurrency@(linkPriceSource == "coingecko+fx" ? " (converted via USD)" : "").
                                    @if (LinkFiatToDgb is decimal dgb)
                                    {
                                        <span>The customer pays <strong class="text-slate-900 dark:text-white">@dgb.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) DGB</strong>.</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <div class="ui-banner ui-banner-warning" role="status">
                                    <Icon Name="alert" Class="" />
                                    <p>The live DGB price isn't available right now, so a link in your currency can't be created. Try again in a moment, or price the link in DGB.</p>
                                </div>
                                <button type="button" class="btn-secondary btn-sm self-start" @onclick="LoadLinkPriceAsync">Try again</button>
                            }
                        }

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="field">
                                <label class="field-label" for="link-label">Label <span class="font-normal opacity-70">(shown to the payer, optional)</span></label>
                                <input id="link-label" @bind="linkLabel" placeholder="What it's for" class="@Input" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="link-memo">Memo or order number <span class="font-normal opacity-70">(optional)</span></label>
                                <input id="link-memo" @bind="linkMemo" class="@Input" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 items-end">
                            <div class="field">
                                <label class="field-label" for="link-expiry">Expires in (minutes)</label>
                                <input id="link-expiry" @bind="linkExpiryMinutes" type="number" min="1" max="1440" placeholder="30" class="@Input" aria-describedby="link-expiry-hint" />
                                <p id="link-expiry-hint" class="field-hint">1 to 1440. Leave blank for the store's default.</p>
                            </div>
                            <button class="@Btn" @onclick="CreatePaymentLinkAsync"
                                    disabled="@(busy || !LinkFormValid)" aria-busy="@(busy ? "true" : null)">
                                @(busy ? "Creating…" : "Create payment link")
                            </button>
                        </div>

                        @if (linkError != null) { <p class="field-error" role="alert">@linkError</p> }
                        @if (linkDdFailed && linkPriceMode == "dd" && linkAmountDd > 0)
                        {
                            @* DigiDollar can't be reached: the same dollars as a USD-priced link, paid in DGB, in one step (FR-014). *@
                            <button type="button" class="btn-secondary btn-sm self-start" data-dd-fallback @onclick="CreateLinkInDgbInsteadAsync" disabled="@busy">
                                Create a @Fiat.Format(linkAmountDd, "USD") link in DGB instead
                            </button>
                        }
                    </section>

                    @if (createdLink is not null)
                    {
                        <section class="@Card scale-in-delay-2 mt-4">
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <h2 class="@H2">Share this link</h2>
                                <button class="@BtnGhost text-xs py-1.5 px-3" @onclick="ResetLinkForm">Create another</button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-4 items-start">
                                @* QR rendered server-side via QRCoder — same approach as
                                   Receipt.razor. Encoding the bare https URL means any
                                   phone scanner can open it (no wallet-specific scheme
                                   needed; the checkout page itself shows the BIP21 QR
                                   for the wallet step). *@
                                @if (!string.IsNullOrEmpty(linkQrDataUrl))
                                {
                                    <div class="qr-frame self-start mx-auto md:mx-0">
                                        <img src="@linkQrDataUrl" alt="QR code for the payment link" class="block w-40 h-40" />
                                    </div>
                                }

                                <div class="flex flex-col gap-3 min-w-0">
                                    <div>
                                        <label class="@Eyebrow mb-1" for="link-url">Checkout URL</label>
                                        <div class="flex gap-2 items-stretch">
                                            <input id="link-url" class="@Input flex-1 font-mono text-xs" readonly value="@createdLink.CheckoutUrl"
                                                   @onclick="SelectLinkInputAsync" />
                                            <button class="@BtnGhost text-xs px-3 shrink-0"
                                                    @onclick='() => CopySnippetAsync("link", createdLink!.CheckoutUrl)'>
                                                Copy
                                            </button>
                                        </div>
                                    </div>

                                    <div class="flex flex-wrap gap-2">
                                        <a class="@BtnGhost text-xs py-1.5 px-3 inline-flex items-center gap-1.5 no-underline"
                                           href="@createdLink.CheckoutUrl" target="_blank" rel="noopener">
                                            <Icon Name="external-link" Class="w-3.5 h-3.5" />
                                            Open
                                        </a>
                                        <a class="@BtnGhost text-xs py-1.5 px-3 inline-flex items-center gap-1.5 no-underline"
                                           href="@MailtoHref(createdLink)">
                                            <Icon Name="bell" Class="w-3.5 h-3.5" />
                                            Email
                                        </a>
                                        <a class="@BtnGhost text-xs py-1.5 px-3 inline-flex items-center gap-1.5 no-underline"
                                           href="@SmsHref(createdLink)">
                                            <Icon Name="bell" Class="w-3.5 h-3.5" />
                                            SMS
                                        </a>
                                        <button class="@BtnGhost text-xs py-1.5 px-3 inline-flex items-center gap-1.5"
                                                @onclick="ShareLinkAsync"
                                                title="Share via your device's share sheet (if supported)">
                                            <Icon Name="external-link" Class="w-3.5 h-3.5" />
                                            Share…
                                        </button>
                                    </div>

                                    <div class="text-xs text-slate-500 dark:text-slate-400 grid grid-cols-2 gap-y-0.5 max-w-md items-center">
                                        <div>Amount</div><div class="text-right tabular-nums">@FormatLinkAmount(createdLink)</div>
                                        @if (!string.IsNullOrWhiteSpace(createdLink.Label))
                                        {
                                            <div>Label</div><div class="text-right truncate" title="@createdLink.Label">@createdLink.Label</div>
                                        }
                                        <div>Status</div><div class="text-right"><StatusBadge Status="@createdLink.Status" /></div>
                                        <div>Expires</div><div class="text-right tabular-nums">@clock.Show(createdLink.ExpiresAt)</div>
                                    </div>
                                    <a href="@SessionHref(createdLink.Id)" class="btn-secondary btn-sm self-start">View payment</a>
                                </div>
                            </div>
                        </section>
                    }
                }
            }
            else if (activeTab == "donation")
            {
                <div class="flex items-baseline justify-between mb-1 slide-up">
                    <h1 class="@H1">Donation button</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong></span>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">A permanent, session-less tip button for your site. Reuses this store's donation address — any DigiByte wallet can pay.</p>

                @if (!activeStore.HasReceive)
                {
                    @* No receive address means no donation address: say so instead of loading forever. *@
                    <section class="@Card">
                        <h2 class="@H2">Configure where to receive payments</h2>
                        <p class="@Muted m-0">The donation button pays this store's receive address. Set a DigiByte address or BIP84 xpub in Settings first.</p>
                        <a href="@($"{HrefFor(DashboardSections.ForKey("settings"))}#receive")" class="@Btn self-start">Go to Settings</a>
                    </section>
                }
                else if (donationAddress is null && donationLoadFailed)
                {
                    <section class="@Card">
                        <p class="m-0">The donation address couldn't be loaded. Check your connection and try again.</p>
                        <button type="button" class="btn-secondary btn-sm self-start" @onclick="LoadDonationAddressAsync">Try again</button>
                    </section>
                }
                else if (donationAddress is null)
                {
                    <section class="@Card" aria-busy="true">
                        <span class="sr-only">Loading the donation address</span>
                        <Skeleton Shape="line" Count="3" />
                    </section>
                }
                else
                {
                    <section class="@Card">
                        <h2 class="@H2">Configure</h2>
                        <div class="@Eyebrow">Donation address <span class="@Muted">(from this store)</span></div>
                        <div class="font-mono text-[0.6875rem] px-3 py-2 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-lg break-all">@donationAddress</div>
                        @if (DdOffered)
                        {
                            @* specs/033 US4: the tip page can also take DigiDollar, from the store's fixed DD donation address. *@
                            <label class="inline-flex items-center gap-2 cursor-pointer mt-2">
                                <input type="checkbox" id="don-accept-dd" checked="@donAcceptDd" disabled="@donDdBusy" @onchange="ToggleDonationDdAsync" class="w-5 h-5 accent-dgb-500" />
                                <span class="text-sm">Accept DigiDollar too</span>
                            </label>
                            @if (donDdError != null) { <p class="field-error" role="alert">@donDdError</p> }
                            @if (donAcceptDd && ddDonationAddress is not null)
                            {
                                <div class="@Eyebrow mt-2">DigiDollar donation address</div>
                                <div id="don-dd-address" class="font-mono text-[0.6875rem] px-3 py-2 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-lg break-all">@ddDonationAddress</div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
                                    <div class="field">
                                        <label class="field-label" for="don-open-on">Tip page opens on</label>
                                        <select id="don-open-on" @bind="donOpenOn" class="@Input">
                                            <option value="DGB">DGB</option>
                                            <option value="DD">DigiDollar</option>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label class="field-label" for="don-dd-amount">DigiDollar amount <span class="font-normal opacity-70">(US dollars, optional)</span></label>
                                        <input id="don-dd-amount" @bind="donDdAmount" @bind:event="oninput" type="number" inputmode="decimal" step="0.01" min="0" placeholder="0.00" class="@Input" />
                                    </div>
                                </div>
                                <p class="@Muted m-0">The button opens your tip page, which offers DGB and DigiDollar and drops DigiDollar if you turn it off later. DigiPay holds DD tips until they're paid out to you.</p>
                            }
                        }
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
                            <div class="field">
                                <label class="field-label" for="don-amount">Amount <span class="font-normal opacity-70">(DGB, optional)</span></label>
                                <input id="don-amount" @bind="donAmount" @bind:event="oninput" type="number" inputmode="decimal" step="0.00000001" min="0" placeholder="0" class="@Input" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="don-name">Your name <span class="font-normal opacity-70">(optional)</span></label>
                                <input id="don-name" @bind="donName" @bind:event="oninput" placeholder="e.g. Acme Coffee" class="@Input" maxlength="80" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="don-label">Message <span class="font-normal opacity-70">(optional)</span></label>
                                <input id="don-label" @bind="donLabel" @bind:event="oninput" placeholder="e.g. Thanks for the tip!" class="@Input" maxlength="120" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="don-button">Button text</label>
                                <input id="don-button" @bind="donButtonText" @bind:event="oninput" placeholder="Tip DGB" class="@Input" maxlength="40" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="don-logo">Logo <span class="font-normal opacity-70">(optional)</span></label>
                                <select id="don-logo" @bind="donLogo" class="@Input">
                                    <option value="none">None</option>
                                    <option value="dgb">DigiByte logo</option>
                                    <option value="custom">Custom image URL</option>
                                </select>
                            </div>
                            @if (donLogo == "custom")
                            {
                                <div class="field">
                                    <label class="field-label" for="don-logo-url">Image URL</label>
                                    <input id="don-logo-url" @bind="donLogoUrl" @bind:event="oninput" type="url" inputmode="url" placeholder="https://example.com/logo.png" class="@Input" maxlength="500"
                                           aria-describedby="don-logo-url-hint" aria-invalid="@(DonationLogoUrlInvalid ? "true" : "false")" />
                                    <p id="don-logo-url-hint" class="@Muted m-0 mt-1 text-xs">@(DonationLogoUrlInvalid ? "Use a full https:// image link." : "A square image works best; it's shown at 20×20.")</p>
                                </div>
                            }
                        </div>
                    </section>

                    @* Variant 1 — hosted button page (zero-JS, universal) *@
                    <section class="@Card mt-4">
                        <div class="flex items-start justify-between gap-2 flex-wrap">
                            <div>
                                <h2 class="@H2">Hosted button page</h2>
                                <p class="@Muted m-0">Links to a DigiPay-hosted page with a QR + "Open in wallet" button. Works anywhere HTML works — email, static sites, CMS blocks. No JavaScript needed.</p>
                            </div>
                            <span class="text-[0.625rem] font-semibold tracking-widest uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 shrink-0">Recommended</span>
                        </div>
                        <div class="@Eyebrow mt-1">Preview</div>
                        <div class="p-4 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-lg text-center">
                            <a href="@DonationHostedUrl" target="_blank" rel="noopener"
                               class="inline-flex items-center gap-2 px-4 py-2 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-lg no-underline text-sm">
                                @if (DonationLogoUrl is { } hostedLogo) { <img src="@hostedLogo" alt="" width="20" height="20" class="w-5 h-5 object-contain rounded-full shrink-0" /> }
                                @DonationButtonLabel
                            </a>
                        </div>
                        <div class="@Eyebrow">HTML snippet</div>
                        <pre class="@Pre">@DonationHostedSnippet</pre>
                        <button class="@BtnGhost" @onclick='() => CopySnippetAsync("hosted", DonationHostedSnippet)'>Copy snippet</button>
                    </section>

                    @* Variant 2 — embed widget (JS-rendered, drop-in styling) *@
                    <section class="@Card mt-4">
                        <h2 class="@H2">Embed widget</h2>
                        <p class="@Muted m-0">Include <code class="px-1 bg-slate-100 dark:bg-dgb-800 rounded text-[0.6875rem]">digipay.js</code> once and drop a <code class="px-1 bg-slate-100 dark:bg-dgb-800 rounded text-[0.6875rem]">data-digipay-button</code> element anywhere — the widget swaps it for a pre-styled button that opens the hosted page in a new tab.</p>
                        <div class="@Eyebrow mt-1">Preview</div>
                        <div class="p-4 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-lg text-center">
                            @* The widget's real output uses inline styles — match them so preview = reality. *@
                            <a href="@DonationHostedUrl" target="_blank" rel="noopener"
                               style="display:inline-flex;align-items:center;gap:8px;padding:10px 18px;background:#0066ff;color:#fff;border-radius:10px;text-decoration:none;font:600 14px system-ui,-apple-system,Segoe UI,sans-serif;">
                                @if (DonationLogoUrl is { } widgetLogo) { <img src="@widgetLogo" alt="" width="20" height="20" style="width:20px;height:20px;object-fit:contain;border-radius:50%;flex-shrink:0;" /> }
                                @DonationButtonLabel
                            </a>
                        </div>
                        <div class="@Eyebrow">HTML snippet</div>
                        <pre class="@Pre">@DonationWidgetSnippet</pre>
                        <button class="@BtnGhost" @onclick='() => CopySnippetAsync("widget", DonationWidgetSnippet)'>Copy snippet</button>
                    </section>

                    @* Variant 3 — raw BIP21 (direct OS wallet handoff) *@
                    <section class="@Card mt-4">
                        <h2 class="@H2">Raw BIP21 link</h2>
                        <p class="@Muted m-0">Direct <code class="px-1 bg-slate-100 dark:bg-dgb-800 rounded text-[0.6875rem]">digibyte:</code> protocol URI. Clicking on mobile opens the default DGB wallet immediately — no intermediate page. Desktop behavior depends on installed protocol handlers.</p>
                        <div class="@Eyebrow mt-1">Preview</div>
                        <div class="p-4 bg-slate-50 dark:bg-dgb-950 border border-slate-200 dark:border-dgb-800 rounded-lg text-center">
                            <a href="@DonationBip21Uri"
                               class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-dgb-800 text-slate-900 dark:text-white font-semibold rounded-lg no-underline text-sm border border-slate-200 dark:border-dgb-800">
                                @if (DonationLogoUrl is { } bip21Logo) { <img src="@bip21Logo" alt="" width="20" height="20" class="w-5 h-5 object-contain rounded-full shrink-0" /> }
                                @DonationButtonLabel
                            </a>
                        </div>
                        <div class="@Eyebrow">HTML snippet</div>
                        <pre class="@Pre">@DonationBip21Snippet</pre>
                        <button class="@BtnGhost" @onclick='() => CopySnippetAsync("bip21", DonationBip21Snippet)'>Copy snippet</button>
                    </section>
                }
            }
            else if (activeTab == "webhook")
            {
                <div class="flex items-baseline justify-between mb-1 slide-up">
                    <h1 class="@H1">Webhooks</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong></span>
                </div>
                @if (WebhookFailing)
                {
                    @* FR-024: recent deliveries are failing; link straight to the log. *@
                    <div class="ui-banner ui-banner-warning mb-4" role="status">
                        <Icon Name="alert" Class="" />
                        <p>Webhook deliveries to your server are failing. <a href="@($"{HrefFor(DashboardSections.ForKey("webhook"))}#delivery-log")" class="font-semibold underline">See the delivery log</a> to find out why.</p>
                    </div>
                }
                <p class="@Muted mb-6 slide-up-delay-1">POST with HMAC-SHA256 signature on session state changes. Each store has its own webhook URL and secret. Header: <span class="font-mono">X-DigiPay-Signature: sha256=…</span></p>

                <section class="@Card scale-in-delay-1">
                    <div class="field">
                        <label class="field-label" for="webhook-url">Webhook address</label>
                        <input id="webhook-url" @bind="webhookInput" type="url" inputmode="url" placeholder="https://your-server.example/digipay-webhook" class="@Input" aria-describedby="webhook-url-hint" />
                        <p id="webhook-url-hint" class="field-hint">A public https:// address on your server. Leave it empty and save to turn webhooks off.</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <button class="@Btn" @onclick="SaveWebhookAsync" disabled="@(webhookBusy || webhookInput == (activeStore.WebhookUrl ?? ""))">
                            @(webhookBusy ? "Saving…" : "Save")
                        </button>
                        <button class="@BtnGhost" @onclick="TestWebhookAsync" disabled="@(webhookBusy || string.IsNullOrWhiteSpace(activeStore.WebhookUrl))">
                            Send test event
                        </button>
                    </div>
                    @if (webhookMessage != null) { <p class="@Muted m-0">@webhookMessage</p> }
                    @if (webhookError != null) { <p class="field-error" role="alert">@webhookError</p> }
                </section>

                @* Signing secret: DigiPay signs each delivery with it. It is shown once, when it is
                   created or rotated; after that only "it's set" is known here. *@
                <section id="signing-secret" class="@Card mt-4">
                    <h2 class="@H2">Signing secret</h2>
                    @if (revealedSecret is not null)
                    {
                        <div class="dash-once-card">
                            <p class="font-semibold m-0">New signing secret — copy it now</p>
                            <p class="@Muted m-0">This is the only time it is shown. Put it in your server's settings to check the <span class="font-mono">X-DigiPay-Signature</span> header.</p>
                            <pre id="webhook-secret" class="@Pre break-all">@revealedSecret</pre>
                            <div class="flex gap-2 flex-wrap">
                                <CopyButton Value="@revealedSecret" Label="Copy signing secret" Text="Copy secret" TargetId="webhook-secret" SuccessText="Signing secret copied. Store it somewhere safe." />
                                <button type="button" class="@BtnGhost btn-sm" @onclick="() => revealedSecret = null">Dismiss</button>
                            </div>
                        </div>
                    }
                    else if (activeStore.HasWebhookSecret)
                    {
                        <p class="@Muted m-0">A signing secret is set for this store. It can't be shown again; if you've lost it, rotate it to get a new one.</p>
                    }
                    else
                    {
                        <p class="@Muted m-0">Save a webhook address above and a signing secret is created for you.</p>
                    }
                    @if (activeStore.HasWebhookSecret || !string.IsNullOrWhiteSpace(activeStore.WebhookUrl))
                    {
                        <button type="button" class="btn-secondary btn-sm self-start"
                                @onclick='() => Ask("Rotate the signing secret?", "A new secret is created and shown once. The old secret stops working at once, so webhook checks on your server fail until you put the new secret there.", "Rotate secret", RotateWebhookSecretAsync)'>
                            Rotate secret
                        </button>
                    }
                </section>

                <section id="delivery-log" class="@Card mt-4" tabindex="-1">
                    <div class="flex items-baseline justify-between flex-wrap gap-2">
                        <h2 class="@H2">Delivery log</h2>
                        <div class="flex gap-2 flex-wrap">
                            <button class="@BtnGhost btn-sm" @onclick="ExportDeliveriesCsvAsync" disabled="@exportingCsv"
                                    aria-busy="@(exportingCsv ? "true" : null)" title="Download as CSV">
                                @(exportingCsv ? "Exporting…" : "Export CSV")
                            </button>
                            <button class="@BtnGhost btn-sm" @onclick="LoadDeliveriesAsync" disabled="@loadingDeliveries"
                                    aria-busy="@(loadingDeliveries ? "true" : null)">
                                <Icon Name="refresh" Class="w-4 h-4" /><span>Refresh</span>
                            </button>
                        </div>
                    </div>
                    <p class="@Muted m-0">Last 25 delivery attempts for this store. Replays re-fire the event with the same payload and add a new row to the log.</p>
                    @if (deliveries is null)
                    {
                        <Skeleton Shape="row" Count="3" />
                    }
                    else if (deliveries.Count == 0)
                    {
                        <EmptyState Title="Nothing sent yet"
                                    Text="Save a webhook address above and send a test event; every delivery shows up here."
                                    BakuPose="support" Class="border-0 shadow-none p-0" />
                    }
                    else
                    {
                        <ul class="list-none p-0 m-0 flex flex-col gap-2">
                            @foreach (var d in deliveries)
                            {
                                var pillBg = d.Success
                                    ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300"
                                    : (d.StatusCode is null
                                        ? "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"
                                        : "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300");
                                var pillLabel = d.StatusCode?.ToString() ?? "network err";
                                <li class="p-3 border border-slate-200 dark:border-dgb-800 rounded-lg">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full @pillBg">@pillLabel</span>
                                                <span class="font-semibold text-sm text-slate-900 dark:text-white">@d.EventName</span>
                                                @if (d.Attempt > 1) { <span class="@Muted">· attempt @d.Attempt</span> }
                                            </div>
                                            <div class="@Muted mt-1">
                                                @clock.Show(d.CreatedAt)
                                                @(d.DurationMs is null ? "" : $" · {d.DurationMs}ms")
                                                @if (!string.IsNullOrEmpty(d.SessionId))
                                                {
                                                    <span> · </span>
                                                    @if (d.SessionId.StartsWith("ses_test_"))
                                                    {
                                                        <span>test event</span>
                                                    }
                                                    else
                                                    {
                                                        <a href="@SessionHref(d.SessionId)" class="font-mono">@d.SessionId</a>
                                                    }
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(d.ErrorMessage))
                                            {
                                                <div class="font-mono text-xs text-red-500 dark:text-red-400 mt-1 break-all">@d.ErrorMessage</div>
                                            }
                                            else if (!string.IsNullOrEmpty(d.ResponseSnippet))
                                            {
                                                <div class="font-mono text-xs text-slate-500 dark:text-slate-400 mt-1 break-all max-w-xl">@(d.ResponseSnippet.Length > 160 ? d.ResponseSnippet[..160] + "…" : d.ResponseSnippet)</div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(d.SessionId) && !d.SessionId.StartsWith("ses_test_"))
                                        {
                                            <button class="@BtnGhost text-xs py-1.5 px-3 shrink-0" @onclick="() => ReplayDeliveryAsync(d.Id)" disabled="@replayingId.Equals(d.Id)">
                                                @(replayingId == d.Id ? "Replaying…" : "Replay")
                                            </button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
            else if (activeTab == "stores")
            {
                <div class="flex items-baseline justify-between mb-1 slide-up"><h1 class="@H1">Stores</h1></div>
                <p class="@Muted mb-6 slide-up-delay-1">Each store has its own receive address, webhook config, and sessions. You can run multiple shops from one account.</p>

                <section class="@Card scale-in-delay-1">
                    <h2 class="@H2">Add a new store</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-2 items-end">
                        <div class="field">
                            <label class="field-label" for="new-store-name">Store name</label>
                            <input id="new-store-name" @bind="newStoreName" class="@Input" maxlength="120" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="new-store-network">Network</label>
                            <select id="new-store-network" @bind="newStoreNetwork" class="@Input sm:w-32">
                                <option value="mainnet">mainnet</option>
                                <option value="testnet">testnet</option>
                                <option value="regtest">regtest</option>
                            </select>
                        </div>
                        <button class="@Btn" @onclick="AddStoreAsync" disabled="@(storeBusy || string.IsNullOrWhiteSpace(newStoreName))"
                                aria-busy="@(storeBusy ? "true" : null)">
                            @(storeBusy ? "Adding…" : "Add store")
                        </button>
                    </div>
                    @if (storeError != null) { <p class="field-error" role="alert">@storeError</p> }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Your stores</h2>
                    <ul class="list-none p-0 m-0 flex flex-col gap-2">
                        @foreach (var s in stores)
                        {
                            var isActive = s.Id == activeStoreId;
                            <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-3 border rounded-lg @(isActive ? "border-dgb-500 bg-dgb-500/5" : "border-slate-200 dark:border-dgb-800")">
                                <div class="min-w-0">
                                    <div class="font-semibold text-sm text-slate-900 dark:text-white" style="overflow-wrap:anywhere">@s.Name @(isActive ? "· active" : "")</div>
                                    <div class="@Muted" style="overflow-wrap:anywhere">
                                        @s.Network ·
                                        @(s.HasReceive ? $"receiving to {s.ReceivePreview}" : "no receive configured")
                                        @(string.IsNullOrEmpty(s.WebhookUrl) ? "" : " · webhook set")
                                    </div>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    @if (!isActive)
                                    {
                                        <button class="btn-secondary btn-sm" @onclick="() => SetActiveAsync(s.Id)">Switch to</button>
                                    }
                                    <button class="btn-danger btn-sm"
                                            @onclick='() => Ask("Delete this store?", $"\u201c{s.Name}\u201d stops taking payments and disappears from your dashboard. Payments already made are not affected. This can\u2019t be undone.", "Delete store", () => DeleteStoreAsync(s.Id))'
                                            disabled="@(stores.Count <= 1)" title="@(stores.Count <= 1 ? "You need at least one store" : null)">
                                        Delete
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
            else if (activeTab == "apikeys")
            {
                <div class="flex items-baseline justify-between mb-1 slide-up"><h1 class="@H1">API keys</h1></div>
                <p class="@Muted mb-6 slide-up-delay-1">Long-lived tokens for SDK / server-to-server use. Secrets are shown <strong>once</strong> at creation — store them in your secrets manager.</p>

                @if (createdKey is not null)
                {
                    <section class="@Card mb-4 border-emerald-200 dark:border-emerald-800/30 bg-emerald-50 dark:bg-emerald-900/20">
                        <h2 class="@H2 text-emerald-700 dark:text-emerald-300">New key created — copy it now</h2>
                        <p class="@Muted m-0">This is the only time the secret will be shown. After you dismiss this card, only the prefix remains visible.</p>
                        <pre class="@Pre break-all">@createdKey.ApiKey</pre>
                        <div class="flex gap-2 flex-wrap">
                            <button class="@Btn" @onclick="CopyCreatedKeyAsync">Copy key</button>
                            <button class="@BtnGhost" @onclick="() => { createdKey = null; createdKeyCopied = false; }">Dismiss</button>
                        </div>
                    </section>
                }

                <section class="@Card">
                    <h2 class="@H2">Generate new key</h2>
                    @* Input + button share a row so baselines align; hint flows below so it
                       doesn't push the button off the input's centerline. *@
                    <label class="field-label" for="new-key-label">Label <span class="font-normal opacity-70">(optional)</span></label>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input id="new-key-label" @bind="newKeyLabel" placeholder="e.g. production, ci"
                               class="@Input flex-1" maxlength="80" aria-describedby="new-key-hint" />
                        <button class="@Btn sm:shrink-0" @onclick="CreateApiKeyAsync" disabled="@creatingKey" aria-busy="@(creatingKey ? "true" : null)">
                            @(creatingKey ? "Creating…" : "Generate key")
                        </button>
                    </div>
                    <div id="new-key-hint" class="@Muted text-[0.6875rem] mt-0.5">Just to help you tell keys apart. POS tablets have their own keys, under POS tablets.</div>
                    @if (apiKeyError != null) { <p class="field-error" role="alert">@apiKeyError</p> }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Your keys</h2>
                    @if (loadingKeys && apiKeys is null)
                    {
                        <Skeleton Shape="row" Count="2" />
                    }
                    else if (apiKeys is null || apiKeys.Count == 0)
                    {
                        <EmptyState Title="No API keys"
                                    Text="Create a key above to connect your shop, plugin or scripts through the SDKs or REST API."
                                    BakuPose="idea" Class="border-0 shadow-none p-0" />
                    }
                    else
                    {
                        <ul class="list-none p-0 m-0 flex flex-col gap-2">
                            @foreach (var k in apiKeys)
                            {
                                <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-3 border rounded-lg @(k.IsRevoked ? "border-slate-200 dark:border-dgb-800 opacity-50" : "border-slate-200 dark:border-dgb-800")">
                                    <div class="min-w-0">
                                        <div class="font-semibold text-sm text-slate-900 dark:text-white">
                                            @(string.IsNullOrEmpty(k.Label) ? "(no label)" : k.Label)
                                            @if (k.IsRevoked) { <span class="text-xs text-red-500 dark:text-red-400 font-medium"> · revoked</span> }
                                        </div>
                                        <div class="font-mono text-xs text-slate-500 dark:text-slate-400 my-0.5 break-all">@k.Prefix…</div>
                                        <div class="@Muted">
                                            Created @clock.Show(k.CreatedAt)
                                            @(k.LastUsedAt is null ? " · never used" : $" · last used {clock.Show(k.LastUsedAt)}")
                                            @(k.RevokedAt is null ? "" : $" · revoked {clock.Show(k.RevokedAt)}")
                                        </div>
                                    </div>
                                    @if (!k.IsRevoked)
                                    {
                                        <button class="btn-danger btn-sm shrink-0"
                                                @onclick='() => Ask("Revoke this API key?", "Anything using this key (your shop, plugin or scripts) stops working at once. This can\u2019t be undone; you can create a new key.", "Revoke key", () => RevokeApiKeyAsync(k.Id), "API key revoked")'>
                                            Revoke
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
            else if (activeTab == "audit")
            {
                <AuditPanel Token="@(token ?? string.Empty)" Clock="@clock" />
            }
            else if (activeTab == "pos")
            {
                <div class="flex items-baseline justify-between gap-2 flex-wrap mb-1 slide-up">
                    <h1 class="@H1">POS tablets</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore?.Name</strong></span>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">
                    Turn any tablet into a countertop checkout for <strong class="text-slate-900 dark:text-white">@activeStore?.Name</strong>.
                    Pair it once with a short code (below) and the tablet remembers itself — no sign-in needed at opening time.
                </p>

                <section class="@Card scale-in-delay-1">
                    <h2 class="@H2">Launch on this device</h2>
                    <p class="@Muted m-0">Opens the POS kiosk on this browser. Add it to your home screen for a full-screen experience.</p>
                    <a class="@Btn self-start no-underline text-white" href="/pos" target="_blank" rel="noopener">Open POS page ↗</a>
                </section>

                <section class="@Card mt-4 scale-in-delay-2">
                    <h2 class="@H2">Pair a new tablet</h2>
                    <p class="@Muted m-0">Generate a one-time code. On the tablet, go to <code class="font-mono text-xs">/pos</code> and type the code to pair. Codes expire after 10 minutes and can only be used once.</p>
                    <label class="field-label" for="pos-device-label">Tablet name <span class="font-normal opacity-70">(optional)</span></label>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input id="pos-device-label" @bind="newPosDeviceLabel" placeholder="e.g. Front counter"
                               class="@Input flex-1" maxlength="60" />
                        <button class="@Btn sm:shrink-0" @onclick="CreatePosPairingAsync" disabled="@posPairingBusy" aria-busy="@(posPairingBusy ? "true" : null)">
                            @(posPairingBusy ? "Generating…" : "Generate code")
                        </button>
                    </div>
                    @if (posPairingError != null) { <p class="field-error" role="alert">@posPairingError</p> }
                    @if (posPairing != null)
                    {
                        var left = PairingSecondsLeft;
                        var expired = left <= 0 && posPairedDevice is null;
                        @* The code stays here until a tablet uses it or it runs out, even if the merchant visits
                           another section and comes back (kept in this tab's sessionStorage). *@
                        <div @ref="pairingCard" tabindex="-1"
                             class="dash-pair @(posPairedDevice is not null ? "is-paired" : expired ? "is-expired" : "")"
                             role="status" aria-live="polite">
                            @if (posPairedDevice is not null)
                            {
                                <span class="dash-pair-seal" aria-hidden="true"><Icon Name="check" Class="w-6 h-6" /></span>
                                <p class="dash-pair-title">Tablet paired</p>
                                <p class="@Muted m-0">@posPairedDevice.Label is ready to take payments for @posPairing.StoreName.@(posPairingReplaces is not null ? " Its old key has been revoked." : "")</p>
                                <button type="button" class="btn-secondary btn-sm" @onclick="DismissPairing">Done</button>
                            }
                            else if (expired)
                            {
                                <p class="dash-pair-eyebrow">Code expired</p>
                                <p class="dash-pair-code is-dim">@posPairing.Code</p>
                                <p class="@Muted m-0">This code can no longer be used.</p>
                                <div class="dash-pair-actions">
                                    <button type="button" class="@Btn" @onclick="RegeneratePairingAsync">Get a new code</button>
                                    <button type="button" class="btn-secondary" @onclick="DismissPairing">Dismiss</button>
                                </div>
                            }
                            else
                            {
                                <p class="dash-pair-eyebrow">@(posPairingReplaces is not null ? $"Re-pair code for {posPairingReplaces.Label}" : "Pairing code")</p>
                                <p class="dash-pair-code" aria-label="@string.Join(" ", posPairing.Code.ToCharArray())">@posPairing.Code</p>
                                <div class="dash-pair-meter" aria-hidden="true"><span style="width: @(PairingProgress)%"></span></div>
                                <p class="@Muted m-0 tabular-nums">Expires in @($"{left / 60}:{left % 60:00}") · @posPairing.DeviceLabel</p>
                                <p class="dash-pair-wait"><span class="dash-pair-dot" aria-hidden="true"></span>Waiting for the tablet. On it, open <code class="font-mono text-xs">/pos</code> and type this code.</p>
                                <div class="dash-pair-actions">
                                    <button type="button" class="btn-secondary btn-sm" @onclick="CopyPairingCodeAsync">
                                        <Icon Name="@(pairingCopied ? "check" : "copy")" Class="w-4 h-4" /><span>@(pairingCopied ? "Copied" : "Copy code")</span>
                                    </button>
                                    <button type="button" class="btn-secondary btn-sm" @onclick="DismissPairing">Cancel</button>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="@Card mt-4 scale-in-delay-3">
                    <h2 class="@H2">Paired devices</h2>
                    @if (posDevices is null)
                    {
                        <Skeleton Shape="row" Count="2" />
                    }
                    else if (posDevices.Count == 0)
                    {
                        <EmptyState Title="No paired tablets"
                                    Text="Generate a pairing code above, then enter it on the tablet to take payments at the counter."
                                    BakuPose="idea" Class="border-0 shadow-none p-0" />
                    }
                    else
                    {
                        <ul class="list-none p-0 m-0 flex flex-col gap-2">
                            @foreach (var d in posDevices)
                            {
                                <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-3 border border-slate-200 dark:border-dgb-800 rounded-lg">
                                    <div class="min-w-0">
                                        <div class="font-semibold text-sm text-slate-900 dark:text-white">@(string.IsNullOrEmpty(d.Label) ? "(no label)" : d.Label)</div>
                                        <div class="font-mono text-xs text-slate-500 dark:text-slate-400 my-0.5 break-all">@d.Prefix…</div>
                                        <div class="@Muted">
                                            Paired @clock.Show(d.CreatedAt)
                                            @(d.LastUsedAt is null ? " · never used" : $" · last seen {clock.Show(d.LastUsedAt)}")
                                        </div>
                                        @if (d.StoreId is null)
                                        {
                                            @* Paired before tablets were tied to a store: it can still act on every store in the
                                               account. Re-pairing ties it to the store chosen above. *@
                                            <p class="dash-legacy-tablet">
                                                <Icon Name="alert" Class="w-4 h-4 shrink-0" />
                                                <span>Paired before tablets were tied to one store, so it can still take and cancel payments for all your stores. Re-pair it to limit it to <strong>@activeStore?.Name</strong>.</span>
                                            </p>
                                        }
                                        else if ((account?.Stores?.Count ?? 0) > 1)
                                        {
                                            <div class="@Muted">Store: @(account!.Stores!.FirstOrDefault(st => st.Id == d.StoreId)?.Name ?? "another store")</div>
                                        }
                                    </div>
                                    <div class="flex gap-2 shrink-0">
                                    <button type="button" class="btn-secondary btn-sm" disabled="@posPairingBusy"
                                            title="Make a new code for this tablet; its current key is revoked once the new pairing goes through"
                                            @onclick="() => RepairTabletAsync(d)">
                                        Re-pair
                                    </button>
                                    <button class="btn-danger btn-sm shrink-0"
                                            @onclick='() => Ask("Unpair this tablet?", "The tablet signs out of POS mode and can\u2019t take payments until you pair it again.", "Unpair tablet", () => UnpairTabletAsync(d.Id), "Tablet unpaired")'>
                                        Unpair
                                    </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    <p class="@Muted text-[0.6875rem] m-0 mt-1">Unpairing revokes the tablet's key. The tablet asks to be paired again on its next sale.</p>
                </section>
            }
            else if (activeTab == "settings")
            {
                <div class="flex items-baseline justify-between mb-1 slide-up">
                    <h1 class="@H1">Settings</h1>
                    <span class="@Muted">Store: <strong class="text-slate-900 dark:text-white">@activeStore.Name</strong></span>
                </div>
                <p class="@Muted mb-6 slide-up-delay-1">Account profile + settings for the active store.</p>

                <section class="@Card scale-in-delay-1">
                    <h2 class="@H2">Profile (account)</h2>
                    <p class="@Muted m-0">Display name for you as a DigiPay account owner. Store-facing names are set per store below.</p>
                    <div class="field">
                        <label class="field-label" for="account-name">Display name</label>
                        <input id="account-name" @bind="nameInput" placeholder="@account.DisplayName" class="@Input" maxlength="120" />
                    </div>
                    <button class="@Btn self-start" @onclick="SaveNameAsync" disabled="@(nameBusy || string.IsNullOrWhiteSpace(nameInput) || nameInput.Trim() == account.DisplayName)">
                        @(nameBusy ? "Saving…" : "Save")
                    </button>
                    @if (nameMessage != null) { <p class="@Muted m-0">@nameMessage</p> }
                    @if (nameError != null) { <p class="field-error" role="alert">@nameError</p> }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Store name</h2>
                    <p class="@Muted m-0">Shown to buyers on the hosted checkout and in webhook payloads.</p>
                    <div class="field">
                        <label class="field-label" for="store-name">Store name</label>
                        <input id="store-name" @bind="storeNameInput" placeholder="@activeStore.Name" class="@Input" maxlength="120" />
                    </div>
                    <button class="@Btn self-start" @onclick="SaveStoreNameAsync" disabled="@(storeNameBusy || string.IsNullOrWhiteSpace(storeNameInput) || storeNameInput.Trim() == activeStore.Name)">
                        @(storeNameBusy ? "Saving…" : "Save")
                    </button>
                    @if (storeNameError != null) { <p class="field-error" role="alert">@storeNameError</p> }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Default currency</h2>
                    <p class="@Muted m-0">Payment links and newly paired POS tablets start in this currency. A cashier can still pick another on each tablet.</p>
                    <div class="field">
                        <label class="field-label" for="store-currency">Currency</label>
                        <button id="store-currency" type="button" class="@Input dash-currency-btn" aria-haspopup="dialog" disabled="@defaultCurrencyBusy"
                                aria-label="@($"Default currency: {DefaultCurrencyName(activeStore.DefaultCurrency)}, change")" @onclick="() => defaultCurrencyPickerOpen = true">
                            @if (activeStore.DefaultCurrency is { } current)
                            {
                                <CurrencyFlag Code="@current" />
                                <span class="dash-currency-code">@current</span>
                                <span class="dash-currency-name">@DefaultCurrencyName(current)</span>
                            }
                            else
                            {
                                <span class="dash-currency-name">Not set: links and new tablets start in DGB</span>
                            }
                            <Icon Name="chevron-down" Class="w-4 h-4" />
                        </button>
                        <CurrencyPicker Id="store-currency-picker" IsOpen="defaultCurrencyPickerOpen" Selected="@activeStore.DefaultCurrency" IncludeDgb="true" IncludeDd="@DdOffered"
                                        Title="Default currency" Hint="Payment links and new POS tablets for this store start in this currency."
                                        OnSelected="SaveDefaultCurrencyAsync" OnClosed="() => defaultCurrencyPickerOpen = false" />
                    </div>
                    @if (activeStore.DefaultCurrency is not null)
                    {
                        <button class="@BtnGhost self-start" @onclick="() => SaveDefaultCurrencyAsync(null)" disabled="@defaultCurrencyBusy">
                            @(defaultCurrencyBusy ? "Saving…" : "Clear default")
                        </button>
                    }
                    @if (defaultCurrencyError != null) { <p class="field-error" role="alert">@defaultCurrencyError</p> }
                </section>

                <section id="receive" class="@Card mt-4" tabindex="-1">
                    <h2 class="@H2">Where you receive payments</h2>
                    @if (activeStore.HasReceive)
                    {
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <div class="min-w-0">
                                <div class="@Eyebrow">Current</div>
                                <div class="font-mono text-sm font-semibold my-0.5 break-all">@activeStore.ReceivePreview</div>
                                <div class="@Muted">@(activeStore.ReceiveMode == "xpub" ? "Fresh address per session" : "Single reused address")</div>
                            </div>
                            <button class="@BtnGhost shrink-0" @onclick="() => showEditReceive = !showEditReceive">
                                @(showEditReceive ? "Cancel" : "Change")
                            </button>
                        </div>
                    }
                    @if (!activeStore.HasReceive || showEditReceive)
                    {
                        <div class="field">
                            <label class="field-label" for="receive-input">DigiByte address or BIP84 xpub</label>
                            <input id="receive-input" @bind="receiveInput" placeholder="dgb1… or xpub…" class="@Input font-mono text-xs" autocomplete="off" aria-describedby="receive-hint" />
                            <p id="receive-hint" class="field-hint">An xpub gives every payment its own address; a single address is reused. Use one from your own wallet.</p>
                        </div>
                        <button class="@Btn" @onclick="SaveReceiveAsync" disabled="@(busy || string.IsNullOrWhiteSpace(receiveInput))" aria-busy="@(busy ? "true" : null)">
                            @(busy ? "Saving…" : "Save")
                        </button>
                        @if (patchError != null) { <p class="field-error" role="alert">@patchError</p> }
                    }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Default session expiry</h2>
                    <p class="@Muted m-0">How long a pending session stays open before it expires. Defaults to 30 minutes. Late payments (up to 3 days past expiry) still reconcile automatically.</p>
                    <label class="field-label" for="expiry-input">Minutes</label>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input id="expiry-input" @bind="expiryInput" type="number" min="1" max="1440" placeholder="30"
                               class="@Input flex-1" aria-describedby="expiry-hint" />
                        <button class="@Btn sm:shrink-0" @onclick="SaveExpiryAsync" disabled="@expiryBusy">
                            @(expiryBusy ? "Saving…" : "Save")
                        </button>
                    </div>
                    <div id="expiry-hint" class="@Muted text-[0.6875rem] mt-0.5">1 to 1440 minutes. Leave blank for the default (30).</div>
                    @if (expiryMessage != null) { <p class="@Muted m-0">@expiryMessage</p> }
                    @if (expiryError != null) { <p class="field-error" role="alert">@expiryError</p> }
                </section>

                <section class="@Card mt-4">
                    <h2 class="@H2">Accept DigiDollar (DD) <span class="text-[0.625rem] font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400 align-middle ml-1">Beta</span></h2>
                    <p id="dd-setting-text" class="@Muted m-0">@Merchant.DigiDollarSettingText.Description(DdSurfacesEnabled)</p>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="ddEnabledInput" @bind:after="SaveDigiDollarEnabledAsync" disabled="@ddBusy" class="w-5 h-5 accent-dgb-500" />
                        <span class="text-sm">Enable DigiDollar for this store</span>
                    </label>
                    @if (ddMessage != null) { <p class="@Muted m-0">@ddMessage</p> }
                    @if (ddError != null) { <p class="field-error" role="alert">@ddError</p> }
                    @if (activeStore.DigiDollarEnabled && DdSurfacesEnabled)
                    {
                        @* specs/033 FR-029. *@
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="buyer-choice" checked="@activeStore.BuyerChoiceEnabled" disabled="@buyerChoiceBusy"
                                   @onchange="SaveBuyerChoiceAsync" class="w-5 h-5 accent-dgb-500" />
                            <span class="text-sm">Let buyers choose DGB or DigiDollar at checkout</span>
                        </label>
                        <p class="@Muted m-0">Applies to payments priced in a regular currency. Payments you create in DGB or in DD stay in that currency.</p>
                    }
                </section>
            }
            </div>
            }
        </ChildContent>
        <Overlays>
            <ConfirmDialog Open="@(pendingConfirm is not null)" Title="@(pendingConfirm?.Title ?? "")"
                           ConfirmLabel="@(pendingConfirm?.ConfirmLabel ?? "Confirm")" Busy="@confirmBusy"
                           OnConfirm="RunConfirmAsync" OnCancel="() => { pendingConfirm = null; confirmError = null; }">
                <p>@pendingConfirm?.Body</p>
                @if (confirmError is not null)
                {
                    <p class="field-error mt-3" role="alert">@confirmError</p>
                }
            </ConfirmDialog>
        </Overlays>
    </DashboardShell>
}

@code {
    // ----- Sections and addresses (spec 032, US2; contracts/dashboard-routes.md) -----
    // Every section has its own address (/merchant/{Section}). Moving between sections is real
    // navigation, so bookmarks and the back and forward buttons work (FR-014, FR-015). Blazor
    // keeps this component alive across sections, so the merchant, stores and lists stay loaded.

    [Parameter] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "store")] public string? StoreParam { get; set; }
    /// <summary>?status= : the Payments list filter (an API status), so tiles and bookmarks can link to it.</summary>
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }

    /// <summary>Shows API times in the browser's time zone (asked for once, at bootstrap).</summary>
    private readonly LocalClock clock = new();

    private string activeTab = "overview";
    private bool notFound;
    private bool storeNotFound;

    private DashboardSection CurrentSection => DashboardSections.ForKey(activeTab);

    /// <summary>The merchant's stores for the shell's switcher.</summary>
    private IReadOnlyList<DashboardShell.StoreOption> ShellStores =>
        stores.Select(s => new DashboardShell.StoreOption(s.Id, s.Name, s.Network)).ToArray();

    /// <summary>The section's address, keeping the chosen store when the merchant has several.</summary>
    private string HrefFor(DashboardSection sec) =>
        stores.Count > 1 && !string.IsNullOrEmpty(activeStoreId)
            ? $"{sec.Href}?store={Uri.EscapeDataString(activeStoreId)}"
            : sec.Href;

    protected override async Task OnParametersSetAsync()
    {
        var sec = DashboardSections.ForSlug(Section);
        notFound = sec is null;
        if (sec is null) return;
        var changed = activeTab != sec.Key;
        activeTab = sec.Key;
        var filter = NormalizeStatus(StatusParam);
        var filterChanged = filter != statusFilter;
        statusFilter = filter;
        if (account is null) return; // bootstrap applies the section and store once loaded
        // POS: reload the paired devices on each visit so revoked ones fall off.
        if (changed && sec.Key == "pos") { _ = LoadPosDevicesAsync(); _ = RestorePairingAsync(); }
        if (sec.Key != "pos") StopPairingWatch();
        var storeChanged = await ApplyStoreParamAsync();
        // The store change already reloaded the list with the new filter.
        if (filterChanged && !storeChanged) await LoadSessionsAsync();
        UpdatePolling();
    }

    /// <summary>The filter for a ?status= value: a known API status, or null for all payments.</summary>
    private static string? NormalizeStatus(string? status)
    {
        var s = status?.Trim().ToLowerInvariant();
        return s is not null && StatusFilters.Any(f => f.Value == s) ? s : null;
    }

    /// <summary>Uses the store named in the address (bookmarks, shared links). True when it switched stores.</summary>
    private async Task<bool> ApplyStoreParamAsync()
    {
        storeNotFound = false;
        if (string.IsNullOrEmpty(StoreParam) || StoreParam == activeStoreId) return false;
        if (stores.Any(s => s.Id == StoreParam))
        {
            activeStoreId = StoreParam;
            await OnActiveStoreChangedAsync();
            return true;
        }
        // Never show another merchant's store, or hint that it exists: not found.
        storeNotFound = true;
        return false;
    }

    /// <summary>
    /// The latest delivery attempts are failing (FR-024): the newest one failed and so did at least
    /// one of the two before it, so a single blip doesn't raise the banner.
    /// </summary>
    private bool WebhookFailing
    {
        get
        {
            if (deliveries is null || deliveries.Count == 0 || string.IsNullOrWhiteSpace(activeStore?.WebhookUrl)) return false;
            var recent = deliveries.OrderByDescending(d => d.CreatedAt).Take(3).ToList();
            return !recent[0].Success && (recent.Count == 1 || recent.Skip(1).Any(d => !d.Success));
        }
    }

    // ----- Confirmations for destructive actions (FR-025) and notices (FR-022) -----
    // Each confirmed action returns null when it worked, or a plain error sentence. An error stays
    // inside the open dialog (not behind it), so the merchant can try again or cancel.
    private sealed record PendingConfirm(string Title, string Body, string ConfirmLabel, Func<Task<string?>> Action, string? SuccessText);
    private PendingConfirm? pendingConfirm;
    private bool confirmBusy;
    private string? confirmError;

    private void Ask(string title, string body, string confirmLabel, Func<Task<string?>> action, string? successText = null)
    {
        confirmError = null;
        pendingConfirm = new PendingConfirm(title, body, confirmLabel, action, successText);
    }

    private async Task RunConfirmAsync()
    {
        if (pendingConfirm is null) return;
        var job = pendingConfirm;
        confirmBusy = true;
        confirmError = null;
        string? error;
        try { error = await job.Action(); }
        finally { confirmBusy = false; }
        if (error is not null)
        {
            confirmError = error;
            return;
        }
        // An action may open a follow-up question (a store that still holds DD); keep that one open.
        if (!ReferenceEquals(pendingConfirm, job)) return;
        pendingConfirm = null;
        if (job.SuccessText is not null) Toasts.Success(job.SuccessText);
    }

    /// <summary>A plain message for failures; details go to the server log, never the page.</summary>
    private string Plain(Exception ex, string what)
    {
        Log.LogWarning(ex, "Dashboard: {What} failed", what);
        return ApiError.Network;
    }

