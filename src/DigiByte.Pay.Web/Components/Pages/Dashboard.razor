    private string SessionsPath(int skip, int take, string? status) =>
        $"/v1/pay/sessions?take={take}&skip={skip}&storeId={Uri.EscapeDataString(activeStoreId)}"
        + (status is null ? "" : $"&status={Uri.EscapeDataString(status)}");

    private async Task<SessionList?> FetchSessionsAsync(int skip, int take, string? status)
    {
        var http = HttpFactory.CreateClient("PayApi");
        var response = await http.SendAsync(AuthedRequest(HttpMethod.Get, SessionsPath(skip, take, status)));
        return response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<SessionList>() : null;
    }

    /// <summary>The first page of the list (or as many rows as are showing, on a refresh).</summary>
    private async Task LoadSessionsAsync()
    {
        if (activeStore is null) return;
        loadingSessions = true; StateHasChanged();
        try
        {
            var take = Math.Clamp(sessions?.Count ?? PageSize, PageSize, 100);
            var payload = await FetchSessionsAsync(0, take, statusFilter);
            if (payload != null)
            {
                sessions = payload.Sessions;
                sessionsTotal = payload.Total;
            }
            else sessions ??= new();
        }
        catch (Exception ex) { Log.LogWarning(ex, "Dashboard: loading payments failed"); sessions ??= new(); }
        finally { loadingSessions = false; UpdatePolling(); StateHasChanged(); }
    }

    /// <summary>Load more: the next page after the rows already showing.</summary>
    private async Task LoadMoreSessionsAsync()
    {
        if (activeStore is null || sessions is null) return;
        loadingMore = true; StateHasChanged();
        try
        {
            var payload = await FetchSessionsAsync(sessions.Count, PageSize, statusFilter);
            if (payload is null) { Toasts.Error("More payments couldn't be loaded. Try again."); return; }
            var known = sessions.Select(s => s.Id).ToHashSet();
            sessions.AddRange(payload.Sessions.Where(s => !known.Contains(s.Id)));
            sessionsTotal = payload.Total;
        }
        catch (Exception ex) { Log.LogWarning(ex, "Dashboard: load more failed"); Toasts.Error(ApiError.Network); }
        finally { loadingMore = false; UpdatePolling(); StateHasChanged(); }
    }

    /// <summary>
    /// All-time counts for the Overview tiles: one small request per status (take=1, reading Total),
    /// because the list itself is paged and would only count its first page.
    /// </summary>
    private async Task LoadCountsAsync()
    {
        if (activeStore is null) return;
        try
        {
            string[] statuses = ["pending", "seen", "paid", "confirmed", "underpaid", "expired"];
            var all = FetchSessionsAsync(0, 1, null);
            var each = statuses.Select(s => FetchSessionsAsync(0, 1, s)).ToArray();
            await Task.WhenAll(each.Append(all));
            if (all.Result is null || each.Any(t => t.Result is null)) return; // tiles show a dash
            allTotal = all.Result.Total;
            statusCounts = statuses.Zip(each, (s, t) => (s, t.Result!.Total)).ToDictionary(x => x.s, x => x.Total);
        }
        catch (Exception ex) { Log.LogWarning(ex, "Dashboard: loading counts failed"); }
    }

    private static readonly string[] LiveStatuses = ["pending", "seen", "paid"];

    /// <summary>Starts or stops the list's auto-refresh: on while the Payments list shows a payment that can still change.</summary>
    private void UpdatePolling()
    {
        var wanted = activeTab == "sessions"
            && sessions is not null
            && sessions.Any(s => LiveStatuses.Contains(s.Status, StringComparer.OrdinalIgnoreCase));
        if (wanted && sessionPoller is null)
        {
            sessionPoller = new System.Threading.Timer(_ => _ = InvokeAsync(PollSessionsAsync), null, PollEvery, PollEvery);
        }
        else if (!wanted && sessionPoller is not null)
        {
            sessionPoller.Dispose();
            sessionPoller = null;
        }
    }

    private async Task PollSessionsAsync()
    {
        if (loadingSessions || loadingMore || activeTab != "sessions") { UpdatePolling(); return; }
        await LoadSessionsAsync();
        await LoadCountsAsync();
    }

    // CSV export: hit the same /sessions endpoint with ?format=csv, hand the
    // bytes to a tiny JS helper that triggers a Blob download. We do the
    // fetch server-side (via PayApi HttpClient with the auth header attached)
    // because the browser can't add a Bearer header to a plain navigation.
    private async Task ExportSessionsCsvAsync()
    {
        if (activeStore is null) return;
        await DownloadCsvAsync(
            $"/v1/pay/sessions?format=csv&storeId={Uri.EscapeDataString(activeStoreId)}",
            $"digipay-sessions-{DateTime.UtcNow:yyyyMMdd}.csv");
    }

    private async Task ExportDeliveriesCsvAsync()
    {
        if (activeStore is null) return;
        await DownloadCsvAsync(
            $"/v1/pay/stores/{activeStoreId}/webhook-deliveries?format=csv",
            $"digipay-deliveries-{activeStoreId}-{DateTime.UtcNow:yyyyMMdd}.csv");
    }

    private async Task DownloadCsvAsync(string apiPath, string filename)
    {
        exportingCsv = true; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Get, apiPath));
            if (!response.IsSuccessStatusCode)
            {
                Toasts.Error($"The CSV couldn't be downloaded. {await ApiError.ReadAsync(response)}");
                return;
            }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("digipayDownloadBlob", filename, "text/csv;charset=utf-8",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Dashboard: CSV export failed");
            Toasts.Error("The CSV couldn't be downloaded. Check your connection and try again.");
        }
        finally { exportingCsv = false; StateHasChanged(); }
    }

    private async Task LoadDonationAddressAsync()
    {
        if (activeStore is null || !activeStore.HasReceive) return;
        donationLoadFailed = false;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Get,
                $"/v1/pay/stores/{activeStoreId}/donation-address"));
            if (response.IsSuccessStatusCode)
            {
                var dto = await response.Content.ReadFromJsonAsync<DonationAddressDto>();
                donationAddress = dto?.Address;
            }
            donationLoadFailed = donationAddress is null;
        }
        catch (Exception ex) { Log.LogWarning(ex, "Dashboard: donation address failed"); donationLoadFailed = true; }
    }

    private async Task RefreshStoreAsync()
    {
        // Re-fetch account so the stores list (and active store's fields) stay fresh.
        await LoadAccountAsync();
        if (!stores.Any(s => s.Id == activeStoreId) && stores.Count > 0)
            activeStoreId = stores[0].Id;
    }

    private string WebBase => Nav.BaseUri.TrimEnd('/');

    private string DonationButtonLabel =>
        string.IsNullOrWhiteSpace(donButtonText) || (DonationIncludesDd && donButtonText == "Tip DGB")
            ? (DonationIncludesDd ? "Tip in DGB or DD" : "Tip DGB")
            : donButtonText;

    /// <summary>URL to the DigiPay-hosted /pay/button page with address + optional params.</summary>
    private string DonationHostedUrl
    {
        get
        {
            if (string.IsNullOrEmpty(donationAddress)) return "#";
            var sb = new System.Text.StringBuilder($"{WebBase}/pay/button?to=")
                .Append(Uri.EscapeDataString(donationAddress));
            if (donAmount > 0)
                sb.Append("&amount=").Append(donAmount.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture));
            if (!string.IsNullOrWhiteSpace(donName))
                sb.Append("&name=").Append(Uri.EscapeDataString(donName));
            if (!string.IsNullOrWhiteSpace(donLabel))
                sb.Append("&label=").Append(Uri.EscapeDataString(donLabel));
            if (DonationIncludesDd && activeStore is not null)
            {
                sb.Append("&store=").Append(Uri.EscapeDataString(activeStore.Id));
                if (donOpenOn == "DD") sb.Append("&currency=DD");
                if (DonationDdAmountText is { } dd) sb.Append("&ddAmount=").Append(dd);
            }
            return sb.ToString();
        }
    }

    /// <summary>Direct BIP21 `digibyte:` URI — bypasses the hosted page, opens OS wallet handler.</summary>
    private string DonationBip21Uri
    {
        get
        {
            if (string.IsNullOrEmpty(donationAddress)) return "#";
            var sb = new System.Text.StringBuilder("digibyte:").Append(donationAddress);
            var sep = "?";
            if (donAmount > 0)
            {
                sb.Append(sep).Append("amount=").Append(donAmount.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture));
                sep = "&";
            }
            if (!string.IsNullOrWhiteSpace(donName))
            {
                sb.Append(sep).Append("label=").Append(Uri.EscapeDataString(donName));
                sep = "&";
            }
            if (!string.IsNullOrWhiteSpace(donLabel))
            {
                sb.Append(sep).Append("message=").Append(Uri.EscapeDataString(donLabel));
            }
            return sb.ToString();
        }
    }

