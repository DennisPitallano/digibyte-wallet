    private async Task<string?> DeleteStoreAsync(string storeId)
    {
        if (stores.Count <= 1) return ApiError.Plain(400, "cannot delete your only store");
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Delete, $"/v1/pay/stores/{storeId}"));
            if (!response.IsSuccessStatusCode) return await ApiError.ReadAsync(response);
            await LoadAccountAsync();
            if (activeStoreId == storeId && stores.Count > 0)
            {
                activeStoreId = stores[0].Id;
                await OnActiveStoreChangedAsync();
            }
            // The address may still name the deleted store.
            Nav.NavigateTo(HrefFor(CurrentSection), replace: true);
            Toasts.Success("Store deleted");
            StateHasChanged();
            return null;
        }
        catch (Exception ex) { return Plain(ex, "delete store"); }
    }

