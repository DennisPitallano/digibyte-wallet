    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (revealPairing)
        {
            // A new pairing code: bring it into view so it isn't missed below the form.
            revealPairing = false;
            try
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/digipay-dashboard.js");
                await module.InvokeVoidAsync("reveal", pairingCard);
            }
            catch (JSException) { } catch (JSDisconnectedException) { }
        }
        if (!firstRender || account != null || bootstrapError != null) return;
        await BootstrapAsync();
    }

    /// <summary>Signed-out visitors go to Digi-ID sign-in and come back to this exact address.</summary>
    private void GoToSignIn()
    {
        var here = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/merchant/signin?return={Uri.EscapeDataString(ReturnUrlGuard.Sanitize(here))}");
    }

    private async Task BootstrapAsync()
    {
        try
        {
            token = await JS.InvokeAsync<string?>("localStorage.getItem", "digipay-token");
            if (string.IsNullOrEmpty(token))
            {
                GoToSignIn();
                return;
            }
            await clock.InitAsync(JS);
            await LoadAccountAsync();
            if (account is not null && stores.Count > 0)
            {
                // The store in the address wins (bookmarks, shared links); otherwise the first one.
                activeStoreId = !string.IsNullOrEmpty(StoreParam) && stores.Any(s => s.Id == StoreParam) ? StoreParam : stores[0].Id;
                storeNotFound = !string.IsNullOrEmpty(StoreParam) && StoreParam != activeStoreId;
                await LoadActiveStoreContextAsync();
            }
            // Account-scoped (not store-scoped), load once at bootstrap. Paired tablets also
            // count for the getting-started checklist.
            await LoadApiKeysAsync();
            await LoadPosDevicesAsync();
            if (activeTab == "pos") await RestorePairingAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Details to the server log; the page shows a plain message with Try again.
            Log.LogWarning(ex, "Dashboard bootstrap failed");
            bootstrapError = "load-failed";
            StateHasChanged();
        }
    }

    private HttpRequestMessage AuthedRequest(HttpMethod method, string path, HttpContent? content = null)
    {
        var req = new HttpRequestMessage(method, path) { Content = content };
        req.Headers.TryAddWithoutValidation("Authorization", $"Bearer {token}");
        return req;
    }

    private async Task LoadAccountAsync()
    {
        var http = HttpFactory.CreateClient("PayApi");
        var response = await http.SendAsync(AuthedRequest(HttpMethod.Get, "/v1/pay/me/"));
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "digipay-token");
            await JS.InvokeVoidAsync("DigiPayAuth.refresh");
            GoToSignIn();
            return;
        }
        response.EnsureSuccessStatusCode();
        var dto = await response.Content.ReadFromJsonAsync<AccountDto>();
        account = dto;
        stores = dto?.Stores?.ToList() ?? new();
    }

    private async Task LoadActiveStoreContextAsync()
    {
        if (activeStore is null) return;
        webhookInput = activeStore.WebhookUrl ?? "";
        expiryInput = activeStore.DefaultSessionExpiryMinutes;
        ddEnabledInput = activeStore.DigiDollarEnabled;
        await ApplyStoreDefaultToLinkFormAsync();
        await Task.WhenAll(LoadSessionsAsync(), LoadCountsAsync());
        await LoadDeliveriesAsync();
        if (activeStore.HasReceive) await LoadDonationAddressAsync();
        else donationAddress = null;
    }

    private async Task OnActiveStoreChangedAsync()
    {
        // Reset store-scoped state, reload everything for the new active store.
        donationAddress = null;
        donAcceptDd = false;
        ddDonationAddress = null;
        donDdError = null;
        donationLoadFailed = false;
        sessions = null;
        sessionsTotal = 0;
        statusCounts = null;
        allTotal = null;
        deliveries = null;
        createdSession = null;
        createdSessionQr = null;
        revealedSecret = null;
        showEditReceive = false;
        receiveInput = "";
        storeNameInput = "";
        webhookMessage = webhookError = null;
        expiryMessage = expiryError = null;
        ddMessage = ddError = null;
        defaultCurrencyError = null;
        defaultCurrencyPickerOpen = false;
        await LoadActiveStoreContextAsync();
        StateHasChanged();
    }

    /// <summary>Switches the active store and puts it in the address, so a reload keeps it.</summary>
    private async Task SetActiveAsync(string storeId)
    {
        activeStoreId = storeId;
        await OnActiveStoreChangedAsync();
        Nav.NavigateTo(HrefFor(CurrentSection), replace: true);
        Toasts.Success($"Now showing {activeStore?.Name}");
