    private async Task SaveWebhookAsync()
    {
        if (activeStore is null) return;
        webhookBusy = true; webhookError = null; webhookMessage = null; StateHasChanged();
        try
        {
            var (ok, error, body) = await PatchStoreAsync(new { webhookUrl = webhookInput.Trim() });
            if (!ok) { webhookError = error; return; }
            // The first save creates the signing secret and returns it this once.
            if (!string.IsNullOrEmpty(body?.WebhookSecret)) revealedSecret = body.WebhookSecret;
            await RefreshStoreAsync();
            webhookMessage = string.IsNullOrWhiteSpace(activeStore?.WebhookUrl) ? "Webhook cleared." : "Webhook saved.";
            Toasts.Success(webhookMessage!);
        }
        catch (Exception ex) { webhookError = Plain(ex, "webhookError"); }
        finally { webhookBusy = false; StateHasChanged(); }
    }

    /// <summary>Creates a new signing secret (the old one stops working) and shows it once.</summary>
    private async Task<string?> RotateWebhookSecretAsync()
    {
        if (activeStore is null) return null;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Post, $"/v1/pay/stores/{activeStoreId}/webhook-secret/rotate"));
            if (!response.IsSuccessStatusCode) return await ApiError.ReadAsync(response);
            var body = await response.Content.ReadFromJsonAsync<WebhookSecretDto>();
            if (string.IsNullOrEmpty(body?.WebhookSecret)) return ApiError.Plain(500, null);
            revealedSecret = body.WebhookSecret;
            await RefreshStoreAsync();
            Toasts.Success("New signing secret created. Copy it now.");
            return null;
        }
        catch (Exception ex) { return Plain(ex, "rotate webhook secret"); }
    }

