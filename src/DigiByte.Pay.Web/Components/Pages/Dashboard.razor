        else Toasts.Info("Your browser blocked copying. Select the key and copy it by hand.");
    }

    // POS pairing state — one-shot code generation + a list of POS-labelled
    // keys so the merchant can see and revoke paired tablets.
    private string newPosDeviceLabel = "";
    private bool posPairingBusy;
    private string? posPairingError;
    private PosPairingDto? posPairing;
    private List<PosDeviceDto>? posDevices;

    private Task CreatePosPairingAsync() =>
        StartPairingAsync(string.IsNullOrWhiteSpace(newPosDeviceLabel) ? null : newPosDeviceLabel.Trim(), replaces: null);

    /// <summary>A new code for a tablet that's already paired (reset, cleared or moved); its old key is revoked
    /// once the new pairing goes through.</summary>
    private Task RepairTabletAsync(PosDeviceDto device) => StartPairingAsync(TabletName(device.Label), replaces: device);

    /// <summary>The same kind of code again, for the same tablet if it was a re-pair.</summary>
    private Task RegeneratePairingAsync() =>
        StartPairingAsync(posPairingReplaces is not null ? TabletName(posPairingReplaces.Label) : TabletName(posPairing?.DeviceLabel), posPairingReplaces);

    // "POS — Front counter" → "Front counter"; the dated default name ("POS device — …") gets a fresh default.
    private static string? TabletName(string? label) =>
        label is not null && label.StartsWith("POS — ", StringComparison.Ordinal) ? label["POS — ".Length..] : null;

    private async Task StartPairingAsync(string? label, PosDeviceDto? replaces)
    {
        if (activeStore is null) return;
        posPairingBusy = true;
        posPairingError = null;
        StopPairingWatch();
        posPairing = null;
        posPairedDevice = null;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var body = JsonContent.Create(new { storeId = activeStoreId, deviceLabel = label });
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Post, "/v1/pay/pos/pairings", body));
            if (!response.IsSuccessStatusCode)
            {
                posPairingError = await ApiError.ReadAsync(response);
                return;
            }
            posPairing = await response.Content.ReadFromJsonAsync<PosPairingDto>();
            posPairingReplaces = replaces;
            pairingCopied = false;
            newPosDeviceLabel = "";
            await SavePairingAsync();
            StartPairingWatch();
            revealPairing = true;
        }
        catch (Exception ex) { posPairingError = Plain(ex, "posPairingError"); }
        finally { posPairingBusy = false; StateHasChanged(); }
    }

    // ---- Watching a code: countdown every second, the device list every few seconds. ----
    private PosDeviceDto? posPairingReplaces;
    private PosDeviceDto? posPairedDevice;
    private System.Threading.Timer? pairingTimer;
    private int pairingTicks;
    private bool pairingCopied;
    private bool revealPairing;
    private ElementReference pairingCard;
    private static readonly TimeSpan PairingTtl = TimeSpan.FromMinutes(10);

    private int PairingSecondsLeft => posPairing is null ? 0 : Math.Max(0, (int)Math.Ceiling((posPairing.ExpiresAt.ToUniversalTime() - DateTime.UtcNow).TotalSeconds));
    private int PairingProgress => (int)Math.Clamp(PairingSecondsLeft * 100.0 / PairingTtl.TotalSeconds, 0, 100);

    private void StartPairingWatch()
    {
        pairingTimer?.Dispose();
        pairingTicks = 0;
        pairingTimer = new System.Threading.Timer(_ => _ = InvokeAsync(PairingTickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopPairingWatch()
    {
        pairingTimer?.Dispose();
        pairingTimer = null;
    }

    private async Task PairingTickAsync()
    {
        if (posPairing is null || posPairedDevice is not null) { StopPairingWatch(); return; }
        if (PairingSecondsLeft <= 0)
        {
            StopPairingWatch();
            await ClearSavedPairingAsync();
            StateHasChanged();
            return;
        }
        if (++pairingTicks % 3 == 0) await CheckPairedAsync();
        StateHasChanged();
    }

    /// <summary>Has a tablet used the code yet? Its new key shows up in the device list with the prefix the
    /// pairing announced.</summary>
    private async Task CheckPairedAsync()
    {
        if (posPairing is null || string.IsNullOrEmpty(posPairing.Prefix)) return;
        await LoadPosDevicesAsync();
        var paired = posDevices?.FirstOrDefault(d => d.Prefix == posPairing.Prefix);
        if (paired is null) return;
        posPairedDevice = paired;
        StopPairingWatch();
        await ClearSavedPairingAsync();
        if (posPairingReplaces is not null && posPairingReplaces.Id != paired.Id)
        {
            var error = await RevokeKeyAsync(posPairingReplaces.Id);
            if (error is not null) Toasts.Error($"The tablet paired, but its old key couldn't be revoked: {error} Unpair the old entry by hand.");
            await LoadPosDevicesAsync();
        }
        Toasts.Success($"{paired.Label} paired.");
    }

    private async Task CopyPairingCodeAsync()
    {
        if (posPairing is null) return;
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("digipayClipboard.copy", posPairing.Code); }
        catch (JSException) { ok = false; }
        pairingCopied = ok;
        if (!ok) Toasts.Info("Your browser blocked copying. Read the code from the screen instead.");
    }

    private async Task DismissPairing()
    {
        StopPairingWatch();
        posPairing = null;
        posPairedDevice = null;
        posPairingReplaces = null;
        await ClearSavedPairingAsync();
    }

    // ---- Keeping an unused code across section visits (this tab only; cleared when used or expired). ----
    private sealed record SavedPairing(PosPairingDto Pairing, PosDeviceDto? Replaces);
    private const string PairingStoreKey = "digipay.dash.pairing:v1";

    private async Task SavePairingAsync()
    {
        if (posPairing is null) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new SavedPairing(posPairing, posPairingReplaces));
            await JS.InvokeVoidAsync("sessionStorage.setItem", PairingStoreKey, json);
        }
        catch (JSException) { } catch (JSDisconnectedException) { }
    }

    private async Task ClearSavedPairingAsync()
    {
        try { await JS.InvokeVoidAsync("sessionStorage.removeItem", PairingStoreKey); }
        catch (JSException) { } catch (JSDisconnectedException) { }
    }

    private async Task RestorePairingAsync()
    {
        if (posPairing is not null)
        {
            if (posPairedDevice is null && PairingSecondsLeft > 0) StartPairingWatch();
            return;
        }
        try
        {
            var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", PairingStoreKey);
            if (string.IsNullOrEmpty(json)) return;
            var saved = System.Text.Json.JsonSerializer.Deserialize<SavedPairing>(json);
            if (saved?.Pairing is null || saved.Pairing.StoreId != activeStoreId) return;
            posPairing = saved.Pairing;
            posPairingReplaces = saved.Replaces;
            if (PairingSecondsLeft <= 0) { await ClearSavedPairingAsync(); return; }
            await CheckPairedAsync();
            if (posPairedDevice is null) StartPairingWatch();
            StateHasChanged();
        }
        catch (JSException) { } catch (JSDisconnectedException) { } catch (System.Text.Json.JsonException) { }
    }

    private async Task LoadPosDevicesAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Get, "/v1/pay/pos/devices"));
            if (response.IsSuccessStatusCode)
                posDevices = await response.Content.ReadFromJsonAsync<List<PosDeviceDto>>();
        }
        catch { posDevices = new(); }
    }

