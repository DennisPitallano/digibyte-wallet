    /// <summary>The Payments filter: API status values with merchant-facing labels. Null is all.</summary>
    private static readonly (string? Value, string Label)[] StatusFilters =
    [
        (null, "All"),
        ("pending", "Waiting"),
        ("seen", "Detected"),
        ("paid", "Received"),
        ("confirmed", "Confirmed"),
        ("underpaid", "Underpaid"),
        ("expired", "Expired"),
        ("refunded", "Refunded"),
        ("voided", "Cancelled"),
    ];

    private static string FilterLabel(string? value) => StatusFilters.FirstOrDefault(f => f.Value == value).Label ?? "All";

    /// <summary>The Payments list address, keeping the store and adding ?status= when filtered.</summary>
    private string PaymentsHref(string? status)
    {
        var href = HrefFor(DashboardSections.ForKey("sessions"));
        if (status is null) return href;
        return href + (href.Contains('?') ? "&" : "?") + "status=" + Uri.EscapeDataString(status);
    }

    /// <summary>A payment's detail page, with the way back to the list it was opened from.</summary>
    private string SessionHref(string sessionId)
    {
        var back = activeTab == "sessions" ? PaymentsHref(statusFilter) : HrefFor(CurrentSection);
        return $"/merchant/sessions/{Uri.EscapeDataString(sessionId)}?back={Uri.EscapeDataString(back)}";
    }

