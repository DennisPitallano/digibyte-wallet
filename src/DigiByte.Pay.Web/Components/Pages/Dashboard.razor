    /// <summary>Revokes a key. Returns null when it worked, or a plain error.</summary>
    private async Task<string?> RevokeKeyAsync(string id)
    {
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Delete, $"/v1/pay/api-keys/{id}"));
            return response.IsSuccessStatusCode ? null : await ApiError.ReadAsync(response);
        }
        catch (Exception ex) { return Plain(ex, "revoke key"); }
    }

    private async Task<string?> RevokeApiKeyAsync(string id)
    {
        var error = await RevokeKeyAsync(id);
        if (error is null) await LoadApiKeysAsync();
        return error;
    }

    /// <summary>Unpairing revokes the tablet's key; the paired-devices list is what changes.</summary>
    private async Task<string?> UnpairTabletAsync(string id)
    {
        var error = await RevokeKeyAsync(id);
        if (error is null) { await LoadPosDevicesAsync(); StateHasChanged(); }
        return error;
    }

