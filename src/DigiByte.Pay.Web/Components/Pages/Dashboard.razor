    private static string CountText(int? n) => n is int v ? v.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) : "–";

    /// <summary>The store's all-time count for these statuses, or null while loading.</summary>
    private int? Sum(params string[] statuses) =>
