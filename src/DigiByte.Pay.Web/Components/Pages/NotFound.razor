@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · DigiPay</PageTitle>

@* Site-wide not-found page in the shared style (spec 032, T056). The dashboard shows its own
   not-found card for unknown /merchant/... addresses and stores that aren't the merchant's. *@
<main class="ui-shopper-page">
    <div class="card ui-checkout ui-checkout-center w-full max-w-md">
        <span class="ui-terminal-icon ui-badge-neutral" aria-hidden="true"><Icon Name="search" Class="w-7 h-7" /></span>
        <h1 class="page-title">Page not found</h1>
        <p class="ui-checkout-muted">There's nothing at this address. It may have moved, or the link may be mistyped.</p>
        <div class="w-full flex flex-col sm:flex-row gap-2">
            <a href="/" class="btn-primary flex-1">DigiPay home</a>
            <a href="/merchant" class="btn-secondary flex-1">Merchant dashboard</a>
        </div>
    </div>
</main>
