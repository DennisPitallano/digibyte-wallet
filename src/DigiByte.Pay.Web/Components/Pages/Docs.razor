@page "/docs"
@layout SiteLayout

<PageTitle>Developer docs: quickstart and guide — DigiPay</PageTitle>

@{
    const string P = "leading-relaxed text-slate-700 dark:text-slate-300 mb-3";
    const string Ul = "space-y-2 leading-relaxed text-slate-700 dark:text-slate-300 list-disc pl-5 mb-3";
    const string Ol = "space-y-2 leading-relaxed text-slate-700 dark:text-slate-300 list-decimal pl-5 mb-3";
}

<main class="flex-1 page-enter">
    <DocsLayout Current="/docs" Toc="toc">
        <article class="dp-docs-article">
            <p class="dp-docs-eyebrow">Developer docs</p>
            <h1 class="dp-docs-title slide-up">Accept DigiByte from your own code</h1>
            <p class="dp-docs-lead slide-up-delay-1">
                Start with the five-minute quickstart, then read how a payment moves from <InlineCode>pending</InlineCode> to
                <InlineCode>confirmed</InlineCode> and what your server hears along the way. Every endpoint, field and status code is in the
                <a href="/docs/api" class="text-dgb-500 hover:underline">API reference</a>.
            </p>

            @* Quick paths for the two most common readers: non-developers who just want a shareable link, and
               developers who'd rather start from a working app. *@
            <div class="grid sm:grid-cols-2 gap-3 mb-4 slide-up-delay-2">
                <a href="/merchant" class="card card-hover flex items-start gap-3 p-4 no-underline">
                    <Icon Name="link" Class="w-5 h-5 text-dgb-500 shrink-0 mt-0.5" />
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-slate-900 dark:text-white">Just need a link to share?</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
                            The dashboard's <strong class="text-slate-700 dark:text-slate-300">Payment links</strong> tab makes a checkout link with a QR code and share buttons. No code.
                        </div>
                    </div>
                </a>
                <a href="https://github.com/DennisPitallano/digibyte-wallet/tree/main/samples" target="_blank" rel="noopener" class="card card-hover flex items-start gap-3 p-4 no-underline">
                    <Icon Name="package" Class="w-5 h-5 text-dgb-500 shrink-0 mt-0.5" />
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-slate-900 dark:text-white">Rather start from an app?</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
                            Clone a single-file <strong class="text-slate-700 dark:text-slate-300">sample store</strong> for Express, Flask or ASP.NET: checkout plus a verified webhook.<span class="sr-only"> (opens in a new tab)</span>
                        </div>
                    </div>
                </a>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">
                Prefer clicking to curl? <a href="/digipay.postman_collection.json" download class="text-dgb-500 hover:underline">Download the Postman collection</a>
                (variables for <InlineCode>baseUrl</InlineCode> and <InlineCode>apiKey</InlineCode>).
            </p>

            @* ===================== Quickstart ===================== *@
            <DocsHeading Id="quickstart">Quickstart — 5 minutes</DocsHeading>
            <p class="@P">
                The API lives at <InlineCode>https://api.pay.dgbwallet.app</InlineCode>; the hosted checkout and the JS embed are served from
                <InlineCode>https://pay.dgbwallet.app</InlineCode>. Every request body is JSON, and authenticated calls send
                <InlineCode>Authorization: Bearer &lt;your API key&gt;</InlineCode>.
            </p>

            <DocsHeading Id="qs-key" Level="3">1. Get an API key</DocsHeading>
            <p class="@P">
                <a href="/merchant/signin" class="text-dgb-500 hover:underline">Sign in with Digi-ID</a> (scan a QR with your DigiByte wallet; no password),
                open the dashboard's <em>API keys</em> tab and create a key. The full key (<InlineCode>dgp_…</InlineCode>) is shown once: put it in your
                secrets manager.
            </p>
            <p class="@P">
                Setting up without a browser (self-hosting, CI)? One unauthenticated call creates an account, its first store and a key.
                It is limited to 5 sign-ups per hour from one address.
            </p>
            <CodeBlock Lang="bash" Label="Copy the register example">@("curl -X POST https://api.pay.dgbwallet.app/v1/pay/merchants \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"displayName\": \"My Shop\", \"addressOrXpub\": \"dgb1q...\", \"webhookUrl\": \"https://shop.example/digipay/webhook\" }'")</CodeBlock>
            <p class="@P">The response contains <InlineCode>apiKey</InlineCode>, <InlineCode>storeId</InlineCode> and, because a webhook URL was given, <InlineCode>webhookSecret</InlineCode>. Both secrets are shown only in this response. Accounts made this way already have a receive address, so skip to step 3.</p>

            <DocsHeading Id="qs-receive" Level="3">2. Set a receive address</DocsHeading>
            <p class="@P">
                A Digi-ID account starts with a <em>Default Store</em> that has nowhere to send money yet: creating a session now returns
                <InlineCode>400</InlineCode> with <InlineCode>store has no receive address or xpub configured</InlineCode>. Get the store id from
                <InlineCode>GET /v1/pay/stores</InlineCode>, then give it an account-level xpub (a fresh address for every invoice) or a single
                <InlineCode>dgb1…</InlineCode> address, plus your webhook URL:
            </p>
            <CodeBlock Lang="bash" Label="Copy the store setup example">@("curl -X PATCH https://api.pay.dgbwallet.app/v1/pay/stores/$STORE_ID \\\n  -H \"Authorization: Bearer $DIGIPAY_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"addressOrXpub\": \"xpub6...\", \"webhookUrl\": \"https://shop.example/digipay/webhook\" }'")</CodeBlock>
            <p class="@P">
                The first time a webhook URL is saved, the response includes <InlineCode>webhookSecret</InlineCode>. Save it now: later responses
                return <InlineCode>null</InlineCode>. Lost it? <a href="/docs/api#rotate-webhook-secret" class="text-dgb-500 hover:underline">Rotate the secret</a>
                to get a new one. (The dashboard's <em>Store settings</em> and <em>Webhook</em> tabs do the same without curl.)
            </p>

            <DocsHeading Id="qs-session" Level="3">3. Create a session</DocsHeading>
            <p class="@P">From your server, create a payment session with the amount in DGB:</p>
            <CodeBlock Lang="bash" Label="Copy the create-session example">@("curl -X POST https://api.pay.dgbwallet.app/v1/pay/sessions \\\n  -H \"Authorization: Bearer $DIGIPAY_KEY\" \\\n  -H \"Idempotency-Key: order-4201\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"amount\": 12.5, \"label\": \"Order #4201\" }'")</CodeBlock>
            <p class="@P">The response (shortened here) carries everything the buyer needs:</p>
            <CodeBlock Lang="json" Label="Copy the session response example">@("{\n  \"id\": \"ses_8kq2x7m4n9p3r6t1\",\n  \"storeId\": \"sto_4fj8w2k9m3n7p5q1\",\n  \"address\": \"dgb1qexampleaddress\",\n  \"amount\": 12.5,\n  \"status\": \"pending\",\n  \"uri\": \"digibyte:dgb1qexampleaddress?amount=12.5&label=Order%20%234201\",\n  \"checkoutUrl\": \"https://pay.dgbwallet.app/pay/ses_8kq2x7m4n9p3r6t1\",\n  \"expiresAt\": \"2026-11-26T12:30:00Z\"\n}")</CodeBlock>
            <p class="@P">Send the buyer to <InlineCode>checkoutUrl</InlineCode>, or show <InlineCode>uri</InlineCode> as a QR code in your own page. Keep <InlineCode>id</InlineCode> with your order.</p>

            <DocsHeading Id="qs-simulate" Level="3">4. Watch a checkout move, without paying</DocsHeading>
            <p class="@P">
                The public sandbox walks a demo session through every state so you can see the hosted checkout react. It needs no key
                (20 requests per minute per address):
            </p>
            <CodeBlock Lang="bash" Label="Copy the sandbox example">@("# 1. Make a throwaway demo session (5 DGB, its own demo store)\ncurl -X POST https://api.pay.dgbwallet.app/v1/pay/test/demo-session\n# -> { \"sessionId\": \"ses_demo_...\", \"storeId\": \"sto_demo_...\", \"merchantId\": \"mer_demo_...\" }\n\n# 2. Open https://pay.dgbwallet.app/pay/ses_demo_... in a browser, then advance it.\n#    Each call moves it one step: pending -> seen -> paid -> confirmed\ncurl -X POST https://api.pay.dgbwallet.app/v1/pay/test/sessions/ses_demo_.../advance")</CodeBlock>
            <div class="dp-callout dp-callout-warn">
                <p><strong>The sandbox only moves demo sessions.</strong> <InlineCode>advance</InlineCode> refuses any id that doesn't start with
                    <InlineCode>ses_demo_</InlineCode>, and demo stores have no webhook URL, so it never calls your server. Use step 5 to test your
                    webhook receiver, and a <a href="/docs#testing">testnet store</a> to run the real sequence end to end.</p>
            </div>

            <DocsHeading Id="qs-webhook" Level="3">5. Receive and verify a webhook</DocsHeading>
            <p class="@P">Ask DigiPay to send a signed <InlineCode>webhook.test</InlineCode> event to your store's URL right now. The response tells you what your server answered:</p>
            <CodeBlock Lang="bash" Label="Copy the webhook test example">@("curl -X POST https://api.pay.dgbwallet.app/v1/pay/stores/$STORE_ID/webhook/test \\\n  -H \"Authorization: Bearer $DIGIPAY_KEY\"\n# -> { \"ok\": true, \"webhookUrl\": \"https://shop.example/digipay/webhook\", \"deliveryId\": \"wdel_...\", \"statusCode\": 200, \"error\": null }")</CodeBlock>
            <p class="@P">
                On your side, check the <InlineCode>X-DigiPay-Signature</InlineCode> header against an HMAC-SHA256 of the <em>raw</em> request body
                before you parse it. Reject anything that doesn't match with <InlineCode>401</InlineCode>:
            </p>
            <CodeBlock Lang="js" Label="Copy the Node verification example">@NodeVerify</CodeBlock>
            <p class="@P">
                That's a working integration. When a real payment lands you'll receive <InlineCode>session.seen</InlineCode>,
                <InlineCode>session.paid</InlineCode> and <InlineCode>session.confirmed</InlineCode> the same way.
                Python, PHP and C# versions are in the <a href="/docs/api#verify-signature" class="text-dgb-500 hover:underline">API reference</a>,
                and the <a href="/sdks" class="text-dgb-500 hover:underline">SDKs</a> ship a ready-made verifier.
            </p>

            @* ===================== Testing ===================== *@
            <DocsHeading Id="testing">Testing without real money</DocsHeading>
            <ul class="@Ul">
                <li><strong>Sandbox</strong> (step 4): see the checkout UI change state. No key, no webhooks.</li>
                <li><strong>Test webhook</strong> (step 5): check that your receiver is reachable and verifies signatures. Test events are sent once and never retried.</li>
                <li>
                    <strong>Testnet store</strong>: the full flow, webhooks included, with DigiByte testnet coins. Create a second store with
                    <InlineCode>POST /v1/pay/stores</InlineCode> and <InlineCode>{ "name": "Testnet", "network": "testnet" }</InlineCode>, give it a testnet
                    address or extended public key with <InlineCode>PATCH</InlineCode>, and pass its <InlineCode>storeId</InlineCode> when you create sessions.
                    DigiPay watches testnet for that store, so a testnet payment produces the same states and events as a real one.
                    Receive addresses are checked against the store's network.
                </li>
                <li><strong>A small real payment</strong>: the final check before you go live. You can record a refund afterwards (see <a href="/docs/api#refund-session">refunds</a>).</li>
            </ul>

            @* ===================== Guide ===================== *@
            <DocsHeading Id="lifecycle">How a payment flows</DocsHeading>
            <p class="@P">Each session moves through these states. Your webhook hears every change.</p>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead><tr><th scope="col">Status</th><th scope="col">Meaning</th><th scope="col">Checkout shows</th></tr></thead>
                    <tbody>
                        <tr><td><InlineCode>pending</InlineCode></td><td>Waiting for a payment.</td><td>Waiting</td></tr>
                        <tr><td><InlineCode>seen</InlineCode></td><td>A payment is in the mempool, not yet in a block.</td><td>Detected</td></tr>
                        <tr><td><InlineCode>paid</InlineCode></td><td>One confirmation (about 15 seconds on DigiByte). Safe to fulfil most orders.</td><td>Paid</td></tr>
                        <tr><td><InlineCode>confirmed</InlineCode></td><td>Six confirmations. Fully settled.</td><td>Confirmed</td></tr>
                        <tr><td><InlineCode>underpaid</InlineCode></td><td>Less than 99% of the amount arrived.</td><td>Underpaid</td></tr>
                        <tr><td><InlineCode>expired</InlineCode></td><td>Nothing arrived before <InlineCode>expiresAt</InlineCode> (30 minutes unless the store or request sets another).</td><td>Expired</td></tr>
                        <tr><td><InlineCode>refunded</InlineCode></td><td>You recorded a refund for a paid session.</td><td>Refunded</td></tr>
                        <tr><td><InlineCode>voided</InlineCode></td><td>You cancelled an unpaid session.</td><td>Cancelled</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="@P">
                The hosted checkout shows a QR code, an <em>Open in wallet</em> button, a countdown and a live status pill that updates as the
                transaction moves. DigiPay derives a fresh address for every invoice in xpub mode, so payments can't be linked to each other.
            </p>

            <DocsHeading Id="stores">Stores and receive addresses</DocsHeading>
            <p class="@P">An account owns one or more stores. Each store has its own receive address, webhook, default expiry and sessions, which suits several shops, a tip jar, or a separate testnet store.</p>
            <ul class="@Ul">
                <li><strong>Xpub (recommended).</strong> Paste your BIP84 account-level extended public key (<InlineCode>xpub6…</InlineCode>). DigiPay derives a new address for every invoice: no reuse.</li>
                <li><strong>Single address.</strong> Paste one <InlineCode>dgb1…</InlineCode>. Every invoice shares it, so your payment history is linked. Fine for a tip jar.</li>
            </ul>
            <p class="@P">In the DigiByte Wallet app, copy the xpub from <em>Settings → Share xpub (watch-only)</em>. It can watch payments; it can't spend them.</p>

            <DocsHeading Id="checkout">Hosted checkout and the embed</DocsHeading>
            <p class="@P">Redirect the buyer to <InlineCode>checkoutUrl</InlineCode>, or open the checkout over your own page with the JS embed (<a href="/embed/demo.html" target="_blank" class="text-dgb-500 hover:underline">live demo<span class="sr-only"> (opens in a new tab)</span></a>):</p>
            <CodeBlock Lang="html" Label="Copy the embed example">@("<script src=\"https://pay.dgbwallet.app/embed/digipay.js\"></script>\n<button data-digipay-checkout data-session-id=\"ses_...\">Pay with DigiByte</button>")</CodeBlock>
            <p class="@P">
                <strong>Match your shop's theme (optional).</strong> The checkout follows the shopper's own light or dark setting. To fix it, add
                <InlineCode>data-theme="light"</InlineCode> or <InlineCode>"dark"</InlineCode> to the button, pass <InlineCode>theme</InlineCode> to
                <InlineCode>DigiPay.checkout()</InlineCode>, or append <InlineCode>?theme=light</InlineCode> to <InlineCode>checkoutUrl</InlineCode>.
                Other values are ignored, and the shopper's own setting is never changed.
            </p>
            <CodeBlock Lang="html" Label="Copy the themed embed example">@("<button data-digipay-checkout data-session-id=\"ses_...\" data-theme=\"light\">Pay with DigiByte</button>\n<script>DigiPay.checkout({ sessionId: 'ses_...', theme: 'dark' });</script>\n<!-- or redirect to: https://pay.dgbwallet.app/pay/ses_...?theme=light -->")</CodeBlock>
            <p class="@P">
                The embedded checkout tells your page when the status changes, so you can update your UI (see
                <a href="/docs/api#embed" class="text-dgb-500 hover:underline">embed events</a>). Fulfil orders from the webhook, not from the browser.
                Pass <InlineCode>returnUrl</InlineCode> when you create the session and the checkout offers a <em>Return to merchant</em> button once payment confirms.
            </p>

            <DocsHeading Id="retries">Safe retries</DocsHeading>
            <p class="@P">
                Send an <InlineCode>Idempotency-Key</InlineCode> header on the create call (any string up to 255 characters; your order id is a natural fit).
                Calling again with the same key within 24 hours returns the <em>same</em> session, so a double-clicked <em>Buy</em> button never makes two invoices.
            </p>

            <DocsHeading Id="webhooks">Webhooks</DocsHeading>
            <p class="@P">
                Every state change sends a signed <InlineCode>POST</InlineCode> to the store's webhook URL. Events:
                <InlineCode>session.seen</InlineCode>, <InlineCode>session.paid</InlineCode>, <InlineCode>session.confirmed</InlineCode>,
                <InlineCode>session.underpaid</InlineCode>, <InlineCode>session.expired</InlineCode>, <InlineCode>session.refunded</InlineCode>,
                <InlineCode>session.voided</InlineCode>, and <InlineCode>webhook.test</InlineCode> when you ask for one.
                The <a href="/docs/api#webhook-events" class="text-dgb-500 hover:underline">events table</a> says exactly when each fires.
            </p>
            <ul class="@Ul">
                <li><InlineCode>X-DigiPay-Event</InlineCode>: the event name (also in the body as <InlineCode>event</InlineCode>).</li>
                <li><InlineCode>X-DigiPay-Signature</InlineCode>: <InlineCode>sha256=</InlineCode> followed by the hex HMAC-SHA256 of the raw body, keyed with the store's webhook secret.</li>
                <li><InlineCode>X-DigiPay-Delivery</InlineCode>: the id of this delivery attempt (<InlineCode>wdel_…</InlineCode>). Each retry or replay gets a new one, so use it for logging, not for de-duplication.</li>
            </ul>
            <p class="@P">
                <strong>Retries.</strong> If your server can't be reached, times out, or answers <InlineCode>5xx</InlineCode>, <InlineCode>408</InlineCode> or
                <InlineCode>429</InlineCode>, DigiPay tries again after 1 minute, 5 minutes, 30 minutes, 2 hours and 6 hours, then stops. Other
                <InlineCode>4xx</InlineCode> answers aren't retried. Every attempt appears in the dashboard's delivery log, where <em>Replay</em> sends it again.
            </p>
            <p class="@P">
                <strong>De-duplicate on the session.</strong> Retries and replays mean you can receive the same event more than once, and each one is rebuilt from
                the session's current state. Treat <InlineCode>session.id</InlineCode> plus <InlineCode>event</InlineCode> as the key, and let
                <InlineCode>session.status</InlineCode> decide what your order should look like. Answer <InlineCode>200</InlineCode> to events you don't use.
            </p>

            <DocsHeading Id="late-payments">Late payments</DocsHeading>
            <p class="@P">
                If a buyer pays after expiry, DigiPay still reconciles: it keeps watching expired sessions for three days. The session moves to
                <InlineCode>paid</InlineCode> or <InlineCode>confirmed</InlineCode> and the usual event fires, so your server needs no special case.
                If the payment already has six confirmations when DigiPay sees it, you get <InlineCode>session.confirmed</InlineCode> without a
                <InlineCode>session.paid</InlineCode> first.
            </p>

            <DocsHeading Id="donation-button">Donation button</DocsHeading>
            <p class="@P">
                A tip jar needs no server and no session. Link to DigiPay's hosted tip page with your address, or let the embed script draw the button.
                Only <InlineCode>to</InlineCode> is required; <InlineCode>amount</InlineCode> (DGB), <InlineCode>name</InlineCode> and <InlineCode>label</InlineCode> are optional.
            </p>
            <CodeBlock Lang="html" Label="Copy the donation link example">@("<a href=\"https://pay.dgbwallet.app/pay/button?to=dgb1q...&name=My%20Blog&label=Thanks!\">Tip in DGB</a>")</CodeBlock>
            <CodeBlock Lang="html" Label="Copy the donation button example">@("<script src=\"https://pay.dgbwallet.app/embed/digipay.js\"></script>\n<span data-digipay-button data-address=\"dgb1q...\" data-name=\"My Blog\" data-amount=\"5\">Tip DGB</span>")</CodeBlock>
            <p class="@P">
                The embed swaps the element for a button that opens the tip page in a new tab (add <InlineCode>data-theme</InlineCode> to fix its theme).
                Using an xpub store? <InlineCode>GET /v1/pay/stores/{id}/donation-address</InlineCode> returns a stable address reserved for donations,
                and the dashboard's <em>Donation</em> tab builds the snippet for you.
            </p>

            <DocsHeading Id="sdks">SDKs</DocsHeading>
            <p class="@P">On Node, Python or .NET, the <a href="/sdks" class="text-dgb-500 hover:underline">official SDKs</a> wrap all of the above (sessions, stores, webhook verification, deliveries, CSV export) behind a typed client, and raise one <InlineCode>DigiPayError</InlineCode> type with the HTTP status.</p>
            <ul class="space-y-1 leading-relaxed text-slate-700 dark:text-slate-300 list-disc pl-5 mb-3">
                <li><strong>Node</strong>: <InlineCode>npm install @("@dgbwallet/digipay")</InlineCode> (Node 18+, ESM and CJS)</li>
                <li><strong>Python</strong>: <InlineCode>pip install digipay</InlineCode> (Python 3.10+)</li>
                <li><strong>.NET</strong>: <InlineCode>dotnet add package DigiPay</InlineCode> (net8.0 and net9.0)</li>
            </ul>
            <p class="@P">Running WooCommerce? Use the <a href="/docs/woocommerce" class="text-dgb-500 hover:underline">WooCommerce plugin</a> instead of writing code.</p>

            <DocsHeading Id="pos">Selling in person</DocsHeading>
            <p class="@P">Taking DGB at a counter rather than on a website? The <a href="/docs/pos" class="text-dgb-500 hover:underline">POS guide</a> covers pairing a tablet, taking a payment, refunds, closing a shift and the audit trail.</p>

            <DocsHeading Id="next">Next</DocsHeading>
            <ol class="@Ol">
                <li>Read the <a href="/docs/api" class="text-dgb-500 hover:underline">API reference</a> for every endpoint and field.</li>
                <li>Pick an <a href="/sdks" class="text-dgb-500 hover:underline">SDK</a>, or clone a <a href="https://github.com/DennisPitallano/digibyte-wallet/tree/main/samples" target="_blank" rel="noopener" class="text-dgb-500 hover:underline">sample store<span class="sr-only"> (opens in a new tab)</span></a>.</li>
                <li><a href="/merchant/signin" class="text-dgb-500 hover:underline">Sign in</a> and create your first key.</li>
            </ol>
        </article>
    </DocsLayout>
</main>

@code {
    private static readonly DocsTocItem[] toc =
    [
        new("quickstart", "Quickstart — 5 minutes"),
        new("qs-key", "1. Get an API key", true),
        new("qs-receive", "2. Set a receive address", true),
        new("qs-session", "3. Create a session", true),
        new("qs-simulate", "4. Watch a checkout move", true),
        new("qs-webhook", "5. Verify a webhook", true),
        new("testing", "Testing without real money"),
        new("lifecycle", "How a payment flows"),
        new("stores", "Stores and receive addresses"),
        new("checkout", "Hosted checkout and the embed"),
        new("retries", "Safe retries"),
        new("webhooks", "Webhooks"),
        new("late-payments", "Late payments"),
        new("donation-button", "Donation button"),
        new("sdks", "SDKs"),
        new("pos", "Selling in person"),
        new("next", "Next"),
    ];

    /// <summary>Shared with the API reference: rejects a missing or wrong-length header before the constant-time compare.</summary>
    internal const string NodeVerify =
        "const crypto = require('crypto');\n" +
        "const express = require('express');\n" +
        "const app = express();\n\n" +
        "function verifyDigiPay(rawBody, header, secret) {\n" +
        "  if (typeof header !== 'string' || !header.startsWith('sha256=')) return false;\n" +
        "  const expected = Buffer.from(\n" +
        "    crypto.createHmac('sha256', secret).update(rawBody).digest('hex'));\n" +
        "  const provided = Buffer.from(header.slice('sha256='.length));\n" +
        "  // timingSafeEqual throws on different lengths, so check that first.\n" +
        "  return provided.length === expected.length &&\n" +
        "    crypto.timingSafeEqual(expected, provided);\n" +
        "}\n\n" +
        "app.post('/digipay/webhook', express.raw({ type: 'application/json' }), (req, res) => {\n" +
        "  const ok = verifyDigiPay(req.body, req.headers['x-digipay-signature'],\n" +
        "    process.env.DIGIPAY_WEBHOOK_SECRET);\n" +
        "  if (!ok) return res.status(401).end();\n" +
        "  const event = JSON.parse(req.body.toString('utf8'));\n" +
        "  // De-duplicate on event.session.id + event.event, then update the order.\n" +
        "  res.status(200).end();\n" +
        "});";
}
