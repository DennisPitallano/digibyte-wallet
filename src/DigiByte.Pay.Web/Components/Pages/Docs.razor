    /// <summary>Shared with the API reference: rejects a missing or wrong-length header before the constant-time compare.</summary>
    internal const string NodeVerify =
        "const crypto = require('crypto');\n" +
        "const express = require('express');\n" +
        "const app = express();\n\n" +
        "function verifyDigiPay(rawBody, header, secret) {\n" +
        "  if (typeof header !== 'string' || !header.startsWith('sha256=')) return false;\n" +
        "  const expected = Buffer.from(\n" +
        "    crypto.createHmac('sha256', secret).update(rawBody).digest('hex'));\n" +
        "  const provided = Buffer.from(header.slice('sha256='.length));\n" +
        "  // timingSafeEqual throws on different lengths, so check that first.\n" +
        "  return provided.length === expected.length &&\n" +
        "    crypto.timingSafeEqual(expected, provided);\n" +
        "}\n\n" +
        "app.post('/digipay/webhook', express.raw({ type: 'application/json' }), (req, res) => {\n" +
        "  const ok = verifyDigiPay(req.body, req.headers['x-digipay-signature'],\n" +
        "    process.env.DIGIPAY_WEBHOOK_SECRET);\n" +
        "  if (!ok) return res.status(401).end();\n" +
        "  const event = JSON.parse(req.body.toString('utf8'));\n" +
        "  // De-duplicate on event.session.id + event.event, then update the order.\n" +
        "  res.status(200).end();\n" +
        "});";
