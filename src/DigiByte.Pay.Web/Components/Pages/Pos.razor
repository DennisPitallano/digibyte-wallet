@page "/pos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHttpClientFactory HttpFactory
@inject PayApiUrl PayApi
@inject IJSRuntime JS
@inject LiveAnnouncer Announcer
@inject ILogger<Pos> Log
@using Microsoft.AspNetCore.SignalR.Client
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using DigiByte.Wallet.Models

<PageTitle>@(device?.StoreName is { Length: > 0 } s ? $"{s} — POS" : "DigiPay POS")</PageTitle>

@* Full-bleed kiosk shell. No nav, no chrome. Starts dark (so the tablet looks the same whatever the device's
   setting); the merchant can pick Light or Match my device per tablet in settings. Colours come from the --pos-*
   tokens in digipay-pos.css, set for both themes. The root stays put while <main> scrolls, so nothing is cut off on
   short (landscape phone) screens. Layout, keypad order, keypad side and the customer display are data attributes
   on this root, styled in digipay-pos.css, so every layout shares one set of markup. *@
<div class="dp-pos fixed inset-0 font-sans flex flex-col select-none touch-manipulation overflow-hidden"
     data-layout="@prefs.Layout" data-keypad="@prefs.Keypad" data-side="@prefs.Side" data-waiting="@prefs.Waiting"
     data-haptics="@(prefs.Haptics ? "on" : "off")" data-screen="@screen.ToString().ToLowerInvariant()"
     data-idle="@(IsIdle ? "true" : "false")">

    @if (screen == Screen.Pair)
    {
        <div class="flex-1 flex items-center justify-center p-6 dp-pos-main">
            <div class="dp-pos-pair w-full max-w-md flex flex-col gap-4">
                <header class="flex items-center gap-3 pb-2">
                    <img src="/digipay-logo.svg" alt="" class="w-10 h-10" />
                    <div>
                        <div class="text-lg font-extrabold tracking-tight">Digi<span class="text-dgb-500">Pay</span> POS</div>
                        <div class="dp-pos-muted dp-pos-small">Pair this device to start taking payments</div>
                    </div>
                </header>

                <div class="segmented">
                    <button type="button" class="segmented-item" aria-pressed="@(pairMode == "code" ? "true" : "false")"
                            @onclick="@(() => pairMode = "code")">Pairing code</button>
                    <button type="button" class="segmented-item" aria-pressed="@(pairMode == "key" ? "true" : "false")"
                            @onclick="@(() => pairMode = "key")">API key</button>
                </div>

                @if (pairMode == "code")
                {
                    <label for="pos-pair-code" class="section-label block">
                        Enter the 6-character code from your dashboard
                    </label>
                    <input id="pos-pair-code" @bind="pairCode" @bind:event="oninput" autocomplete="off" autocorrect="off" autocapitalize="characters" spellcheck="false"
                           maxlength="8" placeholder="AB2C9D" enterkeyhint="go"
                           @onkeydown="@(e => { if (e.Key == "Enter" && !busy && !string.IsNullOrWhiteSpace(pairCode)) _ = ClaimPairingAsync(); })"
                           class="input dp-pos-pair-code" />
                    <button class="btn-primary w-full" aria-busy="@(busy ? "true" : null)"
                            @onclick="ClaimPairingAsync" disabled="@(busy || string.IsNullOrWhiteSpace(pairCode))">
                        @(busy ? "Pairing…" : "Pair this device")
                    </button>
                }
                else
                {
                    <label for="pos-pair-key" class="section-label block">
                        Paste an API key (dgp_…)
                    </label>
                    <input id="pos-pair-key" @bind="manualApiKey" @bind:event="oninput" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                           @onkeydown="@(e => { if (e.Key == "Enter" && !busy && !string.IsNullOrWhiteSpace(manualApiKey)) _ = ApplyManualKeyAsync(); })"
                           placeholder="dgp_xxxx_xxxxxxxx…" class="input font-mono" />
                    <label for="pos-pair-store" class="section-label block">
                        Store ID (optional — leave blank to use default store)
                    </label>
                    <input id="pos-pair-store" @bind="manualStoreId" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                           placeholder="sto_…" class="input font-mono" />
                    <button class="btn-primary w-full" aria-busy="@(busy ? "true" : null)"
                            @onclick="ApplyManualKeyAsync" disabled="@(busy || string.IsNullOrWhiteSpace(manualApiKey))">
                        @(busy ? "Checking…" : "Use this key")
                    </button>
                }

                @if (pairError != null)
                {
                    <p class="dp-pos-error text-center" role="alert">@pairError</p>
                }

                <p class="dp-pos-muted dp-pos-small text-center mt-2">
                    Tip: add this page to your home screen for a full-screen experience.
                </p>
            </div>
        </div>
    }
    else
    {
        @* Top bar: who this till belongs to, whether it is live, and one menu for everything else, so the keypad
           and QR dominate the screen. *@
        <header class="dp-pos-bar">
            <div class="dp-pos-store">
                <span class="dp-pos-avatar" aria-hidden="true">@StoreInitial</span>
                <div class="dp-pos-store-text">
                    <div class="dp-pos-store-name">@(device?.StoreName ?? "Store")</div>
                    @if (!string.IsNullOrWhiteSpace(device?.MerchantName))
                    {
                        <div class="dp-pos-store-sub">@device!.MerchantName</div>
                    }
                </div>
            </div>
            <div class="dp-pos-bar-actions">
                <span class="dp-pos-conn is-@ConnectionTone" title="@ConnectionHint">
                    <span class="dp-pos-conn-dot" aria-hidden="true"></span>
                    <span><span class="sr-only">Connection: </span>@ConnectionLabel</span>
                </span>
                <button type="button" class="icon-btn dp-pos-menu-btn" @onclick="OpenMenu"
                        aria-label="Till menu" aria-haspopup="dialog" aria-expanded="@(showMenu ? "true" : "false")">
                    <Icon Name="menu" Class="w-5 h-5" />
                </button>
            </div>
        </header>

        @* A late payment on an expired sale (InvoiceMonitor keeps reconciling them for days). The
           till keeps watching expired sales for a while so the cashier finds out. *@
        @if (latePaymentNotice is not null)
        {
            <div class="dp-pos-late ui-banner ui-banner-warning" role="alert">
                <Icon Name="zap" Class="" />
                <p>@latePaymentNotice</p>
                <button type="button" class="dp-pos-late-close" @onclick="DismissLateNotice" aria-label="Dismiss late payment notice">
                    <Icon Name="close" Class="w-4 h-4" />
                </button>
            </div>
        }

        @if (screen == Screen.Keypad)
        {
            var readout = Readout();
            <main id="main" class="dp-pos-main dp-pos-keypad">

                @* Amount panel: what the customer will be asked for. *@
                <section class="dp-pos-readout" aria-label="Sale amount">
                    <div class="dp-pos-readout-top">
                        @* Currency: opens the wallet's currency picker. The amount is kept when it fits the new
                           currency; otherwise the till asks before clearing it. *@
                        <button type="button" class="dp-pos-currency" @onclick="OpenCurrencyPicker"
                                aria-label="@($"Currency: {currency}, change")" aria-haspopup="dialog">
                            <CurrencyFlag Code="@currency" />
                            <span>@currency</span>
                            <Icon Name="chevron-down" Class="w-4 h-4" />
                        </button>
                        @if (amount.Length > 0)
                        {
                            <button type="button" class="dp-pos-clear" @onclick="ClearAmount">
                                <Icon Name="close" Class="w-4 h-4" />
                                <span>Clear</span>
                            </button>
                        }
                    </div>

                    <div class="dp-pos-caption">@(tipPercent > 0 ? "Total with tip" : "Amount")</div>
                    <div class="dp-pos-amount tabular-nums @PosEntry.SizeClass(readout.Symbol + readout.Number + readout.Unit) @(readout.Empty ? "is-empty" : "")"
                         aria-live="polite" aria-atomic="true">
                        @if (readout.Symbol.Length > 0)
                        {
                            <span class="dp-pos-sym @(PosEntry.SymbolIsWord(currency) ? "is-word" : "")">@readout.Symbol</span>
                        }
                        <span class="dp-pos-num">@readout.Number</span>
                        @if (readout.Unit.Length > 0)
                        {
                            <span class="dp-pos-unit">@readout.Unit</span>
                        }
                    </div>

                    @if (tipPercent > 0 && SubtotalDecimal is decimal subTotal)
                    {
                        @* The tip folds into the charged amount; this shows how the total was built. *@
                        <div class="dp-pos-breakdown tabular-nums">
                            @PosEntry.Money(subTotal, currency) + @PosEntry.Money(TipDecimal, currency) tip (@tipPercent%)
                        </div>
                    }

                    @if (IsFiat)
                    {
                        <div class="dp-pos-quote">
                            @if (quote is { } q)
                            {
                                @if (DgbEquivalent is decimal d)
                                {
                                    <div class="dp-pos-equiv tabular-nums">≈ @PosEntry.FormatDgb(d) <span class="dp-pos-unit">DGB</span></div>
                                }
                                <div class="dp-pos-rate">
                                    <span class="tabular-nums">1 DGB = @Fiat.Rate(q.DgbPrice, currency)</span>
                                    @if (q.Source == "coingecko+fx")
                                    {
                                        <span class="dp-pos-rate-via">via USD</span>
                                    }
                                    <span class="dp-pos-rate-age">updated @PosEntry.Ago(QuoteAge)</span>
                                </div>
                                @if (QuoteIsStale)
                                {
                                    <p class="dp-pos-note is-amber" role="status">
                                        <Icon Name="clock" Class="w-4 h-4" />
                                        <span>Last known price, @PosEntry.Ago(QuoteAge)</span>
                                    </p>
                                }
                            }
                            else if (priceFailed)
                            {
                                <div class="dp-pos-noprice" role="alert">
                                    <p>No DGB price for @currency right now, so this till can't charge in @currency. Try again, or switch to DGB.</p>
                                    <button type="button" class="btn-secondary btn-sm dp-pos-retry" @onclick="RetryPriceAsync" disabled="@priceLoading"
                                            aria-busy="@(priceLoading ? "true" : null)">
                                        <Icon Name="refresh" Class="w-4 h-4" />
                                        <span>@(priceLoading ? "Retrying…" : "Retry")</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="dp-pos-rate">Fetching price…</div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(labelInput))
                    {
                        <div class="dp-pos-label-preview">@labelInput</div>
                    }
                </section>

                @* Keypad. A hardware keyboard works too: digits, ".", Backspace, Delete to clear and Enter to charge
                   (pos-store.js, only while no text field has focus). *@
                <section class="dp-pos-pad" aria-label="Keypad">
                    <label for="pos-sale-label" class="sr-only">Sale label (optional)</label>
                    <input id="pos-sale-label" @bind="labelInput" @bind:event="oninput" maxlength="60" placeholder="Label (optional — e.g. Order #42)"
                           class="input dp-pos-label-input" />

                    @if (prefs.QuickAmountsFor(currency) is { Count: > 0 } quick)
                    {
                        <div class="dp-pos-quick" role="group" aria-label="Quick amounts">
                            @foreach (var qa in quick)
                            {
                                var value = qa;
                                <button type="button" class="dp-pos-quick-btn tabular-nums" @onclick="() => UseQuickAmount(value)">
                                    @PosEntry.Money(value, currency)
                                </button>
                            }
                        </div>
                    }

                    <div class="dp-pos-keys @(BottomRow.Length == 4 ? "has-wide-bottom" : "")">
                        @foreach (var k in Keys)
                        {
                            var key = k;
                            var bottom = BottomRow.Contains(key);
                            @if (key == "back")
                            {
                                <button type="button" class="dp-pos-key is-alt is-bottom" data-pos-haptic
                                        aria-label="Delete last digit (hold to clear)"
                                        @onclick="() => PressKey(key)"
                                        @onpointerdown="BackDown" @onpointerup="BackUp" @onpointerleave="BackUp" @onpointercancel="BackUp">
                                    <Icon Name="backspace" Class="w-7 h-7" />
                                </button>
                            }
                            else
                            {
                                <button type="button" class="dp-pos-key tabular-nums @(key is "." or "00" ? "is-alt" : "") @(bottom ? "is-bottom" : "")" data-pos-haptic
                                        aria-label="@(key == "." ? "Decimal point" : key == "00" ? "Double zero" : null)"
                                        disabled="@(key == "." && MaxDecimals == 0)"
                                        @onclick="() => PressKey(key)">@key</button>
                            }
                        }
                    </div>

                    @* Tip: only once there is an amount, so the quick no-tip sale stays uncluttered. *@
                    @if (HasAmount)
                    {
                        <div class="segmented dp-pos-tips" role="group" aria-label="Tip">
                            @foreach (var pct in TipPresets)
                            {
                                var p = pct;
                                <button type="button" class="segmented-item dp-pos-tip"
                                        aria-pressed="@(tipPercent == p ? "true" : "false")"
                                        @onclick="() => SetTip(p)">@(p == 0 ? "No tip" : $"{p}%")</button>
                            }
                        </div>
                    }

                    @if (IsDd && TotalDecimal is decimal ddTotal && !PosEntry.DdInRange(ddTotal))
                    {
                        <p class="dp-pos-note is-amber" role="status" data-dd-range>
                            DigiDollar amounts must be from @PosEntry.Money(PosEntry.DdMin, PosEntry.Dd) to @PosEntry.Money(PosEntry.DdMax, PosEntry.Dd).
                        </p>
                    }
                    <button type="button" class="dp-pos-charge" @onclick="ChargeAsync" disabled="@(!CanCharge)"
                            aria-busy="@(busy ? "true" : null)">
                        <span class="dp-pos-charge-main tabular-nums">@ChargeLabel</span>
                        @if (!busy && IsFiat && HasAmount && DgbEquivalent is decimal dgbSub)
                        {
                            <span class="dp-pos-charge-sub tabular-nums">≈ @PosEntry.FormatDgb(dgbSub) DGB</span>
                        }
                    </button>
                    @if (chargeError != null)
                    {
                        <p class="dp-pos-error text-center" role="alert">@chargeError</p>
                    }
                    @if (ddFallbackOffered && IsDd && TotalDecimal is decimal fallbackUsd)
                    {
                        @* DD couldn't be charged (turned off, say): the same dollar amount, priced in USD and paid in DGB, in one tap (FR-014). *@
                        <button type="button" class="btn-secondary w-full" data-dd-fallback @onclick="ChargeInDgbInsteadAsync" disabled="@busy">
                            Charge @Fiat.Format(fallbackUsd, "USD") in DGB instead
                        </button>
                    }
                    @if (ddNotice != null)
                    {
                        <p class="dp-pos-note is-amber text-center" role="status" data-dd-notice>@ddNotice</p>
                    }
                </section>
            </main>
        }
        else if (screen == Screen.Waiting && session != null)
        {
            var confirming = CheckoutStates.IsConfirming(session.Status);
            var hasFiat = session.FiatAmount is decimal && !string.IsNullOrEmpty(session.FiatCurrency) && !IsDdSession(session);
            <main id="main" class="dp-pos-main dp-pos-waiting">

                @* Customer-facing: what to pay, the code to scan, how long the price holds. *@
                <section class="dp-pos-customer" aria-label="Payment for the customer">
                    <div class="dp-pos-due">
                        <div class="dp-pos-caption">Amount due</div>
                        @if (hasFiat)
                        {
                            @* Fiat-quoted sale: the number the cashier rang up, with the DGB the wallet will show under it. *@
                            var fiatText = Fiat.Format(session.FiatAmount!.Value, session.FiatCurrency);
                            <div class="dp-pos-amount dp-pos-amount-due tabular-nums @PosEntry.SizeClass(fiatText)">@fiatText</div>
                            <div class="dp-pos-equiv tabular-nums">≈ @PosEntry.FormatDgb(session.AmountSatoshis) <span class="dp-pos-unit">DGB</span></div>
                        }
                        else if (IsDdSession(session))
                        {
                            @* DigiDollar sale: dollars, 1 DD = $1, no conversion and no price that can drift. *@
                            var ddText = PosEntry.FormatDd((session.AmountCentsDd ?? 0) / 100m);
                            <div class="dp-pos-amount dp-pos-amount-due tabular-nums @PosEntry.SizeClass(ddText + " DD")" data-dd-due>
                                <span class="dp-pos-num">@ddText</span> <span class="dp-pos-unit">DD</span>
                            </div>
                        }
                        else
                        {
                            var dgbText = PosEntry.FormatDgb(session.AmountSatoshis);
                            <div class="dp-pos-amount dp-pos-amount-due tabular-nums @PosEntry.SizeClass(dgbText + " DGB")">
                                <span class="dp-pos-num">@dgbText</span> <span class="dp-pos-unit">DGB</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.Label))
                        {
                            <div class="dp-pos-label-preview">@session.Label</div>
                        }
                    </div>

                    @if (ShowPosSwitch)
                    {
                        @* specs/033 US3: one tap switches the code between DGB and DigiDollar until the customer pays. *@
                        <div class="segmented w-fit self-center" role="group" aria-label="Customer pays with" data-pay-switch>
                            <button type="button" class="segmented-item" aria-pressed="@(posView == "DGB" ? "true" : "false")"
                                    disabled="@posSwitching" @onclick='() => SwitchPosToAsync("DGB")'>DGB</button>
                            <button type="button" class="segmented-item" aria-pressed="@(posView == "DD" ? "true" : "false")"
                                    disabled="@posSwitching" @onclick='() => SwitchPosToAsync("DD")'>DigiDollar</button>
                        </div>
                    }
                    @if (posSwitchError != null)
                    {
                        <p class="dp-pos-note is-amber text-center" role="status" data-switch-message>@posSwitchError</p>
                    }
                    <div class="dp-pos-pay">
                        @if (confirming)
                        {
                            @* Paid: the customer is done, so stop showing a code to pay and show how close the
                               payment is to final instead (same component as the hosted checkout). *@
                            <div class="dp-pos-confirm">
                                <ConfirmationProgress Status="@session.Status" Confirmations="@session.Confirmations"
                                                      Txid="@session.PaidTxid" Currency="@session.Currency" />
                            </div>
                        }
                        else
                        {
                            <div class="qr-frame dp-pos-qr-frame">
                                <img src="@qrDataUrl" alt="Scan to pay" class="dp-pos-qr" />
                                <span class="qr-frame-logo"><img src="/digibyte-logo.svg" alt="" width="32" height="32" class="dp-pos-qr-logo" /></span>
                            </div>
                        }
                    </div>

                    @if (!confirming)
                    {
                        <div class="dp-pos-scan">
                            <p class="dp-pos-scan-hint">@(IsDdSession(session) ? "Scan with a DigiByte wallet that holds DigiDollar" : "Scan with any DigiByte wallet")</p>
                            @* checkout-countdown.js replaces the whole line once the window closes, so it never
                               reads "Expires in expired". *@
                            <p class="dp-pos-countdown" data-digipay-countdown="This price has expired.">
                                <Icon Name="clock" Class="w-4 h-4" />
                                <span>Expires in <span class="tabular-nums" data-digipay-expires="@session.ExpiresAt.ToString("o", CultureInfo.InvariantCulture)">—</span></span>
                            </p>
                            <p class="dp-pos-address font-mono">@session.Address</p>
                        </div>
                    }
                </section>

                @* Cashier controls, kept secondary. *@
                <aside class="dp-pos-cashier" aria-label="Cashier">
                    @if (reconnecting)
                    {
                        <div class="ui-banner ui-banner-info dp-pos-cashier-banner" role="status">
                            <Icon Name="refresh" Class="" />
                            <p>Reconnecting… payment is still being watched.</p>
                        </div>
                    }
                    <StatusBadge Status="@session.Status" Class="dp-pos-status" />
                    @* Cancelling voids the session on the server, so the customer can no longer pay it.
                       Not offered once the payment is in a block. *@
                    @if (CanCancelSale)
                    {
                        <button type="button" class="btn-secondary btn-sm dp-pos-cancel" aria-busy="@(cancelling ? "true" : null)"
                                @onclick="RequestCancelSale" disabled="@cancelling">
                            @(cancelling ? "Cancelling…" : "Cancel sale")
                        </button>
                    }
                    @if (cancelError != null)
                    {
                        <p class="dp-pos-error dp-pos-cashier-error" role="alert">@cancelError</p>
                    }
                </aside>
            </main>
        }
        else if (screen == Screen.Result && session != null)
        {
            var state = CheckoutStates.For(resultStatus);
            var success = resultStatus == "confirmed";
            var hasFiat = session.FiatAmount is decimal && !string.IsNullOrEmpty(session.FiatCurrency);
            const double circumference = 2 * Math.PI * 52;
            var ring = circumference.ToString("0.##", CultureInfo.InvariantCulture);
            <main id="main" class="dp-pos-main dp-pos-result-main">
                <div class="dp-pos-result">
                    @* Same seal and ring as the checkout's final state (TerminalState). *@
                    @if (success)
                    {
                        <div class="ui-confirm-ring ui-terminal-ring dp-pos-ring" aria-hidden="true">
                            <svg viewBox="0 0 120 120" width="120" height="120">
                                <circle class="ui-confirm-ring-track" cx="60" cy="60" r="52" />
                                <circle class="ui-confirm-ring-fill ui-terminal-ring-draw" cx="60" cy="60" r="52"
                                        stroke-dasharray="@ring" style="--ui-ring-length: @ring" />
                            </svg>
                            <span class="ui-confirm-ring-center"><Icon Name="check" Class="ui-terminal-check" /></span>
                        </div>
                    }
                    else
                    {
                        <span class="ui-receipt-seal dp-pos-seal @SealClass(state.Tone)" aria-hidden="true"><Icon Name="@state.Icon" Class="w-10 h-10" /></span>
                    }
                    <div>
                        <h2 class="dp-pos-result-title">@state.Heading</h2>
                        <p class="dp-pos-muted dp-pos-result-text">@CashierExplanation(resultStatus)</p>
                    </div>
                    @if (success)
                    {
                        var received = session.ReceivedSatoshis > 0 ? session.ReceivedSatoshis : session.AmountSatoshis;
                        @* Fiat sale: the number the cashier rang up first, the DGB that arrived under it. *@
                        @if (hasFiat)
                        {
                            <div>
                                <div class="dp-pos-result-amount tabular-nums">@Fiat.Format(session.FiatAmount!.Value, session.FiatCurrency)</div>
                                <div class="dp-pos-equiv tabular-nums">@PosEntry.FormatDgb(received) DGB</div>
                            </div>
                        }
                        else if (IsDdSession(session))
                        {
                            <div class="dp-pos-result-amount tabular-nums" data-dd-result>@PosEntry.FormatDdCents(session.ReceivedSatoshis > 0 ? session.ReceivedSatoshis : session.AmountCentsDd ?? 0)</div>
                        }
                        else
                        {
                            <div class="dp-pos-result-amount tabular-nums">@PosEntry.FormatDgb(received) <span class="dp-pos-unit">DGB</span></div>
                        }
                        <p class="ui-terminal-final dp-pos-final">
                            <span class="ui-receipt-dots" aria-hidden="true">
                                @for (var i = 0; i < CheckoutStates.ConfirmationsRequired; i++)
                                {
                                    <span class="is-done"></span>
                                }
                            </span>
                            <span>@CheckoutStates.ConfirmationsRequired of @CheckoutStates.ConfirmationsRequired confirmations · Final</span>
                        </p>
                    }
                    @if (resultStatus == "underpaid")
                    {
                        <dl class="ui-terminal-amounts">
                            <div><dt>Received</dt><dd class="font-mono tabular-nums">@SessionAmount(session, session.ReceivedSatoshis)</dd></div>
                            <div>
                                <dt>Expected</dt>
                                <dd class="font-mono tabular-nums">@SessionAmount(session, ExpectedAmount(session))</dd>
                                @if (hasFiat)
                                {
                                    <dd class="dp-pos-dd-sub tabular-nums">@Fiat.Format(session.FiatAmount!.Value, session.FiatCurrency)</dd>
                                }
                            </div>
                        </dl>
                    }
                    @if (!string.IsNullOrEmpty(session.PaidTxid))
                    {
                        <div class="dp-pos-txid font-mono">@session.PaidTxid</div>
                    }
                    <div class="dp-pos-result-actions">
                        @if (CanChargeAgain)
                        {
                            <button type="button" class="btn-secondary dp-pos-again" aria-busy="@(busy ? "true" : null)"
                                    @onclick="ChargeAgainAsync" disabled="@busy">
                                <Icon Name="refresh" Class="w-5 h-5" />
                                <span>@(busy ? "Creating…" : "Charge again")</span>
                            </button>
                        }
                        <button type="button" class="btn-primary dp-pos-new" @onclick="NewSale">New sale</button>
                    </div>
                    @if (success)
                    {
                        <p class="dp-pos-muted dp-pos-small">Auto-returning in @autoReturnSeconds…</p>
                    }
                </div>
            </main>
        }
    }

