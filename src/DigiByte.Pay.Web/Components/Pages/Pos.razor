    public record PairedDevice(
        [property: JsonPropertyName("apiKey")] string ApiKey,
        [property: JsonPropertyName("storeId")] string StoreId,
        [property: JsonPropertyName("storeName")] string StoreName,
        [property: JsonPropertyName("merchantName")] string MerchantName,
        [property: JsonPropertyName("deviceLabel")] string DeviceLabel);

    public record ClaimResponse(
        string ApiKey, string Prefix, string MerchantId, string MerchantName,
        string StoreId, string StoreName, string DeviceLabel);

    public record MeStoreDto(string Id, string Name, string? DefaultCurrency = null,
        bool DigiDollarEnabled = false, string? DefaultCurrencyEffective = null, bool BuyerChoiceEnabled = true);

    // GET /v1/pay/stores/{id}: only what the till needs from the store.
    private sealed record StoreDefaultsDto(string Id, string? DefaultCurrency = null,
        bool DigiDollarEnabled = false, string? DefaultCurrencyEffective = null, bool BuyerChoiceEnabled = true);
    public record MeResponse(string Id, string DisplayName, List<MeStoreDto> Stores, bool DdSurfacesEnabled = false);

    public record CreatedSession(
        string Id, string Address, long AmountSatoshis, decimal Amount,
        string? FiatCurrency, decimal? FiatAmount, string? Label, string? Memo,
        string Status, DateTime CreatedAt, DateTime ExpiresAt,
        long ReceivedSatoshis, int Confirmations, string? PaidTxid,
        string Uri, string CheckoutUrl,
        string Currency = "DGB", long? AmountCentsDd = null,
        bool BuyerChoice = false, DateTime? LockedAt = null, List<SessionOptionDto>? Options = null);

    public record SessionOptionDto(string Currency, string Address, long AmountSatoshis, long? AmountCentsDd, decimal? UsdRate, DateTime? RateAt, string Uri);

    public record StatusUpdate(string SessionId, string Status, long ReceivedSatoshis, int Confirmations, string? Txid,
        string? Currency = null, DateTime? LockedAt = null, long? AmountCentsDd = null);

    // GET /v1/pay/sessions/{id}: the fields the till needs to follow a sale.
    public record SessionEnvelope(CreatedSession Session);
    public record SessionStatusDto(string Id, string Status, long ReceivedSatoshis, int Confirmations, string? PaidTxid);

    // GET /v1/pay/public/price: the price of 1 DGB in the currency, when it was fetched upstream, and how
    // ("coingecko" directly, or "coingecko+fx" through the USD price and an exchange rate).
    public record PriceQuote(
        [property: JsonPropertyName("currency")] string Currency,
        [property: JsonPropertyName("dgbPrice")] decimal DgbPrice,
        [property: JsonPropertyName("fetchedAt")] DateTime FetchedAt,
        [property: JsonPropertyName("source")] string? Source = null,
        [property: JsonPropertyName("decimals")] int? Decimals = null,
        [property: JsonPropertyName("symbol")] string? Symbol = null,
        [property: JsonPropertyName("stale")] bool Stale = false);

    // /v1/pay/pos/shift-report payload, flattened to what the dialog needs. Fiat/Tips are keyed by currency code.
