@* A switch the typed amount can't survive (too many decimals for the new currency): ask before clearing it. *@
<ConfirmDialog Open="@(pendingCurrency is not null)" Title="@($"Switch to {pendingCurrency}?")" Danger="false"
               ConfirmLabel="Clear and switch" CancelLabel="@($"Keep {currency}")"
               OnConfirm="ConfirmCurrencySwitchAsync" OnCancel="() => pendingCurrency = null">
    @PendingSwitchText
</ConfirmDialog>

@* Cancelling a sale whose payment is already on its way needs a second look: the money may still
   arrive, and the session can no longer be paid once it is voided. *@
<ConfirmDialog Open="@confirmCancelSeen" Title="Cancel this sale?" ConfirmLabel="Cancel sale" CancelLabel="Keep waiting"
               Busy="@cancelling" OnConfirm="CancelSaleAsync" OnCancel="() => confirmCancelSeen = false">
    A payment for this sale has already been detected. If you cancel, the sale is voided; any money that still arrives has to be refunded from the dashboard.
</ConfirmDialog>
</div>

@code {
    private enum Screen { Pair, Keypad, Waiting, Result }

    private static readonly string[][] PhoneRows = [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]];
    private static readonly string[][] CalculatorRows = [["7", "8", "9"], ["4", "5", "6"], ["1", "2", "3"]];

    private Screen screen = Screen.Pair;
    private string pairMode = "code";
    private string pairCode = "";

    /// <summary>Nothing in progress: the keypad with no amount, no dialog, nothing being created. pos-store.js only
    /// reloads the till for a new version while this is true (the data-idle attribute on the root).</summary>
    private bool IsIdle => screen == Screen.Keypad && string.IsNullOrEmpty(amount) && !AnyDialogOpen && !busy;
    private string manualApiKey = "";
    private string manualStoreId = "";
    private string? pairError;

    private PairedDevice? device;
    private bool busy;

    // Keypad state — the amount is kept as typed so "10." shows the cashier is about to type decimals.
    private string amount = "";
    private string labelInput = "";
    private string? chargeError;

    // Display settings for this tablet (pos-store.js).
    private PosPrefs prefs = new();
    private string quickAmountsText = "";

    // Till currency: "DGB" (the cashier types DGB, 8 decimals) or any wallet currency (typed in that currency with its
    // own decimals and converted at the live price). Remembered per tablet, with the last four as "Recent".
    private string currency = PosEntry.Dgb;
    // True once this tablet has a till currency of its own (saved earlier, or picked now); until then the till
    // follows the store's default currency.
    private bool currencyChosenHere;
    private List<string> recentCurrencies = new();
    private bool showCurrencyPicker;
    private string? pendingCurrency;    // a switch waiting for "Clear and switch"

    // Price quote for the till currency (GET /v1/pay/public/price). Refreshed every minute while in fiat, and again
    // just before charging when the one on screen is over a minute old.
    private static readonly TimeSpan QuoteRefreshEvery = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan QuoteStaleAfter = TimeSpan.FromMinutes(10);
    private PriceQuote? quote;
    private DateTime quoteLoadedAt;
    private DateTime lastPriceAttempt;
    private bool priceLoading;
    private bool priceFailed;
    private System.Threading.Timer? tickTimer;

    // Connection: false after a request to DigiPay failed outright, or the browser reported it is offline.
    private bool apiReachable = true;

    // Long-press on backspace clears the amount.
    private CancellationTokenSource? holdCts;

    // The sale on screen (waiting or result). Kept on the result screen so "Charge again", the
    // fiat amount and the underpaid figures can be shown, and so a late payment can revive it.
    private CreatedSession? session;
    private string? qrDataUrl;

    // Live updates. One hub connection for the page; every watched session (the current sale and
    // recently expired ones) is subscribed on it. A dropped connection never shows a final state:
    // the page says "Reconnecting…" and polls over HTTP until live updates are back (as Checkout).
    private HubConnection? hub;
    private readonly CancellationTokenSource lifetime = new();
    private Task? pollLoop;
    private bool reconnecting;
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(10);
    private string? lastAnnouncedStatus;
    private int lastAnnouncedConfirmations;

    // Expired sales the till keeps an eye on. The server still reconciles a payment that lands
    // after expiry (InvoiceMonitor, days of grace); the till only needs to know for a while.
    private static readonly TimeSpan LatePaymentWatch = TimeSpan.FromMinutes(30);
    private readonly List<LateWatch> lateWatches = new();
    private string? latePaymentNotice;
    private sealed record LateWatch(string SessionId, string Description, DateTime Until);

    private bool cancelling;
    private bool confirmCancelSeen;
    private string? cancelError;

    private string? resultStatus;
    private int autoReturnSeconds = 5;
    private CancellationTokenSource? autoReturnCts;

    private DotNetObjectReference<Pos>? selfRef;
    private string? jsDialogId;
    private bool keysBound;

    private bool showMenu;
    private bool showUnpair;

    // Shift report: null while loading. The shift start is per tablet (pos-store.js).
    private bool showShiftReport;
    private ShiftReport? shiftReport;
    private string? shiftReportError;

    // Settings and manager PIN.
    private bool showSettings;
    private bool hasPin;
    private bool pinFormOpen;
    private bool showPinChallenge;
    private string pinNew = "";
    private string pinConfirm = "";
    private string pinEntered = "";
    private string? pinSettingsError;
    private string? pinChallengeError;
    private string pinChallengePrompt = "";
    private Func<Task>? pinChallengePending;

    private bool CanSavePin =>
        !string.IsNullOrEmpty(pinNew)
        && pinNew.Length >= 4 && pinNew.Length <= 8
        && pinNew.All(char.IsDigit)
        && pinNew == pinConfirm;

    // A fiat till prices in its currency and charges DGB at the live price; DGB and DD are charged as typed.
    private bool IsFiat => !PosEntry.IsCoin(currency);

    private bool IsDd => PosEntry.IsDd(currency);

    // specs/033 US1: DD is offered on the till only when the store has DigiDollar on and the server's DD surfaces switch
    // is on (FR-001, FR-032). Read from GET /v1/pay/me with the tablet key.
    private bool ddAvailable;
    private string? ddNotice;
    // Shown after a failed DD charge: charge the same dollars in DGB in one tap (FR-014).
    private bool ddFallbackOffered;
    // Idempotency-Key for the charge being created; reused when the same request is retried after a network error.
    private string? chargeKey;
    private string? chargeKeyFor;

    private string PickerHint => ddAvailable
        ? "The amount you type is in this currency. DGB and DD (1 DD = $1) are charged as typed; anything else is converted to DGB at the live price."
        : "The amount you type is in this currency. Anything other than DGB is converted at the live price when you charge.";

    private string PendingSwitchText => PosEntry.IsDd(pendingCurrency)
        ? $"{amount} {currency} isn't converted to DD: only a USD amount carries over. Switching clears the amount."
        : $"{amount} {currency} doesn't fit {pendingCurrency} ({(PosEntry.DecimalsFor(pendingCurrency) == 0 ? "no decimals" : $"{PosEntry.DecimalsFor(pendingCurrency)} decimals")}). Switching clears the amount.";

    private static bool IsDdSession(CreatedSession s) => PosEntry.IsDd(s.Currency);

    // specs/033 US3: a fiat sale can be paid in DGB or DD. posActual is the payment as the API returned it; session is
    // what the screen shows, in the currency the customer switched to (posView) until funds lock it.
    private CreatedSession? posActual;
    private string posView = PosEntry.Dgb;
    private bool posSwitching;
    private string? posSwitchError;

    private bool ShowPosSwitch => ddAvailable && posActual is { BuyerChoice: true, LockedAt: null, Status: "pending" };

    private void AdoptSession(CreatedSession s)
    {
        posActual = s;
        if (s.LockedAt is not null || !s.BuyerChoice) posView = s.Currency;
        else if (posView != s.Currency && s.Options?.Any(o => o.Currency == posView) != true) posView = s.Currency;
        ProjectSession();
    }

    private void ProjectSession()
    {
        if (posActual is null) return;
        var shown = posActual;
        if (posActual is { BuyerChoice: true, LockedAt: null } && posActual.Options?.FirstOrDefault(o => o.Currency == posView) is { } o)
            shown = posActual with { Currency = o.Currency, Address = o.Address, AmountSatoshis = o.AmountSatoshis, AmountCentsDd = o.AmountCentsDd, Uri = o.Uri };
        var uriChanged = session?.Uri != shown.Uri;
        session = shown;
        if (uriChanged) qrDataUrl = GenerateQr(shown.Uri);
    }

    private async Task SwitchPosToAsync(string currency)
    {
        if (posActual is null || device is null || currency == posView || posSwitching) return;
        posSwitchError = null;
        if (currency == PosEntry.Dd && posActual.Options?.Any(o => o.Currency == PosEntry.Dd) != true)
        {
            posSwitching = true;
            try
            {
                var http = HttpFactory.CreateClient("PayApi");
                using var req = new HttpRequestMessage(HttpMethod.Post, $"/v1/pay/sessions/{Uri.EscapeDataString(posActual.Id)}/options/dd");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
                using var resp = await http.SendAsync(req, lifetime.Token);
                if (!resp.IsSuccessStatusCode) { posSwitchError = await ApiError.ReadAsync(resp); return; }
                var option = await resp.Content.ReadFromJsonAsync<SessionOptionDto>(lifetime.Token);
                if (option is null) return;
                posActual = posActual with { Options = [.. posActual.Options ?? [], option] };
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex)
            {
                Log.LogInformation(ex, "POS could not switch the sale to DD");
                posSwitchError = "DigiDollar isn't available for this payment right now.";
                return;
            }
            finally { posSwitching = false; }
        }
        posView = currency;
        ProjectSession();
    }

    private static long ExpectedAmount(CreatedSession s) => IsDdSession(s) ? s.AmountCentsDd ?? 0 : s.AmountSatoshis;

    // A session amount with its unit: DD from cents, DGB from satoshis.
    private static string SessionAmount(CreatedSession s, long amount) =>
        IsDdSession(s) ? PosEntry.FormatDdCents(amount) : $"{PosEntry.FormatDgb(amount)} DGB";

    /// <summary>
    /// Whether this tablet's store takes DD right now (GET /v1/pay/me). A till left on DD falls back to the store's
    /// default currency, with a note, once DD isn't offered any more (FR-006). A failed lookup changes nothing.
    /// </summary>
    private async Task LoadDdAvailabilityAsync()
    {
        if (device is null) return;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            using var req = new HttpRequestMessage(HttpMethod.Get, "/v1/pay/me");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            using var resp = await http.SendAsync(req, lifetime.Token);
            if (!resp.IsSuccessStatusCode) return;
            var me = await resp.Content.ReadFromJsonAsync<MeResponse>(lifetime.Token);
            if (me is null) return;
            var store = me.Stores.FirstOrDefault(s => s.Id == device.StoreId);
            ddAvailable = me.DdSurfacesEnabled && store is { DigiDollarEnabled: true };
            if (!ddAvailable && IsDd)
            {
                var fallback = PosEntry.NormalizeCurrency(store?.DefaultCurrencyEffective ?? store?.DefaultCurrency);
                if (fallback is null || PosEntry.IsDd(fallback)) fallback = PosEntry.Dgb;
                await SwitchCurrencyAsync(fallback, clearAmount: false);
                ddNotice = $"DigiDollar isn't offered for this store any more, so the till is back on {fallback}.";
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Log.LogInformation(ex, "POS could not check whether the store takes DigiDollar"); }
    }

    // After a failed DD charge: the same dollars as a USD-priced sale, paid in DGB at the live price.
    private async Task ChargeInDgbInsteadAsync()
    {
        await SwitchCurrencyAsync("USD", clearAmount: false);
        await RefreshPriceAsync();
        await ChargeAsync();
    }

    private int MaxDecimals => PosEntry.DecimalsFor(currency);

    private bool HasAmount => PosEntry.Parse(amount) is not null;

    private string StoreInitial =>
        device?.StoreName?.FirstOrDefault(char.IsLetterOrDigit) is char c and not '\0' ? char.ToUpperInvariant(c).ToString() : "D";

    // ----- Keypad layout ------------------------------------------------------------------

    private bool ShowDoubleZero => prefs.DoubleZero && IsFiat && MaxDecimals is 0 or 2;

    private string[] BottomRow =>
        !ShowDoubleZero ? [".", "0", "back"]
        : MaxDecimals == 0 ? ["00", "0", "back"]
        : [".", "0", "00", "back"];

    private IEnumerable<string> Keys =>
        (prefs.Keypad == "calculator" ? CalculatorRows : PhoneRows).SelectMany(r => r).Concat(BottomRow);

    // ----- Amounts ------------------------------------------------------------------------

    // Gratuity, as a whole percentage of the subtotal. 0 = no tip. Folded into the charged amount.
    private static readonly int[] TipPresets = [0, 10, 15, 20];
    private int tipPercent;

    private decimal? SubtotalDecimal => PosEntry.Parse(amount);

    // Tip in the till currency, rounded to its decimals ("10% of ₱12.50" is ₱1.25, "10% of ¥155" is ¥16).
    private decimal TipDecimal =>
        tipPercent <= 0 || SubtotalDecimal is not decimal sub ? 0m : PosEntry.Round(sub * tipPercent / 100m, currency);

    private decimal? TotalDecimal => SubtotalDecimal is decimal sub ? PosEntry.Round(sub + TipDecimal, currency) : null;

    // DGB the customer pays for the fiat total, on the satoshi grid (Fiat.ToDgb rounds half away from zero).
    private decimal? DgbEquivalent =>
        IsFiat && quote is { DgbPrice: > 0 } q && TotalDecimal is decimal fiat && fiat > 0 ? Fiat.ToDgb(fiat, q.DgbPrice) : null;

    private sealed record ReadoutParts(string Symbol, string Number, string Unit, bool Empty);

    private ReadoutParts Readout()
    {
        var unit = IsFiat ? "" : IsDd ? "DD" : "DGB";
        if (tipPercent > 0 && TotalDecimal is decimal total)
            return new(PosEntry.Symbol(currency), PosEntry.Number(total, currency), unit, false);
        return new(PosEntry.Symbol(currency), PosEntry.TypedNumber(amount, currency), unit, amount.Length == 0);
    }

    private bool CanCharge => !busy && HasAmount && (!IsFiat || quote is not null)
        && (!IsDd || (ddAvailable && TotalDecimal is decimal dd && PosEntry.DdInRange(dd)));

    private string ChargeLabel
    {
        get
        {
            if (busy) return "Creating…";
            if (!HasAmount || TotalDecimal is not decimal total) return "Charge";
            return $"Charge {PosEntry.Money(total, currency)}";
        }
    }

    // ----- Quote freshness ----------------------------------------------------------------

    private TimeSpan QuoteAge
    {
        get
        {
            if (quote is null) return TimeSpan.Zero;
            var at = quote.FetchedAt.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(quote.FetchedAt, DateTimeKind.Utc) : quote.FetchedAt.ToUniversalTime();
            var age = DateTime.UtcNow - at;
            return age < TimeSpan.Zero ? TimeSpan.Zero : age;
        }
    }

    private bool QuoteIsStale => quote is not null && (quote.Stale || QuoteAge > QuoteStaleAfter);

    // ----- Connection status --------------------------------------------------------------

    private string ConnectionTone => !apiReachable ? "offline" : reconnecting ? "reconnecting" : "live";
    private string ConnectionLabel => !apiReachable ? "Offline" : reconnecting ? "Reconnecting" : "Live";
    private string ConnectionHint => !apiReachable
        ? "DigiPay can't be reached from this tablet. Sales already on screen are still watched once it's back."
        : reconnecting ? "Live updates dropped; checking for payments every few seconds." : "Connected to DigiPay.";

    // ----- Lifecycle ----------------------------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncJsAsync();
        if (!firstRender) return;
        // Load a previously paired device from localStorage so returning cashiers don't see the pair screen every session.
        var stored = await JS.InvokeAsync<PairedDevice?>("digipayPos.load");
        if (stored is { ApiKey.Length: > 0, StoreId.Length: > 0 })
        {
            device = stored;
            screen = Screen.Keypad;
        }
        hasPin = await JS.InvokeAsync<bool>("digipayPos.hasPin");
        // The till currency, checked against the wallet's list (an old or edited value falls back to DGB).
        var savedCurrency = PosEntry.NormalizeCurrency(await JS.InvokeAsync<string?>("digipayPos.loadCurrency"));
        currencyChosenHere = savedCurrency is not null;
        currency = savedCurrency ?? PosEntry.Dgb;
        recentCurrencies = PosEntry.NormalizeRecent(await SafeLoadAsync<string[]>("digipayPos.loadRecent"));
        prefs = PosPrefs.Normalize(await SafeLoadAsync<PosPrefs>("digipayPos.loadPrefs"));
        StartTicker();
        if (IsFiat) _ = RefreshPriceAsync();
        // No currency picked on this tablet yet: start in the store's default currency.
        if (!currencyChosenHere && device is not null) _ = ApplyStoreDefaultCurrencyAsync();
        if (device is not null) _ = LoadDdAvailabilityAsync();
        StateHasChanged();
    }

    private async Task<T?> SafeLoadAsync<T>(string fn) where T : class
    {
        try { return await JS.InvokeAsync<T?>(fn); }
        catch (JSException) { return null; }
        catch (System.Text.Json.JsonException) { return null; }
    }

    // Wires the hardware keyboard and the dialogs' focus handling (dialog.js) after each render.
    private async Task SyncJsAsync()
    {
        try
        {
            selfRef ??= DotNetObjectReference.Create(this);
            if (!keysBound)
            {
                keysBound = true;
                await JS.InvokeVoidAsync("digipayPos.bindKeys", selfRef);
            }

            // One dialog at a time: Escape closes it, focus moves to its first field and comes back
            // to where it was when it closes.
            var wanted = showPinChallenge ? "pos-pin-dialog"
                : showSettings ? "pos-settings-dialog"
                : showCurrencyPicker ? "pos-currency-dialog"
                : showShiftReport ? "pos-shift-dialog"
                : showUnpair ? "pos-unpair-dialog"
                : showMenu ? "pos-menu-dialog"
                : null;
            if (wanted == jsDialogId) return;
            if (jsDialogId is not null) await JS.InvokeVoidAsync("digipayDialog.close", jsDialogId);
            jsDialogId = wanted;
            if (wanted is not null) await JS.InvokeVoidAsync("digipayDialog.open", wanted, selfRef);
            // The picker's first control is its close button; start in the search field instead.
            if (wanted == "pos-currency-dialog") await JS.InvokeVoidAsync("digipayPos.focus", "#pos-currency-dialog input[type=search]");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerendering */ }
    }

    /// <summary>Escape in an open dialog (dialog.js).</summary>
    [JSInvokable]
    public Task OnEscape() => InvokeAsync(() =>
    {
        if (showPinChallenge) CancelPinChallenge();
        else if (showSettings) CloseSettings();
        else if (showCurrencyPicker) CloseCurrencyPicker();
        else if (showShiftReport) showShiftReport = false;
        else if (showUnpair) showUnpair = false;
        else if (showMenu) showMenu = false;
        StateHasChanged();
    });

    private bool AnyDialogOpen =>
        showPinChallenge || showSettings || showCurrencyPicker || showShiftReport || showUnpair || showMenu
        || confirmCancelSeen || pendingCurrency is not null;

    /// <summary>
    /// A key from a hardware keyboard while the keypad is showing and no text field has focus
    /// (pos-store.js filters the rest): digits, ".", Backspace, Delete (clear), and Enter to charge.
    /// </summary>
    [JSInvokable]
    public Task OnKeypadKey(string key) => InvokeAsync(async () =>
    {
        if (screen != Screen.Keypad || AnyDialogOpen || busy) return;
        switch (key)
        {
            case "Enter":
                if (CanCharge) await ChargeAsync();
                break;
            case "Backspace":
                PressKey("back");
                break;
            case "Delete":
                ClearAmount();
                break;
            case "." or ",":
                PressKey(".");
                break;
            case { Length: 1 } when char.IsAsciiDigit(key[0]):
                PressKey(key);
                break;
            default:
                return;
        }
        StateHasChanged();
    });

    /// <summary>The browser went on or offline (pos-store.js).</summary>
    [JSInvokable]
    public Task OnNetworkChanged(bool online) => InvokeAsync(() =>
    {
        apiReachable = online;
        if (online && IsFiat && screen == Screen.Keypad) _ = RefreshPriceAsync();
        StateHasChanged();
    });

    private void PressKey(string key)
    {
        chargeError = null;
        amount = PosEntry.Press(amount, key, MaxDecimals);
    }

    private void ClearAmount()
    {
        chargeError = null;
        if (amount.Length == 0) return;
        amount = "";
        tipPercent = 0;
        Announcer.Announce("Amount cleared.");
    }

    private void BackDown(PointerEventArgs e)
    {
        holdCts?.Cancel();
        holdCts = new CancellationTokenSource();
        _ = HoldToClearAsync(holdCts.Token);
    }

    private void BackUp() => holdCts?.Cancel();

    private async Task HoldToClearAsync(CancellationToken ct)
    {
        try { await Task.Delay(600, ct); }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            ClearAmount();
            StateHasChanged();
        });
    }

    private void UseQuickAmount(decimal value)
    {
        chargeError = null;
        amount = PosEntry.Typed(value, currency);
    }

    private void SetTip(int percent)
    {
        // Tapping the active preset clears it, so there is no separate clear button.
        tipPercent = tipPercent == percent ? 0 : percent;
        chargeError = null;
    }

    // ----- Currency -----------------------------------------------------------------------

    private void OpenCurrencyPicker()
    {
        pendingCurrency = null;
        showCurrencyPicker = true;
    }

    private void CloseCurrencyPicker() => showCurrencyPicker = false;

    // Picking a currency keeps the typed amount (and tip) when it fits the new currency's precision; otherwise the
    // till asks before clearing it, so nothing vanishes silently.
    private async Task SelectCurrencyAsync(string picked)
    {
        if (PosEntry.NormalizeCurrency(picked) is not { } code) return;
        CloseCurrencyPicker();
        if (code == currency) return;
        if (PosEntry.IsDd(code))
        {
            // Only a USD amount carries over to DD; anything else would need converting, so it is cleared (after asking).
            if (amount.Length > 0 && PosEntry.CarryToDd(amount, currency).Length == 0) { pendingCurrency = code; return; }
            await SwitchCurrencyAsync(code, clearAmount: false);
            return;
        }
        if (!PosEntry.Fits(amount, PosEntry.DecimalsFor(code))) { pendingCurrency = code; return; }
        await SwitchCurrencyAsync(code, clearAmount: false);
    }

    private Task ConfirmCurrencySwitchAsync() =>
        pendingCurrency is { } code ? SwitchCurrencyAsync(code, clearAmount: true) : Task.CompletedTask;

    private async Task SwitchCurrencyAsync(string code, bool clearAmount)
    {
        currency = code;
        currencyChosenHere = true;
        pendingCurrency = null;
        if (clearAmount)
        {
            amount = "";
            tipPercent = 0;
        }
        else if (amount.EndsWith('.') && MaxDecimals == 0)
        {
            amount = amount.TrimEnd('.');
        }
        chargeError = null;
        ddFallbackOffered = false;
        ddNotice = null;
        quote = null;
        priceFailed = false;
        recentCurrencies = PosEntry.PushRecent(recentCurrencies, code);
        try
        {
            await JS.InvokeVoidAsync("digipayPos.saveCurrency", currency);
            await JS.InvokeVoidAsync("digipayPos.saveRecent", recentCurrencies);
        }
        catch (JSException) { }
        if (IsFiat) _ = RefreshPriceAsync();
    }

    /// <summary>
    /// The store's default currency (GET /v1/pay/stores/{id} with the tablet key, unless <paramref name="known"/>
    /// already has it) as the till currency, for a tablet where no currency was picked yet. It isn't saved, so the
    /// tablet keeps following the store default until the cashier picks a currency here. Anything already typed,
    /// or a currency picked meanwhile, wins.
    /// </summary>
    private async Task ApplyStoreDefaultCurrencyAsync(string? known = null)
    {
        if (currencyChosenHere || device is null) return;
        var code = known;
        if (code is null)
        {
            try
            {
                var http = HttpFactory.CreateClient("PayApi");
                using var req = new HttpRequestMessage(HttpMethod.Get, $"/v1/pay/stores/{Uri.EscapeDataString(device.StoreId)}");
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
                using var resp = await http.SendAsync(req, lifetime.Token);
                if (!resp.IsSuccessStatusCode) return;
                var defaults = await resp.Content.ReadFromJsonAsync<StoreDefaultsDto>(lifetime.Token);
                // A saved DD default reads as USD while DD can't be offered (FR-008); the API works that out.
                code = defaults?.DefaultCurrencyEffective ?? defaults?.DefaultCurrency;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Log.LogInformation(ex, "POS could not load the store's default currency");
                return;
            }
            catch (OperationCanceledException) { return; }
        }
        if (PosEntry.NormalizeCurrency(code) is not { } normalized) return;
        if (currencyChosenHere || amount.Length > 0 || normalized == currency) return;
        currency = normalized;
        quote = null;
        priceFailed = false;
        chargeError = null;
        if (IsFiat) _ = RefreshPriceAsync();
        await InvokeAsync(StateHasChanged);
    }

    // ----- Price --------------------------------------------------------------------------

    private Task RetryPriceAsync() => RefreshPriceAsync();

    private async Task RefreshPriceAsync()
    {
        if (!IsFiat || priceLoading) return;
        var code = currency;
        priceLoading = true;
        lastPriceAttempt = DateTime.UtcNow;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var resp = await http.GetAsync($"/v1/pay/public/price?currency={Uri.EscapeDataString(code.ToLowerInvariant())}", lifetime.Token);
            apiReachable = true;
            if (code != currency) return;
            var body = resp.IsSuccessStatusCode ? await resp.Content.ReadFromJsonAsync<PriceQuote>(lifetime.Token) : null;
            if (code != currency) return;
            if (body is { DgbPrice: > 0 })
            {
                quote = body;
                quoteLoadedAt = DateTime.UtcNow;
                priceFailed = false;
            }
            else
            {
                // Keep a previous quote (its age shows as "last known price"); without one, charging pauses.
                priceFailed = true;
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "POS could not fetch the {Currency} price", code);
            if (ex is HttpRequestException) apiReachable = false;
            if (code == currency) priceFailed = true;
        }
        finally
        {
            priceLoading = false;
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        }
    }

    // One timer for the page: refreshes the quote every minute while in fiat (and retries a missing one), and
    // re-renders now and then so "updated 12s ago" stays true.
    private void StartTicker()
    {
        tickTimer ??= new System.Threading.Timer(_ => _ = InvokeAsync(async () =>
        {
            if (lifetime.IsCancellationRequested || screen != Screen.Keypad || !IsFiat) return;
            var now = DateTime.UtcNow;
            var due = quote is null ? now - lastPriceAttempt >= QuoteRefreshEvery : now - quoteLoadedAt >= QuoteRefreshEvery;
            if (due) await RefreshPriceAsync();
            else StateHasChanged();
        }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    // ----- Pairing ------------------------------------------------------------------------

    private async Task ClaimPairingAsync()
    {
        pairError = null;
        busy = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.PostAsJsonAsync("/v1/pay/pos/claim", new { code = pairCode.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                // The API surfaces a structured `error`/`reason` for claim failures so we can render typo-vs-expired distinctly.
                ClaimErrorDto? err = null;
                try { err = await response.Content.ReadFromJsonAsync<ClaimErrorDto>(); } catch { }
                pairError = !string.IsNullOrWhiteSpace(err?.Error)
                    ? err!.Error
                    : $"Pairing failed ({(int)response.StatusCode}).";
                return;
            }
            var dto = await response.Content.ReadFromJsonAsync<ClaimResponse>();
            if (dto is null) { pairError = "Pairing failed — empty response."; return; }
            await SaveDeviceAsync(new PairedDevice(
                dto.ApiKey, dto.StoreId, dto.StoreName,
                dto.MerchantName, dto.DeviceLabel));
            screen = Screen.Keypad;
            if (IsFiat) _ = RefreshPriceAsync();
            _ = ApplyStoreDefaultCurrencyAsync();
        }
        catch (Exception ex) { pairError = $"Pairing failed: {ex.Message}"; }
        finally { busy = false; }
    }

    private sealed record ClaimErrorDto(string? Error, string? Reason);

    private async Task ApplyManualKeyAsync()
    {
        pairError = null;
        busy = true;
        try
        {
            var key = manualApiKey.Trim();
            if (!key.StartsWith("dgp_")) { pairError = "API key should start with \"dgp_\"."; return; }
            var http = HttpFactory.CreateClient("PayApi");
            // Resolve the merchant + stores for this key so we can prefill name/store info without asking the user to type them.
            var req = new HttpRequestMessage(HttpMethod.Get, "/v1/pay/me");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", key);
            var resp = await http.SendAsync(req);
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            { pairError = "That API key was rejected."; return; }
            if (!resp.IsSuccessStatusCode)
            { pairError = $"Could not verify key ({(int)resp.StatusCode})."; return; }

            var me = await resp.Content.ReadFromJsonAsync<MeResponse>();
            var stores = me?.Stores ?? new();
            if (stores.Count == 0) { pairError = "This account has no stores yet."; return; }

            var targetId = string.IsNullOrWhiteSpace(manualStoreId) ? stores[0].Id : manualStoreId.Trim();
            var target = stores.FirstOrDefault(s => s.Id == targetId);
            if (target is null) { pairError = "Store ID not found for this account."; return; }

            await SaveDeviceAsync(new PairedDevice(
                key, target.Id, target.Name, me?.DisplayName ?? "", "Manual pairing"));
            screen = Screen.Keypad;
            if (IsFiat) _ = RefreshPriceAsync();
            _ = LoadDdAvailabilityAsync();
            if ((target.DefaultCurrencyEffective ?? target.DefaultCurrency) is { Length: > 0 } storeDefault) await ApplyStoreDefaultCurrencyAsync(storeDefault);
        }
        catch (Exception ex) { pairError = $"Could not verify key: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task SaveDeviceAsync(PairedDevice d)
    {
        device = d;
        await JS.InvokeVoidAsync("digipayPos.save", d);
    }

    // ----- Charging -----------------------------------------------------------------------

    private async Task ChargeAsync()
    {
        chargeError = null;
        if (!HasAmount || device is null || busy) return;
        busy = true;
        try
        {
            // In fiat the cashier typed a fiat amount: convert it to DGB for the on-chain invoice and keep the fiat
            // context on the session so the dashboard, receipt and CSV show both. A quote over a minute old is
            // refreshed first. A stale one (the price feed is down) is still used: the note on screen says so.
            decimal dgbAmount = 0m;
            long? ddCents = null;
            decimal? fiatAmount = null;
            string? fiatCurrency = null;
            decimal? priceSnapshot = null;
            if (IsDd)
            {
                // DigiDollar: the typed dollars are the amount, in cents (1 DD = $1). No price, no conversion.
                if (TotalDecimal is not decimal dollars || !PosEntry.DdInRange(dollars))
                {
                    chargeError = $"DigiDollar amounts must be from {PosEntry.Money(PosEntry.DdMin, PosEntry.Dd)} to {PosEntry.Money(PosEntry.DdMax, PosEntry.Dd)}.";
                    return;
                }
                ddCents = (long)(PosEntry.Round(dollars, PosEntry.Dd) * 100m);
            }
            else if (IsFiat)
            {
                if (quote is null || DateTime.UtcNow - quoteLoadedAt > QuoteRefreshEvery)
                {
                    busy = false;
                    await RefreshPriceAsync();
                    busy = true;
                }
                if (quote is not { DgbPrice: > 0 } q || TotalDecimal is not decimal totalFiat)
                {
                    chargeError = $"No DGB price for {currency} right now — try again or switch to DGB.";
                    return;
                }
                fiatAmount = Fiat.Round(totalFiat, currency);
                dgbAmount = Fiat.ToDgb(fiatAmount.Value, q.DgbPrice);
                fiatCurrency = currency;
                priceSnapshot = q.DgbPrice;
                if (dgbAmount <= 0) { chargeError = "That amount is too small to charge in DGB."; return; }
            }
            else
            {
                dgbAmount = TotalDecimal ?? 0m;
            }

            // When tipped, the label carries the breakdown so it survives in the dashboard, webhooks, exports and
            // receipts without an extra column on the session.
            string? label = string.IsNullOrWhiteSpace(labelInput) ? null : labelInput.Trim();
            if (tipPercent > 0 && SubtotalDecimal is not null)
            {
                var tipNote = $"Tip {tipPercent}% ({PosEntry.Money(TipDecimal, currency)})";
                label = string.IsNullOrEmpty(label) ? tipNote : $"{label} · {tipNote}";
            }

            object body = ddCents is long cents
                ? new { currency = PosEntry.Dd, amountCentsDd = cents, storeId = device.StoreId, label }
                : new
                {
                    amount = dgbAmount,
                    storeId = device.StoreId,
                    label,
                    fiatCurrency,
                    fiatAmount,
                    dgbPriceAtCreation = priceSnapshot,
                    // specs/033 US3: a fiat sale lets the customer pay in DGB or DD (the API ignores it where DD isn't offered).
                    buyerChoice = fiatCurrency is null ? (bool?)null : true,
                };
            // One key per charge; a retry of the very same request after a network error reuses it, so the API
            // returns the payment it already made instead of a second one.
            var signature = System.Text.Json.JsonSerializer.Serialize(body);
            if (chargeKey is null || chargeKeyFor != signature) { chargeKey = Guid.NewGuid().ToString("N"); chargeKeyFor = signature; }

            var http = HttpFactory.CreateClient("PayApi");
            var req = new HttpRequestMessage(HttpMethod.Post, "/v1/pay/sessions") { Content = JsonContent.Create(body) };
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            req.Headers.Add("Idempotency-Key", chargeKey);
            var resp = await http.SendAsync(req);
            apiReachable = true;
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                chargeError = "Pairing was revoked — unpair and re-pair this device.";
                return;
            }
            if (!resp.IsSuccessStatusCode)
            {
                chargeError = await ApiError.ReadAsync(resp);
                chargeKey = null; // the server answered: a new attempt is a new charge
                // DD couldn't be charged (DD just turned off, say): keep the amount and offer the same dollars in DGB (FR-014).
                ddFallbackOffered = IsDd;
                return;
            }
            chargeKey = null;
            ddFallbackOffered = false;
            var created = await resp.Content.ReadFromJsonAsync<CreatedSession>();
            if (created is null) { chargeError = "Empty response from server."; return; }
            autoReturnCts?.Cancel();
            posView = created.Currency;
            posSwitchError = null;
            AdoptSession(created);
            resultStatus = null;
            cancelError = null;
            lastAnnouncedStatus = created.Status;
            lastAnnouncedConfirmations = created.Confirmations;
            qrDataUrl = GenerateQr(session!.Uri);
            screen = Screen.Waiting;
        }
        catch (HttpRequestException ex)
        {
            apiReachable = false;
            chargeError = $"Couldn't reach DigiPay: {ex.Message}";
        }
        catch (Exception ex) { chargeError = $"Failed: {ex.Message}"; }
        finally { busy = false; }

        if (screen == Screen.Waiting && session is not null)
        {
            StateHasChanged();
            await WatchAsync(session.Id);
        }
    }

    // ----- Live updates -------------------------------------------------------------------

    private IEnumerable<string> WatchedSessionIds()
    {
        if (session is not null) yield return session.Id;
        foreach (var w in lateWatches)
            if (w.SessionId != session?.Id) yield return w.SessionId;
    }

    private bool HasAnythingToWatch
    {
        get
        {
            PruneLateWatches();
            return (session is not null && !CheckoutStates.IsFinal(session.Status)) || lateWatches.Count > 0;
        }
    }

    private void PruneLateWatches() => lateWatches.RemoveAll(w => w.Until <= DateTime.UtcNow);

    // Starts (or reuses) the page's hub connection and subscribes to a session. A status change
    // between creating the session and subscribing is caught by reading it once more afterwards.
    private async Task WatchAsync(string sessionId)
    {
        if (hub is null)
        {
            hub = new HubConnectionBuilder()
                .WithUrl($"{PayApi.Value}/hubs/checkout")
                .WithAutomaticReconnect()
                .Build();
            hub.On<StatusUpdate>("StatusChanged", OnStatusChangedAsync);
            hub.Reconnecting += _ => SetReconnectingAsync(true);
            hub.Reconnected += async _ =>
            {
                await SubscribeAllAsync();
                await RefreshWatchedAsync(); // catch anything that happened while we were away
                await SetReconnectingAsync(false);
            };
            hub.Closed += async _ =>
            {
                // Automatic reconnect gave up. Keep watching over plain HTTP; a dropped connection
                // never ends a sale on its own.
                if (lifetime.IsCancellationRequested) return;
                await SetReconnectingAsync(true);
                StartPolling();
            };
        }

        try
        {
            if (hub.State == HubConnectionState.Disconnected)
            {
                await hub.StartAsync(lifetime.Token);
                await SubscribeAllAsync();
            }
            else if (hub.State == HubConnectionState.Connected)
            {
                await hub.InvokeAsync("SubscribeToSession", sessionId, lifetime.Token);
            }
            // Connecting / Reconnecting: Reconnected re-subscribes everything, and polling covers us.
            await RefreshSessionAsync(sessionId);
            if (hub.State != HubConnectionState.Connected)
            {
                await SetReconnectingAsync(true);
                StartPolling();
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "POS live updates unavailable for {SessionId}; polling instead", sessionId);
            await SetReconnectingAsync(true);
            await RefreshSessionAsync(sessionId);
            StartPolling();
        }
    }

    private async Task SubscribeAllAsync()
    {
        if (hub is null) return;
        foreach (var id in WatchedSessionIds().ToList())
            await hub.InvokeAsync("SubscribeToSession", id, lifetime.Token);
    }

    private void StartPolling()
    {
        if (pollLoop is { IsCompleted: false }) return;
        pollLoop = PollAsync();
    }

    private async Task PollAsync()
    {
        var delay = PollEvery;
        while (!lifetime.IsCancellationRequested && HasAnythingToWatch)
        {
            try { await Task.Delay(delay, lifetime.Token); }
            catch (OperationCanceledException) { return; }

            await RefreshWatchedAsync();

            // Try to get live updates back, backing off up to a minute.
            if (hub is not null && hub.State == HubConnectionState.Disconnected)
            {
                try
                {
                    await hub.StartAsync(lifetime.Token);
                    await SubscribeAllAsync();
                    await SetReconnectingAsync(false);
                    return;
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch { delay = TimeSpan.FromSeconds(Math.Min(60, delay.TotalSeconds * 2)); }
            }
            else if (hub is not null && hub.State == HubConnectionState.Connected)
            {
                await SetReconnectingAsync(false);
                return;
            }
        }
        await SetReconnectingAsync(false);
    }

    private async Task RefreshWatchedAsync()
    {
        foreach (var id in WatchedSessionIds().ToList())
            await RefreshSessionAsync(id);
    }

    // Re-reads one session over HTTP (the public read the checkout uses). Only the server's answer
    // can move the till to a final state.
    private async Task RefreshSessionAsync(string sessionId)
    {
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.GetFromJsonAsync<SessionEnvelope>($"/v1/pay/sessions/{Uri.EscapeDataString(sessionId)}", lifetime.Token);
            if (!apiReachable) await InvokeAsync(() => { apiReachable = true; StateHasChanged(); });
            if (response?.Session is { } s)
            {
                // A buyer-choice lock (or a new option) changes what the screen shows: take the whole payment again.
                if (posActual is not null && posActual.Id == s.Id
                    && (s.LockedAt != posActual.LockedAt || s.Currency != posActual.Currency || (s.Options?.Count ?? 0) != (posActual.Options?.Count ?? 0)))
                    await InvokeAsync(() => { AdoptSession(s with { Status = posActual.Status }); StateHasChanged(); });
                await OnStatusChangedAsync(new StatusUpdate(s.Id, s.Status, s.ReceivedSatoshis, s.Confirmations, s.PaidTxid));
            }
        }
        catch (HttpRequestException)
        {
            if (apiReachable) await InvokeAsync(() => { apiReachable = false; StateHasChanged(); });
        }
        catch { /* still offline: keep the last known state */ }
    }

    private async Task SetReconnectingAsync(bool value)
    {
        if (reconnecting == value) return;
        await InvokeAsync(() =>
        {
            reconnecting = value;
            if (value && screen == Screen.Waiting)
                Announcer.Announce("Reconnecting. The payment is still being watched.");
            StateHasChanged();
        });
    }

    private async Task OnStatusChangedAsync(StatusUpdate u)
    {
        if (posActual is not null && posActual.Id == u.SessionId
            && ((u.LockedAt is not null && u.LockedAt != posActual.LockedAt) || (u.Currency is { } c && c != posActual.Currency)))
        {
            await RefreshSessionAsync(u.SessionId);
            return;
        }
        await InvokeAsync(async () =>
        {
            if (session is not null && session.Id == u.SessionId) await ApplyToCurrentAsync(u);
            else if (lateWatches.FirstOrDefault(w => w.SessionId == u.SessionId) is { } late) await ApplyLateAsync(late, u.Status);
        });
    }

    private async Task ApplyToCurrentAsync(StatusUpdate u)
    {
        if (session is null) return;
        var wasExpiredResult = screen == Screen.Result && resultStatus == "expired";
        session = session with
        {
            Status = u.Status,
            ReceivedSatoshis = u.ReceivedSatoshis,
            Confirmations = u.Confirmations,
            PaidTxid = u.Txid ?? session.PaidTxid,
        };
        if (posActual is not null && posActual.Id == u.SessionId)
            posActual = posActual with { Status = u.Status, ReceivedSatoshis = u.ReceivedSatoshis, Confirmations = u.Confirmations, PaidTxid = u.Txid ?? posActual.PaidTxid };

        if (u.Status != lastAnnouncedStatus)
        {
            lastAnnouncedStatus = u.Status;
            lastAnnouncedConfirmations = u.Confirmations;
            var announcement = CheckoutStates.For(u.Status).Announcement;
            if (announcement is not null) Announcer.Announce(announcement, assertive: u.Status is "underpaid");
        }
        else if (u.Status == "paid" && u.Confirmations > lastAnnouncedConfirmations)
        {
            lastAnnouncedConfirmations = u.Confirmations;
            Announcer.Announce($"{u.Confirmations} of {CheckoutStates.ConfirmationsRequired} confirmations.");
        }

        if (wasExpiredResult && u.Status != "expired")
        {
            // A late payment on the sale still on screen: say so, and follow it to the end.
            lateWatches.RemoveAll(w => w.SessionId == session.Id);
            ShowLateNotice(u.Status, Describe(session));
        }

        if (CheckoutStates.IsFinal(u.Status))
        {
            if (screen != Screen.Result || resultStatus != u.Status) await ShowResultAsync(u.Status);
            else StateHasChanged();
        }
        else
        {
            if (screen == Screen.Result) { autoReturnCts?.Cancel(); screen = Screen.Waiting; resultStatus = null; }
            StateHasChanged();
        }
    }

    private Task ApplyLateAsync(LateWatch late, string status)
    {
        if (status is "expired" or "voided" or "pending") return Task.CompletedTask;
        lateWatches.Remove(late);
        ShowLateNotice(status, late.Description);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ShowLateNotice(string status, string description)
    {
        latePaymentNotice = status == "underpaid"
            ? $"Late partial payment received for {description}. Check the dashboard."
            : $"Late payment received for {description}.";
        Announcer.Announce(latePaymentNotice, assertive: true);
        _ = BeepAsync();
    }

    private void DismissLateNotice() => latePaymentNotice = null;

    private async Task BeepAsync()
    {
        try { await JS.InvokeVoidAsync("digipayPos.beep"); } catch { }
    }

    // How a sale is named in a late-payment notice: its label, else its amount.
    private static string Describe(CreatedSession s)
    {
        var label = s.Label;
        if (!string.IsNullOrWhiteSpace(label))
        {
            // Drop the tip annotation ChargeAsync appends; the cashier typed the first part.
            var cut = label.IndexOf(" · Tip ", StringComparison.Ordinal);
            if (cut > 0) label = label[..cut];
            if (!label.StartsWith("Tip ", StringComparison.Ordinal)) return label;
        }
        if (IsDdSession(s)) return $"the {PosEntry.FormatDdCents(s.AmountCentsDd ?? 0)} sale";
        return s.FiatAmount is decimal fa && !string.IsNullOrEmpty(s.FiatCurrency)
            ? $"the {Fiat.FormatWithCode(fa, s.FiatCurrency)} sale"
            : $"the {PosEntry.FormatDgb(s.AmountSatoshis)} DGB sale";
    }

    private async Task ShowResultAsync(string status)
    {
        resultStatus = status;
        screen = Screen.Result;
        cancelError = null;
        confirmCancelSeen = false;
        StateHasChanged();

        if (status == "expired" && session is not null)
        {
            // Keep watching: a payment can still land after the price window closed.
            lateWatches.RemoveAll(w => w.SessionId == session.Id);
            lateWatches.Add(new LateWatch(session.Id, Describe(session), DateTime.UtcNow + LatePaymentWatch));
        }

        if (status == "confirmed")
        {
            await BeepAsync();
            autoReturnCts?.Cancel();
            autoReturnCts = new CancellationTokenSource();
            var ct = autoReturnCts.Token;
            autoReturnSeconds = 5;
            _ = Task.Run(async () =>
            {
                try
                {
                    for (var i = 5; i > 0; i--)
                    {
                        autoReturnSeconds = i;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(1000, ct);
                    }
                    await InvokeAsync(NewSale);
                }
                catch (TaskCanceledException) { /* cancelled — operator hit New sale */ }
            }, ct);
        }
    }

    // ----- Cancelling a sale --------------------------------------------------------------

    /// <summary>Not once the payment is in a block: from then on it is the merchant's money.</summary>
    private bool CanCancelSale => session is { Status: "pending" or "seen" };

    private bool CanChargeAgain => resultStatus is "expired" or "underpaid" or "voided";

    private Task RequestCancelSale()
    {
        cancelError = null;
        if (session?.Status == "seen")
        {
            confirmCancelSeen = true;
            return Task.CompletedTask;
        }
        return CancelSaleAsync();
    }

    // Voids the session on the server so the customer can no longer pay it (the POS key is a
    // merchant API key, so POST /v1/pay/sessions/{id}/void accepts it).
    private async Task CancelSaleAsync()
    {
        if (session is null || device is null) return;
        var target = session;
        cancelling = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = new HttpRequestMessage(HttpMethod.Post, $"/v1/pay/sessions/{Uri.EscapeDataString(target.Id)}/void")
            {
                Content = JsonContent.Create(new { note = "Cancelled at the till" }),
            };
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            var resp = await http.SendAsync(req, lifetime.Token);
            if (resp.IsSuccessStatusCode)
            {
                Announcer.Announce("Sale cancelled.");
                confirmCancelSeen = false;
                session = null;
                qrDataUrl = null;
                tipPercent = 0;
                screen = Screen.Keypad;
                return;
            }
            confirmCancelSeen = false;
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // Paid (or otherwise final) in the meantime: show what really happened.
                cancelError = "This sale can no longer be cancelled.";
                await RefreshSessionAsync(target.Id);
                return;
            }
            cancelError = resp.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Pairing was revoked — the sale could not be cancelled."
                : $"Could not cancel the sale ({(int)resp.StatusCode}). Try again.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "POS could not void {SessionId}", target.Id);
            confirmCancelSeen = false;
            cancelError = "Could not reach DigiPay to cancel the sale. Check the connection and try again.";
        }
        finally { cancelling = false; }
    }

    // Same amount, label and tip as the sale on screen, at a fresh price.
    private async Task ChargeAgainAsync()
    {
        if (busy) return;
        autoReturnCts?.Cancel();
        if (IsFiat) await RefreshPriceAsync();
        await ChargeAsync();
        if (screen == Screen.Result && chargeError is not null)
        {
            // Couldn't create it: back to the keypad, where the amount is ready and the error shows.
            screen = Screen.Keypad;
        }
    }

    private void NewSale()
    {
        autoReturnCts?.Cancel();
        amount = "";
        labelInput = "";
        tipPercent = 0;
        session = null;
        qrDataUrl = null;
        resultStatus = null;
        cancelError = null;
        screen = Screen.Keypad;
        StateHasChanged();
    }

    // ----- Menu, shift, unpair ------------------------------------------------------------

    private void OpenMenu() => showMenu = true;

    private void CloseMenu() => showMenu = false;

    private void OpenSettingsFromMenu()
    {
        showMenu = false;
        OpenSettings();
    }

    private Task OpenShiftFromMenuAsync()
    {
        showMenu = false;
        return OpenShiftReportAsync();
    }

    private Task UnpairFromMenuAsync()
    {
        showMenu = false;
        return ShowUnpairAsync();
    }

    private Task ShowUnpairAsync()
    {
        // If a manager PIN is set, require it before even showing the confirm dialog.
        if (hasPin)
        {
            return PromptPinAsync("Enter the manager PIN to unpair this device.", () =>
            {
                showUnpair = true;
                StateHasChanged();
                return Task.CompletedTask;
            });
        }
        showUnpair = true;
        return Task.CompletedTask;
    }

    private async Task OpenShiftReportAsync()
    {
        if (device is null || screen != Screen.Keypad) return;
        // Reset every time so a stale report never flashes. Show the dialog at once and let the fetch fill it.
        shiftReport = null;
        shiftReportError = null;
        showShiftReport = true;
        StateHasChanged();

        try
        {
            var since = await JS.InvokeAsync<string?>("digipayPos.loadShiftStart");
            var http = HttpFactory.CreateClient("PayApi");
            var url = $"/v1/pay/pos/shift-report?storeId={Uri.EscapeDataString(device.StoreId)}";
            if (!string.IsNullOrWhiteSpace(since))
                url += $"&since={Uri.EscapeDataString(since)}";
            var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            var resp = await http.SendAsync(req);
            if (!resp.IsSuccessStatusCode)
            {
                shiftReportError = $"Could not load report ({(int)resp.StatusCode}).";
                return;
            }
            shiftReport = await resp.Content.ReadFromJsonAsync<ShiftReport>();
            if (shiftReport is null) shiftReportError = "Empty response from server.";
        }
        catch (Exception ex) { shiftReportError = $"Failed: {ex.Message}"; }
    }

    private async Task StartNewShiftAsync()
    {
        // Stamp "now" so the next report only shows sales from this moment on. Per tablet by design.
        var nowIso = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture);
        await JS.InvokeVoidAsync("digipayPos.saveShiftStart", nowIso);
        showShiftReport = false;
        shiftReport = null;
    }

    // ----- Settings -----------------------------------------------------------------------

    private void OpenSettings()
    {
        quickAmountsText = string.Join(", ", prefs.QuickAmountsFor(currency).Select(a => PosEntry.Typed(a, currency)));
        ClosePinForm();
        showSettings = true;
    }

    private void CloseSettings()
    {
        showSettings = false;
        ClosePinForm();
    }

    // A labelled set of mutually exclusive choices (aria-pressed buttons).
    private RenderFragment Choice(string id, string label, string? hint, string current, (string Value, string Text)[] options, Action<string> set) => __builder =>
    {
        <div class="dp-pos-set-field">
            <p id="@id" class="field-label">@label</p>
            <div class="segmented dp-pos-set-choice" role="group" aria-labelledby="@id" aria-describedby="@(hint is null ? null : id + "-hint")">
                @foreach (var (value, text) in options)
                {
                    var v = value;
                    <button type="button" class="segmented-item" data-value="@v" aria-pressed="@(current == v ? "true" : "false")"
                            @onclick="() => SetPrefAsync(() => set(v))">@text</button>
                }
            </div>
            @if (hint is not null)
            {
                <p id="@(id)-hint" class="field-hint">@hint</p>
            }
        </div>
    };

    private async Task SetPrefAsync(Action change)
    {
        change();
        prefs = PosPrefs.Normalize(prefs);
        await SavePrefsAsync();
    }

    private async Task SavePrefsAsync()
    {
        try { await JS.InvokeVoidAsync("digipayPos.savePrefs", prefs); }
        catch (JSException) { }
    }

    private async Task SaveQuickAmountsAsync(ChangeEventArgs e)
    {
        var list = PosEntry.ParseQuickAmounts(e.Value?.ToString(), currency);
        if (list.Count == 0) prefs.QuickAmounts.Remove(currency);
        else prefs.QuickAmounts[currency] = list;
        quickAmountsText = string.Join(", ", list.Select(a => PosEntry.Typed(a, currency)));
        await SavePrefsAsync();
    }

    // ----- Manager PIN --------------------------------------------------------------------

    private void OpenPinForm()
    {
        pinNew = "";
        pinConfirm = "";
        pinSettingsError = null;
        // Changing an existing PIN first asks for the current one, so a walk-up can't silently rotate it.
        if (hasPin)
        {
            _ = PromptPinAsync("Enter the current manager PIN to change it.", () =>
            {
                pinFormOpen = true;
                StateHasChanged();
                return Task.CompletedTask;
            });
            return;
        }
        pinFormOpen = true;
    }

    private void ClosePinForm()
    {
        pinFormOpen = false;
        pinNew = "";
        pinConfirm = "";
        pinSettingsError = null;
    }

    private async Task SavePinAsync()
    {
        pinSettingsError = null;
        if (!CanSavePin)
        {
            pinSettingsError = "PIN must be 4–8 digits and match in both fields.";
            return;
        }
        var ok = await JS.InvokeAsync<bool>("digipayPos.setPin", pinNew);
        if (!ok) { pinSettingsError = "Could not save PIN — try again."; return; }
        hasPin = true;
        ClosePinForm();
        Announcer.Announce("Manager PIN saved.");
    }

    // Removing the PIN is itself guarded by the current PIN.
    private Task RequestRemovePin() =>
        PromptPinAsync("Enter the current manager PIN to remove it.", RemovePinAsync);

    private async Task RemovePinAsync()
    {
        await JS.InvokeVoidAsync("digipayPos.clearPin");
        hasPin = false;
        ClosePinForm();
        Announcer.Announce("Manager PIN removed.");
        StateHasChanged();
    }

    private Task PromptPinAsync(string prompt, Func<Task> onSuccess)
    {
        pinChallengePrompt = prompt;
        pinChallengeError = null;
        pinEntered = "";
        pinChallengePending = onSuccess;
        showPinChallenge = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CancelPinChallenge()
    {
        showPinChallenge = false;
        pinChallengePending = null;
        pinEntered = "";
        pinChallengeError = null;
    }

    private async Task VerifyPinChallengeAsync()
    {
        pinChallengeError = null;
        var ok = await JS.InvokeAsync<bool>("digipayPos.verifyPin", pinEntered);
        if (!ok) { pinChallengeError = "Incorrect PIN."; return; }
        var pending = pinChallengePending;
        CancelPinChallenge();
        if (pending != null) await pending();
    }

    private async Task UnpairAsync()
    {
        showUnpair = false;
        await JS.InvokeVoidAsync("digipayPos.clear");
        device = null;
        pairCode = "";
        manualApiKey = "";
        manualStoreId = "";
        screen = Screen.Pair;
    }

    // ----- Helpers ------------------------------------------------------------------------

    private static string GenerateQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.H);
        using var qr = new QRCoder.PngByteQRCode(data);
        return $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(8))}";
    }

    private static string SealClass(BadgeTone tone) => tone switch
    {
        BadgeTone.Success => "",
        BadgeTone.Danger => "is-danger",
        BadgeTone.Refund => "is-refund",
        BadgeTone.Info => "is-pending",
        _ => "is-neutral",
    };

    // The result screen talks to the cashier; CheckoutStates' explanations talk to a shopper.
    private static string CashierExplanation(string? status) => status switch
    {
        "confirmed" => "Thank the customer — all done.",
        "underpaid" => "Less than the full amount arrived. Collect the difference with a new sale, or refund what arrived from the dashboard.",
        "expired" => "No payment arrived in time. Charge again for a fresh price; if a late payment lands, this till will tell you.",
        "voided" => "This sale was cancelled, so it can't be paid. Nothing was charged.",
        "refunded" => "This payment was refunded from the dashboard.",
        _ => CheckoutStates.For(status).Explanation,
    };

    public async ValueTask DisposeAsync()
    {
        autoReturnCts?.Cancel();
        holdCts?.Cancel();
        lifetime.Cancel();
        tickTimer?.Dispose();
        tickTimer = null;
        try { if (keysBound) await JS.InvokeVoidAsync("digipayPos.unbindKeys"); } catch { }
        try { if (jsDialogId is not null) await JS.InvokeVoidAsync("digipayDialog.close", jsDialogId); } catch { }
        if (hub != null) { try { await hub.DisposeAsync(); } catch { } }
        selfRef?.Dispose();
        lifetime.Dispose();
    }

