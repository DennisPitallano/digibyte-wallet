@* Currency picker: DGB and every wallet currency, with the last four used on this tablet as "Recent". *@
<CurrencyPicker IsOpen="@showCurrencyPicker" Selected="@currency" IncludeDgb="true" IncludeDd="@ddAvailable" Recent="@recentCurrencies"
                Id="pos-currency-dialog" Title="Till currency"
                Hint="@PickerHint"
