@page "/pos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHttpClientFactory HttpFactory
@inject PayApiUrl PayApi
@inject IJSRuntime JS
@inject LiveAnnouncer Announcer
@inject ILogger<Pos> Log
@using Microsoft.AspNetCore.SignalR.Client
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json.Serialization

<PageTitle>@(device?.StoreName is { Length: > 0 } s ? $"{s} — POS" : "DigiPay POS")</PageTitle>

@* Full-bleed kiosk shell. No nav, no chrome. Starts dark (so the tablet looks the same whatever
   the device's setting); the merchant can pick Light or Match my device per tablet in settings, and
   digipay-pos.css maps the dark-only colours onto the light tokens. The root stays put while
   <main> scrolls, so nothing is cut off on short (landscape phone) screens. *@
<div class="dp-pos fixed inset-0 bg-slate-950 text-white font-sans flex flex-col select-none touch-manipulation overflow-hidden">

    @if (screen == Screen.Pair)
    {
        <div class="flex-1 flex items-center justify-center p-6">
            <div class="w-full max-w-md bg-dgb-900 border border-dgb-800 rounded-3xl p-6 sm:p-8 flex flex-col gap-4 shadow-2xl">
                <header class="flex items-center gap-3 pb-2">
                    <img src="/digipay-logo.svg" alt="" class="w-10 h-10" />
                    <div>
                        <div class="text-lg font-extrabold tracking-tight">Digi<span class="text-dgb-500">Pay</span> POS</div>
                        <div class="text-xs text-slate-400">Pair this device to start taking payments</div>
                    </div>
                </header>

                <div class="flex rounded-xl bg-slate-900 p-1 text-sm font-semibold">
                    <button type="button" aria-pressed="@(pairMode == "code" ? "true" : "false")" class="flex-1 py-2 rounded-lg transition-colors @(pairMode == "code" ? "bg-dgb-500 text-white" : "text-slate-400")"
                            @onclick="@(() => pairMode = "code")">Pairing code</button>
                    <button type="button" aria-pressed="@(pairMode == "key" ? "true" : "false")" class="flex-1 py-2 rounded-lg transition-colors @(pairMode == "key" ? "bg-dgb-500 text-white" : "text-slate-400")"
                            @onclick="@(() => pairMode = "key")">API key</button>
                </div>

                @if (pairMode == "code")
                {
                    <label for="pos-pair-code" class="text-[0.6875rem] font-bold uppercase tracking-widest text-slate-400 block">
                        Enter the 6-character code from your dashboard
                    </label>
                    <input id="pos-pair-code" @bind="pairCode" @bind:event="oninput" autocomplete="off" autocorrect="off" autocapitalize="characters" spellcheck="false"
                           maxlength="8" placeholder="AB2C9D"
                           class="w-full text-center font-mono text-3xl tracking-[0.5em] uppercase bg-slate-900 border border-dgb-800 rounded-xl py-4 focus:outline-none focus:ring-2 focus:ring-dgb-500/50" />
                    <button class="w-full py-3 bg-dgb-500 hover:bg-dgb-600 disabled:bg-dgb-500/40 text-white font-bold rounded-xl text-base transition-colors flex items-center justify-center gap-2"
                            @onclick="ClaimPairingAsync" disabled="@(busy || string.IsNullOrWhiteSpace(pairCode))">
                        @if (busy)
                        {
                            <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"></circle>
                                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                            </svg>
                            <span>Pairing…</span>
                        }
                        else
                        {
                            <span>Pair this device</span>
                        }
                    </button>
                }
                else
                {
                    <label for="pos-pair-key" class="text-[0.6875rem] font-bold uppercase tracking-widest text-slate-400 block">
                        Paste an API key (dgp_…)
                    </label>
                    <input id="pos-pair-key" @bind="manualApiKey" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                           placeholder="dgp_xxxx_xxxxxxxx…"
                           class="w-full font-mono text-sm bg-slate-900 border border-dgb-800 rounded-xl px-3 py-3 focus:outline-none focus:ring-2 focus:ring-dgb-500/50" />
                    <label for="pos-pair-store" class="text-[0.6875rem] font-bold uppercase tracking-widest text-slate-400 block">
                        Store ID (optional — leave blank to use default store)
                    </label>
                    <input id="pos-pair-store" @bind="manualStoreId" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                           placeholder="sto_…"
                           class="w-full font-mono text-sm bg-slate-900 border border-dgb-800 rounded-xl px-3 py-3 focus:outline-none focus:ring-2 focus:ring-dgb-500/50" />
                    <button class="w-full py-3 bg-dgb-500 hover:bg-dgb-600 disabled:bg-dgb-500/40 text-white font-bold rounded-xl text-base transition-colors flex items-center justify-center gap-2"
                            @onclick="ApplyManualKeyAsync" disabled="@(busy || string.IsNullOrWhiteSpace(manualApiKey))">
                        @if (busy)
                        {
                            <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"></circle>
                                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
                            </svg>
                            <span>Checking…</span>
                        }
                        else
                        {
                            <span>Use this key</span>
                        }
                    </button>
                }

                @if (pairError != null)
                {
                    <p class="dp-pos-error text-sm text-center m-0" role="alert">@pairError</p>
                }

                <p class="text-[0.6875rem] text-slate-500 text-center m-0 mt-2">
                    Tip: add this page to your home screen for a full-screen experience.
                </p>
            </div>
        </div>
    }
    else
    {
        @* Top bar — merchant + store + "lock / unpair" access. Minimal so the
           keypad and QR dominate the viewport. *@
        <header class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-dgb-800/60 shrink-0">
            <div class="flex items-center gap-2.5 min-w-0">
                <img src="/digipay-logo.svg" alt="" class="w-7 h-7 shrink-0" />
                <div class="min-w-0">
                    <div class="text-sm font-bold truncate">@(device?.StoreName ?? "Store")</div>
                    <div class="text-[0.6875rem] text-slate-500 truncate">@(device?.MerchantName ?? "")</div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button class="w-9 h-9 flex items-center justify-center text-slate-300 border border-dgb-800 rounded-lg hover:bg-dgb-900 transition-colors"
                        @onclick="OpenPinSettings" title="@(hasPin ? "Change / remove PIN" : "Set a manager PIN")" aria-label="Tablet settings">
                    <Icon Name="@(hasPin ? "shield" : "settings")" Class="w-4 h-4" />
                </button>
                @* "Close shift" surfaces the today-so-far summary. Disabled on
                   anything but the keypad screen so we don't yank the cashier
                   out of a sale mid-flow. *@
                <button class="px-3 py-1.5 text-xs font-semibold text-slate-300 border border-dgb-800 rounded-lg hover:bg-dgb-900 transition-colors disabled:opacity-40"
                        @onclick="OpenShiftReportAsync" disabled="@(screen != Screen.Keypad)" title="Today's totals">Close shift</button>
                <button class="px-3 py-1.5 text-xs font-semibold text-slate-300 border border-dgb-800 rounded-lg hover:bg-dgb-900 transition-colors"
                        @onclick="ShowUnpairAsync" title="Unpair this device">Unpair</button>
            </div>
        </header>

        @* A late payment on an expired sale (InvoiceMonitor keeps reconciling them for days). The
           till keeps watching expired sales for a while so the cashier finds out. *@
        @if (latePaymentNotice is not null)
        {
            <div class="dp-pos-late ui-banner ui-banner-warning" role="alert">
                <Icon Name="zap" Class="" />
                <p>@latePaymentNotice</p>
                <button type="button" class="dp-pos-late-close" @onclick="DismissLateNotice" aria-label="Dismiss late payment notice">
                    <Icon Name="close" Class="w-4 h-4" />
                </button>
            </div>
        }

        @if (screen == Screen.Keypad)
        {
            <main class="dp-pos-main dp-pos-keypad flex-1 grid grid-rows-[auto_1fr_auto] md:grid-cols-2 md:grid-rows-1 gap-4 p-4 sm:p-6">

                @* Amount readout *@
                <section class="dp-pos-readout md:order-2 flex flex-col items-center justify-center bg-dgb-900/60 border border-dgb-800 rounded-3xl p-6 min-h-[8rem] relative">

                    @* Currency: opens a picker listing every till currency. The amount is kept when it
                       fits the new currency; otherwise the picker asks before clearing it. *@
                    <button type="button" class="dp-pos-currency" @onclick="OpenCurrencyPicker"
                            aria-label="@($"Currency: {currency}, change")" aria-haspopup="dialog">
                        <span>@currency</span>
                        <Icon Name="chevron-down" Class="w-4 h-4" />
                    </button>

                    <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400 mb-2">Total</div>
                    @{
                        var readout = tipPercent > 0 && TotalDecimal is decimal tot ? FormatAmount(tot) : FormattedAmount;
                    }
                    <div class="dp-pos-amount @AmountSizeClass(readout + currency)" aria-live="polite">
                        @readout <span class="text-dgb-500">@currency</span>
                    </div>

                    @if (tipPercent > 0 && SubtotalDecimal is decimal subTotal)
                    {
                        @* Tip breakdown: shown only when a tip is applied so the
                           cashier / customer can see exactly how the total was
                           built. Doesn't exist as separate fields on the invoice
                           — the charge amount is just subtotal + tip folded in. *@
                        <div class="text-xs text-slate-400 mt-2">
                            @FormatAmount(subTotal) + @FormatAmount(TipDecimal) tip (@tipPercent%)
                        </div>
                    }

                    @if (IsFiat)
                    {
                        @* Secondary line: live DGB conversion. Keeps the cashier
                           honest about what's actually being invoiced and gives
                           a fallback to sanity-check the rate. *@
                        <div class="text-xs text-slate-400 mt-2">
                            @if (priceError != null)
                            {
                                <span class="dp-pos-warn">@priceError</span>
                            }
                            else if (DgbEquivalent is decimal d)
                            {
                                <span>≈ @d.ToString("0.########", CultureInfo.InvariantCulture) DGB</span>
                                @if (dgbPrice is decimal p)
                                {
                                    <span class="text-slate-500 ml-2">· 1 DGB = @p.ToString("0.########", CultureInfo.InvariantCulture) @currency</span>
                                }
                            }
                            else if (dgbPrice is null && !string.IsNullOrEmpty(amount))
                            {
                                <span>Fetching price…</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(labelInput))
                    {
                        <div class="text-xs text-slate-400 mt-3 truncate max-w-full">@labelInput</div>
                    }
                </section>

                @* Keypad. A hardware keyboard works too: digits, ".", Backspace and Enter to charge
                   (pos-store.js, only while no text field has focus). *@
                <section class="md:order-1 flex flex-col gap-3">
                    <label for="pos-sale-label" class="sr-only">Sale label (optional)</label>
                    <input id="pos-sale-label" @bind="labelInput" @bind:event="oninput" maxlength="60" placeholder="Label (optional — e.g. Order #42)"
                           class="w-full bg-slate-900 border border-dgb-800 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-dgb-500/50" />
                    <div class="grid grid-cols-3 gap-2 sm:gap-3 flex-1">
                        @foreach (var k in KeypadKeys)
                        {
                            var key = k;
                            <button type="button" class="dp-pos-key @KeyClass(key) min-h-16 text-2xl sm:text-3xl font-bold rounded-2xl transition-all active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dgb-500"
                                    aria-label="@(key == "back" ? "Delete last digit" : key == "." ? "Decimal point" : null)"
                                    @onclick="() => PressKey(key)">
                                @if (key == "back")
                                {
                                    <Icon Name="backspace" Class="w-8 h-8 mx-auto" />
                                }
                                else
                                {
                                    @key
                                }
                            </button>
                        }
                    </div>
                    @* Gratuity pill row — only makes sense once the cashier has
                       entered a base amount, so hide the whole strip until then
                       to keep the quick-sale (no-tip) flow uncluttered. *@
                    @if (HasAmount)
                    {
                        <div class="flex gap-2" role="group" aria-label="Tip">
                            @foreach (var pct in TipPresets)
                            {
                                var p = pct;
                                var selected = tipPercent == p;
                                var cls = selected
                                    ? "bg-dgb-500 text-white border-dgb-500"
                                    : "bg-slate-900 hover:bg-slate-800 text-slate-300 border-dgb-800";
                                <button type="button"
                                        class="dp-pos-tip flex-1 py-2 text-sm font-bold rounded-xl border transition-colors @cls"
                                        aria-pressed="@(selected ? "true" : "false")"
                                        @onclick="() => SetTip(p)">
                                    @(p == 0 ? "No tip" : $"{p}%")
                                </button>
                            }
                        </div>
                    }
                    <button type="button" class="dp-pos-charge w-full py-5 bg-dgb-500 hover:bg-dgb-600 disabled:bg-dgb-500/30 disabled:text-white/50 text-white font-extrabold rounded-2xl text-xl transition-colors active:scale-[0.99]"
                            @onclick="ChargeAsync" disabled="@(busy || !HasAmount)">
                        @(busy ? "Creating…" : "Charge")
                    </button>
                    @if (chargeError != null)
                    {
                        <p class="dp-pos-error text-sm text-center m-0" role="alert">@chargeError</p>
                    }
                </section>
            </main>
        }
        else if (screen == Screen.Waiting && session != null)
        {
            var confirming = CheckoutStates.IsConfirming(session.Status);
            <main class="dp-pos-main dp-pos-waiting flex-1 grid grid-rows-[auto_1fr] md:grid-cols-2 md:grid-rows-1 gap-6 p-4 sm:p-6 items-center">

                <section class="flex flex-col items-center gap-3 order-2 md:order-1">
                    @if (confirming)
                    {
                        @* Paid: the customer is done, so stop showing a code to pay and show how close the
                           payment is to final instead (same component as the hosted checkout). *@
                        <div class="dp-pos-confirm">
                            <ConfirmationProgress Status="@session.Status" Confirmations="@session.Confirmations"
                                                  Txid="@session.PaidTxid" Currency="DGB" />
                        </div>
                    }
                    else
                    {
                        <div class="qr-frame">
                            <img src="@qrDataUrl" alt="Scan to pay" class="dp-pos-qr" />
                        </div>
                        <div class="font-mono text-xs text-slate-400 break-all max-w-xs text-center">@session.Address</div>
                    }
                </section>

                <section class="flex flex-col items-center md:items-start gap-4 order-1 md:order-2 text-center md:text-left">
                    @if (reconnecting)
                    {
                        <div class="ui-banner ui-banner-info w-full" role="status">
                            <Icon Name="refresh" Class="" />
                            <p>Reconnecting… payment is still being watched.</p>
                        </div>
                    }
                    <div class="min-w-0 max-w-full">
                        <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400">Amount due</div>
                        @if (session.FiatAmount is decimal fa && !string.IsNullOrEmpty(session.FiatCurrency))
                        {
                            @* Fiat-quoted sale: lead with the fiat number (what the
                               cashier rang up) and put the DGB equivalent underneath
                               so the customer can reconcile with what their wallet shows. *@
                            var fiatText = FormatFiat(fa, session.FiatCurrency);
                            <div class="dp-pos-amount dp-pos-amount-due @AmountSizeClass(fiatText + session.FiatCurrency) mt-1">
                                @fiatText <span class="text-dgb-500">@session.FiatCurrency</span>
                            </div>
                            <div class="text-sm text-slate-400 mt-1">≈ @FormatDgb(session.AmountSatoshis) DGB</div>
                        }
                        else
                        {
                            var dgbText = FormatDgb(session.AmountSatoshis);
                            <div class="dp-pos-amount dp-pos-amount-due @AmountSizeClass(dgbText + "DGB") mt-1">
                                @dgbText <span class="text-dgb-500">DGB</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.Label))
                        {
                            <div class="text-sm text-slate-300 mt-2">@session.Label</div>
                        }
                    </div>

                    <StatusBadge Status="@session.Status" Class="dp-pos-status" />

                    @if (!confirming)
                    {
                        @* checkout-countdown.js replaces the whole line once the window closes, so it never
                           reads "Expires in expired". *@
                        <p class="text-xs text-slate-500 m-0" data-digipay-countdown="This price has expired.">
                            Expires in <span class="font-mono tabular-nums" data-digipay-expires="@session.ExpiresAt.ToString("o", CultureInfo.InvariantCulture)">—</span>
                        </p>
                    }

                    @* Cancelling voids the session on the server, so the customer can no longer pay it.
                       Not offered once the payment is in a block. *@
                    @if (CanCancelSale)
                    {
                        <button type="button" class="dp-pos-cancel mt-2 px-5 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-sm transition-colors"
                                @onclick="RequestCancelSale" disabled="@cancelling">
                            @(cancelling ? "Cancelling…" : "Cancel sale")
                        </button>
                    }
                    @if (cancelError != null)
                    {
                        <p class="dp-pos-error text-sm m-0" role="alert">@cancelError</p>
                    }
                </section>
            </main>
        }
        else if (screen == Screen.Result && session != null)
        {
            var state = CheckoutStates.For(resultStatus);
            var success = resultStatus == "confirmed";
            var hasFiat = session.FiatAmount is decimal && !string.IsNullOrEmpty(session.FiatCurrency);
            <main class="dp-pos-main flex-1 flex items-center justify-center p-6">
                <div class="dp-pos-result w-full max-w-lg bg-dgb-900 border border-dgb-800 rounded-3xl p-8 flex flex-col items-center gap-5 shadow-2xl text-center">
                    <span class="ui-receipt-seal dp-pos-seal @SealClass(state.Tone)" aria-hidden="true"><Icon Name="@state.Icon" Class="w-12 h-12" /></span>
                    <div>
                        <h2 class="text-3xl font-extrabold m-0">@state.Heading</h2>
                        <p class="text-sm text-slate-400 mt-2 m-0">@CashierExplanation(resultStatus)</p>
                    </div>
                    @if (success)
                    {
                        @* Fiat sale: the number the cashier rang up first, the DGB that arrived under it. *@
                        @if (hasFiat)
                        {
                            <div>
                                <div class="text-4xl font-bold tabular-nums">@FormatFiat(session.FiatAmount!.Value, session.FiatCurrency!) <span class="text-dgb-500">@session.FiatCurrency</span></div>
                                <div class="text-sm text-slate-400 mt-1">@FormatDgb(session.ReceivedSatoshis > 0 ? session.ReceivedSatoshis : session.AmountSatoshis) DGB</div>
                            </div>
                        }
                        else
                        {
                            <div class="text-4xl font-bold tabular-nums">@FormatDgb(session.ReceivedSatoshis > 0 ? session.ReceivedSatoshis : session.AmountSatoshis) <span class="text-dgb-500">DGB</span></div>
                        }
                    }
                    @if (resultStatus == "underpaid")
                    {
                        <dl class="ui-terminal-amounts">
                            <div><dt>Received</dt><dd class="font-mono tabular-nums">@FormatDgb(session.ReceivedSatoshis) DGB</dd></div>
                            <div>
                                <dt>Expected</dt>
                                <dd class="font-mono tabular-nums">@FormatDgb(session.AmountSatoshis) DGB</dd>
                                @if (hasFiat)
                                {
                                    <dd class="dp-pos-dd-sub">@FormatFiat(session.FiatAmount!.Value, session.FiatCurrency!) @session.FiatCurrency</dd>
                                }
                            </div>
                        </dl>
                    }
                    @if (!string.IsNullOrEmpty(session.PaidTxid))
                    {
                        <div class="font-mono text-[0.625rem] text-slate-500 break-all max-w-full">@session.PaidTxid</div>
                    }
                    <div class="dp-pos-result-actions">
                        @if (CanChargeAgain)
                        {
                            <button type="button" class="dp-pos-again py-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-extrabold rounded-2xl text-lg transition-colors"
                                    @onclick="ChargeAgainAsync" disabled="@busy">
                                <Icon Name="refresh" Class="w-5 h-5" />
                                <span>@(busy ? "Creating…" : "Charge again")</span>
                            </button>
                        }
                        <button type="button" class="py-4 bg-dgb-500 hover:bg-dgb-600 text-white font-extrabold rounded-2xl text-lg transition-colors"
                                @onclick="NewSale">New sale</button>
                    </div>
                    @if (success)
                    {
                        <p class="text-[0.6875rem] text-slate-500 m-0">Auto-returning in @autoReturnSeconds…</p>
                    }
                </div>
            </main>
        }
    }

@* Unpair confirmation *@
@if (showUnpair)
{
    <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6" @onclick="() => showUnpair = false">
        <div id="pos-unpair-dialog" class="dp-pos-dialog bg-dgb-900 border border-dgb-800 rounded-2xl p-6 max-w-sm w-full text-white" role="dialog" aria-modal="true" aria-labelledby="pos-unpair-title" @onclick:stopPropagation>
            <h3 id="pos-unpair-title" class="text-lg font-bold m-0 mb-2">Unpair this device?</h3>
            <p class="text-sm text-slate-400 m-0 mb-4">The stored API key will be forgotten on this tablet. Revoke it from the dashboard too if it's lost or stolen.</p>
            <div class="flex gap-2">
                <button type="button" class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" data-autofocus @onclick="() => showUnpair = false">Cancel</button>
                <button class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg text-sm" @onclick="UnpairAsync">Unpair</button>
            </div>
        </div>
    </div>
}

@* Shift close / end-of-day summary.
   Pulls from /v1/pay/pos/shift-report?since=<shiftStartedAt>. The "since"
   timestamp is kept in localStorage per-tablet so resetting the shift only
   affects this till, not the merchant's aggregate dashboard numbers. *@
@if (showShiftReport)
{
    <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6" @onclick="() => showShiftReport = false">
        <div id="pos-shift-dialog" class="dp-pos-dialog bg-dgb-900 border border-dgb-800 rounded-2xl p-6 max-w-md w-full text-white" role="dialog" aria-modal="true" aria-labelledby="pos-shift-title" @onclick:stopPropagation>
            <div class="flex items-start justify-between gap-2 mb-4">
                <div>
                    <h3 id="pos-shift-title" class="text-lg font-bold m-0">Shift summary</h3>
                    @if (shiftReport is not null)
                    {
                        <p class="text-xs text-slate-400 m-0 mt-0.5">@shiftReport.From.ToLocalTime().ToString("dd MMM, HH:mm") → @shiftReport.To.ToLocalTime().ToString("HH:mm")</p>
                    }
                </div>
                <button type="button" class="dp-pos-dialog-close text-slate-400 hover:text-white" @onclick="() => showShiftReport = false" aria-label="Close shift summary"><Icon Name="close" Class="w-5 h-5" /></button>
            </div>

            @if (shiftReportError is not null)
            {
                <p class="dp-pos-error text-sm m-0" role="alert">@shiftReportError</p>
            }
            else if (shiftReport is null)
            {
                <p class="text-sm text-slate-400 m-0">Loading…</p>
            }
            else
            {
                var totals = shiftReport.Totals;
                var outcomes = shiftReport.Outcomes;
                <div class="space-y-4">
                    @* Collected / totals block. DGB total is always shown (it's
                       the one number that survives across currencies); fiat
                       buckets are listed only when present so a DGB-only till
                       doesn't render an empty section. *@
                    <div>
                        <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400 mb-1">Collected</div>
                        <div class="text-3xl font-bold tabular-nums">@FormatDgb8(totals.CollectedDgb) <span class="text-dgb-500 text-xl">DGB</span></div>
                        <div class="text-xs text-slate-400 mt-0.5">across @outcomes.Collected @(outcomes.Collected == 1 ? "sale" : "sales")</div>
                        @if (totals.Fiat is { Count: > 0 })
                        {
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var kv in totals.Fiat.OrderBy(k => k.Key))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-800 text-slate-200 text-xs font-semibold tabular-nums">
                                        @FormatFiat(kv.Value, kv.Key) @kv.Key
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @if (totals.Tips is { Count: > 0 })
                    {
                        <div>
                            <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400 mb-1">Tips</div>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var kv in totals.Tips.OrderBy(k => k.Key))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 text-xs font-semibold tabular-nums border border-emerald-500/20">
                                        @FormatFiat(kv.Value, kv.Key) @kv.Key
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <div>
                        <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400 mb-1">Outcomes</div>
                        <div class="grid grid-cols-4 gap-2 text-center">
                            <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg py-1.5">
                                <div class="text-lg font-bold tabular-nums text-emerald-300">@outcomes.Collected</div>
                                <div class="text-[0.625rem] uppercase tracking-wider text-emerald-300/80">Paid</div>
                            </div>
                            <div class="bg-slate-800/60 border border-slate-700 rounded-lg py-1.5">
                                <div class="text-lg font-bold tabular-nums">@outcomes.Pending</div>
                                <div class="text-[0.625rem] uppercase tracking-wider text-slate-400">Pending</div>
                            </div>
                            <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg py-1.5">
                                <div class="text-lg font-bold tabular-nums text-amber-300">@outcomes.Underpaid</div>
                                <div class="text-[0.625rem] uppercase tracking-wider text-amber-300/80">Underpaid</div>
                            </div>
                            <div class="bg-slate-800/60 border border-slate-700 rounded-lg py-1.5">
                                <div class="text-lg font-bold tabular-nums">@outcomes.Expired</div>
                                <div class="text-[0.625rem] uppercase tracking-wider text-slate-400">Expired</div>
                            </div>
                        </div>
                    </div>

                    @* Missed revenue — only when there's something to show, so a
                       clean shift doesn't render a dead section. Same shape as
                       collected so the cashier can compare at a glance. *@
                    @if (shiftReport.Missed is { } missed
                        && (missed.Expired.Count > 0 || missed.Underpaid.Count > 0))
                    {
                        <div>
                            <div class="text-[0.6875rem] uppercase tracking-widest text-slate-400 mb-1">Missed revenue</div>
                            <div class="grid grid-cols-2 gap-2">
                                @if (missed.Expired.Count > 0)
                                {
                                    <div class="bg-slate-800/40 border border-slate-700/60 rounded-lg p-2">
                                        <div class="text-[0.625rem] uppercase tracking-wider text-slate-400 mb-0.5">Expired (@missed.Expired.Count)</div>
                                        <div class="text-sm font-bold tabular-nums">@FormatDgb8(missed.Expired.Dgb) <span class="text-slate-500 text-xs">DGB</span></div>
                                        @if (missed.Expired.Fiat is { Count: > 0 })
                                        {
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var kv in missed.Expired.Fiat.OrderBy(k => k.Key))
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-900 text-slate-300 text-[0.625rem] font-semibold tabular-nums">
                                                        @FormatFiat(kv.Value, kv.Key) @kv.Key
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (missed.Underpaid.Count > 0)
                                {
                                    <div class="bg-amber-500/5 border border-amber-500/20 rounded-lg p-2">
                                        <div class="text-[0.625rem] uppercase tracking-wider text-amber-300/80 mb-0.5">Underpaid (@missed.Underpaid.Count)</div>
                                        <div class="text-sm font-bold tabular-nums text-amber-200">@FormatDgb8(missed.Underpaid.Dgb) <span class="text-amber-300/70 text-xs">DGB</span></div>
                                        @if (missed.Underpaid.Fiat is { Count: > 0 })
                                        {
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var kv in missed.Underpaid.Fiat.OrderBy(k => k.Key))
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-200 text-[0.625rem] font-semibold tabular-nums">
                                                        @FormatFiat(kv.Value, kv.Key) @kv.Key
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="flex gap-2 mt-5">
                    <button class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" @onclick="() => showShiftReport = false">Close</button>
                    <button class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-lg text-sm" @onclick="StartNewShiftAsync">Start new shift</button>
                </div>
            }
        </div>
    </div>
}

@* PIN settings (set / change / remove).
   Kept as a dedicated modal so a busy cashier can't toggle security in passing —
   the "Save" button is only enabled when both fields match and length is valid. *@
@if (showPinSettings)
{
    <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6" @onclick="ClosePinSettings">
        <div id="pos-settings-dialog" class="dp-pos-dialog bg-dgb-900 border border-dgb-800 rounded-2xl p-6 max-w-sm w-full text-white" role="dialog" aria-modal="true" aria-labelledby="pos-settings-title" @onclick:stopPropagation>
            <h3 id="pos-settings-title" class="text-lg font-bold m-0 mb-1">@(hasPin ? "Change manager PIN" : "Set a manager PIN")</h3>
            <p class="text-sm text-slate-400 m-0 mb-4">
                A 4–8 digit PIN gates destructive actions on this tablet (right now: unpairing).
                The PIN never leaves the browser.
            </p>
            <label for="pos-pin-new" class="block text-xs font-semibold text-slate-300 mb-1">New PIN</label>
            <input id="pos-pin-new" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password"
                   maxlength="8"
                   class="w-full px-3 py-2.5 bg-slate-950 border border-dgb-800 rounded-lg text-white tracking-[0.4em] text-center mb-3"
                   @bind="pinNew" @bind:event="oninput" />
            <label for="pos-pin-confirm" class="block text-xs font-semibold text-slate-300 mb-1">Confirm PIN</label>
            <input id="pos-pin-confirm" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password"
                   maxlength="8"
                   class="w-full px-3 py-2.5 bg-slate-950 border border-dgb-800 rounded-lg text-white tracking-[0.4em] text-center mb-3"
                   @bind="pinConfirm" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(pinSettingsError))
            {
                <p class="dp-pos-error text-sm m-0 mb-3" role="alert">@pinSettingsError</p>
            }
            <div class="flex gap-2 mb-2">
                <button class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" @onclick="ClosePinSettings">Cancel</button>
                <button class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-400 disabled:bg-slate-700 disabled:text-slate-400 text-white font-semibold rounded-lg text-sm"
                        @onclick="SavePinAsync" disabled="@(!CanSavePin)">Save PIN</button>
            </div>
            @if (hasPin)
            {
                <button class="w-full py-2 text-xs font-semibold text-red-400 hover:text-red-300" @onclick="RemovePinAsync">Remove PIN</button>
            }
            @* Screen theme for this tablet (FR-013). Stored under the POS key, so it doesn't
               change the merchant's dashboard theme. Starts dark. *@
            <div class="border-t border-dgb-800 mt-4 pt-4">
                <p class="block text-xs font-semibold text-slate-300 mb-2">Screen theme</p>
                <ThemePicker />
            </div>
        </div>
    </div>
}

@* PIN challenge — shown before executing a guarded action.
   Currently only gates Unpair; structured so future actions (lock, switch store)
   can reuse it by setting pinChallengePending to a different callback. *@
@if (showPinChallenge)
{
    <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6" @onclick="CancelPinChallenge">
        <div id="pos-pin-dialog" class="dp-pos-dialog bg-dgb-900 border border-dgb-800 rounded-2xl p-6 max-w-sm w-full text-white" role="dialog" aria-modal="true" aria-labelledby="pos-pin-title" @onclick:stopPropagation>
            <h3 id="pos-pin-title" class="text-lg font-bold m-0 mb-1">Enter manager PIN</h3>
            <p id="pos-pin-prompt" class="text-sm text-slate-400 m-0 mb-4">@pinChallengePrompt</p>
            <label for="pos-pin-entry" class="sr-only">Manager PIN</label>
            <input id="pos-pin-entry" aria-describedby="pos-pin-prompt" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="off"
                   maxlength="8"
                   class="w-full px-3 py-2.5 bg-slate-950 border border-dgb-800 rounded-lg text-white tracking-[0.4em] text-center mb-3"
                   @bind="pinEntered" @bind:event="oninput"
                   @onkeydown="@(e => { if (e.Key == "Enter") _ = VerifyPinChallengeAsync(); })" />
            @if (!string.IsNullOrEmpty(pinChallengeError))
            {
                <p class="dp-pos-error text-sm m-0 mb-3" role="alert">@pinChallengeError</p>
            }
            <div class="flex gap-2">
                <button class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" @onclick="CancelPinChallenge">Cancel</button>
                <button class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-400 text-white font-semibold rounded-lg text-sm" @onclick="VerifyPinChallengeAsync">Continue</button>
            </div>
        </div>
    </div>
}

@* Modals live inside the .dp-pos root so they follow the POS screen theme. *@
@* Currency picker. Every till currency in one list; the amount is kept when it fits. *@
@if (showCurrencyPicker)
{
    <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6" @onclick="CloseCurrencyPicker">
        <div id="pos-currency-dialog" class="dp-pos-dialog bg-dgb-900 border border-dgb-800 rounded-2xl p-6 max-w-sm w-full text-white" role="dialog" aria-modal="true" aria-labelledby="pos-currency-title" @onclick:stopPropagation>
            <h3 id="pos-currency-title" class="text-lg font-bold m-0 mb-1">Till currency</h3>
            <p class="text-sm text-slate-400 m-0 mb-4">The amount you type is in this currency. Anything other than DGB is converted at the live price when you charge.</p>
            @if (pendingCurrency is not null)
            {
                <div class="ui-banner ui-banner-warning mb-3" role="alert">
                    <Icon Name="alert" Class="" />
                    <p>@amount @currency doesn't fit @pendingCurrency (@(DecimalsFor(pendingCurrency) == 0 ? "no decimals" : $"{DecimalsFor(pendingCurrency)} decimals")). Switching clears the amount.</p>
                </div>
                <div class="flex gap-2">
                    <button type="button" class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" data-autofocus @onclick="() => pendingCurrency = null">Keep @currency</button>
                    <button type="button" class="flex-1 py-2.5 bg-dgb-500 hover:bg-dgb-600 text-white font-semibold rounded-lg text-sm" @onclick="ConfirmCurrencySwitchAsync">Clear and switch</button>
                </div>
            }
            else
            {
                <div class="dp-pos-currency-list" role="group" aria-label="Currencies">
                    @foreach (var c in SupportedCurrencies)
                    {
                        var cur = c;
                        var selected = cur == currency;
                        <button type="button" class="dp-pos-currency-option @(selected ? "is-selected" : "")"
                                aria-pressed="@(selected ? "true" : "false")" data-autofocus="@(selected ? "" : null)"
                                @onclick="() => SelectCurrencyAsync(cur)">
                            <span class="dp-pos-currency-code">@cur</span>
                            <span class="dp-pos-currency-name">@CurrencyName(cur)</span>
                            @if (selected)
                            {
                                <Icon Name="check" Class="w-4 h-4" />
                            }
                        </button>
                    }
                </div>
                <button type="button" class="w-full mt-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-sm" @onclick="CloseCurrencyPicker">Close</button>
            }
        </div>
    </div>
}

@* Cancelling a sale whose payment is already on its way needs a second look: the money may still
   arrive, and the session can no longer be paid once it is voided. *@
<ConfirmDialog Open="@confirmCancelSeen" Title="Cancel this sale?" ConfirmLabel="Cancel sale" CancelLabel="Keep waiting"
               Busy="@cancelling" OnConfirm="CancelSaleAsync" OnCancel="() => confirmCancelSeen = false">
    A payment for this sale has already been detected. If you cancel, the sale is voided; any money that still arrives has to be refunded from the dashboard.
</ConfirmDialog>
</div>

@code {
    private enum Screen { Pair, Keypad, Waiting, Result }

    // Keypad layout — "." at bottom-left accepts a single decimal point, and
    // "back" is a soft backspace (keeps the keypad 3x4 without a clear button,
    // which staff kept mis-tapping on the prototype).
    private static readonly string[] KeypadKeys = new[]
    {
        "1","2","3",
        "4","5","6",
        "7","8","9",
        ".","0","back",
    };

    private Screen screen = Screen.Pair;
    private string pairMode = "code";
    private string pairCode = "";
    private string manualApiKey = "";
    private string manualStoreId = "";
    private string? pairError;

    private PairedDevice? device;
    private bool busy;

    // Keypad state — amount is stored as a string so we can display
    // the user's literal input (e.g. "10." → they're about to type decimals).
    private string amount = "";
    private string labelInput = "";
    private string? chargeError;

    // Currency mode. "DGB" means the cashier is typing a raw DGB amount
    // (8 decimals allowed). Anything else is a fiat code like "EUR" / "USD"
    // — the cashier types a fiat amount (2 decimals), we convert live using
    // the cached /v1/pay/public/price quote. Persisted in localStorage via
    // digipayPos.setCurrency so each tablet remembers its till currency.
    //
    // SupportedCurrencies is intentionally narrow and mirrors the server's
    // allow-list in PublicEndpoints so an operator can't pick a currency
    // the price endpoint will reject.
    private static readonly string[] SupportedCurrencies =
        new[] { "DGB", "USD", "EUR", "GBP", "CAD", "AUD", "JPY", "CHF", "PHP", "NGN", "ZAR" };
    private string currency = "DGB";
    private decimal? dgbPrice;          // null while loading or on error
    private DateTime? dgbPriceFetchedAt;
    private string? priceError;
    private System.Threading.Timer? priceTimer;

    private bool showCurrencyPicker;
    private string? pendingCurrency;    // a switch waiting for "Clear and switch"

    // The sale on screen (waiting or result). Kept on the result screen so "Charge again", the
    // fiat amount and the underpaid figures can be shown, and so a late payment can revive it.
    private CreatedSession? session;
    private string? qrDataUrl;

    // Live updates. One hub connection for the page; every watched session (the current sale and
    // recently expired ones) is subscribed on it. A dropped connection never shows a final state:
    // the page says "Reconnecting…" and polls over HTTP until live updates are back (as Checkout).
    private HubConnection? hub;
    private readonly CancellationTokenSource lifetime = new();
    private Task? pollLoop;
    private bool reconnecting;
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(10);
    private string? lastAnnouncedStatus;
    private int lastAnnouncedConfirmations;

    // Expired sales the till keeps an eye on. The server still reconciles a payment that lands
    // after expiry (InvoiceMonitor, days of grace); the till only needs to know for a while.
    private static readonly TimeSpan LatePaymentWatch = TimeSpan.FromMinutes(30);
    private readonly List<LateWatch> lateWatches = new();
    private string? latePaymentNotice;
    private sealed record LateWatch(string SessionId, string Description, DateTime Until);

    private bool cancelling;
    private bool confirmCancelSeen;
    private string? cancelError;

    private string? resultStatus;
    private int autoReturnSeconds = 5;
    private CancellationTokenSource? autoReturnCts;

    private DotNetObjectReference<Pos>? selfRef;
    private string? jsDialogId;
    private bool keysBound;

    private bool showUnpair;

    // Shift-report (end-of-day summary) state. shiftReport stays null until
    // the modal fetches — we use that as the "loading" signal in the UI.
    // shiftStartedAt is kept in localStorage (see pos-store.js) so "Start
    // new shift" resets the clock per-tablet without touching the API.
    private bool showShiftReport;
    private ShiftReport? shiftReport;
    private string? shiftReportError;

    // Manager PIN state. hasPin is mirrored from localStorage so the gear
    // icon can show "shield" when set and "settings" when not.
    private bool hasPin;
    private bool showPinSettings;
    private bool showPinChallenge;
    private string pinNew = "";
    private string pinConfirm = "";
    private string pinEntered = "";
    private string? pinSettingsError;
    private string? pinChallengeError;
    private string pinChallengePrompt = "";
    private Func<Task>? pinChallengePending;

    private bool CanSavePin =>
        !string.IsNullOrEmpty(pinNew)
        && pinNew.Length >= 4 && pinNew.Length <= 8
        && pinNew.All(char.IsDigit)
        && pinNew == pinConfirm;

    private bool IsFiat => currency != "DGB";

    // Decimal precision allowed in the current currency. DGB supports 8
    // (satoshi); fiat only needs 2; JPY has no sub-unit.
    private int MaxDecimals => DecimalsFor(currency);

    private static int DecimalsFor(string code) => code switch
    {
        "DGB" => 8,
        "JPY" => 0,
        _ => 2,
    };

    private bool HasAmount => decimal.TryParse(amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var a) && a > 0;
    private string FormattedAmount => string.IsNullOrEmpty(amount) ? "0" : amount;

    // Gratuity. Stored as an integer percentage of the subtotal so the rate is
    // obvious in receipts/reports. 0 = no tip. We only support presets for now
    // (10/15/20) — custom-amount / custom-% can be added later without schema
    // changes because the tip is folded into the total before it ever hits the
    // API.
    private static readonly int[] TipPresets = new[] { 0, 10, 15, 20 };
    private int tipPercent;

    private decimal? SubtotalDecimal =>
        decimal.TryParse(amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var v) && v > 0 ? v : null;

    // Tip is computed off the subtotal in whatever currency the cashier is in,
    // then rounded to the currency's display precision so "10% of 12.50 EUR"
    // is a clean 1.25 instead of banker-rounded nonsense.
    private decimal TipDecimal
    {
        get
        {
            if (tipPercent <= 0 || SubtotalDecimal is not decimal sub) return 0m;
            var raw = sub * tipPercent / 100m;
            return Math.Round(raw, MaxDecimals, MidpointRounding.AwayFromZero);
        }
    }

    private decimal? TotalDecimal => SubtotalDecimal is decimal sub ? sub + TipDecimal : null;

    // String form the "Charge" button actually commits. Uses the subtotal's
    // literal string when tipPercent=0 so we don't round-trip "12.5" → "12.50"
    // and surprise the cashier; otherwise formats the computed total.
    private string AmountForCharge
    {
        get
        {
            if (tipPercent == 0) return amount;
            if (TotalDecimal is decimal t)
            {
                return MaxDecimals == 0
                    ? t.ToString("0", CultureInfo.InvariantCulture)
                    : t.ToString("0." + new string('#', MaxDecimals), CultureInfo.InvariantCulture);
            }
            return amount;
        }
    }

    // Live DGB equivalent of the fiat amount the cashier has typed. Used for
    // the secondary readout on the keypad + for the charge payload. Returns
    // null if we don't have a price yet or the amount is empty / invalid.
    // When a tip is applied, converts the total (subtotal + tip) so what the
    // customer sees on the QR matches what their wallet will ask them to sign.
    private decimal? DgbEquivalent
    {
        get
        {
            if (!IsFiat || dgbPrice is not decimal p || p <= 0) return null;
            if (TotalDecimal is not decimal fiat || fiat <= 0) return null;
            // Round to 8dp (satoshi grid). Banker's rounding would bias us, so
            // use AwayFromZero — customers paying fiat-quoted invoices expect
            // "no less than" the quote, and InvoiceMonitor has a 1% slack
            // either way, so a half-sat rounding up can't trip underpayment.
            return Math.Round(fiat / p, 8, MidpointRounding.AwayFromZero);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncJsAsync();
        if (!firstRender) return;
        // Load a previously paired device from localStorage so returning
        // cashiers don't see the pair screen every session.
        var stored = await JS.InvokeAsync<PairedDevice?>("digipayPos.load");
        if (stored is { ApiKey.Length: > 0, StoreId.Length: > 0 })
        {
            device = stored;
            screen = Screen.Keypad;
        }
        hasPin = await JS.InvokeAsync<bool>("digipayPos.hasPin");
        // Remember the last-selected currency so a JPY till stays on JPY
        // across reloads.
        var storedCurrency = await JS.InvokeAsync<string?>("digipayPos.loadCurrency");
        if (!string.IsNullOrWhiteSpace(storedCurrency)
            && SupportedCurrencies.Contains(storedCurrency))
        {
            currency = storedCurrency;
        }
        if (IsFiat) _ = RefreshPriceAsync();
        StateHasChanged();
    }

    // Wires the hardware keyboard and the dialogs' focus handling (dialog.js) after each render.
    private async Task SyncJsAsync()
    {
        try
        {
            selfRef ??= DotNetObjectReference.Create(this);
            if (!keysBound)
            {
                keysBound = true;
                await JS.InvokeVoidAsync("digipayPos.bindKeys", selfRef);
            }

            // One dialog at a time: Escape closes it, focus moves to its first field and comes back
            // to where it was when it closes.
            var wanted = showPinChallenge ? "pos-pin-dialog"
                : showPinSettings ? "pos-settings-dialog"
                : showCurrencyPicker ? "pos-currency-dialog"
                : showShiftReport ? "pos-shift-dialog"
                : showUnpair ? "pos-unpair-dialog"
                : null;
            if (wanted == jsDialogId) return;
            if (jsDialogId is not null) await JS.InvokeVoidAsync("digipayDialog.close", jsDialogId);
            jsDialogId = wanted;
            if (wanted is not null) await JS.InvokeVoidAsync("digipayDialog.open", wanted, selfRef);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerendering */ }
    }

    /// <summary>Escape in an open dialog (dialog.js).</summary>
    [JSInvokable]
    public Task OnEscape() => InvokeAsync(() =>
    {
        if (showPinChallenge) CancelPinChallenge();
        else if (showPinSettings) ClosePinSettings();
        else if (showCurrencyPicker) CloseCurrencyPicker();
        else if (showShiftReport) showShiftReport = false;
        else if (showUnpair) showUnpair = false;
        StateHasChanged();
    });

    private bool AnyDialogOpen =>
        showPinChallenge || showPinSettings || showCurrencyPicker || showShiftReport || showUnpair || confirmCancelSeen;

    /// <summary>
    /// A key from a hardware keyboard while the keypad is showing and no text field has focus
    /// (pos-store.js filters the rest): digits, ".", Backspace, and Enter to charge.
    /// </summary>
    [JSInvokable]
    public Task OnKeypadKey(string key) => InvokeAsync(async () =>
    {
        if (screen != Screen.Keypad || AnyDialogOpen || busy) return;
        switch (key)
        {
            case "Enter":
                if (HasAmount) await ChargeAsync();
                break;
            case "Backspace":
                PressKey("back");
                break;
            case "." or ",":
                PressKey(".");
                break;
            case { Length: 1 } when char.IsAsciiDigit(key[0]):
                PressKey(key);
                break;
            default:
                return;
        }
        StateHasChanged();
    });

    private string KeyClass(string key) => key switch
    {
        "back" => "bg-slate-800 hover:bg-slate-700 text-slate-300",
        "." => "bg-slate-800 hover:bg-slate-700 text-slate-300",
        _ => "bg-dgb-900 hover:bg-dgb-800 border border-dgb-800 text-white",
    };

    private void PressKey(string key)
    {
        chargeError = null;
        if (key == "back")
        {
            if (amount.Length > 0) amount = amount[..^1];
            return;
        }
        if (key == ".")
        {
            // Currencies with no sub-unit (JPY) don't get a decimal point at all.
            if (MaxDecimals == 0) return;
            if (amount.Contains('.')) return;
            amount = amount.Length == 0 ? "0." : amount + ".";
            return;
        }
        // Numeric
        // Prevent leading-zero weirdness ("007" stays "7") but keep "0.x"
        if (amount == "0") { amount = key == "0" ? "0" : key; return; }
        // Cap decimal precision per currency (8 for DGB, 2 for fiat, 0 for JPY).
        var dot = amount.IndexOf('.');
        if (dot >= 0 && amount.Length - dot - 1 >= MaxDecimals) return;
        // Cap total length to avoid absurd inputs
        if (amount.Length >= 16) return;
        amount += key;
    }

    private void OpenCurrencyPicker()
    {
        pendingCurrency = null;
        showCurrencyPicker = true;
    }

    private void CloseCurrencyPicker()
    {
        pendingCurrency = null;
        showCurrencyPicker = false;
    }

    /// <summary>True when the typed amount is valid in a currency with this many decimals.</summary>
    private bool AmountFits(int decimals)
    {
        var dot = amount.IndexOf('.');
        if (dot < 0) return true;
        return decimals > 0 && amount.Length - dot - 1 <= decimals;
    }

    // Picking a currency keeps the typed amount (and tip) when it fits the new currency's
    // precision; otherwise the picker asks before clearing it, so nothing vanishes silently.
    private async Task SelectCurrencyAsync(string code)
    {
        if (code == currency) { CloseCurrencyPicker(); return; }
        if (!AmountFits(DecimalsFor(code))) { pendingCurrency = code; return; }
        await SwitchCurrencyAsync(code, clearAmount: false);
    }

    private Task ConfirmCurrencySwitchAsync() =>
        pendingCurrency is { } code ? SwitchCurrencyAsync(code, clearAmount: true) : Task.CompletedTask;

    private async Task SwitchCurrencyAsync(string code, bool clearAmount)
    {
        currency = code;
        if (clearAmount)
        {
            amount = "";
            tipPercent = 0;
        }
        else if (amount.EndsWith('.') && MaxDecimals == 0)
        {
            amount = amount.TrimEnd('.');
        }
        chargeError = null;
        CloseCurrencyPicker();
        dgbPrice = null;
        priceError = null;
        try { await JS.InvokeVoidAsync("digipayPos.saveCurrency", currency); } catch (JSException) { }
        if (IsFiat) _ = RefreshPriceAsync();
        else StopPriceTimer();
    }

    private static string CurrencyName(string code) => code switch
    {
        "DGB" => "DigiByte",
        "USD" => "US dollar",
        "EUR" => "Euro",
        "GBP" => "British pound",
        "CAD" => "Canadian dollar",
        "AUD" => "Australian dollar",
        "JPY" => "Japanese yen",
        "CHF" => "Swiss franc",
        "PHP" => "Philippine peso",
        "NGN" => "Nigerian naira",
        "ZAR" => "South African rand",
        _ => code,
    };

    // Shrinks the big readout for long numbers so it never overflows its panel.
    private static string AmountSizeClass(string text) => text.Length switch
    {
        > 16 => "is-xlong",
        > 11 => "is-long",
        _ => "",
    };

    private void SetTip(int percent)
    {
        // Tapping the already-active preset clears it (acts as a toggle). Lets
        // the cashier "unselect" 15% without a dedicated clear button.
        tipPercent = tipPercent == percent ? 0 : percent;
        chargeError = null;
    }

    // Formats a number using the current currency's display precision, without
    // trailing zeros except for JPY where we always show integers.
    private string FormatAmount(decimal value) => MaxDecimals switch
    {
        0 => value.ToString("0", CultureInfo.InvariantCulture),
        _ => value.ToString("0." + new string('#', MaxDecimals), CultureInfo.InvariantCulture),
    };

    private async Task RefreshPriceAsync()
    {
        if (!IsFiat) return;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var resp = await http.GetAsync($"/v1/pay/public/price?currency={currency.ToLowerInvariant()}");
            if (!resp.IsSuccessStatusCode)
            {
                priceError = "Price feed unavailable — switch to DGB or try again.";
                dgbPrice = null;
                return;
            }
            var body = await resp.Content.ReadFromJsonAsync<PriceQuote>();
            if (body is null || body.DgbPrice <= 0)
            {
                priceError = "Price feed returned nothing.";
                dgbPrice = null;
                return;
            }
            dgbPrice = body.DgbPrice;
            dgbPriceFetchedAt = body.FetchedAt;
            priceError = null;
            StartPriceTimer();
        }
        catch (Exception ex)
        {
            priceError = $"Price feed error: {ex.Message}";
            dgbPrice = null;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartPriceTimer()
    {
        // Refresh every 60s, matching the server's fresh cache window. The
        // server single-flights concurrent requests, so even a busy fleet of
        // tablets costs CoinGecko at most 1 call/currency/minute.
        priceTimer ??= new System.Threading.Timer(async _ =>
        {
            if (IsFiat && screen == Screen.Keypad) await RefreshPriceAsync();
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private void StopPriceTimer()
    {
        priceTimer?.Dispose();
        priceTimer = null;
    }

    private async Task ClaimPairingAsync()
    {
        pairError = null;
        busy = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.PostAsJsonAsync("/v1/pay/pos/claim", new { code = pairCode.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                // The API surfaces a structured `error`/`reason` for claim
                // failures so we can render typo-vs-expired distinctly.
                ClaimErrorDto? err = null;
                try { err = await response.Content.ReadFromJsonAsync<ClaimErrorDto>(); } catch { }
                pairError = !string.IsNullOrWhiteSpace(err?.Error)
                    ? err!.Error
                    : $"Pairing failed ({(int)response.StatusCode}).";
                return;
            }
            var dto = await response.Content.ReadFromJsonAsync<ClaimResponse>();
            if (dto is null) { pairError = "Pairing failed — empty response."; return; }
            await SaveDeviceAsync(new PairedDevice(
                dto.ApiKey, dto.StoreId, dto.StoreName,
                dto.MerchantName, dto.DeviceLabel));
            screen = Screen.Keypad;
        }
        catch (Exception ex) { pairError = $"Pairing failed: {ex.Message}"; }
        finally { busy = false; }
    }

    private sealed record ClaimErrorDto(string? Error, string? Reason);

    private async Task ApplyManualKeyAsync()
    {
        pairError = null;
        busy = true;
        try
        {
            var key = manualApiKey.Trim();
            if (!key.StartsWith("dgp_")) { pairError = "API key should start with \"dgp_\"."; return; }
            var http = HttpFactory.CreateClient("PayApi");
            // Resolve the merchant + stores for this key so we can prefill
            // name/store info without asking the user to type them.
            var req = new HttpRequestMessage(HttpMethod.Get, "/v1/pay/me");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", key);
            var resp = await http.SendAsync(req);
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            { pairError = "That API key was rejected."; return; }
            if (!resp.IsSuccessStatusCode)
            { pairError = $"Could not verify key ({(int)resp.StatusCode})."; return; }

            var me = await resp.Content.ReadFromJsonAsync<MeResponse>();
            var stores = me?.Stores ?? new();
            if (stores.Count == 0) { pairError = "This account has no stores yet."; return; }

            var targetId = string.IsNullOrWhiteSpace(manualStoreId) ? stores[0].Id : manualStoreId.Trim();
            var target = stores.FirstOrDefault(s => s.Id == targetId);
            if (target is null) { pairError = "Store ID not found for this account."; return; }

            await SaveDeviceAsync(new PairedDevice(
                key, target.Id, target.Name, me?.DisplayName ?? "", "Manual pairing"));
            screen = Screen.Keypad;
        }
        catch (Exception ex) { pairError = $"Could not verify key: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task SaveDeviceAsync(PairedDevice d)
    {
        device = d;
        await JS.InvokeVoidAsync("digipayPos.save", d);
    }

    private async Task ChargeAsync()
    {
        chargeError = null;
        if (!HasAmount || device is null) return;

        // In fiat mode the cashier typed a fiat amount — convert to DGB for
        // the on-chain invoice and stash the fiat context on the session so
        // the dashboard / receipt / CSV can show both. When a tip is applied
        // it's already folded into TotalDecimal / DgbEquivalent, so the
        // conversion below uses the combined number.
        decimal dgbAmount;
        decimal? fiatAmount = null;
        string? fiatCurrency = null;
        decimal? priceSnapshot = null;
        if (IsFiat)
        {
            if (DgbEquivalent is not decimal d || TotalDecimal is not decimal totalFiat)
            {
                chargeError = priceError ?? "Price feed unavailable — cannot charge in fiat.";
                return;
            }
            dgbAmount = d;
            fiatAmount = totalFiat;
            fiatCurrency = currency;
            priceSnapshot = dgbPrice;
        }
        else
        {
            dgbAmount = decimal.Parse(AmountForCharge, CultureInfo.InvariantCulture);
        }

        // When tipped, annotate the session label so the breakdown survives in
        // the dashboard, webhooks, exports, and receipts without needing an
        // extra column on PaySession. Keeps the tip visible to the merchant
        // even though the on-chain amount is "total only".
        string? label = string.IsNullOrWhiteSpace(labelInput) ? null : labelInput.Trim();
        if (tipPercent > 0 && SubtotalDecimal is decimal subtotalForLabel)
        {
            var tipNote = $"Tip {tipPercent}% ({FormatAmount(TipDecimal)} {currency})";
            label = string.IsNullOrEmpty(label) ? tipNote : $"{label} · {tipNote}";
        }

        busy = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = new HttpRequestMessage(HttpMethod.Post, "/v1/pay/sessions")
            {
                Content = JsonContent.Create(new
                {
                    amount = dgbAmount,
                    storeId = device.StoreId,
                    label,
                    fiatCurrency,
                    fiatAmount,
                    dgbPriceAtCreation = priceSnapshot,
                }),
            };
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            var resp = await http.SendAsync(req);
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                chargeError = "Pairing was revoked — unpair and re-pair this device.";
                return;
            }
            if (!resp.IsSuccessStatusCode)
            {
                chargeError = $"Could not create session ({(int)resp.StatusCode}).";
                return;
            }
            var created = await resp.Content.ReadFromJsonAsync<CreatedSession>();
            if (created is null) { chargeError = "Empty response from server."; return; }
            autoReturnCts?.Cancel();
            session = created;
            resultStatus = null;
            cancelError = null;
            lastAnnouncedStatus = created.Status;
            lastAnnouncedConfirmations = created.Confirmations;
            qrDataUrl = GenerateQr(created.Uri);
            screen = Screen.Waiting;
        }
        catch (Exception ex) { chargeError = $"Failed: {ex.Message}"; }
        finally { busy = false; }

        if (screen == Screen.Waiting && session is not null)
        {
            StateHasChanged();
            await WatchAsync(session.Id);
        }
    }

    // ----- Live updates -------------------------------------------------------------------

    private IEnumerable<string> WatchedSessionIds()
    {
        if (session is not null) yield return session.Id;
        foreach (var w in lateWatches)
            if (w.SessionId != session?.Id) yield return w.SessionId;
    }

    private bool HasAnythingToWatch
    {
        get
        {
            PruneLateWatches();
            return (session is not null && !CheckoutStates.IsFinal(session.Status)) || lateWatches.Count > 0;
        }
    }

    private void PruneLateWatches() => lateWatches.RemoveAll(w => w.Until <= DateTime.UtcNow);

    // Starts (or reuses) the page's hub connection and subscribes to a session. A status change
    // between creating the session and subscribing is caught by reading it once more afterwards.
    private async Task WatchAsync(string sessionId)
    {
        if (hub is null)
        {
            hub = new HubConnectionBuilder()
                .WithUrl($"{PayApi.Value}/hubs/checkout")
                .WithAutomaticReconnect()
                .Build();
            hub.On<StatusUpdate>("StatusChanged", OnStatusChangedAsync);
            hub.Reconnecting += _ => SetReconnectingAsync(true);
            hub.Reconnected += async _ =>
            {
                await SubscribeAllAsync();
                await RefreshWatchedAsync(); // catch anything that happened while we were away
                await SetReconnectingAsync(false);
            };
            hub.Closed += async _ =>
            {
                // Automatic reconnect gave up. Keep watching over plain HTTP; a dropped connection
                // never ends a sale on its own.
                if (lifetime.IsCancellationRequested) return;
                await SetReconnectingAsync(true);
                StartPolling();
            };
        }

        try
        {
            if (hub.State == HubConnectionState.Disconnected)
            {
                await hub.StartAsync(lifetime.Token);
                await SubscribeAllAsync();
            }
            else if (hub.State == HubConnectionState.Connected)
            {
                await hub.InvokeAsync("SubscribeToSession", sessionId, lifetime.Token);
            }
            // Connecting / Reconnecting: Reconnected re-subscribes everything, and polling covers us.
            await RefreshSessionAsync(sessionId);
            if (hub.State != HubConnectionState.Connected)
            {
                await SetReconnectingAsync(true);
                StartPolling();
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "POS live updates unavailable for {SessionId}; polling instead", sessionId);
            await SetReconnectingAsync(true);
            await RefreshSessionAsync(sessionId);
            StartPolling();
        }
    }

    private async Task SubscribeAllAsync()
    {
        if (hub is null) return;
        foreach (var id in WatchedSessionIds().ToList())
            await hub.InvokeAsync("SubscribeToSession", id, lifetime.Token);
    }

    private void StartPolling()
    {
        if (pollLoop is { IsCompleted: false }) return;
        pollLoop = PollAsync();
    }

    private async Task PollAsync()
    {
        var delay = PollEvery;
        while (!lifetime.IsCancellationRequested && HasAnythingToWatch)
        {
            try { await Task.Delay(delay, lifetime.Token); }
            catch (OperationCanceledException) { return; }

            await RefreshWatchedAsync();

            // Try to get live updates back, backing off up to a minute.
            if (hub is not null && hub.State == HubConnectionState.Disconnected)
            {
                try
                {
                    await hub.StartAsync(lifetime.Token);
                    await SubscribeAllAsync();
                    await SetReconnectingAsync(false);
                    return;
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch { delay = TimeSpan.FromSeconds(Math.Min(60, delay.TotalSeconds * 2)); }
            }
            else if (hub is not null && hub.State == HubConnectionState.Connected)
            {
                await SetReconnectingAsync(false);
                return;
            }
        }
        await SetReconnectingAsync(false);
    }

    private async Task RefreshWatchedAsync()
    {
        foreach (var id in WatchedSessionIds().ToList())
            await RefreshSessionAsync(id);
    }

    // Re-reads one session over HTTP (the public read the checkout uses). Only the server's answer
    // can move the till to a final state.
    private async Task RefreshSessionAsync(string sessionId)
    {
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.GetFromJsonAsync<SessionEnvelope>($"/v1/pay/sessions/{Uri.EscapeDataString(sessionId)}", lifetime.Token);
            if (response?.Session is { } s)
                await OnStatusChangedAsync(new StatusUpdate(s.Id, s.Status, s.ReceivedSatoshis, s.Confirmations, s.PaidTxid));
        }
        catch { /* still offline: keep the last known state */ }
    }

    private async Task SetReconnectingAsync(bool value)
    {
        if (reconnecting == value) return;
        await InvokeAsync(() =>
        {
            reconnecting = value;
            if (value && screen == Screen.Waiting)
                Announcer.Announce("Reconnecting. The payment is still being watched.");
            StateHasChanged();
        });
    }

    private async Task OnStatusChangedAsync(StatusUpdate u)
    {
        await InvokeAsync(async () =>
        {
            if (session is not null && session.Id == u.SessionId) await ApplyToCurrentAsync(u);
            else if (lateWatches.FirstOrDefault(w => w.SessionId == u.SessionId) is { } late) await ApplyLateAsync(late, u.Status);
        });
    }

    private async Task ApplyToCurrentAsync(StatusUpdate u)
    {
        if (session is null) return;
        var wasExpiredResult = screen == Screen.Result && resultStatus == "expired";
        session = session with
        {
            Status = u.Status,
            ReceivedSatoshis = u.ReceivedSatoshis,
            Confirmations = u.Confirmations,
            PaidTxid = u.Txid ?? session.PaidTxid,
        };

        if (u.Status != lastAnnouncedStatus)
        {
            lastAnnouncedStatus = u.Status;
            lastAnnouncedConfirmations = u.Confirmations;
            var announcement = CheckoutStates.For(u.Status).Announcement;
            if (announcement is not null) Announcer.Announce(announcement, assertive: u.Status is "underpaid");
        }
        else if (u.Status == "paid" && u.Confirmations > lastAnnouncedConfirmations)
        {
            lastAnnouncedConfirmations = u.Confirmations;
            Announcer.Announce($"{u.Confirmations} of {CheckoutStates.ConfirmationsRequired} confirmations.");
        }

        if (wasExpiredResult && u.Status != "expired")
        {
            // A late payment on the sale still on screen: say so, and follow it to the end.
            lateWatches.RemoveAll(w => w.SessionId == session.Id);
            ShowLateNotice(u.Status, Describe(session));
        }

        if (CheckoutStates.IsFinal(u.Status))
        {
            if (screen != Screen.Result || resultStatus != u.Status) await ShowResultAsync(u.Status);
            else StateHasChanged();
        }
        else
        {
            if (screen == Screen.Result) { autoReturnCts?.Cancel(); screen = Screen.Waiting; resultStatus = null; }
            StateHasChanged();
        }
    }

    private Task ApplyLateAsync(LateWatch late, string status)
    {
        if (status is "expired" or "voided" or "pending") return Task.CompletedTask;
        lateWatches.Remove(late);
        ShowLateNotice(status, late.Description);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ShowLateNotice(string status, string description)
    {
        latePaymentNotice = status == "underpaid"
            ? $"Late partial payment received for {description}. Check the dashboard."
            : $"Late payment received for {description}.";
        Announcer.Announce(latePaymentNotice, assertive: true);
        _ = BeepAsync();
    }

    private void DismissLateNotice() => latePaymentNotice = null;

    private async Task BeepAsync()
    {
        try { await JS.InvokeVoidAsync("digipayPos.beep"); } catch { }
    }

    // How a sale is named in a late-payment notice: its label, else its amount.
    private static string Describe(CreatedSession s)
    {
        var label = s.Label;
        if (!string.IsNullOrWhiteSpace(label))
        {
            // Drop the tip annotation ChargeAsync appends; the cashier typed the first part.
            var cut = label.IndexOf(" · Tip ", StringComparison.Ordinal);
            if (cut > 0) label = label[..cut];
            if (!label.StartsWith("Tip ", StringComparison.Ordinal)) return label;
        }
        return s.FiatAmount is decimal fa && !string.IsNullOrEmpty(s.FiatCurrency)
            ? $"the {FormatFiat(fa, s.FiatCurrency)} {s.FiatCurrency} sale"
            : $"the {FormatDgb(s.AmountSatoshis)} DGB sale";
    }

    private async Task ShowResultAsync(string status)
    {
        resultStatus = status;
        screen = Screen.Result;
        cancelError = null;
        confirmCancelSeen = false;
        StateHasChanged();

        if (status == "expired" && session is not null)
        {
            // Keep watching: a payment can still land after the price window closed.
            lateWatches.RemoveAll(w => w.SessionId == session.Id);
            lateWatches.Add(new LateWatch(session.Id, Describe(session), DateTime.UtcNow + LatePaymentWatch));
        }

        if (status == "confirmed")
        {
            await BeepAsync();
            autoReturnCts?.Cancel();
            autoReturnCts = new CancellationTokenSource();
            var ct = autoReturnCts.Token;
            autoReturnSeconds = 5;
            _ = Task.Run(async () =>
            {
                try
                {
                    for (var i = 5; i > 0; i--)
                    {
                        autoReturnSeconds = i;
                        await InvokeAsync(StateHasChanged);
                        await Task.Delay(1000, ct);
                    }
                    await InvokeAsync(NewSale);
                }
                catch (TaskCanceledException) { /* cancelled — operator hit New sale */ }
            }, ct);
        }
    }

    // ----- Cancelling a sale --------------------------------------------------------------

    /// <summary>Not once the payment is in a block: from then on it is the merchant's money.</summary>
    private bool CanCancelSale => session is { Status: "pending" or "seen" };

    private bool CanChargeAgain => resultStatus is "expired" or "underpaid" or "voided";

    private Task RequestCancelSale()
    {
        cancelError = null;
        if (session?.Status == "seen")
        {
            confirmCancelSeen = true;
            return Task.CompletedTask;
        }
        return CancelSaleAsync();
    }

    // Voids the session on the server so the customer can no longer pay it (the POS key is a
    // merchant API key, so POST /v1/pay/sessions/{id}/void accepts it).
    private async Task CancelSaleAsync()
    {
        if (session is null || device is null) return;
        var target = session;
        cancelling = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = new HttpRequestMessage(HttpMethod.Post, $"/v1/pay/sessions/{Uri.EscapeDataString(target.Id)}/void")
            {
                Content = JsonContent.Create(new { note = "Cancelled at the till" }),
            };
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            var resp = await http.SendAsync(req, lifetime.Token);
            if (resp.IsSuccessStatusCode)
            {
                Announcer.Announce("Sale cancelled.");
                confirmCancelSeen = false;
                session = null;
                qrDataUrl = null;
                tipPercent = 0;
                screen = Screen.Keypad;
                return;
            }
            confirmCancelSeen = false;
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // Paid (or otherwise final) in the meantime: show what really happened.
                cancelError = "This sale can no longer be cancelled.";
                await RefreshSessionAsync(target.Id);
                return;
            }
            cancelError = resp.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Pairing was revoked — the sale could not be cancelled."
                : $"Could not cancel the sale ({(int)resp.StatusCode}). Try again.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "POS could not void {SessionId}", target.Id);
            confirmCancelSeen = false;
            cancelError = "Could not reach DigiPay to cancel the sale. Check the connection and try again.";
        }
        finally { cancelling = false; }
    }

    // Same amount, label and tip as the sale on screen, at a fresh price.
    private async Task ChargeAgainAsync()
    {
        if (busy) return;
        autoReturnCts?.Cancel();
        if (IsFiat) await RefreshPriceAsync();
        await ChargeAsync();
        if (screen == Screen.Result && chargeError is not null)
        {
            // Couldn't create it: back to the keypad, where the amount is ready and the error shows.
            screen = Screen.Keypad;
        }
    }

    private void NewSale()
    {
        autoReturnCts?.Cancel();
        amount = "";
        labelInput = "";
        tipPercent = 0;
        session = null;
        qrDataUrl = null;
        resultStatus = null;
        cancelError = null;
        screen = Screen.Keypad;
        StateHasChanged();
    }

    private Task ShowUnpairAsync()
    {
        // If a manager PIN is set, require it before even showing the confirm
        // dialog. Keeps staff from accidentally (or deliberately) disarming
        // the tablet while the owner is away.
        if (hasPin)
        {
            return PromptPinAsync("Enter the manager PIN to unpair this device.", () =>
            {
                showUnpair = true;
                StateHasChanged();
                return Task.CompletedTask;
            });
        }
        showUnpair = true;
        return Task.CompletedTask;
    }

    private async Task OpenShiftReportAsync()
    {
        if (device is null) return;
        // Reset state every time so a stale report from a previous open never
        // flashes. Show the modal immediately and let the fetch populate.
        shiftReport = null;
        shiftReportError = null;
        showShiftReport = true;
        StateHasChanged();

        try
        {
            var since = await JS.InvokeAsync<string?>("digipayPos.loadShiftStart");
            var http = HttpFactory.CreateClient("PayApi");
            var url = $"/v1/pay/pos/shift-report?storeId={Uri.EscapeDataString(device.StoreId)}";
            if (!string.IsNullOrWhiteSpace(since))
                url += $"&since={Uri.EscapeDataString(since)}";
            var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", device.ApiKey);
            var resp = await http.SendAsync(req);
            if (!resp.IsSuccessStatusCode)
            {
                shiftReportError = $"Could not load report ({(int)resp.StatusCode}).";
                return;
            }
            shiftReport = await resp.Content.ReadFromJsonAsync<ShiftReport>();
            if (shiftReport is null) shiftReportError = "Empty response from server.";
        }
        catch (Exception ex) { shiftReportError = $"Failed: {ex.Message}"; }
    }

    private async Task StartNewShiftAsync()
    {
        // Stamp "now" so the next report only shows sales from this moment
        // onward. Per-tablet by design — the dashboard keeps the merchant-
        // wide picture, this is purely a cashier convenience.
        var nowIso = DateTime.UtcNow.ToString("o", CultureInfo.InvariantCulture);
        await JS.InvokeVoidAsync("digipayPos.saveShiftStart", nowIso);
        showShiftReport = false;
        shiftReport = null;
    }

    private void OpenPinSettings()
    {
        pinNew = "";
        pinConfirm = "";
        pinSettingsError = null;

        // If a PIN already exists, the "Change" flow must first verify the
        // old PIN so a walk-up attacker can't silently rotate it.
        if (hasPin)
        {
            _ = PromptPinAsync("Enter the current manager PIN to change it.", () =>
            {
                showPinSettings = true;
                StateHasChanged();
                return Task.CompletedTask;
            });
            return;
        }
        showPinSettings = true;
    }

    private void ClosePinSettings()
    {
        showPinSettings = false;
        pinNew = "";
        pinConfirm = "";
        pinSettingsError = null;
    }

    private async Task SavePinAsync()
    {
        pinSettingsError = null;
        if (!CanSavePin)
        {
            pinSettingsError = "PIN must be 4–8 digits and match in both fields.";
            return;
        }
        var ok = await JS.InvokeAsync<bool>("digipayPos.setPin", pinNew);
        if (!ok) { pinSettingsError = "Could not save PIN — try again."; return; }
        hasPin = true;
        ClosePinSettings();
    }

    private async Task RemovePinAsync()
    {
        // Removing a PIN is itself a guarded action — require the current PIN
        // before we wipe it. Same reasoning as change-PIN.
        await JS.InvokeVoidAsync("digipayPos.clearPin");
        hasPin = false;
        ClosePinSettings();
    }

    private Task PromptPinAsync(string prompt, Func<Task> onSuccess)
    {
        pinChallengePrompt = prompt;
        pinChallengeError = null;
        pinEntered = "";
        pinChallengePending = onSuccess;
        showPinChallenge = true;
        return Task.CompletedTask;
    }

    private void CancelPinChallenge()
    {
        showPinChallenge = false;
        pinChallengePending = null;
        pinEntered = "";
        pinChallengeError = null;
    }

    private async Task VerifyPinChallengeAsync()
    {
        pinChallengeError = null;
        var ok = await JS.InvokeAsync<bool>("digipayPos.verifyPin", pinEntered);
        if (!ok) { pinChallengeError = "Incorrect PIN."; return; }
        var pending = pinChallengePending;
        CancelPinChallenge();
        if (pending != null) await pending();
    }

    private async Task UnpairAsync()
    {
        showUnpair = false;
        await JS.InvokeVoidAsync("digipayPos.clear");
        device = null;
        pairCode = "";
        manualApiKey = "";
        manualStoreId = "";
        screen = Screen.Pair;
    }

    private static string GenerateQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.H);
        using var qr = new QRCoder.PngByteQRCode(data);
        return $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(8))}";
    }

    private static string FormatDgb(long sats) =>
        (sats / 100_000_000m).ToString("0.########", CultureInfo.InvariantCulture);

    private static string FormatDgb8(decimal dgb) =>
        dgb.ToString("0.########", CultureInfo.InvariantCulture);

    // What the customer sees: whole yen, two decimals for every other fiat currency.
    private static string FormatFiat(decimal value, string? code) =>
        value.ToString(string.Equals(code, "JPY", StringComparison.OrdinalIgnoreCase) ? "0" : "0.00", CultureInfo.InvariantCulture);

    private static string SealClass(BadgeTone tone) => tone switch
    {
        BadgeTone.Success => "",
        BadgeTone.Danger => "is-danger",
        BadgeTone.Refund => "is-refund",
        BadgeTone.Info => "is-pending",
        _ => "is-neutral",
    };

    // The result screen talks to the cashier; CheckoutStates' explanations talk to a shopper.
    private static string CashierExplanation(string? status) => status switch
    {
        "confirmed" => "Thank the customer — all done.",
        "underpaid" => "Less than the full amount arrived. Collect the difference with a new sale, or refund what arrived from the dashboard.",
        "expired" => "No payment arrived in time. Charge again for a fresh price; if a late payment lands, this till will tell you.",
        "voided" => "This sale was cancelled, so it can't be paid. Nothing was charged.",
        "refunded" => "This payment was refunded from the dashboard.",
        _ => CheckoutStates.For(status).Explanation,
    };

    public async ValueTask DisposeAsync()
    {
        autoReturnCts?.Cancel();
        lifetime.Cancel();
        StopPriceTimer();
        try { if (keysBound) await JS.InvokeVoidAsync("digipayPos.unbindKeys"); } catch { }
        try { if (jsDialogId is not null) await JS.InvokeVoidAsync("digipayDialog.close", jsDialogId); } catch { }
        if (hub != null) { try { await hub.DisposeAsync(); } catch { } }
        selfRef?.Dispose();
        lifetime.Dispose();
    }

    // DTOs
    public record PairedDevice(
        [property: JsonPropertyName("apiKey")] string ApiKey,
        [property: JsonPropertyName("storeId")] string StoreId,
        [property: JsonPropertyName("storeName")] string StoreName,
        [property: JsonPropertyName("merchantName")] string MerchantName,
        [property: JsonPropertyName("deviceLabel")] string DeviceLabel);

    public record ClaimResponse(
        string ApiKey, string Prefix, string MerchantId, string MerchantName,
        string StoreId, string StoreName, string DeviceLabel);

    public record MeStoreDto(string Id, string Name);
    public record MeResponse(string Id, string DisplayName, List<MeStoreDto> Stores);

    public record CreatedSession(
        string Id, string Address, long AmountSatoshis, decimal Amount,
        string? FiatCurrency, decimal? FiatAmount, string? Label, string? Memo,
        string Status, DateTime CreatedAt, DateTime ExpiresAt,
        long ReceivedSatoshis, int Confirmations, string? PaidTxid,
        string Uri, string CheckoutUrl);

    public record StatusUpdate(string SessionId, string Status, long ReceivedSatoshis, int Confirmations, string? Txid);

    // GET /v1/pay/sessions/{id}: the fields the till needs to follow a sale.
    public record SessionEnvelope(SessionStatusDto Session);
    public record SessionStatusDto(string Id, string Status, long ReceivedSatoshis, int Confirmations, string? PaidTxid);

    public record PriceQuote(
        [property: JsonPropertyName("currency")] string Currency,
        [property: JsonPropertyName("dgbPrice")] decimal DgbPrice,
        [property: JsonPropertyName("fetchedAt")] DateTime FetchedAt);

    // /v1/pay/pos/shift-report payload. Flattened to what the modal needs;
    // deliberately loose on Fiat/Tips — they're optional dictionaries keyed
    // by currency code ("EUR" → 23.00).
    public record ShiftReport(
        [property: JsonPropertyName("from")] DateTime From,
        [property: JsonPropertyName("to")] DateTime To,
        [property: JsonPropertyName("storeId")] string StoreId,
        [property: JsonPropertyName("totals")] ShiftTotals Totals,
        [property: JsonPropertyName("missed")] ShiftMissed? Missed,
        [property: JsonPropertyName("outcomes")] ShiftOutcomes Outcomes);

    public record ShiftTotals(
        [property: JsonPropertyName("collectedCount")] int CollectedCount,
        [property: JsonPropertyName("collectedDgb")] decimal CollectedDgb,
        [property: JsonPropertyName("fiat")] Dictionary<string, decimal>? Fiat,
        [property: JsonPropertyName("tips")] Dictionary<string, decimal>? Tips);

    public record ShiftMissed(
        [property: JsonPropertyName("expired")] ShiftMissedBucket Expired,
        [property: JsonPropertyName("underpaid")] ShiftMissedBucket Underpaid);

    public record ShiftMissedBucket(
        [property: JsonPropertyName("count")] int Count,
        [property: JsonPropertyName("dgb")] decimal Dgb,
        [property: JsonPropertyName("fiat")] Dictionary<string, decimal>? Fiat);

    public record ShiftOutcomes(
        [property: JsonPropertyName("collected")] int Collected,
        [property: JsonPropertyName("expired")] int Expired,
        [property: JsonPropertyName("underpaid")] int Underpaid,
        [property: JsonPropertyName("pending")] int Pending,
        [property: JsonPropertyName("total")] int Total);
}
