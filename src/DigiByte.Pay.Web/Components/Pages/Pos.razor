                        </button>
                        @if (hasPin)
                        {
                            <button type="button" class="btn-ghost btn-sm dp-pos-remove-pin" @onclick="RequestRemovePin">Remove PIN</button>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
}

@* PIN challenge — shown before executing a guarded action (unpair, changing or removing the PIN). *@
