@page "/pay/{SessionId}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHttpClientFactory HttpFactory
@inject PersistentComponentState AppState
@inject PayApiUrl PayApi
@inject LiveAnnouncer Announcer
@inject NavigationManager Nav
@inject ILogger<Checkout> Log
@inject IServiceProvider Services
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json

<PageTitle>@PageTitleText</PageTitle>

@* Hosted checkout (spec 032, US1). Built from the shared style layer: card, qr-frame, btn-primary,
   copy buttons and status badges. Shoppers never see technical error text (FR-010), a dropped live
   connection shows "Reconnecting" instead of a final state (FR-011), and every status change is
   announced to screen readers (FR-009). No Baku on shopper pages (clarification 2). *@
<main id="main" class="ui-shopper-page page-enter">
    <div class="w-full max-w-md">
        @if (loadFailed)
        {
            var failed = CheckoutStates.For(CheckoutStates.LoadFailed);
            <div data-digipay-measure class="card ui-checkout ui-checkout-center">
                <StatusBadge Status="@CheckoutStates.LoadFailed" />
                <h1 class="page-title">@failed.Heading</h1>
                <p class="ui-checkout-muted">@failed.Explanation</p>
                <button type="button" class="btn-primary w-full" @onclick="RetryAsync" disabled="@loading">
                    <Icon Name="refresh" Class="w-4 h-4" />
                    <span>@(loading ? "Trying again…" : "Try again")</span>
                </button>
            </div>
        }
        else if (session == null)
        {
            <div data-digipay-measure class="card ui-checkout ui-checkout-center" aria-busy="true">
                <h1 class="sr-only">Loading payment</h1>
                <Loader Text="Loading payment…" />
            </div>
        }
        else
        {
            var final = CheckoutStates.IsFinal(session.Status);
            @* data-digipay-status/-session/-return-url: inside the embed iframe, checkout-countdown.js posts
               each status change to the shop's page (digipay.js). *@
            <div data-digipay-measure class="card ui-checkout" data-digipay-status="@session.Status"
                 data-digipay-session="@session.Id" data-digipay-return-url="@session.ReturnUrl">
                <header class="ui-checkout-header">
                    <div class="min-w-0">
                        @if (!string.IsNullOrWhiteSpace(session.Label))
                        {
                            <h1 class="ui-checkout-label">@session.Label</h1>
                            <p class="ui-checkout-merchant">@(merchantName ?? "Merchant")</p>
                        }
                        else
                        {
                            <p class="section-label">Pay</p>
                            <h1 class="ui-checkout-label">@(merchantName ?? "Merchant")</h1>
                        }
                    </div>
                    <StatusBadge Status="@(reconnecting && !final ? CheckoutStates.Reconnecting : session.Status)" Class="shrink-0" />
                </header>

                @if (ShowSwitch)
                {
                    @* specs/033 US3: the buyer picks DGB or DigiDollar until funds arrive (FR-020). *@
                    <div class="segmented w-fit self-center" role="group" aria-label="Pay with" data-pay-switch>
                        <button type="button" class="segmented-item" aria-pressed="@(viewCurrency == "DGB" ? "true" : "false")"
                                disabled="@switching" @onclick='() => SwitchToAsync("DGB")'>DGB</button>
                        @if (ddAvailable)
                        {
                            <button type="button" class="segmented-item" aria-pressed="@(viewCurrency == "DD" ? "true" : "false")"
                                    disabled="@switching" @onclick='() => SwitchToAsync("DD")'>DigiDollar</button>
                        }
                    </div>
                }
                @if (switchMessage != null)
                {
                    <div class="ui-banner ui-banner-info w-full" role="status" data-switch-message>
                        <Icon Name="info" Class="" />
                        <p>@switchMessage</p>
                    </div>
                }

                @if (session.Currency == "DD" && session.AmountCentsDd is { } ddCents)
                {
                    @* DigiDollar: the amount is already USD ($1 = 1 DD), so no conversion and no drift banner. *@
                    <div class="ui-checkout-amount">
                        <img src="/images/digidollar-logo-128.png"
                             srcset="/images/digidollar-logo-64.png 64w, /images/digidollar-logo-96.png 96w, /images/digidollar-logo-128.png 128w, /images/digidollar-logo-192.png 192w, /images/digidollar-logo-256.png 256w"
                             sizes="56px" width="56" height="56" alt="DigiDollar" decoding="async" class="w-14 h-14 rounded-full"
                             onerror="this.style.display='none'" />
                        <p class="ui-checkout-big"><span id="checkout-amount">@FormatUsdPlain(ddCents)</span> <span class="ui-checkout-unit">USD</span></p>
                        <p class="ui-checkout-muted">DigiDollar payment</p>
                        @if (RateLine is { } rateLine)
                        {
                            <p class="ui-checkout-muted tabular-nums" data-rate-line>@rateLine</p>
                        }
                    </div>
                }
                else if (session.FiatAmount is { } fiatAmt && !string.IsNullOrWhiteSpace(session.FiatCurrency))
                {
                    @* Fiat-priced: lead with the number the shopper recognises; the DGB line is what gets paid. *@
                    <div class="ui-checkout-amount">
                        <p class="ui-checkout-big">@Fiat.Format(fiatAmt, session.FiatCurrency) <span class="ui-checkout-unit">@session.FiatCurrency!.ToUpperInvariant()</span></p>
                        <p class="ui-checkout-muted tabular-nums">≈ <span id="checkout-amount" class="font-mono">@FormatDgb(session.AmountSatoshis)</span> DGB</p>
                    </div>
                }
                else
                {
                    <div class="ui-checkout-amount">
                        <p class="ui-checkout-big"><span id="checkout-amount">@FormatDgb(session.AmountSatoshis)</span> <span class="ui-checkout-unit">DGB</span></p>
                    </div>
                }

                @* Price-volatility notice: the DGB amount was fixed when the invoice was created, so a big
                   price move changes what the shopper pays in their own currency. A banner, not a state. *@
                @if (session.Currency != "DD" && priceDriftPct is { } drift && Math.Abs(drift) >= DriftThreshold && !final && !CheckoutStates.IsConfirming(session.Status))
                {
                    var pricierNow = drift > 0;
                    <div class="ui-banner @(pricierNow ? "ui-banner-warning" : "ui-banner-info") w-full">
                        <Icon Name="@(pricierNow ? "alert" : "info")" Class="" />
                        <p>
                            DGB has moved <strong>@drift.ToString("+0.0;-0.0;0.0")%</strong> since this invoice was issued.
                            @if (pricierNow)
                            {
                                <text> Paying now costs a bit more in @session.FiatCurrency!.ToUpperInvariant() than the price shown.</text>
                            }
                            else
                            {
                                <text> Paying now costs slightly less in @session.FiatCurrency!.ToUpperInvariant() than the price shown.</text>
                            }
                        </p>
                    </div>
                }

                @if (final)
                {
                    <TerminalState Status="@session.Status" Txid="@session.PaidTxid" SessionId="@session.Id"
                                   ReturnUrl="@session.ReturnUrl" ReceiptHref="@ReceiptHref"
                                   ReceivedSatoshis="@session.ReceivedSatoshis" ExpectedSatoshis="@(session.Currency == "DD" ? session.AmountCentsDd ?? 0 : session.AmountSatoshis)"
                                   Currency="@session.Currency" />
                }
                else if (CheckoutStates.IsConfirming(session.Status))
                {
                    @* Paid: hide the QR, address and countdown so nobody pays twice; show progress instead. *@
                    @if (reconnecting)
                    {
                        <div class="ui-banner ui-banner-info w-full" role="status">
                            <Icon Name="refresh" Class="" />
                            <p>@CheckoutStates.For(CheckoutStates.Reconnecting).Explanation</p>
                        </div>
                    }
                    <ConfirmationProgress Status="@session.Status" Confirmations="@session.Confirmations"
                                          Txid="@session.PaidTxid" Currency="@session.Currency" />
                }
                else
                {
                    @if (reconnecting)
                    {
                        <div class="ui-banner ui-banner-info w-full" role="status">
                            <Icon Name="refresh" Class="" />
                            <p>@CheckoutStates.For(CheckoutStates.Reconnecting).Explanation</p>
                        </div>
                    }

                    @* QR in the shared frame. ECC level H keeps the code readable with the logo, which stays
                       under a fifth of the code's width. *@
                    <div class="qr-frame">
                        <img src="@qrDataUrl" alt="Scan to pay" width="224" height="224" class="w-56 h-56" />
                        <span class="qr-frame-logo"><img src="/digibyte-logo.svg" alt="" width="32" height="32" class="block w-8 h-8" /></span>
                    </div>

                    <WalletButtons Uri="@session.Uri" ReturnUrl="@SelfUrl" />

                    <div class="ui-checkout-copyrow">
                        <div class="min-w-0 flex-1">
                            <p class="section-label">Address</p>
                            <p id="checkout-address" class="ui-checkout-address">@session.Address</p>
                        </div>
                        <CopyButton Value="@session.Address" Label="Copy address" TargetId="checkout-address" SuccessText="Address copied" Variant="icon" />
                    </div>
                    <div class="ui-checkout-copyrow">
                        <div class="min-w-0 flex-1">
                            <p class="section-label">Amount</p>
                            <p class="ui-checkout-address">@AmountToCopy @(session.Currency == "DD" ? "DD" : "DGB")</p>
                        </div>
                        <CopyButton Value="@AmountToCopy" Label="Copy amount" TargetId="checkout-amount" SuccessText="Amount copied" Variant="icon" />
                    </div>

                    @* The countdown is pure JS (wwwroot/checkout-countdown.js) so it keeps ticking inside the
                       embed iframe even when the interactive connection is slow to start. *@
                    <p class="ui-checkout-muted text-center" data-digipay-countdown="This price has expired. Don't pay to this address.">
                        Price expires in <span class="font-mono tabular-nums" data-digipay-expires="@session.ExpiresAt.ToString("o", System.Globalization.CultureInfo.InvariantCulture)">—</span>
                    </p>
                }
            </div>
        }
        @* Light / Dark / Match my device for the shopper (FR-026). A shop-set ?theme= wins for this view. *@
        <div class="ui-shopper-footer ui-no-print">
            <ThemePicker Compact="true" />
        </div>
    </div>
</main>

@code {
    [Parameter] public string SessionId { get; set; } = "";

    /// <summary>A shop's ?theme=light|dark, carried into the receipt link (contract C3).</summary>
    [SupplyParameterFromQuery(Name = "theme")] public string? Theme { get; set; }

    // What the page shows. For an unlocked buyer-choice payment it is the payment as seen in the currency the buyer
    // picked (viewCurrency); otherwise the payment as the API returned it (actual).
    private SessionDto? session;
    private SessionDto? actual;
    private string? viewCurrency;
    private bool ddAvailable;
    private bool switching;
    private string? switchMessage;
    private string? merchantName;
    private string? qrDataUrl;
    private bool loadFailed;
    private bool loading;
    private bool reconnecting;
    private string? lastAnnouncedStatus;
    private int lastAnnouncedConfirmations;

    // Drift between the quote-time and the current DGB price; |value| ≥ DriftThreshold shows the banner.
    private decimal? priceDriftPct;
    private const decimal DriftThreshold = 3m;

    private HubConnection? hub;
    private readonly CancellationTokenSource lifetime = new();
    private Task? pollLoop;
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(10);

    private bool ShowSwitch => actual is { BuyerChoice: true, LockedAt: null, Status: "pending" };

    private OptionDto? OptionFor(string currency) => actual?.Options?.FirstOrDefault(o => o.Currency == currency);

    /// <summary>"₱1,250.00 at ₱58.20 per US dollar" for a DD amount converted from another currency (FR-022).</summary>
    private string? RateLine =>
        viewCurrency == "DD" && OptionFor("DD") is { UsdRate: { } rate } && rate != 1m
        && actual?.FiatAmount is { } fa && actual.FiatCurrency is { } fc
            ? $"{Fiat.Format(fa, fc)} at {Fiat.Format(rate, fc)} per US dollar"
            : null;

    /// <summary>Shows the payment in <see cref="viewCurrency"/> while it can still be switched; else as it is.</summary>
    private void Project()
    {
        if (actual is null) return;
        var shown = actual;
        if (actual.BuyerChoice && actual.LockedAt is null && viewCurrency is not null && OptionFor(viewCurrency) is { } o)
            shown = actual with { Currency = o.Currency, Address = o.Address, AmountSatoshis = o.AmountSatoshis, AmountCentsDd = o.AmountCentsDd, Uri = o.Uri };
        var uriChanged = session?.Uri != shown.Uri;
        session = shown;
        if (uriChanged || qrDataUrl is null) qrDataUrl = GenerateQr(shown.Uri);
    }

    /// <summary>Takes a fresh copy of the payment from the API and follows a lock or a change in DD availability.</summary>
    private void Adopt(GetSessionResponse response)
    {
        actual = response.Session;
        ddAvailable = response.DdAvailable ?? false;
        if (actual.LockedAt is not null || !actual.BuyerChoice) viewCurrency = actual.Currency;
        else if ((viewCurrency ??= actual.Currency) == "DD" && !ddAvailable)
        {
            // DigiDollar went away before the buyer paid: back to DGB, with a note (spec edge case).
            viewCurrency = "DGB";
            switchMessage = "DigiDollar isn't available for this payment any more, so it's back to DGB.";
        }
        Project();
    }

    /// <summary>The buyer's DGB/DD switch. The first switch to DD asks the API for this payment's DD option.</summary>
    private async Task SwitchToAsync(string currency)
    {
        if (actual is null || currency == viewCurrency || switching) return;
        switchMessage = null;
        if (currency == "DD" && OptionFor("DD") is null)
        {
            switching = true;
            try
            {
                var http = HttpFactory.CreateClient("PayApi");
                using var request = new HttpRequestMessage(HttpMethod.Post, $"/v1/pay/sessions/{Uri.EscapeDataString(SessionId)}/options/dd");
                // The API's per-visitor rate limit counts the shopper, not this server (DigiPay:TrustedClientKey).
                var key = Services.GetService<IConfiguration>()?["DigiPay:TrustedClientKey"];
                if (!string.IsNullOrEmpty(key) && visitorAddress is not null)
                {
                    request.Headers.TryAddWithoutValidation("X-DigiPay-Client-Address", visitorAddress);
                    request.Headers.TryAddWithoutValidation("X-DigiPay-Client-Key", key);
                }
                using var response = await http.SendAsync(request, lifetime.Token);
                if (!response.IsSuccessStatusCode)
                {
                    switchMessage = await DigiByte.Pay.Web.Components.Shared.Ui.ApiError.ReadAsync(response);
                    return;
                }
                var option = await response.Content.ReadFromJsonAsync<OptionDto>(lifetime.Token);
                if (option is null) return;
                actual = actual with { Options = [.. actual.Options ?? [], option] };
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
            catch (Exception ex)
            {
                Log.LogInformation(ex, "Checkout could not switch {SessionId} to DD", SessionId);
                switchMessage = "DigiDollar isn't available for this payment right now.";
                return;
            }
            finally { switching = false; }
        }
        viewCurrency = currency;
        Project();
        priceDriftPct = null;
        await RefreshPriceDriftAsync();
    }

    private string? visitorAddress;

    private string PageTitleText => merchantName is null ? "Pay · DigiPay" : $"Pay {merchantName} · DigiPay";

    private string AmountToCopy => session is null ? "" :
        session.Currency == "DD" && session.AmountCentsDd is { } c ? FormatUsdPlain(c) : FormatDgb(session.AmountSatoshis);

    private string ThemeSuffix => Theme?.ToLowerInvariant() is "light" or "dark" ? $"?theme={Theme.ToLowerInvariant()}" : "";

    private string ReceiptHref => $"/pay/{Uri.EscapeDataString(SessionId)}/receipt{ThemeSuffix}";

    /// <summary>This checkout's absolute address (with the shop's ?theme=), for the wallet's "Return to" button.</summary>
    private string SelfUrl => Nav.ToAbsoluteUri($"/pay/{Uri.EscapeDataString(SessionId)}{ThemeSuffix}").AbsoluteUri;

    protected override Task OnInitializedAsync() => LoadAsync();

    // The page is rendered on the server first (shopper pages, FR-013a). The session fetched then is
    // handed to the interactive copy so it doesn't flash "Loading…" and fetch it again.
    private const string PersistKey = "digipay-session";
    private PersistingComponentStateSubscription? persisting;
    private GetSessionResponse? loaded;

    protected override void OnInitialized() =>
        persisting = AppState.RegisterOnPersisting(() =>
        {
            if (loaded is not null) AppState.PersistAsJson(PersistKey, loaded);
            return Task.CompletedTask;
        });

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = AppState.TryTakeFromJson<GetSessionResponse>(PersistKey, out var restored) && restored?.Session is not null
                ? restored
                : await http.GetFromJsonAsync<GetSessionResponse>($"/v1/pay/sessions/{Uri.EscapeDataString(SessionId)}", lifetime.Token);
            if (response?.Session is null)
            {
                Fail(null);
                return;
            }
            loaded = response;
            visitorAddress ??= Services.GetService<IHttpContextAccessor>()?.HttpContext is { } context ? Signin.VisitorAddressOf(context) : null;
            Adopt(response);
            merchantName = response.MerchantName;
            loadFailed = false;
            lastAnnouncedStatus = session.Status; // the first state is visible, not announced
            lastAnnouncedConfirmations = session.Confirmations;
            await RefreshPriceDriftAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Fail(ex); }
        finally { loading = false; }
    }

    private void Fail(Exception? ex)
    {
        // Details go to the server log only, never to the page (FR-010).
        if (ex is not null) Log.LogWarning(ex, "Checkout could not load session {SessionId}", SessionId);
        else Log.LogInformation("Checkout session {SessionId} not found", SessionId);
        loadFailed = true;
        Announcer.Announce(CheckoutStates.For(CheckoutStates.LoadFailed).Announcement!, assertive: true);
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
        StateHasChanged();
        if (session is not null && !CheckoutStates.IsFinal(session.Status)) await ConnectHubAsync();
    }

    // Live DGB price vs the quote recorded at creation. Silent on failure: the banner just stays hidden.
    private async Task RefreshPriceDriftAsync()
    {
        if (session is null || session.Currency == "DD") return;
        if (session.DgbPriceAtCreation is not { } quote || quote <= 0m) return;
        if (string.IsNullOrWhiteSpace(session.FiatCurrency) || CheckoutStates.IsFinal(session.Status)) return;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var quoteDto = await http.GetFromJsonAsync<PriceQuoteDto>(
                $"/v1/pay/public/price?currency={Uri.EscapeDataString(session.FiatCurrency)}", lifetime.Token);
            if (quoteDto is null || quoteDto.DgbPrice <= 0m) return;
            priceDriftPct = (quoteDto.DgbPrice - quote) / quote * 100m;
        }
        catch { /* banner stays hidden */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not just on the first render: that one happens while the session is still loading
        // (session == null), so a firstRender-only check never connected live updates at all.
        // Connect on the first render that has a live (non-final) session; ConnectHubAsync
        // is a no-op once a connection exists.
        if (hub is not null || session is null || CheckoutStates.IsFinal(session.Status)) return;
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        if (hub is not null) return;
        hub = new HubConnectionBuilder()
            .WithUrl($"{PayApi.Value}/hubs/checkout")
            .WithAutomaticReconnect()
            .Build();
        hub.On<StatusUpdate>("StatusChanged", OnStatusChanged);
        hub.Reconnecting += _ => SetReconnectingAsync(true);
        hub.Reconnected += async _ =>
        {
            await hub.InvokeAsync("SubscribeToSession", SessionId);
            await RefreshSessionAsync(); // catch anything that happened while we were away
            await SetReconnectingAsync(false);
        };
        hub.Closed += async _ =>
        {
            // Automatic reconnect gave up. Keep watching over plain HTTP; never show a final state
            // just because the connection is gone (FR-011).
            await SetReconnectingAsync(true);
            StartPolling();
        };

        try
        {
            await hub.StartAsync(lifetime.Token);
            await hub.InvokeAsync("SubscribeToSession", SessionId, lifetime.Token);
            // A status change between the first load and the subscription would otherwise be
            // missed until the next one; read the session once more now that updates flow.
            await RefreshSessionAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogInformation(ex, "Checkout live updates unavailable for {SessionId}; polling instead", SessionId);
            await SetReconnectingAsync(true);
            StartPolling();
        }
    }

    private void StartPolling()
    {
        if (pollLoop is { IsCompleted: false }) return;
        pollLoop = PollAsync();
    }

    private async Task PollAsync()
    {
        var delay = PollEvery;
        while (!lifetime.IsCancellationRequested && session is not null && !CheckoutStates.IsFinal(session.Status))
        {
            try { await Task.Delay(delay, lifetime.Token); }
            catch (OperationCanceledException) { return; }

            await RefreshSessionAsync();

            // Try to get live updates back, backing off up to a minute.
            if (hub is not null && hub.State == HubConnectionState.Disconnected)
            {
                try
                {
                    await hub.StartAsync(lifetime.Token);
                    await hub.InvokeAsync("SubscribeToSession", SessionId, lifetime.Token);
                    await SetReconnectingAsync(false);
                    return;
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch { delay = TimeSpan.FromSeconds(Math.Min(60, delay.TotalSeconds * 2)); }
            }
        }
        await SetReconnectingAsync(false);
    }

    // Re-reads the session over HTTP. Only the server's answer can move the page to a final state.
    private async Task RefreshSessionAsync()
    {
        if (session is null) return;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var response = await http.GetFromJsonAsync<GetSessionResponse>($"/v1/pay/sessions/{Uri.EscapeDataString(SessionId)}", lifetime.Token);
            if (response?.Session is not { } fresh) return;
            if (actual is not null && (fresh.LockedAt != actual.LockedAt || fresh.Currency != actual.Currency
                || (response.DdAvailable ?? false) != ddAvailable || (fresh.Options?.Count ?? 0) != (actual.Options?.Count ?? 0)))
            {
                // Locked to a currency, or DigiDollar came or went: take the whole payment again.
                await InvokeAsync(() => { Adopt(response); StateHasChanged(); });
            }
            await ApplyAsync(fresh.Status, fresh.ReceivedSatoshis, fresh.Confirmations, fresh.PaidTxid);
        }
        catch { /* still offline: keep the last known state */ }
    }

    private async Task OnStatusChanged(StatusUpdate update)
    {
        // A buyer-choice lock changes the currency in effect: re-read the payment so the page shows that currency.
        if (actual is not null && (update.LockedAt != actual.LockedAt || (update.Currency is { } c && c != actual.Currency)))
            await RefreshSessionAsync();
        await ApplyAsync(update.Status, update.ReceivedSatoshis, update.Confirmations, update.Txid);
    }

    private async Task ApplyAsync(string status, long received, int confirmations, string? txid)
    {
        if (session is null) return;
        await InvokeAsync(() =>
        {
            if (actual is not null)
                actual = actual with { Status = status, ReceivedSatoshis = received, Confirmations = confirmations, PaidTxid = txid ?? actual.PaidTxid };
            session = session with
            {
                Status = status,
                ReceivedSatoshis = received,
                Confirmations = confirmations,
                PaidTxid = txid ?? session.PaidTxid,
            };
            if (status != lastAnnouncedStatus)
            {
                lastAnnouncedStatus = status;
                lastAnnouncedConfirmations = confirmations;
                var announcement = CheckoutStates.For(status).Announcement;
                if (announcement is not null) Announcer.Announce(announcement, assertive: status is "underpaid");
            }
            else if (status == "paid" && confirmations > lastAnnouncedConfirmations)
            {
                // Each new block while confirming, so a screen-reader user hears progress too.
                lastAnnouncedConfirmations = confirmations;
                Announcer.Announce($"{confirmations} of {CheckoutStates.ConfirmationsRequired} confirmations.");
            }
            StateHasChanged();
        });
        await RefreshPriceDriftAsync();
    }

    private async Task SetReconnectingAsync(bool value)
    {
        if (reconnecting == value) return;
        await InvokeAsync(() =>
        {
            reconnecting = value;
            if (value && session is not null && !CheckoutStates.IsFinal(session.Status))
                Announcer.Announce(CheckoutStates.For(CheckoutStates.Reconnecting).Announcement!);
            StateHasChanged();
        });
    }

    private static string GenerateQr(string content)
    {
        using var gen = new QRCoder.QRCodeGenerator();
        using var data = gen.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.H);
        using var qr = new QRCoder.PngByteQRCode(data);
        return $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(6))}";
    }

    // Plain decimal strings: what a copy button puts on the clipboard (no symbol, no separators).
    private static string FormatDgb(long sats) =>
        (sats / 100_000_000m).ToString("0.########", System.Globalization.CultureInfo.InvariantCulture);


    private static string FormatUsdPlain(long cents) =>
        (cents / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        persisting?.Dispose();
        lifetime.Cancel();
        if (hub != null) await hub.DisposeAsync();
        lifetime.Dispose();
    }

    public record GetSessionResponse(SessionDto Session, string? MerchantName, bool? DdAvailable = null, string? DdReason = null);

    public record SessionDto(
        string Id, string Address, long AmountSatoshis, decimal Amount,
        string? FiatCurrency, decimal? FiatAmount, decimal? DgbPriceAtCreation,
        string? Label, string? Memo,
        string Status, DateTime CreatedAt, DateTime ExpiresAt,
        long ReceivedSatoshis, int Confirmations, string? PaidTxid,
        string Uri, string CheckoutUrl,
        // Optional merchant URL the buyer is sent back to once paid.
        string? ReturnUrl = null,
        // DigiDollar: Currency = "DGB" (default) or "DD"; for DD, AmountCentsDd carries USD cents.
        string Currency = "DGB",
        long? AmountCentsDd = null,
        // specs/033 buyer choice: the currencies it can be paid in, and when funds locked it to one.
        bool BuyerChoice = false,
        DateTime? LockedAt = null,
        List<OptionDto>? Options = null);

    public record OptionDto(string Currency, string Address, long AmountSatoshis, long? AmountCentsDd, decimal? UsdRate, DateTime? RateAt, string Uri);

    public record StatusUpdate(string SessionId, string Status, long ReceivedSatoshis, int Confirmations, string? Txid,
        string? Currency = null, DateTime? LockedAt = null, long? AmountCentsDd = null);

    public record PriceQuoteDto(
        [property: System.Text.Json.Serialization.JsonPropertyName("dgbPrice")] decimal DgbPrice);
}
