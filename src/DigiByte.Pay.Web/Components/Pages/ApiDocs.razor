@page "/docs/api"
@layout SiteLayout
@inject PayApiPublicUrl ApiPublic
@inject NavigationManager Nav

<PageTitle>API reference — DigiPay</PageTitle>
<HeadContent><meta name="description" content="DigiPay API reference: create payment sessions, check their status and verify the signed webhooks DigiPay sends to your server." /></HeadContent>

@{
    // Resolve the public API base. If the configured value is absent or points
    // at a non-browser-reachable address (Railway's *.railway.internal, or
    // localhost without a port override in prod) we derive one from the current
    // request: pay.dgbwallet.app → api.pay.dgbwallet.app. This keeps the Scalar
    // link working even when someone forgets to set DigiPay:ApiPublicUrl on the
    // digipay-web Railway service.
    string ResolveApiPublic()
    {
        var cfg = ApiPublic.Value?.TrimEnd('/') ?? "";
        var looksInternal = cfg.Length == 0
            || cfg.Contains(".railway.internal", StringComparison.OrdinalIgnoreCase)
            || cfg.Contains(".internal:", StringComparison.OrdinalIgnoreCase);
        if (!looksInternal) return cfg;

        var uri = new Uri(Nav.BaseUri);
        // Local dev falls back to the configured value (usually http://localhost:5008).
        if (uri.Host is "localhost" or "127.0.0.1" || uri.Host.EndsWith(".local", StringComparison.OrdinalIgnoreCase))
            return cfg;
        // pay.dgbwallet.app → api.pay.dgbwallet.app. Strips a leading "www." if present.
        var host = uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? uri.Host[4..] : uri.Host;
        return $"{uri.Scheme}://api.{host}";
    }
    var apiPublic = ResolveApiPublic();

    const string P = "leading-relaxed text-slate-700 dark:text-slate-300 mb-3";
    const string Small = "text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-3";
}

<main id="main" class="flex-1 page-enter">
    <DocsLayout Current="/docs/api" Toc="toc">
        <article class="dp-docs-article">
            <p class="dp-docs-eyebrow">Developer docs</p>
            <h1 class="dp-docs-title slide-up">API reference</h1>
            <p class="dp-docs-lead slide-up-delay-1">
                DigiPay speaks plain REST over HTTPS with JSON bodies. Every endpoint lives under
                <InlineCode>/v1/pay</InlineCode> on <InlineCode>https://api.pay.dgbwallet.app</InlineCode>. An account owns one or more stores;
                receive address, webhook and session defaults belong to a store. New here? Start with the
                <a href="/docs#quickstart" class="text-dgb-500 hover:underline">quickstart</a>.
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
                On Node, Python or .NET? The <a href="/sdks" class="text-dgb-500 hover:underline font-medium">official SDKs</a> wrap these endpoints with types and a webhook verifier.
            </p>

            @* Live OpenAPI / Scalar callout. Only the integrator-facing groups are in the OpenAPI document
               (see Program.cs: auth, me, api-keys and pos are ExcludeFromDescription). *@
            <div class="mb-8 rounded-2xl border border-dgb-200/70 dark:border-dgb-800 bg-gradient-to-br from-dgb-50 to-white dark:from-dgb-900 dark:to-dgb-950 p-5 sm:p-6">
                <div class="flex items-start gap-3 mb-3">
                    <div class="w-10 h-10 rounded-xl bg-dgb-500/10 dark:bg-dgb-500/20 flex items-center justify-center flex-shrink-0">
                        <Icon Name="code" Class="w-5 h-5 text-dgb-500" />
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white">Try it in the browser</h2>
                        <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5">
                            The server-to-server endpoints (sessions, stores and webhooks, public, sandbox) are published as OpenAPI 3.1 and rendered with Scalar,
                            where you can send real requests. Dashboard-only endpoints (Digi-ID sign-in, account, API keys, POS pairing) are documented on this page only.
                        </p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 mt-4">
                    <a href="@($"{apiPublic}/scalar")" target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2">
                        Open Scalar explorer <Icon Name="external-link" Class="w-3.5 h-3.5" /><span class="sr-only">(opens in a new tab)</span>
                    </a>
                    <a href="@($"{apiPublic}/openapi/v1.json")" target="_blank" rel="noopener" class="btn-secondary inline-flex items-center gap-2">
                        openapi.json <Icon Name="download" Class="w-3.5 h-3.5" /><span class="sr-only">(opens in a new tab)</span>
                    </a>
                </div>
            </div>

            @* ===================== Authentication ===================== *@
            <DocsHeading Id="authentication">Authentication</DocsHeading>
            <p class="@P">Send one header on every authenticated call: <InlineCode>Authorization: Bearer &lt;token&gt;</InlineCode>. Two kinds of token work:</p>
            <ul class="space-y-1 leading-relaxed text-slate-700 dark:text-slate-300 list-disc pl-5 mb-3">
                <li><InlineCode>dgp_…</InlineCode> — <strong>API key</strong>. Long-lived, as many per account as you like, revocable one by one. For your server, CI and the SDKs. Create them in the dashboard's API keys tab.</li>
                <li><InlineCode>dps_…</InlineCode> — <strong>session token</strong>, minted when you sign in to the dashboard with Digi-ID. Expires after 30 days, revoked on sign-out. Used by the browser.</li>
            </ul>
            <p class="@P">
                A token has three parts joined by underscores: its kind (<InlineCode>dgp</InlineCode> or <InlineCode>dps</InlineCode>), a 10-character public id,
                and the secret. Send the whole string exactly as you received it. DigiPay stores only a SHA-256 hash of the secret, so a lost key can't be
                shown again: revoke it and create a new one.
            </p>
            <CodeBlock Lang="bash" Label="Copy the header example">Authorization: Bearer dgp_a1b2c3d4e5_s3cr3tPartShownOnlyOnce</CodeBlock>
            <p class="@Small">The example key is made up. In the docs, <InlineCode>$DIGIPAY_KEY</InlineCode> stands for your full key.</p>

            @* ===================== Register ===================== *@
            <DocsHeading Id="register">Register (headless)</DocsHeading>
            <p class="@P">Creates an account, its first store and an API key in one call, for self-hosting and CI bootstrapping. People should sign in with Digi-ID from the dashboard instead.</p>
            <Endpoint Method="POST" Path="/v1/pay/merchants" Auth="No auth · 5 per hour" Id="post-merchants">
                <CodeBlock Lang="json" Label="Copy the register body">@("{\n  \"displayName\": \"My Shop\",\n  \"addressOrXpub\": \"dgb1q...\",\n  \"network\": \"mainnet\",\n  \"webhookUrl\": \"https://shop.example/digipay/webhook\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="displayName" Type="string" Required="true">Account and store name.</Param>
                    <Param Name="addressOrXpub" Type="string" Required="true">A DigiByte address (single-address mode) or a BIP84 account xpub (a fresh address per session).</Param>
                    <Param Name="network" Type="string">mainnet (default), testnet or regtest.</Param>
                    <Param Name="webhookUrl" Type="string">If given, a webhook secret is generated and returned. Must be a public HTTPS URL.</Param>
                </ParamList>
                <p class="@Small m-0">Returns <InlineCode>id</InlineCode>, <InlineCode>displayName</InlineCode>, <InlineCode>storeId</InlineCode>, <InlineCode>network</InlineCode>, <InlineCode>mode</InlineCode> (<InlineCode>address</InlineCode> or <InlineCode>xpub</InlineCode>), <InlineCode>apiKey</InlineCode> and <InlineCode>webhookSecret</InlineCode> (null without a webhook URL). Both secrets appear only in this response.</p>
            </Endpoint>

            @* ===================== Sessions ===================== *@
            <DocsHeading Id="sessions">Sessions</DocsHeading>
            <p class="@P">A session is one invoice: an amount, an address to pay, and a status that moves from <InlineCode>pending</InlineCode> to <InlineCode>confirmed</InlineCode> (or <InlineCode>expired</InlineCode>, <InlineCode>underpaid</InlineCode>, <InlineCode>refunded</InlineCode>, <InlineCode>voided</InlineCode>). See <a href="/docs#lifecycle" class="text-dgb-500 hover:underline">how a payment flows</a>.</p>

            <Endpoint Method="POST" Path="/v1/pay/sessions" Auth="API key" Id="create-session">
                <p class="@Small">Create a payment session.</p>
                <CodeBlock Lang="json" Label="Copy the create-session body">@("{\n  \"amount\": 12.5,\n  \"storeId\": \"sto_4fj8w2k9m3n7p5q1\",\n  \"label\": \"Order #4201\",\n  \"memo\": \"inv-001\",\n  \"fiatCurrency\": \"USD\",\n  \"fiatAmount\": 5.00,\n  \"dgbPriceAtCreation\": 0.0098,\n  \"expiresInSeconds\": 1800,\n  \"returnUrl\": \"https://shop.example/orders/42/thanks\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="amount" Type="number">Amount in DGB. Required for DGB sessions (must be greater than 0).</Param>
                    <Param Name="storeId" Type="string">Which store gets paid. Defaults to the account's first store.</Param>
                    <Param Name="label" Type="string">Shown to the buyer on the checkout and in the wallet request.</Param>
                    <Param Name="memo" Type="string">Your own reference. Added to the payment request as its message.</Param>
                    <Param Name="fiatCurrency" Type="string">The currency you priced the order in, for example USD. Recorded for your books and shown on the checkout.</Param>
                    <Param Name="fiatAmount" Type="number">The order total in <InlineCode>fiatCurrency</InlineCode>.</Param>
                    <Param Name="dgbPriceAtCreation" Type="number">The DGB price you quoted. The checkout warns the buyer if the live price has moved noticeably since.</Param>
                    <Param Name="expiresInSeconds" Type="integer">1 to 86400. Overrides the store's default expiry (30 minutes if unset).</Param>
                    <Param Name="returnUrl" Type="string">Where the checkout sends the buyer after payment confirms (a <em>Return to merchant</em> button and a 5-second redirect). HTTPS, or HTTP on localhost only. Up to 2048 characters.</Param>
                    <Param Name="currency" Type="string">DGB (default) or DD for a DigiDollar session.</Param>
                    <Param Name="buyerChoice" Type="boolean">Optional. Let the buyer pay in DGB or DigiDollar at checkout. Honoured only for a payment priced in a regular currency (<InlineCode>fiatCurrency</InlineCode> and <InlineCode>fiatAmount</InlineCode>, currency DGB) at a store with DigiDollar and buyer choice on, where DigiPay offers DigiDollar beyond the API; otherwise ignored without an error. The response then has <InlineCode>buyerChoice: true</InlineCode> and an <InlineCode>options</InlineCode> list (one per currency: <InlineCode>currency</InlineCode>, <InlineCode>address</InlineCode>, <InlineCode>amountSatoshis</InlineCode>, <InlineCode>amountCentsDd</InlineCode>, <InlineCode>usdRate</InlineCode>, <InlineCode>rateAt</InlineCode>, <InlineCode>uri</InlineCode>). The session's own <InlineCode>currency</InlineCode>, <InlineCode>address</InlineCode> and amounts describe the currency in effect; once funds arrive, <InlineCode>lockedAt</InlineCode> is set and they are the currency actually paid. Funds later sent in the other currency show as <InlineCode>extra: {"{ currency, amount, txid, seenAt }"}</InlineCode> (satoshis for DGB, cents for DD) for you to refund.</Param>
                    <Param Name="amountCentsDd" Type="integer">DigiDollar amount in US cents, 100 to 10000000. Required when <InlineCode>currency</InlineCode> is DD; <InlineCode>amount</InlineCode> is then ignored. The store must have <InlineCode>digiDollarEnabled</InlineCode>, otherwise <InlineCode>400 digidollar_not_enabled_for_store</InlineCode>; if the DigiDollar node can't be reached you get <InlineCode>503 digidollar_node_unavailable</InlineCode>.</Param>
                </ParamList>
                <ParamList Title="Headers">
                    <Param Name="Idempotency-Key" Type="string">Up to 255 characters. Repeat calls with the same key within 24 hours (per account) return the original session instead of a new one. Your order id works well.</Param>
                </ParamList>
                <p class="@Small">
                    Returns the session: <InlineCode>id</InlineCode>, <InlineCode>storeId</InlineCode>, <InlineCode>address</InlineCode>, <InlineCode>amount</InlineCode>,
                    <InlineCode>amountSatoshis</InlineCode>, <InlineCode>status</InlineCode>, <InlineCode>uri</InlineCode> (BIP21 payment request),
                    <InlineCode>checkoutUrl</InlineCode>, <InlineCode>expiresAt</InlineCode>, <InlineCode>returnUrl</InlineCode>, <InlineCode>currency</InlineCode>
                    and the payment fields below (null until something arrives).
                </p>
                <p class="@Small m-0">
                    <strong>Errors:</strong> <InlineCode>400</InlineCode> if the store has no receive address yet (<InlineCode>PATCH</InlineCode> the store first), the store id isn't yours, or a field is invalid.
                </p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/sessions" Auth="API key" Id="list-sessions">
                <p class="@Small">Your sessions, newest first, as <InlineCode>{ total, take, skip, sessions: [ … ] }</InlineCode>.</p>
                <ParamList Title="Query parameters">
                    <Param Name="status" Type="string">pending, seen, paid, confirmed, expired, underpaid, refunded or voided. An unknown value is ignored (no filter).</Param>
                    <Param Name="storeId" Type="string">Only this store's sessions.</Param>
                    <Param Name="take" Type="integer">1 to 100, default 25. With <InlineCode>format=csv</InlineCode>: up to 10000.</Param>
                    <Param Name="skip" Type="integer">Default 0.</Param>
                    <Param Name="format" Type="string"><InlineCode>csv</InlineCode> returns a spreadsheet download (<InlineCode>text/csv</InlineCode>) instead of JSON: id, store, status, address, DGB amounts, fiat, label, memo, confirmations, txid, timestamps and source, then <InlineCode>currency</InlineCode>, <InlineCode>amount</InlineCode> and <InlineCode>received</InlineCode> in the session's own currency (DigiDollar in dollars; its DGB columns are 0).</Param>
                </ParamList>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/sessions/{id}" Auth="No auth" Id="get-session">
                <p class="@Small m-0">
                    Public read of one session, as <InlineCode>{ session: { … }, merchantName }</InlineCode>. No key needed: the id is random and reveals nothing
                    secret. The hosted checkout uses it, and it's the call to make when you want to double-check a webhook.
                    For a buyer-choice session it also has <InlineCode>ddAvailable</InlineCode> and, when that's false, <InlineCode>ddReason</InlineCode>
                    (<InlineCode>dd_disabled</InlineCode> or <InlineCode>unavailable</InlineCode>).
                </p>
            </Endpoint>

            <Endpoint Method="POST" Path="/v1/pay/sessions/{id}/options/dd" Auth="No auth" Id="session-dd-option">
                <p class="@Small m-0">
                    The buyer's switch to DigiDollar on a buyer-choice session (the hosted checkout and POS call it). Returns the session's DD option, making it
                    the first time: a USD price becomes DD at 1:1, any other currency is converted at DigiPay's USD rate and rounded up to the cent, and the
                    amount then stays fixed until the session expires. Rate-limited per visitor. <InlineCode>409</InlineCode> with
                    <InlineCode>dd_option_not_allowed</InlineCode> (<InlineCode>reason</InlineCode>: <InlineCode>no_choice</InlineCode>, <InlineCode>locked</InlineCode>,
                    <InlineCode>not_pending</InlineCode>, <InlineCode>expired</InlineCode>) or <InlineCode>dd_option_unavailable</InlineCode>
                    (<InlineCode>dd_disabled</InlineCode>, <InlineCode>no_rate</InlineCode>, <InlineCode>out_of_range</InlineCode> with <InlineCode>minCents</InlineCode> and
                    <InlineCode>maxCents</InlineCode>); <InlineCode>503 digidollar_node_unavailable</InlineCode> when the DigiDollar node can't be reached.
                </p>
            </Endpoint>

            <Endpoint Method="POST" Path="/v1/pay/sessions/{id}/refund" Auth="API key" Id="refund-session">
                <p class="@Small">
                    Record a refund. Crypto payments can't be pulled back, so you send the DGB back from your own wallet first, then record the transaction
                    here so the dashboard, receipts and webhooks agree. The session becomes <InlineCode>refunded</InlineCode> and
                    <InlineCode>session.refunded</InlineCode> fires.
                </p>
                <CodeBlock Lang="json" Label="Copy the refund body">@("{\n  \"txid\": \"9f2c4e1a7b3d5f8e0c6a2b4d8f1e3a5c7b9d0e2f4a6c8b1d3e5f7a9c0b2d4e6f\",\n  \"note\": \"Customer returned the item\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="txid" Type="string" Required="true">The refund transaction id, 32 to 128 characters.</Param>
                    <Param Name="note" Type="string">Why. Kept up to 512 characters and included in the webhook as <InlineCode>refundNote</InlineCode>.</Param>
                </ParamList>
                <p class="@Small m-0"><strong>Errors:</strong> <InlineCode>409</InlineCode> unless the session is <InlineCode>paid</InlineCode> or <InlineCode>confirmed</InlineCode> (so refunding twice is refused), <InlineCode>404</InlineCode> if it isn't yours.</p>
            </Endpoint>

            <Endpoint Method="POST" Path="/v1/pay/sessions/{id}/void" Auth="API key" Id="void-session">
                <p class="@Small">Cancel an unpaid session. It becomes <InlineCode>voided</InlineCode>, DigiPay stops watching its address, the checkout shows it as cancelled, and <InlineCode>session.voided</InlineCode> fires. The body is optional.</p>
                <CodeBlock Lang="json" Label="Copy the void body">@("{\n  \"note\": \"Order cancelled\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="note" Type="string">Why. Kept up to 512 characters.</Param>
                </ParamList>
                <p class="@Small m-0"><strong>Errors:</strong> <InlineCode>409</InlineCode> unless the session is <InlineCode>pending</InlineCode> or <InlineCode>seen</InlineCode>.</p>
            </Endpoint>

            @* ===================== Stores ===================== *@
            <DocsHeading Id="stores">Stores</DocsHeading>
            <p class="@P">A store owns its receive address or xpub, webhook URL and secret, default expiry and sessions. An account can run many: several shops, a tip jar, a testnet store. A store id that belongs to another account answers <InlineCode>404</InlineCode>.</p>

            <Endpoint Method="GET" Path="/v1/pay/stores" Auth="API key" Id="list-stores">
                <p class="@Small m-0">All your stores. Each has <InlineCode>id</InlineCode>, <InlineCode>name</InlineCode>, <InlineCode>network</InlineCode>, <InlineCode>receiveMode</InlineCode> (<InlineCode>xpub</InlineCode>, <InlineCode>address</InlineCode> or <InlineCode>unconfigured</InlineCode>), <InlineCode>hasReceive</InlineCode>, <InlineCode>receivePreview</InlineCode>, <InlineCode>webhookUrl</InlineCode>, <InlineCode>hasWebhookSecret</InlineCode>, <InlineCode>defaultSessionExpiryMinutes</InlineCode>, <InlineCode>digiDollarEnabled</InlineCode>, <InlineCode>defaultCurrency</InlineCode> (<InlineCode>DGB</InlineCode>, a fiat code such as <InlineCode>EUR</InlineCode>, <InlineCode>DD</InlineCode>, or <InlineCode>null</InlineCode> when not set), <InlineCode>defaultCurrencyEffective</InlineCode> (the same, except a saved <InlineCode>DD</InlineCode> reads as <InlineCode>USD</InlineCode> while the store can't offer DigiDollar), <InlineCode>buyerChoiceEnabled</InlineCode>, <InlineCode>ddDonationAddress</InlineCode> and <InlineCode>createdAt</InlineCode>.</p>
            </Endpoint>

            <Endpoint Method="POST" Path="/v1/pay/stores" Auth="API key" Id="create-store">
                <CodeBlock Lang="json" Label="Copy the create-store body">@("{\n  \"name\": \"Acme Tips Jar\",\n  \"network\": \"mainnet\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="name" Type="string" Required="true">Store name.</Param>
                    <Param Name="network" Type="string">mainnet (default), testnet or regtest. A testnet store is watched on DigiByte testnet.</Param>
                    <Param Name="defaultCurrency" Type="string">Optional. The store's default currency, as on <InlineCode>PATCH</InlineCode>.</Param>
                </ParamList>
                <p class="@Small m-0">The new store has no receive address yet: <InlineCode>PATCH</InlineCode> one before creating sessions.</p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/stores/{id}" Auth="API key" Id="get-store">
                <p class="@Small m-0">One store, in the same shape as the list. A paired POS tablet's key can read its own store, which is how a new tablet learns the store's <InlineCode>defaultCurrency</InlineCode>.</p>
            </Endpoint>

            <Endpoint Method="PATCH" Path="/v1/pay/stores/{id}" Auth="API key" Id="update-store">
                <p class="@Small">Change any subset of these fields; leave the rest out.</p>
                <CodeBlock Lang="json" Label="Copy the update-store body">@("{\n  \"name\": \"Main Shop\",\n  \"network\": \"mainnet\",\n  \"addressOrXpub\": \"xpub6...\",\n  \"webhookUrl\": \"https://shop.example/digipay/webhook\",\n  \"defaultSessionExpiryMinutes\": 45,\n  \"digiDollarEnabled\": false,\n  \"defaultCurrency\": \"EUR\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="name" Type="string">1 to 120 characters.</Param>
                    <Param Name="network" Type="string">mainnet, testnet or regtest.</Param>
                    <Param Name="addressOrXpub" Type="string">A DigiByte address or a BIP84 account xpub, checked against the store's network. An empty string clears it. Setting a new xpub restarts address derivation.</Param>
                    <Param Name="webhookUrl" Type="string">Public HTTPS URL for webhooks. The first time one is set, a webhook secret is created. An empty string removes the URL and deletes the secret.</Param>
                    <Param Name="defaultSessionExpiryMinutes" Type="integer">1 to 1440.</Param>
                    <Param Name="digiDollarEnabled" Type="boolean">Allow DigiDollar (DD) sessions on this store.</Param>
                    <Param Name="buyerChoiceEnabled" Type="boolean">Let buyers choose DGB or DigiDollar on payments priced in a regular currency. On by default; only has an effect while DigiDollar is on.</Param>
                    <Param Name="defaultCurrency" Type="string"><InlineCode>DGB</InlineCode> or one of the DigiByte wallet's ~80 fiat codes (<InlineCode>USD</InlineCode>, <InlineCode>EUR</InlineCode>, <InlineCode>PHP</InlineCode> …), any case; stored upper case. Payment links in the dashboard and newly paired POS tablets start in it. <InlineCode>DD</InlineCode> (DigiDollar) is accepted only while the store can offer it (DigiDollar on and DigiPay offering it beyond the API), otherwise <InlineCode>400 digidollar_not_enabled_for_store</InlineCode>; turning DigiDollar off later keeps the saved value, and it acts as <InlineCode>USD</InlineCode> until DigiDollar is back. An empty string or <InlineCode>null</InlineCode> clears it; any other value answers <InlineCode>400</InlineCode>.</Param>
                </ParamList>
                <p class="@Small m-0">
                    Returns the store, plus <InlineCode>webhookSecret</InlineCode>. It holds the secret only on the call that created it, and is
                    <InlineCode>null</InlineCode> on every other call. Store it then: it can't be read again (rotate it if it's lost).
                </p>
            </Endpoint>

            <Endpoint Method="POST" Path="/v1/pay/stores/{id}/webhook-secret/rotate" Auth="API key" Id="rotate-webhook-secret">
                <p class="@Small">Replace the store's webhook secret. The new secret is returned once:</p>
                <CodeBlock Lang="json" Label="Copy the rotate response example">@("{\n  \"webhookSecret\": \"3f9a1c7e5b2d8f4a6c0e9b1d7f3a5c8e2b4d6f8a0c1e3b5d\"\n}")</CodeBlock>
                <p class="@Small m-0">The old secret stops working immediately: every webhook after this call is signed with the new one, so update your receiver straight away.</p>
            </Endpoint>

            <Endpoint Method="DELETE" Path="/v1/pay/stores/{id}" Auth="API key" Id="delete-store">
                <p class="@Small m-0">Delete a store. Answers <InlineCode>400</InlineCode> (<InlineCode>cannot delete your only store</InlineCode>) if it's the account's last one.</p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/stores/{id}/donation-address" Auth="API key" Id="donation-address">
                <p class="@Small m-0">A stable address for <a href="/docs#donation-button" class="text-dgb-500 hover:underline">donation buttons</a>, as <InlineCode>{ address, mode }</InlineCode>. In xpub mode it's derivation index 0, which is then reserved (invoices start at 1). In address mode it's the configured address. <InlineCode>400</InlineCode> if the store has no receive address.</p>
                <p class="@Small m-0">With <InlineCode>?currency=DD</InlineCode> it returns the store's DigiDollar donation address (<InlineCode>mode: "dd"</InlineCode>), made on the first call and never changed, so DD tips sent later are still credited. Needs DigiDollar on for the store and offered by DigiPay beyond the API, otherwise <InlineCode>400 digidollar_not_enabled_for_store</InlineCode>; <InlineCode>503 digidollar_node_unavailable</InlineCode> if the address can't be made right now. DigiPay holds DD tips until they're paid out to the store's payout address.</p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/public/stores/{id}/donation-options" Auth="No auth" Id="donation-options">
                <p class="@Small m-0">What a store's tip page can offer, as <InlineCode>{ storeName, network, dgbAddress, ddAddress, ddAvailable, ddReason }</InlineCode>. <InlineCode>dgbAddress</InlineCode> is the store's address in address mode (null for xpub stores, whose buttons carry the address themselves); <InlineCode>ddAddress</InlineCode> is set only while the store has DigiDollar on and DigiPay offers it, so turning DigiDollar off removes it from every button already embedded. <InlineCode>ddAvailable</InlineCode> is false (<InlineCode>ddReason: "unavailable"</InlineCode>) while the DigiDollar node can't be reached. Read-only and rate-limited; <InlineCode>404</InlineCode> for an unknown store.</p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/stores/{id}/analytics" Auth="API key" Id="analytics">
                <p class="@Small">Daily totals for the dashboard charts: <InlineCode>{ storeId, days, since, until, summary, series }</InlineCode>.</p>
                <ParamList Title="Query parameters">
                    <Param Name="days" Type="integer">1 to 365, default 30. Days are UTC.</Param>
                </ParamList>
                <p class="@Small m-0">
                    <InlineCode>summary</InlineCode> has <InlineCode>totalSessions</InlineCode>, <InlineCode>totalPaid</InlineCode> (paid, confirmed and refunded), <InlineCode>totalRefunded</InlineCode>,
                    <InlineCode>grossVolumeDgb</InlineCode>, <InlineCode>conversionPct</InlineCode> and <InlineCode>refundRatePct</InlineCode>. Each <InlineCode>series</InlineCode> entry has
                    <InlineCode>day</InlineCode>, <InlineCode>total</InlineCode>, <InlineCode>paid</InlineCode>, <InlineCode>refunded</InlineCode>, <InlineCode>voided</InlineCode>, <InlineCode>failed</InlineCode> and <InlineCode>volumeDgb</InlineCode>.
                </p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/stores/{id}/stats/daily" Auth="API key" Id="daily-stats">
                <p class="@Small">Sales per day on your own calendar days, for the dashboard's Overview charts:
                    <InlineCode>{ storeId, days, timeZone, from, to, fromUtc, toUtc, storeHasPayments, totals, previous, series }</InlineCode>.</p>
                <ParamList Title="Query parameters">
                    <Param Name="days" Type="integer">1 to 365, default 30. The window ends today (in <InlineCode>tz</InlineCode>) and includes it. Anything else answers <InlineCode>400</InlineCode>.</Param>
                    <Param Name="tz" Type="string">The time zone whose calendar days to count in, such as <InlineCode>Europe/Amsterdam</InlineCode>. Default UTC; an unknown zone answers <InlineCode>400</InlineCode>.</Param>
                </ParamList>
                <p class="@Small">
                    <InlineCode>totals</InlineCode> counts the window's sessions by creation day: <InlineCode>payments</InlineCode>, <InlineCode>paid</InlineCode> (paid or confirmed), <InlineCode>open</InlineCode> (waiting or detected),
                    <InlineCode>expired</InlineCode>, <InlineCode>underpaid</InlineCode>, <InlineCode>refunded</InlineCode>, <InlineCode>voided</InlineCode>, <InlineCode>revenueDgb</InlineCode>, the DGB amount of the paid and confirmed DGB sessions, and <InlineCode>revenueDdCents</InlineCode>, the same for DigiDollar sessions in USD cents (never added into DGB).
                    <InlineCode>series</InlineCode> has one entry per day, oldest first and including days with nothing, each with <InlineCode>date</InlineCode> (<InlineCode>yyyy-MM-dd</InlineCode>) and the same fields.
                </p>
                <p class="@Small m-0">
                    <InlineCode>previous</InlineCode> is <InlineCode>{ from, to, totals }</InlineCode> for the same number of days just before the window, for "+12% vs previous 30 days";
                    it is <InlineCode>null</InlineCode> when the store didn't exist yet before the window. <InlineCode>fromUtc</InlineCode> and <InlineCode>toUtc</InlineCode> are the window's start and (exclusive) end as UTC instants.
                    <InlineCode>storeHasPayments</InlineCode> says whether the store has ever had a session, to tell a new store from a quiet period.
                </p>
            </Endpoint>

            @* ===================== Webhooks ===================== *@
            <DocsHeading Id="webhooks">Webhooks</DocsHeading>
            <p class="@P">
                DigiPay sends a signed <InlineCode>POST</InlineCode> with a JSON body to the store's <InlineCode>webhookUrl</InlineCode> whenever a session changes state.
                A store needs both a URL and a secret; set the URL with <a href="/docs/api#update-store" class="text-dgb-500 hover:underline">PATCH store</a>.
            </p>

            <DocsHeading Id="webhook-events" Level="3">Events</DocsHeading>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead><tr><th scope="col">Event</th><th scope="col">Sent when</th></tr></thead>
                    <tbody>
                        <tr><td><InlineCode>session.seen</InlineCode></td><td>A payment for at least 99% of the amount is in the mempool, unconfirmed.</td></tr>
                        <tr><td><InlineCode>session.paid</InlineCode></td><td>That payment has 1 confirmation.</td></tr>
                        <tr><td><InlineCode>session.confirmed</InlineCode></td><td>It has 6 confirmations. Can arrive without <InlineCode>session.paid</InlineCode> first if the payment was already that deep when DigiPay saw it.</td></tr>
                        <tr><td><InlineCode>session.underpaid</InlineCode></td><td>The payment found is less than 99% of the amount.</td></tr>
                        <tr><td><InlineCode>session.expired</InlineCode></td><td>Nothing arrived before <InlineCode>expiresAt</InlineCode>. A payment within the next 3 days still moves the session on and sends <InlineCode>session.paid</InlineCode> or <InlineCode>session.confirmed</InlineCode>.</td></tr>
                        <tr><td><InlineCode>session.refunded</InlineCode></td><td>You recorded a refund (<a href="/docs/api#refund-session" class="text-dgb-500 hover:underline">refund</a>). <InlineCode>refundTxid</InlineCode>, <InlineCode>refundedAt</InlineCode> and <InlineCode>refundNote</InlineCode> are set.</td></tr>
                        <tr><td><InlineCode>session.extra_payment</InlineCode></td><td>On a buyer-choice session, funds arrived in the currency the buyer didn't pay in. Sent once, with <InlineCode>session.extra</InlineCode>; refund the buyer from your wallet.</td></tr>
                        <tr><td><InlineCode>session.voided</InlineCode></td><td>You cancelled an unpaid session (<a href="/docs/api#void-session" class="text-dgb-500 hover:underline">void</a>).</td></tr>
                        <tr><td><InlineCode>payout.sent</InlineCode></td><td>DigiDollar held for the store was sent to its DD payout address. The body has a <InlineCode>payout</InlineCode> object (amount in cents, destination, txid, and the sessions it covers) instead of a <InlineCode>session</InlineCode>.</td></tr>
                        <tr><td><InlineCode>payout.confirmed</InlineCode></td><td>That payout has 6 confirmations.</td></tr>
                        <tr><td><InlineCode>payout.failed</InlineCode></td><td>A payout didn't go through. <InlineCode>failureCode</InlineCode>, <InlineCode>failureReason</InlineCode> and <InlineCode>willRetry</InlineCode> say why and what happens next; the DD is still held for you.</td></tr>
                        <tr><td><InlineCode>payout_address.change_requested</InlineCode>, <InlineCode>payout_address.change_cancelled</InlineCode>, <InlineCode>payout_address.changed</InlineCode></td><td>The store's DD payout address change was requested (it takes effect after 48 hours), cancelled, or took effect. The body has a <InlineCode>payoutAddress</InlineCode> object with the old and new addresses.</td></tr>
                        <tr><td><InlineCode>webhook.test</InlineCode></td><td>You asked for a test (<a href="/docs/api#webhook-test" class="text-dgb-500 hover:underline">test</a>). Its session is made up (<InlineCode>ses_test_…</InlineCode>); it is sent once, never retried, and can't be replayed.</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="@Small">New event types may be added. Answer <InlineCode>200</InlineCode> to ones you don't handle; anything else counts as a failed delivery.</p>

            <DocsHeading Id="dd-payouts" Level="3">DigiDollar payouts (beta)</DocsHeading>
            <p class="@Small">
                DigiPay holds the DigiDollar (DD) buyers pay a store until it's paid out to the store's DD payout address. Set the
                address in the Dashboard (DigiDollar payouts): it needs a fresh Digi-ID sign-in, and a change waits 48 hours with payouts
                held, so a stolen session can't redirect your money. API keys can't set or change it. By default each payment is paid out
                once it has 6 confirmations; you can choose once a day or a balance threshold instead. DigiPay pays the DGB network fee,
                so you receive the full DD amount. Payouts start at 1.00 DD.
            </p>
            <p class="@Small">
                Read-only with an API key: <InlineCode>GET /v1/pay/stores/{storeId}/dd-balance</InlineCode> (held DD, why it's held, by
                source), <InlineCode>GET /v1/pay/stores/{storeId}/payouts</InlineCode> (newest first, <InlineCode>?status=</InlineCode>
                and <InlineCode>?cursor=</InlineCode>) and <InlineCode>GET /v1/pay/payouts/{payoutId}</InlineCode>. In your own session
                list, DD rows carry <InlineCode>ddPayout</InlineCode> and <InlineCode>ddExtraRefundCents</InlineCode>. Turning DigiDollar
                on (<InlineCode>digiDollarEnabled: true</InlineCode>) answers <InlineCode>409 payout_address_required</InlineCode> until the
                store has a payout address.
            </p>

            <DocsHeading Id="webhook-headers" Level="3">Headers</DocsHeading>
            <ul class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 list-disc pl-5 mb-3 space-y-1">
                <li><InlineCode>X-DigiPay-Signature: sha256=&lt;hex&gt;</InlineCode> — HMAC-SHA256 of the raw body, keyed with the store's webhook secret.</li>
                <li><InlineCode>X-DigiPay-Event</InlineCode> — the event name, the same as <InlineCode>event</InlineCode> in the body. Handy for routing without parsing.</li>
                <li><InlineCode>X-DigiPay-Delivery: wdel_…</InlineCode> — the id of this delivery attempt. Every retry and replay gets a <em>new</em> id, so log it, but don't de-duplicate on it.</li>
            </ul>

            <DocsHeading Id="webhook-body" Level="3">Body</DocsHeading>
            <CodeBlock Lang="json" Label="Copy the webhook body example">@("{\n  \"event\": \"session.paid\",\n  \"timestamp\": \"2026-11-26T12:34:56Z\",\n  \"session\": {\n    \"id\": \"ses_8kq2x7m4n9p3r6t1\",\n    \"merchantId\": \"mer_2m8p4q6r1t3v5x7z\",\n    \"storeId\": \"sto_4fj8w2k9m3n7p5q1\",\n    \"address\": \"dgb1qexampleaddress\",\n    \"amountSatoshis\": 1250000000,\n    \"amount\": 12.5,\n    \"fiatCurrency\": \"USD\",\n    \"fiatAmount\": 5.00,\n    \"label\": \"Order #4201\",\n    \"memo\": \"inv-001\",\n    \"status\": \"paid\",\n    \"receivedSatoshis\": 1250000000,\n    \"confirmations\": 1,\n    \"paidTxid\": \"c4de7f12a34bc6de3e9f1d7b5a2c3f7e8b4d1a6c9e5f2a8d3b7c1e4f6a9d2c5\",\n    \"returnUrl\": \"https://shop.example/orders/42/thanks\",\n    \"createdAt\": \"2026-11-26T12:30:02Z\",\n    \"expiresAt\": \"2026-11-26T13:00:02Z\",\n    \"currency\": \"DGB\"\n  }\n}")</CodeBlock>
            <ParamList Title="Notes">
                <Param Name="null fields">Fields with no value are left out of the body rather than sent as null: <InlineCode>fiatCurrency</InlineCode>, <InlineCode>label</InlineCode>, <InlineCode>paidTxid</InlineCode> and so on appear only when set.</Param>
                <Param Name="refundTxid, refundedAt, refundNote">Present on <InlineCode>session.refunded</InlineCode> (a void sets <InlineCode>refundedAt</InlineCode> and, if given, <InlineCode>refundNote</InlineCode>).</Param>
                <Param Name="currency, amountCentsDd">DigiDollar sessions carry <InlineCode>"currency": "DD"</InlineCode> and <InlineCode>amountCentsDd</InlineCode>; their <InlineCode>amountSatoshis</InlineCode> is 0 and <InlineCode>receivedSatoshis</InlineCode> holds the cents received.</Param>
                <Param Name="timestamp">When this attempt was sent. Rejecting deliveries more than about 5 minutes from your clock protects you if your secret leaks; each retry carries a fresh timestamp.</Param>
            </ParamList>

            <DocsHeading Id="webhook-retries" Level="3">Retries and de-duplication</DocsHeading>
            <p class="@P">
                A delivery fails when your server can't be reached, times out, or answers anything but <InlineCode>2xx</InlineCode> (redirects aren't followed).
                Network errors, <InlineCode>5xx</InlineCode>, <InlineCode>408</InlineCode> and <InlineCode>429</InlineCode> are retried automatically after
                <strong>1 minute, 5 minutes, 30 minutes, 2 hours and 6 hours</strong> (7 attempts over about 8.5 hours). Other <InlineCode>4xx</InlineCode> answers
                are treated as permanent and not retried. After the last attempt the delivery stays failed until you replay it.
            </p>
            <p class="@P">
                Each retry or replay is a new delivery, rebuilt from the session's <em>current</em> state, with a new id, timestamp and signature. So you may see an
                event more than once: de-duplicate on <InlineCode>session.id</InlineCode> plus <InlineCode>event</InlineCode>, and treat
                <InlineCode>session.status</InlineCode> as the truth. For money-critical steps you can always confirm with
                <a href="/docs/api#get-session" class="text-dgb-500 hover:underline">GET /v1/pay/sessions/{id}</a>.
            </p>

            <DocsHeading Id="webhook-log" Level="3">Test, delivery log and replay</DocsHeading>
            <Endpoint Method="POST" Path="/v1/pay/stores/{id}/webhook/test" Auth="API key" Id="webhook-test">
                <p class="@Small m-0">Sends a <InlineCode>webhook.test</InlineCode> event to the configured URL now and returns <InlineCode>{ ok, webhookUrl, deliveryId, statusCode, error }</InlineCode>, so you can see what your server answered. <InlineCode>400</InlineCode> if the store has no webhook URL.</p>
            </Endpoint>
            <Endpoint Method="GET" Path="/v1/pay/stores/{id}/webhook-deliveries" Auth="API key" Id="webhook-deliveries">
                <p class="@Small">Recent delivery attempts, newest first. Each has <InlineCode>id</InlineCode>, <InlineCode>sessionId</InlineCode>, <InlineCode>eventName</InlineCode>, <InlineCode>url</InlineCode>, <InlineCode>attempt</InlineCode>, <InlineCode>statusCode</InlineCode> or <InlineCode>errorMessage</InlineCode>, <InlineCode>durationMs</InlineCode>, <InlineCode>responseSnippet</InlineCode> (the first 512 characters of your reply, as plain text), <InlineCode>success</InlineCode>, and <InlineCode>nextRetryAt</InlineCode> (set while a retry is scheduled; null once it succeeded or gave up).</p>
                <ParamList Title="Query parameters">
                    <Param Name="take" Type="integer">1 to 100, default 25. With <InlineCode>format=csv</InlineCode>: up to 10000.</Param>
                    <Param Name="sessionId" Type="string">Only deliveries for this session, including retries and replays.</Param>
                    <Param Name="format" Type="string"><InlineCode>csv</InlineCode> returns a spreadsheet download. The response text is replaced by its length.</Param>
                </ParamList>
            </Endpoint>
            <Endpoint Method="POST" Path="/v1/pay/stores/{id}/webhook-deliveries/{deliveryId}/replay" Auth="API key" Id="webhook-replay">
                <p class="@Small m-0">Sends a past delivery's event again, rebuilt from the session's current state, as a new delivery with <InlineCode>attempt</InlineCode> increased by one. Test deliveries can't be replayed (<InlineCode>400</InlineCode>): send a new test instead.</p>
            </Endpoint>

            <DocsHeading Id="verify-signature" Level="3">Verifying the signature</DocsHeading>
            <p class="@P">
                Compute <InlineCode>HMAC_SHA256(secret, rawBody)</InlineCode> as lowercase hex, prefix it with <InlineCode>sha256=</InlineCode>, and compare it with the
                <InlineCode>X-DigiPay-Signature</InlineCode> header in <strong>constant time</strong>. Verify before parsing: the signature covers the exact bytes, so
                re-serialised JSON won't match. Answer <InlineCode>401</InlineCode> on a mismatch or a missing header.
            </p>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mt-4 mb-2"><strong>Node</strong> (Express):</p>
            <CodeBlock Lang="js" Label="Copy the Node verification example">@Docs.NodeVerify</CodeBlock>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mt-4 mb-2"><strong>Python</strong> (Flask):</p>
            <CodeBlock Lang="python" Label="Copy the Python verification example">@("import hmac, hashlib, os\nfrom flask import Flask, request, abort\n\napp = Flask(__name__)\n\n@app.post('/digipay/webhook')\ndef webhook():\n    raw = request.get_data()\n    expected = 'sha256=' + hmac.new(\n        os.environ['DIGIPAY_WEBHOOK_SECRET'].encode(),\n        raw, hashlib.sha256).hexdigest()\n    provided = request.headers.get('X-DigiPay-Signature', '')\n    if not hmac.compare_digest(expected, provided):\n        abort(401)\n    event = request.get_json()  # safe now\n    # de-duplicate on event['session']['id'] + event['event']\n    return '', 200")</CodeBlock>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mt-4 mb-2"><strong>PHP</strong>:</p>
            <CodeBlock Lang="php" Label="Copy the PHP verification example">@("<?php\n$raw = file_get_contents('php://input');\n$expected = 'sha256=' . hash_hmac('sha256', $raw, getenv('DIGIPAY_WEBHOOK_SECRET'));\n$provided = $_SERVER['HTTP_X_DIGIPAY_SIGNATURE'] ?? '';\nif (!hash_equals($expected, $provided)) {\n    http_response_code(401);\n    exit;\n}\n$event = json_decode($raw, true);\n// de-duplicate on $event['session']['id'] + $event['event']\nhttp_response_code(200);")</CodeBlock>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mt-4 mb-2"><strong>C#</strong> (ASP.NET Core):</p>
            <CodeBlock Lang="csharp" Label="Copy the C# verification example">@("app.MapPost(\"/digipay/webhook\", async (HttpRequest req) =>\n{\n    using var ms = new MemoryStream();\n    await req.Body.CopyToAsync(ms);\n    var raw = ms.ToArray();\n    var secret = Environment.GetEnvironmentVariable(\"DIGIPAY_WEBHOOK_SECRET\")!;\n    using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(secret));\n    var expected = \"sha256=\" + Convert.ToHexString(hmac.ComputeHash(raw)).ToLowerInvariant();\n    var provided = req.Headers[\"X-DigiPay-Signature\"].ToString();\n    // FixedTimeEquals returns false (not throws) when the lengths differ.\n    if (!CryptographicOperations.FixedTimeEquals(\n            Encoding.UTF8.GetBytes(expected), Encoding.UTF8.GetBytes(provided)))\n        return Results.Unauthorized();\n    // JsonSerializer.Deserialize<WebhookEvent>(raw) ...\n    return Results.Ok();\n});")</CodeBlock>

            @* ===================== Embed ===================== *@
            <DocsHeading Id="embed">Embed script</DocsHeading>
            <p class="@P">
                <InlineCode>https://pay.dgbwallet.app/embed/digipay.js</InlineCode> is a small script with no dependencies that opens the hosted checkout in a modal
                over your page. <a href="/embed/demo.html" target="_blank" class="text-dgb-500 hover:underline">Try it live<span class="sr-only"> (opens in a new tab)</span></a>.
            </p>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mb-2">From code:</p>
            <CodeBlock Lang="js" Label="Copy the embed API example">@("DigiPay.checkout({ sessionId: 'ses_abc' });                  // open the checkout modal\nDigiPay.checkout({ sessionId: 'ses_abc', theme: 'light' });  // theme: 'light' | 'dark' (optional)\nDigiPay.close();                                             // close it\nconst a = DigiPay.button({ address: 'dgb1...', amount: 5, name: 'Shop' });\ndocument.body.appendChild(a);                                // a donation button")</CodeBlock>
            <p class="leading-relaxed text-slate-700 dark:text-slate-300 mt-3 mb-2">From markup:</p>
            <CodeBlock Lang="html" Label="Copy the embed markup example">@("<button data-digipay-checkout data-session-id=\"ses_abc\">Pay</button>\n<span data-digipay-button data-address=\"dgb1...\" data-amount=\"5\">Tip</span>\n<!-- optional on either: data-theme=\"light\" or \"dark\" -->")</CodeBlock>
            <p class="@P">Elements are bound on <InlineCode>DOMContentLoaded</InlineCode>; call <InlineCode>DigiPay.bind(rootEl)</InlineCode> after adding new ones.</p>

            <DocsHeading Id="embed-callbacks" Level="3">Callbacks</DocsHeading>
            <p class="@P">Options for <InlineCode>DigiPay.checkout(options)</InlineCode>:</p>
            <ParamList>
                <Param Name="sessionId" Type="string" Required="true">The session to pay.</Param>
                <Param Name="theme" Type="string"><InlineCode>light</InlineCode> or <InlineCode>dark</InlineCode>. Without it the checkout follows the buyer's own setting.</Param>
                <Param Name="onStatus" Type="function">Called with <InlineCode>{ sessionId, status }</InlineCode> on every status change the checkout shows: <InlineCode>pending</InlineCode>, <InlineCode>seen</InlineCode>, <InlineCode>paid</InlineCode>, <InlineCode>confirmed</InlineCode>, <InlineCode>underpaid</InlineCode>, <InlineCode>expired</InlineCode>, <InlineCode>refunded</InlineCode>, <InlineCode>voided</InlineCode>.</Param>
                <Param Name="onSuccess" Type="function">Called once with <InlineCode>{ sessionId, status }</InlineCode> when the payment is <InlineCode>confirmed</InlineCode>. With it, you decide what happens next; without it the widget goes to the session's <InlineCode>returnUrl</InlineCode> (if any) after closing.</Param>
                <Param Name="closeDelay" Type="number">Milliseconds the modal stays open after <InlineCode>confirmed</InlineCode>, so the buyer sees it. Default 2500.</Param>
            </ParamList>
            <CodeBlock Lang="js" Label="Copy the embed callbacks example">@Docs.EmbedCallbacks</CodeBlock>
            <p class="@Small">An error thrown inside a callback is caught and logged, so it can't break the checkout.</p>

            <DocsHeading Id="embed-messages" Level="3">Messages from the checkout</DocsHeading>
            <p class="@P">
                The callbacks are built on messages the checkout iframe posts to your page with <InlineCode>postMessage</InlineCode>. Listen for them
                yourself if you embed the checkout without <InlineCode>digipay.js</InlineCode>:
            </p>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead><tr><th scope="col"><InlineCode>type</InlineCode></th><th scope="col">Other fields</th><th scope="col">Sent when</th></tr></thead>
                    <tbody>
                        <tr><td><InlineCode>digipay-checkout-status</InlineCode></td><td><InlineCode>sessionId</InlineCode>, <InlineCode>status</InlineCode>, <InlineCode>returnUrl</InlineCode></td><td>The status changes (and once when the checkout loads).</td></tr>
                        <tr><td><InlineCode>digipay-checkout-return</InlineCode></td><td><InlineCode>sessionId</InlineCode>, <InlineCode>status</InlineCode>, <InlineCode>url</InlineCode></td><td>The buyer chose to go back to the shop. Navigate your page to <InlineCode>url</InlineCode>.</td></tr>
                        <tr><td><InlineCode>digipay-checkout-escape</InlineCode></td><td>none</td><td>The buyer pressed Escape inside the checkout. Close it.</td></tr>
                    </tbody>
                </table>
            </div>
            <CodeBlock Lang="js" Label="Copy the status event example">@("window.addEventListener('message', (e) => {\n  if (e.origin !== 'https://pay.dgbwallet.app') return;\n  const msg = e.data;\n  if (!msg || msg.type !== 'digipay-checkout-status') return;\n  // msg.sessionId, msg.status: 'seen' | 'paid' | 'confirmed' | 'expired' | ...\n  if (msg.status === 'paid') showThankYou();\n});")</CodeBlock>
            <p class="@Small">Use callbacks and messages for your page's UI only. Anyone can post messages to a window, and the buyer's browser can close at any moment, so fulfil orders from the webhook.</p>

            @* ===================== Account ===================== *@
            <DocsHeading Id="account">Account and audit log</DocsHeading>
            <p class="@Small">Used by the dashboard; not in the OpenAPI document.</p>
            <Endpoint Method="GET" Path="/v1/pay/me" Auth="API key or session" Id="get-me">
                <p class="@Small m-0">The signed-in account: <InlineCode>{ id, displayName, digiIdAddress, createdAt, stores: [ … ] }</InlineCode>.</p>
            </Endpoint>
            <Endpoint Method="PATCH" Path="/v1/pay/me" Auth="API key or session" Id="update-me">
                <CodeBlock Lang="json" Label="Copy the update-account body">@("{\n  \"displayName\": \"Acme Co\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="displayName" Type="string">1 to 120 characters. Everything else is set per store.</Param>
                </ParamList>
            </Endpoint>
            <Endpoint Method="GET" Path="/v1/pay/me/audit" Auth="API key or session" Id="audit">
                <p class="@Small">The account's append-only audit trail, newest first: <InlineCode>{ items: [ … ], nextCursor }</InlineCode>. Each item has <InlineCode>action</InlineCode> (for example <InlineCode>session.refund</InlineCode>, <InlineCode>store.update</InlineCode>), the actor (type, token prefix, IP), the target, a summary, metadata and <InlineCode>createdAt</InlineCode>.</p>
                <ParamList Title="Query parameters">
                    <Param Name="limit" Type="integer">1 to 200, default 50.</Param>
                    <Param Name="cursor" Type="string">The <InlineCode>nextCursor</InlineCode> from the previous page (a UTC timestamp). Omit for the newest entries; <InlineCode>nextCursor</InlineCode> is null on the last page.</Param>
                </ParamList>
            </Endpoint>

            @* ===================== API keys ===================== *@
            <DocsHeading Id="api-keys">API keys</DocsHeading>
            <p class="@Small">Managed from the dashboard; not in the OpenAPI document.</p>
            <Endpoint Method="GET" Path="/v1/pay/api-keys" Auth="API key or session" Id="list-keys">
                <p class="@Small m-0">Your keys: prefix, label, created, last used and revoked dates. Never the secret.</p>
            </Endpoint>
            <Endpoint Method="POST" Path="/v1/pay/api-keys" Auth="API key or session" Id="create-key">
                <CodeBlock Lang="json" Label="Copy the create-key body">@("{\n  \"label\": \"production\"\n}")</CodeBlock>
                <ParamList>
                    <Param Name="label" Type="string">Optional, up to 80 characters.</Param>
                </ParamList>
                <p class="@Small m-0">The full key is returned <strong>once</strong>, as <InlineCode>apiKey</InlineCode>. DigiPay keeps only its hash.</p>
            </Endpoint>
            <Endpoint Method="DELETE" Path="/v1/pay/api-keys/{id}" Auth="API key or session" Id="revoke-key">
                <p class="@Small m-0">Revoke a key. Calls with it then get <InlineCode>401</InlineCode>. Existing sessions carry on and their webhooks still fire.</p>
            </Endpoint>

            @* ===================== Digi-ID ===================== *@
            <DocsHeading Id="digi-id">Digi-ID sign-in</DocsHeading>
            <p class="@Small">The browser dashboard's sign-in flow. Servers don't need it. Limited to 10 requests per minute per address.</p>
            <Endpoint Method="GET" Path="/v1/pay/auth/challenge" Auth="No auth" Id="auth-challenge">
                <p class="@Small m-0">Returns <InlineCode>{ nonce, uri, expiresAt }</InlineCode>. Show <InlineCode>uri</InlineCode> as a QR code for the DigiByte wallet to sign.</p>
            </Endpoint>
            <Endpoint Method="POST" Path="/v1/pay/auth/callback" Auth="No auth" Id="auth-callback">
                <p class="@Small m-0">Called by the wallet with <InlineCode>@("{ address, uri, signature }")</InlineCode>. DigiPay checks the signature, creates the account and its Default Store if new, and marks the challenge signed. <InlineCode>409</InlineCode> if the challenge was already used or has expired.</p>
            </Endpoint>
            <Endpoint Method="GET" Path="/v1/pay/auth/poll/{nonce}" Auth="No auth" Id="auth-poll">
                <p class="@Small m-0">The browser polls until it returns <InlineCode>{ status: "signed", merchantId, displayName, token }</InlineCode>. The token is a <InlineCode>dps_</InlineCode> session token.</p>
            </Endpoint>
            <Endpoint Method="DELETE" Path="/v1/pay/auth/session" Auth="Session" Id="auth-signout">
                <p class="@Small m-0">Sign out: revokes the current <InlineCode>dps_</InlineCode> token. API keys aren't affected.</p>
            </Endpoint>

            @* ===================== Public ===================== *@
            <DocsHeading Id="public">Public data</DocsHeading>
            <Endpoint Method="GET" Path="/v1/pay/public/stats" Auth="No auth" Id="public-stats">
                <p class="@Small m-0">Site-wide totals for the home page: <InlineCode>{ merchants, stores, sessions, paidSessions, totalDgb, generatedAt }</InlineCode>. Counts only, demo and test data excluded, cached for 30 seconds.</p>
            </Endpoint>
            <Endpoint Method="GET" Path="/v1/pay/public/price" Auth="No auth" Id="public-price">
                <p class="@Small">The price of 1 DGB in a fiat currency, worked out the same way as the DigiByte wallet: CoinGecko's own price where it quotes DGB in that currency, otherwise the USD price times the USD exchange rate. Used by POS tablets, payment links and the checkout. Returns <InlineCode>{ currency, dgbPrice, fetchedAt, source, decimals, symbol, stale }</InlineCode>.</p>
                <ParamList Title="Query parameters">
                    <Param Name="currency" Type="string">Any code from <InlineCode>GET /v1/pay/public/currencies</InlineCode> (the wallet's list of about 80), case-insensitive; default <InlineCode>usd</InlineCode>. Anything else: <InlineCode>400</InlineCode>.</Param>
                </ParamList>
                <ParamList Title="Response fields">
                    <Param Name="source" Type="string"><InlineCode>coingecko</InlineCode> (priced directly) or <InlineCode>coingecko+fx</InlineCode> (USD price times the USD exchange rate, refreshed every 6 hours).</Param>
                    <Param Name="decimals" Type="number">Digits after the decimal point for amounts in this currency: 0 for yen, won or rupiah, 3 for the Gulf dinars, otherwise 2. Round fiat amounts to this.</Param>
                    <Param Name="symbol" Type="string">The symbol written before an amount, for example ₱.</Param>
                    <Param Name="stale" Type="boolean"><InlineCode>true</InlineCode> when CoinGecko couldn't be reached and this is the last price from the past 10 minutes (check <InlineCode>fetchedAt</InlineCode>).</Param>
                </ParamList>
                <p class="@Small m-0">Prices are cached for 60 seconds. With no price at all: <InlineCode>502</InlineCode>. To charge a fiat amount, send <InlineCode>amount = fiatAmount / dgbPrice</InlineCode> rounded to 8 decimals, with <InlineCode>fiatCurrency</InlineCode>, <InlineCode>fiatAmount</InlineCode> and <InlineCode>dgbPriceAtCreation</InlineCode>.</p>
            </Endpoint>

            <Endpoint Method="GET" Path="/v1/pay/public/currencies" Auth="No auth" Id="public-currencies">
                <p class="@Small m-0">The fiat currencies DigiPay can price in, the same list as the DigiByte wallet: <InlineCode>{ regions, currencies: [{ code, name, symbol, region, decimals, flag }] }</InlineCode>. <InlineCode>flag</InlineCode> is an ISO country code, or null for currencies shared by several countries.</p>
            </Endpoint>

            @* ===================== Sandbox ===================== *@
            <DocsHeading Id="sandbox">Sandbox</DocsHeading>
            <p class="@P">
                Pretend a buyer paid, without coins: on your own <strong>testnet or regtest</strong> store, or on a throwaway demo session.
                20 requests per minute per address. The <a href="/docs#qs-simulate" class="text-dgb-500 hover:underline">quickstart</a> walks through the
                whole flow, and <a href="/docs#testing" class="text-dgb-500 hover:underline">testing without real money</a> lists the other options.
            </p>
            <Endpoint Method="POST" Path="/v1/pay/test/sessions/{id}/advance" Auth="API key (demo sessions: no auth) · 20/min" Id="advance-session">
                <p class="@Small">
                    Moves a session one step per call: <InlineCode>pending → seen → paid</InlineCode> (1 confirmation) <InlineCode>→ confirmed</InlineCode> (6),
                    with a made-up txid. It sends the same webhooks as a real payment (<InlineCode>session.seen</InlineCode>, <InlineCode>session.paid</InlineCode>,
                    <InlineCode>session.confirmed</InlineCode>, signed as usual) and updates any open checkout. The body is optional:
                </p>
                <CodeBlock Lang="json" Label="Copy the advance body">@("{\n  \"to\": \"confirmed\",\n  \"confirmations\": 6\n}")</CodeBlock>
                <ParamList>
                    <Param Name="to" Type="string"><InlineCode>seen</InlineCode>, <InlineCode>paid</InlineCode> or <InlineCode>confirmed</InlineCode>: jump straight there instead of one step.</Param>
                    <Param Name="confirmations" Type="integer">Set the confirmation count, for example 3 to watch a payment part way to final.</Param>
                </ParamList>
                <p class="@Small">Returns where the session is now:</p>
                <CodeBlock Lang="json" Label="Copy the advance response">@("{\n  \"id\": \"ses_8kq2x7m4n9p3r6t1\",\n  \"status\": \"confirmed\",\n  \"confirmations\": 6,\n  \"receivedSatoshis\": 1250000000,\n  \"paidTxid\": \"c4de7f12a34bc6de3e9f1d7b5a2c3f7e8b4d1a6c9e5f2a8d3b7c1e4f6a9d2c5\"\n}")</CodeBlock>
                <p class="@Small m-0">
                    <strong>Who can advance what.</strong> Your own sessions need the usual <InlineCode>Authorization</InlineCode> header (an API key or session
                    token of the account that owns the session), and the session's store must be on testnet or regtest: a mainnet store answers
                    <InlineCode>400</InlineCode> <InlineCode>advance only works on testnet or regtest stores</InlineCode>. Demo sessions
                    (<InlineCode>ses_demo_…</InlineCode>) need no auth and never send webhooks.
                </p>
            </Endpoint>
            <Endpoint Method="POST" Path="/v1/pay/test/demo-session" Auth="No auth · 20/min" Id="demo-session">
                <p class="@Small m-0">Creates a throwaway demo account, store and 5 DGB session, and returns <InlineCode>{ sessionId, storeId, merchantId }</InlineCode>. Open <InlineCode>https://pay.dgbwallet.app/pay/{sessionId}</InlineCode> to watch it while you advance it. Demo stores have no webhook, and demo data is swept away within a day.</p>
            </Endpoint>

            @* ===================== Errors ===================== *@
            <DocsHeading Id="errors">Status codes</DocsHeading>
            <p class="@P">Errors come back as JSON with an <InlineCode>error</InlineCode> field explaining what to fix, for example <InlineCode>{ "error": "amount (DGB) must be > 0" }</InlineCode>.</p>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead><tr><th scope="col">Code</th><th scope="col">Meaning</th><th scope="col">What to do</th></tr></thead>
                    <tbody>
                        <tr><td><InlineCode>200</InlineCode></td><td>Success.</td><td></td></tr>
                        <tr><td><InlineCode>400</InlineCode></td><td>Invalid input, or the request can't work yet (no receive address, deleting your only store).</td><td>Fix the request; don't retry as is.</td></tr>
                        <tr><td><InlineCode>401</InlineCode></td><td>Missing, wrong or revoked token.</td><td>Check the key.</td></tr>
                        <tr><td><InlineCode>404</InlineCode></td><td>Not found, or it belongs to another account (DigiPay doesn't say which).</td><td>Check the id.</td></tr>
                        <tr><td><InlineCode>409</InlineCode></td><td>Wrong state: refunding a session that isn't paid or confirmed, voiding one that isn't pending or seen, or reusing a Digi-ID challenge.</td><td>Read the session's status first.</td></tr>
                        <tr><td><InlineCode>429</InlineCode></td><td>Rate limit reached (see below).</td><td>Wait for the window to reset, then retry with backoff.</td></tr>
                        <tr><td><InlineCode>502</InlineCode></td><td>Public price only: no price source available.</td><td>Retry later.</td></tr>
                        <tr><td><InlineCode>503</InlineCode></td><td>DigiDollar sessions only: the DigiDollar node is unreachable.</td><td>Retry with backoff.</td></tr>
                    </tbody>
                </table>
            </div>

            <DocsHeading Id="rate-limits" Level="3">Rate limits</DocsHeading>
            <p class="@Small">Fixed windows; going over returns <InlineCode>429</InlineCode> until the window resets.</p>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead><tr><th scope="col">Endpoints</th><th scope="col">Limit</th></tr></thead>
                    <tbody>
                        <tr><td><InlineCode>/v1/pay/stores/…</InlineCode>, <InlineCode>/me/…</InlineCode>, <InlineCode>/api-keys/…</InlineCode></td><td>120 requests per minute per key or session token</td></tr>
                        <tr><td><InlineCode>POST /v1/pay/merchants</InlineCode></td><td>5 per hour per client address</td></tr>
                        <tr><td><InlineCode>/v1/pay/auth/…</InlineCode></td><td>10 per minute per client address</td></tr>
                        <tr><td><InlineCode>/v1/pay/test/…</InlineCode></td><td>20 per minute per client address</td></tr>
                        <tr><td><InlineCode>/v1/pay/pos/…</InlineCode></td><td>20 per minute per client address</td></tr>
                    </tbody>
                </table>
            </div>

            <DocsHeading Id="questions">Questions?</DocsHeading>
            <p class="@P">The source is open: read it, file an issue, or run DigiPay yourself. It's built to self-host in one container backed by SQLite or Postgres.</p>
        </article>
    </DocsLayout>
</main>

