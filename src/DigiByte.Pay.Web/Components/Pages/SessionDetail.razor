@page "/merchant/sessions/{SessionId}"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@using System.Net.Http.Json

<PageTitle>@(session?.Id ?? SessionId) — DigiPay</PageTitle>

@{
    const string Card = "card p-5 sm:p-6 flex flex-col gap-3";
    const string BtnGhost = "btn-secondary";
    const string Eyebrow = "section-label";
    const string Muted = "dp-muted";
    const string Mono = "font-mono text-sm break-all";
    const string H2 = "block-title";
    const string H1 = "page-title";
}

@if (bootstrapError != null)
{
    <main class="min-h-dvh flex items-center justify-center p-4 bg-slate-50 dark:bg-dgb-950 text-slate-900 dark:text-white font-sans">
        <div class="@Card text-center max-w-md">
            <h1 class="block-title">This payment couldn't be loaded</h1>
            <p class="ui-checkout-muted">It may not exist, or it belongs to another account.</p>
            <a href="@BackHref" class="btn-primary btn-sm">Back to sessions</a>
        </div>
    </main>
}
else if (session == null)
{
    <main class="min-h-dvh flex items-center justify-center p-4 bg-slate-50 dark:bg-dgb-950 text-slate-900 dark:text-white font-sans">
        <Loader Text="Loading session…" />
    </main>
}
else
{
    <div class="min-h-dvh bg-slate-50 dark:bg-dgb-950 text-slate-900 dark:text-white font-sans">
        <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10 flex flex-col gap-4">
            @* Header — back link + session id + status *@
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-2">
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        @* Back to the list the merchant came from (FR-018). *@
                        <a href="@BackHref" class="back-btn" aria-label="Back to sessions"><Icon Name="arrow-left" Class="w-5 h-5" /></a>
                        <h1 class="@H1">Session</h1>
                    </div>
                    <div class="@Mono text-slate-500 dark:text-slate-400 mt-1">@session.Id</div>
                </div>
                <div class="shrink-0 flex items-center gap-2">
                    @if (session.Source is not null && session.Source.StartsWith("pos", StringComparison.OrdinalIgnoreCase))
                    {
                        @* Same chip as the dashboard list. On the detail page we can
                           afford to print the device name inline too, since there's room. *@
                        var deviceName = session.Source.Length > 4 && session.Source[3] == ':'
                            ? session.Source[4..]
                            : null;
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-semibold uppercase tracking-wider bg-dgb-500/10 text-dgb-500"
                              title="Created from a paired POS tablet">
                            <Icon Name="zap" Class="w-3 h-3" />
                            @if (!string.IsNullOrEmpty(deviceName)) { <span>POS · @deviceName</span> } else { <span>POS</span> }
                        </span>
                    }
                    <StatusBadge Status="@session.Status" />
                </div>
            </div>

            @* Primary details *@
            <section class="@Card">
                <h2 class="@H2">Payment</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <div class="@Eyebrow">Amount</div>
                        <div class="text-2xl font-bold tabular-nums">@session.Amount.ToString("0.########") DGB</div>
                        @if (session.FiatAmount is decimal fa && !string.IsNullOrEmpty(session.FiatCurrency))
                        {
                            <div class="@Muted">~ @fa.ToString("0.00") @session.FiatCurrency (at session creation)</div>
                        }
                        <div class="@Muted mt-1">@session.ReceivedSatoshis / @session.AmountSatoshis sats received · @session.Confirmations conf</div>
                    </div>
                    <div>
                        <div class="@Eyebrow">Address</div>
                        <div class="@Mono">@session.Address</div>
                        <CopyButton Value="@(session.Address)" Label="Copy address" Text="Copy" Class="self-start" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(session.Label))
                {
                    <div>
                        <div class="@Eyebrow">Label</div>
                        <div class="text-sm">@session.Label</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(session.Memo))
                {
                    <div>
                        <div class="@Eyebrow">Memo (private)</div>
                        <div class="text-sm">@session.Memo</div>
                    </div>
                }
            </section>

            @* Timeline — a reached step means the transition actually happened; unreached
               steps still show so merchants can see what's pending / skipped. Expiry only
               renders as "reached" if we actually hit that terminal state. *@
            <section class="@Card">
                <h2 class="@H2">Timeline</h2>
                <ul class="list-none p-0 m-0 flex flex-col gap-2">
                    @{
                        var expired = session.Status == "expired";
                        RenderFragment timelineRow(bool reached, string label, DateTime? at, bool isTerminalNegative = false) =>
                            @<li class="flex items-start gap-3">
                                <span class="shrink-0 mt-0.5 w-2.5 h-2.5 rounded-full @(reached ? (isTerminalNegative ? "bg-red-500" : "bg-emerald-500") : "bg-slate-300 dark:bg-dgb-800")"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm @(reached ? "text-slate-900 dark:text-white font-medium" : "text-slate-400 dark:text-slate-500")">@label</div>
                                    @if (at is DateTime t)
                                    {
                                        <div class="@Muted">@t.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    }
                                    else if (!reached)
                                    {
                                        <div class="@Muted">pending</div>
                                    }
                                </div>
                            </li>;
                    }
                    @timelineRow(true, "Created", session.CreatedAt)
                    @timelineRow(session.SeenAt is not null, "Detected in mempool", session.SeenAt)
                    @timelineRow(session.PaidAt is not null, "Paid (1 confirmation)", session.PaidAt)
                    @timelineRow(session.Confirmations >= 6, "Confirmed (6 confirmations)", session.Confirmations >= 6 ? session.PaidAt : null)
                    @timelineRow(expired, expired ? "Expired" : $"Expires at {session.ExpiresAt.ToLocalTime():yyyy-MM-dd HH:mm}", expired ? session.ExpiresAt : null, isTerminalNegative: true)
                </ul>
            </section>

            @* Paid tx details — only when a txid exists *@
            @if (!string.IsNullOrEmpty(session.PaidTxid))
            {
                <section class="@Card">
                    <h2 class="@H2">Transaction</h2>
                    <div class="@Mono">@session.PaidTxid</div>
                    <div class="flex gap-2 flex-wrap">
                        <CopyButton Value="@(session.PaidTxid!)" Label="Copy transaction ID" Text="Copy txid" Class="self-start" />
                        <a href="@($"https://digiexplorer.info/tx/{session.PaidTxid}")" target="_blank" rel="noopener"
                           class="@BtnGhost text-xs py-1.5 px-3 no-underline">View on DigiExplorer ↗</a>
                    </div>
                </section>
            }

            @* Links — BIP21 URI + checkout URL *@
            <section class="@Card">
                <h2 class="@H2">Links</h2>
                <div>
                    <div class="@Eyebrow">Checkout URL <span class="@Muted">(public, safe to share)</span></div>
                    <div class="@Mono">@session.CheckoutUrl</div>
                    <div class="flex gap-2 flex-wrap mt-1">
                        <CopyButton Value="@(session.CheckoutUrl)" Label="Copy checkout link" Text="Copy" Class="self-start" />
                        <a href="@session.CheckoutUrl" target="_blank" rel="noopener" class="@BtnGhost text-xs py-1.5 px-3 no-underline">Open ↗</a>
                    </div>
                </div>
                <div>
                    <div class="@Eyebrow">BIP21 URI</div>
                    <div class="@Mono">@session.Uri</div>
                    <CopyButton Value="@(session.Uri)" Label="Copy payment URI" Text="Copy" Class="self-start" />
                </div>
                @if (!string.IsNullOrWhiteSpace(session.ReturnUrl))
                {
                    @* Where the buyer is sent back to once payment confirms. Shown
                       on the merchant detail view so support can verify the right
                       integration delivered the session — useful when one DigiPay
                       account fronts multiple shops. *@
                    <div>
                        <div class="@Eyebrow">Return URL <span class="@Muted">(buyer is redirected here on success)</span></div>
                        <div class="@Mono">@session.ReturnUrl</div>
                        <div class="flex gap-2 flex-wrap mt-1">
                            <CopyButton Value="@(session.ReturnUrl!)" Label="Copy return URL" Text="Copy" Class="self-start" />
                            <a href="@session.ReturnUrl" target="_blank" rel="noopener" class="@BtnGhost text-xs py-1.5 px-3 no-underline">Open ↗</a>
                        </div>
                    </div>
                }
            </section>

            @* Webhook deliveries filtered to this session *@
            <section class="@Card">
                <div class="flex items-baseline justify-between">
                    <h2 class="@H2">Webhook deliveries</h2>
                    <button class="@BtnGhost text-xs py-1.5 px-3" @onclick="LoadDeliveriesAsync" disabled="@loadingDeliveries">
                        @(loadingDeliveries ? "…" : "Refresh")
                    </button>
                </div>
                <p class="@Muted m-0">Every delivery attempt that's referenced this session. Replays create a new row with the attempt number bumped.</p>
                @if (deliveries is null)
                {
                    <p class="@Muted m-0">Loading…</p>
                }
                else if (deliveries.Count == 0)
                {
                    <p class="@Muted m-0">No webhook deliveries for this session — either no webhook is configured for the store, or no state change has fired yet.</p>
                }
                else
                {
                    <ul class="list-none p-0 m-0 flex flex-col gap-2">
                        @foreach (var d in deliveries)
                        {
                            var pillBg = d.Success
                                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300"
                                : (d.StatusCode is null
                                    ? "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"
                                    : "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300");
                            <li class="p-3 border border-slate-200 dark:border-dgb-800 rounded-lg">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="text-xs font-semibold px-2 py-0.5 rounded-full @pillBg">@(d.StatusCode?.ToString() ?? "network err")</span>
                                            <span class="font-semibold text-sm text-slate-900 dark:text-white">@d.EventName</span>
                                            @if (d.Attempt > 1) { <span class="@Muted">· attempt @d.Attempt</span> }
                                        </div>
                                        <div class="@Muted mt-1">
                                            @d.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            @(d.DurationMs is null ? "" : $" · {d.DurationMs}ms")
                                        </div>
                                        @if (!string.IsNullOrEmpty(d.ErrorMessage))
                                        {
                                            <div class="@Mono text-red-500 dark:text-red-400 mt-1">@d.ErrorMessage</div>
                                        }
                                        else if (!string.IsNullOrEmpty(d.ResponseSnippet))
                                        {
                                            <div class="@Mono text-slate-500 dark:text-slate-400 mt-1 max-w-xl">@(d.ResponseSnippet.Length > 160 ? d.ResponseSnippet[..160] + "…" : d.ResponseSnippet)</div>
                                        }
                                    </div>
                                    <button class="@BtnGhost text-xs py-1.5 px-3 shrink-0" @onclick="() => ReplayDeliveryAsync(d.Id)" disabled="@(replayingId == d.Id)">
                                        @(replayingId == d.Id ? "Replaying…" : "Replay")
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* Merchant actions — refund (Paid/Confirmed) and void (Pending/Seen).
               Refunded/voided sessions show the recorded note + timestamp so the
               audit trail is visible without re-querying the DB. Kept below
               everything else because it's an occasional action, not the
               primary workflow. *@
            <section class="@Card">
                <h2 class="@H2">Actions</h2>
                @if (session.Status is "refunded")
                {
                    <div class="text-sm">
                        Refunded @(session.RefundedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "").
                        @if (!string.IsNullOrEmpty(session.RefundTxid))
                        {
                            <div class="@Eyebrow mt-2">Refund txid</div>
                            <div class="@Mono">@session.RefundTxid</div>
                            <a href="@($"https://digiexplorer.info/tx/{session.RefundTxid}")" target="_blank" rel="noopener"
                               class="@BtnGhost text-xs py-1.5 px-3 no-underline mt-1 inline-block">View on DigiExplorer ↗</a>
                        }
                        @if (!string.IsNullOrEmpty(session.RefundNote))
                        {
                            <div class="@Eyebrow mt-2">Note</div>
                            <div class="text-sm">@session.RefundNote</div>
                        }
                    </div>
                }
                else if (session.Status is "voided")
                {
                    <div class="text-sm">
                        Voided @(session.RefundedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "").
                        @if (!string.IsNullOrEmpty(session.RefundNote))
                        {
                            <div class="@Eyebrow mt-2">Note</div>
                            <div class="text-sm">@session.RefundNote</div>
                        }
                    </div>
                }
                else if (session.Status is "paid" or "confirmed")
                {
                    <p class="@Muted m-0">Refunds aren't automatic — send DGB back to the customer from your wallet, then paste the txid here to keep the dashboard + webhooks in sync.</p>
                    <button class="@BtnGhost text-xs py-1.5 px-3 self-start" @onclick="OpenRefundDialog">Record refund</button>
                }
                else if (session.Status is "pending" or "seen")
                {
                    <p class="@Muted m-0">Cancel this invoice before payment. The customer's checkout page flips to "Cancelled by merchant".</p>
                    <button class="btn-danger btn-sm self-start" @onclick="OpenVoidDialog">Void session</button>
                }
                else
                {
                    <p class="@Muted m-0">No actions available for @session.Status sessions.</p>
                }
                @if (!string.IsNullOrEmpty(actionError))
                {
                    <p class="field-error" role="alert">@actionError</p>
                }
            </section>
        </main>
    </div>

    <ConfirmDialog Open="@showRefundDialog" Title="Record a refund" ConfirmLabel="@(submittingAction ? "Saving…" : "Record refund")"
                   Danger="false" Busy="@submittingAction" ConfirmDisabled="@string.IsNullOrWhiteSpace(refundTxid)"
                   OnConfirm="SubmitRefundAsync" OnCancel="CloseDialogs">
        <p>Paste the transaction ID of the DGB you sent back. The payment is marked <strong>refunded</strong>, a <InlineCode>session.refunded</InlineCode> webhook is sent, and the note is kept for your records.</p>
        <div class="field mt-3">
            <label class="field-label" for="refund-txid">Refund transaction ID</label>
            <input id="refund-txid" type="text" @bind="refundTxid" @bind:event="oninput" placeholder="e.g. a1b2c3…" class="input font-mono" autocomplete="off" />
        </div>
        <div class="field mt-3">
            <label class="field-label" for="refund-note">Note <span class="font-normal opacity-70">(optional)</span></label>
            <input id="refund-note" type="text" @bind="refundNote" placeholder="Duplicate order, customer request…" class="input" />
        </div>
    </ConfirmDialog>

    <ConfirmDialog Open="@showVoidDialog" Title="Void this payment?" ConfirmLabel="@(submittingAction ? "Voiding…" : "Void payment")"
                   Busy="@submittingAction" OnConfirm="SubmitVoidAsync" OnCancel="CloseDialogs">
        <p>The customer's checkout changes to "Cancelled by the merchant" and nothing more can be paid to it. Only unpaid payments can be voided, and this can't be undone.</p>
        <div class="field mt-3">
            <label class="field-label" for="void-note">Note <span class="font-normal opacity-70">(optional, only you see it)</span></label>
            <input id="void-note" type="text" @bind="voidNote" class="input" />
        </div>
    </ConfirmDialog>
}

@code {
    /// <summary>?back= : the Sessions list address this page was opened from (local /merchant paths only).</summary>
    [SupplyParameterFromQuery(Name = "back")] public string? Back { get; set; }

    private string BackHref
    {
        get
        {
            var b = ReturnUrlGuard.Sanitize(Back);
            return b == ReturnUrlGuard.Default ? "/merchant/sessions" : b;
        }
    }

    [Parameter] public string SessionId { get; set; } = "";

    private string? token;
    private SessionDto? session;
    private List<WebhookDeliveryDto>? deliveries;
    private bool loadingDeliveries;
    private string replayingId = "";
    private string copiedField = "";
    private string? bootstrapError;

    // Refund/void dialog state. We deliberately keep txid + note on the outer
    // component (not the dialog markup) so a user can close-and-reopen the
    // dialog without losing what they typed.
    private bool showRefundDialog;
    private bool showVoidDialog;
    private string refundTxid = "";
    private string refundNote = "";
    private string voidNote = "";
    private bool submittingAction;
    private string? actionError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || session != null || bootstrapError != null) return;
        try
        {
            token = await JS.InvokeAsync<string?>("localStorage.getItem", "digipay-token");
            if (string.IsNullOrEmpty(token))
            {
                var here = "/" + Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"/merchant/signin?return={Uri.EscapeDataString(ReturnUrlGuard.Sanitize(here))}");
                return;
            }
            await LoadSessionAsync();
            if (session is not null) await LoadDeliveriesAsync();
            StateHasChanged();
        }
        catch (Exception ex) { bootstrapError = "Something went wrong. Check your connection and try again."; StateHasChanged(); }
    }

    private HttpRequestMessage AuthedRequest(HttpMethod method, string path)
    {
        var req = new HttpRequestMessage(method, path);
        req.Headers.TryAddWithoutValidation("Authorization", $"Bearer {token}");
        return req;
    }

    private async Task LoadSessionAsync()
    {
        // /v1/pay/sessions/{id} is a public read — no auth needed to resolve. We
        // still send the token so future authorization rules (e.g. restricting memo
        // visibility to the owning merchant) can tighten here without a client change.
        var http = HttpFactory.CreateClient("PayApi");
        var response = await http.SendAsync(AuthedRequest(HttpMethod.Get, $"/v1/pay/sessions/{SessionId}"));
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            bootstrapError = $"Session {SessionId} not found.";
            return;
        }
        response.EnsureSuccessStatusCode();
        var payload = await response.Content.ReadFromJsonAsync<SessionResponse>();
        session = payload?.Session;
    }

    private async Task LoadDeliveriesAsync()
    {
        if (session is null) return;
        loadingDeliveries = true; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            // Scoped to the session's store + filtered server-side by sessionId so this
            // works for stores with high webhook traffic.
            var response = await http.SendAsync(AuthedRequest(HttpMethod.Get,
                $"/v1/pay/stores/{session.StoreId}/webhook-deliveries?sessionId={Uri.EscapeDataString(session.Id)}"));
            if (response.IsSuccessStatusCode)
            {
                deliveries = await response.Content.ReadFromJsonAsync<List<WebhookDeliveryDto>>() ?? new();
            }
        }
        catch { /* non-fatal */ }
        finally { loadingDeliveries = false; StateHasChanged(); }
    }

    private async Task ReplayDeliveryAsync(string deliveryId)
    {
        if (session is null) return;
        replayingId = deliveryId; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            await http.SendAsync(AuthedRequest(HttpMethod.Post,
                $"/v1/pay/stores/{session.StoreId}/webhook-deliveries/{deliveryId}/replay"));
            await LoadDeliveriesAsync();
        }
        catch { }
        finally { replayingId = ""; StateHasChanged(); }
    }

    private void OpenRefundDialog()
    {
        actionError = null;
        refundTxid = "";
        refundNote = "";
        showRefundDialog = true;
    }

    private void OpenVoidDialog()
    {
        actionError = null;
        voidNote = "";
        showVoidDialog = true;
    }

    private void CloseDialogs()
    {
        showRefundDialog = false;
        showVoidDialog = false;
        submittingAction = false;
    }

    private async Task SubmitRefundAsync()
    {
        if (session is null || string.IsNullOrWhiteSpace(refundTxid)) return;
        submittingAction = true; actionError = null; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = AuthedRequest(HttpMethod.Post, $"/v1/pay/sessions/{session.Id}/refund");
            req.Content = JsonContent.Create(new { txid = refundTxid.Trim(), note = refundNote });
            var resp = await http.SendAsync(req);
            if (!resp.IsSuccessStatusCode)
            {
                actionError = $"Refund failed ({(int)resp.StatusCode}): {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            showRefundDialog = false;
            await LoadSessionAsync();
            await LoadDeliveriesAsync();
        }
        catch (Exception ex) { actionError = "Something went wrong. Check your connection and try again."; }
        finally { submittingAction = false; StateHasChanged(); }
    }

    private async Task SubmitVoidAsync()
    {
        if (session is null) return;
        submittingAction = true; actionError = null; StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = AuthedRequest(HttpMethod.Post, $"/v1/pay/sessions/{session.Id}/void");
            req.Content = JsonContent.Create(new { note = voidNote });
            var resp = await http.SendAsync(req);
            if (!resp.IsSuccessStatusCode)
            {
                actionError = $"Void failed ({(int)resp.StatusCode}): {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            showVoidDialog = false;
            await LoadSessionAsync();
            await LoadDeliveriesAsync();
        }
        catch (Exception ex) { actionError = "Something went wrong. Check your connection and try again."; }
        finally { submittingAction = false; StateHasChanged(); }
    }

    private async Task CopyAsync(string field, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            copiedField = field;
            StateHasChanged();
            await Task.Delay(1500);
            if (copiedField == field) copiedField = "";
            StateHasChanged();
        }
        catch { }
    }

    private record SessionResponse(SessionDto Session, string? MerchantName);

    private record SessionDto(string Id, string StoreId, string Address, long AmountSatoshis, decimal Amount,
        string? FiatCurrency, decimal? FiatAmount, string? Label, string? Memo,
        string Status, DateTime CreatedAt, DateTime ExpiresAt,
        DateTime? SeenAt, DateTime? PaidAt,
        long ReceivedSatoshis, int Confirmations, string? PaidTxid,
        string Uri, string CheckoutUrl, string? Source = null,
        string? RefundTxid = null, DateTime? RefundedAt = null, string? RefundNote = null,
        string? ReturnUrl = null);

    private record WebhookDeliveryDto(string Id, string StoreId, string? SessionId,
        string EventName, string Url, int Attempt, int? StatusCode, string? ErrorMessage,
        int? DurationMs, string? ResponseSnippet,
        DateTime CreatedAt, DateTime? DeliveredAt, bool Success);
}
