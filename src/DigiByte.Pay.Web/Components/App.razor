<!DOCTYPE html>
@* data-dp-prerendered: this page arrived as full HTML. Its content is shown as it is, without the entrance
   animations, and isn't animated a second time when the live connection redraws it (tailwind-input.css).
   dialog.js removes the attribute on the first in-app navigation, so later page changes animate as before. *@
<html lang="en" data-dp-prerendered="@(Prerendered ? "" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Product favicon — the DigiPay-specific mark (receipt + arrow) so
       a pinned tab reads as DigiPay, not as the DigiByte chain itself.
       SVG first, PNG fallback at 192px for older browsers + Apple touch. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["digipay-logo.svg"]" />
    <link rel="icon" type="image/png" href="@Assets["digipay-logo-192.png"]" />
    <link rel="apple-touch-icon" href="@Assets["digipay-logo-192.png"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    @* Shared style layer from DigiByte.UI (spec 032): the wallet's fonts, tokens and components.
       Loaded after Tailwind so the component classes win; served from this origin. *@
    <link rel="stylesheet" href="@Assets["_content/DigiByte.UI/css/ui.css"]" />
    @* DigiPay's own page layout, built from the shared tokens. *@
    <link rel="stylesheet" href="@Assets["css/digipay.css"]" />
    @if (Prerendered)
    {
        @* The dashboard and POS styles aren't used by pages that arrive as full HTML, so they load without
           holding up the first paint; they are in place long before an in-app link opens the dashboard. *@
        <link rel="stylesheet" href="@Assets["css/digipay-dashboard.css"]" media="print" onload="this.media='all'" />
        <link rel="stylesheet" href="@Assets["css/digipay-pos.css"]" media="print" onload="this.media='all'" />
        <noscript>
            <link rel="stylesheet" href="@Assets["css/digipay-dashboard.css"]" />
            <link rel="stylesheet" href="@Assets["css/digipay-pos.css"]" />
        </noscript>
    }
    else
    {
        <link rel="stylesheet" href="@Assets["css/digipay-dashboard.css"]" />
        <link rel="stylesheet" href="@Assets["css/digipay-pos.css"]" />
    }
    <link rel="stylesheet" href="@Assets["css/digipay-docs.css"]" />
    @* Inter is used by every page, so fetch it early; JetBrains Mono loads on demand (FR-013a). *@
    <link rel="preload" as="font" type="font/woff2" crossorigin href="_content/DigiByte.UI/fonts/inter-latin-wght-normal.woff2" />
    <meta name="theme-color" content="#f8fafc" />
    @* The build this page came from; pos-store.js compares it with /api/build. *@
    <meta name="digipay-build" content="@DigiByte.Pay.Web.BuildInfo.Id" />
    <link rel="stylesheet" href="@Assets["DigiByte.Pay.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer"/>
    @* Theme boot script: runs synchronously in <head> and sets the `dark` class on <html>
       before first paint, so no page flashes the wrong theme (FR-027). *@
    <script src="@Assets["theme.js"]"></script>
    @* Auth-state boot — same pattern, sets data-digipay-auth="yes|no" from
       localStorage so the nav can show Dashboard vs Sign-in via CSS alone. *@
    <script src="@Assets["auth-state.js"]"></script>
    <link rel="stylesheet" href="@Assets["auth-state.css"]" />
    @* The helpers below are `defer`: they download alongside the styles but don't hold up the first paint, and
       run in this order once the page is parsed, before blazor.web.js (also deferred, at the end of <body>). *@
    @* Checkout countdown — pure JS so the timer works inside the embed iframe
       where Blazor's InteractiveServer circuit can't reliably hydrate. *@
    <script src="@Assets["checkout-countdown.js"]" defer></script>
    @* Browser-side blob → file download for the dashboard's CSV export buttons. *@
    <script src="@Assets["download.js"]" defer></script>
    @* Kiosk-side state for the POS page (/pos) — tiny localStorage wrapper
       + confirmation beep. Loaded site-wide so a reconnecting circuit can
       call window.digipayPos before the InteractiveServer hub is up. *@
    <script src="@Assets["pos-store.js"]" defer></script>
    @* Web Share API helper used by the dashboard's payment-links tab. *@
    <script src="@Assets["share-link.js"]" defer></script>
    @* Copy buttons, confirmation dialogs and the skip link (spec 032). *@
    <script src="@Assets["clipboard.js"]" defer></script>
    <script src="@Assets["dialog.js"]" defer></script>
</head>

<body>
    @* Shopper pages (/pay/...) are rendered on the server first so the amount and QR code arrive in
       the first HTML, then become interactive for live updates (spec 032, FR-013a, research R8).
       The public website (/, /features, /about, /sdks, /docs/...) is prerendered the same way.
       The dashboard and POS keep prerendering off: they read the browser's storage before they can
       draw anything. *@
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static readonly IComponentRenderMode ShopperMode = new InteractiveServerRenderMode(prerender: true);
    private static readonly IComponentRenderMode AppMode = new InteractiveServerRenderMode(prerender: false);

    private bool Prerendered => UsesPrerendering(HttpContext?.Request.Path.Value);

    private IComponentRenderMode PageRenderMode => Prerendered ? ShopperMode : AppMode;

    /// <summary>Shopper pages and the public website arrive as full HTML; the dashboard and POS don't.</summary>
    public static bool UsesPrerendering(string? path) => IsShopperPage(path) || IsPublicPage(path);

    /// <summary>/pay/{id}, /pay/{id}/receipt and /pay/button.</summary>
    public static bool IsShopperPage(string? path) =>
        path is not null && (path.Equals("/pay", StringComparison.OrdinalIgnoreCase)
                             || path.StartsWith("/pay/", StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// The public website: home, features, about, SDKs and every /docs page. These read nothing from the
    /// browser before drawing, so they are rendered on the server first (readable before the live connection
    /// is up, and visible to search engines), then become interactive for the menu, tabs and copy buttons.
    /// </summary>
    public static bool IsPublicPage(string? path)
    {
        if (path is null) return false;
        var p = path.Length > 1 ? path.TrimEnd('/') : path;
        if (p.Length == 0 || p == "/") return true;
        foreach (var page in PublicPages)
        {
            if (p.Equals(page, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return p.StartsWith("/docs/", StringComparison.OrdinalIgnoreCase);
    }

    private static readonly string[] PublicPages = ["/features", "/use-cases", "/about", "/sdks", "/docs"];
}
