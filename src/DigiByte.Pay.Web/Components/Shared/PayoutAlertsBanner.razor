@* Shows every DD payout address change the merchant hasn't acknowledged, on every Dashboard page (specs/034 FR-010). *@
@inject IHttpClientFactory HttpFactory
@using System.Net.Http.Json
@using System.Text.Json

@if (items is { Count: > 0 })
{
    <div class="flex flex-col gap-2 mb-4" id="payout-alerts">
        @foreach (var a in items)
        {
            <div class="rounded-lg border border-amber-400 bg-amber-50 dark:bg-amber-950/40 p-3 flex flex-col sm:flex-row sm:items-center gap-2" role="alert">
                <p class="m-0 flex-1 text-sm">
                    <strong>@Title(a)</strong>
                    @(a.StoreName is null ? "" : $" for {a.StoreName}"):
                    <span class="font-mono break-all">@a.NewAddress</span>.
                    @if (a.Status == "pending")
                    {
                        <span> Takes effect @a.EffectiveAt.ToLocalTime().ToString("g"). If this wasn't you, open DigiDollar payouts and cancel it.</span>
                    }
                </p>
                <button class="btn-secondary btn-sm" @onclick="() => AcknowledgeAsync(a)">Got it</button>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Token { get; set; } = string.Empty;

    private List<AlertDto>? items;
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token)) return;
        try
        {
            var http = HttpFactory.CreateClient("PayApi");
            var req = new HttpRequestMessage(HttpMethod.Get, "/v1/pay/me/payout-alerts");
            req.Headers.TryAddWithoutValidation("Authorization", $"Bearer {Token}");
            var response = await http.SendAsync(req);
            if (response.IsSuccessStatusCode) items = (await response.Content.ReadFromJsonAsync<AlertPage>(Json))?.Items;
        }
        catch { /* the banner is best-effort; the audit log and webhooks also record changes */ }
    }

    private async Task AcknowledgeAsync(AlertDto a)
    {
        var http = HttpFactory.CreateClient("PayApi");
        var req = new HttpRequestMessage(HttpMethod.Post, $"/v1/pay/stores/{a.StoreId ?? "-"}/payout-address/acknowledge")
        {
            Content = JsonContent.Create(new { changeId = a.ChangeId }),
        };
        req.Headers.TryAddWithoutValidation("Authorization", $"Bearer {Token}");
        await http.SendAsync(req);
        items?.Remove(a);
    }

    private static string Title(AlertDto a) => a.Event switch
    {
        "changed" => "DD payout address changed",
        "change_cancelled" => "DD payout address change cancelled",
        _ => "DD payout address change requested",
    };

    private sealed record AlertPage(List<AlertDto> Items);
    private sealed record AlertDto(string ChangeId, string? StoreId, string? StoreName, string Event, string? OldAddress, string NewAddress,
        DateTime RequestedAt, DateTime EffectiveAt, string Status);
}
