@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Public site menu (spec 032, US7). Wide screens: inline links. Phones: a menu button that opens a
   wallet-style sheet (dialog: focus moves in, Escape or a tap outside closes it, focus returns). *@
@{
    var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
    bool current(string p) => path == p;
}

<nav class="dp-sitenav" aria-label="Site">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center gap-3 sm:gap-6">
        <a href="/" class="dp-brand">
            <img src="/digipay-logo.svg" alt="" width="28" height="28" class="w-7 h-7 shrink-0" />
            <span>Digi<span class="text-dgb-500">Pay</span></span>
        </a>
        <div class="hidden md:flex gap-1 flex-1 items-center">
            @foreach (var (href, label) in Links)
            {
                <a href="@href" class="dp-sitenav-link" aria-current="@(current(href) ? "page" : null)">@label</a>
            }
            <a href="https://dgbwallet.app" target="_blank" rel="noopener" class="dp-sitenav-link">
                Wallet <Icon Name="external-link" Class="w-3.5 h-3.5 opacity-60" /><span class="sr-only">(opens in a new tab)</span>
            </a>
        </div>
        <div class="flex-1 md:hidden"></div>
        <ThemePicker Compact="true" Class="hidden sm:flex" />
        @* Signed out: Sign in. Signed in: Dashboard (auth-state.js shows one via CSS). *@
        <a href="/merchant/signin" data-auth-show="out" class="btn-primary btn-sm">Sign in</a>
        <a href="/merchant" data-auth-show="in" class="btn-primary btn-sm">
            <Icon Name="dashboard" Class="w-4 h-4" /><span>Dashboard</span>
        </a>
        <button type="button" class="icon-btn md:hidden" aria-label="Open menu" aria-haspopup="dialog"
                aria-expanded="@(menuOpen ? "true" : "false")" @onclick="OpenMenu">
            <Icon Name="menu" Class="w-5 h-5" />
        </button>
    </div>
</nav>

@if (menuOpen)
{
    <div class="dp-sheet-overlay dp-sheet-overlay-site" @onclick="CloseMenu">
        <div id="dp-site-sheet" class="card-raised dp-sheet" role="dialog" aria-modal="true" aria-labelledby="dp-site-sheet-title" @onclick:stopPropagation="true">
            <div class="dp-sheet-head">
                <h2 id="dp-site-sheet-title" class="block-title">Menu</h2>
                <button type="button" class="icon-btn" aria-label="Close menu" data-autofocus @onclick="CloseMenu"><Icon Name="close" Class="w-5 h-5" /></button>
            </div>
            <nav aria-label="Site pages" class="dp-sheet-list">
                @foreach (var (href, label) in Links)
                {
                    <a href="@href" class="dp-rail-item" aria-current="@(current(href) ? "page" : null)" @onclick="CloseMenu">@label</a>
                }
                <a href="https://dgbwallet.app" target="_blank" rel="noopener" class="dp-rail-item">
                    <span class="flex-1">Wallet</span><Icon Name="external-link" Class="w-4 h-4 opacity-60" /><span class="sr-only">(opens in a new tab)</span>
                </a>
            </nav>
            <div class="dp-rail-group">
                <p class="section-label px-3">Theme</p>
                <ThemePicker Class="mx-1" />
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Href, string Label)[] Links =
    [
        ("/features", "Features"),
        ("/docs", "How it works"),
        ("/docs/pos", "POS"),
        ("/sdks", "SDKs"),
        ("/docs/api", "API"),
        ("/about", "About"),
    ];

    private bool menuOpen;
    private DotNetObjectReference<SiteNav>? self;

    private async Task OpenMenu()
    {
        menuOpen = true;
        StateHasChanged();
        await Task.Yield();
        self ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("digipayDialog.open", "dp-site-sheet", self); } catch (JSException) { }
    }

    private async Task CloseMenu()
    {
        if (!menuOpen) return;
        menuOpen = false;
        try { await JS.InvokeVoidAsync("digipayDialog.close", "dp-site-sheet"); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        await CloseMenu();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (menuOpen)
        {
            try { await JS.InvokeVoidAsync("digipayDialog.close", "dp-site-sheet"); } catch { }
        }
        self?.Dispose();
    }
}
