@* Branded loader: the DigiByte mark breathing inside an orbiting gradient arc (.dgb-loader in digipay.css).
   Use for page-level loading states (dashboard start-up, checkout and receipt fetch, payment detail, sign-in).
   Screen readers hear the text once through role="status"; the animation is decorative. *@
<div class="dgb-loader-wrap @Class" role="status">
    <div class="dgb-loader @SizeClass" aria-hidden="true">
        <span class="dgb-loader-arc"></span>
        <span class="dgb-loader-glow"></span>
        <img src="/digibyte-logo.svg" alt="" class="dgb-loader-mark" width="36" height="36" />
    </div>
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        @* Trailing dots are animated by CSS, so strip any typed ellipsis. *@
        <p class="dgb-loader-text m-0">@Text.TrimEnd('…', '.')</p>
    }
    else
    {
        <span class="sr-only">Loading</span>
    }
</div>

@code {
    /// <summary>Text under the loader. Null or empty for compact spots.</summary>
    [Parameter] public string? Text { get; set; } = "Loading…";

    /// <summary>"sm", "md" (default) or "lg".</summary>
    [Parameter] public string Size { get; set; } = "md";

    /// <summary>Extra classes on the wrapper, e.g. "py-10" for pages or "py-4" inside a card.</summary>
    [Parameter] public string Class { get; set; } = "py-10";

    private string SizeClass => Size switch { "sm" => "dgb-loader-sm", "lg" => "dgb-loader-lg", _ => "" };
}
