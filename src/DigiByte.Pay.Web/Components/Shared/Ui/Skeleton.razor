@* Content-shaped loading placeholder (FR-020), using the shared `skeleton` class. Hidden from
   screen readers; the page announces loading through its own heading/status text. *@
<div class="@Class" aria-hidden="true">
    @for (var i = 0; i < Count; i++)
    {
        @switch (Shape)
        {
            case "line":
                <div class="skeleton h-4 @(i % 3 == 2 ? "w-2/3" : "w-full") @(i > 0 ? "mt-2" : "")"></div>
                break;
            case "block":
                <div class="skeleton h-24 w-full @(i > 0 ? "mt-3" : "")"></div>
                break;
            case "card":
                <div class="card p-4 @(i > 0 ? "mt-3" : "")">
                    <div class="skeleton h-4 w-1/3"></div>
                    <div class="skeleton h-8 w-1/2 mt-3"></div>
                    <div class="skeleton h-3 w-2/3 mt-3"></div>
                </div>
                break;
            default: @* row *@
                <div class="flex items-center gap-3 py-3 @(i > 0 ? "border-t border-slate-200/70 dark:border-white/10" : "")">
                    <div class="skeleton h-9 w-9 shrink-0" style="border-radius:9999px"></div>
                    <div class="flex-1 min-w-0">
                        <div class="skeleton h-4 w-1/2"></div>
                        <div class="skeleton h-3 w-1/3 mt-2"></div>
                    </div>
                    <div class="skeleton h-4 w-16 shrink-0"></div>
                </div>
                break;
        }
    }
</div>

@code {
    /// <summary>line | block | row | card</summary>
    [Parameter] public string Shape { get; set; } = "row";
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public string Class { get; set; } = "";
}
