<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf library shared by the two public APIs (DigiByte.Api, DigiByte.Pay.Api) ONLY: outbound-request guard
    (specs/008-security-hardening). It references no other project in this repo, so it inverts no dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
